(** Character properties for the Unicode version the language pins, from
    tables generated by [stage0/tools/unicode/generate.ml]. Code points are
    plain [int]s. *)

val version : string
(** The pinned Unicode version, such as ["18.0.0"]. *)

(** {1 UTF-8} *)

val decode : string -> int -> int
(** [decode text offset] decodes the UTF-8 sequence starting at [offset]
    strictly. It returns [(code_point lsl 3) lor length], or [-1] if the bytes
    there do not start a valid sequence: an overlong form, an encoded
    surrogate, a value above U+10FFFF, a stray continuation byte, or a
    truncated sequence. Use {!decoded_code_point} and {!decoded_length} on the
    result, which avoids allocating. *)

val decoded_code_point : int -> int
val decoded_length : int -> int

val encode : Buffer.t -> int -> unit
(** Appends the UTF-8 encoding of a Unicode scalar value. *)

val code_points : string -> int list
(** The code points of valid UTF-8 text. *)

val of_code_points : int list -> string

(** {1 Properties} *)

val is_xid_start : int -> bool
val is_xid_continue : int -> bool

val is_uppercase_or_titlecase : int -> bool
(** General category [Lu] or [Lt]. *)

val is_forbidden : int -> bool
(** The characters GRAMMAR.md forbids anywhere in a file: those with
    [Bidi_Control]; control characters other than tab, line feed, and
    carriage return, which the scanner handles itself; and every other
    [Default_Ignorable_Code_Point] except U+200C, U+200D, and the variation
    selectors. *)

val is_bidi_control : int -> bool
val is_control : int -> bool

val forbidden_name : int -> string option
(** The name of a forbidden character, for error messages. Only forbidden
    characters have names here, and unassigned ones have none. *)

val is_identifier_allowed : int -> bool
(** [Identifier_Status=Allowed] under UTS #39. *)

val to_lowercase : int -> int
val to_uppercase : int -> int
(** Simple case mappings. A character without one maps to itself. *)

(** {1 Normalization} *)

val is_nfc_quick_check_yes : int -> bool
val is_nfc : string -> bool
val nfc : string -> string
val nfd : string -> string

(** {1 Scripts and confusables (UTS #39)} *)

val is_moderately_restrictive : string -> bool
(** Whether a name meets UTS #39's Moderately Restrictive level, worked out
    from [Script_Extensions] as section 5.2 describes. ASCII, single-script,
    and highly restrictive names all meet it. *)

val script_names : string -> string list
(** The scripts of a name's characters, other than Common and Inherited, in
    order of first appearance, for error messages. *)

val skeleton : string -> string
(** UTS #39's skeleton: two strings are confusable when their skeletons are
    equal. *)
