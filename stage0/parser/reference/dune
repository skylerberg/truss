(library
 (name reference)
 (modules reference truss menhir_log)
 (libraries diagnostic token parser))

(rule
 (copy %{workspace_root}/grammar/truss.mly truss.mly))

(menhir
 (modules truss)
 (flags --strict))

(rule
 (write-file no_sentences ""))

(rule
 (with-outputs-to
  menhir.log
  (with-stdin-from
   no_sentences
   (run %{bin:menhir} --log-automaton 2 --interpret %{dep:truss.mly}))))

(rule
 (with-stdout-to
  menhir_log.ml
  (progn
   (echo "let text = {|")
   (cat %{dep:menhir.log})
   (echo "|}\n"))))
