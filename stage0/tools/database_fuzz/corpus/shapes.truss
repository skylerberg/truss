type Point(x: Int64, y: Int64)
  derives Equal

type Segment(start: Point, end: Point)

type Shape =
  | Dot(at: Point)
  | Line(segment: Segment)

trait Measured {
  fn size(self) -> Int64
    cost time finite
}

impl Measured for Point {
  fn size(self) -> Int64
    cost time finite
  {
    1
  }
}

impl Measured for Segment {
  fn size(self) -> Int64
    cost time finite
  {
    self.start.size() + self.end.size()
  }
}

fn measure(shape: Shape) -> Int64
  cost time finite
{
  match shape {
    Dot(at) => at.size()
    Line(segment) => segment.size()
  }
}

fn largest[T: Measured](left: T, right: T) -> Int64
  cost time finite
{
  let first = left.size()
  let second = right.size()
  if first > second { first } else { second }
}
