(library
 (name watcher)
 (libraries unix)
 (foreign_stubs
  (language c)
  (names watcher_stubs))
 (c_library_flags
  (:include c_library_flags.sexp)))

(rule
 (target c_library_flags.sexp)
 (enabled_if
  (= %{ocaml-config:system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "(-framework CoreServices)"))))

(rule
 (target c_library_flags.sexp)
 (enabled_if
  (<> %{ocaml-config:system} macosx))
 (action
  (with-stdout-to
   %{target}
   (echo "()"))))
