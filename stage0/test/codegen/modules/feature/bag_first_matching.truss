type Bag(items: List[String])

fn Bag.first_matching(self, prefix: String) lends Option[String] {
  let wanted = prefix.copy()
  for item in self.items {
    if item.starts_with(wanted) {
      return Some(item)
    }
  }
  None
}

test "a lending method lends from a `return` inside a loop, while it owns a value" {
  let bag = Bag(items: ["pear", "fig", "plum"])
  assert bag.first_matching("f") == Some("fig")
  assert bag.first_matching("p") == Some("pear")
  assert bag.first_matching("x") is None
}
