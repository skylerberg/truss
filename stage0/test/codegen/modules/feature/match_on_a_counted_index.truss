fn next_index(counter: mut UInt64) -> UInt64 {
  counter += 1
  counter - 1
}

test "an expression a pattern looks into is evaluated once" {
  var counter: UInt64 = 0
  let items = [Some(10), Some(20), None]
  let Some(first) = items[next_index(mut counter)] else {
    return
  }
  assert first == 10
  assert counter == 1
  if items[next_index(mut counter)] is Some(second) {
    assert second == 20
  }
  assert counter == 2
}
