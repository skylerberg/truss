fn counted(counter: mut UInt64) -> List[UInt64] {
  counter += 1
  [1, 2, 3, 4]
}

test "a slice of a temporary evaluates the temporary once" {
  var counter: UInt64 = 0
  assert counted(mut counter)[1..].length() == 3
  assert counter == 1
  assert counted(mut counter)[..=1].length() == 2
  assert counter == 2
  assert counted(mut counter)[..][3] == 4
  assert counter == 3
}
