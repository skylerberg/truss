type Words(left: List[String])

impl Cursor for Words {
  type Element = String

  fn next(mut self) -> Option[String] {
    mut self.left.pop()
  }
}

test "a loop over a cursor that is left without taking its value drops the value" uses RunForever {
  var each = Words(left: ["a${1}", "b${2}"])
  for _ in each {
    break
  }
}