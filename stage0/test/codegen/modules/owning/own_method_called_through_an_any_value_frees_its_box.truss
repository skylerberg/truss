trait Named {
  fn into_name(own self) -> String
  fn rename(mut self, tag: own String)
}

type Dog(tag: String)

impl Named for Dog {
  fn into_name(own self) -> String {
    self.tag
  }

  fn rename(mut self, tag: own String) {
    self.tag = own tag
  }
}

test "an own method called through an any value takes its value" {
  let pet: any Named = any Dog(tag: "${1}st")
  assert own pet.into_name() == "1st"
}

test "an any value changed through a mut method, then consumed through an own method" {
  var pet: any Named = any Dog(tag: "${1}st")
  mut pet.rename(tag: "${2}nd")
  assert own pet.into_name() == "2nd"
}
