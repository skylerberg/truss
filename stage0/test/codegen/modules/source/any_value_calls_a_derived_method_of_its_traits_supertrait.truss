trait Keyed: Hash {
  fn key(self) -> String
}

type Dog(tag: String)
  derives Equal, Hash

impl Keyed for Dog {
  fn key(self) -> String {
    self.tag.copy()
  }
}

test "a derived method through any hashes as the value does" {
  let pet: any Keyed = any Dog(tag: "rex")
  assert pet.key() == "rex"
  assert pet.hash(Hasher.new()).finish() == Dog(tag: "rex").hash(Hasher.new()).finish()
}
