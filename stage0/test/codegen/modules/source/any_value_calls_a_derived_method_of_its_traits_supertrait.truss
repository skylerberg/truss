trait Keyed: Hash {
  fn key(self) -> String
}

type Dog(tag: String)
  derives Equal, Hash

impl Keyed for Dog {
  fn key(self) -> String {
    self.tag.copy()
  }
}

test "a derived method through any hashes as the value does" {
  let pet: any Keyed = any Dog(tag: "rex")
  assert pet.key() == "rex"
  var through_any = Hasher.new()
  pet.hash(mut through_any)
  var direct = Hasher.new()
  Dog(tag: "rex").hash(mut direct)
  assert through_any.finish() == direct.finish()
}
