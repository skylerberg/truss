type Label(name: view String, rank: UInt64)

let greeting: view String = "hello"
let nothing: view String = ""
let words: List[view String] = ["one", "two"]
let alias: view String = greeting
let label: Label = Label(name: "first", rank: 1)
let ranks: Map[String, UInt64] = ["one": 1, "two": 2]

test "a view String constant reads its literal's bytes" {
  assert greeting == "hello"
  assert greeting.length() == 5
  assert nothing.is_empty()
}

test "a constant that holds views reads each literal's bytes" {
  assert words.length() == 2
  assert words[1] == "two"
  assert alias == "hello"
  assert label.name == "first"
}

test "a constant of views computed by running reads each literal's bytes" {
  assert ranks.get("two") == Some(2)
  assert ranks.length() == 2
}
