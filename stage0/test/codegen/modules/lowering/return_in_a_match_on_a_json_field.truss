use standard.json

fn first(value: json.Value) -> Result[String, String] {
  let name = match value.get("alg") {
    Some(member) => match member.as_text() {
      Some(text) => text.copy()
      None => return Err("not text")
    }
    None => return Err("missing")
  }
  Ok(own name)
}

fn first_of(text: String) -> Result[String, String] {
  match json.parse(text) {
    Ok(value) => first(value)
    Err(_) => Err("no json")
  }
}

test "a return in an arm of a match on a lent part drops only what it holds" {
  assert first_of("{\"alg\":\"x\"}") == Ok("x")
  assert first_of("{\"alg\":1}") == Err("not text")
  assert first_of("{}") == Err("missing")
}
