type Countdown(left: Int64)
  invariant left >= 0

impl Cursor for Countdown {
  type Element = Int64

  fn next(mut self) -> Option[Int64]
    ensures (result is Some(_)) ==> self.left < old(self.left)
  {
    if self.left == 0 {
      return None
    }
    self.left -= 1
    Some(self.left)
  }
}

impl FiniteCursor for Countdown {
  fn remaining(self) -> UInt64
    ensures result == UInt64.from_integer(self.left)
  {
    UInt64.from_integer(self.left)
  }
}

fn sum(items: mut any FiniteCursor[Element = Int64]) -> Int64 {
  var total: Int64 = 0
  while mut items.next() is Some(item)
    decreases items.remaining()
  {
    total = total.wrapping_add(item)
  }
  total
}

test "any FiniteCursor calls the next of its Cursor and its own remaining, over two kinds of cursor" {
  var written: any FiniteCursor[Element = Int64] = any Countdown(left: 4)
  assert written.remaining() == 4
  assert sum(mut written) == 6
  assert written.remaining() == 0
  let items: List[Int64] = [3, 1, 4]
  var built: any FiniteCursor[Element = Int64] = any items.cursor()
  assert mut built.next() == Some(3)
  assert built.remaining() == 2
  assert sum(mut built) == 5
}
