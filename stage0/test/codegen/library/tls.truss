fn certificate(text: StringSlice) -> x509::Certificate
  uses Panic
{
  match x509::parse_pem(text) {
    Ok(certificates) => certificates[0].copy()
    Err(_) => Panic.crash("a certificate")
  }
}

fn server_config() -> tls::ServerConfig
  uses Panic
{
  let blocks = x509::pem_blocks(leaf_key_pem.slice(), label: "PRIVATE KEY")
  let key = x509::parse_private_key(blocks[0].slice()).expect("a key")
  tls::ServerConfig(
    chain: [certificate(leaf_pem.slice()), certificate(intermediate_pem.slice())],
    key: own key,
    protocols: ["h2", "http/1.1"],
  )
}

fn world() -> simulation::World
  uses Panic
{
  let now = Instant.from_unix_seconds(1900000000).expect("in range")
  simulation::World.from(simulation::Setup.new().with_time(now).with_host("example.test", address: network::IpAddress.loopback))
}

fn serve_once(listener: mut network::Listener) -> String
  uses Handles, Tasks, Random, Clock, Panic
{
  var connection = mut listener.accept().expect("a client connects")
  let _ = mut connection.set_read_timeout(Some(Duration.seconds(5)))
  match tls::accept(own connection, config: server_config()) {
    Ok(secured) => {
      let session = own secured
      var line: List[UInt8] = []
      let _ = session.receive_exactly(mut line, count: 5)
      var reply: String = "echo "
      mut reply.push(String.from_utf8_lossy(line.slice()).slice())
      let _ = session.send_all(reply.slice().bytes())
      var rest: List[UInt8] = []
      let ended = session.receive_to_end(mut rest)
      let protocol = session.protocol().unwrap_or("none".slice()).to_string()
      "${protocol} ${ended == Ok(0)}"
    }
    Err(error) => "failed: ${error}"
  }
}

fn visit(host: StringSlice, roots: own List[x509::Certificate], protocols: own List[String]) -> String
  uses NetworkClient, Handles, Tasks, Random, Clock, Panic
{
  var connection = network::connect(host, port: 8443).expect("the server accepts")
  let _ = mut connection.set_read_timeout(Some(Duration.seconds(5)))
  match tls::connect(own connection, host: host, config: tls::ClientConfig(roots: own roots, protocols: own protocols)) {
    Ok(secured) => {
      let session = own secured
      let _ = session.send_all("hello".bytes())
      var reply: List[UInt8] = []
      let _ = session.receive_exactly(mut reply, count: 10)
      let _ = session.close_sending()
      let protocol = session.protocol().unwrap_or("none".slice()).to_string()
      "${String.from_utf8_lossy(reply.slice())} ${protocol} ${session.peer_certificates().length()}"
    }
    Err(error) => "failed: ${error}"
  }
}

fn handshake(host: StringSlice, roots: own List[x509::Certificate], protocols: own List[String]) -> List[String]
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, Random, Panic
{
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: 8443)).expect("the port is free")
  var server = ""
  var client = ""
  concurrent {
    server = serve_once(mut listener)
    client = visit(host, roots: own roots, protocols: own protocols)
  }
  [own client, own server]
}

test "a client and a server agree on keys, verify the chain, pick a protocol, and exchange data" {
  provide world() {
    let seen = handshake("example.test", roots: [certificate(root_pem.slice())], protocols: ["http/1.1", "h2"])
    assert seen[0] == "echo hello h2 2"
    assert seen[1] == "h2 true"
  }
}

test "a client rejects a chain for another host or from an unknown root" {
  provide world() {
    let other = handshake("localhost", roots: [certificate(root_pem.slice())], protocols: [])
    assert other[0] == "failed: the certificate is not for this host"
    assert other[1].slice().starts_with("failed: ")
  }
  provide world() {
    let unknown = handshake("example.test", roots: [], protocols: [])
    assert unknown[0] == "failed: the chain does not lead to a trusted root"
  }
}

fn greet(request: own http::Request, responder: mut http::Responder)
  uses Tasks
{
  let _ = mut responder.send(http::Response.text("secure ${request.path()}".slice()))
}

fn secure_exchange() -> String
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: 8443)).expect("the port is free")
  concurrent {
    http::serve_tls(mut listener, config: server_config(), handler: greet)
    {
      let options = http::ClientOptions(roots: Some([certificate(root_pem.slice())]))
      return match http::get("https://example.test:8443/page", options: options) {
        Ok(response) => "${response.status.code} ${response.text_body().unwrap_or("")}"
        Err(error) => "failed: ${error}"
      }
    }
  }
}

test "an HTTPS client and server exchange a request and a response" {
  provide world() {
    assert secure_exchange() == "200 secure /page"
  }
}

fn routes(request: own http::Request, responder: mut http::Responder)
  uses Handles, Tasks
{
  let _ = mut responder.send(route(own request))
}

fn route(request: own http::Request) -> http::Response
  uses Handles, Tasks
{
  if request.matches(http::Route"POST /upload") is Some(_) {
    let tag = request.header("x-tag").unwrap_or("none".slice()).to_string()
    let length = match own request.bytes() {
      Ok(bytes) => bytes.length()
      Err(_) => 0
    }
    return http::Response.text("${length} ${tag}".slice())
  }
  if request.matches(http::Route"GET /empty") is Some(_) {
    return http::Response.new(status: http::Status.no_content)
  }
  if request.matches(http::Route"GET /big") is Some(_) {
    let text = "x".slice().repeated(70000)
    return http::Response.text(text.slice())
  }
  http::Response.text("served ${request.path()}".slice())
}

fn summary(outcome: own Result[http::Response, http::Error]) -> String {
  match own outcome {
    Ok(response) => "${response.status.code} ${response.body.length()} ${response.text_body().unwrap_or("")}"
    Err(error) => "failed: ${error}"
  }
}

fn client_exchanges(is_secure: Bool) -> List[String]
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  let port: UInt16 = if is_secure { 8443 } else { 8080 }
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: port)).expect("the port is free")
  concurrent {
    if is_secure {
      http::serve_tls(mut listener, config: server_config(), handler: routes)
    } else {
      http::serve(mut listener, handler: routes)
    }
    {
      var seen: List[String] = []
      var client = http::Client.new(http::ClientOptions(roots: Some([certificate(root_pem.slice())])))
      let base = if is_secure { "https://example.test:8443" } else { "http://example.test:8080" }
      mut seen.push(summary(mut client.get("${base}/first".slice())))
      mut seen.push(summary(mut client.get("${base}/second?page=2".slice())))
      var headers = http::Headers.new()
      mut headers.add("X-Tag", value: "tagged")
      let upload: List[UInt8] = List.filled(7, count: 70000)
      let upload_url = url::parse("${base}/upload".slice()).expect("a URL")
      mut seen.push(summary(mut client.send(http::Method.Post, url: upload_url, headers: headers, body: upload)))
      mut seen.push(summary(mut client.get("${base}/empty".slice())))
      match mut client.get("${base}/big".slice()) {
        Ok(response) => mut seen.push("${response.status.code} ${response.body.length()}")
        Err(error) => mut seen.push("failed: ${error}")
      }
      let head_url = url::parse("${base}/first".slice()).expect("a URL")
      mut seen.push(summary(mut client.send(http::Method.Head, url: head_url)))
      return own seen
    }
  }
}

test "a client sends several requests over one HTTP/2 connection, with an upload larger than a window" {
  provide world() {
    let seen = client_exchanges(true)
    assert seen.length() == 6
    assert seen[0] == "200 13 served /first"
    assert seen[1] == "200 14 served /second"
    assert seen[2] == "200 12 70000 tagged"
    assert seen[3] == "204 0 "
    assert seen[4] == "200 70000"
    assert seen[5] == "200 0 "
  }
}

test "a client keeps an HTTP/1.1 connection open between requests" {
  provide world() {
    let seen = client_exchanges(false)
    assert seen.length() == 6
    assert seen[0] == "200 13 served /first"
    assert seen[1] == "200 14 served /second"
    assert seen[2] == "200 12 70000 tagged"
    assert seen[3] == "204 0 "
    assert seen[4] == "200 70000"
    assert seen[5] == "200 0 "
  }
}

fn identity(certificate_text: StringSlice, key_text: StringSlice) -> tls::Identity
  uses Panic
{
  let blocks = x509::pem_blocks(key_text, label: "PRIVATE KEY")
  let key = x509::parse_private_key(blocks[0].slice()).expect("a key")
  tls::Identity(chain: [certificate(certificate_text)], key: own key)
}

fn mutual(port: UInt16, required: tls::ClientCertificates, protocols: List[String], presented: Option[tls::Identity]) -> String
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: port)).expect("the port is free")
  var config = server_config()
  config.protocols = protocols.copy()
  config.client_certificates = required
  config.client_roots = [certificate(client_ca_pem.slice())]
  concurrent {
    http::serve_tls(mut listener, config: config, handler: fn(request, responder) {
      let name = match request.client_certificates.first() {
        Some(leaf) => leaf.common_name().unwrap_or("unnamed").to_string()
        None => "none"
      }
      let _ = mut responder.send(http::Response.text("${request.client_certificates.length()} ${name}".slice()))
    })
    {
      var client = http::Client.new(http::ClientOptions(roots: Some([certificate(root_pem.slice())]), identity: presented.copy()))
      return match mut client.get("https://example.test:${port}/".slice()) {
        Ok(response) => response.text_body().unwrap_or("")
        Err(_) => "refused"
      }
    }
  }
}

test "a server that requires a client certificate accepts one its roots signed, and refuses others" {
  provide world() {
    let client = identity(client_pem.slice(), key_text: client_key_pem.slice())
    let server_only = identity(server_only_pem.slice(), key_text: server_only_key_pem.slice())
    assert mutual(8450, required: tls::ClientCertificates.Required, protocols: ["http/1.1"], presented: Some(client.copy())) == "1 Truss Test client"
    assert mutual(8451, required: tls::ClientCertificates.Required, protocols: ["h2"], presented: Some(client.copy())) == "1 Truss Test client"
    assert mutual(8452, required: tls::ClientCertificates.Required, protocols: ["http/1.1"], presented: None) == "refused"
    assert mutual(8453, required: tls::ClientCertificates.Required, protocols: ["http/1.1"], presented: Some(own server_only)) == "refused"
    assert mutual(8454, required: tls::ClientCertificates.Verified, protocols: ["http/1.1"], presented: None) == "0 none"
  }
}

fn read_proxy_head(connection: network::Connection) -> String
  uses Handles, Tasks
{
  var received: List[UInt8] = []
  while !String.from_utf8_lossy(received.slice()).slice().contains("\r\n\r\n") {
    match connection.receive(mut received, limit: 4096) {
      Ok(count) => if count == 0 { return String.from_utf8_lossy(received.slice()) }
      Err(_) => return String.from_utf8_lossy(received.slice())
    }
  }
  String.from_utf8_lossy(received.slice())
}

fn pump(from: network::Connection, to: network::Connection)
  uses Handles, Tasks
{
  while true {
    var piece: List[UInt8] = []
    match from.receive(mut piece, limit: 16384) {
      Ok(count) => {
        if count == 0 {
          let _ = to.close_sending()
          return
        }
      }
      Err(_) => return
    }
    if to.send_all(piece.slice()) is Err(_) {
      return
    }
  }
}

fn proxied() -> List[String]
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  var origin = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: 8455)).expect("the port is free")
  var proxy = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: 3128)).expect("the port is free")
  let tunnels = tasks::Cell[List[String]].new([])
  concurrent {
    http::serve_tls(mut origin, config: server_config(), handler: routes)
    {
      while true {
        let client_side = match mut proxy.accept() {
          Ok(connection) => own connection
          Err(_) => return []
        }
        let head = read_proxy_head(client_side)
        let first = head.slice().lines().first().unwrap_or("").to_string()
        if first.slice().starts_with("CONNECT ") {
          let line = first.copy()
          tunnels.update(fn(listed) { mut listed.push(line.copy()) })
          let _ = client_side.send_all("HTTP/1.1 200 Connection established\r\n\r\n".bytes())
          let target = network::connect("example.test", port: 8455).expect("the origin accepts")
          concurrent {
            pump(from: client_side, to: target)
            pump(from: target, to: client_side)
          }
        } else {
          var authorization = "none"
          for line in head.slice().lines() {
            match line.strip_prefix("Proxy-Authorization: ") {
              Some(value) => authorization = value.to_string()
              None => {}
            }
          }
          let body = "${first}|${authorization}"
          let reply = "HTTP/1.1 200 OK\r\nContent-Length: ${body.length()}\r\nConnection: close\r\n\r\n${body}"
          let _ = client_side.send_all(reply.slice().bytes())
          let _ = client_side.close_sending()
        }
      }
    }
    {
      let through = http::Proxy(
        http: url::parse("http://user:secret@example.test:3128").ok(),
        https: url::parse("http://example.test:3128").ok(),
      )
      var seen: List[String] = []
      var client = http::Client.new(http::ClientOptions(roots: Some([certificate(root_pem.slice())]), proxy: Some(through.copy())))
      mut seen.push(summary(mut client.get("http://origin.test/path?q=1")))
      let secured = summary(mut client.get("https://example.test:8455/first"))
      for line in tunnels.read(fn(listed) { listed.copy() }) {
        mut seen.push(line.copy())
      }
      mut seen.push(own secured)
      let skipping = http::Proxy(https: url::parse("http://example.test:3128").ok(), excluded: ["example.test"])
      var direct = http::Client.new(http::ClientOptions(roots: Some([certificate(root_pem.slice())]), proxy: Some(own skipping)))
      mut seen.push(summary(mut direct.get("https://example.test:8455/second")))
      return seen
    }
  }
}

test "a client sends plain requests to its proxy in absolute form and tunnels TLS through CONNECT" {
  provide world() {
    let seen = proxied()
    assert seen.length() == 4
    assert seen[0] == "200 63 GET http://origin.test/path?q=1 HTTP/1.1|Basic dXNlcjpzZWNyZXQ="
    assert seen[1] == "CONNECT example.test:8455 HTTP/1.1"
    assert seen[2] == "200 13 served /first"
    assert seen[3] == "200 14 served /second"
  }
}

fn smtp_line[Stream: streams::Duplex](connection: Stream, inbox: mut List[UInt8]) -> Option[String]
  uses Handles, Tasks
{
  while true {
    for index in 1..inbox.length() {
      if inbox[index] == 10 && inbox[index - 1] == 13 {
        let rest = mut inbox.split_off(index + 1)
        let line = String.from_utf8_lossy(inbox[..index - 1])
        inbox = own rest
        return Some(own line)
      }
    }
    match connection.receive(mut inbox, limit: 4096) {
      Ok(count) => if count == 0 { return None }
      Err(_) => return None
    }
  }
}

fn smtp_session[Stream: streams::Duplex](connection: Stream, transcript: tasks::Cell[List[String]], offers_tls: Bool) -> Bool
  uses Handles, Tasks
{
  var inbox: List[UInt8] = []
  while true {
    let line = match smtp_line(connection, inbox: mut inbox) {
      Some(line) => own line
      None => return false
    }
    let recorded = line.copy()
    transcript.update(fn(listed) { mut listed.push(recorded.copy()) })
    if line.slice().starts_with("EHLO") {
      let _ = connection.send_all(if offers_tls { "250-mail.example.test\r\n250 STARTTLS\r\n".bytes() } else { "250 mail.example.test\r\n".bytes() })
    } else if line == "STARTTLS" {
      let _ = connection.send_all("220 go ahead\r\n".bytes())
      return true
    } else if line == "DATA" {
      let _ = connection.send_all("354 go ahead\r\n".bytes())
      while true {
        match smtp_line(connection, inbox: mut inbox) {
          Some(body_line) => if body_line == "." { break }
          None => return false
        }
      }
      let _ = connection.send_all("250 queued\r\n".bytes())
    } else if line == "QUIT" {
      let _ = connection.send_all("221 bye\r\n".bytes())
      return false
    } else {
      let _ = connection.send_all("250 ok\r\n".bytes())
    }
  }
}

fn mailed(port: UInt16, offers_tls: Bool) -> List[String]
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: port)).expect("the port is free")
  let transcript = tasks::Cell[List[String]].new([])
  var outcome = ""
  concurrent {
    {
      match mut listener.accept() {
        Ok(connection) => {
          let _ = connection.send_all("220 mail.example.test ready\r\n".bytes())
          if smtp_session(connection, transcript: transcript, offers_tls: offers_tls) {
            match tls::accept(own connection, config: server_config()) {
              Ok(secured) => {
                let _ = smtp_session(secured, transcript: transcript, offers_tls: false)
              }
              Err(_) => {}
            }
          }
        }
        Err(_) => {}
      }
    }
    {
      let note = mail::Message(from: mail::Address(email: "ada@example.test"), to: [mail::Address(email: "grace@example.test")], subject: "Hello", text: Some("Hi"))
      outcome = match mail::send(note, options: mail::SmtpOptions(host: "example.test", port: port, roots: Some([certificate(root_pem.slice())]))) {
        Ok(_) => "sent"
        Err(Unsupported(message)) => "unsupported: ${message}"
        Err(error) => "failed: ${error}"
      }
    }
  }
  var seen: List[String] = [own outcome]
  for line in transcript.read(fn(listed) { listed.copy() }) {
    mut seen.push(line.copy())
  }
  seen
}

test "mail upgrades an SMTP connection with STARTTLS, verifies the server, and sends over TLS" {
  provide world() {
    assert mailed(2526, offers_tls: true) == [
      "sent",
      "EHLO localhost",
      "STARTTLS",
      "EHLO localhost",
      "MAIL FROM:<ada@example.test>",
      "RCPT TO:<grace@example.test>",
      "DATA",
      "QUIT",
    ]
  }
}

test "mail refuses to send in the clear to a server that does not offer STARTTLS" {
  provide world() {
    let seen = mailed(2527, offers_tls: false)
    assert seen[0] == "unsupported: a mail server that does not offer STARTTLS"
    assert !seen.contains("MAIL FROM:<ada@example.test>")
  }
}
