fn certificate(text: StringSlice) -> x509::Certificate
  uses Panic
{
  match x509::parse_pem(text) {
    Ok(certificates) => certificates[0].copy()
    Err(_) => Panic.crash("a certificate")
  }
}

fn server_config() -> tls::ServerConfig
  uses Panic
{
  let blocks = x509::pem_blocks(leaf_key_pem.slice(), label: "PRIVATE KEY")
  let key = x509::parse_private_key(blocks[0].slice()).expect("a key")
  tls::ServerConfig(
    chain: [certificate(leaf_pem.slice()), certificate(intermediate_pem.slice())],
    key: own key,
    protocols: ["h2", "http/1.1"],
  )
}

fn world() -> simulation::World
  uses Panic
{
  let now = Instant.from_unix_seconds(1900000000).expect("in range")
  simulation::World.from(simulation::Setup.new().with_time(now).with_host("example.test", address: network::IpAddress.loopback))
}

fn serve_once(listener: mut network::Listener) -> String
  uses Handles, Tasks, Random, Panic
{
  var connection = mut listener.accept().expect("a client connects")
  let _ = mut connection.set_read_timeout(Some(Duration.seconds(5)))
  match tls::accept(own connection, config: server_config()) {
    Ok(secured) => {
      let session = own secured
      var line: List[UInt8] = []
      let _ = session.receive_exactly(mut line, count: 5)
      var reply: String = "echo "
      mut reply.push(String.from_utf8_lossy(line.slice()).slice())
      let _ = session.send_all(reply.slice().bytes())
      var rest: List[UInt8] = []
      let ended = session.receive_to_end(mut rest)
      let protocol = session.protocol().unwrap_or("none".slice()).to_string()
      "${protocol} ${ended == Ok(0)}"
    }
    Err(error) => "failed: ${error}"
  }
}

fn visit(host: StringSlice, roots: own List[x509::Certificate], protocols: own List[String]) -> String
  uses NetworkClient, Handles, Tasks, Random, Clock, Panic
{
  var connection = network::connect(host, port: 8443).expect("the server accepts")
  let _ = mut connection.set_read_timeout(Some(Duration.seconds(5)))
  match tls::connect(own connection, host: host, config: tls::ClientConfig(roots: own roots, protocols: own protocols)) {
    Ok(secured) => {
      let session = own secured
      let _ = session.send_all("hello".bytes())
      var reply: List[UInt8] = []
      let _ = session.receive_exactly(mut reply, count: 10)
      let _ = session.close_sending()
      let protocol = session.protocol().unwrap_or("none".slice()).to_string()
      "${String.from_utf8_lossy(reply.slice())} ${protocol} ${session.peer_certificates().length()}"
    }
    Err(error) => "failed: ${error}"
  }
}

fn handshake(host: StringSlice, roots: own List[x509::Certificate], protocols: own List[String]) -> List[String]
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, Random, Panic
{
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: 8443)).expect("the port is free")
  var server = ""
  var client = ""
  concurrent {
    server = serve_once(mut listener)
    client = visit(host, roots: own roots, protocols: own protocols)
  }
  [own client, own server]
}

test "a client and a server agree on keys, verify the chain, pick a protocol, and exchange data" {
  provide world() {
    let seen = handshake("example.test", roots: [certificate(root_pem.slice())], protocols: ["http/1.1", "h2"])
    assert seen[0] == "echo hello h2 2"
    assert seen[1] == "h2 true"
  }
}

test "a client rejects a chain for another host or from an unknown root" {
  provide world() {
    let other = handshake("localhost", roots: [certificate(root_pem.slice())], protocols: [])
    assert other[0] == "failed: the certificate is not for this host"
    assert other[1].slice().starts_with("failed: ")
  }
  provide world() {
    let unknown = handshake("example.test", roots: [], protocols: [])
    assert unknown[0] == "failed: the chain does not lead to a trusted root"
  }
}

fn greet(request: own http::Request, responder: mut http::Responder)
  uses Tasks
{
  let _ = mut responder.send(http::Response.text("secure ${request.path()}".slice()))
}

fn secure_exchange() -> String
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: 8443)).expect("the port is free")
  concurrent {
    http::serve_tls(mut listener, config: server_config(), handler: greet)
    {
      let options = http::ClientOptions(roots: Some([certificate(root_pem.slice())]))
      return match http::get("https://example.test:8443/page", options: options) {
        Ok(response) => "${response.status.code} ${response.text_body().unwrap_or("")}"
        Err(error) => "failed: ${error}"
      }
    }
  }
}

test "an HTTPS client and server exchange a request and a response" {
  provide world() {
    assert secure_exchange() == "200 secure /page"
  }
}

fn routes(request: own http::Request, responder: mut http::Responder)
  uses Handles, Tasks
{
  let _ = mut responder.send(route(own request))
}

fn route(request: own http::Request) -> http::Response
  uses Handles, Tasks
{
  if request.matches(http::Route"POST /upload") is Some(_) {
    let tag = request.header("x-tag").unwrap_or("none".slice()).to_string()
    let length = match own request.bytes() {
      Ok(bytes) => bytes.length()
      Err(_) => 0
    }
    return http::Response.text("${length} ${tag}".slice())
  }
  if request.matches(http::Route"GET /empty") is Some(_) {
    return http::Response.new(status: http::Status.no_content)
  }
  if request.matches(http::Route"GET /big") is Some(_) {
    let text = "x".slice().repeated(70000)
    return http::Response.text(text.slice())
  }
  http::Response.text("served ${request.path()}".slice())
}

fn summary(outcome: own Result[http::Response, http::Error]) -> String {
  match own outcome {
    Ok(response) => "${response.status.code} ${response.body.length()} ${response.text_body().unwrap_or("")}"
    Err(error) => "failed: ${error}"
  }
}

fn client_exchanges(is_secure: Bool) -> List[String]
  uses Tasks, Clock, NetworkServer, NetworkClient, Handles, FileRead, Random, Panic
{
  let port: UInt16 = if is_secure { 8443 } else { 8080 }
  var listener = NetworkServer.listen(network::SocketAddress(address: network::IpAddress.loopback, port: port)).expect("the port is free")
  concurrent {
    if is_secure {
      http::serve_tls(mut listener, config: server_config(), handler: routes)
    } else {
      http::serve(mut listener, handler: routes)
    }
    {
      var seen: List[String] = []
      var client = http::Client.new(http::ClientOptions(roots: Some([certificate(root_pem.slice())])))
      let base = if is_secure { "https://example.test:8443" } else { "http://example.test:8080" }
      mut seen.push(summary(mut client.get("${base}/first".slice())))
      mut seen.push(summary(mut client.get("${base}/second?page=2".slice())))
      var headers = http::Headers.new()
      mut headers.add("X-Tag", value: "tagged")
      let upload: List[UInt8] = List.filled(7, count: 70000)
      let upload_url = url::parse("${base}/upload".slice()).expect("a URL")
      mut seen.push(summary(mut client.send(http::Method.Post, url: upload_url, headers: headers, body: upload)))
      mut seen.push(summary(mut client.get("${base}/empty".slice())))
      match mut client.get("${base}/big".slice()) {
        Ok(response) => mut seen.push("${response.status.code} ${response.body.length()}")
        Err(error) => mut seen.push("failed: ${error}")
      }
      let head_url = url::parse("${base}/first".slice()).expect("a URL")
      mut seen.push(summary(mut client.send(http::Method.Head, url: head_url)))
      return own seen
    }
  }
}

test "a client sends several requests over one HTTP/2 connection, with an upload larger than a window" {
  provide world() {
    let seen = client_exchanges(true)
    assert seen.length() == 6
    assert seen[0] == "200 13 served /first"
    assert seen[1] == "200 14 served /second"
    assert seen[2] == "200 12 70000 tagged"
    assert seen[3] == "204 0 "
    assert seen[4] == "200 70000"
    assert seen[5] == "200 0 "
  }
}

test "a client keeps an HTTP/1.1 connection open between requests" {
  provide world() {
    let seen = client_exchanges(false)
    assert seen.length() == 6
    assert seen[0] == "200 13 served /first"
    assert seen[1] == "200 14 served /second"
    assert seen[2] == "200 12 70000 tagged"
    assert seen[3] == "204 0 "
    assert seen[4] == "200 70000"
    assert seen[5] == "200 0 "
  }
}
