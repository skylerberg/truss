use standard::cryptography
use standard::hex
use standard::random

fn bytes_of(text: StringSlice) -> List[UInt8] {
  match hex::decode(text) {
    Ok(bytes) => own bytes
    Err(_) => []
  }
}

let modulus: String = ""

let pkcs1_signature: String = ""

let pss_signature: String = ""

fn public_key() -> cryptography::RsaPublicKey
  uses Panic
{
  cryptography::RsaPublicKey.new(bytes_of(modulus.slice()), exponent: bytes_of("010001")).expect("a 2048-bit key")
}

fn private_key() -> cryptography::RsaPrivateKey
  uses Panic
{
  cryptography::RsaPrivateKey.new(
    public_key(),
    exponent: bytes_of(""),
    first_prime: bytes_of("f67eca3dbbe266f0e373ea2b23dd011f26b5a7a56dd16184e78ebd75c4e2fa84a93e562f5bd6bf066cf82405a033a6382f9f42432402eef7b8fb90964dc24306f7bd0a954373f3ea507397432f42bcab46fb481dc95fb323a4e4191757a386aa3f5c3df1630c97af837938934deeb4ffebc56261d056d860fb26f30dc96c4251"),
    second_prime: bytes_of("db4f963151c08a4a5c3cd3641d22f009e44636e1ed2a146e7381a2cf63861cf90223e98fe57d603e9383802cfc089031c7b52d56f34b365a60cb73121316bdb1df7778d38525b71ade8c2f20b42925ea2cb5756d85017e7c602fcc9a1c8e0e62e7a40b3d19651d083b625e335d0aebce880b27770062e395bb1d53e235c22969"),
    first_exponent: bytes_of("bc4a9216a24509b98d25e884d7ba64b6f50ce2691e00496c0aae20cfab7c6f3d9342c8f718426c5d6e3406e03d45f6fd0873b15c345001573df8fcb3b3e666e915a954423cea8032470e6547aefc5dbec05406fca9ecee9c95c29fe012d41974473e211b193c6f4a6535de1fb7f2565500372135f2bdc44020d9d9e4782eb861"),
    second_exponent: bytes_of("6b77f59e9774259048e0d9a9fe89275d818a52cca57e7062aba18419e2a84ebc4b2b3401fab054a075830425871fdf2135bef7c7db132940629c6ff81478995e77a641044e03ec557366f8952b13daeb851b2abf0f656b0921cd6a92be99723d4f4bd8e208f6bea2510f642001611faaa689e8bdece788a4cffb902692b761b9"),
    coefficient: bytes_of("953889e63796d31ac65641d10a72a05f11019b259d8bcef6363429815fa722a5a32474a1d506fc25906fb9d493f4c8908dc997effc169e57df1064d08e04821cb52010666af16bd512508c7f20b789df316499fea9a25eb2c29549ccaeefccbce419c91d6cca61709c142108e800d9d356dbf2cad31e92e8b75b1786827d02e2"),
  ).expect("the parts of one key")
}

test "RSA signatures OpenSSL made verify with PKCS #1 v1.5 and PSS, and changed ones do not" {
  let key = public_key()
  let message = "hello truss".bytes()
  assert key.bits() == 2048
  assert key.verify_pkcs1(cryptography::HashFunction.Sha256, message: message, signature: bytes_of(pkcs1_signature.slice()))
  assert !key.verify_pkcs1(cryptography::HashFunction.Sha256, message: "hello trust".bytes(), signature: bytes_of(pkcs1_signature.slice()))
  assert key.verify_pss(cryptography::HashFunction.Sha256, message: message, signature: bytes_of(pss_signature.slice()))
  var changed = bytes_of(pss_signature.slice())
  changed[100] = changed[100] ^ 4
  assert !key.verify_pss(cryptography::HashFunction.Sha256, message: message, signature: changed)
  assert !key.verify_pkcs1(cryptography::HashFunction.Sha256, message: message, signature: bytes_of(pss_signature.slice()))
}

test "an RSA private key signs with PKCS #1 v1.5 as OpenSSL does, and with PSS that verifies" {
  let key = private_key()
  let message = "hello truss".bytes()
  assert hex::encode(key.sign_pkcs1(cryptography::HashFunction.Sha256, message: message)) == pkcs1_signature
  provide random::SeededRandom.new(9) {
    let signed = key.sign_pss(cryptography::HashFunction.Sha384, message: message)
    assert key.public_key().verify_pss(cryptography::HashFunction.Sha384, message: message, signature: signed)
  }
  assert cryptography::RsaPrivateKey.new(
    public_key(),
    exponent: bytes_of(""),
    first_prime: bytes_of("db4f963151c08a4a5c3cd3641d22f009e44636e1ed2a146e7381a2cf63861cf90223e98fe57d603e9383802cfc089031c7b52d56f34b365a60cb73121316bdb1df7778d38525b71ade8c2f20b42925ea2cb5756d85017e7c602fcc9a1c8e0e62e7a40b3d19651d083b625e335d0aebce880b27770062e395bb1d53e235c22969"),
    second_prime: bytes_of("f67eca3dbbe266f0e373ea2b23dd011f26b5a7a56dd16184e78ebd75c4e2fa84a93e562f5bd6bf066cf82405a033a6382f9f42432402eef7b8fb90964dc24306f7bd0a954373f3ea507397432f42bcab46fb481dc95fb323a4e4191757a386aa3f5c3df1630c97af837938934deeb4ffebc56261d056d860fb26f30dc96c4251"),
    first_exponent: bytes_of("bc4a9216a24509b98d25e884d7ba64b6f50ce2691e00496c0aae20cfab7c6f3d9342c8f718426c5d6e3406e03d45f6fd0873b15c345001573df8fcb3b3e666e915a954423cea8032470e6547aefc5dbec05406fca9ecee9c95c29fe012d41974473e211b193c6f4a6535de1fb7f2565500372135f2bdc44020d9d9e4782eb861"),
    second_exponent: bytes_of("6b77f59e9774259048e0d9a9fe89275d818a52cca57e7062aba18419e2a84ebc4b2b3401fab054a075830425871fdf2135bef7c7db132940629c6ff81478995e77a641044e03ec557366f8952b13daeb851b2abf0f656b0921cd6a92be99723d4f4bd8e208f6bea2510f642001611faaa689e8bdece788a4cffb902692b761b9"),
    coefficient: bytes_of("953889e63796d31ac65641d10a72a05f11019b259d8bcef6363429815fa722a5a32474a1d506fc25906fb9d493f4c8908dc997effc169e57df1064d08e04821cb52010666af16bd512508c7f20b789df316499fea9a25eb2c29549ccaeefccbce419c91d6cca61709c142108e800d9d356dbf2cad31e92e8b75b1786827d02e2"),
  ) is None
}
