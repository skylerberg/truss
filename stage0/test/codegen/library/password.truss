use standard::cryptography
use standard::password
use standard::simulation

let small: cryptography::PasswordCost = cryptography::PasswordCost(memory_kibibytes: 256, iterations: 2, parallelism: 1)

test "password verifies the Argon2id PHC strings that Node made, and only for their passwords" {
  let one = "$argon2id$v=19$m=256,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc"
  let two = "$argon2id$v=19$m=512,t=3,p=2$YW5vdGhlciBzYWx0ISE$GOlPNGJJuYUe8gpub+AgmQ"
  let three = "$argon2id$v=19$m=64,t=1,p=4$MTIzNDU2Nzg$U/YereLQPXegetNBXxjJFXci4eL83pSbvUkWL7Ica2MLr/Mx/EZBgKCR2eSYHr8Y5kEPyQkrRRJ6ScvAuaNUeA"
  assert password::verify("correct horse battery staple", stored: one) == Ok(true)
  assert password::verify("correct horse battery stapler", stored: one) == Ok(false)
  assert password::verify("hunter2", stored: two) == Ok(true)
  assert password::verify("hunter3", stored: two) == Ok(false)
  assert password::verify("", stored: three) == Ok(true)
  assert password::verify(" ", stored: three) == Ok(false)
}

test "password hashes with a fresh salt, verifies its own strings, and asks for a rehash when the cost changes" {
  provide simulation::World.new() {
    let first = password::hash("open sesame", password_cost: small)
    let second = password::hash("open sesame", password_cost: small)
    assert first != second
    assert first.slice().starts_with("$argon2id$v=19$m=256,t=2,p=1$")
    assert password::verify("open sesame", stored: first.slice()) == Ok(true)
    assert password::verify("open sesame!", stored: first.slice()) == Ok(false)
    assert !password::needs_rehash(first.slice(), password_cost: small)
    assert password::needs_rehash(first.slice())
    assert password::needs_rehash("$argon2id$v=19$m=64,t=1,p=4$MTIzNDU2Nzg$U/YereLQPXegetNBXxjJFXci4eL83pSbvUkWL7Ica2MLr/Mx/EZBgKCR2eSYHr8Y5kEPyQkrRRJ6ScvAuaNUeA")
    assert password::needs_rehash("not a hash")
  }
}

test "password rejects strings that are not Argon2id version 19 with a usable cost" {
  assert password::verify("x", stored: "") is Err(_)
  assert password::verify("x", stored: "$argon2i$v=19$m=256,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc") is Err(_)
  assert password::verify("x", stored: "$argon2id$v=16$m=256,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc") is Err(_)
  assert password::verify("x", stored: "$argon2id$v=19$t=2,m=256,p=1$c2FsdHNhbHRzYWx0c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc") is Err(_)
  assert password::verify("x", stored: "$argon2id$v=19$m=4,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc") is Err(_)
  assert password::verify("x", stored: "$argon2id$v=19$m=256,t=0,p=1$c2FsdHNhbHRzYWx0c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc") is Err(_)
  assert password::verify("x", stored: "$argon2id$v=19$m=256,t=2,p=1$c2FsdA$K4eJ1KSOnNuMgOU3u/9wqThRy4yMttohXmobWVFyYEc") is Err(_)
  assert password::verify("x", stored: "$argon2id$v=19$m=256,t=2,p=1$c2FsdHNhbHRzYWx0c2FsdA$!!!") is Err(_)
}
