fn same_items(actual: Slice[Int64], expected: Slice[Int64]) -> Bool {
  if actual.length() != expected.length() {
    return false
  }
  for index in 0..actual.length() {
    if actual[index] != expected[index] {
      return false
    }
  }
  true
}

test "a loop goes over an array's elements in order, and can change them" {
  let fixed: Array[Int64, 4] = [1, 2, 3, 4]
  var total = 0
  var last = 0
  for item in fixed {
    total += item
    last = item
  }
  assert total == 10
  assert last == 4
  var changed: Array[Int64, 3] = [1, 2, 3]
  for item in mut changed {
    item = item * 10
  }
  assert same_items(changed[..], expected: [10, 20, 30])
  let words: Array[String, 2] = ["a${1}", "bb${2}"]
  var lengths: USize = 0
  for word in words {
    lengths += word.length()
  }
  assert lengths == 5
}

test "an array is swapped, reversed, and rotated in place" {
  var fixed: Array[Int64, 5] = [1, 2, 3, 4, 5]
  mut fixed.swap(0, second: 4)
  assert same_items(fixed[..], expected: [5, 2, 3, 4, 1])
  mut fixed.reverse()
  assert same_items(fixed[..], expected: [1, 4, 3, 2, 5])
  mut fixed.rotate_left(2)
  assert same_items(fixed[..], expected: [3, 2, 5, 1, 4])
  mut fixed.rotate_right(1)
  assert same_items(fixed[..], expected: [4, 3, 2, 5, 1])
}

test "fill, copy_from, and update_each replace an array's elements" {
  var fixed: Array[Int64, 3] = [1, 2, 3]
  mut fixed.fill(7)
  assert same_items(fixed[..], expected: [7, 7, 7])
  let source: List[Int64] = [4, 5, 6]
  mut fixed.copy_from(source)
  assert same_items(fixed[..], expected: [4, 5, 6])
  mut fixed.update_each(fn(item) { item = item - 4 })
  assert same_items(fixed[..], expected: [0, 1, 2])
}

test "an array lends its elements to change with their indexes, in pairs, and back to front" {
  var fixed: Array[Int64, 3] = [10, 20, 30]
  for entry in mut fixed.enumerate() {
    if entry.index == 2 {
      entry.element = 0
    }
  }
  assert same_items(fixed[..], expected: [10, 20, 0])
  var other: List[Int64] = [1, 2, 3]
  for pair in mut fixed.zip(mut other[..]) {
    pair.first = pair.first + pair.second
    pair.second = 0
  }
  assert same_items(fixed[..], expected: [11, 22, 3])
  assert same_items(other, expected: [0, 0, 0])
  var next = 1
  for item in mut fixed.reversed() {
    item = next
    next += 1
  }
  assert same_items(fixed[..], expected: [3, 2, 1])
}

test "an array is made of copies of one value, or of what a function gives for each index" {
  let zeros: Array[Int64, 4] = Array.filled(0)
  assert same_items(zeros[..], expected: [0, 0, 0, 0])
  let words: Array[String, 3] = Array.filled("ab${1}")
  assert words[0] == "ab1"
  assert words[2] == "ab1"
  let squares: Array[Int64, 5] = Array.generate(fn(index) { counted_square(index) })
  assert same_items(squares[..], expected: [0, 1, 4, 9, 16])
  let none: Array[Int64, 0] = Array.filled(7)
  assert none[..].length() == 0
}

fn counted_square(index: USize) -> Int64 {
  var total = 0
  for _ in 0..index {
    for _ in 0..index {
      total += 1
    }
  }
  total
}

test "an array's elements are each given to a function, which makes a new array" {
  let numbers: Array[Int64, 3] = [1, 2, 3]
  let doubled: Array[Int64, 3] = numbers.map_each(fn(item) { item * 2 })
  assert same_items(doubled[..], expected: [2, 4, 6])
  let words: Array[String, 2] = ["a${1}", "bb${2}"]
  let lengths: Array[USize, 2] = own words.map_each(fn(word) { word.length() })
  assert lengths[0] == 2
  assert lengths[1] == 3
}

test "an array is searched, joined, and sorted by a comparison" {
  var numbers: Array[Int64, 6] = [4, 1, 5, 2, 6, 3]
  assert numbers.find_slice([5, 2][..]) == Some(2)
  assert numbers.find_slice([2, 5][..]) is None
  assert numbers.join("+") == "4+1+5+2+6+3"
  mut numbers.sort_by(fn(first, second) { first.compare(second) })
  assert numbers == [1, 2, 3, 4, 5, 6]
  assert numbers.binary_search(4) == Some(3)
  assert numbers.binary_search(7) is None
}

test "an array is sorted in place, by key, and into a list" {
  var numbers: Array[Int64, 6] = [4, 1, 5, 2, 6, 3]
  assert numbers.sorted() == [1, 2, 3, 4, 5, 6]
  assert numbers == [4, 1, 5, 2, 6, 3]
  mut numbers.sort_by_key(fn(number) { -number })
  assert numbers == [6, 5, 4, 3, 2, 1]
  mut numbers.sort()
  assert numbers == [1, 2, 3, 4, 5, 6] && numbers.is_sorted()
}

test "an array lends its least and its greatest element by a comparison" {
  let numbers: Array[Int64, 5] = [5, 3, 8, 1, 8]
  assert numbers.min_by(fn(first, second) { first.compare(second) }) == Some(1)
  assert numbers.max_by(fn(first, second) { first.compare(second) }) == Some(8)
}
test "arrays are ordered by their first different element" {
  let low: Array[Int64, 3] = [1, 2, 3]
  let high: Array[Int64, 3] = [1, 3, 0]
  assert low.compare(high) == Ordering.Less && high.compare(low) == Ordering.Greater
  assert low.compare(low.copy()) == Ordering.Equal
  assert low < high && high >= low
}
