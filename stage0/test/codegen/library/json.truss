use standard::json
use standard::network
use standard::serialization
use standard::streams
use standard::url
use standard::uuid

fn kind_of(text: StringSlice) -> Option[json::ParseErrorKind] {
  match json::parse(text) {
    Ok(_) => None
    Err(error) => Some(error.kind)
  }
}

fn round_trip(text: StringSlice) -> Bool {
  match json::parse(text) {
    Ok(value) => value.to_text().slice() == text
    Err(_) => false
  }
}

fn written_text_parses_to_the_same_value(text: StringSlice) -> Bool {
  match json::parse(text) {
    Ok(value) => match json::parse(value.to_text().slice()) {
      Ok(again) => again == value
      Err(_) => false
    }
    Err(_) => false
  }
}

test "parse reads each kind of value" {
  assert json::parse("null") == Ok(json::Value.Null)
  assert json::parse(" true ") is Ok(yes) && yes.as_bool() == Some(true)
  assert json::parse("false") is Ok(no) && no.as_bool() == Some(false)
  assert json::parse("42") is Ok(whole) && whole.as_int64() == Some(42)
  assert json::parse("-0.5e1") is Ok(real) && real.as_float64() == Some(-5.0)
  assert json::parse("\"plain\"") is Ok(text) && text.as_text() == Some("plain")
  assert json::parse("[1, [2, 3], {}]") is Ok(array)
    && array.as_items() is Some(items)
    && items.length() == 3
    && items[0].as_int64() == Some(1)
  assert json::parse("{\"a\": 1, \"b\": {\"c\": [true]}}") is Ok(object)
    && object.get("a") is Some(first)
    && first.as_int64() == Some(1)
    && object.get("missing") is None
    && object.get_index(0) is None
  assert json::parse_bytes("[null]".bytes()) is Ok(from_bytes) && from_bytes.to_text() == "[null]"
}

test "parse decodes the escapes of a string" {
  assert json::parse("\"a\\nb\\tc\\\"d\\\\e\\/f\"") is Ok(escaped) && escaped.as_text() == Some("a\nb\tc\"d\\e/f")
  assert json::parse("\"\\u00e9\\u4e2d\"") is Ok(unicode) && unicode.as_text() == Some("é中")
  assert json::parse("\"\\ud83d\\ude00\"") is Ok(pair) && pair.as_text() == Some("😀")
  assert json::parse("\"é中😀\"") is Ok(direct) && direct.as_text() == Some("é中😀")
  assert kind_of("\"\\x\"") == Some(json::ParseErrorKind.InvalidEscape)
  assert kind_of("\"\\ud83d\"") == Some(json::ParseErrorKind.InvalidUnicode)
  assert kind_of("\"\\ude00\"") == Some(json::ParseErrorKind.InvalidUnicode)
  assert kind_of("\"\\u12\"") == Some(json::ParseErrorKind.InvalidEscape)
}

test "parse rejects text that is not JSON and says where" {
  assert kind_of("") == Some(json::ParseErrorKind.UnexpectedEnd)
  assert kind_of("[1, 2") == Some(json::ParseErrorKind.UnexpectedEnd)
  assert kind_of("\"open") == Some(json::ParseErrorKind.UnexpectedEnd)
  assert kind_of("{\"a\" 1}") == Some(json::ParseErrorKind.UnexpectedCharacter)
  assert kind_of("[1,]") == Some(json::ParseErrorKind.UnexpectedCharacter)
  assert kind_of("{a: 1}") == Some(json::ParseErrorKind.UnexpectedCharacter)
  assert kind_of("nul") == Some(json::ParseErrorKind.UnexpectedEnd)
  assert kind_of("nulx") == Some(json::ParseErrorKind.UnexpectedCharacter)
  assert kind_of("01") == Some(json::ParseErrorKind.InvalidNumber)
  assert kind_of("1.") == Some(json::ParseErrorKind.InvalidNumber)
  assert kind_of("-") == Some(json::ParseErrorKind.InvalidNumber)
  assert kind_of("1e") == Some(json::ParseErrorKind.InvalidNumber)
  assert kind_of("1 2") == Some(json::ParseErrorKind.TrailingCharacters)
  assert kind_of("[[[1]]]") is None
  assert json::parse("[[[1]]]", maximum_depth: 2) is Err(deep) && deep.kind == json::ParseErrorKind.TooDeep
  assert json::parse("[\n  1,\n  x\n]") is Err(placed)
    && placed.kind == json::ParseErrorKind.UnexpectedCharacter
    && placed.offset == 9
    && placed.line == 3
    && placed.column == 3
}

test "a number keeps a whole value exact and any other value as a float" {
  assert json::parse("9007199254740993") is Ok(large) && large.as_int64() == Some(9007199254740993)
  assert json::parse("-9223372036854775808") is Ok(least) && least.as_int64() == Some(Int64.minimum)
  assert json::parse("1.5") is Ok(half) && half.as_int64() is None && half.as_float64() == Some(1.5)
  assert json::parse("1e3") is Ok(thousand) && thousand.as_float64() == Some(1000.0)
  assert json::Number.from_float64(3.0) is Some(three) && three.is_whole() && three.to_int64() == Some(3)
  assert json::Number.from_float64(0.25) is Some(quarter) && !quarter.is_whole() && quarter.to_float64() == 0.25
  assert json::Number.from_float64(Float64.not_a_number) is None
  assert json::Number.from_float64(Float64.infinity) is None
  assert json::Value.from_float64(Float64.not_a_number) is None
  assert round_trip("[0,-1,1.5,0.1,-0.25]")
  assert written_text_parses_to_the_same_value("[1e300,-2.5e-7,1.7976931348623157e308,5e-324,123456789012345680000]")
}

test "a value is written as compact text and as indented text" {
  let text = "{\"name\":\"Ada\",\"tags\":[\"a\",\"b\"],\"age\":36,\"ratio\":0.5,\"none\":null,\"empty\":[],\"object\":{}}"
  assert round_trip(text)
  assert json::parse(text) is Ok(value)
    && value.to_pretty_text()
    == "{\n  \"name\": \"Ada\",\n  \"tags\": [\n    \"a\",\n    \"b\"\n  ],\n  \"age\": 36,\n  \"ratio\": 0.5,\n  \"none\": null,\n  \"empty\": [],\n  \"object\": {}\n}"
  assert json::parse("[1,[2]]") is Ok(nested) && nested.to_pretty_text(indent: 1) == "[\n 1,\n [\n  2\n ]\n]"
  assert json::parse("{\"a\":1}") is Ok(shown) && "${shown}" == "{\"a\":1}"
  assert json::quote("a\"b\\c\n\té") == "\"a\\\"b\\\\c\\n\\té\""
  assert round_trip("\"\\u0001\\u001f\"")
}

type Player(name: String, score: Int64, tags: List[String], rank: Option[UInt8])
  derives Equal, serialization::Serialize, serialization::Deserialize

type Shape =
  | Point
  | Circle(radius: Float64)
  | Labelled(label: String, inner: Player)
  derives Equal, serialization::Serialize, serialization::Deserialize

type Settings(user_name: String, retry_count: UInt32 = 3, shapes: List[Shape] = [])
  derives Equal, serialization::Serialize, serialization::Deserialize

test "a type that derives Serialize and Deserialize goes to JSON and back" {
  let player = Player(name: "Ada", score: 12, tags: ["a", "b"], rank: Some(3))
  let text = json::encode(player)
  assert text == "{\"name\":\"Ada\",\"score\":12,\"tags\":[\"a\",\"b\"],\"rank\":3}"
  let decoded: Result[Player, json::Error] = json::decode(text)
  assert decoded == Ok(own player)
  let unranked: Result[Player, json::Error] = json::decode("{\"name\":\"Bo\",\"score\":-1,\"tags\":[]}")
  assert unranked == Ok(Player(name: "Bo", score: -1, tags: [], rank: None))
  assert json::encode(Player(name: "Bo", score: 0, tags: [], rank: None)) == "{\"name\":\"Bo\",\"score\":0,\"tags\":[],\"rank\":null}"
  assert json::encode_pretty([1, 2]) == "[\n  1,\n  2\n]"
}

test "a sum type's variant is its name, or an object that holds its fields under its name" {
  let shapes: List[Shape] = [
    Shape.Point,
    Shape.Circle(radius: 1.5),
    Shape.Labelled(label: "x", inner: Player(name: "Cy", score: 1, tags: [], rank: None)),
  ]
  let text = json::encode(shapes)
  assert text
    == "[\"Point\",{\"Circle\":{\"radius\":1.5}},{\"Labelled\":{\"label\":\"x\",\"inner\":{\"name\":\"Cy\",\"score\":1,\"tags\":[],\"rank\":null}}}]"
  let decoded: Result[List[Shape], json::Error] = json::decode(text)
  assert decoded == Ok(own shapes)
  let unknown: Result[Shape, json::Error] = json::decode("\"Square\"")
  assert unknown is Err(Deserialize(error)) && "${error}".contains("Square")
  let inside: Result[Shape, json::Error] = json::decode("{\"Circle\":{\"radius\":\"big\"}}")
  assert inside is Err(Deserialize(wrong)) && wrong.path == "/Circle/radius"
}

test "a field with a default may be missing, and names may be written in camel case" {
  let read: Result[Settings, json::Error] = json::decode("{\"user_name\":\"ada\"}")
  assert read == Ok(Settings(user_name: "ada"))
  let settings = Settings(user_name: "bo", retry_count: 5, shapes: [Shape.Point])
  let text = json::encode(settings, names: serialization::Names.CamelCase)
  assert text == "{\"userName\":\"bo\",\"retryCount\":5,\"shapes\":[\"Point\"]}"
  let back: Result[Settings, json::Error] = json::decode(text, names: serialization::Names.CamelCase)
  assert back == Ok(own settings)
  let snake: Result[Settings, json::Error] = json::decode(text)
  assert snake is Err(Deserialize(missing)) && missing.path == "/user_name"
}

type Event(at: Instant, id: uuid::Uuid, source: network::IpAddress, link: url::Url)
  derives Equal, serialization::Serialize, serialization::Deserialize

test "instants, UUIDs, addresses, and URLs are written as their text" {
  let text = "{\"at\":\"2024-01-02T03:04:05Z\",\"id\":\"0b8f5e3c-1d2a-4f6b-9c7e-2a4d6f8b0c1e\",\"source\":\"10.0.0.1\",\"link\":\"https://example.com/a\"}"
  let read: Result[Event, json::Error] = json::decode(text)
  assert read is Ok(event) && json::encode(event) == text
  let wrong: Result[Event, json::Error] = json::decode("{\"at\":\"yesterday\",\"id\":\"x\",\"source\":\"x\",\"link\":\"x\"}")
  assert wrong is Err(Deserialize(error)) && error.path == "/at" && "${error}".contains("instant")
}

test "deserialize says which member has the wrong type or is missing" {
  let wrong: Result[Player, json::Error] = json::decode("{\"name\":\"Ada\",\"score\":\"high\",\"tags\":[]}")
  assert wrong is Err(Deserialize(mismatch)) && mismatch.path == "/score"
  let missing: Result[Player, json::Error] = json::decode("{\"name\":\"Ada\",\"score\":1}")
  assert missing is Err(Deserialize(absent)) && "${absent}".contains("tags")
  let nested: Result[Player, json::Error] = json::decode("{\"name\":\"Ada\",\"score\":1,\"tags\":[\"a\",2]}")
  assert nested is Err(Deserialize(inner)) && inner.path == "/tags/1"
  let outside: Result[Player, json::Error] = json::decode("{\"name\":\"Ada\",\"score\":1,\"tags\":[],\"rank\":256}")
  assert outside is Err(Deserialize(range)) && range.path == "/rank"
  let broken: Result[Player, json::Error] = json::decode("{\"name\":")
  assert broken is Err(Parse(_))
  let numbers: Result[List[UInt8], json::Error] = json::decode("[0, 255]")
  assert numbers == Ok([0, 255])
  let table: Result[Map[String, Bool], json::Error] = json::decode("{\"on\": true, \"off\": false}")
  assert table is Ok(flags) && flags.length() == 2 && flags["on"] && !flags["off"]
  let untyped: Result[json::Value, json::Error] = json::decode("{\"a\":[1,2.5,null,true,\"x\"]}")
  assert untyped is Ok(value) && value.to_text() == "{\"a\":[1,2.5,null,true,\"x\"]}"
}

type Signup(name: String, age: UInt32, team: Team = Team())
  invariant age >= 13 && age <= 150
  invariant name.length() > 0
  derives serialization::Deserialize

type Team(size: UInt32 = 1)
  invariant size > 0
  derives serialization::Deserialize

type Reading =
  | Celsius(degrees: Int32)
  | Kelvin(degrees: Int32)
  invariant !(self is Kelvin(degrees) && degrees < 0)
  derives serialization::Deserialize

test "deserialize rejects a value that breaks its type's invariant, at the value's path" {
  let young: Result[Signup, json::Error] = json::decode("{\"name\":\"Ada\",\"age\":7}")
  assert young is Err(Deserialize(error)) && error.path == "" && error.message == "breaks the invariant `age >= 13 && age <= 150`"
  let unnamed: Result[Signup, json::Error] = json::decode("{\"name\":\"\",\"age\":30}")
  assert unnamed is Err(Deserialize(error)) && error.message == "breaks the invariant `name.length() > 0`"
  let empty: Result[Signup, json::Error] = json::decode("{\"name\":\"Ada\",\"age\":30,\"team\":{\"size\":0}}")
  assert empty is Err(Deserialize(error)) && error.path == "/team" && error.message == "breaks the invariant `size > 0`"
  let valid: Result[Signup, json::Error] = json::decode("{\"name\":\"Ada\",\"age\":30}")
  assert valid is Ok(signup) && signup.age == 30 && signup.team.size == 1
  let cold: Result[Reading, json::Error] = json::decode("{\"Kelvin\":{\"degrees\":-1}}")
  assert cold is Err(Deserialize(_))
  let mild: Result[Reading, json::Error] = json::decode("{\"Celsius\":{\"degrees\":-1}}")
  assert mild is Ok(Celsius(degrees)) && degrees == -1
}

test "a value is read from a reader and written to a writer" {
  provide streams::NoHandles() {
    var source = streams::ByteReader.new("{\"items\": [1, 2, 3]}".bytes())
    assert json::read_from(mut source) is Ok(value)
      && value.get("items") is Some(items)
      && items.get_index(2) is Some(last)
      && last.as_int64() == Some(3)
    var sink = streams::ByteWriter.new()
    assert json::parse("[1, \"two\"]") is Ok(written) && json::write_to(written, sink: mut sink) is Ok(_)
    assert sink.written() == "[1,\"two\"]".bytes()
    var broken = streams::ByteReader.new("[1,".bytes())
    assert json::read_from(mut broken) is Err(Parse(_))
  }
}

fn pointed(text: StringSlice, path: StringSlice) -> Option[String] {
  match json::parse(text) {
    Ok(document) => {
      match document.pointer(path) {
        Some(value) => Some(value.to_text())
        None => None
      }
    }
    Err(_) => None
  }
}

test "a pointer finds the value at a path of member names and positions" {
  let text = "{\"a\": {\"b\": [10, {\"c\": true}]}, \"\": 1, \"m/n\": 2, \"k~l\": 3, \"01\": 4}"
  assert pointed(text, path: "/a/b") == Some("[10,{\"c\":true}]")
  assert pointed(text, path: "/a/b/0") == Some("10")
  assert pointed(text, path: "/a/b/1/c") == Some("true")
  assert pointed(text, path: "/") == Some("1")
  assert pointed(text, path: "/m~1n") == Some("2")
  assert pointed(text, path: "/k~0l") == Some("3")
  assert pointed(text, path: "/01") == Some("4")
  assert pointed("[5]", path: "") == Some("[5]")
  assert pointed(text, path: "/a/b/2") is None
  assert pointed(text, path: "/a/b/01") is None
  assert pointed(text, path: "/a/b/-") is None
  assert pointed(text, path: "/a/b/+1") is None
  assert pointed(text, path: "/a/x") is None
  assert pointed(text, path: "/a/b/0/c") is None
  assert pointed(text, path: "a") is None
  assert pointed(text, path: "/k~2l") is None
  assert pointed(text, path: "/k~") is None
}

test "a template builds a value around the values written in it" {
  let name = "Ada \"the first\""
  let count: Int64 = 3
  let tags: List[json::Value] = [json::Value.from("a"), json::Value.from(true)]
  let built = json::Value"""{"name": ${name.slice()}, "count": ${count}, "tags": ${own tags}, "nested": [ ${false} , null, 1.5]}"""
  assert built.to_text() == "{\"name\":\"Ada \\\"the first\\\"\",\"count\":3,\"tags\":[\"a\",true],\"nested\":[false,null,1.5]}"
  let whole = json::Value"${count}"
  let inner = json::Value"""{"id": ${count}}"""
  let members: Map[String, json::Value] = [:]
  let outer = json::Value"""[${own inner}, ${own members}]"""
  assert outer.to_text() == "[{\"id\":3},{}]"
  assert whole.as_int64() == Some(3)
  let plain = json::Value" [1, 2] "
  assert plain.to_text() == "[1,2]"
}
