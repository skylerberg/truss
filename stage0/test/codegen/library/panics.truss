use standard::tasks

test "Task 2 is receiving from an empty channel." {
  provide tasks::SeededTasks.new(0) {
    let numbers = tasks::Channel[Int64].new()
    concurrent {
      let _ = numbers.receive()
      let _ = numbers.receive()
    }
  }
}

test "Task 1 is sending to a channel that no task is receiving from." {
  provide tasks::SeededTasks.new(0) {
    let numbers = tasks::Channel[Int64].new()
    concurrent {
      let _ = numbers.send(1)
    }
  }
}

test "Task 0 is sending to a full channel." {
  provide tasks::SeededTasks.new(0) {
    let numbers = tasks::Channel[Int64].new(capacity: 1)
    let _ = numbers.send(1)
    let _ = numbers.send(2)
  }
}
