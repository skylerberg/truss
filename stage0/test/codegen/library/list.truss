test "a list splits into two slices that view its elements" {
  let items: List[Int64] = [1, 2, 3, 4, 5]
  let halves = items.split_at(2)
  assert halves.first.length() == 2
  assert halves.second.length() == 3
  assert halves.first[1] == 2
  assert halves.second[0] == 3
  assert halves.second[2] == 5
  let ends = items.split_at(5)
  assert ends.first.length() == 5
  assert ends.second.length() == 0
}

fn set_first(part: mut Slice[Int64], value: Int64)
  requires part.length() > 0
{
  part[0] = value
}

test "an element is replaced through a slice of a list" {
  var items: List[Int64] = [1, 2, 3, 4]
  set_first(mut items[1..3], value: 20)
  assert items[0] == 1
  assert items[1] == 20
  assert items[2] == 3
  set_first(mut items[3..], value: 40)
  assert items[3] == 40
  assert items.length() == 4
}

test "reversed yields elements from the last to the first" {
  let items: List[Int64] = [1, 2, 3]
  var seen: List[Int64] = []
  for item in items.reversed() {
    mut seen.push(item)
  }
  assert seen.length() == 3
  assert seen[0] == 3
  assert seen[1] == 2
  assert seen[2] == 1
  let none: List[Int64] = []
  var count = 0
  for _ in none.reversed() {
    count += 1
  }
  assert count == 0
  let fixed: Array[Int64, 2] = [7, 8]
  var last = 0
  for item in fixed.reversed() {
    last = item
  }
  assert last == 7
}

test "windows yields every run of a size, and none when the list is shorter" {
  let items: List[Int64] = [1, 2, 3, 4]
  var sums: List[Int64] = []
  for window in items.windows(2) {
    assert window.length() == 2
    mut sums.push(window[0] + window[1])
  }
  assert sums.length() == 3
  assert sums[0] == 3
  assert sums[1] == 5
  assert sums[2] == 7
  var whole = 0
  for window in items.windows(4) {
    whole += 1
    assert window.length() == 4
  }
  assert whole == 1
  var none = 0
  for _ in items.windows(5) {
    none += 1
  }
  assert none == 0
}

test "chunks yields runs of a size, with a shorter last one" {
  let items: List[Int64] = [1, 2, 3, 4, 5]
  var lengths: List[USize] = []
  var firsts: List[Int64] = []
  for chunk in items.chunks(2) {
    mut lengths.push(chunk.length())
    mut firsts.push(chunk[0])
  }
  assert lengths.length() == 3
  assert lengths[0] == 2
  assert lengths[1] == 2
  assert lengths[2] == 1
  assert firsts[2] == 5
  var count = 0
  for chunk in items.chunks(9) {
    count += 1
    assert chunk.length() == 5
  }
  assert count == 1
  let none: List[Int64] = []
  var empty = 0
  for _ in none.chunks(3) {
    empty += 1
  }
  assert empty == 0
}

fn same_items(found: Slice[Int64], expected: Slice[Int64]) -> Bool {
  if found.length() != expected.length() {
    return false
  }
  for index in 0..found.length() {
    if found[index] != expected[index] {
      return false
    }
  }
  true
}

fn reverse_part(part: mut Slice[Int64]) {
  mut part.reverse()
}

fn double_each(part: mut Slice[Int64]) {
  for item in mut part {
    item = item * 2
  }
}

test "a list and a part of a list are reversed in place" {
  var items: List[Int64] = [1, 2, 3, 4, 5]
  mut items.reverse()
  assert same_items(items, expected: [5, 4, 3, 2, 1])
  reverse_part(mut items[1..4])
  assert same_items(items, expected: [5, 2, 3, 4, 1])
  var one: List[Int64] = [7]
  mut one.reverse()
  assert same_items(one, expected: [7])
  var none: List[Int64] = []
  mut none.reverse()
  assert none.length() == 0
}

test "rotating moves elements round, left and right" {
  var items: List[Int64] = [1, 2, 3, 4, 5]
  mut items.rotate_left(2)
  assert same_items(items, expected: [3, 4, 5, 1, 2])
  mut items.rotate_right(2)
  assert same_items(items, expected: [1, 2, 3, 4, 5])
  mut items.rotate_right(1)
  assert same_items(items, expected: [5, 1, 2, 3, 4])
  mut items.rotate_left(0)
  assert same_items(items, expected: [5, 1, 2, 3, 4])
  mut items.rotate_left(5)
  assert same_items(items, expected: [5, 1, 2, 3, 4])
}

test "fill and copy_from replace every element" {
  var items: List[Int64] = [1, 2, 3]
  mut items.fill(9)
  assert same_items(items, expected: [9, 9, 9])
  let source: List[Int64] = [4, 5, 6]
  mut items.copy_from(source)
  assert same_items(items, expected: [4, 5, 6])
}

test "update_each and a mut loop change elements where they are" {
  var items: List[Int64] = [1, 2, 3, 4]
  mut items.update_each(fn(item) { item = item + 10 })
  assert same_items(items, expected: [11, 12, 13, 14])
  double_each(mut items[2..])
  assert same_items(items, expected: [11, 12, 26, 28])
}

test "contains and the index searches compare elements" {
  let items: List[Int64] = [3, 1, 4, 1, 5]
  assert items.contains(4)
  assert !items.contains(9)
  assert items.index_of(1) == Some(1)
  assert items.last_index_of(1) == Some(3)
  assert items.index_of(9) is None
  assert items.last_index_of(9) is None
  assert items.find_index(fn(item) { item > 3 }) == Some(2)
  assert items.find_index(fn(item) { item > 9 }) is None
  let none: List[Int64] = []
  assert !none.contains(1)
  assert none.index_of(1) is None
  let fixed: Array[Int64, 3] = [7, 8, 7]
  assert fixed.contains(8)
  assert fixed.index_of(7) == Some(0)
  assert fixed.last_index_of(7) == Some(2)
  let words: List[String] = ["a${1}", "b${2}"]
  assert words.contains("b2")
  assert words.index_of("a1") == Some(0)
  assert !words.contains("c3")
}

test "starts_with and ends_with compare a run of elements" {
  let items: List[Int64] = [1, 2, 3, 4]
  assert items.starts_with([1, 2])
  assert items.starts_with([])
  assert !items.starts_with([2])
  assert !items.starts_with([1, 2, 3, 4, 5])
  assert items.ends_with([3, 4])
  assert items.ends_with([])
  assert !items.ends_with([3])
  assert items.ends_with([1, 2, 3, 4])
}

fn hash_of(items: Slice[Int64]) -> UInt64 {
  var hasher = Hasher.new()
  items.hash(mut hasher)
  hasher.finish()
}

test "partition_point finds where a sorted list stops satisfying a test" {
  let items: List[Int64] = [1, 3, 5, 7, 9]
  assert items.partition_point(fn(item) { item < 6 }) == 3
  assert items.partition_point(fn(item) { item < 0 }) == 0
  assert items.partition_point(fn(item) { item < 100 }) == 5
  assert items.partition_point(fn(item) { item < 1 }) == 0
  assert items.partition_point(fn(item) { item <= 1 }) == 1
  let none: List[Int64] = []
  assert none.partition_point(fn(item) { item < 6 }) == 0
}

test "slices and arrays are equal when their elements are" {
  let first: List[Int64] = [1, 2, 3]
  let second: List[Int64] = [1, 2, 3]
  let shorter: List[Int64] = [1, 2]
  let different: List[Int64] = [1, 2, 4]
  assert first.slice() == second.slice()
  assert first.slice() != shorter.slice()
  assert first.slice() != different.slice()
  assert first[1..] == second[1..]
  assert first[..2] == shorter[..]
  let fixed: Array[Int64, 3] = [1, 2, 3]
  let same: Array[Int64, 3] = [1, 2, 3]
  let other: Array[Int64, 3] = [3, 2, 1]
  assert fixed == same
  assert fixed != other
}

test "equal slices hash alike, and the length is part of the hash" {
  let first: List[Int64] = [1, 2, 3]
  let second: List[Int64] = [1, 2, 3]
  assert hash_of(first) == hash_of(second)
  assert hash_of(first) != hash_of(first[..2])
  let none: List[Int64] = []
  let zero: List[Int64] = [0]
  assert hash_of(none) != hash_of(zero)
}

test "a list is displayed with brackets and commas" {
  let items: List[Int64] = [1, 2, 3]
  assert "${items}" == "[1, 2, 3]"
  let one: List[Int64] = [7]
  assert "${one}" == "[7]"
  let none: List[Int64] = []
  assert "${none}" == "[]"
  let words: List[String] = ["a${1}", "b${2}"]
  assert "${words}" == "[a1, b2]"
  let fixed: Array[Int64, 2] = [4, 5]
  assert "${fixed}" == "[4, 5]"
  let part = fixed.slice()
  assert "${part}" == "[4, 5]"
}

test "to_list copies a slice, and filter copies the elements that pass" {
  let items: List[Int64] = [1, 2, 3, 4, 5, 6]
  let tail = items[2..].to_list()
  assert same_items(tail, expected: [3, 4, 5, 6])
  let even = items.filter(fn(item) { item % 2 == 0 })
  assert same_items(even, expected: [2, 4, 6])
  let none = items.filter(fn(item) { item > 10 })
  assert none.length() == 0
  let words: List[String] = ["a${1}", "bb${2}", "c${3}"]
  let short = words.filter(fn(word) { word.length() == 2 })
  assert short.length() == 2
  assert short[1] == "c3"
  let copies = words.to_list()
  assert copies.length() == 3
  assert copies[1] == "bb2"
}

test "get, first, and last lend an element, or nothing when there is none" {
  let words: List[String] = ["a${1}", "b${2}", "c${3}"]
  assert words.get(1) is Some(word) && word == "b2"
  assert words.get(3) is None
  assert words.first() is Some(word) && word == "a1"
  assert words.last() is Some(word) && word == "c3"
  let none: List[String] = []
  assert none.get(0) is None
  assert none.first() is None
  assert none.last() is None
  assert words[1..].first() is Some(word) && word == "b2"
  let fixed: Array[Int64, 3] = [7, 8, 9]
  assert fixed.get(2) is Some(item) && item == 9
  assert fixed.first() is Some(item) && item == 7
  assert fixed.last() is Some(item) && item == 9
  assert words.length() == 3
}

test "split_first and split_last lend one element and view the rest" {
  let items: List[Int64] = [1, 2, 3]
  assert items.split_first() is Some(split) && split.first == 1 && same_items(split.rest, expected: [2, 3])
  assert items.split_last() is Some(split) && split.last == 3 && same_items(split.rest, expected: [1, 2])
  let one: List[Int64] = [5]
  assert one.split_first() is Some(split) && split.first == 5 && split.rest.length() == 0
  let none: List[Int64] = []
  assert none.split_first() is None
  assert none.split_last() is None
}

test "enumerate yields each element with its index" {
  let words: List[String] = ["a${1}", "b${2}"]
  var seen: USize = 0
  for entry in words.enumerate() {
    assert entry.index == seen
    assert entry.element.length() == 2
    seen += 1
  }
  assert seen == 2
  var items: List[Int64] = [10, 20, 30]
  for entry in mut items.enumerate() {
    if entry.index > 0 {
      entry.element = entry.element + 1
    }
  }
  assert same_items(items, expected: [10, 21, 31])
}

test "zip yields pairs up to the shorter length, and lends both to change" {
  let numbers: List[Int64] = [1, 2, 3]
  let more: List[Int64] = [10, 20]
  var total = 0
  var count = 0
  for pair in numbers.zip(more) {
    total += pair.first * pair.second
    count += 1
  }
  assert count == 2
  assert total == 50
  var left: List[Int64] = [1, 2, 3]
  var right: List[Int64] = [10, 20, 30]
  for pair in mut left.zip(mut right[..]) {
    let kept = pair.first
    pair.first = pair.second
    pair.second = kept
  }
  assert same_items(left, expected: [10, 20, 30])
  assert same_items(right, expected: [1, 2, 3])
}

test "reversed lends elements to change, from the last to the first" {
  var items: List[Int64] = [1, 2, 3]
  var next = 100
  for item in mut items.reversed() {
    item = next
    next += 1
  }
  assert same_items(items, expected: [102, 101, 100])
}

test "a list is made of copies of a value, or of what a function gives for each index" {
  let zeros: List[Int64] = List.filled(0, count: 3)
  assert same_items(zeros, expected: [0, 0, 0])
  let words: List[String] = List.filled("ab${1}", count: 2)
  assert words.length() == 2
  assert words[1] == "ab1"
  let none: List[Int64] = List.filled(7, count: 0)
  assert none.length() == 0
  let doubles: List[USize] = List.generate(4, make: fn(index) { index * 2 })
  assert doubles.length() == 4
  assert doubles[0] == 0
  assert doubles[3] == 6
}

test "clear and truncate drop elements from the end and keep the room" {
  var items: List[Int64] = [1, 2, 3, 4, 5]
  let room = items.capacity()
  mut items.truncate(3)
  assert same_items(items, expected: [1, 2, 3])
  mut items.truncate(10)
  assert same_items(items, expected: [1, 2, 3])
  mut items.clear()
  assert items.length() == 0
  assert items.capacity() == room
  var words: List[String] = ["a${1}", "b${2}", "c${3}"]
  mut words.truncate(1)
  assert words.length() == 1
  assert words[0] == "a1"
  mut words.shrink_to_fit()
  assert words.capacity() == 1
  assert words[0] == "a1"
}

test "swap_remove, remove_range, and split_off take elements out" {
  var items: List[Int64] = [1, 2, 3, 4, 5, 6, 7]
  assert mut items.swap_remove(1) == 2
  assert same_items(items, expected: [1, 7, 3, 4, 5, 6])
  assert mut items.swap_remove(5) == 6
  assert same_items(items, expected: [1, 7, 3, 4, 5])
  mut items.remove_range(1..3)
  assert same_items(items, expected: [1, 4, 5])
  mut items.remove_range(1..1)
  assert same_items(items, expected: [1, 4, 5])
  mut items.remove_range(0..3)
  assert items.length() == 0
  var letters: List[Int64] = [10, 20, 30, 40, 50]
  mut letters.remove_range(0..2)
  assert same_items(letters, expected: [30, 40, 50])
  let tail = mut letters.split_off(1)
  assert same_items(letters, expected: [30])
  assert same_items(tail, expected: [40, 50])
  let everything = mut letters.split_off(0)
  assert letters.length() == 0
  assert same_items(everything, expected: [30])
}

test "retain, filter, and deduplicate keep elements in their order" {
  var items: List[Int64] = [1, 2, 3, 4, 5, 6]
  mut items.retain(fn(item) { item % 2 == 0 })
  assert same_items(items, expected: [2, 4, 6])
  mut items.retain(fn(item) { item > 100 })
  assert items.length() == 0
  let odd: List[Int64] = [1, 2, 3, 4, 5]
  let kept = own odd.filter(fn(item) { item % 2 == 1 })
  assert same_items(kept, expected: [1, 3, 5])
  var runs: List[Int64] = [1, 1, 2, 2, 2, 3, 1, 1]
  mut runs.deduplicate()
  assert same_items(runs, expected: [1, 2, 3, 1])
  var single: List[Int64] = [9]
  mut single.deduplicate()
  assert same_items(single, expected: [9])
  var empty: List[Int64] = []
  mut empty.deduplicate()
  assert empty.length() == 0
}

test "the smallest and the largest element are lent, the first of equals" {
  let items: List[Int64] = [3, 1, 4, 1, 5, 9, 2, 6]
  assert items.minimum() is Some(least) && least == 1
  assert items.maximum() is Some(greatest) && greatest == 9
  let part = items[4..]
  assert part.minimum() is Some(least) && least == 2
  let none: List[Int64] = []
  assert none.minimum() is None
  assert none.maximum() is None
  let fixed: Array[Int64, 3] = [7, -2, 7]
  assert fixed.minimum() is Some(least) && least == -2
  assert fixed.maximum() is Some(greatest) && greatest == 7
}

test "a slice is repeated, and split where an element is" {
  let items: List[Int64] = [1, 2]
  assert same_items(items.repeated(3), expected: [1, 2, 1, 2, 1, 2])
  assert items.repeated(0).length() == 0
  let fixed: Array[Int64, 1] = [5]
  assert same_items(fixed.repeated(2), expected: [5, 5])
  let fields: List[Int64] = [1, 0, 2, 3, 0, 0, 4]
  var lengths: List[USize] = []
  var total = 0
  for part in fields.split(0) {
    mut lengths.push(part.length())
    for item in part {
      total += item
    }
  }
  assert lengths.length() == 4
  assert lengths[0] == 1
  assert lengths[1] == 2
  assert lengths[2] == 0
  assert lengths[3] == 1
  assert total == 10
  let none: List[Int64] = []
  var parts = 0
  for part in none.split(0) {
    parts += 1
    assert part.length() == 0
  }
  assert parts == 1
}

test "append moves another list's elements onto the end, in order" {
  var items: List[Int64] = [1, 2]
  mut items.append([3, 4, 5])
  assert same_items(items, expected: [1, 2, 3, 4, 5])
  mut items.append([])
  assert same_items(items, expected: [1, 2, 3, 4, 5])
  var empty: List[Int64] = []
  mut empty.append([9])
  assert same_items(empty, expected: [9])
  var words: List[String] = ["a${1}"]
  let more: List[String] = ["b${2}", "c${3}"]
  mut words.append(own more)
  assert words.length() == 3
  assert words[0] == "a1"
  assert words[1] == "b2"
  assert words[2] == "c3"
}

test "binary_search finds an element of a sorted list, or reports that it is absent" {
  let numbers: List[Int64] = [1, 3, 5, 7, 9, 11]
  assert numbers.binary_search(1) == Some(0)
  assert numbers.binary_search(7) == Some(3)
  assert numbers.binary_search(11) == Some(5)
  assert numbers.binary_search(0) is None
  assert numbers.binary_search(6) is None
  assert numbers.binary_search(12) is None
  let none: List[Int64] = []
  assert none.binary_search(1) is None
  assert numbers[1..4].binary_search(5) == Some(1)
  let words: List[String] = ["apple", "banana", "cherry"]
  assert words.binary_search("banana") == Some(1)
  assert words.binary_search("blueberry") is None
}

test "find_slice finds the first place where a slice occurs" {
  let numbers: List[Int64] = [1, 2, 1, 2, 3, 1, 2, 3, 4]
  assert numbers.find_slice([1, 2, 3][..]) == Some(2)
  assert numbers.find_slice([1, 2, 3, 4][..]) == Some(5)
  assert numbers.find_slice([4][..]) == Some(8)
  assert numbers.find_slice([2, 2][..]) is None
  assert numbers.find_slice([1, 2, 1, 2, 3, 1, 2, 3, 4, 5][..]) is None
  let none: List[Int64] = []
  assert numbers.find_slice(none[..]) == Some(0)
  assert none.find_slice([1][..]) is None
  let repeated: List[Int64] = [0, 0, 0, 0, 1]
  assert repeated.find_slice([0, 0, 1][..]) == Some(2)
}

test "join writes each element with the separator between them" {
  let numbers: List[Int64] = [1, 2, 3]
  assert numbers.join(", ") == "1, 2, 3"
  assert numbers.join("") == "123"
  assert numbers[..1].join(", ") == "1"
  let none: List[Int64] = []
  assert none.join(", ") == ""
  let words: List[String] = ["a", "b"]
  assert words.join("-") == "a-b"
}

test "sort_by orders a list by a comparison" {
  var numbers: List[Int64] = [5, 3, 8, 1, 9, 2, 7, 3]
  mut numbers.sort_by(fn(first, second) { first.compare(second) })
  assert numbers == [1, 2, 3, 3, 5, 7, 8, 9]
  mut numbers.sort_by(fn(first, second) { second.compare(first) })
  assert numbers == [9, 8, 7, 5, 3, 3, 2, 1]
  var one: List[Int64] = [4]
  mut one.sort_by(fn(first, second) { first.compare(second) })
  assert one == [4]
  var none: List[Int64] = []
  mut none.sort_by(fn(first, second) { first.compare(second) })
  assert none.is_empty()
  var many: List[Int64] = []
  for value in 0..300 {
    mut many.push((value * 73) % 211)
  }
  mut many.sort_by(fn(first, second) { first.compare(second) })
  assert many.length() == 300 && many.is_sorted()
  var words: List[String] = ["pear", "fig", "banana"]
  mut words.sort_by(fn(first, second) { first.length().compare(second.length()) })
  assert words == ["fig", "pear", "banana"]
  mut words[1..].sort_by(fn(first, second) { first.compare(second) })
  assert words == ["fig", "banana", "pear"]
}

test "sort orders a list, and binary_search then finds its elements" {
  var numbers: List[Int64] = [5, 3, 8, 1, 9, 2, 7, 3]
  mut numbers.sort()
  assert numbers == [1, 2, 3, 3, 5, 7, 8, 9]
  assert numbers.is_sorted()
  assert numbers.binary_search(7) == Some(5)
  var one: List[Int64] = [4]
  mut one.sort()
  assert one == [4]
  var none: List[Int64] = []
  mut none.sort()
  assert none.is_empty()
  var two: List[Int64] = [2, 1]
  mut two.sort()
  assert two == [1, 2]
  var many: List[Int64] = []
  for value in 0..500 {
    mut many.push((value * 73) % 211)
  }
  mut many.sort()
  assert many.length() == 500 && many.is_sorted()
  assert many[0] == 0 && many[499] == 210
  var words: List[String] = ["pear", "fig", "banana", "apple"]
  mut words.sort()
  assert words == ["apple", "banana", "fig", "pear"]
  var part: List[Int64] = [9, 8, 7, 6, 5]
  mut part[1..4].sort()
  assert part == [9, 6, 7, 8, 5]
}

test "sorted returns a sorted copy and leaves the list as it was" {
  let numbers: List[Int64] = [3, 1, 2]
  assert numbers.sorted() == [1, 2, 3]
  assert numbers == [3, 1, 2]
  assert numbers[1..].sorted() == [1, 2]
  let none: List[Int64] = []
  assert none.sorted().is_empty()
}

test "sort_by_key orders a list by what a function gives for each element" {
  var words: List[String] = ["pear", "fig", "banana", "kiwi"]
  mut words.sort_by_key(fn(word) { word.length() })
  assert words[0] == "fig" && words[3] == "banana"
  assert words[1].length() == 4 && words[2].length() == 4
  var numbers: List[Int64] = [3, -1, 2, -5]
  mut numbers.sort_by_key(fn(number) { number * number })
  assert numbers == [-1, 2, 3, -5]
  let offset: Int64 = 10
  mut numbers.sort_by_key(fn(number) { (number - offset) * (number - offset) })
  assert numbers == [3, 2, -1, -5]
}
