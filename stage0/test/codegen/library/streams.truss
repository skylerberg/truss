use standard::streams

type Trickle(received: List[UInt8], step: USize)

impl streams::Writer for Trickle {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    var accepted: USize = 0
    while accepted < self.step && accepted < bytes.length() {
      mut self.received.push(bytes[accepted])
      accepted += 1
    }
    Ok(accepted)
  }

  fn flush(mut self) -> Result[Unit, SystemError] {
    Ok(Unit)
  }
}

test "write_all writes until a writer has taken every byte" {
  provide streams::NoHandles() {
    var slow = Trickle(received: [], step: 2)
    assert mut slow.write_text("hello") is Ok(_)
    assert slow.received.length() == 5
    assert slow.received[0] == 104
    assert slow.received[4] == 111
  }
}

test "write_all stops when a writer takes nothing" {
  provide streams::NoHandles() {
    var stuck = Trickle(received: [], step: 0)
    assert mut stuck.write_all("hi".bytes()) is Err(NothingWritten)
    assert mut stuck.write_all("".bytes()) is Ok(_)
    assert stuck.received.length() == 0
  }
}

type Drip(bytes: List[UInt8], position: USize, step: USize)

impl streams::Reader for Drip {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError] {
    var read_count: USize = 0
    while read_count < self.step && read_count < limit && self.position < self.bytes.length() {
      mut buffer.push(self.bytes[self.position])
      self.position += 1
      read_count += 1
    }
    Ok(read_count)
  }
}

fn drip(text: StringSlice, step: USize) -> Drip {
  Drip(bytes: text.to_bytes(), position: 0, step: step)
}

fn same_text(bytes: Slice[UInt8], expected: StringSlice) -> Bool {
  String.from_utf8_lossy(bytes) == expected.to_string()
}

test "a reader that gives a little at a time is read to an exact count, to its end, and past" {
  provide streams::NoHandles() {
    var source = drip("hello world", step: 3)
    var buffer: List[UInt8] = []
    assert mut source.read_exactly(mut buffer, count: 5) is Ok(_)
    assert same_text(buffer, expected: "hello")
    assert mut source.skip(1) == Ok(1)
    assert mut source.read_text() is Ok(rest) && rest == "world"
    assert mut source.read_to_end(mut buffer) == Ok(0)
    assert mut source.read_exactly(mut buffer, count: 1) is Err(error) && error == SystemError.UnexpectedEnd
    assert mut source.skip(10) == Ok(0)
    var whole = drip("abcdefgh", step: 3)
    var all: List[UInt8] = [33]
    assert mut whole.read_to_end(mut all) == Ok(8)
    assert same_text(all, expected: "!abcdefgh")
    var broken = Drip(bytes: [104, 255], position: 0, step: 5)
    assert mut broken.read_text() is Err(error) && error == SystemError.InvalidData
  }
}

test "a byte reader gives its bytes, and a byte writer keeps its input" {
  provide streams::NoHandles() {
    let bytes: List[UInt8] = [1, 2, 3, 4, 5]
    var reader = streams::ByteReader.new(bytes)
    var buffer: List[UInt8] = []
    assert mut reader.read(mut buffer, limit: 2) == Ok(2)
    assert reader.remaining().length() == 3
    assert mut reader.read(mut buffer, limit: 10) == Ok(3)
    assert mut reader.read(mut buffer, limit: 10) == Ok(0)
    assert buffer.length() == 5
    assert buffer[0] == 1
    assert buffer[4] == 5
    var writer = streams::ByteWriter.new()
    assert mut writer.write_all(buffer) is Ok(_)
    assert mut writer.write_text("!") is Ok(_)
    assert writer.written().length() == 6
    let finished = own writer.finish()
    assert finished[5] == 33
  }
}

test "a buffered reader gives lines, with either line end or none at the end" {
  provide streams::NoHandles() {
    var reader = streams::BufferedReader.new(drip("one\ntwo\r\n\nlast", step: 4), capacity: 8)
    assert mut reader.read_line() is Ok(Some(line)) && line == "one"
    assert mut reader.read_line() is Ok(Some(line)) && line == "two"
    assert mut reader.read_line() is Ok(Some(line)) && line == ""
    assert mut reader.read_line() is Ok(Some(line)) && line == "last"
    assert mut reader.read_line() is Ok(None)
    assert mut reader.read_line() is Ok(None)
    var counted = streams::BufferedReader.new(drip("a\nbb\nccc\n", step: 2))
    var lengths: USize = 0
    var lines: USize = 0
    while mut counted.read_line() is Ok(Some(text)) {
      assert text.length() == lines + 1
      lines += 1
      lengths += lines
    }
    assert lines == 3
    assert lengths == 6
  }
}

test "a buffered reader reads up to a byte, peeks at the next bytes, and returns its source" {
  provide streams::NoHandles() {
    var reader = streams::BufferedReader.new(drip("key=value;rest", step: 5), capacity: 4)
    var buffer: List[UInt8] = []
    assert mut reader.read_until(61, buffer: mut buffer) == Ok(4)
    assert same_text(buffer, expected: "key=")
    assert mut reader.peek(3) is Ok(coming) && same_text(coming, expected: "val")
    assert mut reader.peek(3) is Ok(coming) && same_text(coming, expected: "val")
    mut buffer.clear()
    assert mut reader.read_until(59, buffer: mut buffer) == Ok(6)
    assert same_text(buffer, expected: "value;")
    mut buffer.clear()
    assert mut reader.read(mut buffer, limit: 2) == Ok(2)
    assert mut reader.read_until(59, buffer: mut buffer) == Ok(2)
    assert same_text(buffer, expected: "rest")
    assert mut reader.read_until(59, buffer: mut buffer) == Ok(0)
    assert mut reader.peek(5) is Ok(coming) && coming.length() == 0
    let source = own reader.finish()
    assert source.position == 14
  }
}

test "a buffered writer holds bytes until it has no more room, or is flushed" {
  provide streams::NoHandles() {
    var writer = streams::BufferedWriter.new(Trickle(received: [], step: 100), capacity: 4)
    assert mut writer.write_text("ab") is Ok(_)
    assert mut writer.write_text("cde") is Ok(_)
    assert mut writer.write_line("fghij") is Ok(_)
    assert mut writer.flush() is Ok(_)
    let sink = own writer.finish()
    assert same_text(sink.received, expected: "abcdefghij\n")
    var slow = streams::BufferedWriter.new(Trickle(received: [], step: 1), capacity: 3)
    assert mut slow.write_all("abcdefg".bytes()) is Ok(_)
    assert mut slow.flush() is Ok(_)
    let trickled = own slow.finish()
    assert same_text(trickled.received, expected: "abcdefg")
  }
}

test "copy moves every byte, and a limited reader stops at its limit" {
  provide streams::NoHandles() {
    var source = drip("0123456789", step: 3)
    var sink = streams::ByteWriter.new()
    assert streams::copy(mut source, sink: mut sink) == Ok(10)
    assert same_text(sink.written(), expected: "0123456789")
    var limited = streams::Limited.new(drip("0123456789", step: 3), limit: 4)
    var buffer: List[UInt8] = []
    assert mut limited.read_to_end(mut buffer) == Ok(4)
    assert same_text(buffer, expected: "0123")
    let rest = own limited.finish()
    assert rest.position == 4
  }
}
