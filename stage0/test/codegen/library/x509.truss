fn one(text: StringSlice) -> x509::Certificate
  uses Panic
{
  match x509::parse_pem(text) {
    Ok(certificates) => certificates[0].copy()
    Err(_) => Panic.crash("a certificate")
  }
}

fn now() -> Instant
  uses Panic
{
  Instant.from_unix_seconds(1900000000).expect("in range")
}

test "a certificate is read: names, validity, key, and extensions" {
  let leaf = one(leaf_pem.slice())
  assert leaf.common_name() == Some("example.test".slice())
  assert leaf.dns_names().length() == 2 && !leaf.is_authority()
  assert leaf.public_key() is Ecdsa(key) && key.curve() == cryptography::Curve.P384
  assert leaf.not_before() < now() && now() < leaf.not_after()
  let intermediate = one(intermediate_pem.slice())
  assert intermediate.is_authority() && intermediate.public_key() is Rsa(_)
  assert der::parse(leaf.encoded()) is Ok(_)
}

test "a chain verifies up to a trusted root, and fails for another host, time, or root" {
  let chain: List[x509::Certificate] = [one(leaf_pem.slice()), one(intermediate_pem.slice())]
  let roots: List[x509::Certificate] = [one(root_pem.slice())]
  assert x509::verify_chain(chain, roots: roots, host: "example.test", now: now()) == Ok(Unit)
  assert x509::verify_chain(chain, roots: roots, host: "API.Apps.Example.Test", now: now()) == Ok(Unit)
  assert x509::verify_chain(chain, roots: roots, host: "10.1.2.3", now: now()) == Ok(Unit)
  assert x509::verify_chain(chain, roots: roots, host: "a.b.apps.example.test", now: now()) == Err(x509::VerifyError.WrongHost)
  assert x509::verify_chain(chain, roots: roots, host: "other.test", now: now()) == Err(x509::VerifyError.WrongHost)
  let early = Instant.from_unix_seconds(1000000000).expect("in range")
  assert x509::verify_chain(chain, roots: roots, host: "example.test", now: early) == Err(x509::VerifyError.NotYetValid)
  let no_roots: List[x509::Certificate] = []
  assert x509::verify_chain(chain, roots: no_roots, host: "example.test", now: now()) == Err(x509::VerifyError.UnknownIssuer)
  let only_leaf: List[x509::Certificate] = [one(leaf_pem.slice())]
  assert x509::verify_chain(only_leaf, roots: roots, host: "example.test", now: now()) == Err(x509::VerifyError.UnknownIssuer)
  let leaf_as_issuer: List[x509::Certificate] = [one(intermediate_pem.slice())]
  assert x509::verify_chain(leaf_as_issuer, roots: roots, host: "example.test", now: now()) is Err(_)
}

test "PKCS #8 keys are read, and sign what their certificates' keys verify" {
  let blocks = x509::pem_blocks(leaf_key_pem.slice(), label: "PRIVATE KEY")
  assert blocks.length() == 1
  assert x509::parse_private_key(blocks[0]) is Some(Ecdsa(key)) && key.verifying_key().curve() == cryptography::Curve.P384
  let rsa_blocks = x509::pem_blocks(intermediate_key_pem.slice(), label: "PRIVATE KEY")
  assert x509::parse_private_key(rsa_blocks[0]) is Some(Rsa(private))
    && one(intermediate_pem.slice()).public_key() == x509::PublicKey.Rsa(key: private.public_key())
}

test "an ECDSA signature goes to DER and back" {
  var raw: List[UInt8] = List.filled(1, count: 64)
  raw[0] = 200
  raw[32] = 0
  let encoded = x509::ecdsa_signature_to_der(raw)
  assert x509::ecdsa_signature_from_der(encoded, size: 32) == Some(own raw)
}

test "the system's roots are read from the first bundle present" {
  var disk = files::MemoryFiles.new().with_text(Path.new("/etc/ssl/cert.pem"), contents: root_pem.slice())
  provide mut disk {
    assert x509::system_roots() is Ok(roots) && roots.length() == 1
  }
}
