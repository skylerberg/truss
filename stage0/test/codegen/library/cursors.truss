use standard::simulation

type Counter(next: Int64, stop: Int64)

impl Cursor for Counter {
  type Element = Int64

  fn next(mut self) -> Option[Int64] {
    if self.next >= self.stop {
      None
    } else {
      let value = self.next
      self.next += 1
      Some(value)
    }
  }
}

fn count_to(stop: Int64) -> Counter {
  Counter(next: 1, stop: stop + 1)
}

test "a cursor is collected, counted, and folded, and gives its last value" {
  assert count_to(3).to_list() == [1, 2, 3]
  assert count_to(5).count() == 5
  assert count_to(5).last() == Some(5)
  assert count_to(5).fold(0, combine: fn(total, item) { total + item }) == 15
  assert count_to(0).count() == 0
  assert count_to(0).last() is None
  assert count_to(0).to_list().length() == 0
}

test "find takes values up to the first that matches, and the cursor continues from there" {
  var cursor = count_to(6)
  assert mut cursor.find(fn(item) { item > 3 }) == Some(4)
  assert mut cursor.next() == Some(5)
  assert mut cursor.find(fn(item) { item > 9 }) is None
  assert mut cursor.next() is None
}

test "skip, take, and step_by choose which values a cursor gives" {
  assert count_to(7).skip(2).to_list() == [3, 4, 5, 6, 7]
  assert count_to(7).skip(9).to_list() == []
  assert count_to(7).take(3).to_list() == [1, 2, 3]
  assert count_to(7).take(0).to_list() == []
  assert count_to(7).take(9).to_list() == [1, 2, 3, 4, 5, 6, 7]
  assert count_to(7).step_by(3).to_list() == [1, 4, 7]
  assert count_to(7).step_by(1).to_list() == [1, 2, 3, 4, 5, 6, 7]
  assert count_to(7).skip(1).step_by(2).take(2).to_list() == [2, 4]
}

test "chain gives one cursor's values and then another's" {
  assert count_to(2).chain(Counter(next: 7, stop: 9)).to_list() == [1, 2, 7, 8]
  assert count_to(0).chain(count_to(1)).to_list() == [1]
  assert count_to(2).chain(count_to(0)).to_list() == [1, 2]
}

test "zip pairs two cursors up to the shorter, and enumerate counts from zero" {
  var total = 0
  var pairs: UInt64 = 0
  var zipped = Counter(next: 10, stop: 13).zip(count_to(2))
  while mut zipped.next() is Some(pair) {
    total += pair.first * pair.second
    pairs += 1
  }
  assert pairs == 2
  assert total == 32
  var counted = Counter(next: 10, stop: 13).enumerate()
  var weighted = 0
  var last_index: UInt64 = 0
  while mut counted.next() is Some(indexed) {
    last_index = indexed.index
    weighted += indexed.element
  }
  assert last_index == 2
  assert weighted == 33
}

test "a peekable cursor shows the next value without taking it" {
  var cursor = Counter(next: 7, stop: 9).peekable()
  assert mut cursor.peek() == Some(7)
  assert mut cursor.peek() == Some(7)
  assert mut cursor.next() == Some(7)
  assert mut cursor.next() == Some(8)
  assert mut cursor.peek() is None
  assert mut cursor.next() is None
}

type Letters(left: UInt64)

impl Cursor for Letters {
  type Element = Character

  fn next(mut self) -> Option[Character] {
    if self.left == 0 {
      None
    } else {
      self.left -= 1
      Some(if self.left % 2 == 0 { Character"\u{e9}" } else { Character"h" })
    }
  }
}

test "a list and a string are collected from a cursor, and a list is extended by one" {
  let collected: List[Int64] = List.collect(count_to(4).skip(1))
  assert collected == [2, 3, 4]
  var longer: List[Int64] = [0]
  mut longer.extend(count_to(9).take(2))
  assert longer == [0, 1, 2]
  mut longer.extend(count_to(0))
  assert longer == [0, 1, 2]
  let text: String = String.collect(Letters(left: 4))
  assert text == "h\u{e9}h\u{e9}"
}

test "the adapters and the trait's methods work on a list's cursor" {
  let items: List[Int64] = [1, 2, 3, 4, 5, 6, 7]
  assert items.cursor().skip(2).to_list() == [3, 4, 5, 6, 7]
  assert items.cursor().take(3).to_list() == [1, 2, 3]
  assert items.cursor().step_by(3).to_list() == [1, 4, 7]
  assert items.cursor().skip(1).step_by(2).take(2).to_list() == [2, 4]
  assert items.cursor().count() == 7
  assert items.cursor().last() == Some(7)
  assert items.cursor().fold(0, combine: fn(total, item) { total + item }) == 28
  let collected: List[Int64] = List.collect(items.cursor().skip(5))
  assert collected == [6, 7]
  var cursor = items.cursor().peekable()
  assert mut cursor.peek() == Some(1)
  assert mut cursor.next() == Some(1)
  assert mut cursor.find(fn(item) { item > 5 }) == Some(6)
  let text = "h\u{e9}llo"
  let start: String = String.collect(text.characters().take(2))
  assert start == "h\u{e9}"
  assert text.characters().count() == 5
  assert text.characters().skip(4).last() == Some(Character"o")
}

fn sum_after_the_first(items: own List[Int64], count: UInt64) -> Int64
  cost time finite
{
  var cursor = own items.cursor().skip(1).take(count)
  var total = 0
  var pulled: UInt64 = 0
  while pulled < count {
    pulled += 1
    match mut cursor.next() {
      Some(item) => {
        total = total.saturating_add(item)
      }
      None => {}
    }
  }
  total
}

fn positions_of_the_first_two(items: own List[String]) -> List[UInt64]
  cost time finite
{
  var cursor = own items.cursor().enumerate().take(2)
  var positions: List[UInt64] = []
  if mut cursor.next() is Some(first) {
    mut positions.push(first.index)
  }
  if mut cursor.next() is Some(second) {
    mut positions.push(second.index)
  }
  positions
}

test "a function with a time clause pulls the adapters over a list's cursor" {
  assert sum_after_the_first([5, 7, 11, 13], count: 2) == 18
  assert sum_after_the_first([5, 7, 11, 13], count: 9) == 31
  assert sum_after_the_first([], count: 3) == 0
  let both: List[UInt64] = [0, 1]
  assert positions_of_the_first_two(["a", "b", "c"]) == both
  let one: List[UInt64] = [0]
  assert positions_of_the_first_two(["a"]) == one
}

type Typed(most: UInt64)

type LineLengths(most: UInt64, read_count: UInt64)

impl Cursor for LineLengths {
  type Element = UInt64
  capability Uses = Console

  fn next(mut self) -> Option[UInt64]
    uses Console
  {
    if self.read_count >= self.most {
      return None
    }
    match Console.read_line() {
      Some(line) => {
        self.read_count += 1
        Some(line.length())
      }
      None => None
    }
  }
}

fn Typed.line_lengths(self) -> LineLengths {
  LineLengths(most: self.most, read_count: 0)
}

fn typing(lines: own List[String]) -> simulation::World {
  simulation::World.from(simulation::Setup.new().with_input(own lines))
}

test "the adapters work on a cursor that uses a capability" uses Panic {
  let typed = Typed(most: 100)
  provide typing(["a", "bb", "ccc", "dddd", "eeeee", "ffffff"]) {
    let middle: List[UInt64] = [2, 3]
    assert typed.line_lengths().skip(1).take(2).to_list() == middle
    let stepped: List[UInt64] = [4, 6]
    assert typed.line_lengths().step_by(2).to_list() == stepped
  }
  provide typing(["a", "bb", "ccc"]) {
    assert typed.line_lengths().enumerate().fold(0, combine: fn(total, entry) { total + entry.index * entry.element }) == 8
  }
  provide typing(["a", "bb", "ccc", "dddd"]) {
    assert Typed(most: 1).line_lengths().chain(typed.line_lengths()).count() == 4
  }
  provide typing(["a", "bb", "ccc", "dddd"]) {
    assert typed.line_lengths().zip(typed.line_lengths()).fold(0, combine: fn(total, pair) { total + pair.first * pair.second }) == 14
  }
  provide typing(["a", "bb"]) {
    var cursor = typed.line_lengths().peekable()
    assert mut cursor.peek() == Some(1)
    assert mut cursor.next() == Some(1)
    assert mut cursor.find(fn(length) { length > 1 }) == Some(2)
    assert mut cursor.next() is None
  }
  provide typing(["a", "bb", "ccc"]) {
    let collected: List[UInt64] = List.collect(typed.line_lengths().skip(1))
    let rest: List[UInt64] = [2, 3]
    assert collected == rest
    var longer: List[UInt64] = [9]
    mut longer.extend(typed.line_lengths())
    assert longer.length() == 1
  }
}
