use standard::collections

fn set_of(elements: List[Int64]) -> collections::SortedSet[Int64] {
  var sorted: collections::SortedSet[Int64] = collections::SortedSet.new()
  for element in elements {
    mut sorted.insert(element)
  }
  sorted
}

fn listed(sorted: collections::SortedSet[Int64]) -> List[Int64] {
  var elements: List[Int64] = []
  for element in sorted {
    mut elements.push(element)
  }
  elements
}

fn or_minus_one(element: Option[Int64]) -> Int64 {
  match element {
    Some(present) => present
    None => -1
  }
}

fn listed_within(sorted: collections::SortedSet[Int64], range: Range[Int64]) -> List[Int64] {
  var elements: List[Int64] = []
  for element in sorted.in_range(range) {
    mut elements.push(element)
  }
  elements
}

test "a sorted set keeps its elements in order, each once" {
  var sorted = set_of([5, 1, 4, 1, 2, 5, 3])
  assert sorted.length() == 5 && !sorted.is_empty()
  assert listed(sorted) == [1, 2, 3, 4, 5]
  var backwards: List[Int64] = []
  for element in sorted.reversed() {
    mut backwards.push(element)
  }
  assert backwards == [5, 4, 3, 2, 1]
  assert sorted.contains(4) && !sorted.contains(6) && !sorted.contains(0)
  assert or_minus_one(sorted.first()) == 1 && or_minus_one(sorted.last()) == 5
  assert mut sorted.insert_new(6) && !mut sorted.insert_new(6) && !mut sorted.insert_new(1)
  assert listed(sorted) == [1, 2, 3, 4, 5, 6]
  let empty: collections::SortedSet[Int64] = collections::SortedSet.new()
  assert empty.is_empty() && empty.first() is None && empty.last() is None && !empty.contains(1)
}

test "elements are removed by value and from either end" {
  var sorted = set_of([1, 2, 3, 4, 5, 6])
  mut sorted.remove(3)
  mut sorted.remove(30)
  assert listed(sorted) == [1, 2, 4, 5, 6]
  assert mut sorted.take(5) == Some(5) && mut sorted.take(5) is None
  assert mut sorted.pop_first() == Some(1) && mut sorted.pop_last() == Some(6)
  assert listed(sorted) == [2, 4]
  mut sorted.clear()
  assert sorted.is_empty() && mut sorted.pop_first() is None && mut sorted.pop_last() is None
  mut sorted.insert(8)
  assert listed(sorted) == [8]
}

test "a sorted set finds the elements nearest a value and those within a range" {
  let sorted = set_of([10, 20, 30, 40])
  assert or_minus_one(sorted.at_or_before(20)) == 20 && or_minus_one(sorted.at_or_before(25)) == 20
  assert or_minus_one(sorted.at_or_before(5)) == -1 && or_minus_one(sorted.at_or_before(99)) == 40
  assert or_minus_one(sorted.at_or_after(20)) == 20 && or_minus_one(sorted.at_or_after(25)) == 30
  assert or_minus_one(sorted.at_or_after(5)) == 10 && or_minus_one(sorted.at_or_after(41)) == -1
  assert listed_within(sorted, range: 15..35) == [20, 30]
  assert listed_within(sorted, range: 20..40) == [20, 30]
  assert listed_within(sorted, range: 20..=40) == [20, 30, 40]
  assert listed_within(sorted, range: 0..100) == [10, 20, 30, 40]
  assert listed_within(sorted, range: 10..10).is_empty()
  assert listed_within(sorted, range: 35..15).is_empty()
  let empty: collections::SortedSet[Int64] = collections::SortedSet.new()
  assert empty.at_or_before(1) is None && empty.at_or_after(1) is None
  assert listed_within(empty, range: 0..9).is_empty()
}

test "retain keeps the elements a function accepts, in order" {
  var sorted = set_of([6, 5, 4, 3, 2, 1])
  mut sorted.retain(fn(element) { element % 2 == 0 })
  assert listed(sorted) == [2, 4, 6] && !sorted.contains(5)
  mut sorted.retain(fn(element) { element > 100 })
  assert sorted.is_empty()
}

test "a sorted set is made from elements in any order" {
  let elements: List[Int64] = [3, 1, 3, 2, 3, 1]
  let sorted: collections::SortedSet[Int64] = collections::SortedSet.from(elements.copy())
  assert listed(sorted) == [1, 2, 3]
  var collected: collections::SortedSet[Int64] = collections::SortedSet.collect(elements.copy().cursor())
  assert collected == sorted
  let more: List[Int64] = [9, 2, 0, 2, 7]
  mut collected.extend(more.copy().cursor())
  assert listed(collected) == [0, 1, 2, 3, 7, 9]
  var fresh: collections::SortedSet[Int64] = collections::SortedSet.default()
  mut fresh.extend(more.copy().cursor())
  assert listed(fresh) == [0, 2, 7, 9]
  var owned: List[Int64] = []
  for element in own fresh {
    mut owned.push(element)
  }
  assert owned == [0, 2, 7, 9]
}

test "sorted sets are joined, intersected, and subtracted" {
  let odd = set_of([1, 3, 5, 7, 9])
  let low = set_of([1, 2, 3, 4, 5])
  let none: collections::SortedSet[Int64] = collections::SortedSet.new()
  assert listed(odd.union(low)) == [1, 2, 3, 4, 5, 7, 9]
  assert listed(low.union(odd)) == [1, 2, 3, 4, 5, 7, 9]
  assert listed(odd.intersection(low)) == [1, 3, 5]
  assert listed(odd.difference(low)) == [7, 9]
  assert listed(low.difference(odd)) == [2, 4]
  assert listed(odd.union(none)) == [1, 3, 5, 7, 9] && listed(none.union(odd)) == [1, 3, 5, 7, 9]
  assert odd.intersection(none).is_empty() && none.intersection(odd).is_empty()
  assert listed(odd.difference(none)) == [1, 3, 5, 7, 9] && none.difference(odd).is_empty()
  assert odd.difference(odd).is_empty() && listed(odd.intersection(odd)) == [1, 3, 5, 7, 9]
}

test "one sorted set is within, around, or apart from another" {
  let odd = set_of([1, 3, 5, 7, 9])
  let few = set_of([3, 7])
  let even = set_of([2, 4, 6])
  let none: collections::SortedSet[Int64] = collections::SortedSet.new()
  assert few.is_subset_of(odd) && !odd.is_subset_of(few) && odd.is_subset_of(odd)
  assert odd.is_superset_of(few) && !few.is_superset_of(odd)
  assert none.is_subset_of(odd) && odd.is_superset_of(none) && !odd.is_subset_of(none)
  assert !set_of([3, 8]).is_subset_of(odd) && !set_of([0, 3]).is_subset_of(odd) && !set_of([3, 11]).is_subset_of(odd)
  assert odd.is_disjoint_from(even) && even.is_disjoint_from(odd) && !odd.is_disjoint_from(few)
  assert none.is_disjoint_from(odd) && odd.is_disjoint_from(none)
  assert !set_of([2, 9]).is_disjoint_from(odd)
}

test "sorted sets are equal when their elements are, hash alike, and copy apart" {
  let first = set_of([1, 2, 3])
  var second = set_of([3, 1, 2])
  assert first == second
  var first_hasher = Hasher.new()
  var second_hasher = Hasher.new()
  first.hash(mut first_hasher)
  second.hash(mut second_hasher)
  assert first_hasher.finish() == second_hasher.finish()
  mut second.insert(4)
  assert first != second
  var copied = first.copy()
  mut copied.remove(1)
  assert first.length() == 3 && copied.length() == 2 && first != copied
}

test "a sorted set of many elements inserted out of order stays in order" {
  var sorted: collections::SortedSet[Int64] = collections::SortedSet.new()
  for step in 0..101 {
    mut sorted.insert(step * 37 % 101)
  }
  assert sorted.length() == 101
  var expected: Int64 = 0
  for element in sorted {
    assert element == expected
    expected += 1
  }
  for element in 0..101 {
    if element % 3 == 0 {
      mut sorted.remove(element)
    }
  }
  assert sorted.length() == 67
  for element in 0..101 {
    assert sorted.contains(element) == (element % 3 != 0)
  }
  assert or_minus_one(sorted.at_or_after(33)) == 34 && or_minus_one(sorted.at_or_before(33)) == 32
}

test "a sorted set orders text by its bytes" {
  var sorted: collections::SortedSet[String] = collections::SortedSet.new()
  mut sorted.insert("pear")
  mut sorted.insert("apple")
  mut sorted.insert("fig")
  mut sorted.insert("apple")
  var order = ""
  for element in sorted {
    mut order.push(element.slice())
    mut order.push(" ")
  }
  assert order == "apple fig pear " && sorted.contains("fig") && !sorted.contains("plum")
}
