use standard::jwk
use standard::jwt
use standard::serialization
use standard::simulation

type Claims(sub: String, exp: Int64, iss: String, aud: List[String])
  derives Equal, serialization::Serialize, serialization::Deserialize

type Short(sub: String, exp: Int64)
  derives Equal, serialization::Serialize, serialization::Deserialize

type Starting(sub: String, exp: Int64, nbf: Int64)
  derives serialization::Serialize

type Unexpiring(sub: String)
  derives serialization::Serialize

fn key(text: StringSlice) -> jwk::Key
  uses Panic
{
  match jwk::Key.parse(text) {
    Ok(key) => own key
    Err(error) => Panic.crash("${error}".slice())
  }
}

fn rules(algorithm: jwt::Algorithm) -> jwt::Validation {
  jwt::Validation(algorithms: [algorithm], issuer: Some("https://issuer.test"), audience: Some("web"))
}
