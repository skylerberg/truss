use standard::tasks

fn counted(count: Int64) -> List[Int64] {
  var numbers: List[Int64] = []
  for number in 0..count {
    mut numbers.push(number)
  }
  numbers
}

fn produce(numbers: tasks::Channel[Int64], count: Int64)
  uses Tasks
{
  for number in 0..count {
    let _ = numbers.send(number)
  }
  numbers.close()
}

fn collect[Message: Storable](messages: tasks::Channel[Message]) -> List[Message]
  uses Tasks
{
  var received: List[Message] = []
  for message in messages.messages() {
    mut received.push(own message)
  }
  received
}

fn includes(orders: List[List[Int64]], order: List[Int64]) -> Bool {
  for other in orders {
    if other == order {
      return true
    }
  }
  false
}

test "a channel delivers messages in the order they were sent" {
  provide tasks::SeededTasks.new(1) {
    let numbers = tasks::Channel[Int64].new(capacity: 3)
    assert numbers.send(1) is Ok(_)
    assert numbers.send(2) is Ok(_)
    assert numbers.send(3) is Ok(_)
    assert numbers.receive() == Some(1)
    assert numbers.try_receive() == Some(2)
    assert numbers.receive() == Some(3)
    assert numbers.try_receive() is None
  }
}

test "a copy of a channel refers to the same queue" {
  provide tasks::SeededTasks.new(2) {
    let texts = tasks::Channel[String].new(capacity: 2)
    let other = texts.copy()
    assert other.send("sent ${1}") is Ok(_)
    assert texts.receive() == Some("sent 1")
    texts.close()
    assert other.send("late") is Err(Closed)
  }
}

test "a closed channel refuses messages and delivers the messages it holds" {
  provide tasks::SeededTasks.new(3) {
    let numbers = tasks::Channel[Int64].new(capacity: 2)
    assert numbers.send(1) is Ok(_)
    numbers.close()
    assert numbers.send(2) is Err(Closed)
    assert numbers.receive() == Some(1)
    assert numbers.receive() is None
    assert "${tasks::SendError.Closed}" == "the channel is closed"
    assert "${tasks::SendError.Cancelled}" == "the task was cancelled"
  }
}

fn produce_from(numbers: tasks::Channel[Int64], first: Int64, count: Int64)
  uses Tasks
{
  for index in 0..count {
    let _ = numbers.send(first + 2 * index)
  }
}

fn with_parity(numbers: List[Int64], parity: Int64) -> List[Int64] {
  var selected: List[Int64] = []
  for number in numbers {
    if number % 2 == parity {
      mut selected.push(number)
    }
  }
  selected
}

fn stepping(first: Int64, count: Int64) -> List[Int64] {
  var numbers: List[Int64] = []
  for index in 0..count {
    mut numbers.push(first + 2 * index)
  }
  numbers
}

test "the messages of each sender arrive in the order it sent them" {
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let numbers = tasks::Channel[Int64].new(capacity: 2)
      concurrent {
        {
          concurrent {
            produce_from(numbers, first: 0, count: 6)
            produce_from(numbers, first: 1, count: 6)
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      assert received.length() == 12
      assert with_parity(received, parity: 0) == stepping(0, count: 6)
      assert with_parity(received, parity: 1) == stepping(1, count: 6)
    }
  }
}

test "send waits while the channel is full and receive waits while it is empty" {
  let capacities: List[USize] = [0, 1, 2, 64]
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    for capacity in capacities {
      provide tasks::SeededTasks.new(seed) {
        let numbers = tasks::Channel[Int64].new(capacity: capacity)
        concurrent {
          produce(numbers, count: 12)
          let received = collect(numbers)
        }
        assert received == counted(12)
      }
    }
  }
}

test "a send to a channel of capacity 0 returns after a task has received the message" {
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let numbers = tasks::Channel[Int64].new()
      concurrent {
        {
          for number in 0..6 {
            assert numbers.send(number) is Ok(_)
            assert numbers.try_receive() is None
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      assert received == counted(6)
    }
  }
}

test "every message of several senders arrives once, in each sender's order" {
  let senders: USize = 4
  let steps: USize = 5
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let numbers = tasks::Channel[USize].new(capacity: 2)
      concurrent {
        {
          concurrent for sender in 0..senders {
            for step in 0..steps {
              let _ = numbers.send(sender * 10 + step)
            }
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      var next: List[USize] = [0, 0, 0, 0]
      for number in received {
        let sender = number / 10
        assert sender < 4 && number % 10 == next[sender]
        next[sender] = next[sender] + 1
      }
      assert next == [5, 5, 5, 5]
    }
  }
}

test "the order in which tasks run depends on the seed" {
  var orders: List[List[Int64]] = []
  let seeds: UInt64 = 64
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let numbers = tasks::Channel[Int64].new(capacity: 3)
      concurrent for sender in 0..3 {
        let _ = numbers.send(sender)
      }
      numbers.close()
      let order = collect(numbers)
      if !includes(orders, order: order) {
        mut orders.push(own order)
      }
    }
  }
  assert orders.length() == 6
}

test "one seed gives one order" {
  var first: List[Int64] = []
  for attempt in 0..3 {
    provide tasks::SeededTasks.new(7) {
      let numbers = tasks::Channel[Int64].new(capacity: 8)
      concurrent for sender in 0..8 {
        let _ = numbers.send(sender)
      }
      numbers.close()
      let order = collect(numbers)
      if attempt == 0 {
        first = own order
      } else {
        assert order == first
      }
    }
  }
}

fn receive_or_leave(numbers: tasks::Channel[Int64]) -> Int64
  uses Tasks
{
  concurrent {
    {
      let _ = numbers.receive()
      return 1
    }
    return 2
  }
}

test "leaving a concurrent block cancels a task that waits to receive" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      assert receive_or_leave(tasks::Channel[Int64].new()) == 2
    }
  }
}

fn send_or_leave(numbers: tasks::Channel[Int64], outcomes: tasks::Channel[Bool])
  uses Tasks
{
  concurrent {
    {
      let outcome = numbers.send(5)
      let _ = outcomes.send(outcome is Err(Cancelled))
    }
    return
  }
}

test "a cancelled send fails with Cancelled and leaves no message in the channel" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let outcomes = tasks::Channel[Bool].new(capacity: 1)
      let unbuffered = tasks::Channel[Int64].new()
      send_or_leave(unbuffered, outcomes: outcomes)
      assert outcomes.try_receive() == Some(true)
      assert unbuffered.try_receive() is None
      concurrent {
        produce(unbuffered, count: 3)
        let received = collect(unbuffered)
      }
      assert received == counted(3)

      let full = tasks::Channel[Int64].new(capacity: 1)
      assert full.send(4) is Ok(_)
      send_or_leave(full, outcomes: outcomes)
      assert outcomes.try_receive() == Some(true)
      assert full.try_receive() == Some(4)
      assert full.try_receive() is None
    }
  }
}

fn count_until_cancelled() -> Int64
  uses Tasks
{
  var polls = 0
  concurrent {
    {
      while !Tasks.cancelled() {
        polls += 1
      }
      return polls
    }
    return -1
  }
}

test "a task that polls Tasks.cancelled lets the other tasks run" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      assert count_until_cancelled() == -1
    }
  }
}

type StoppedClock(never: tasks::Channel[Int64])

impl Clock for StoppedClock
  uses Tasks
{
  fn now(self) -> Instant {
    Instant.from_unix_nanoseconds(0)
  }

  fn monotonic(self) -> Duration {
    Duration.seconds(0)
  }

  fn sleep(self, duration: Duration) {
    let _ = self.never.receive()
  }
}

type InstantClock()

impl Clock for InstantClock {
  fn now(self) -> Instant {
    Instant.from_unix_nanoseconds(0)
  }

  fn monotonic(self) -> Duration {
    Duration.seconds(0)
  }

  fn sleep(self, duration: Duration) {}
}

test "with_timeout returns the output of work that ends before the limit" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      provide StoppedClock(never: tasks::Channel[Int64].new()) {
        assert tasks::with_timeout(Duration.seconds(1), work: fn() { 7 }) == Some(7)
      }
    }
  }
}

test "with_timeout cancels work that is still waiting at the limit" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed), InstantClock() {
      let never = tasks::Channel[Int64].new()
      assert tasks::with_timeout(Duration.seconds(1), work: fn() { never.receive() }) is None
    }
  }
}

fn hold_each(limiter: tasks::Limiter, events: tasks::Channel[Int64])
  uses Tasks
{
  concurrent for _ in 0..6 {
    let _ = limiter.hold(fn() {
      let _ = events.send(1)
      Tasks.yield_now()
      let _ = events.send(-1)
    })
  }
  events.close()
}

test "a limiter runs at most as many tasks at once as it has permits" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let events = tasks::Channel[Int64].new(capacity: 12)
      hold_each(tasks::Limiter.new(2), events: events)
      var holding = 0
      var most = 0
      var held = 0
      for event in events.messages() {
        holding += event
        if event == 1 {
          held += 1
        }
        if holding > most {
          most = holding
        }
      }
      assert held == 6 && holding == 0 && most <= 2
    }
  }
}

capability Accounts {
  fn deposit(amount: Int64)
  fn balance() -> Int64
}

type Bank(balance: Int64)

impl Accounts for Bank {
  fn deposit(mut self, amount: Int64) {
    self.balance += amount
  }

  fn balance(self) -> Int64 {
    self.balance
  }
}

test "tasks change the state of one capability implementation" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    var bank = Bank(balance: 0)
    provide mut bank, tasks::SeededTasks.new(seed) {
      concurrent {
        Accounts.deposit(10)
        Accounts.deposit(5)
        concurrent for amount in 1..=4 {
          Accounts.deposit(amount)
        }
      }
      assert Accounts.balance() == 25
    }
    assert bank.balance == 25
  }
}

type SlowBank(balance: Int64)

impl Accounts for SlowBank
  uses Tasks
{
  fn deposit(mut self, amount: Int64) {
    let before = self.balance
    Tasks.yield_now()
    self.balance = before + amount
  }

  fn balance(self) -> Int64 {
    self.balance
  }
}

test "calls of a `mut` capability implementation are mutually exclusive" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      var bank = SlowBank(balance: 0)
      provide mut bank {
        concurrent for amount in 1..=6 {
          Accounts.deposit(amount)
        }
        assert Accounts.balance() == 21
      }
    }
  }
}

test "tasks spawn tasks of their own" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide tasks::SeededTasks.new(seed) {
      let numbers = tasks::Channel[Int64].new(capacity: 4)
      concurrent {
        {
          concurrent for outer in 0..3 {
            concurrent for inner in 0..3 {
              let _ = numbers.send(outer * 3 + inner)
            }
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      var sum = 0
      for number in received {
        sum += number
      }
      assert received.length() == 9 && sum == 36
    }
  }
}
