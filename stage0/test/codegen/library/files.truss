use standard::files
use standard::random
use standard::streams

fn shows(path: Path, expected: StringSlice) -> Bool {
  match path.text() {
    Some(text) => text == expected
    None => false
  }
}

fn holds(actual: Option[StringSlice], expected: StringSlice) -> Bool {
  match actual {
    Some(text) => text == expected
    None => false
  }
}

test "joining puts one separator between two paths, and an absolute part replaces" {
  assert shows(Path.new("a").join("b"), expected: "a/b")
  assert shows(Path.new("a/").join("b"), expected: "a/b")
  assert shows(Path.new("/").join("b"), expected: "/b")
  assert shows(Path.new("").join("b"), expected: "b")
  assert shows(Path.new("a").join("/b"), expected: "/b")
  assert shows(Path.new("a").join(""), expected: "a/")
  assert shows(Path.new("a/b").join_path(Path.new("c/d")), expected: "a/b/c/d")
  assert Path.new("/usr").is_absolute()
  assert !Path.new("usr").is_absolute()
  assert !Path.new("").is_absolute()
}

test "a path's parent is the path without its last component" {
  assert Path.new("a/b/c").parent() is Some(parent) && shows(parent, expected: "a/b")
  assert Path.new("a/b/").parent() is Some(parent) && shows(parent, expected: "a")
  assert Path.new("a//b").parent() is Some(parent) && shows(parent, expected: "a")
  assert Path.new("/a").parent() is Some(parent) && shows(parent, expected: "/")
  assert Path.new("a").parent() is Some(parent) && shows(parent, expected: "")
  assert Path.new("/").parent() is None
  assert Path.new("").parent() is None
}

test "a path's file name, stem, and extension come from its last component" {
  let archive = Path.new("backups/archive.tar.gz")
  assert holds(archive.file_name(), expected: "archive.tar.gz")
  assert holds(archive.stem(), expected: "archive.tar")
  assert holds(archive.extension(), expected: "gz")
  let hidden = Path.new("/home/user/.profile")
  assert holds(hidden.file_name(), expected: ".profile")
  assert holds(hidden.stem(), expected: ".profile")
  assert hidden.extension() is None
  let plain = Path.new("notes/")
  assert holds(plain.file_name(), expected: "notes")
  assert plain.extension() is None
  let dotted = Path.new("name.")
  assert holds(dotted.stem(), expected: "name")
  assert holds(dotted.extension(), expected: "")
  assert Path.new("/").file_name() is None
  assert Path.new("a/..").file_name() is None
  assert Path.new("").file_name() is None
}

test "the file name and the extension can be replaced" {
  assert shows(Path.new("a/b.txt").with_extension("md"), expected: "a/b.md")
  assert shows(Path.new("a/b").with_extension("md"), expected: "a/b.md")
  assert shows(Path.new("a/b.tar.gz").with_extension(""), expected: "a/b.tar")
  assert shows(Path.new("a/b.txt").with_file_name("c.md"), expected: "a/c.md")
  assert shows(Path.new("b.txt").with_file_name("c"), expected: "c")
  assert shows(Path.new("/").with_file_name("c"), expected: "/c")
}

test "components are the names between separators" {
  var names: List[String] = []
  for component in Path.new("/usr//local/bin/").components() {
    mut names.push(component.to_string())
  }
  assert names.length() == 3
  assert names[0] == "usr"
  assert names[1] == "local"
  assert names[2] == "bin"
  var none = 0
  for _ in Path.new("/").components() {
    none += 1
  }
  assert none == 0
}

test "a path starts with another when its first components are the other's" {
  assert Path.new("/usr/local/bin").starts_with(Path.new("/usr/local"))
  assert Path.new("/usr/local/bin").starts_with(Path.new("/usr/local/"))
  assert Path.new("/usr/local").starts_with(Path.new("/usr/local"))
  assert !Path.new("/usr/locale").starts_with(Path.new("/usr/local"))
  assert !Path.new("/usr").starts_with(Path.new("/usr/local"))
  assert !Path.new("usr/local").starts_with(Path.new("/usr"))
  assert Path.new("a/b").starts_with(Path.new(""))
  assert Path.new("/usr/local/bin").relative_to(Path.new("/usr")) is Some(rest) && shows(rest, expected: "local/bin")
  assert Path.new("/usr").relative_to(Path.new("/usr")) is Some(rest) && shows(rest, expected: "")
  assert Path.new("/usr/locale").relative_to(Path.new("/usr/local")) is None
  assert Path.new("a/b/c").relative_to(Path.new("a")) is Some(rest) && shows(rest, expected: "b/c")
}

test "a path is made from bytes only when they are UTF-8" {
  let valid: List[UInt8] = [47, 116, 109, 112]
  assert Path.from_bytes(own valid) is Some(path) && shows(path, expected: "/tmp")
  let invalid: List[UInt8] = [47, 255]
  assert Path.from_bytes(own invalid) is None
}

test "normalizing drops empty and single-dot components and resolves double dots" {
  assert shows(Path.new("a/b/../c").normalized(), expected: "a/c")
  assert shows(Path.new("a/./b").normalized(), expected: "a/b")
  assert shows(Path.new("a//b/").normalized(), expected: "a/b")
  assert shows(Path.new("./a").normalized(), expected: "a")
  assert shows(Path.new("a/b/c/../../d").normalized(), expected: "a/d")
  assert shows(Path.new("a/..").normalized(), expected: ".")
  assert shows(Path.new("").normalized(), expected: ".")
  assert shows(Path.new(".").normalized(), expected: ".")
  assert shows(Path.new("a/../b").normalized(), expected: "b")
  assert shows(Path.new("abc/def").normalized(), expected: "abc/def")
}

test "normalizing keeps the double dots that lead out of a relative path, and none above the root" {
  assert shows(Path.new("../a").normalized(), expected: "../a")
  assert shows(Path.new("a/../..").normalized(), expected: "..")
  assert shows(Path.new("../../a/../b").normalized(), expected: "../../b")
  assert shows(Path.new("a/../../b/../c").normalized(), expected: "../c")
  assert shows(Path.new("/").normalized(), expected: "/")
  assert shows(Path.new("//").normalized(), expected: "/")
  assert shows(Path.new("/..").normalized(), expected: "/")
  assert shows(Path.new("/a/../..").normalized(), expected: "/")
  assert shows(Path.new("/a/b/../../../c").normalized(), expected: "/c")
  assert shows(Path.new("/a/b/..").normalized(), expected: "/a")
  assert shows(Path.new("/usr//local/./bin/").normalized(), expected: "/usr/local/bin")
}

fn joins_to(base: StringSlice, part: StringSlice, expected: StringSlice) -> Bool {
  match Path.new(base).join_confined(Path.new(part)) {
    Ok(joined) => shows(joined, expected: expected)
    Err(_) => false
  }
}

fn refused(base: StringSlice, part: StringSlice) -> Bool {
  Path.new(base).join_confined(Path.new(part)) is Err(error) && error == SystemError.PermissionDenied
}

test "joining within a directory refuses a part that would leave it" {
  assert joins_to("/srv/data", part: "a/b", expected: "/srv/data/a/b")
  assert joins_to("/srv/data", part: "a/../b", expected: "/srv/data/b")
  assert joins_to("/srv/data", part: "./a//b/", expected: "/srv/data/a/b")
  assert joins_to("/srv/data", part: ".", expected: "/srv/data")
  assert joins_to("/srv/data", part: "", expected: "/srv/data")
  assert joins_to("/srv/data", part: "a/..", expected: "/srv/data")
  assert joins_to("data", part: "x", expected: "data/x")
  assert joins_to("", part: "x", expected: "x")
  assert joins_to("/srv/data", part: "..a", expected: "/srv/data/..a")
  assert refused("/srv/data", part: "..")
  assert refused("/srv/data", part: "../x")
  assert refused("/srv/data", part: "a/../../x")
  assert refused("/srv/data", part: "a/b/../../..")
  assert refused("/srv/data", part: "/etc/passwd")
  assert refused("data", part: "/x")
}

fn path_of(text: StringSlice) -> Path {
  Path.new(text)
}

test "memory files hold the files of their setup and make the directories above them" {
  var memory = files::MemoryFiles.new()
    .with_text(path_of("/etc/app/config.toml"), contents: "port = 80")
    .with_bytes(path_of("/data/blob"), contents: [1, 2, 3])
  assert memory.text(path_of("/etc/app/config.toml")) == Some("port = 80")
  assert memory.contents(path_of("/data/blob")) == Some([1, 2, 3])
  assert memory.text(path_of("/missing")) is None
  assert memory.paths().length() == 2
  provide mut memory {
    assert FileRead.read_text(path_of("/etc/app/config.toml")) == Ok("port = 80")
    assert FileRead.read(path_of("/data/blob")) == Ok([1, 2, 3])
    assert FileRead.read(path_of("/etc/app")) == Err(SystemError.IsADirectory)
    assert FileRead.read(path_of("/etc/none")) == Err(SystemError.NotFound)
    assert FileRead.read(path_of("/data/blob/below")) == Err(SystemError.NotADirectory)
    assert FileRead.metadata(path_of("/etc/app")) is Ok(directory) && directory.is_directory()
    assert FileRead.metadata(path_of("/data/blob")) is Ok(blob) && blob.is_file() && blob.length == 3
    assert FileRead.read_text(path_of("etc/./app/../app/config.toml")) == Ok("port = 80")
  }
}

test "memory files write, replace, list, and remove" {
  var memory = files::MemoryFiles.new()
  provide mut memory {
    assert FileWrite.write_text(path_of("/notes.txt"), contents: "first") is Ok(_)
    assert FileWrite.write_text(path_of("/notes.txt"), contents: "second") is Ok(_)
    assert FileRead.read_text(path_of("/notes.txt")) == Ok("second")
    assert FileWrite.write_text(path_of("/none/notes.txt"), contents: "x") == Err(SystemError.NotFound)
    assert FileWrite.create_directory(path_of("/logs")) is Ok(_)
    assert FileWrite.create_directory(path_of("/logs")) == Err(SystemError.AlreadyExists)
    assert FileWrite.write(path_of("/logs/a"), contents: [7]) is Ok(_)
    assert FileRead.list(path_of("/")) is Ok(entries)
      && entries.length() == 2
      && entries[0].name == "notes.txt"
      && entries[0].kind == files::FileKind.File
      && entries[1].name == "logs"
      && entries[1].kind == files::FileKind.Directory
    assert FileRead.list(path_of("/notes.txt")) is Err(NotADirectory)
    assert FileWrite.remove(path_of("/logs")) == Err(SystemError.DirectoryNotEmpty)
    assert FileWrite.remove(path_of("/logs/a")) is Ok(_)
    assert FileWrite.remove(path_of("/logs")) is Ok(_)
    assert FileWrite.remove(path_of("/logs")) == Err(SystemError.NotFound)
    assert FileWrite.remove(path_of("/")) == Err(SystemError.PermissionDenied)
    assert files::is_present(path_of("/notes.txt")) && !files::is_present(path_of("/logs"))
  }
}

test "memory files rename a file and a directory with the names below it" {
  var memory = files::MemoryFiles.new()
    .with_text(path_of("/project/source/main.truss"), contents: "main")
    .with_text(path_of("/project/README"), contents: "read")
    .with_text(path_of("/other"), contents: "other")
  provide mut memory {
    assert FileWrite.rename(path_of("/project"), to: path_of("/renamed")) is Ok(_)
    assert FileRead.read_text(path_of("/renamed/source/main.truss")) == Ok("main")
    assert FileRead.read_text(path_of("/renamed/README")) == Ok("read")
    assert FileRead.read(path_of("/project/README")) == Err(SystemError.NotFound)
    assert FileWrite.rename(path_of("/other"), to: path_of("/renamed/README")) is Ok(_)
    assert FileRead.read_text(path_of("/renamed/README")) == Ok("other")
    assert FileWrite.rename(path_of("/renamed"), to: path_of("/renamed/source/inside")) == Err(SystemError.InvalidInput)
    assert FileWrite.rename(path_of("/renamed/README"), to: path_of("/renamed/source")) == Err(SystemError.IsADirectory)
    assert FileWrite.rename(path_of("/none"), to: path_of("/else")) == Err(SystemError.NotFound)
  }
}

test "memory files follow symbolic links and share the bytes of hard links" {
  var memory = files::MemoryFiles.new().with_text(path_of("/real/data"), contents: "data")
  provide mut memory {
    assert FileWrite.link(path_of("/real"), link: path_of("/alias"), kind: files::LinkKind.Symbolic) is Ok(_)
    assert FileRead.read_text(path_of("/alias/data")) == Ok("data")
    assert FileRead.read_link(path_of("/alias")) is Ok(target) && "${target}" == "/real"
    assert FileRead.read_link(path_of("/real")) == Err(SystemError.InvalidInput)
    assert FileRead.resolve(path_of("/alias/data")) is Ok(resolved) && "${resolved}" == "/real/data"
    assert FileRead.metadata(path_of("/alias"), follow_links: false) is Ok(link)
      && link.kind == files::FileKind.SymbolicLink
    assert FileRead.metadata(path_of("/alias")) is Ok(followed) && followed.is_directory()
    assert FileWrite.link(path_of("relative"), link: path_of("/real/loop"), kind: files::LinkKind.Symbolic) is Ok(_)
    assert FileWrite.link(path_of("loop"), link: path_of("/real/relative"), kind: files::LinkKind.Symbolic) is Ok(_)
    assert FileRead.read(path_of("/real/loop")) == Err(SystemError.InvalidInput)

    assert FileWrite.link(path_of("/real/data"), link: path_of("/copy"), kind: files::LinkKind.Hard) is Ok(_)
    assert FileWrite.write_text(path_of("/copy"), contents: "changed") is Ok(_)
    assert FileRead.read_text(path_of("/real/data")) == Ok("changed")
    assert FileWrite.remove(path_of("/real/data")) is Ok(_)
    assert FileRead.read_text(path_of("/copy")) == Ok("changed")
    assert FileWrite.link(path_of("/real"), link: path_of("/hard"), kind: files::LinkKind.Hard)
      == Err(SystemError.PermissionDenied)
    assert FileWrite.link(path_of("/copy"), link: path_of("/alias"), kind: files::LinkKind.Hard)
      == Err(SystemError.AlreadyExists)
  }
}

test "memory files refuse what a file's permissions forbid" {
  var memory = files::MemoryFiles.new().with_text(path_of("/secret"), contents: "hidden")
  provide mut memory {
    assert FileWrite.set_permissions(path_of("/secret"), permissions: files::Permissions.from_mode(0o444)) is Ok(_)
    assert FileWrite.write_text(path_of("/secret"), contents: "new") == Err(SystemError.PermissionDenied)
    assert FileWrite.open(path_of("/secret"), mode: files::WriteMode.Append) is Err(PermissionDenied)
    assert FileRead.read_text(path_of("/secret")) == Ok("hidden")
    assert FileWrite.set_permissions(path_of("/secret"), permissions: files::Permissions.from_mode(0o200)) is Ok(_)
    assert FileRead.read_text(path_of("/secret")) == Err(SystemError.PermissionDenied)
    assert FileRead.open(path_of("/secret")) is Err(PermissionDenied)
    let stamp = Instant.from_unix_nanoseconds(5000000000)
    assert FileWrite.set_modified(path_of("/secret"), time: stamp) is Ok(_)
    assert FileRead.metadata(path_of("/secret")) is Ok(metadata)
      && metadata.modified == stamp
      && metadata.permissions.mode() == 0o200
  }
}

test "a file opened in memory files reads, writes, seeks, and changes its length through its handle" {
  var memory = files::MemoryFiles.new()
  provide mut memory {
    var file = FileWrite.open(path_of("/log"), mode: files::WriteMode.Update).expect("the file opens")
    assert mut file.write_all("hello world".bytes()) is Ok(_)
    assert mut file.seek(streams::Position.FromStart(offset: 6)) == Ok(6)
    var word: List[UInt8] = []
    assert mut file.read(mut word, limit: 3) == Ok(3)
    assert word == [119, 111, 114]
    assert mut file.write_at(0, bytes: "J".bytes()) == Ok(1)
    assert mut file.seek(streams::Position.FromEnd(offset: -5)) == Ok(6)
    assert mut file.seek(streams::Position.FromCurrent(offset: -7)) == Err(SystemError.InvalidInput)
    assert mut file.set_length(5) is Ok(_)
    assert file.metadata() is Ok(shortened) && shortened.length == 5
    assert mut file.set_length(7) is Ok(_)
    var tail: List[UInt8] = []
    assert mut file.read_at(4, buffer: mut tail, limit: 10) == Ok(3)
    assert tail == [111, 0, 0]
    assert own file.close() is Ok(_)

    var appended = FileWrite.open(path_of("/log"), mode: files::WriteMode.Append).expect("the file opens")
    assert mut appended.write_all("!".bytes()) is Ok(_)
    var unread: List[UInt8] = []
    assert mut appended.read(mut unread, limit: 1) == Err(SystemError.InvalidInput)
    assert own appended.close() is Ok(_)
    assert FileWrite.open(path_of("/log"), mode: files::WriteMode.CreateNew) is Err(AlreadyExists)
    assert FileRead.read(path_of("/log")) == Ok([74, 101, 108, 108, 111, 0, 0, 33])

    var replaced = FileWrite.open(path_of("/log"), mode: files::WriteMode.Replace).expect("the file opens")
    assert mut replaced.write_all("new".bytes()) is Ok(_)
    assert own replaced.close() is Ok(_)
    assert FileRead.read_text(path_of("/log")) == Ok("new")
  }
}

test "a file reader over memory files reads lines through Handles" {
  var memory = files::MemoryFiles.new().with_text(path_of("/fresh"), contents: "line one\r\nline two\nlast")
  provide mut memory {
    var reader = FileRead.open(path_of("/fresh")).expect("the file opens")
    var lines: List[String] = []
    for line in mut reader.lines() {
      if line is Ok(text) {
        mut lines.push(text.copy())
      }
    }
    assert lines == ["line one", "line two", "last"]
    assert mut reader.read_line() == Ok(None)
    assert mut reader.seek(streams::Position.FromStart(offset: 10)) == Ok(10)
    assert mut reader.read_line() == Ok(Some("line two"))
    assert reader.metadata() is Ok(metadata) && metadata.length == 23
    assert FileRead.open(path_of("/none")) is Err(NotFound)
  }
}

test "a removed file stays readable through a handle that was open" {
  var memory = files::MemoryFiles.new().with_text(path_of("/gone"), contents: "still here")
  provide mut memory {
    var reader = FileRead.open(path_of("/gone")).expect("the file opens")
    assert FileWrite.remove(path_of("/gone")) is Ok(_)
    assert FileRead.read(path_of("/gone")) == Err(SystemError.NotFound)
    assert mut reader.read_line() == Ok(Some("still here"))
  }
}

fn project() -> files::MemoryFiles {
  files::MemoryFiles.new()
    .with_text(path_of("/project/README"), contents: "read me")
    .with_text(path_of("/project/source/main.truss"), contents: "main")
    .with_text(path_of("/project/source/library/list.truss"), contents: "list")
}

test "append adds to the end of a file and makes a missing one" {
  var memory = files::MemoryFiles.new()
  provide mut memory {
    assert files::append_text(path_of("/log"), contents: "one\n") is Ok(_)
    assert files::append_text(path_of("/log"), contents: "two\n") is Ok(_)
    assert files::append(path_of("/log"), contents: [51]) is Ok(_)
    assert FileRead.read_text(path_of("/log")) == Ok("one\ntwo\n3")
    assert files::append_text(path_of("/none/log"), contents: "x") == Err(SystemError.NotFound)
  }
}

test "copy writes the bytes and the permissions of a file to another path" {
  var memory = project()
  provide mut memory {
    assert FileWrite.set_permissions(path_of("/project/README"), permissions: files::Permissions.from_mode(0o600)) is Ok(_)
    assert files::copy(path_of("/project/README"), to: path_of("/copy")) == Ok(7)
    assert FileRead.read_text(path_of("/copy")) == Ok("read me")
    assert FileRead.metadata(path_of("/copy")) is Ok(copied) && copied.permissions.mode() == 0o600
    assert files::copy(path_of("/project/source/main.truss"), to: path_of("/copy")) == Ok(4)
    assert FileRead.read_text(path_of("/copy")) == Ok("main")
    assert files::copy(path_of("/none"), to: path_of("/copy")) == Err(SystemError.NotFound)
    assert files::copy(path_of("/project"), to: path_of("/copy")) == Err(SystemError.IsADirectory)
    assert files::copy(path_of("/copy"), to: path_of("/none/copy")) == Err(SystemError.NotFound)
  }
}

test "create_directories makes each missing directory of a path" {
  var memory = files::MemoryFiles.new().with_text(path_of("/file"), contents: "x")
  provide mut memory {
    assert files::create_directories(path_of("/a/b/c")) is Ok(_)
    assert FileRead.metadata(path_of("/a/b/c")) is Ok(metadata) && metadata.is_directory()
    assert files::create_directories(path_of("/a/b/c")) is Ok(_)
    assert files::create_directories(path_of("/a/b/d/e")) is Ok(_)
    assert FileRead.list(path_of("/a/b")) is Ok(entries) && entries.length() == 2
    assert files::create_directories(path_of("/file/below")) == Err(SystemError.NotADirectory)
  }
}

test "remove_all removes a directory with everything below it" {
  var memory = project()
  provide mut memory {
    assert FileWrite.link(path_of("/project/README"), link: path_of("/project/source/link"), kind: files::LinkKind.Symbolic)
      is Ok(_)
    assert files::remove_all(path_of("/project/source")) is Ok(_)
    assert FileRead.read(path_of("/project/source")) == Err(SystemError.NotFound)
    assert FileRead.read_text(path_of("/project/README")) == Ok("read me")
    assert files::remove_all(path_of("/project/README")) is Ok(_)
    assert files::remove_all(path_of("/project/README")) == Err(SystemError.NotFound)
    assert FileRead.list(path_of("/project")) is Ok(left) && left.length() == 0
  }
}

test "walk lists a directory before the entries below it" {
  var memory = project()
  provide mut memory {
    assert FileWrite.link(path_of("/project/source"), link: path_of("/project/alias"), kind: files::LinkKind.Symbolic)
      is Ok(_)
    assert files::walk(path_of("/project")) is Ok(entries)
      && entries.length() == 7
      && "${entries[0].path}" == "/project"
      && entries[0].depth == 0
      && "${entries[1].path}" == "/project/README"
      && entries[1].kind == files::FileKind.File
      && "${entries[2].path}" == "/project/source"
      && entries[2].kind == files::FileKind.Directory
      && "${entries[3].path}" == "/project/source/main.truss"
      && entries[3].depth == 2
      && "${entries[4].path}" == "/project/source/library"
      && "${entries[5].path}" == "/project/source/library/list.truss"
      && entries[5].depth == 3
      && "${entries[6].path}" == "/project/alias"
      && entries[6].kind == files::FileKind.SymbolicLink
    assert files::walk(path_of("/project"), follow_links: true) is Ok(followed)
      && followed.length() == 10
      && "${followed[7].path}" == "/project/alias/main.truss"
    assert files::walk(path_of("/project/README")) is Ok(single) && single.length() == 1
    assert files::walk(path_of("/none")) is Err(NotFound)
  }
}

test "walk stops at a loop of symbolic links when it follows links" {
  var memory = files::MemoryFiles.new().with_text(path_of("/loop/file"), contents: "x")
  provide mut memory {
    assert FileWrite.link(path_of("/loop"), link: path_of("/loop/again"), kind: files::LinkKind.Symbolic) is Ok(_)
    assert files::walk(path_of("/loop")) is Ok(entries) && entries.length() == 3
    assert files::walk(path_of("/loop"), follow_links: true) == Err(SystemError.InvalidInput)
  }
}

test "write_atomically replaces a file and leaves no temporary file" {
  var memory = files::MemoryFiles.new().with_text(path_of("/data/config"), contents: "old")
  provide mut memory, random::SeededRandom.new(4) {
    assert files::write_atomically(path_of("/data/config"), contents: "new".bytes()) is Ok(_)
    assert FileRead.read_text(path_of("/data/config")) == Ok("new")
    assert FileRead.list(path_of("/data")) is Ok(entries) && entries.length() == 1
    assert files::write_atomically(path_of("/data/fresh"), contents: "made".bytes()) is Ok(_)
    assert FileRead.read_text(path_of("/data/fresh")) == Ok("made")
    assert files::write_atomically(path_of("/none/config"), contents: "x".bytes()) == Err(SystemError.NotFound)
    assert files::write_atomically(path_of("/"), contents: "x".bytes()) == Err(SystemError.InvalidInput)
    assert FileWrite.create_directory(path_of("/data/directory")) is Ok(_)
    assert files::write_atomically(path_of("/data/directory"), contents: "x".bytes()) == Err(SystemError.IsADirectory)
    assert FileRead.list(path_of("/data")) is Ok(after) && after.length() == 3
  }
}

test "create_temporary_directory makes a new directory with the prefix" {
  var memory = files::MemoryFiles.new()
  provide mut memory, random::SeededRandom.new(9) {
    assert FileWrite.create_directory(path_of("/tmp")) is Ok(_)
    assert files::create_temporary_directory(path_of("/tmp"), prefix: "build-") is Ok(first)
      && files::create_temporary_directory(path_of("/tmp"), prefix: "build-") is Ok(second)
      && first != second
      && "${first}".starts_with("/tmp/build-")
      && FileRead.metadata(first) is Ok(metadata)
      && metadata.is_directory()
    assert files::create_temporary_directory(path_of("/none"), prefix: "x") is Err(NotFound)
  }
}

test "files within a directory resolve a path to one below the directory, or refuse" {
  var memory = project()
  provide mut memory {
    assert FileWrite.link(path_of("/project/source"), link: path_of("/project/inside"), kind: files::LinkKind.Symbolic)
      is Ok(_)
    assert FileWrite.link(path_of("/"), link: path_of("/project/outside"), kind: files::LinkKind.Symbolic) is Ok(_)
    provide files::FilesWithin(root: path_of("/project")) {
      assert FileRead.resolve(path_of("inside/main.truss")) is Ok(inside) && "${inside}" == "source/main.truss"
      assert FileRead.resolve(path_of("outside")) == Err(SystemError.PermissionDenied)
      assert FileRead.resolve(path_of("missing")) == Err(SystemError.NotFound)
    }
  }
}

fn glob_matches(pattern: StringSlice, path: StringSlice) -> Bool {
  match files::Glob.parse(pattern) {
    Ok(glob) => glob.matches(Path.new(path))
    Err(_) => false
  }
}

fn glob_error(pattern: StringSlice) -> Option[USize] {
  match files::Glob.parse(pattern) {
    Ok(_) => None
    Err(error) => Some(error.offset)
  }
}

test "a glob matches the characters of one name" {
  assert glob_matches("*.truss", path: "main.truss")
  assert !glob_matches("*.truss", path: "main.ml")
  assert !glob_matches("*.truss", path: "source/main.truss")
  assert glob_matches("ma?n.*", path: "main.truss")
  assert !glob_matches("ma?n", path: "man")
  assert glob_matches("*a*b*c*", path: "xxaxxbxxc")
  assert !glob_matches("*a*b*c*", path: "xxaxxcxxb")
  assert glob_matches("[a-c]at", path: "bat") && !glob_matches("[a-c]at", path: "dat")
  assert glob_matches("[!a-c]at", path: "dat") && !glob_matches("[!a-c]at", path: "bat")
  assert glob_matches("[abc-]x", path: "-x") && glob_matches("[abc-]x", path: "cx")
  assert glob_matches("\\*literal", path: "*literal") && !glob_matches("\\*literal", path: "xliteral")
  assert glob_matches("caf?", path: "café") && !glob_matches("caf?", path: "caf")
  assert glob_matches("*", path: ".hidden")
  assert !glob_matches("exact", path: "exactly") && !glob_matches("exactly", path: "exact")
}

test "a glob's ** matches any number of directories" {
  assert glob_matches("source/**/*.truss", path: "source/main.truss")
  assert glob_matches("source/**/*.truss", path: "source/a/b/c/list.truss")
  assert !glob_matches("source/**/*.truss", path: "tests/main.truss")
  assert glob_matches("**/README", path: "README") && glob_matches("**/README", path: "a/b/README")
  assert glob_matches("a/**", path: "a") && glob_matches("a/**", path: "a/b/c")
  assert glob_matches("**/a/**/b", path: "x/a/y/z/b") && !glob_matches("**/a/**/b", path: "x/b/y/a")
  assert glob_matches("/etc/*.conf", path: "/etc/app.conf") && !glob_matches("/etc/*.conf", path: "etc/app.conf")
}

test "parse rejects a glob that is not valid and says where" {
  assert glob_error("a**") == Some(1)
  assert glob_error("**a/b") == Some(0)
  assert glob_error("x/[abc") == Some(2)
  assert glob_error("[]") == Some(0)
  assert glob_error("trailing\\") == Some(8)
  assert glob_error("fine/**/*.[ch]") is None
  assert "${files::GlobError(offset: 3)}" == "the glob is not valid at byte 3"
}

test "find lists the paths below a directory that a glob matches" {
  var memory = project()
  provide mut memory {
    assert files::Glob.parse("**/*.truss") is Ok(glob)
      && glob.find(path_of("/project")) is Ok(paths)
      && paths.length() == 2
      && "${paths[0]}" == "/project/source/main.truss"
      && "${paths[1]}" == "/project/source/library/list.truss"
    assert files::Glob.parse("/project/*") is Ok(absolute)
      && absolute.find(path_of("/project")) is Ok(top)
      && top.length() == 2
    assert files::Glob.parse("*") is Ok(star) && star.find(path_of("/none")) is Err(NotFound)
  }
}

test "a glob written as a template is the glob that parse gives" {
  let sources = files::Glob"src/**/*.truss"
  assert sources.matches(path_of("src/list/slice.truss"))
  assert sources.matches(path_of("src/core.truss"))
  assert !sources.matches(path_of("docs/core.truss"))
  assert files::Glob"/tmp/[a-c]?".matches(path_of("/tmp/b1"))
  assert !files::Glob"/tmp/[a-c]?".matches(path_of("/tmp/d1"))
}
