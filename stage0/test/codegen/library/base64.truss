use standard::base64

fn decodes_to(text: StringSlice, expected: StringSlice) -> Bool {
  match base64::decode(text) {
    Ok(bytes) => bytes == expected.to_bytes()
    Err(_) => false
  }
}

test "bytes encode with padding, as RFC 4648 gives them" {
  assert base64::encode("".bytes()) == ""
  assert base64::encode("f".bytes()) == "Zg=="
  assert base64::encode("fo".bytes()) == "Zm8="
  assert base64::encode("foo".bytes()) == "Zm9v"
  assert base64::encode("foob".bytes()) == "Zm9vYg=="
  assert base64::encode("fooba".bytes()) == "Zm9vYmE="
  assert base64::encode("foobar".bytes()) == "Zm9vYmFy"
}

test "encoding can leave out the padding and use the alphabet for addresses" {
  assert base64::encode("f".bytes(), padding: false) == "Zg"
  assert base64::encode("fo".bytes(), padding: false) == "Zm8"
  assert base64::encode("foo".bytes(), padding: false) == "Zm9v"
  let bytes: List[UInt8] = [251, 255, 254]
  assert base64::encode(bytes) == "+//+"
  assert base64::encode(bytes, alphabet: base64::Alphabet.UrlSafe) == "-__-"
  let two: List[UInt8] = [251, 255]
  assert base64::encode(two, alphabet: base64::Alphabet.UrlSafe) == "-_8="
}

test "text decodes with or without its padding" {
  assert decodes_to("", expected: "")
  assert decodes_to("Zg==", expected: "f")
  assert decodes_to("Zg", expected: "f")
  assert decodes_to("Zm8=", expected: "fo")
  assert decodes_to("Zm8", expected: "fo")
  assert decodes_to("Zm9v", expected: "foo")
  assert decodes_to("Zm9vYmFy", expected: "foobar")
  assert decodes_to("Zm9vYmE=", expected: "fooba")
  assert base64::decode("-__-", alphabet: base64::Alphabet.UrlSafe) is Ok(bytes) && bytes.length() == 3 && bytes[0] == 251
    && bytes[2] == 254
}

test "decoding says what is wrong with text that is not base64" {
  assert base64::decode("Z") == Err(base64::DecodeError.InvalidLength)
  assert base64::decode("Zm9vY") == Err(base64::DecodeError.InvalidLength)
  assert base64::decode("Zg=") == Err(base64::DecodeError.InvalidPadding)
  assert base64::decode("Zm8==") == Err(base64::DecodeError.InvalidPadding)
  assert base64::decode("Zm9v=") == Err(base64::DecodeError.InvalidPadding)
  assert base64::decode("Zh==") == Err(base64::DecodeError.InvalidPadding)
  assert base64::decode("Zm9=") == Err(base64::DecodeError.InvalidPadding)
  assert base64::decode("Zm9!") == Err(base64::DecodeError.InvalidCharacter(offset: 3))
  assert base64::decode("Z=9v") == Err(base64::DecodeError.InvalidCharacter(offset: 1))
  assert base64::decode("-__-") == Err(base64::DecodeError.InvalidCharacter(offset: 0))
  assert base64::decode("+//+", alphabet: base64::Alphabet.UrlSafe)
    == Err(base64::DecodeError.InvalidCharacter(offset: 0))
  assert "${base64::DecodeError.InvalidCharacter(offset: 2)}" == "the byte at offset 2 is not in the alphabet"
}
