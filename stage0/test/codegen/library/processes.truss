use standard::processes

test "a command keeps its program and the arguments added to it" {
  let more: List[String] = ["-l${1}", "x${2}"]
  let command = processes::Command.new("list").argument("-a").arguments(more)
  let arguments = command.argument_list()
  assert command.program().length() == 4
  assert arguments.length() == 3
  assert arguments[0] == "-a"
  assert arguments[1] == "-l1"
  assert arguments[2] == "x2"
}

test "a command's builders each return the command with one thing set" {
  let command = processes::Command.new("tool")
    .variable("KEY", value: "value")
    .without_inherited_variables()
    .directory(Path.new("/tmp"))
    .input(processes::Redirect.Discard)
    .output(processes::Redirect.Pipe)
    .error_output(processes::Redirect.Capture)
    .argument("last")
  assert command.argument_list().length() == 1
  assert command.program().length() == 4
}

test "a finished command's output is text when it is UTF-8" {
  let finished = processes::Output(status: processes::ExitStatus.Exited(code: 0), output: [104, 195, 169], error_output: [])
  assert finished.text() is Ok(text) && text == "h\u{e9}"
  let broken = processes::Output(status: processes::ExitStatus.Exited(code: 1), output: [104, 255], error_output: [])
  assert broken.text() is Err(error) && error.valid_up_to == 1
  let silent = processes::Output(status: processes::ExitStatus.Exited(code: 0), output: [], error_output: [33])
  assert silent.text() is Ok(text) && text.is_empty()
}

fn words_of(command: processes::Command) -> String {
  var text = command.program().to_string()
  let arguments = command.argument_list()
  for index in 0..arguments.length() {
    mut text.push("|")
    mut text.push(arguments[index].slice())
  }
  text
}

test "a command written as a template splits its text into words and keeps each value whole" {
  let message = "fix the build"
  let command = processes::Command"git commit  -m ${message.slice()} --author=${"me"}"
  assert words_of(command) == "git|commit|-m|fix the build|--author=me"
  let empty = ""
  let listing = processes::Command" ls ${empty.slice()} "
  assert words_of(listing) == "ls|"
  let plain = processes::Command"true"
  assert words_of(plain) == "true"
  let removal = processes::Command"rm -f ${Path.new("/tmp/a file")}"
  assert words_of(removal) == "rm|-f|/tmp/a file"
  let lines = processes::Command"sort\t-n\n-r"
  assert words_of(lines) == "sort|-n|-r"
}
