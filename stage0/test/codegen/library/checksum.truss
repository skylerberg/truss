use standard::checksum

test "the checksums give the standard check values" {
  assert checksum::crc32("123456789".bytes()) == 0xCBF43926
  assert checksum::crc32c("123456789".bytes()) == 0xE3069283
  assert checksum::adler32("Wikipedia".bytes()) == 0x11E60398
  assert checksum::crc32("The quick brown fox jumps over the lazy dog".bytes()) == 0x414FA339
}

test "the checksums of no bytes are their starting values" {
  assert checksum::crc32("".bytes()) == 0
  assert checksum::crc32c("".bytes()) == 0
  assert checksum::adler32("".bytes()) == 1
}

test "a checksum taken in parts is the checksum of the whole" {
  var running = checksum::Crc32.new()
  mut running.update("1234".bytes())
  mut running.update("".bytes())
  mut running.update("56789".bytes())
  assert running.finish() == 0xCBF43926
  let fresh = checksum::Crc32.new()
  assert fresh.finish() == 0
}

test "adler32 stays in range over many large bytes" {
  var bytes: List[UInt8] = []
  for _ in 0..6000 {
    mut bytes.push(255)
  }
  assert checksum::adler32(bytes) == 0xA49759EA
}

test "xxh64 gives the reference values" {
  assert checksum::xxh64([]) == 0xEF46DB3751D8E999
  assert checksum::xxh64("abc".bytes()) == 0x44BC2CF5AD770999
}
