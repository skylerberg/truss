use standard::hex
use standard::http::hpack

fn field(name: StringSlice, value: StringSlice) -> hpack::Field {
  hpack::Field(name: name.to_string(), value: value.to_string())
}

fn check(decoder: mut hpack::Decoder, block: StringSlice, expected: own List[hpack::Field]) -> Bool
  uses Panic
{
  let bytes = hex::decode(block).expect("hexadecimal")
  mut decoder.decode(bytes.slice()) == Ok(own expected)
}

fn fails(block: StringSlice) -> Bool
  uses Panic
{
  let bytes = hex::decode(block).expect("hexadecimal")
  var decoder = hpack::Decoder.new()
  mut decoder.decode(bytes.slice()) is Err(_)
}

test "RFC 7541 C.3: requests without Huffman coding" {
  var decoder = hpack::Decoder.new()
  assert check(mut decoder, block: "828684410f7777772e6578616d706c652e636f6d", expected: [field(":method", value: "GET"), field(":scheme", value: "http"), field(":path", value: "/"), field(":authority", value: "www.example.com")])
  assert check(mut decoder, block: "828684be58086e6f2d6361636865", expected: [field(":method", value: "GET"), field(":scheme", value: "http"), field(":path", value: "/"), field(":authority", value: "www.example.com"), field("cache-control", value: "no-cache")])
  assert check(mut decoder, block: "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565", expected: [field(":method", value: "GET"), field(":scheme", value: "https"), field(":path", value: "/index.html"), field(":authority", value: "www.example.com"), field("custom-key", value: "custom-value")])
}

test "RFC 7541 C.4: requests with Huffman coding" {
  var decoder = hpack::Decoder.new()
  assert check(mut decoder, block: "828684418cf1e3c2e5f23a6ba0ab90f4ff", expected: [field(":method", value: "GET"), field(":scheme", value: "http"), field(":path", value: "/"), field(":authority", value: "www.example.com")])
  assert check(mut decoder, block: "828684be5886a8eb10649cbf", expected: [field(":method", value: "GET"), field(":scheme", value: "http"), field(":path", value: "/"), field(":authority", value: "www.example.com"), field("cache-control", value: "no-cache")])
  assert check(mut decoder, block: "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", expected: [field(":method", value: "GET"), field(":scheme", value: "https"), field(":path", value: "/index.html"), field(":authority", value: "www.example.com"), field("custom-key", value: "custom-value")])
}

test "RFC 7541 C.5: responses that evict entries from a 256-byte table" {
  var decoder = hpack::Decoder.new(limit: 256)
  assert check(mut decoder, block: "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d", expected: [field(":status", value: "302"), field("cache-control", value: "private"), field("date", value: "Mon, 21 Oct 2013 20:13:21 GMT"), field("location", value: "https://www.example.com")])
  assert check(mut decoder, block: "4803333037c1c0bf", expected: [field(":status", value: "307"), field("cache-control", value: "private"), field("date", value: "Mon, 21 Oct 2013 20:13:21 GMT"), field("location", value: "https://www.example.com")])
  assert check(mut decoder, block: "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31", expected: [field(":status", value: "200"), field("cache-control", value: "private"), field("date", value: "Mon, 21 Oct 2013 20:13:22 GMT"), field("location", value: "https://www.example.com"), field("content-encoding", value: "gzip"), field("set-cookie", value: "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")])
}

test "RFC 7541 C.6: responses with Huffman coding and eviction" {
  var decoder = hpack::Decoder.new(limit: 256)
  assert check(mut decoder, block: "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3", expected: [field(":status", value: "302"), field("cache-control", value: "private"), field("date", value: "Mon, 21 Oct 2013 20:13:21 GMT"), field("location", value: "https://www.example.com")])
  assert check(mut decoder, block: "4883640effc1c0bf", expected: [field(":status", value: "307"), field("cache-control", value: "private"), field("date", value: "Mon, 21 Oct 2013 20:13:21 GMT"), field("location", value: "https://www.example.com")])
  assert check(mut decoder, block: "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007", expected: [field(":status", value: "200"), field("cache-control", value: "private"), field("date", value: "Mon, 21 Oct 2013 20:13:22 GMT"), field("location", value: "https://www.example.com"), field("content-encoding", value: "gzip"), field("set-cookie", value: "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")])
}

test "an encoder's blocks decode to its fields, and repeated fields shrink to indexes" {
  let first: List[hpack::Field] = [
    field(":status", value: "302"),
    field("cache-control", value: "private"),
    field("date", value: "Mon, 21 Oct 2013 20:13:21 GMT"),
    field("location", value: "https://www.example.com"),
    hpack::Field(name: "authorization", value: "Bearer secret", is_sensitive: false),
    hpack::Field(name: "x-token", value: "abc", is_sensitive: true),
  ]
  let second: List[hpack::Field] = [
    field(":status", value: "307"),
    field("cache-control", value: "private"),
    field("date", value: "Mon, 21 Oct 2013 20:13:21 GMT"),
    field("location", value: "https://www.example.com"),
  ]
  var encoder = hpack::Encoder.new(limit: 256)
  var decoder = hpack::Decoder.new(limit: 256)
  let first_block = mut encoder.encode(first)
  let second_block = mut encoder.encode(second)
  let decoded = mut decoder.decode(first_block.slice())
  assert decoded is Ok(fields) && fields.length() == 6 && fields[0] == first[0] && fields[3] == first[3]
    && fields[4].is_sensitive && fields[5].is_sensitive && fields[5].value == "abc"
  assert mut decoder.decode(second_block.slice()) == Ok(second.copy())
  assert second_block.length() < 10
  mut encoder.set_limit(0)
  let emptied = mut encoder.encode(second)
  assert mut decoder.decode(emptied.slice()) == Ok(own second)
}

test "malformed header blocks are rejected" {
  assert fails("80")
  assert fails("be")
  assert fails("3fe21f")
  assert fails("418cf1e3c2e5f23a6ba0ab90f4")
  assert fails("4181ff")
  assert fails("410f7777")
  assert fails("82ffffffffffffff")
}
