fn recovered(value: Result[Int64, Bool]) -> Int64
  cost allocations <= 0
  cost allocated_bytes <= 0
{
  value.map(fn(inner) { inner / 2 }).map_error(fn(error) { !error }).unwrap_or_else(fn(error) { if error { 1 } else { 0 } })
}

test "a result's combinators with lambdas that allocate nothing keep an allocation bound of zero" {
  assert recovered(Ok(8)) == 4
  assert recovered(Err(false)) == 1
  assert recovered(Err(true)) == 0
}

test "a result maps its value and its error" {
  let four: Result[Int64, Int64] = Ok(4)
  let failed: Result[Int64, Int64] = Err(9)
  assert four.map(fn(value) { value + 1 }) == Ok(5)
  assert failed.map(fn(value) { value + 1 }) == Err(9)
  assert four.map_error(fn(error) { error + 1 }) == Ok(4)
  assert failed.map_error(fn(error) { error + 1 }) == Err(10)
}

test "a result chains on its value and recovers from its error" {
  let four: Result[Int64, Int64] = Ok(4)
  let failed: Result[Int64, Int64] = Err(9)
  let halved: Result[Int64, Int64] = four.and_then(fn(value) { if value % 2 == 0 { Ok(value / 2) } else { Err(value) } })
  assert halved == Ok(2)
  let still_failed: Result[Int64, Int64] = failed.and_then(fn(value) { Ok(value / 2) })
  assert still_failed == Err(9)
  let recovered_value: Result[Int64, Int64] = failed.or_else(fn(error) { Ok(error - 9) })
  assert recovered_value == Ok(0)
  assert four.unwrap_or_else(fn(error) { error }) == 4
  assert failed.unwrap_or_else(fn(error) { error }) == 9
}
