use standard::compression::zstd
use standard::hex

fn bytes_of(text: StringSlice) -> List[UInt8] {
  match hex::decode(text) {
    Ok(bytes) => own bytes
    Err(_) => []
  }
}

fn joined(parts: Slice[String]) -> List[UInt8] {
  var text = TextBuilder.new()
  for part in parts {
    mut text.write(part.slice())
  }
  bytes_of(own text.finish().slice())
}

fn words(count: USize) -> List[UInt8] {
  let vocabulary: List[String] = ["alpha ", "beta ", "gamma ", "delta ", "epsilon\n", "zeta ", "eta ", "theta "]
  var bytes: List[UInt8] = []
  var state: USize = 7
  while bytes.length() < count {
    state = (state * 1103515245 + 12345) % 2147483648
    let word = vocabulary[(state >> 16) & 7].bytes()
    for byte in word {
      if bytes.length() < count {
        mut bytes.push(byte)
      }
    }
  }
  bytes
}

fn noise(count: USize) -> List[UInt8] {
  var bytes: List[UInt8] = []
  var state: UInt64 = 11
  for _ in 0..count {
    state = (state * 1103515245 + 12345) % 2147483648
    mut bytes.push(UInt8.try_from((state >> 16) & 255).unwrap_or(0))
  }
  bytes
}

fn input_of(name: String) -> List[UInt8] {
  if name == "short" {
    "Hello, zstd and Brotli!".bytes().to_list()
  } else if name == "text_3000" {
    words(3000)
  } else if name == "text_300000" {
    words(300000)
  } else if name == "random_1000" {
    noise(1000)
  } else if name == "zeros_200000" {
    List.filled(0, count: 200000)
  } else {
    []
  }
}

