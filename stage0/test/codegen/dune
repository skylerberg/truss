(executable
 (name module_tests)
 (modules module_tests)
 (libraries codegen_support harness backend compiler_bug path))

(rule
 (alias runtest)
 (deps
  (glob_files_rec modules/**.truss))
 (action
  (setenv
   TRUSS_TEST_SHARE
   0/2
   (run %{exe:module_tests.exe}))))

(rule
 (alias runtest)
 (deps
  (glob_files_rec modules/**.truss))
 (action
  (setenv
   TRUSS_TEST_SHARE
   1/2
   (run %{exe:module_tests.exe}))))

(rule
 (target fixtures.ml)
 (deps
  (glob_files_rec fixtures/**.truss))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../embed_fixtures/embed_fixtures.exe} %{deps}))))
