type Countdown(left: UInt64)

impl FiniteCursor for Countdown {
  fn remaining(self) -> UInt64
    ensures result == self.left
  {
    self.left
  }
}

impl Cursor for Countdown {
  type Element = String

  fn next(mut self) -> Option[String]
    ensures (result is Some(_)) ==> self.left < old(self.left)
  {
    if self.left == 0 {
      return None
    }
    self.left -= 1
    Some("left ${self.left + 1}")
  }
}

fn countdown(from: UInt64) -> Countdown {
  Countdown(left: from)
}

fn cursors() -> Int64
  uses Tasks, Console
{
  var lines = countdown(3)
  concurrent for line in lines {
    Console.print_line("stored ${line}")
  }
  concurrent for line in countdown(4) {
    if line == "left 2" {
      return 2
    }
    Console.print_line("temporary ${line}")
  }
  0
}

fn run() -> ExitCode
  uses Tasks, Console
{
  Console.print_line("${cursors()}")
  ExitCode.success
}
