type Sum(total: USize)

capability Lengths {
  fn add(length: USize)
  fn total() -> USize
}

impl Lengths for Sum {
  fn add(mut self, length: USize) {
    self.total += length
  }

  fn total(self) -> USize {
    self.total
  }
}

type Labels(index: Int64, count: Int64)

impl Cursor for Labels {
  type Element = String

  fn next(mut self) -> Option[String] {
    if self.index >= self.count {
      return None
    }
    self.index += 1
    Some("label number ${(self.index - 1) % 10}")
  }
}

fn labels(count: Int64) -> Labels {
  Labels(index: 0, count: count)
}

fn main(arguments: List[String]) -> ExitCode
  uses Tasks, Console
{
  var sum = Sum(total: 0)
  provide mut sum {
    concurrent for label in labels(100) {
      Lengths.add(label.length())
    }
    Console.print_line("total ${Lengths.total()}")
  }
  ExitCode.success
}
