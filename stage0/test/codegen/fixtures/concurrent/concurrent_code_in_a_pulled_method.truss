fn counted(limit: Int64) yields own Int64
  uses Tasks
{
  var total: Int64 = 0
  concurrent {
    total = limit
  }
  yield total
}

fn main(arguments: List[String]) -> ExitCode
  uses Tasks, Console
{
  var cursor = counted(3)
  if mut cursor.next() is Some(value) {
    Console.print_line("${value}")
  }
  ExitCode.success
}
