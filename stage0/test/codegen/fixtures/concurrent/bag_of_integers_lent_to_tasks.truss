type Bag(items: List[Int64])

impl Iterable for Bag {
  type Element = Int64

  fn count(self) -> UInt64 {
    self.items.count()
  }

  fn element(self, position: UInt64) lends Int64 {
    self.items[position]
  }
}

fn run() -> ExitCode
  uses Tasks, Console
{
  let bag = Bag(items: [5, 6, 7])
  concurrent for item in bag {
    Console.print_line("saw ${item}")
  }
  ExitCode.success
}
