type Numbers(index: Int64, count: Int64)

impl Cursor for Numbers {
  type Element = Int64

  fn next(mut self) -> Option[Int64] {
    if self.index >= self.count {
      return None
    }
    self.index += 1
    Some(self.index)
  }
}

fn numbers(limit: Int64) -> Numbers {
  Numbers(index: 0, count: limit)
}

fn first_and_rest(limit: Int64) -> Int64 {
  var cursor = numbers(limit)
  let first = match mut cursor.next() {
    Some(number) => number
    None => 0
  }
  var rest = 0
  for number in mut cursor {
    rest += number
  }
  first * 100 + rest
}

test "cursors" {
  assert first_and_rest(4) == 109
  assert first_and_rest(0) == 0
}
