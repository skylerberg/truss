fn step(start: Int64, by: Int64 = 2 * 3) -> Int64
  requires by > 0
{
  start + by
}

fn length(prefix: String = "item") -> USize {
  prefix.length()
}

fn keep(text: own String = "kept") -> String {
  text
}

test "defaults" {
  assert step(1) == 7
  assert step(1, by: 1) == 2
  assert length() == 4
  assert length("ab") == 2
  assert keep() == "kept"
  assert keep("mine") == "mine"
}
