trait Counter {
  fn count(self) -> UInt64
  fn count(mut self) -> UInt64
}

type Tally()

impl Counter for Tally {
  fn count(self) -> UInt64 {
    1
  }

  fn count(mut self) -> UInt64 {
    2
  }
}

test "each overload is called through any" {
  var counter: any Counter = any Tally()
  let read = counter.count()
  let mutated = mut counter.count()
  assert read == 1
  assert mutated == 2
}
