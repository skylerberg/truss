fn fib(limit_count: UInt64) -> UInt64 {
  if limit_count < 2 {
    return limit_count
  }
  parallel {
    let left = fib(limit_count - 1)
    let right = fib(limit_count - 2)
  }
  left.wrapping_add(right)
}

fn main(arguments: List[String]) -> ExitCode
  uses Console
{
  Console.print_line("${fib(30)}")
  ExitCode.success
}
