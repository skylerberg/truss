fn all_positive(items: List[Int64]) -> Bool {
  forall step_index in 0..items.length() => items[step_index] > 0
}

fn any_long(names: List[String], over: USize) -> Bool {
  exists step_index in 0..names.length() => names[step_index].length() > over
}

fn sorted(items: List[Int64]) -> Bool {
  forall step_index in 1..items.length() => items[step_index - 1] <= items[step_index]
}

fn first_long(names: List[String]) -> Int64 {
  var looked: Int64 = 0
  for name in names {
    looked += 1
    if exists step_index in 0..=name.length() => step_index > 3 {
      return looked
    }
  }
  0
}

test "quantifiers over ranges run as loops that stop at the first answer" {
  assert all_positive([3, 1, 2])
  assert !all_positive([3, 0, 2])
  assert all_positive([])
  let names = ["${1}a", "${2}bcdefgh", "${3}c"]
  assert any_long(names, over: 5)
  assert !any_long(names, over: 50)
  assert !any_long([], over: 0)
  assert sorted([1, 2, 2, 5])
  assert !sorted([1, 3, 2])
  assert sorted([7])
  assert first_long(names) == 2
  assert (forall step_index in 0..3 => exists other_index in 0..3 => step_index + other_index == 2)
  assert !(forall step_index in 0..3 => exists other_index in 0..3 => step_index + other_index == 3)
  assert !(exists step_index in 0..3 => forall other_index in 0..3 => step_index * other_index > 0)
}
