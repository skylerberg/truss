type Tree =
  | Leaf
  | indirect Node(left: Tree, name: String, right: Tree)

fn Tree.leftmost_name(self) lends String {
  match self {
    Leaf => "none".copy()
    Node(left, name, ..) => {
      if left is Leaf {
        name
      } else {
        left.leftmost_name()
      }
    }
  }
}

test "leftmost name" {
  let one = Tree.Node(left: Tree.Leaf, name: "one".copy(), right: Tree.Leaf)
  assert one.leftmost_name() == "one"
}
