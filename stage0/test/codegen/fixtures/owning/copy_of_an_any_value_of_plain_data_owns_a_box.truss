trait Located: Copyable {
  fn x(self) -> Int64
}

type Point(x: Int64, y: Int64)

impl Located for Point {
  fn x(self) -> Int64 {
    self.x
  }
}

fn duplicate[Value: Copyable](value: Value) -> Value {
  value.copy()
}

test "a copy outlives its original" {
  let copied = {
    let original: any Located = any Point(x: 3, y: 4)
    duplicate(original)
  }
  assert copied.x() == 3
}
