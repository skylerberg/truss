type Quad(first_value: Int64, second_value: Int64, third_value: Int64, fourth_value: Int64)

fn swapped(second_point: Quad) -> Quad {
  second_point with (first_value: second_point.second_value, second_value: second_point.first_value)
}

test "swapped" {
  var second_point = Quad(first_value: 1, second_value: 2, third_value: 3, fourth_value: 4)
  second_point = swapped(second_point)
  assert second_point.first_value == 2
  assert second_point.second_value == 1
}
