type Counted(value: Int64, reads: Int64)

fn Counted.peek(mut self) lends Option[Int64] {
  yield Some(self.value)
  self.reads = 1
}

test "lent" {
  var counted = Counted(value: 1, reads: 0)
  if mut counted.peek() is Some(value) {
    assert value == 1
    assert counted.reads == 1
    counted.value = 10
  }
  assert counted.value == 10
}
