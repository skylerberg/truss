type Quiet()

fn Quiet.count(self, limit: Int64) yields Int64 {
  var step_index = 1
  while step_index <= limit {
    yield step_index
    step_index += 1
  }
}

test "counted" {
  let quiet = Quiet()
  var each = quiet.count(2)
  assert mut each.next() == Some(1)
  assert mut each.next() == Some(2)
  assert mut each.next() == None
}
