type Holder(id: Int64)

fn Holder.label(self) lends Option[String] {
  let text = "label ${self.id}"
  yield Some(text)
}

test "lent" {
  let holder = Holder(id: 1)
  var count: USize = 0
  while count < 3 && holder.label() is Some(text) {
    assert text == "label 1"
    count = count.saturating_add(1)
  }
  assert count == 3
}
