use standard.text

type Slow(text: String)

impl FromTemplate for Slow {
  type Part = String

  fn is_valid_template(literals: List[text.Literal]) -> Bool
  {
    var state: UInt64 = 1
    for round in 0..30_000_000
      invariant state < 1_000_003
    {
      state = (state * 3 + round) % 1_000_003
    }
    state == 915_721
  }

  fn from_template(template: Template[String]) -> Slow
  {
    Slow(text: "")
  }
}

fn f() -> Slow {
  Slow"hey"
}
