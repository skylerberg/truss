use standard.text

type Shout(text: String)

impl FromTemplate for Shout {
  type Interpolation = String

  fn is_valid_template(literals: List[text.Literal]) -> Bool
  {
    let broken: UInt8 = "x"
    true
  }

  fn from_template(template: Template[String]) -> Shout
  {
    Shout(text: "")
  }
}

