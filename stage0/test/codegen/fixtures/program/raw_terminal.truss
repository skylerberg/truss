use standard.processes

fn holds(bytes: Slice[UInt8], word: StringSlice) -> Bool {
  let wanted = word.bytes()
  if wanted.length() > bytes.length() {
    return false
  }
  for start in 0..=(bytes.length() - wanted.length()) {
    var same = true
    for index in 0..wanted.length() {
      if bytes[start + index] != wanted[index] {
        same = false
      }
    }
    if same {
      return true
    }
  }
  false
}

fn settings() -> List[UInt8]
  uses Processes
{
  let asked = processes.Command.new("sh")
    .argument("-c")
    .argument("stty -a < /dev/tty")
    .output(processes.Redirect.Capture)
  match Processes.run(asked) {
    Ok(output) => output.output.copy()
    Err(_) => []
  }
}

fn main(arguments: Slice[String]) -> ExitCode
  uses Console, Handles, Processes, FileWrite
{
  var report = ""
  var terminal = Console.terminal()
  mut report.push("interactive ${terminal.is_interactive()}\n")
  mut report.push("size known ${terminal.size() is Ok(_)}\n")
  let before = settings()
  mut report.push("starts raw ${holds(before, word: "-icanon")}\n")
  mut report.push("made raw ${mut terminal.set_raw_mode(true) is Ok(_)}\n")
  let raw = settings()
  mut report.push("raw ${holds(raw, word: "-icanon")} ${holds(raw, word: "-isig")} ${holds(raw, word: "-opost")}\n")
  mut report.push("restored ${mut terminal.set_raw_mode(false) is Ok(_)}\n")
  let after = settings()
  mut report.push("after ${holds(after, word: "-icanon")} ${holds(after, word: "-isig")} ${holds(after, word: "-opost")}\n")
  let _ = FileWrite.write_text(Path.new(arguments[1]), contents: report)
  ExitCode(0)
}
