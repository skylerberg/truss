use standard.collections

fn total(items: List[Int64]) -> Int64
  uses Panic
{
  var sum: Int64 = 0
  for item in items {
    sum = sum.checked_add(item).expect("arithmetic overflow")
  }
  sum
}

fn quotient(dividend: Int64, divisor: Int64) -> Int64
  uses Panic
{
  dividend.checked_divide(divisor).expect("division by zero")
}

fn shifted(value: UInt64, amount: UInt64) -> UInt64
  uses Panic
{
  value.checked_shift_left(amount).expect("shift amount out of range")
}

fn element(items: List[Int64], index: UInt64) -> Int64
  uses Panic
{
  items.get(index).expect("index out of bounds")
}

fn tail_length(items: List[Int64], start: UInt64) -> UInt64
  uses Panic
{
  if start > items.length() {
    Panic.crash("range out of bounds")
  }
  items[start..].length()
}

fn port(ports: Map[String, UInt16], name: String) -> UInt16
  uses Panic
{
  ports.get(name).expect("index out of bounds")
}

fn marked(index: UInt64) -> UInt64
  uses Panic
{
  var bits = collections.BitSet.new(2)
  if index >= bits.length() {
    Panic.crash("index out of bounds")
  }
  bits[index] = true
  bits.count_ones()
}

type Shelf(items: List[Int64])

impl Index for Shelf {
  type Key = UInt64
  type Output = Int64

  fn contains_key(self, key: UInt64) -> Bool
    ensures result == (key < self.items.length())
    cost time O(1)
  {
    key < self.items.length()
  }

  fn at(self, key: UInt64) lends Int64
    cost time O(1)
  {
    self.items[key]
  }
}

fn shelved(shelf: Shelf, index: UInt64) -> Int64
  uses Panic
{
  if !shelf.contains_key(index) {
    Panic.crash("index out of bounds")
  }
  shelf[index]
}

fn main(arguments: List[String]) -> ExitCode
  uses Console, Panic
{
  let numbers = [9223372036854775807, 0]
  let count = arguments.length()
  match arguments[1] {
    "overflow" => Console.print_line("${total([9223372036854775807, 1])}")
    "division" => Console.print_line("${quotient(100, divisor: Int64.try_from_integer(count).unwrap_or(0) - 2)}")
    "shift" => Console.print_line("${shifted(count, amount: count * 32)}")
    "index" => Console.print_line("${element(numbers, index: count)}")
    "range" => Console.print_line("${tail_length(numbers, start: count + 1)}")
    "key" => Console.print_line("${port(["http": 80], name: "https")}")
    "assignment" => Console.print_line("${marked(count)}")
    "inherited" => Console.print_line("${shelved(Shelf(items: [4, 5]), index: count)}")
    _ => Console.print_line("${total(numbers)} ${element(numbers, index: 1)} ${tail_length(numbers, start: 1)} ${marked(1)} ${shelved(Shelf(items: [4, 5]), index: 1)}")
  }
  ExitCode.success
}
