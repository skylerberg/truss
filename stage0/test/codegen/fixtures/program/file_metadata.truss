use standard.files

fn main(arguments: List[String]) -> ExitCode
  uses Console, FileRead, FileWrite, Handles
{
  let directory = Path.new(arguments[1])
  let file = Path.new(arguments[2])
  if FileWrite.write_text(file, contents: "twelve bytes") is Err(_) {
    return ExitCode(1)
  }
  match FileRead.metadata(file, follow_links: true) {
    Ok(metadata) => {
      Console.print_line("file ${metadata.is_file()} ${metadata.length}")
      Console.print_line("recent ${metadata.modified.unix_nanoseconds() > 1577836800000000000}")
      Console.print_line("accessed ${metadata.accessed.is_some()}")
      Console.print_line("owner can write ${!metadata.permissions.is_read_only()}")
    }
    Err(_) => Console.print_line("no file")
  }
  match FileRead.metadata(directory, follow_links: false) {
    Ok(metadata) => {
      Console.print_line("directory ${metadata.is_directory()} ${metadata.is_file()}")
    }
    Err(_) => Console.print_line("no directory")
  }
  if FileRead.metadata(Path.new("/nonexistent/truss"), follow_links: true) is Err(NotFound) {
    Console.print_line("missing")
  }
  match FileWrite.open(file, mode: files.WriteMode.Update) {
    Ok(opened) => {
      if opened.metadata() is Ok(metadata) {
        Console.print_line("open ${metadata.length}")
      }
    }
    Err(_) => {}
  }
  ExitCode(0)
}
