fn main(arguments: List[String]) -> ExitCode
  uses Console, Environment
{
  if Environment.variable("TRUSS_TEST_EMPTY") is Some(value) {
    Console.print_line("set to [${value}]")
  }
  if Environment.variable("TRUSS\0_TEST_EMPTY") is None {
    Console.print_line("no such name")
  }
  ExitCode(0)
}
