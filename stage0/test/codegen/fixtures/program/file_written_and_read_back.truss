use standard.files

fn main(arguments: List[String]) -> ExitCode
  uses Console, FileRead, FileWrite, Handles, RunForever
{
  let path = Path.new(arguments[1])
  if FileWrite.write_text(path, contents: "first\nsecond line\nlast") is Err(_) {
    return ExitCode(1)
  }
  if FileRead.read_text(path) is Ok(text) {
    Console.print_line("${text.length()} bytes")
  }
  let streamed = Path.new("${arguments[1]}.streamed")
  let wrote = files.write_with(streamed, write: fn(writer) {
    mut writer.write("one ")?
    mut writer.write_line("two")?
    mut writer.write_bytes("three".bytes())
  })
  if wrote is Ok(_) && FileRead.read_text(streamed) is Ok(text) {
    Console.print_line("streamed ${text}")
  }
  match FileRead.open(path) {
    Ok(file) => {
      var reader = own file
      if mut reader.read_line() is Ok(Some(line)) {
        Console.print_line("${line}")
      }
      if mut reader.read_line() is Ok(Some(line)) {
        Console.print_line("${line}")
      }
    }
    Err(_) => {}
  }
  if FileRead.read_text(Path.new("/nonexistent/truss")) is Err(NotFound) {
    Console.print_line("missing")
  }
  ExitCode(0)
}
