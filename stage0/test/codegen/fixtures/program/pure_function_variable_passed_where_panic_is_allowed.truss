fn apply(action: (fn(Int64) -> Int64 uses Panic), value: Int64) -> Int64
  uses Panic
{
  action(value)
}

fn doubled(value: Int64) -> Int64 {
  value.saturating_multiply(2)
}

fn main(arguments: List[String]) -> ExitCode
  uses Panic
{
  let pure: fn(Int64) -> Int64 = fn(value) { value.saturating_add(1) }
  let by_name = apply(doubled, value: 5)
  let by_variable = apply(pure, value: 5)
  if by_name == 10 && by_variable == 6 { ExitCode.success } else { ExitCode.failure }
}
