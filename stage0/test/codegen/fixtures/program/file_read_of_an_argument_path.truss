fn main(arguments: List[String]) -> ExitCode
  uses Console, FileRead
{
  if FileRead.read_text(Path.new(arguments[1])) is Ok(text) {
    Console.print_line("${text}")
  }
  if FileRead.read_text(Path.new("${arguments[1]}\0.hidden")) is Err(_) {
    Console.print_line("refused")
  }
  ExitCode(0)
}
