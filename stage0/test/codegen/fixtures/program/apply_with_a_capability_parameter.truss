fn apply(run: (fn() uses generic Granted))
  uses generic Granted
{
  run()
}

fn later(run: (fn() uses generic Granted)) -> (fn() uses generic Granted) {
  run
}

fn shout()
  uses Console
{
  Console.print_line("named")
}

fn main(arguments: Slice[String]) -> ExitCode
  uses Console
{
  apply(fn() { Console.print_line("inside") })
  apply(shout)
  let held = later(fn() { Console.print_line("kept") })
  held()
  ExitCode(0)
}
