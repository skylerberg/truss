fn first_positive(first_value: Int64, second_value: Int64) -> Option[Int64] {
  if first_value > 0 { Some(first_value) } else if second_value > 0 { Some(second_value) } else { None }
}

test "options" {
  assert first_positive(-1, second_value: 4) == Some(4)
  assert first_positive(-1, second_value: -2).is_none()
}
