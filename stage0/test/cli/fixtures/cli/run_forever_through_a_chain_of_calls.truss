fn main(arguments: List[String]) -> ExitCode
  uses RunForever
{
  let _ = outer(arguments.length())
  ExitCode.success
}

fn outer(count: UInt64) -> UInt64
  uses RunForever
{
  middle(count)
}

fn middle(count: UInt64) -> UInt64
  uses RunForever
{
  var last: UInt64 = 0
  for index in 0..count {
    last = index
  }
  last
}
