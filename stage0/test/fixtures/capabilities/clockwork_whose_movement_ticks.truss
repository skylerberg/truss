trait Clockwork {
  type Movement: Ticker

  fn wind(self, movement: mut Self.Movement) -> UInt64
    cost time O(time(Self.Movement.tick))
  {
    mut movement.tick()
  }
}

type Pocket(face: UInt64)

impl Clockwork for Pocket {
  type Movement = Countdown
}

type Broken(face: UInt64)

impl Clockwork for Broken {
  type Movement = Forever
}

fn run[Watch: Clockwork](movement: mut Watch.Movement) -> UInt64
  cost time O(time(Watch.Movement.tick))
{
  mut movement.tick()
}
