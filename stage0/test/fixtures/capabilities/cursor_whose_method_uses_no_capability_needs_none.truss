fn counted(count: Int64) yields Int64 {
  var index = 0
  while index < count {
    yield index
    index += 1
  }
}

fn pull[Source: Cursor](source: mut Source) -> Option[Source.Element]
  uses Source.Uses
{
  mut source.next()
}

fn first() -> Option[Int64] {
  var cursor = counted(3)
  pull(mut cursor)
}

fn length() -> USize {
  counted(3).count()
}
