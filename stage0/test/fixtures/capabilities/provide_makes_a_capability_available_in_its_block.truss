type FixedClock(time: Instant)

impl Clock for FixedClock {
  fn now(self) -> Instant { self.time }
  fn monotonic(self) -> Duration { todo }
  fn sleep(self, duration: Duration) {}
}

fn stamp() -> Instant
  uses Clock
{
  Clock.now()
}

fn run_example() -> Instant {
  provide FixedClock(time: Instant.epoch) {
    stamp()
  }
}
