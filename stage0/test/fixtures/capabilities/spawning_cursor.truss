type Spawning(left: UInt8)

impl Cursor for Spawning {
  type Element = UInt8
  capability Uses = Tasks, Counter

  fn next(mut self) -> Option[UInt8]
    uses Tasks, Counter
  {
    concurrent {
      count_once()
      count_once()
    }
    if self.left == 0 { None } else {
      self.left -= 1
      Some(self.left)
    }
  }
}
