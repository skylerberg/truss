capability Meter {
  fn read() -> Int64
}

type Fixed(value: Int64)

impl Meter for Fixed {
  fn read(self) -> Int64 {
    self.value
  }
}

type Readings(left: UInt64)

fn Readings.remaining(self) -> UInt64 {
  self.left
}

impl Cursor for Readings {
  type Element = Int64
  capability Uses = Meter

  fn next(mut self) -> Option[Int64]
    uses Meter
  {
    if self.left == 0 {
      return None
    }
    self.left -= 1
    Some(Meter.read())
  }
}

fn readings(count: UInt64) -> Readings {
  Readings(left: count)
}

