type Countdown(left: UInt8)

impl Cursor for Countdown {
  type Element = UInt8

  fn next(mut self) -> Option[UInt8] {
    if self.left == 0 { None } else {
      self.left -= 1
      Some(self.left)
    }
  }
}

fn last(start: Countdown) -> UInt8 {
  var left = start
  var last: UInt8 = 0
  for value in left {
    last = value
  }
  last
}
