trait Visited {
  fn visit(self, each: (fn(Int64) uses generic Granted))
    uses generic Granted
}

type Single(value: Int64)

impl Visited for Single {
  fn visit(self, each: (fn(Int64) uses generic Granted))
    uses generic Granted
    cost time O(time(each))
  {
    each(self.value)
  }
}

type Silent(value: Int64)

impl Visited for Silent {
  fn visit(self, each: (fn(Int64) uses generic Granted))
    uses generic Granted
    cost time O(1)
  {
  }
}

fn visit_once[Source: Visited](source: Source)
  cost time O(time(Source.visit))
{
  source.visit(fn(_) { })
}
