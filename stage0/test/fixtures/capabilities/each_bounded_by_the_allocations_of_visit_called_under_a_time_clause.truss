fn each(items: List[Int64], visit: (fn(Int64) uses generic Granted))
  uses generic Granted
  cost allocations <= items.length() * allocations(visit)
{
  for item in items {
    visit(item)
  }
}

fn f(items: List[Int64])
  cost time O(items.length())
{
  each(items, visit: fn(item) {
    let _ = item
  })
}
