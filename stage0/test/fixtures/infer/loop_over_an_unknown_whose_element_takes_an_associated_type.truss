trait Positioned {
  type Position

  fn count(self) -> UInt64

  fn element(self, position: Self.Position) lends Self.Position
}

type Holder[Item](item: Item)

impl Positioned for Holder[Item] {
  type Position = Item

  fn count(self) -> UInt64 {
    1
  }

  fn element(self, position: Item) lends Item {
    self.item
  }
}

