trait Paired[Other] {
  fn name(self) -> String
  fn matches(self, other: Other) -> Bool
}

trait SelfPaired: Paired[Self] {
  fn id(self) -> Int64
}

type Dog(tag: String, weight: Int64)

type Cat(lives: Int64)

impl Paired[Dog] for Dog {
  fn name(self) -> String {
    self.tag.copy()
  }

  fn matches(self, other: Dog) -> Bool {
    self.weight == other.weight
  }
}

impl SelfPaired for Dog {
  fn id(self) -> Int64 {
    1
  }
}

impl Paired[Cat] for Cat {
  fn name(self) -> String {
    "cat"
  }

  fn matches(self, other: Cat) -> Bool {
    self.lives == other.lives
  }
}

impl SelfPaired for Cat {
  fn id(self) -> Int64 {
    2
  }
}

fn describe(pet: any SelfPaired) -> String {
  "${pet.name()} ${pet.id()}"
}

fn match_a_dog_against_a_cat() -> Bool {
  let dog: any SelfPaired = any Dog(tag: "rex", weight: 9)
  let cat: any SelfPaired = any Cat(lives: 9)
  dog.matches(cat)
}
