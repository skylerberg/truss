trait Visitor {
  fn visit(self, session: UInt64)
    uses Panic, RunForever
}

capability Sessions {
  fn touch(session: UInt64)
  fn each(visit: (fn(UInt64) uses Panic, RunForever))
  fn each_visitor(visitor: any Visitor)
}

type Table(sessions: List[UInt64])

impl Sessions for Table {
  fn touch(mut self, session: UInt64) {
    mut self.sessions.push(session)
  }

  fn each(mut self, visit: (fn(UInt64) uses Panic, RunForever)) {
  }

  fn each_visitor(mut self, visitor: any Visitor) {
  }
}

fn serve(session: UInt64)
  uses Sessions
{
  Sessions.touch(session)
}

fn f()
  uses Tasks
{
  var table = Table(sessions: [])
  provide mut table {
    concurrent {
      serve(1)
      serve(2)
    }
  }
}
