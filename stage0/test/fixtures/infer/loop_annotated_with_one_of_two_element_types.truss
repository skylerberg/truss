type Pair(first: Int64, second: String)

fn Pair.count(self) -> UInt64 { 1 }

trait Positioned[Item] {
  fn element(self, position: UInt64) lends Item
}

impl Positioned[Int64] for Pair {
  fn element(self, position: UInt64) lends Int64 { self.first }
}

impl Positioned[String] for Pair {
  fn element(self, position: UInt64) lends String { self.second }
}

fn has_seven(pair: Pair) -> Bool {
  for item: String in pair {
    if item == "seven" {
      return true
    }
  }
  false
}
