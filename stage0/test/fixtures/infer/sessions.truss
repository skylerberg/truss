capability Sessions {
  fn touch(session: UInt64)
  fn each(visit: (fn(UInt64) uses Clock))
}

type Table(sessions: List[UInt64])

impl Sessions for Table {
  fn touch(mut self, session: UInt64) {
    mut self.sessions.push(session)
  }

  fn each(mut self, visit: (fn(UInt64) uses Clock)) {
  }
}

fn serve(session: UInt64)
  uses Sessions
{
  Sessions.touch(session)
}

