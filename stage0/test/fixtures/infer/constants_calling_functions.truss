type Money(cents: Int64) derives Equal

impl Add[Money] for Money {
  type Output = Money

  fn add_is_defined(self, right: Money) -> Bool {
    true
  }

  fn add(self, right: Money) -> Money {
    Money(cents: self.cents.saturating_add(right.cents))
  }
}

fn compute() -> Int64 {
  1
}

let computed: Int64 = compute()
let length: UInt64 = "four".length()
let numbers: List[Int64] = [1, 2]
let first: Int64 = numbers[0]
let rest: Slice[Int64] = numbers[1..2]
let greeting: String = "a"
let same: Bool = greeting == greeting
let total: Money = Money(cents: 1) + Money(cents: compute())
let report: String = "the total is ${computed}"
let letter: Character = Character"a"
let all_are_small: Bool = forall number in numbers => number < 10
let holds_two: Bool = exists index in 0..2 => numbers[index] == 2
