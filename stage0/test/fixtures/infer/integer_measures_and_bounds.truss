fn count_down(count: UInt64) -> UInt64
  decreases count, 1
{
  if count == 0 { 0 } else { count_down(count - 1) }
}

fn count_up(index: UInt64, count: UInt64) -> UInt64
  decreases count - index
{
  if index >= count { index } else { count_up(index + 1, count: count) }
}

fn visit_each(items: Slice[Int64], visit: fn(Int64))
  cost time O(items.length() * time(visit))
{
  var index: UInt64 = 0
  while index < items.length()
    decreases items.length() - index
    cost time O(index * time(visit))
  {
    visit(items[index])
    index = index + 1
  }
}
