trait Ticker {
  fn tick(mut self) -> UInt64

  fn tick_twice(mut self) -> UInt64
    cost time O(time(Self.tick))
  {
    let _ = mut self.tick()
    mut self.tick()
  }
}

type Countdown(left: UInt64)

impl Ticker for Countdown {
  fn tick(mut self) -> UInt64
    cost time O(1)
  {
    self.left
  }
}

type Forever(step: UInt64)

impl Ticker for Forever {
  fn tick(mut self) -> UInt64 {
    self.step
  }
}

type Relay[Inner: Ticker](inner: Inner)

impl Ticker for Relay[Inner: Ticker] {
  fn tick(mut self) -> UInt64
    cost time O(time(Inner.tick))
  {
    mut self.inner.tick()
  }
}

fn advance[Inner: Ticker](ticker: mut Inner) -> UInt64
  cost time O(time(Inner.tick))
{
  mut ticker.tick()
}

fn same[Element: Equal](left: Element, right: Element) -> Bool
  cost time O(time(Element.equal))
{
  left == right
}
