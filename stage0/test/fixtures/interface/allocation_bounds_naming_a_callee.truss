trait Ticker {
  fn tick(mut self) -> UInt64
}

fn counted[Inner: Ticker](ticker: mut Inner) -> UInt64
  cost allocations <= allocations(Inner.tick)
{
  mut ticker.tick()
}

fn timed_and_counted[Inner: Ticker](ticker: mut Inner) -> UInt64
  cost time O(time(Inner.tick))
  cost allocations <= allocations(Inner.tick)
{
  mut ticker.tick()
}

fn visited(visit: (fn(Int64) uses generic Granted))
  uses generic Granted
  cost allocations <= allocations(visit)
  cost allocated_bytes O(allocated_bytes(visit))
{
  visit(1)
}

fn visited_in_finite_time(visit: (fn(Int64) uses generic Granted cost time finite))
  uses generic Granted
  cost time finite
  cost allocations <= allocations(visit)
{
  visit(1)
}

fn timed_and_visited(visit: (fn(Int64) uses generic Granted))
  uses generic Granted
  cost time O(time(visit))
  cost allocations <= allocations(visit)
{
  visit(1)
}
