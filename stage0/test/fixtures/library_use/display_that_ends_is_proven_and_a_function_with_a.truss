type Point(first_number: Int64, second_number: Int64)

impl Display for Point {
  fn display(self, output: mut TextBuilder) {
    mut output.write("(")
    self.first_number.display(mut output)
    mut output.write(", ")
    self.second_number.display(mut output)
    mut output.write(")")
  }
}

fn shown(point: Point) -> String
  cost time finite
{
  var output = TextBuilder.new()
  point.display(mut output)
  own output.finish()
}
