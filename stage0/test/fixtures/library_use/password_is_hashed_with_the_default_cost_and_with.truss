use standard::cryptography

fn stored(password: Slice[UInt8], salt: Array[UInt8, 16]) -> Array[UInt8, 32] {
  cryptography::hash_password(password, salt: salt[..])
}

fn costly(password: Slice[UInt8], salt: Array[UInt8, 16]) -> Array[UInt8, 32] {
  let password_cost = cryptography::PasswordCost(memory_kibibytes: 65536, parallelism: 4)
  cryptography::hash_password(password, salt: salt[..], password_cost: password_cost)
}
