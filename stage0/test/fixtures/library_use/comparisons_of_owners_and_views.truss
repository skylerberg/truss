fn same_as_view(text: own String, viewed: String) -> Bool
  cost allocations == 0
{
  text == viewed
}

fn same_as_part(numbers: own List[Int64], part: List[Int64]) -> Bool
  cost allocations == 0
{
  part == numbers
}

fn equals_its_whole_slice(numbers: own List[Int64]) -> Bool
  ensures result
{
  numbers == numbers[..]
}
