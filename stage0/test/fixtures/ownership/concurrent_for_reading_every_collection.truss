impl Iterable for Pair {
  type Element = List[Int64]

  fn count(self) -> UInt64 {
    2
  }

  fn element(self, position: UInt64) lends List[Int64] {
    if position == 0 {
      self.first
    } else {
      self.second
    }
  }
}

impl IterableMut for Pair {
  fn element(mut self, position: UInt64) lends mut List[Int64] {
    if position == 0 {
      mut self.first
    } else {
      mut self.second
    }
  }
}

fn f(pair: Pair, names: own List[String], parts: own List[List[Int64]])
  uses Tasks
{
  concurrent for list in pair {
    look(list)
  }
  concurrent for name in names {
    look(name)
  }
  concurrent for part in parts {
    look(part)
  }
}
