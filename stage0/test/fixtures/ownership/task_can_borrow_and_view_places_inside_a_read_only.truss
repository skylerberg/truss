fn Pair.each(self) yields List[Int64] {
  yield self.first
  yield self.second
}

fn Pair.words(self) yields own StringSlice {
  yield self.text.slice()
}

fn f(pair: Pair, names: List[String], parts: List[Slice[Int64]])
  uses Tasks
{
  concurrent for list in pair.each() {
    look(list)
  }
  concurrent for word in pair.words() {
    look(word)
  }
  concurrent for name in names {
    look(name)
  }
  concurrent for part in parts {
    look(part)
  }
}
