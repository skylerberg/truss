fn Pair.count(self) -> USize {
  2
}

fn Pair.element(self, position: USize) lends List[Int64] {
  if position == 0 {
    self.first
  } else {
    self.second
  }
}

fn Pair.element(mut self, position: USize) lends mut List[Int64] {
  if position == 0 {
    mut self.first
  } else {
    mut self.second
  }
}

fn f(pair: Pair, names: List[String], parts: List[Slice[Int64]])
  uses Tasks
{
  concurrent for list in pair {
    look(list)
  }
  concurrent for name in names {
    look(name)
  }
  concurrent for part in parts {
    look(part)
  }
}
