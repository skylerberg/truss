fn bump(items: mut List[Int64])
  modifies items[..]
  requires items.length() > 0
{
  items[0] = 9
}

type Window(rest: view List[Int64])

fn narrow(window: mut Window, count: UInt64) {
  window.rest = window.rest[..count]
}

fn f(supplied: mut List[Int64]) -> UInt64 {
  var items: List[Int64] = [3, 1, 2]
  bump(mut items[..])
  items[1..][0] = 4
  bump(mut supplied[..])
  items.length()
}
