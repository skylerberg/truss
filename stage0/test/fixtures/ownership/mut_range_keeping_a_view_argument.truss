fn keep(held: mut List[view List[Int64]], viewed: view List[Int64])
  modifies held[..]
{
  held[0] = viewed
}

fn f() -> UInt64 {
  var data: List[Int64] = [1, 2, 3]
  let other: List[Int64] = [4]
  var views: List[view List[Int64]] = [other[..]]
  keep(mut views[..], viewed: data[0..2])
  mut data.push(4)
  views.length()
}
