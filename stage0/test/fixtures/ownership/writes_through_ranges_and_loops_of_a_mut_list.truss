fn f(items: mut List[String]) {
  mut items[..][..].reverse()
  mut items[..][..][0].push("x")
  for item in mut items[..][..] {
    mut item.push("y")
  }
  for item in mut items[..] {
    item = "z"
  }
}

fn g(viewed: mut List[String])
  modifies viewed[..]
{
  mut viewed[..].reverse()
  for item in mut viewed {
    mut item.push("x")
  }
}

fn h(rows: mut List[List[Int64]]) {
  rows[..][0][0] = 7
  mut rows[..][0][..].sort()
}
