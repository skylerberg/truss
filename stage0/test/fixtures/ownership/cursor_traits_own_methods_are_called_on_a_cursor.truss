fn f(items: List[Int64], text: String) -> USize {
  var cursor = items.cursor()
  let _ = mut cursor.find(fn(item) { item > 3 })
  let _ = items.cursor().fold(0, combine: fn(total, item) { total + item })
  let skipped = items.cursor().skip(1).count()
  let moved = items.cursor().take(1).count()
  skipped + moved + text.characters().skip(1).count()
}
