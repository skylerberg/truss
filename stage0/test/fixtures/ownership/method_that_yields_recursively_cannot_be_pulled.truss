type Tree =
  | Leaf
  | indirect Node(left: Tree, value: Int64, right: Tree)

fn Tree.each(self) yields Int64 {
  match self {
    Leaf => {}
    Node(left, value, right) => {
      for item in left.each() {
        yield item
      }
      yield value
      for item in right.each() {
        yield item
      }
    }
  }
}

fn run_example(tree: Tree) -> Option[Int64] {
  var cursor = tree.each()
  mut cursor.next()
}
