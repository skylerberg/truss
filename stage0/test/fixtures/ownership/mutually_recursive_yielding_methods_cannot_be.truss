fn Tree.first(self) yields Int64 {
  match self {
    Leaf => {}
    Node(left, ..) => {
      for item in left.second() {
        yield item
      }
    }
  }
}

fn Tree.second(self) yields Int64 {
  for item in self.first() {
    yield item
  }
}

fn f(tree: Tree) -> Option[Int64] {
  var cursor = tree.first()
  mut cursor.next()
}
