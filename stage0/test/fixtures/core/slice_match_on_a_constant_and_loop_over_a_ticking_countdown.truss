capability Meter {
  fn tick()
}

type Countdown(left: UInt8)

impl Cursor for Countdown {
  type Element = UInt8
  capability Uses = Meter

  fn next(mut self) -> Option[UInt8]
    uses Meter
  {
    Meter.tick()
    if self.left == 0 { None } else {
      self.left -= 1
      Some(self.left)
    }
  }
}

fn g(items: List[Int64], code: ExitCode, start: Countdown) -> UInt64
  uses Meter
{
  var left = start
  for value in left {
    let _ = value
  }
  let rest = items[1..]
  match code {
    ExitCode.success => rest.length()
    _ => 0
  }
}
