type Pair(first: Int64, second: Int64)

fn f(pair: Pair, items: Slice[Int64], index: UInt64, other: UInt64) -> Bool
  requires index < items.length()
  requires other < items.length()
  requires items.length() > 1
{
  pair.first == pair.second
    && items[index] == items[other]
    && items[0] <= items[1]
    && items.length() == items.length()
}
