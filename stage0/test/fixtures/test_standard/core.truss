use standard::intrinsic

public trait Equal {
  fn equal(self, other: Self) -> Bool
    cost time finite
}

public trait Add[Right] {
  type Output

  fn add_is_defined(self, right: Right) -> Bool
    cost time finite

  fn add(self, right: Right) -> Self.Output
    requires self.add_is_defined(right)
}

public trait Multiply[Right] {
  type Output

  fn multiply_is_defined(self, right: Right) -> Bool
    cost time finite

  fn multiply(self, right: Right) -> Self.Output
    requires self.multiply_is_defined(right)
}

impl Equal for Int64 {
  fn equal(self, other: Int64) -> Bool
    cost time O(1)
  {
    intrinsic::equal(self, right: other)
  }
}

impl Add[Int64] for Int64 {
  type Output = Int64

  fn add_is_defined(self, right: Int64) -> Bool
    cost time O(1)
  {
    !intrinsic::add_overflows(self, right: right)
  }

  fn add(self, right: Int64) -> Int64
    requires !intrinsic::add_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::add(self, right)
  }
}

impl Multiply[Int64] for Int64 {
  type Output = Int64

  fn multiply_is_defined(self, right: Int64) -> Bool
    cost time O(1)
  {
    !intrinsic::multiply_overflows(self, right: right)
  }

  fn multiply(self, right: Int64) -> Int64
    requires !intrinsic::multiply_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::multiply(self, right)
  }
}
