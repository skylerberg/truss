fn apply(change: (fn(Bool) -> Bool cost allocations == 0), value: Bool) -> Bool
  ensures result == change(value)
{
  change(value)
}

theorem each_kept(items: view List[Bool])
  ensures forall i in 0..items.length() =>
    apply(fn(x) {
      let held = x
      held
    }, value: items[i]) == items[i]
{
}
