type Samples(values: List[Int64])

impl Index for Samples {
  type Key = USize
  type Output = Int64

  fn contains_key(self, key: USize) -> Bool
    ensures result == (key < self.values.length())
    cost time O(1)
  {
    key < self.values.length()
  }

  fn at(self, key: USize) lends Int64
    requires key < self.values.length()
    cost time O(1)
  {
    self.values[key]
  }
}

impl IndexAssign for Samples {
  fn accepts_key(self, key: USize) -> Bool
    ensures result == (key < self.values.length())
    cost time O(1)
  {
    key < self.values.length()
  }

  fn assign(mut self, key: own USize, value: own Int64)
    requires key < self.values.length()
    ensures self.values.length() == old(self.values.length())
    cost amortized time O(1)
  {
    self.values[key] = value
  }
}

