type Point(x: Int64, y: Int64)

let limit: UInt64 = 24 * 60 * 60
let name: String = "truss"
let corner: Point = Point(x: 1, y: 2)
let primes: List[UInt64] = [2, 3, 5]
let ages: Map[String, UInt64] = ["ada": 36]
let codes: Set[UInt64] = [7, 9]
let initial: Character = Character"a"
let newline: UInt8 = UInt8"\n"

fn read_them() -> UInt64 {
  limit.saturating_add(name.length()).saturating_add(primes.length()).saturating_add(ages.count())
}

fn read_corner() -> Int64 {
  corner.x
}

fn read_scalars() -> Bool {
  codes.count() == 2 && initial == Character"a" && newline == 10
}
