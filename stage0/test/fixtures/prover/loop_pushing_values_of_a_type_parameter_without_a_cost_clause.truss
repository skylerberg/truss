fn f[Output, capability Granted](
  source: List[Int64],
  transform: (fn(Int64) -> Output uses Granted),
) -> List[Output]
  uses Granted
  cost time O(source.length() * time(transform))
{
  var results: List[Output] = []
  for item in source {
    mut results.push(transform(item))
  }
  results
}
