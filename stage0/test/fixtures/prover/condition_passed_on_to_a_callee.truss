fn scaled(count: Int64) -> Int64
  uses Panic unless Int64.minimum <= count * 1000 && count * 1000 <= Int64.maximum
  ensures result == count * 1000
{
  count * 1000
}

fn small(count: Int64) -> Int64
  uses Panic unless count < 1000
{
  if count < 0 { 0 } else { scaled(count) }
}

fn large(count: Int64) -> Int64
  uses Panic unless count < 1000000000000000000
{
  if count < 0 { 0 } else { scaled(count) }
}
