fn to_seconds(hours: UInt64) -> UInt64
  requires hours <= 24
{
  hours * 60 * 60
}

fn is_even(value: UInt64) -> Bool {
  value % 2 == 0
}

fn pick(first: Bool) -> Character {
  if first {
    Character"a"
  } else {
    Character"b"
  }
}

let seconds_per_day: UInt64 = to_seconds(24)
let seconds_per_two_days: UInt64 = seconds_per_day * 2
let day_is_even: Bool = is_even(seconds_per_day)
let initial: Character = pick(true)

fn read_seconds() -> UInt64
  ensures result == 86400
{
  seconds_per_day
}

fn read_two_days() -> UInt64
  ensures result == 172800
{
  seconds_per_two_days
}

fn read_evenness() -> Bool
  ensures result
{
  day_is_even
}

fn read_initial() -> Character
  ensures result == Character"a"
{
  initial
}

type Point(x: Int64, y: Int64)

type Shape =
  | Circle(radius: Float64)
  | Square(side: Float64)

type Label(name: String, corner: Point, shape: Shape)

fn make_point() -> Point {
  Point(x: 3, y: 4)
}

fn make_ratio() -> Float64 {
  0.5
}

fn make_label() -> Label {
  Label(name: "origin", corner: make_point(), shape: Shape.Circle(radius: 1.5))
}

let corner: Point = make_point()
let ratio: Float64 = make_ratio()
let label: Label = make_label()

fn read_corner() -> Int64
  ensures result == 4
{
  corner.y
}

fn read_ratio() -> Float64
  ensures result == 0.5
{
  ratio
}

fn read_label_corner() -> Int64
  ensures result == 3
{
  label.corner.x
}

fn read_label_radius() -> Float64
  ensures result == 1.5
{
  match label.shape {
    Circle(radius) => radius
    Square(side) => side
  }
}
