fn take(count: mut Int64) -> Int64
  requires count > -1000
  ensures count == old(count) - 1
  ensures result == old(count)
  cost time O(1)
{
  count -= 1
  count + 1
}

fn run_example()
  cost time finite
{
  var step_index: Int64 = 0
  while take(mut step_index) < 10
    invariant step_index > -100
  {
    step_index += 1
  }
}
