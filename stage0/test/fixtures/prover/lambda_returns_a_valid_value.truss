type Positive(limit_count: Int64)
  invariant limit_count > 0

fn apply(change: fn(Positive) -> Positive, value: Positive) -> Positive {
  change(value)
}

fn run_example() -> Positive {
  apply(fn(probe_point) {
    var second_point = probe_point
    second_point.limit_count = 0
    second_point
  }, value: Positive(limit_count: 1))
}
