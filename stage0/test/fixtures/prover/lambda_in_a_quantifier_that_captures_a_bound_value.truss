fn apply(change: (fn(Bool) -> Bool cost time finite), value: Bool) -> Bool
  ensures result == change(value)
  cost time finite
{
  change(value)
}

theorem each_captured(items: List[Bool])
  ensures forall step_index in 0..items.length() =>
    apply(fn(_) {
      var held = items[step_index]
      held
    }, value: false) == items[step_index]
{
}
