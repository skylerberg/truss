type Countdown(left: UInt8)

impl Cursor for Countdown {
  type Element = UInt8

  fn next(mut self) -> Option[UInt8]
    ensures result != None ==> self.left < old(self.left)
    ensures result != None ==> result == Some(self.left)
    cost time finite
  {
    if self.left == 0 { None } else {
      self.left -= 1
      Some(self.left)
    }
  }
}

type Timer(countdown: Countdown, ticks: UInt8)

fn f(timer: mut Timer) -> UInt8
  ensures timer.ticks == old(timer.ticks)
  cost time finite
{
  var last: UInt8 = 0
  for value in timer.countdown
    invariant timer.ticks == old(timer.ticks)
    decreases timer.countdown.left
  {
    last = value
  }
  last
}
