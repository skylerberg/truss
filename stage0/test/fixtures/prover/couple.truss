type Couple(first: Int64, second: Int64)

fn Couple.count(self) -> USize
  ensures result == 2
  cost time O(1)
{
  2
}

fn Couple.element(self, position: USize) lends Int64
  requires position < 2
  ensures result == self.first || result == self.second
  cost time O(1)
{
  if position == 0 {
    self.first
  } else {
    self.second
  }
}

