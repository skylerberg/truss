use standard::math

fn f(value: Int64) -> Int64
  ensures result == value
{
  match Int64.try_from(math::BigInteger.from(value)) {
    Ok(converted) => converted
    Err(_) => unreachable
  }
}

fn g(value: UInt64) -> UInt64
  ensures result == value
{
  match UInt64.try_from(math::BigInteger.from(value)) {
    Ok(converted) => converted
    Err(_) => unreachable
  }
}

fn h(value: Int64) -> UInt64
  requires value < 0
{
  match UInt64.try_from(math::BigInteger.from(value)) {
    Ok(_) => unreachable
    Err(_) => 0
  }
}
