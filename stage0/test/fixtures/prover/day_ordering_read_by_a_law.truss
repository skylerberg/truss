use standard.core

type Day(count: Int32)
  derives Equal, Ordered

impl core.Countable for Day {
  fn successor(self) -> Option[Day]
    cost time O(1)
  {
    self.advanced(1)
  }

  fn predecessor(self) -> Option[Day]
    cost time O(1)
  {
    self.retreated(1)
  }

  fn advanced(self, by: UInt64) -> Option[Day]
    ensures (result is None) == (self.count + by > Int32.maximum)
    ensures !(result is Some(value) && value.count != self.count + by)
    cost time O(1)
  {
    match self.count.advanced(by: by) {
      Some(count) => Some(Day(count: count))
      None => None
    }
  }

  fn retreated(self, by: UInt64) -> Option[Day]
    ensures (result is None) == (self.count - by < Int32.minimum)
    ensures !(result is Some(value) && value.count != self.count - by)
    cost time O(1)
  {
    match self.count.retreated(by: by) {
      Some(count) => Some(Day(count: count))
      None => None
    }
  }

  fn steps_to(self, other: Day) -> Option[UInt64]
    ensures (result is None) == (other.count < self.count)
    ensures !(result is Some(steps) && steps != other.count - self.count)
    cost time O(1)
  {
    self.count.steps_to(other.count)
  }
}
