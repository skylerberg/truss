fn f[Output, capability Granted](
  results: mut List[Output],
  source: List[Int64],
  transform: (fn(Int64) -> Output uses Granted),
)
  uses Granted
  cost amortized time O(source.length() * time(transform))
{
  for index in 0..source.length()
    cost time O(index * time(transform))
  {
    mut results.push(transform(source[index]))
  }
}
