fn set(part: mut Slice[Int64])
  requires part.length() >= 1
  ensures part[0] == 7
{
  part[0] = 7
}

fn f(flag: Bool, first: mut List[Int64], second: mut List[Int64])
  requires first.length() >= 2
  requires second.length() >= 2
  ensures flag ==> first[0] == 7
  ensures !flag ==> second[0] == 7
  ensures !flag ==> first[0] == old(first[0])
  ensures flag ==> second[0] == old(second[0])
{
  var part = if flag { first[0..2] } else { second[0..2] }
  set(mut part)
}
