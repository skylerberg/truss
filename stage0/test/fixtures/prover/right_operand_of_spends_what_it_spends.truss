capability Hits {
  fn hit()
    cost time finite
}

type Counter(count: Int64)

impl Hits for Counter {
  fn hit(mut self) {
    self.count = self.count.saturating_add(1)
  }
}

fn f(flag: Bool, visit: (fn() -> Bool uses Hits cost time finite)) -> Bool
  uses Hits
  cost calls(visit) == 0
{
  flag || visit()
}
