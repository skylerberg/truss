fn pick(
  items: List[UInt8],
  choose: (fn(count: UInt64) -> UInt64 uses generic Granted requires count > 0 ensures result < count),
) -> UInt8
  uses generic Granted
  requires items.length() > 0
{
  items[choose(items.length())]
}

fn lowest(count: UInt64) -> UInt64
  requires count > 0
  ensures result < count
{
  0
}

fn whole(count: UInt64) -> UInt64 {
  count
}

fn first(deck: List[UInt8]) -> UInt8
  requires deck.length() > 0
{
  pick(deck, choose: lowest)
}

fn past_the_end(deck: List[UInt8]) -> UInt8
  requires deck.length() > 0
{
  pick(deck, choose: whole)
}
