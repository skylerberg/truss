fn grow(limit: mut USize, visit: (fn(index: USize) -> Int64 requires index < limit)) -> Int64 {
  if limit < 100 { limit = limit + 1 }
  visit(limit - 1)
}

fn run_example(items: List[Int64]) -> Int64 {
  var limit_count: USize = 0
  grow(mut limit_count, visit: fn(step_index) { items[step_index] })
}
