trait Steps {
  fn left(self) -> Int64
  fn right(self) -> Int64
}

trait LinkedSteps: Steps {
  fn left(self) -> Int64
    ensures result == self.right() + 6

  fn right(self) -> Int64
    ensures result == self.left() - 6
}

type Walker(x: Int64)

impl Steps for Walker {
  fn left(self) -> Int64
    ensures result == 1
  {
    1
  }

  fn right(self) -> Int64
    ensures result == 1
  {
    1
  }
}

impl LinkedSteps for Walker {
}

trait LeftSteps: Steps {
  fn left(self) -> Int64
    ensures result == self.right() + 6
}

trait RightSteps: Steps {
  fn right(self) -> Int64
    ensures result == self.left() - 6
}

type Runner(x: Int64)

impl Steps for Runner {
  fn left(self) -> Int64
    ensures result == 1
  {
    1
  }

  fn right(self) -> Int64
    ensures result == 1
  {
    1
  }
}

impl LeftSteps for Runner {
}

impl RightSteps for Runner {
}

trait Paces {
  fn pace(self) -> Int64

  law seven(value: Self) {
    value.pace() == 7
  }
}

trait LinkedPaces: Paces {
  fn pace(self) -> Int64
    ensures result == 7
}

type Pacer(x: Int64)

impl Paces for Pacer {
  fn pace(self) -> Int64 {
    1
  }
}

impl LinkedPaces for Pacer {
}

trait Strides {
  fn stride(self) -> Int64
}

trait LinkedStrides: Strides {
  fn stride(self) -> Int64
    ensures result == 7
}

trait Totals: LinkedStrides {
  fn total(self) -> Int64

  law seven(value: Self) {
    value.stride() == 7
  }
}

type Strider(x: Int64)

impl Strides for Strider {
  fn stride(self) -> Int64
    ensures result == 1 && self.total() == 2
  {
    1
  }
}

impl LinkedStrides for Strider {
}

impl Totals for Strider {
  fn total(self) -> Int64
    ensures result == 2
  {
    2
  }
}
