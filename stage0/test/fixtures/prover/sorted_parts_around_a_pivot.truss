fn sort_part[Element: Ordered](items: mut Slice[Element])
  ensures items.is_sorted()
  ensures items.model().is_permutation_of(old(items.model()))
  ensures forall i in 0..items.length() => old(items.model()).contains(items[i])
{
  todo
}

fn sort_around[Element: Ordered](items: mut Slice[Element], middle: UInt64)
  requires middle < items.length()
  requires forall i in 0..middle => items[i] < items[middle]
  requires forall i in middle..items.length() => items[middle] <= items[i]
  ensures items.is_sorted()
  ensures items.model().is_permutation_of(old(items.model()))
{
  sort_part(mut items[..middle])
  sort_part(mut items[middle + 1..])
}
