fn triangle(limit_count: Int64) -> Int64
  requires limit_count >= 0 && limit_count <= 1000
  ensures result <= limit_count * 1000
  decreases limit_count
  cost time finite
{
  if limit_count == 0 { 0 } else { limit_count + triangle(limit_count - 1) }
}

theorem triangle_at_least(limit_count: Int64)
  requires limit_count >= 0 && limit_count <= 1000
  ensures triangle(limit_count) >= limit_count
  decreases limit_count
  cost time finite
{
  if limit_count > 0 {
    triangle_at_least(limit_count - 1)
  }
}

trait Bounded {
  fn amount(self) -> Int64
    ensures result >= 0 && result <= 1000
    cost time finite

  law covered(value: Self) {
    triangle(value.amount()) >= value.amount()
  }
}

type Box[Item](item: Item, amount: Int64)
  invariant amount >= 0 && amount <= 1000

impl Bounded for Box[Element] {
  fn amount(self) -> Int64
    ensures result >= 0 && result <= 1000
    cost time finite
  {
    self.amount
  }
}

proof Bounded.covered for Box[Item] {
  triangle_at_least(value.amount())
}
