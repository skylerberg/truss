use standard.text

type Shout[Tone](text: String)

impl FromTemplate for Shout[Tone] {
  type Part = String

  fn is_valid_template(literals: Slice[text.Literal]) -> Bool
    ensures result == (literals.length() == 1 && literals[0].text().length() == 3)
  {
    literals.length() == 1 && literals[0].text().length() == 3
  }

  fn from_template(template: Template[String]) -> Shout[Tone] {
    Shout(text: "")
  }
}

