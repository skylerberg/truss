fn tally[Source: Cursor](source: own Source) -> UInt64
  uses Source.Uses, RunForever unless Source: FiniteCursor
  cost amortized time O((source.remaining() + 1) * time(Source.next)) when Source: FiniteCursor
{
  var cursor = own source
  var count: UInt64 = 0
  while mut cursor.next() is Some(_)
    decreases cursor.remaining() when Source: FiniteCursor
    cost time O(time(Source.next)) when Source: FiniteCursor
  {
    count = count.saturating_add(1)
  }
  count
}
