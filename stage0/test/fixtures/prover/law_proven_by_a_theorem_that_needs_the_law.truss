trait Sized {
  fn size(self) -> Int64

  law at_least_one(value: Self) {
    value.size() >= 1
  }
}

type Box(n: Int64)

impl Sized for Box {
  fn size(self) -> Int64
    ensures result == self.n
  {
    self.n
  }
}

theorem needs(value: Box)
  ensures value.size() >= 1
{
}

proof Sized.at_least_one for Box {
  needs(value)
}
