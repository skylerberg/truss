use standard.text

type Shout[Tone](text: String)

type Loud()

impl FromTemplate for Shout[Tone] {
  type Part = String

  fn is_valid_template(literals: List[text.Literal]) -> Bool {
    literals.length() == 1
  }

  fn from_template(template: Template[String]) -> Shout[Tone] {
    Shout(text: "")
  }
}

fn loud() -> Shout[Loud] {
  Shout"hey"
}
