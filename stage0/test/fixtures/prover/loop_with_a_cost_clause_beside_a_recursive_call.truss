fn step(value: UInt64) -> UInt64
  cost time O(1)
{
  value
}

fn f(count: UInt64) -> UInt64
  decreases count
  cost time O(count * count)
{
  if count == 0 {
    return 0
  }
  var total: UInt64 = 0
  for index in 0..count
    cost time O(index)
  {
    total = step(index)
  }
  total = f(count - 1)
  total
}
