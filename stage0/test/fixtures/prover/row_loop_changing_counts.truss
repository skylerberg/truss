type Row(size: UInt64, value: Int64)

impl Iterable for Row {
  type Element = Int64

  fn count(self) -> UInt64
    ensures result == self.size
    cost time O(1)
  {
    self.size
  }

  fn element(self, position: UInt64) lends Int64
    cost time O(1)
  {
    self.value
  }
}

impl IterableMut for Row {
  fn element(mut self, position: UInt64) lends mut Int64
    cost time O(1)
  {
    self.size = 0
    mut self.value
  }
}

fn reset(row: mut Row) {
  for value in mut row {
    value = 0
  }
}
