fn apply(change: (fn(Bool) -> Bool cost time finite), value: Bool) -> Bool
  ensures result == change(value)
  cost time finite
{
  change(value)
}

theorem each_kept(items: List[Bool])
  ensures forall i in 0..items.length() =>
    apply(fn(x) {
      var held = x
      held
    }, value: items[i]) == items[i]
{
}
