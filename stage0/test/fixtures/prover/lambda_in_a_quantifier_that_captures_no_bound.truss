fn apply(change: (fn(Bool) -> Bool cost time finite), value: Bool) -> Bool
  ensures result == change(value)
  cost time finite
{
  change(value)
}

theorem each_kept(items: List[Bool])
  ensures forall step_index in 0..items.length() =>
    apply(fn(first_number) {
      var held = first_number
      held
    }, value: items[step_index]) == items[step_index]
{
}
