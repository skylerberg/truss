trait Describe {
  fn size(self) -> Int64
    cost time finite

  fn describe(self) -> Int64
    cost time finite
  {
    self.size()
  }
}

type Inner(size: Int64)

type Outer(inner: Inner)

impl Describe for Inner {
  fn size(self) -> Int64 {
    self.size
  }
}

impl Describe for Outer {
  fn size(self) -> Int64 {
    self.inner.size
  }

  fn describe(self) -> Int64 {
    self.inner.describe()
  }
}
