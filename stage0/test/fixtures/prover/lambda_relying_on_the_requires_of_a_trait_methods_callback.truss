trait Generates {
  fn generate(self, count: UInt64, make: (fn(index: UInt64) -> Int64 requires index < count)) -> Int64
    requires count > 0
}

type Eager()

impl Generates for Eager {
  fn generate(self, count: UInt64, make: (fn(index: UInt64) -> Int64 requires index < count)) -> Int64 {
    make(0)
  }
}

fn f(values: List[Int64]) -> Int64
  requires values.length() > 0
{
  Eager().generate(values.length(), make: fn(index) { values[index] })
}
