type Entry(code: UInt64)

fn matching(digit: Option[UInt64], entries: Slice[Entry]) -> Option[List[Entry]]
  uses Panic
  ensures match digit {
    Some(wanted) => result is Some(kept) && forall i in 0..kept.length() => kept.model()[i].code == wanted
    None => result is None
  }
{
  digit.map(fn(wanted) {
    let _ = wanted + 1
    entries.filter(fn(entry) { entry.code == wanted })
  })
}
