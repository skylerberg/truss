fn run(work: (fn() cost time finite))
  cost calls(work) == 1
{
  work()
}

fn f(flag: Bool, visit: (fn(Int64) cost time finite))
  cost calls(visit) == 0
{
  let calling: (fn() cost time finite) = fn() { visit(1) }
  let quiet: (fn() cost time finite) = fn() { let _ = flag }
  let _ = quiet
  run(calling)
}
