fn used_bits(length: USize) -> UInt64
  ensures result == (if length % 64 == 0 { UInt64.maximum } else { 5 })
  cost time O(1)
{
  if length % 64 == 0 { UInt64.maximum } else { 5 }
}

theorem the_unused_words_hold_five(words: List[UInt64], length: USize)
  requires length % 64 == 1
  requires forall step_index in 0..words.length() =>
    words[step_index] == (if step_index < length { 1 } else { used_bits(length) })
  ensures forall step_index in 0..words.length() => step_index >= length ==> words[step_index] == 5
{
}
