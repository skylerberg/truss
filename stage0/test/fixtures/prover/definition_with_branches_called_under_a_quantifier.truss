fn used_bits(length: USize) -> UInt64
  cost time O(1)
{
  if length % 64 == 0 { UInt64.maximum } else { 5 }
}

theorem the_unused_words_hold_five(words: List[UInt64], length: USize)
  requires length % 64 == 1
  requires forall i in 0..words.length() =>
    words[i] == (if i < length { 1 } else { used_bits(length) })
  ensures forall i in 0..words.length() => i >= length ==> words[i] == 5
{
}
