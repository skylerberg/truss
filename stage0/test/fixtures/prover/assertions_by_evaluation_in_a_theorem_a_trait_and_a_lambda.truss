fn is_small(value: UInt64) -> Bool {
  value < 10
}

theorem three_is_small()
  ensures is_small(3)
{
  assert is_small(3) by evaluation
}

trait Sized {
  fn size(self) -> UInt64

  fn is_sized(self) -> Bool
    ensures result
  {
    proof {
      assert is_small(4) by evaluation
    }
    is_small(4)
  }
}

type Box(value: UInt64)

impl Sized for Box {
  fn size(self) -> UInt64 {
    self.value
  }
}

fn in_a_lambda(items: List[UInt64]) -> List[Bool] {
  items.map(fn(item) {
    proof {
      assert is_small(5) by evaluation
    }
    is_small(5) && item > 0
  })
}
