trait Short: FiniteCursor {}

fn drain[Source: Cursor](source: own Source) -> UInt64
  uses Source.Uses, RunForever unless Source: Short
{
  var cursor = own source
  var count: UInt64 = 0
  while mut cursor.next() is Some(_)
    decreases cursor.remaining() when Source: FiniteCursor
  {
    count = count.saturating_add(1)
  }
  count
}
