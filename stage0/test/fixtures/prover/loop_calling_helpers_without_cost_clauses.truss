fn is_even(value: Int64) -> Bool {
  value % 2 == 0
}

fn is_negative(value: Int64) -> Bool {
  value < 0
}

fn has_negative_even(values: List[Int64]) -> Bool
  cost time O(values.length())
{
  for value in values {
    if is_even(value) && is_negative(value) {
      return true
    }
  }
  false
}
