capability Hits {
  fn hit()
}

type Counter(count: Int64)

impl Hits for Counter {
  fn hit(mut self) {
    self.count = self.count.saturating_add(1)
  }
}

fn f(flag: Bool, visit: (fn() uses Hits), other: (fn() uses Hits))
  uses Hits
  cost calls(visit) == 0
{
  let g = if flag { visit } else { other }
  g()
}
