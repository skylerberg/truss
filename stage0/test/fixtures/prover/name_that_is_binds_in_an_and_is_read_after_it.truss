fn f(outcome: own Result[List[UInt8], Int32]) -> USize
  requires outcome is Ok(value) && value.length() == 3
  ensures result == 3
{
  match converted(own outcome) {
    Ok(value) => value.length()
    Err(_) => 3
  }
}
