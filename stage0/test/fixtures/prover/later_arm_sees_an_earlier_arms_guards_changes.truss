fn bump(count: mut Int64) -> Bool
  requires count < 100
  ensures count == old(count) + 1
  ensures !result
  cost time O(1)
{
  count += 1
  false
}

fn run_example(value: Int64) -> Int64
  ensures value == 1 ==> result == 1
  ensures value != 1 ==> result == 0
{
  var count: Int64 = 0
  match value {
    1 if bump(mut count) => 5
    _ => count
  }
}
