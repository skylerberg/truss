type Purse(coins: UInt64)
  invariant coins <= 4611686018427387904
  cost potential coins

fn work(size: UInt64)
  cost time O(size)
{
  for _ in 0..size {
  }
}

fn raise(purse: mut Purse, count: UInt64)
  requires purse.coins == 0
  requires count <= 1000000
  ensures purse.coins == 1000 * count
  cost amortized time O(count)
{
  purse.coins = 1000 * count
}

fn empty(purse: mut Purse)
  ensures purse.coins == 0
  cost time O(1)
{
  purse.coins = 0
}

fn churn(purse: mut Purse, count: UInt64)
  requires purse.coins == 0
  requires count <= 1000000
  ensures purse.coins == 0
  cost amortized time O(1)
{
  raise(mut purse, count)
  empty(mut purse)
  work(900 * count)
}
