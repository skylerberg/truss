trait Scaled {
  fn scale(self, limit_count: Int64) -> Int64
    requires limit_count > 0
    ensures result > 0
}

type Box()

impl Scaled for Box {
  fn scale(self, limit_count: Int64) -> Int64
    requires limit_count >= 0
  {
    limit_count
  }
}

fn run_example() -> Int64
  ensures result > 0
{
  Box().scale(0)
}
