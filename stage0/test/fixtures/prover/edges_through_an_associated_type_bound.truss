trait Size {
  fn size(self) -> Int64
    cost allocations == 0

  law at_least_one(value: Self) {
    value.size() >= 1
  }
}

trait Holds {
  type Inner: Size
  fn inner(self) -> Self.Inner
    cost allocations == 0
}

type Leaf(x: Int64)
  derives Equal

impl Size for Leaf {
  fn size(self) -> Int64
    cost allocations == 0
  {
    0
  }
}

type Holder(leaf: Leaf)

impl Holds for Holder {
  type Inner = Leaf
  fn inner(self) -> Leaf
    ensures result == self.leaf
    cost allocations == 0
  {
    self.leaf
  }
}

fn measure[Item: Holds](item: Item) -> Int64
  ensures result >= 1
  ensures result == item.inner().size()
  cost allocations == 0
{
  item.inner().size()
}

proof Size.at_least_one for Leaf {
  let _ = measure(Holder(leaf: value))
}

trait Weight {
  fn weight(self) -> Int64
}

trait Carries {
  type Carried: Weight
  fn carried(self) -> Self.Carried
}

type Twig(x: Int64)

type Branch(twig: Twig)

impl Carries for Branch {
  type Carried = Twig
  fn carried(self) -> Twig {
    self.twig
  }
}

fn weigh[Item: Carries](item: Item) -> Int64 {
  item.carried().weight()
}

impl Weight for Twig {
  fn weight(self) -> Int64 {
    weigh(Branch(twig: self))
  }
}
