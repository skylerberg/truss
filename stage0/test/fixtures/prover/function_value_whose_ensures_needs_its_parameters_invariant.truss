type Positive(value: Int64)
  invariant value > 0

fn read(positive: Positive) -> Int64
  ensures result == positive.value
  ensures result > 0
{
  positive.value
}

fn f(number: Int64) -> Int64
  ensures result == 7
{
  let measure = read
  if number > 0 {
    let positive = Positive(value: number)
    measure(positive) - read(positive) + 7
  } else {
    8
  }
}
