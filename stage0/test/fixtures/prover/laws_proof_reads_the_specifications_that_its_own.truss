trait Masked {
  fn low(self) -> UInt8
    cost time finite

  law below_sixteen(value: Self) {
    value.low() < 16
  }
}

type Nibble(bits: UInt8)

impl Masked for Nibble {
  fn low(self) -> UInt8
    cost time finite
  {
    self.bits & 15
  }
}

proof Masked.below_sixteen for Nibble {
  let bits = value.bits
  assert forall other in 0..16 => other < 16
  assert (bits & 15) < 16 by bit_vector
}
