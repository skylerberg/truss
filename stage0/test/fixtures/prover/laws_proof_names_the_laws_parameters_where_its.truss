trait Sized {
  fn size(self) -> Int64
    cost time finite

  law at_least_one(value: Self)
    requires value.size() > 0
  {
    value.size() >= 1
  }
}

type Box(n: Int64)

impl Sized for Box {
  fn size(self) -> Int64
    cost time finite
  {
    self.n
  }
}

theorem needs(value: Box)
  requires value.size() > 0
  ensures value.size() >= 1
{
}

proof Sized.at_least_one for Box {
  needs(value)
}
