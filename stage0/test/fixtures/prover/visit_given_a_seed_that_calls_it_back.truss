trait Grow {
  fn grow(self) -> Int64
    cost time finite
}

trait Visit {
  fn visit[Item: Grow](self, item: Item) -> Int64
    cost time finite
}

type Walker()

type Seed()

impl Visit for Walker {
  fn visit[Item: Grow](self, item: Item) -> Int64 {
    item.grow()
  }
}

impl Grow for Seed {
  fn grow(self) -> Int64 {
    Walker().visit(Seed())
  }
}
