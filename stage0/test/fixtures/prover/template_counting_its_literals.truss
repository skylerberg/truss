use standard.text

type Count(value: UInt64)

impl FromTemplate for Count {
  type Part = String

  fn is_valid_template(literals: Slice[text.Literal]) -> Bool {
    true
  }

  fn from_template(template: Template[String]) -> Count
    cost allocations == 0
  {
    Count(value: template.literals.length())
  }
}

