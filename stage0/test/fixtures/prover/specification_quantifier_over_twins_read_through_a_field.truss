type Twins(value: Int64)

impl Iterable for Twins {
  type Element = Int64

  fn count(self) -> UInt64
    ensures result == 2
    cost time O(1)
  {
    2
  }

  fn element(self, position: UInt64) lends Int64
    requires position < self.count()
    ensures result == self.value
    cost time O(1)
  {
    self.value
  }
}

fn positive_twins(twins: Twins) -> Bool
  requires forall value in twins => value > 0
  ensures result
{
  twins.value > 0
}
