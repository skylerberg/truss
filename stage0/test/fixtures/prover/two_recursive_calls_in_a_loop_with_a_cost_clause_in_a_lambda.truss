fn once(visit: fn() -> UInt64) -> UInt64
  cost time O(time(visit))
{
  visit()
}

fn f(count: UInt64) -> UInt64
  decreases count
  cost time O(count)
{
  if count == 0 {
    return 0
  }
  once(fn() {
    var total: UInt64 = 0
    for index in 0..2
      cost time O(index * count)
    {
      total = f(count - 1)
    }
    total
  })
}
