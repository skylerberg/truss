use standard.core

fn after_text(text: StringSlice) -> UInt64 {
  text.length() + 1
}

fn after_string(text: String) -> UInt64 {
  text.length() + 1
}

fn joined(first: String, second: StringSlice) -> UInt64 {
  first.length() + second.length()
}

fn room(text: String) -> UInt64 {
  core.maximum_length - text.length()
}
