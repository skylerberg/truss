fn reset(purse: mut Purse)
  ensures purse.coins == 0
  cost time O(1)
{
  purse.coins = 0
}

fn deposits(count: UInt64) -> UInt64
  requires count <= 4503599627370496
  cost amortized time O(1)
{
  var purse = Purse(coins: 0)
  for index in 0..count
    invariant purse.coins == index * 1000
  {
    deposit(mut purse)
  }
  reset(mut purse)
  purse.coins
}
