type Positive(value: Int64)
  invariant value > 0

fn read(positive: Positive) -> Int64
  ensures result == positive.value
  ensures result > 0
{
  positive.value
}

fn apply(measure: fn(Positive) -> Int64, positive: Positive) -> Int64
  ensures result == measure(positive)
{
  measure(positive)
}

fn f(number: Int64) -> Int64
  ensures result == 7
{
  if number > 0 {
    let positive = Positive(value: number)
    apply(read, positive) - read(positive) + 7
  } else {
    8
  }
}
