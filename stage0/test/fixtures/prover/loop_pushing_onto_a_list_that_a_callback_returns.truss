fn f[capability Granted](
  source: List[Int64],
  produce: (fn(Int64) -> List[Int64] uses Granted),
) -> List[List[Int64]]
  uses Granted
  cost time O(source.length() * time(produce))
{
  var rows: List[List[Int64]] = []
  for index in 0..source.length()
    cost time O(index * time(produce))
  {
    var row = produce(source[index])
    mut row.push(1)
    mut rows.push(own row)
  }
  rows
}
