type Holder(meters: view List[Meter], tag: UInt32)

fn hold(meters: view List[Meter]) -> Holder
  ensures identical(result.meters, meters)
  cost amortized time O(1)
{
  Holder(meters: meters, tag: 0)
}

fn spend_first(meters: mut List[Meter])
  requires meters.length() > 0
  cost amortized time O(1)
{
  mut meters[0].spend()
}

fn spends_after_holding(meters: mut List[Meter])
  requires meters.length() > 0
  cost time O(1)
{
  let _ = hold(meters)
  spend_first(mut meters)
}
