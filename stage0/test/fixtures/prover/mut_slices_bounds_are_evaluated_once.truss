fn set(items: mut Slice[Int64])
  requires items.length() >= 1
  ensures items[0] == 7
{
  items[0] = 7
}

fn run_example(items: mut List[Int64])
  requires items.length() >= 4
  ensures items[1] == old(items[1])
{
  var lookup_key: USize = 0
  set(mut items[{
    lookup_key += 1
    lookup_key
  }..3])
}
