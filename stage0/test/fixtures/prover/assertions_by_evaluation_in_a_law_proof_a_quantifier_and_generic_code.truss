fn is_small(value: UInt64) -> Bool {
  value < 10
}

trait Tagged {
  fn tag(self) -> UInt64

  law tag_is_stable(value: Self) {
    value.tag() == value.tag()
  }
}

type Box(value: UInt64)

impl Tagged for Box {
  fn tag(self) -> UInt64 {
    self.value
  }
}

proof Tagged.tag_is_stable for Box {
  assert is_small(7) by evaluation
}

theorem all_small(count: UInt64)
  ensures forall index in 0..count => is_small(8) || index >= 0
{
  assert forall index in 0..count => {
    assert is_small(8) by evaluation
    is_small(8) || index >= 0
  }
}

fn count_of[Item](items: List[Item]) -> UInt64
  ensures result == items.length()
{
  proof {
    assert is_small(9) by evaluation
  }
  items.length()
}
