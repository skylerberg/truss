type Point(first_number: Int64, second_number: Int64)

fn bump(value: mut Int64)
  requires value < 100
  ensures value == old(value) + 1
{
  value += 1
}

fn run_example() -> Int64
  ensures result == 4
{
  var point = Point(first_number: 1, second_number: 2)
  bump(mut point.first_number)
  point.first_number + point.second_number
}
