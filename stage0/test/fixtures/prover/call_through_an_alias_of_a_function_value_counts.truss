capability Hits {
  fn hit()
    cost time finite
}

type Counter(count: Int64)

impl Hits for Counter {
  fn hit(mut self) {
    self.count = self.count.saturating_add(1)
  }
}

fn run_example(flag: Bool, visit: (fn() uses Hits cost time finite), other: (fn() uses Hits cost time finite))
  uses Hits
  cost calls(visit) == 0
{
  let second_example = if flag { visit } else { other }
  second_example()
}
