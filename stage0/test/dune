; The fixtures, as a library, since both stanzas of tests use them.

(library
 (name fixtures)
 (modules fixtures))

(rule
 (target fixtures.ml)
 (deps
  (glob_files_rec fixtures/**.truss))
 (action
  (with-stdout-to
   %{target}
   (run %{exe:embed_fixtures/embed_fixtures.exe} %{deps}))))

; The slowest suites run as several processes at once, each with a share of
; the suite's tests, since one process runs its tests on one core.

(tests
 (names database_tests prover_tests)
 (modules database_tests prover_tests)
 (libraries
  harness
  substring
  diagnostic
  source
  syntax
  query
  phases
  engine
  database
  store
  unix
  path
  workspace
  project
  process
  resolve
  support
  logic
  solver
  prover
  interface
  infer
  type_checker
  fixtures)
 (deps
  (glob_files %{workspace_root}/*.md))
 (action
  (setenv
   TRUSS_TEST_PROCESSES
   4
   (run %{test}))))
