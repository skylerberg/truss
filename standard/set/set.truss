use standard.list
use standard.map

public opaque type Set[Element: Hash + Ordered](map: map.Map[Element, Unit])
  derives Copyable

impl Model for Set[Element: Hash + Ordered] {
  type Value = FiniteSet[Element]

  fn model(self) -> FiniteSet[Element]
    ensures identical(result, self.map.keys.model().elements())
  {
    self.map.keys.model().elements()
  }
}

public fn contains_equal[Element: Equal](set: FiniteSet[Element], value: Element) -> Bool
  ensures result == (exists other: Element => set.contains(other) && other == value)
{
  exists other: Element => set.contains(other) && other == value
}

public fn Set[Element: Hash + Ordered].length(self) -> UInt64
  ensures result == self.model().size()
  ensures result == self.map.keys.length()
  cost time O(1)
  cost allocations == 0
{
  self.map.length()
}

fn Set[Element: Hash + Ordered].position_of(self, element: Element) -> UInt64
  ensures result <= self.map.keys.length()
  ensures result < self.map.keys.length() ==> self.map.keys.model()[result] == element
  ensures forall i in 0..self.map.keys.length() => i == result || !(self.map.keys.model()[i] == element)
  ensures (result < self.map.keys.length()) == contains_equal(self.model(), value: element)
  cost time O(time(Element.hash) + time(Element.equal) + (1 + log(self.length())) * (1 + time(Element.compare)))
  cost allocations <= allocations(Element.hash) + 16 * allocations(Element.equal)
    + (2 * log(self.length()) + 2) * allocations(Element.compare)
{
  let position = self.map.index_of(element)
  proof {
    assert forall i in 0..self.map.keys.length() => self.model().contains(self.map.keys.model()[i])
  }
  position
}

public fn Set[Element: Hash + Ordered].contains(self, element: Element) -> Bool
  ensures result == contains_equal(self.model(), value: element)
  cost time O(time(Element.hash) + time(Element.equal) + (1 + log(self.length())) * (1 + time(Element.compare)))
  cost allocations <= allocations(Element.hash) + 16 * allocations(Element.equal)
    + (2 * log(self.length()) + 2) * allocations(Element.compare)
{
  self.position_of(element) < self.map.keys.length()
}

theorem members_after_push[Element](before: Sequence[Element], after: Sequence[Element], element: Element)
  requires identical(after, before.append(element))
  ensures forall other: Element =>
    after.elements().contains(other) == (before.elements().contains(other) || identical(other, element))
{
}

public fn Set[Element: Hash + Ordered].insert_new(mut self, element: own Element) -> Bool
  ensures contains_equal(self.model(), value: element)
  ensures result == !contains_equal(old(self.model()), value: element)
  ensures forall other: Element => old(self.model()).contains(other) ==> self.model().contains(other)
  ensures forall other: Element =>
    self.model().contains(other) ==> old(self.model()).contains(other) || identical(other, element)
  ensures !result ==> identical(self.model(), old(self.model()))
  ensures self.length() == old(self.length()) + (if result { 1 } else { 0 })
  cost time O(16 + time(Element.hash) + time(Element.equal) + old(self.length())
    + (1 + log(old(self.length()))) * (1 + time(Element.compare)))
  cost amortized time O(16 + time(Element.hash) + time(Element.equal)
    + (1 + log(old(self.length()))) * (1 + time(Element.compare)))
{
  proof {
    assert self.length() == self.map.keys.length()
  }
  let position = self.position_of(element)
  let is_new = position == self.map.keys.length()
  if is_new {
    mut self.map.push_entry(own element, value: Unit)
    proof {
      members_after_push(old(self.map.keys.model()), after: self.map.keys.model(), element: self.map.keys.model()[position])
      assert self.model().contains(self.map.keys.model()[position])
    }
  } else {
    proof {
      assert self.model().contains(self.map.keys.model()[position])
    }
  }
  is_new
}

public fn Set[Element: Hash + Ordered].insert(mut self, element: own Element)
  ensures contains_equal(self.model(), value: element)
  ensures forall other: Element => old(self.model()).contains(other) ==> self.model().contains(other)
  ensures forall other: Element =>
    self.model().contains(other) ==> old(self.model()).contains(other) || identical(other, element)
  ensures forall value: Element =>
    contains_equal(old(self.model()), value: value) ==> contains_equal(self.model(), value: value)
  ensures contains_equal(old(self.model()), value: element) ==> identical(self.model(), old(self.model()))
  ensures self.length()
    == old(self.length()) + (if contains_equal(old(self.model()), value: element) { 0 } else { 1 })
  cost time O(16 + time(Element.hash) + time(Element.equal) + old(self.length())
    + (1 + log(old(self.length()))) * (1 + time(Element.compare)))
  cost amortized time O(16 + time(Element.hash) + time(Element.equal)
    + (1 + log(old(self.length()))) * (1 + time(Element.compare)))
{
  let _ = mut self.insert_new(own element)
}

public fn Set[Element: Hash + Ordered].with_capacity(capacity: UInt64) -> Set[Element]
  ensures result.length() == 0
  ensures forall value: Element => !result.model().contains(value)
  cost time O(1)
{
  Set(map: map.Map.with_capacity(capacity))
}

public fn Set[Element: Hash + Ordered].collect[Source: Cursor[Element = Element]](source: own Source) -> Set[Element]
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  var set: Set[Element] = Set.default()
  mut set.extend(own source)
  set
}

public fn Set[Element: Hash + Ordered].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
  cost allocations == 0
{
  self.length() == 0
}

public fn Set[Element: Hash + Ordered].take(mut self, element: Element) -> Option[Element]
  ensures !self.contains(element)
  ensures (result is Some(_)) == old(self.contains(element))
  ensures forall other: Element => self.model().contains(other) ==> old(self.model()).contains(other)
  ensures self.length() + (if result is Some(_) { 1 } else { 0 }) == old(self.length())
  cost time O(time(Element.hash) + time(Element.equal) + (1 + log(old(self.length()))) * (1 + time(Element.compare)))
{
  let position = self.position_of(element)
  if position == self.map.keys.length() {
    return None
  }
  let removed = mut self.map.remove_at(position)
  proof {
    assert forall i in 0..self.map.keys.length() =>
      old(self.model()).contains(self.map.keys.model()[i]) && !(self.map.keys.model()[i] == element)
  }
  Some(own removed.key)
}

public fn Set[Element: Hash + Ordered].remove(mut self, element: Element)
  ensures !self.contains(element)
  ensures self.length() <= old(self.length())
  ensures forall other: Element => self.model().contains(other) ==> old(self.model()).contains(other)
  cost time O(time(Element.hash) + time(Element.equal) + (1 + log(old(self.length()))) * (1 + time(Element.compare)))
{
  let _ = mut self.take(element)
}

public fn Set[Element: Hash + Ordered].clear(mut self)
  ensures self.length() == 0
  cost time O(1 + old(self.length()))
  cost allocations == 0
{
  mut self.map.clear()
}

public fn Set[Element: Hash + Ordered].reserve(mut self, additional: UInt64)
  ensures identical(self.model(), old(self.model()))
  ensures self.length() == old(self.length())
{
  mut self.map.reserve(additional)
}

public fn Set[Element: Hash + Ordered].retain(
  mut self,
  keep: (fn(element: Element) -> Bool uses generic Granted requires self.model().contains(element)),
)
  uses generic Granted
  ensures self.length() <= old(self.length())
  ensures forall element: Element => self.model().contains(element) ==> keep.ensures(element, true)
  cost time O(16 + old(self.length()) * (16 + time(keep) + time(Element.hash)
    + (1 + log(old(self.length()))) * (1 + time(Element.compare))))
{
  mut self.map.retain_keys(keep)
}

public fn Set[Element: Hash + Ordered].extend[Source: Cursor[Element = Element]](mut self, elements: own Source)
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  var cursor = own elements
  while mut cursor.next() is Some(element)
    decreases cursor.remaining() when Source: FiniteCursor
  {
    mut self.insert(own element)
  }
}

public fn Set[Element: Hash + Ordered].remove_all(mut self, other: Set[Element])
  ensures self.length() <= old(self.length())
  ensures forall element: Element => self.model().contains(element) ==> !other.contains(element)
  cost time O(1 + other.length() * (1 + time(Element.hash) + time(Element.equal)
    + (1 + log(old(self.length()))) * (1 + time(Element.compare))))
{
  for index in 0..other.map.keys.length()
    invariant self.length() <= old(self.length())
    invariant forall member: Element => self.model().contains(member) ==> old(self.model()).contains(member)
    invariant forall i in 0..index => !contains_equal(self.model(), value: other.map.keys.model()[i])
    cost time O(index * (1 + time(Element.hash) + time(Element.equal)
      + (1 + log(old(self.length()))) * (1 + time(Element.compare))))
  {
    mut self.remove(other.map.keys[index])
  }
  proof {
    disjoint_after_removals(self, other: other)
  }
}

theorem disjoint_after_removals[Element: Hash + Ordered](set: Set[Element], other: Set[Element])
  requires forall i in 0..other.map.keys.length() => !contains_equal(set.model(), value: other.map.keys.model()[i])
  ensures forall element: Element => set.model().contains(element) ==> !contains_equal(other.model(), value: element)
{
}

fn Set[Element: Hash + Ordered].missing_from(self, other: Set[Element]) -> UInt64
  ensures result <= self.map.keys.length()
  ensures forall i in 0..result => other.contains(self.map.keys.model()[i])
  ensures result < self.map.keys.length() ==> !other.contains(self.map.keys.model()[result])
  cost time O(1 + self.length() * (1 + time(Element.hash) + time(Element.equal)
    + (1 + log(other.length())) * (1 + time(Element.compare))))
  cost allocations <= self.length() * (allocations(Element.hash) + 16 * allocations(Element.equal)
    + (2 * log(other.length()) + 2) * allocations(Element.compare))
{
  var index: UInt64 = 0
  while index < self.map.keys.length()
    invariant index <= self.map.keys.length()
    invariant forall i in 0..index => other.contains(self.map.keys.model()[i])
    decreases self.map.keys.length() - index
    cost time O(index * (1 + time(Element.hash) + time(Element.equal)
      + (1 + log(other.length())) * (1 + time(Element.compare))))
    cost allocations <= index * (allocations(Element.hash) + 16 * allocations(Element.equal)
      + (2 * log(other.length()) + 2) * allocations(Element.compare))
  {
    if !other.contains(self.map.keys[index]) {
      return index
    }
    index += 1
  }
  index
}

theorem contained_elements_keep_membership[Element: Hash + Ordered](first: Set[Element], second: Set[Element])
  requires forall i in 0..first.map.keys.length() => second.contains(first.map.keys.model()[i])
  ensures forall element: Element => first.contains(element) ==> second.contains(element)
{
}

theorem missing_element_is_a_member[Element: Hash + Ordered](first: Set[Element], index: UInt64)
  requires index < first.map.keys.length()
  ensures first.model().contains(first.map.keys.model()[index])
  ensures first.contains(first.map.keys.model()[index])
{
}

public fn Set[Element: Hash + Ordered].is_subset_of(self, other: Set[Element]) -> Bool
  ensures result == (forall value: Element =>
    self.model().contains(value) ==> contains_equal(other.model(), value: value))
  cost time O(1 + self.length() * (1 + time(Element.hash) + time(Element.equal)
    + (1 + log(other.length())) * (1 + time(Element.compare))))
  cost allocations <= self.length() * (allocations(Element.hash) + 16 * allocations(Element.equal)
    + (2 * log(other.length()) + 2) * allocations(Element.compare))
{
  let missing = self.missing_from(other)
  proof {
    if missing < self.map.keys.length() {
      missing_element_is_a_member(self, index: missing)
    }
  }
  missing == self.map.keys.length()
}

public fn Set[Element: Hash + Ordered].is_superset_of(self, other: Set[Element]) -> Bool
  ensures result == (forall value: Element =>
    other.model().contains(value) ==> contains_equal(self.model(), value: value))
  cost time O(1 + other.length() * (1 + time(Element.hash) + time(Element.equal)
    + (1 + log(self.length())) * (1 + time(Element.compare))))
  cost allocations <= other.length() * (allocations(Element.hash) + 16 * allocations(Element.equal)
    + (2 * log(self.length()) + 2) * allocations(Element.compare))
{
  other.is_subset_of(self)
}

public fn Set[Element: Hash + Ordered].is_disjoint_from(self, other: Set[Element]) -> Bool
  ensures result == (forall value: Element =>
    self.model().contains(value) ==> !contains_equal(other.model(), value: value))
  cost time O(1 + self.length() * (1 + time(Element.hash) + time(Element.equal)
    + (1 + log(other.length())) * (1 + time(Element.compare))))
  cost allocations <= self.length() * (allocations(Element.hash) + 16 * allocations(Element.equal)
    + (2 * log(other.length()) + 2) * allocations(Element.compare))
{
  var index: UInt64 = 0
  while index < self.map.keys.length()
    invariant index <= self.map.keys.length()
    invariant forall i in 0..index => !contains_equal(other.model(), value: self.map.keys.model()[i])
    decreases self.map.keys.length() - index
    cost time O(index * (1 + time(Element.hash) + time(Element.equal)
      + (1 + log(other.length())) * (1 + time(Element.compare))))
    cost allocations <= index * (allocations(Element.hash) + 16 * allocations(Element.equal)
      + (2 * log(other.length()) + 2) * allocations(Element.compare))
  {
    if other.contains(self.map.keys[index]) {
      proof {
        assert self.model().contains(self.map.keys.model()[index])
      }
      return false
    }
    index += 1
  }
  true
}

public fn Set[Element: Hash + Ordered + Copyable].union(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length() + other.length()
{
  var union = self.copy()
  for index in 0..other.map.keys.length()
    invariant union.length() <= self.length() + index
  {
    mut union.insert(other.map.keys[index].copy())
  }
  union
}

public fn Set[Element: Hash + Ordered + Copyable].intersection(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length()
{
  var intersection: Set[Element] = Set.default()
  for index in 0..self.map.keys.length()
    invariant intersection.length() <= index
  {
    if other.contains(self.map.keys[index]) {
      mut intersection.insert(self.map.keys[index].copy())
    }
  }
  intersection
}

public fn Set[Element: Hash + Ordered + Copyable].difference(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length()
{
  var difference: Set[Element] = Set.default()
  for index in 0..self.map.keys.length()
    invariant difference.length() <= index
  {
    if !other.contains(self.map.keys[index]) {
      mut difference.insert(self.map.keys[index].copy())
    }
  }
  difference
}

public fn Set[Element: Hash + Ordered + Copyable].symmetric_difference(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length() + other.length()
{
  var symmetric_difference = self.difference(other)
  for index in 0..other.map.keys.length()
    invariant symmetric_difference.length() <= self.length() + index
  {
    if !self.contains(other.map.keys[index]) {
      mut symmetric_difference.insert(other.map.keys[index].copy())
    }
  }
  symmetric_difference
}

impl Iterable for Set[Element: Hash + Ordered] {
  type Element = Element

  fn count(self) -> UInt64
    ensures result == self.length()
    ensures forall member: Element =>
      self.model().contains(member) ==>
        (exists position in 0..result => identical(self.element(position), member))
    cost time O(1)
  {
    self.map.keys.length()
  }

  fn element(self, position: UInt64) lends Element
    requires position < self.count()
    ensures self.model().contains(result)
    ensures identical(result, self.map.keys.model()[position])
    cost time O(1)
  {
    self.map.keys[position]
  }
}

public fn Set[Element: Hash + Ordered].cursor(own self) -> list.ListCursor[Element]
  ensures result.remaining() == self.length()
  ensures identical(result.model().elements(), self.model())
  cost time O(self.length())
  cost amortized time O(self.length())
{
  own self.map.keys.cursor()
}

impl Equal for Set[Element: Hash + Ordered] {
  fn equal(self, other: Set[Element]) -> Bool
    ensures result == (self.length() == other.length()
      && forall element: Element => self.contains(element) == other.contains(element))
    cost time O(1 + self.length() * (1 + time(Element.hash) + time(Element.equal)
      + (1 + log(self.length())) * (1 + time(Element.compare))))
    cost allocations <= 2 * self.length() * (allocations(Element.hash) + 16 * allocations(Element.equal)
      + (2 * log(self.length()) + 2) * allocations(Element.compare))
  {
    if self.map.keys.length() != other.map.keys.length() {
      return false
    }
    proof {
      assert self.length() == other.length()
    }
    let missing_from_other = self.missing_from(other)
    let missing_from_self = other.missing_from(self)
    proof {
      if missing_from_other < self.map.keys.length() {
        missing_element_is_a_member(self, index: missing_from_other)
      } else {
        contained_elements_keep_membership(self, second: other)
      }
      if missing_from_self < other.map.keys.length() {
        missing_element_is_a_member(other, index: missing_from_self)
      } else {
        contained_elements_keep_membership(other, second: self)
      }
    }
    missing_from_other == self.map.keys.length() && missing_from_self == other.map.keys.length()
  }
}

theorem equality_is_transitive[Element: Hash + Ordered](first: Set[Element], second: Set[Element], third: Set[Element])
  requires first == second
  requires second == third
  ensures first == third
{
  assert first.length() == third.length()
  assert forall element: Element => first.contains(element) == third.contains(element)
}

proof Equal.transitive for Set[Element: Hash + Ordered] {
  equality_is_transitive(first, second: second, third: third)
}

impl Default for Set[Element: Hash + Ordered] {
  fn default() -> Set[Element]
    ensures result.length() == 0
    ensures forall value: Element => !result.model().contains(value)
    cost time O(1)
    cost amortized time O(1)
    cost allocations == 0
  {
    Set(map: map.Map.default())
  }
}

impl FromElements for Set[Element: Hash + Ordered] {
  type Element = Element

  fn from_elements(elements: own List[Element]) -> Set[Element]
    ensures forall i in 0..elements.length() => contains_equal(result.model(), value: elements.model()[i])
    ensures forall member: Element => result.model().contains(member) ==> elements.model().contains(member)
    ensures result.length() <= elements.length()
    ensures (forall i in 0..elements.length() => forall j in 0..elements.length() =>
      i < j ==> !(elements.model()[i] == elements.model()[j])) ==> result.length() == elements.length()
    cost time O(1 + elements.length() * (16 + time(Element.hash) + time(Element.equal) + elements.length()
      + (1 + log(elements.length())) * (1 + time(Element.compare))))
  {
    let count = elements.length()
    var set: Set[Element] = Set.with_capacity(count)
    var position: UInt64 = 0
    for element in own elements
      invariant position == visited.length() && position <= count
      invariant set.length() <= position
      invariant covers(set.model(), values: elements.model(), count: position)
      invariant forall member: Element =>
        set.model().contains(member) ==> exists i in 0..position => identical(elements.model()[i], member)
      invariant (forall i in 0..count => forall j in 0..count => i < j ==> !(elements.model()[i] == elements.model()[j]))
        ==> set.length() == position
      cost time O(visited.length() * (16 + time(Element.hash) + time(Element.equal) + count
        + (1 + log(count)) * (1 + time(Element.compare))))
    {
      proof {
        assert identical(element, elements.model()[position])
        if forall i in 0..count => forall j in 0..count => i < j ==> !(elements.model()[i] == elements.model()[j]) {
          distinct_element_is_new(elements.model(), set: set.model(), position: position)
        }
      }
      var grown = own set
      mut grown.insert(own element)
      proof {
        coverage_grows(set.model(), after: grown.model(), values: elements.model(), count: position)
        members_grow(set.model(), after: grown.model(), values: elements.model(), count: position)
      }
      set = own grown
      position += 1
    }
    set
  }
}

fn covers[Element: Equal](set: FiniteSet[Element], values: Sequence[Element], count: Integer) -> Bool
  ensures result == (forall i in 0..count => i < values.length() ==> contains_equal(set, value: values[i]))
{
  forall i in 0..count => i < values.length() ==> contains_equal(set, value: values[i])
}

theorem coverage_grows[Element: Equal](
  before: FiniteSet[Element],
  after: FiniteSet[Element],
  values: Sequence[Element],
  count: Integer,
)
  requires 0 <= count && count < values.length()
  requires covers(before, values: values, count: count)
  requires forall value: Element => contains_equal(before, value: value) ==> contains_equal(after, value: value)
  requires contains_equal(after, value: values[count])
  ensures covers(after, values: values, count: count + 1)
{
}

theorem members_grow[Element](before: FiniteSet[Element], after: FiniteSet[Element], values: Sequence[Element], count: Integer)
  requires 0 <= count && count < values.length()
  requires forall member: Element => before.contains(member) ==> exists i in 0..count => identical(values[i], member)
  requires forall member: Element => after.contains(member) ==> before.contains(member) || identical(member, values[count])
  ensures forall member: Element => after.contains(member) ==> exists i in 0..count + 1 => identical(values[i], member)
{
}

theorem distinct_element_is_new[Element: Equal](elements: Sequence[Element], set: FiniteSet[Element], position: Integer)
  requires 0 <= position && position < elements.length()
  requires forall i in 0..elements.length() => forall j in 0..elements.length() =>
    i < j ==> !(elements[i] == elements[j])
  requires forall member: Element => set.contains(member) ==> exists i in 0..position => identical(elements[i], member)
  ensures !contains_equal(set, value: elements[position])
{
}
