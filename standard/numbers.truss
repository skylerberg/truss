}

public let USize.minimum: USize = 0

public let USize.maximum: USize = 18446744073709551615

public fn USize.checked_add(self, other: USize) -> Option[USize] {
  if intrinsic::add_overflows(self, right: other) { None } else { Some(intrinsic::add(self, right: other)) }
}

public fn USize.checked_subtract(self, other: USize) -> Option[USize] {
  if intrinsic::subtract_overflows(self, right: other) { None } else { Some(intrinsic::subtract(self, right: other)) }
}

public fn USize.checked_multiply(self, other: USize) -> Option[USize] {
  if intrinsic::multiply_overflows(self, right: other) { None } else { Some(intrinsic::multiply(self, right: other)) }
}

public fn USize.wrapping_add(self, other: USize) -> USize {
  intrinsic::wrapping_add(self, right: other)
}

public fn USize.wrapping_subtract(self, other: USize) -> USize {
  intrinsic::wrapping_subtract(self, right: other)
}

public fn USize.wrapping_multiply(self, other: USize) -> USize {
  intrinsic::wrapping_multiply(self, right: other)
}

public fn USize.saturating_add(self, other: USize) -> USize {
  if intrinsic::add_overflows(self, right: other) {
    USize.maximum
  } else {
    intrinsic::add(self, right: other)
  }
}

