use standard::intrinsic

impl Equal for Int8 {
  fn equal(self, other: Int8) -> Bool {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for Int8 {
  fn compare(self, other: Int8) -> Ordering {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Default for Int8 {
  fn default() -> Int8 {
    0
  }
}

impl Display for Int8 {
  fn display(self, output: mut TextBuilder) {
    mut output.write_signed(intrinsic::convert(self))
  }
}

impl Add[Int8] for Int8 {
  type Output = Int8

  fn add(self, right: Int8) -> Int8 {
    intrinsic::add(self, right)
  }
}

impl Subtract[Int8] for Int8 {
  type Output = Int8

  fn subtract(self, right: Int8) -> Int8 {
    intrinsic::subtract(self, right)
  }
}

impl Multiply[Int8] for Int8 {
  type Output = Int8

  fn multiply(self, right: Int8) -> Int8 {
    intrinsic::multiply(self, right)
  }
}

impl Divide[Int8] for Int8 {
  type Output = Int8

  fn divide(self, right: Int8) -> Int8 {
    intrinsic::divide(self, right)
  }
}

impl Remainder[Int8] for Int8 {
  type Output = Int8

  fn remainder(self, right: Int8) -> Int8 {
    intrinsic::remainder(self, right)
  }
}

impl Negate for Int8 {
  type Output = Int8

  fn negate(self) -> Int8 {
    intrinsic::negate(self)
  }
}

impl Hash for Int8 {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write(intrinsic::convert(self))
  }
}

public let Int8.minimum: Int8 = -128

public let Int8.maximum: Int8 = 127

public fn Int8.checked_add(self, other: Int8) -> Option[Int8] {
  if intrinsic::add_overflows(self, right: other) { None } else { Some(intrinsic::add(self, right: other)) }
}

public fn Int8.checked_subtract(self, other: Int8) -> Option[Int8] {
  if intrinsic::subtract_overflows(self, right: other) { None } else { Some(intrinsic::subtract(self, right: other)) }
}

public fn Int8.checked_multiply(self, other: Int8) -> Option[Int8] {
  if intrinsic::multiply_overflows(self, right: other) { None } else { Some(intrinsic::multiply(self, right: other)) }
}

public fn Int8.wrapping_add(self, other: Int8) -> Int8 {
  intrinsic::wrapping_add(self, right: other)
}

public fn Int8.wrapping_subtract(self, other: Int8) -> Int8 {
  intrinsic::wrapping_subtract(self, right: other)
}

public fn Int8.wrapping_multiply(self, other: Int8) -> Int8 {
  intrinsic::wrapping_multiply(self, right: other)
}

public fn Int8.saturating_add(self, other: Int8) -> Int8 {
  if intrinsic::add_overflows(self, right: other) {
    if other < 0 { Int8.minimum } else { Int8.maximum }
  } else {
    intrinsic::add(self, right: other)
  }
}

impl TryFrom[Int16] for Int8 {
  type Error = ConversionError

  fn try_from(value: own Int16) -> Result[Int8, ConversionError] {
    if intrinsic::fits[Int16, Int8](value) { Ok(intrinsic::convert(value)) } else { Err(ConversionError()) }
  }
}

impl TryFrom[Int32] for Int8 {
  type Error = ConversionError

  fn try_from(value: own Int32) -> Result[Int8, ConversionError] {
    if intrinsic::fits[Int32, Int8](value) { Ok(intrinsic::convert(value)) } else { Err(ConversionError()) }
  }
}

