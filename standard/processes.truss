use standard::map
use standard::streams
use standard::text

public opaque type Command(
  program: String,
  arguments: List[String],
  variables: List[Variable],
  inherits_variables: Bool,
  directory: Option[Path],
  input: Redirect,
  output: Redirect,
  error_output: Redirect,
)

public type Variable(name: String, value: String)

public type Redirect = Inherit | Capture | Discard | Pipe
  derives Equal

public opaque type Argument(text: String)

impl From[String] for Argument {
  fn from(value: own String) -> Argument {
    Argument(text: own value)
  }
}

impl From[StringSlice] for Argument {
  fn from(value: own StringSlice) -> Argument {
    Argument(text: value.to_string())
  }
}

impl From[Path] for Argument {
  fn from(value: own Path) -> Argument
  {
    Argument(text: own value.text)
  }
}

impl From[Int64] for Argument {
  fn from(value: own Int64) -> Argument
  {
    Argument(text: value.format())
  }
}

fn is_separator(byte: UInt8) -> Bool
  cost time O(1)
{
  byte == 32 || byte == 9 || byte == 10 || byte == 13
}

fn finish_word(words: mut List[String], word: mut String) {
  mut words.push(map::exchange(mut word, value: ""))
}

fn split_into_words(words: mut List[String], word: mut String, in_word: Bool, text: StringSlice) -> Bool {
  var inside = in_word
  var start: USize = 0
  var position: USize = 0
  while position < text.length()
    invariant start <= position
    invariant position <= text.length()
    decreases text.length() - position
  {
    if is_separator(text.byte(position)) {
      if position > start {
        mut word.push(text.part(start, to: position))
        inside = true
      }
      if inside {
        finish_word(mut words, word: mut word)
        inside = false
      }
      start = position + 1
    }
    position += 1
  }
  if text.length() > start {
    mut word.push(text.part(start, to: text.length()))
    inside = true
  }
  inside
}

impl FromTemplate for Command {
  type Part = Argument

  fn from_template(template: Template[Argument]) -> Command
    requires is_valid_command(template.literals)
  {
    var words: List[String] = []
    var word = ""
    var in_word = false
    var index: USize = 0
    while index < template.literals.length()
      invariant index <= template.literals.length()
      decreases template.literals.length() - index
    {
      in_word = split_into_words(mut words, word: mut word, in_word: in_word, text: template.literals[index].text())
      if index < template.parts.length() {
        mut word.push(template.parts[index].text.slice())
        in_word = true
      }
      index += 1
    }
    if in_word {
      finish_word(mut words, word: mut word)
    }
    if words.is_empty() {
      return Command.new("")
    }
    var command = Command.new(words[0].slice())
    var next: USize = 1
    while next < words.length()
      invariant 1 <= next
      decreases words.length() - next
    {
      command = own command.argument(words[next].slice())
      next += 1
    }
    command
  }
}

public fn is_valid_command(literals: Slice[text::Literal]) -> Bool
  cost time finite
{
  if literals.length() == 0 {
    return false
  }
  let first = literals[0].text()
  var index: USize = 0
  while index < first.length() && is_separator(first.byte(index))
    invariant index <= first.length()
    decreases first.length() - index
  {
    index += 1
  }
  if index == first.length() {
    return false
  }
  while index < first.length() && !is_separator(first.byte(index))
    invariant index <= first.length()
    decreases first.length() - index
  {
    index += 1
  }
  index < first.length() || literals.length() == 1
}

public fn Command.new(program: StringSlice) -> Command {
  Command(
    program: program.to_string(),
    arguments: [],
    variables: [],
    inherits_variables: true,
    directory: None,
    input: Redirect.Inherit,
    output: Redirect.Inherit,
    error_output: Redirect.Inherit,
  )
}

public fn Command.argument(own self, argument: StringSlice) -> Command {
  var command = own self
  mut command.arguments.push(argument.to_string())
  command
}

public fn Command.arguments(own self, arguments: Slice[String]) -> Command {
  var command = own self
  for argument in arguments {
    mut command.arguments.push(argument.copy())
  }
  command
}

public fn Command.variable(own self, name: StringSlice, value: StringSlice) -> Command {
  var command = own self
  mut command.variables.push(Variable(name: name.to_string(), value: value.to_string()))
  command
}

public fn Command.without_inherited_variables(own self) -> Command {
  var command = own self
  command.inherits_variables = false
  command
}

public fn Command.directory(own self, directory: own Path) -> Command {
  var command = own self
  command.directory = Some(own directory)
  command
}

public fn Command.input(own self, input: Redirect) -> Command {
  var command = own self
  command.input = input
  command
}

public fn Command.output(own self, output: Redirect) -> Command {
  var command = own self
  command.output = output
  command
}

public fn Command.error_output(own self, error_output: Redirect) -> Command {
  var command = own self
  command.error_output = error_output
  command
}

public fn Command.program(self) -> StringSlice
  cost time O(1)
{
  self.program.slice()
}

public fn Command.argument_list(self) -> Slice[String]
  cost time O(1)
{
  self.arguments.slice()
}

public type ExitStatus =
  | Exited(code: UInt8)
  | Signaled(signal: Signal)
  derives Equal

public transparent fn ExitStatus.is_success(self) -> Bool
  cost time O(1)
{
  self is Exited(0)
}

public type Signal =
  | Interrupt
  | Terminate
  | Kill
  | HangUp
  | Quit
  | User1
  | User2
  | Other(number: Int32)
  derives Equal, Hash

public fn Signal.from_number(number: Int32) -> Signal
  cost time O(1)
{
  if number == 1 {
    Signal.HangUp
  } else if number == 2 {
    Signal.Interrupt
  } else if number == 3 {
    Signal.Quit
  } else if number == 9 {
    Signal.Kill
  } else if number == 15 {
    Signal.Terminate
  } else {
    Signal.Other(number: number)
  }
}

public type Output(status: ExitStatus, output: List[UInt8], error_output: List[UInt8])

public fn Output.text(self) -> Result[String, text::Utf8Error]
  cost time O(self.output.length())
{
  let copied = StringSlice(bytes: self.output.slice().elements).to_string()
  String.from_utf8(own copied.to_bytes())
}

public opaque type Child(
  handle: streams::Handle,
  identifier: UInt32,
  input: Option[ChildInput],
  output: Option[ChildOutput],
  error_output: Option[ChildOutput],
)

public fn Child.identifier(self) -> UInt32
  cost time O(1)
{
  self.identifier
}

public fn Child.take_input(mut self) -> Option[ChildInput]
  cost time O(1)
{
  mut self.input.take()
}

public fn Child.take_output(mut self) -> Option[ChildOutput]
  cost time O(1)
{
  mut self.output.take()
}

public fn Child.take_error_output(mut self) -> Option[ChildOutput]
  cost time O(1)
{
  mut self.error_output.take()
}

public fn Child.wait(mut self) -> Result[ExitStatus, SystemError]
  uses Handles
{
  Handles.wait(self.handle)
}

public fn Child.signal(mut self, signal: Signal) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.signal(self.handle, signal: signal)
}

public opaque type ChildInput(handle: streams::Handle)

impl streams::Writer for ChildInput {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.write(self.handle, bytes: bytes)
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
  {
    Ok(Unit)
  }
}

public fn ChildInput.close(own self) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.close(own self.handle)
}

public opaque type ChildOutput(handle: streams::Handle)

impl streams::Reader for ChildOutput {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.read(self.handle, buffer: mut buffer, limit: limit)
  }
}
