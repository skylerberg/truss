public type Result[Value, Error] =
  | Ok(value: Value)
  | Err(error: Error)
  derives Equal, Hash, Ordered

public fn Result[Value, Error].is_ok(self) -> Bool
  cost time O(1)
{
  self is Ok(_)
}

public fn Result[Value, Error].is_err(self) -> Bool
  cost time O(1)
{
  self is Err(_)
}

public fn Result[Value, Error].ok(own self) -> Option[Value] {
  match own self {
    Ok(value) => Some(own value)
    Err(_) => None
  }
}

public fn Result[Value, Error].map[Output](own self, transform: fn(own Value) -> Output) -> Result[Output, Error] {
  match own self {
    Ok(value) => Ok(transform(own value))
    Err(error) => Err(own error)
  }
}

public fn Result[Value, Error].map_error[Other](own self, transform: fn(own Error) -> Other) -> Result[Value, Other] {
  match own self {
    Ok(value) => Ok(own value)
    Err(error) => Err(transform(own error))
  }
}

public fn Result[Value, Error].unwrap(own self) -> Value
  uses Panic
{
  match own self {
    Ok(value) => value
    Err(_) => Panic.crash("unwrap of Err")
  }
}
