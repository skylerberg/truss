public type Result[Value, Error] =
  | Ok(value: Value)
  | Err(error: Error)
  derives Equal, Hash, Ordered

public fn Result[Value, Error].is_ok(self) -> Bool
  ensures result == (self is Ok(_))
  cost time O(1)
{
  self is Ok(_)
}

public fn Result[Value, Error].is_err(self) -> Bool
  ensures result == (self is Err(_))
  cost time O(1)
{
  self is Err(_)
}

public fn Result[Value, Error].ok(own self) -> Option[Value]
  cost time O(1)
{
  match own self {
    Ok(value) => Some(own value)
    Err(_) => None
  }
}

public fn Result[Value, Error].err(own self) -> Option[Error]
  cost time O(1)
{
  match own self {
    Ok(_) => None
    Err(error) => Some(own error)
  }
}

public fn Result[Value, Error].map[Output, capability Granted](
  own self,
  transform: (fn(own Value) -> Output uses Granted cost time finite),
) -> Result[Output, Error]
  uses Granted
  cost time O(time(transform))
{
  match own self {
    Ok(value) => Ok(transform(own value))
    Err(error) => Err(own error)
  }
}

public fn Result[Value, Error].map_error[Other, capability Granted](
  own self,
  transform: (fn(own Error) -> Other uses Granted cost time finite),
) -> Result[Value, Other]
  uses Granted
  cost time O(time(transform))
{
  match own self {
    Ok(value) => Ok(own value)
    Err(error) => Err(transform(own error))
  }
}

public fn Result[Value, Error].and_then[Output, capability Granted](
  own self,
  next: (fn(own Value) -> Result[Output, Error] uses Granted cost time finite),
) -> Result[Output, Error]
  uses Granted
  cost time O(time(next))
{
  match own self {
    Ok(value) => next(own value)
    Err(error) => Err(own error)
  }
}

public fn Result[Value, Error].or_else[Other, capability Granted](
  own self,
  recover: (fn(own Error) -> Result[Value, Other] uses Granted cost time finite),
) -> Result[Value, Other]
  uses Granted
  cost time O(time(recover))
{
  match own self {
    Ok(value) => Ok(own value)
    Err(error) => recover(own error)
  }
}

public fn Result[Value, Error].unwrap_or(own self, default: own Value) -> Value
  cost time O(1)
{
  match own self {
    Ok(value) => value
    Err(_) => default
  }
}

public fn Result[Value, Error].unwrap_or_else[capability Granted](
  own self,
  recover: (fn(own Error) -> Value uses Granted cost time finite),
) -> Value
  uses Granted
  cost time O(time(recover))
{
  match own self {
    Ok(value) => value
    Err(error) => recover(own error)
  }
}

public fn Result[Value, Error].unwrap(own self) -> Value
  uses Panic
{
  match own self {
    Ok(value) => value
    Err(_) => Panic.crash("unwrap of Err")
  }
}

public fn Result[Value, Error].expect(own self, message: StringSlice) -> Value
  uses Panic
{
  match own self {
    Ok(value) => value
    Err(_) => Panic.crash(message)
  }
}
