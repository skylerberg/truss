public opaque type Sequence[Element] = todo

public fn Sequence[Element].empty() -> Sequence[Element]
  ensures result.length() == 0
  cost time finite
{
  todo
}

public fn Sequence[Element].length(self) -> Integer
  ensures result >= 0
  cost time finite
{
  todo
}

public fn Sequence[Element].append(self, value: Element) -> Sequence[Element]
  ensures result.length() == self.length() + 1
  ensures identical(result[self.length()], value)
  ensures forall i in 0..self.length() => identical(result[i], self[i])
  cost time finite
{
  todo
}

public fn Sequence[Element].concatenate(self, other: Sequence[Element]) -> Sequence[Element]
  ensures result.length() == self.length() + other.length()
  ensures forall i in 0..self.length() => identical(result[i], self[i])
  ensures forall i in 0..other.length() => identical(result[self.length() + i], other[i])
  cost time finite
{
  todo
}

public fn Sequence[Element].update(self, index: Integer, value: Element) -> Sequence[Element]
  requires 0 <= index && index < self.length()
  ensures result.length() == self.length()
  ensures identical(result[index], value)
  ensures forall i in 0..self.length() => i == index || identical(result[i], self[i])
  cost time finite
{
  todo
}

public fn Sequence[Element].contains(self, value: Element) -> Bool
  ensures result == (exists i in 0..self.length() => identical(self[i], value))
  cost time finite
{
  todo
}

