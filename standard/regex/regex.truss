use standard::intrinsic
use standard::text

public opaque type Regex(pattern: String, program: List[UInt32], group_names: List[String])
  derives Copyable

public type PatternErrorKind =
  | UnbalancedParenthesis
  | UnbalancedBracket
  | InvalidEscape
  | InvalidRepetition
  | InvalidRange
  | UnsupportedSyntax
  | TooLarge
  derives Equal

public type ParseError(kind: PatternErrorKind, offset: USize)
  derives Equal

impl Display for ParseError {
  fn display(self, output: mut TextBuilder) {
    match self.kind {
      UnbalancedParenthesis => mut output.write("a parenthesis has no partner")
      UnbalancedBracket => mut output.write("a character class is not closed")
      InvalidEscape => mut output.write("the escape is not one a pattern has")
      InvalidRepetition => mut output.write("the repetition has nothing to repeat, or its counts are wrong")
      InvalidRange => mut output.write("the range in a character class is not from a lower to a higher character")
      UnsupportedSyntax => mut output.write("the pattern uses syntax that is not supported")
      TooLarge => mut output.write("the pattern is too large")
    }
    mut output.write(" at offset ")
    self.offset.display(mut output)
  }
}

public type Match(start: USize, end: USize)
  derives Equal
  invariant start <= end

public fn Match.length(self) -> USize
  ensures result == (self.end - self.start)
  cost time O(1)
{
  self.end - self.start
}

public fn Match.slice(self, text: StringSlice) -> StringSlice
  requires self.end <= text.length()
  requires text.is_boundary(self.start)
  requires text.is_boundary(self.end)
  ensures result.length() == self.length()
  cost time O(1)
{
  text.substring(from: self.start, to: self.end)
}

public opaque type Captures(groups: List[Option[Match]], names: List[String])
  derives Copyable

public fn Captures.whole(self) -> Match
  cost time O(1)
{
  if self.groups.length() > 0 && self.groups[0] is Some(whole) {
    return whole
  }
  Match(start: 0, end: 0)
}

public fn Captures.length(self) -> USize
  cost time O(1)
{
  self.groups.length()
}

public fn Captures.get(self, index: USize) -> Option[Match]
  cost time O(1)
{
  if index < self.groups.length() { self.groups[index] } else { None }
}

public fn Captures.named(self, name: StringSlice) -> Option[Match]
  cost time finite
{
  var index: USize = 0
  while index < self.names.length()
    invariant index <= self.names.length()
    decreases self.names.length() - index
  {
    if self.names[index].slice() == name && name.length() > 0 {
      return self.get(index + 1)
    }
    index += 1
  }
  None
}

fn is_meta(byte: UInt8) -> Bool
  cost time O(1)
{
  byte == 92 || byte == 46 || byte == 43 || byte == 42 || byte == 63 || byte == 40 || byte == 41 || byte == 124
    || byte == 91 || byte == 93 || byte == 123 || byte == 125 || byte == 94 || byte == 36 || byte == 45
}

public fn escape(text: StringSlice) -> String
  cost time finite
{
  var output: List[UInt8] = List.with_capacity(text.length())
  var index: USize = 0
  while index < text.length()
    invariant index <= text.length()
    decreases text.length() - index
  {
    let byte = text.byte(index)
    if is_meta(byte) {
      mut output.push(92)
    }
    mut output.push(byte)
    index += 1
  }
  String.from_utf8_lossy(output.slice())
}

type Builder(code: List[UInt32], ranges: List[UInt32], groups: List[USize], names: List[String], placeholders: Bool)

fn failure(kind: PatternErrorKind, offset: USize) -> Option[ParseError]
  cost time O(1)
{
  Some(ParseError(kind: kind, offset: offset))
}

fn word_of(count: USize) -> UInt32
  ensures result == (if count > 4294967295 { 4294967295 } else { intrinsic::convert(count) })
  cost time O(1)
{
  if count > 4294967295 { 4294967295 } else { intrinsic::convert(count) }
}

fn Builder.here(self) -> USize
  cost time O(1)
{
  self.code.length() / 3
}

fn Builder.emit(mut self, operation: UInt32, first: UInt32, second: UInt32) -> USize
  cost time finite
{
  let index = self.code.length() / 3
  mut self.code.push(operation)
  mut self.code.push(first)
  mut self.code.push(second)
  index
}

fn Builder.set(mut self, instruction: USize, field: USize, value: UInt32)
  requires field <= 2
  cost time O(1)
{
  if instruction < self.code.length() / 3 {
    self.code[instruction * 3 + field] = value
  }
}

fn Builder.group_number(self, offset: USize) -> Option[USize]
  cost time finite
{
  var index: USize = 0
  while index < self.groups.length()
    invariant index <= self.groups.length()
    decreases self.groups.length() - index
  {
    if self.groups[index] == offset {
      return Some(index + 1)
    }
    index += 1
  }
  None
}

fn escape_end(text: StringSlice, from: USize, to: USize) -> Result[USize, ParseError]
  requires from < to
  requires to <= text.length()
  ensures !(result is Ok(end) && (end <= from || end > to))
  cost time finite
{
  if to - from < 2 {
    return Err(ParseError(kind: PatternErrorKind.InvalidEscape, offset: from))
  }
  let letter = text.byte(from + 1)
  if letter == 120 {
    if to - from < 4 {
      return Err(ParseError(kind: PatternErrorKind.InvalidEscape, offset: from))
    }
    return Ok(from + 4)
  }
  if letter == 117 {
    if to - from < 4 || text.byte(from + 2) != 123 {
      return Err(ParseError(kind: PatternErrorKind.InvalidEscape, offset: from))
    }
    var index = from + 3
    while index < to && text.byte(index) != 125
      invariant from + 3 <= index
      invariant index <= to
      decreases to - index
    {
      index += 1
    }
    if index == to {
      return Err(ParseError(kind: PatternErrorKind.InvalidEscape, offset: from))
    }
    return Ok(index + 1)
  }
  let decoded = text.decode(from + 1)
  if decoded.length > to - from - 1 {
    return Err(ParseError(kind: PatternErrorKind.InvalidEscape, offset: from))
  }
  Ok(from + 1 + decoded.length)
}

fn class_end(text: StringSlice, from: USize, to: USize) -> Result[USize, ParseError]
  requires from < to
  requires to <= text.length()
  ensures !(result is Ok(end) && (end <= from || end > to))
  cost time finite
{
  var index = from + 1
  while index < to
    invariant from < index
    invariant index <= to
    decreases to - index
  {
    let byte = text.byte(index)
    if byte == 93 {
      return Ok(index + 1)
    }
    if byte == 92 {
      index = escape_end(text, from: index, to: to)?
    } else {
      index += 1
    }
  }
  Err(ParseError(kind: PatternErrorKind.UnbalancedBracket, offset: from))
}

fn group_end(text: StringSlice, from: USize, to: USize) -> Result[USize, ParseError]
  requires from < to
  requires to <= text.length()
  ensures !(result is Ok(end) && (end <= from || end > to))
  cost time finite
{
  var depth: USize = 0
  var index = from
  while index < to
    invariant from <= index
    invariant index <= to
    invariant depth <= index - from
    invariant index > from || depth == 0
    decreases to - index
  {
    let byte = text.byte(index)
    if byte == 92 {
      index = escape_end(text, from: index, to: to)?
    } else if byte == 91 {
      index = class_end(text, from: index, to: to)?
    } else {
      if byte == 40 {
        depth += 1
      } else if byte == 41 {
        if depth == 0 {
          return Err(ParseError(kind: PatternErrorKind.UnbalancedParenthesis, offset: index))
        }
        if depth == 1 {
          return Ok(index + 1)
        }
        depth -= 1
      }
      index += 1
    }
  }
  Err(ParseError(kind: PatternErrorKind.UnbalancedParenthesis, offset: from))
}

fn atom_end(text: StringSlice, from: USize, to: USize) -> Result[USize, ParseError]
  requires from < to
  requires to <= text.length()
  ensures !(result is Ok(end) && (end <= from || end > to))
  cost time finite
{
  let byte = text.byte(from)
  if byte == 92 {
    return escape_end(text, from: from, to: to)
  }
  if byte == 91 {
    return class_end(text, from: from, to: to)
  }
  if byte == 40 {
    return group_end(text, from: from, to: to)
  }
  if byte == 41 {
    return Err(ParseError(kind: PatternErrorKind.UnbalancedParenthesis, offset: from))
  }
  let decoded = text.decode(from)
  if decoded.length > to - from {
    return Err(ParseError(kind: PatternErrorKind.UnsupportedSyntax, offset: from))
  }
  Ok(from + decoded.length)
}

fn branch_end(text: StringSlice, from: USize, to: USize) -> Result[USize, ParseError]
  requires from <= to
  requires to <= text.length()
  ensures !(result is Ok(end) && (end < from || end > to))
  cost time finite
{
  var index = from
  while index < to
    invariant from <= index
    invariant index <= to
    decreases to - index
  {
    if text.byte(index) == 124 {
      return Ok(index)
    }
    index = atom_end(text, from: index, to: to)?
  }
  Ok(to)
}

type Count(value: USize, end: USize)

fn count_at(text: StringSlice, from: USize, to: USize) -> Option[Count]
  requires from <= to
  requires to <= text.length()
  ensures !(result is Some(count) && (count.value > 1000 || count.end <= from || count.end > to))
  cost time finite
{
  var value: USize = 0
  var index = from
  while index < to && 48 <= text.byte(index) && text.byte(index) <= 57
    invariant from <= index
    invariant index <= to
    invariant value <= 1000
    decreases to - index
  {
    value = value * 10 + intrinsic::convert[UInt8, USize](text.byte(index) - 48)
    if value > 1000 {
      return None
    }
    index += 1
  }
  if index == from {
    return None
  }
  Some(Count(value: value, end: index))
}

type Repetition(least: USize, most: USize, bounded: Bool, lazy: Bool, end: USize)

fn repetition_at(text: StringSlice, from: USize, to: USize) -> Result[Repetition, ParseError]
  requires from <= to
  requires to <= text.length()
  ensures !(result is Ok(repetition) && (repetition.end < from || repetition.end > to || repetition.least > 1000 || repetition.most > 1000))
  ensures !(result is Ok(repetition) && repetition.bounded && repetition.most < repetition.least)
  cost time finite
{
  let once = Repetition(least: 1, most: 1, bounded: true, lazy: false, end: from)
  if from == to {
    return Ok(once)
  }
  let wrong = ParseError(kind: PatternErrorKind.InvalidRepetition, offset: from)
  let byte = text.byte(from)
  var least: USize = 1
  var most: USize = 1
  var bounded = true
  var end = from + 1
  if byte == 42 {
    least = 0
    bounded = false
  } else if byte == 43 {
    bounded = false
  } else if byte == 63 {
    least = 0
  } else if byte == 123 {
    let first = match count_at(text, from: from + 1, to: to) {
      Some(first) => first
      None => return Err(wrong)
    }
    least = first.value
    most = first.value
    var index = first.end
    if index < to && text.byte(index) == 44 {
      index += 1
      if index < to && text.byte(index) == 125 {
        bounded = false
      } else {
        let second = match count_at(text, from: index, to: to) {
          Some(second) => second
          None => return Err(wrong)
        }
        most = second.value
        index = second.end
      }
    }
    if index >= to || text.byte(index) != 125 || (bounded && most < least) {
      return Err(wrong)
    }
    end = index + 1
  } else {
    return Ok(once)
  }
  var lazy = false
  if end < to && text.byte(end) == 63 {
    lazy = true
    end += 1
  }
  Ok(Repetition(least: least, most: most, bounded: bounded, lazy: lazy, end: end))
}

fn escaped_character(text: StringSlice, from: USize, to: USize) -> Result[UInt32, ParseError]
  requires from < to
  requires to <= text.length()
  cost time finite
{
  let wrong = ParseError(kind: PatternErrorKind.InvalidEscape, offset: from)
  if to - from < 2 {
    return Err(wrong)
  }
  let letter = text.byte(from + 1)
  if letter == 110 {
    return Ok(10)
  }
  if letter == 114 {
    return Ok(13)
  }
  if letter == 116 {
    return Ok(9)
  }
  if letter == 102 {
    return Ok(12)
  }
  if letter == 118 {
    return Ok(11)
  }
  if letter == 48 {
    return Ok(0)
  }
  if letter == 120 {
    if to - from < 4 {
      return Err(wrong)
    }
    let high: UInt32 = intrinsic::convert(text.byte(from + 2).digit_value())
    let low: UInt32 = intrinsic::convert(text.byte(from + 3).digit_value())
    if high >= 16 || low >= 16 {
      return Err(wrong)
    }
    return Ok(high * 16 + low)
  }
  if letter == 117 {
    if to - from < 4 {
      return Err(wrong)
    }
    var code: UInt32 = 0
    var has_digits = false
    var index = from + 3
    while index < to && text.byte(index) != 125
      invariant index <= to
      invariant code <= 1114111
      decreases to - index
    {
      let digit: UInt32 = intrinsic::convert(text.byte(index).digit_value())
      if digit >= 16 || code > 69631 {
        return Err(wrong)
      }
      code = code * 16 + digit
      if code > 1114111 {
        return Err(wrong)
      }
      has_digits = true
      index += 1
    }
    if !has_digits || (55296 <= code && code <= 57343) {
      return Err(wrong)
    }
    return Ok(code)
  }
  if (49 <= letter && letter <= 57) {
    return Err(ParseError(kind: PatternErrorKind.UnsupportedSyntax, offset: from))
  }
  if (97 <= letter && letter <= 122) || (65 <= letter && letter <= 90) {
    return Err(wrong)
  }
  Ok(text.decode(from + 1).character.code())
}

fn Builder.push_range(mut self, low: UInt32, high: UInt32)
  cost time finite
{
  mut self.ranges.push(low)
  mut self.ranges.push(high)
}

fn Builder.push_shorthand(mut self, letter: UInt8) -> Bool
  cost time finite
{
  if letter == 100 {
    mut self.push_range(48, high: 57)
  } else if letter == 68 {
    mut self.push_range(0, high: 47)
    mut self.push_range(58, high: 1114111)
  } else if letter == 119 {
    mut self.push_range(48, high: 57)
    mut self.push_range(65, high: 90)
    mut self.push_range(95, high: 95)
    mut self.push_range(97, high: 122)
  } else if letter == 87 {
    mut self.push_range(0, high: 47)
    mut self.push_range(58, high: 64)
    mut self.push_range(91, high: 94)
    mut self.push_range(96, high: 96)
    mut self.push_range(123, high: 1114111)
  } else if letter == 115 {
    mut self.push_range(9, high: 13)
    mut self.push_range(32, high: 32)
    mut self.push_range(133, high: 133)
    mut self.push_range(160, high: 160)
    mut self.push_range(5760, high: 5760)
    mut self.push_range(8192, high: 8202)
    mut self.push_range(8232, high: 8233)
    mut self.push_range(8239, high: 8239)
    mut self.push_range(8287, high: 8287)
    mut self.push_range(12288, high: 12288)
  } else if letter == 83 {
    mut self.push_range(0, high: 8)
    mut self.push_range(14, high: 31)
    mut self.push_range(33, high: 132)
    mut self.push_range(134, high: 159)
    mut self.push_range(161, high: 5759)
    mut self.push_range(5761, high: 8191)
    mut self.push_range(8203, high: 8231)
    mut self.push_range(8234, high: 8238)
    mut self.push_range(8240, high: 8286)
    mut self.push_range(8288, high: 12287)
    mut self.push_range(12289, high: 1114111)
  } else {
    return false
  }
  true
}

fn is_shorthand(letter: UInt8) -> Bool
  cost time O(1)
{
  letter == 100 || letter == 68 || letter == 119 || letter == 87 || letter == 115 || letter == 83
}

type ClassItem(code: UInt32, end: USize, shorthand: Bool)

fn Builder.class_item(mut self, text: StringSlice, from: USize, to: USize) -> Result[ClassItem, ParseError]
  requires from < to
  requires to <= text.length()
  ensures !(result is Ok(item) && (item.end <= from || item.end > to))
  cost time finite
{
  let byte = text.byte(from)
  if self.placeholders && byte == 1 {
    return Err(ParseError(kind: PatternErrorKind.UnsupportedSyntax, offset: from))
  }
  if byte == 92 {
    let end = escape_end(text, from: from, to: to)?
    if to - from >= 2 && is_shorthand(text.byte(from + 1)) {
      let _ = mut self.push_shorthand(text.byte(from + 1))
      return Ok(ClassItem(code: 0, end: end, shorthand: true))
    }
    if to - from >= 2 && (text.byte(from + 1) == 98 || text.byte(from + 1) == 66) {
      return Err(ParseError(kind: PatternErrorKind.InvalidEscape, offset: from))
    }
    let code = escaped_character(text, from: from, to: to)?
    return Ok(ClassItem(code: code, end: end, shorthand: false))
  }
  let decoded = text.decode(from)
  if decoded.length > to - from {
    return Err(ParseError(kind: PatternErrorKind.UnsupportedSyntax, offset: from))
  }
  Ok(ClassItem(code: decoded.character.code(), end: from + decoded.length, shorthand: false))
}

fn Builder.compile_class(mut self, text: StringSlice, from: USize, to: USize) -> Option[ParseError]
  requires from < to
  requires to <= text.length()
  cost time finite
{
  if to - from < 2 {
    return failure(PatternErrorKind.UnbalancedBracket, offset: from)
  }
  let close = to - 1
  var index = from + 1
  var negated = false
  if index < close && text.byte(index) == 94 {
    negated = true
    index += 1
  }
  let start = self.ranges.length() / 2
  while index < close
    invariant from < index
    invariant index <= close
    decreases close - index
  {
    let item = match mut self.class_item(text, from: index, to: close) {
      Ok(item) => item
      Err(error) => return Some(error)
    }
    index = item.end
    if !item.shorthand {
      var high = item.code
      if close - index >= 2 && text.byte(index) == 45 {
        let last = match mut self.class_item(text, from: index + 1, to: close) {
          Ok(last) => last
          Err(error) => return Some(error)
        }
        if last.shorthand || last.code < item.code {
          return failure(PatternErrorKind.InvalidRange, offset: index)
        }
        high = last.code
        index = last.end
      }
      mut self.push_range(item.code, high: high)
    }
  }
  let count = (self.ranges.length() / 2).saturating_subtract(start)
  let _ = mut self.emit(if negated { 4 } else { 3 }, first: word_of(start), second: word_of(count))
  None
}

fn Builder.compile_escape(mut self, text: StringSlice, from: USize, to: USize) -> Option[ParseError]
  requires from < to
  requires to <= text.length()
  cost time finite
{
  if to - from < 2 {
    return failure(PatternErrorKind.InvalidEscape, offset: from)
  }
  let letter = text.byte(from + 1)
  if letter == 98 {
    let _ = mut self.emit(8, first: 2, second: 0)
    return None
  }
  if letter == 66 {
    let _ = mut self.emit(8, first: 3, second: 0)
    return None
  }
  if is_shorthand(letter) {
    let start = self.ranges.length() / 2
    let positive: UInt8 = if letter == 68 { 100 } else if letter == 87 { 119 } else if letter == 83 { 115 } else { letter }
    let _ = mut self.push_shorthand(positive)
    let count = (self.ranges.length() / 2).saturating_subtract(start)
    let _ = mut self.emit(if positive == letter { 3 } else { 4 }, first: word_of(start), second: word_of(count))
    return None
  }
  match escaped_character(text, from: from, to: to) {
    Ok(code) => {
      let _ = mut self.emit(1, first: code, second: 0)
      None
    }
    Err(error) => Some(error)
  }
}

fn Builder.compile_atom(mut self, text: StringSlice, from: USize, to: USize) -> Option[ParseError]
  requires from < to
  requires to <= text.length()
  decreases to - from, 1
  cost time finite
{
  let byte = text.byte(from)
  if byte == 40 {
    var inner = from + 1
    var capturing = true
    if to - from >= 3 && text.byte(from + 1) == 63 {
      let kind = text.byte(from + 2)
      if kind == 58 {
        inner = from + 3
        capturing = false
      } else if kind == 60 {
        inner = from + 3
        while inner < to && text.byte(inner) != 62
          invariant from + 3 <= inner
          invariant inner <= to
          decreases to - inner
        {
          inner += 1
        }
        if inner == to {
          return failure(PatternErrorKind.UnsupportedSyntax, offset: from)
        }
        inner += 1
      } else {
        return failure(PatternErrorKind.UnsupportedSyntax, offset: from)
      }
    }
    if inner > to - 1 {
      return failure(PatternErrorKind.UnbalancedParenthesis, offset: from)
    }
    var slot: UInt32 = 0
    if capturing {
      match self.group_number(from) {
        Some(number) => {
          if number > 100000 {
            return failure(PatternErrorKind.TooLarge, offset: from)
          }
          slot = word_of(number * 2)
          let _ = mut self.emit(7, first: slot, second: 0)
        }
        None => return failure(PatternErrorKind.UnsupportedSyntax, offset: from)
      }
    }
    if mut self.compile_alternation(text, from: inner, to: to - 1) is Some(error) {
      return Some(error)
    }
    if capturing {
      let _ = mut self.emit(7, first: slot + 1, second: 0)
    }
    return None
  }
  if byte == 91 {
    return mut self.compile_class(text, from: from, to: to)
  }
  if byte == 92 {
    return mut self.compile_escape(text, from: from, to: to)
  }
  if byte == 46 {
    let _ = mut self.emit(2, first: 0, second: 0)
    return None
  }
  if byte == 94 {
    let _ = mut self.emit(8, first: 0, second: 0)
    return None
  }
  if byte == 36 {
    let _ = mut self.emit(8, first: 1, second: 0)
    return None
  }
  if byte == 42 || byte == 43 || byte == 63 || byte == 123 {
    return failure(PatternErrorKind.InvalidRepetition, offset: from)
  }
  if self.placeholders && byte == 1 {
    return None
  }
  let _ = mut self.emit(1, first: text.decode(from).character.code(), second: 0)
  None
}

fn Builder.compile_concatenation(mut self, text: StringSlice, from: USize, to: USize) -> Option[ParseError]
  requires from <= to
  requires to <= text.length()
  decreases to - from, 2
  cost time finite
{
  var index = from
  while index < to
    invariant from <= index
    invariant index <= to
    decreases to - index
  {
    let end = match atom_end(text, from: index, to: to) {
      Ok(end) => end
      Err(error) => return Some(error)
    }
    let times = match repetition_at(text, from: end, to: to) {
      Ok(times) => times
      Err(error) => return Some(error)
    }
    var copies: USize = 0
    while copies < times.least
      invariant copies <= times.least
      decreases times.least - copies
    {
      if mut self.compile_atom(text, from: index, to: end) is Some(error) {
        return Some(error)
      }
      copies += 1
    }
    if !times.bounded {
      let split = mut self.emit(5, first: 0, second: 0)
      if mut self.compile_atom(text, from: index, to: end) is Some(error) {
        return Some(error)
      }
      let _ = mut self.emit(6, first: word_of(split), second: 0)
      let body = word_of(split.saturating_add(1))
      let after = word_of(self.here())
      mut self.set(split, field: 1, value: if times.lazy { after } else { body })
      mut self.set(split, field: 2, value: if times.lazy { body } else { after })
    } else {
      var skips: List[USize] = []
      while copies < times.most
        invariant copies <= times.most
        decreases times.most - copies
      {
        let split = mut self.emit(5, first: 0, second: 0)
        mut skips.push(split)
        if mut self.compile_atom(text, from: index, to: end) is Some(error) {
          return Some(error)
        }
        copies += 1
      }
      let after = word_of(self.here())
      var patched: USize = 0
      while patched < skips.length()
        invariant patched <= skips.length()
        decreases skips.length() - patched
      {
        let split = skips[patched]
        let body = word_of(split.saturating_add(1))
        mut self.set(split, field: 1, value: if times.lazy { after } else { body })
        mut self.set(split, field: 2, value: if times.lazy { body } else { after })
        patched += 1
      }
    }
    if self.code.length() > 600000 || self.ranges.length() > 600000 {
      return failure(PatternErrorKind.TooLarge, offset: index)
    }
    index = times.end
  }
  None
}

fn Builder.compile_alternation(mut self, text: StringSlice, from: USize, to: USize) -> Option[ParseError]
  requires from <= to
  requires to <= text.length()
  decreases to - from, 3
  cost time finite
{
  var jumps: List[USize] = []
  var index = from
  while index <= to
    invariant from <= index
    invariant index <= to
    decreases to - index
  {
    let end = match branch_end(text, from: index, to: to) {
      Ok(end) => end
      Err(error) => return Some(error)
    }
    if end == to {
      if mut self.compile_concatenation(text, from: index, to: to) is Some(error) {
        return Some(error)
      }
      let after = word_of(self.here())
      var patched: USize = 0
      while patched < jumps.length()
        invariant patched <= jumps.length()
        decreases jumps.length() - patched
      {
        mut self.set(jumps[patched], field: 1, value: after)
        patched += 1
      }
      return None
    }
    let split = mut self.emit(5, first: 0, second: 0)
    if mut self.compile_concatenation(text, from: index, to: end) is Some(error) {
      return Some(error)
    }
    mut jumps.push(mut self.emit(6, first: 0, second: 0))
    mut self.set(split, field: 1, value: word_of(split.saturating_add(1)))
    mut self.set(split, field: 2, value: word_of(self.here()))
    index = end + 1
  }
  None
}

fn Builder.collect_groups(mut self, text: StringSlice) -> Option[ParseError]
  cost time finite
{
  let to = text.length()
  var index: USize = 0
  while index < to
    invariant index <= to
    decreases to - index
  {
    let byte = text.byte(index)
    if byte == 92 {
      index = match escape_end(text, from: index, to: to) {
        Ok(end) => end
        Err(error) => return Some(error)
      }
    } else if byte == 91 {
      index = match class_end(text, from: index, to: to) {
        Ok(end) => end
        Err(error) => return Some(error)
      }
    } else {
      if byte == 40 {
        if to - index >= 3 && text.byte(index + 1) == 63 {
          let kind = text.byte(index + 2)
          if kind == 60 {
            var end = index + 3
            while end < to && text.byte(end) != 62
              invariant index + 3 <= end
              invariant end <= to
              decreases to - end
            {
              let letter = text.byte(end)
              let named = (97 <= letter && letter <= 122) || (65 <= letter && letter <= 90)
                || (48 <= letter && letter <= 57) || letter == 95
              if !named {
                return failure(PatternErrorKind.UnsupportedSyntax, offset: index)
              }
              end += 1
            }
            if end == to {
              return failure(PatternErrorKind.UnbalancedParenthesis, offset: index)
            }
            if end == index + 3 {
              return failure(PatternErrorKind.UnsupportedSyntax, offset: index)
            }
            mut self.groups.push(index)
            mut self.names.push(text.part(index + 3, to: end).to_string())
          } else if kind != 58 {
            return failure(PatternErrorKind.UnsupportedSyntax, offset: index)
          }
        } else {
          mut self.groups.push(index)
          mut self.names.push("")
        }
      }
      index += 1
    }
  }
  None
}

fn compile(text: StringSlice, placeholders: Bool) -> Result[Regex, ParseError]
  cost time finite
{
  var builder = Builder(code: [], ranges: [], groups: [], names: [], placeholders: placeholders)
  if mut builder.collect_groups(text) is Some(error) {
    return Err(error)
  }
  let _ = mut builder.emit(7, first: 0, second: 0)
  if mut builder.compile_alternation(text, from: 0, to: text.length()) is Some(error) {
    return Err(error)
  }
  let _ = mut builder.emit(7, first: 1, second: 0)
  let _ = mut builder.emit(9, first: 0, second: 0)
  var program: List[UInt32] = List.with_capacity(builder.code.length().saturating_add(builder.ranges.length()).saturating_add(1))
  mut program.push(word_of(builder.here()))
  var index: USize = 0
  while index < builder.code.length()
    invariant index <= builder.code.length()
    decreases builder.code.length() - index
  {
    mut program.push(builder.code[index])
    index += 1
  }
  index = 0
  while index < builder.ranges.length()
    invariant index <= builder.ranges.length()
    decreases builder.ranges.length() - index
  {
    mut program.push(builder.ranges[index])
    index += 1
  }
  Ok(Regex(pattern: text.to_string(), program: own program, group_names: own builder.names))
}

public fn is_valid_template(literals: Slice[text::Literal]) -> Bool
  cost time finite
{
  var pattern = ""
  var index: USize = 0
  while index < literals.length()
    invariant index <= literals.length()
    decreases literals.length() - index
  {
    if index > 0 {
      mut pattern.push("\u{1}")
    }
    mut pattern.push(literals[index].text())
    index += 1
  }
  literals.length() > 0 && compile(pattern.slice(), placeholders: true) is Ok(_)
}

public opaque type Part(source: String)

impl From[StringSlice] for Part {
  fn from(value: own StringSlice) -> Part {
    Part(source: escape(value))
  }
}

impl From[String] for Part {
  fn from(value: own String) -> Part {
    Part(source: escape(value.slice()))
  }
}

impl From[Character] for Part {
  fn from(value: own Character) -> Part {
    var text = ""
    mut text.push_character(value)
    Part(source: escape(text.slice()))
  }
}

impl From[Regex] for Part {
  fn from(value: own Regex) -> Part {
    Part(source: value.pattern.copy())
  }
}

impl FromTemplate for Regex {
  type Part = Part

  fn from_template(template: Template[Part]) -> Regex
    requires is_valid_template(template.literals)
  {
    var pattern = ""
    var index: USize = 0
    while index < template.literals.length()
      invariant index <= template.literals.length()
      decreases template.literals.length() - index
    {
      mut pattern.push(template.literals[index].text())
      if index < template.parts.length() {
        mut pattern.push("(?:")
        mut pattern.push(template.parts[index].source.slice())
        mut pattern.push(")")
      }
      index += 1
    }
    match compile(pattern.slice(), placeholders: false) {
      Ok(regex) => regex
      Err(_) => Regex(pattern: own pattern, program: [0], group_names: [])
    }
  }
}

public fn Regex.pattern(self) -> StringSlice
  cost time O(1)
{
  self.pattern.slice()
}

public fn Regex.size(self) -> USize
  cost time O(1)
{
  self.program.length()
}

public fn Regex.group_count(self) -> USize
  cost time O(1)
{
  self.group_names.length()
}

fn Regex.word(self, at: USize) -> UInt32
  cost time O(1)
{
  if at < self.program.length() { self.program[at] } else { 0 }
}

fn Regex.instructions(self) -> USize
  ensures result <= 4294967295
  cost time O(1)
{
  intrinsic::convert(self.word(0))
}

fn Regex.field(self, instruction: USize, field: USize) -> UInt32
  requires field <= 2
  cost time O(1)
{
  if instruction >= self.instructions() {
    return 0
  }
  self.word(1 + instruction * 3 + field)
}

fn Regex.in_ranges(self, first: UInt32, count: UInt32, code: UInt32) -> Bool
  cost time finite
{
  let base = 1 + self.instructions() * 3 + intrinsic::convert[UInt32, USize](first) * 2
  let pairs: USize = intrinsic::convert(count)
  var index: USize = 0
  while index < pairs
    invariant index <= pairs
    decreases pairs - index
  {
    if self.word(base + index * 2) <= code && code <= self.word(base + index * 2 + 1) {
      return true
    }
    index += 1
  }
  false
}

fn is_word_byte(byte: UInt8) -> Bool
  cost time O(1)
{
  (48 <= byte && byte <= 57) || (65 <= byte && byte <= 90) || (97 <= byte && byte <= 122) || byte == 95
}

fn assertion_holds(kind: UInt32, text: StringSlice, position: USize) -> Bool
  requires position <= text.length()
  cost time O(1)
{
  if kind == 0 {
    return position == 0
  }
  if kind == 1 {
    return position == text.length()
  }
  let before = position > 0 && is_word_byte(text.byte(position - 1))
  let after = position < text.length() && is_word_byte(text.byte(position))
  if kind == 2 { before != after } else { before == after }
}

type Threads(instructions: List[USize], slots: List[USize])

fn popped(stack: mut List[USize]) -> USize
  cost time finite
{
  match mut stack.pop() {
    Some(value) => value
    None => 0
  }
}

fn Regex.follow(
  self,
  text: StringSlice,
  position: USize,
  instruction: USize,
  slots: mut List[USize],
  threads: mut Threads,
  marks: mut List[USize],
  stamp: USize,
  stack: mut List[USize],
)
  requires position <= text.length()
  cost time finite
{
  mut stack.clear()
  mut stack.push(0)
  mut stack.push(instruction)
  mut stack.push(0)
  var fuel = marks.length().saturating_multiply(4).saturating_add(8)
  while fuel > 0 && stack.length() >= 3
    decreases fuel
  {
    fuel -= 1
    let second = popped(mut stack)
    let first = popped(mut stack)
    let kind = popped(mut stack)
    if kind == 1 {
      if first < slots.length() {
        slots[first] = second
      }
    } else if first < marks.length() && marks[first] != stamp {
      marks[first] = stamp
      let operation = self.field(first, field: 0)
      let target: USize = intrinsic::convert(self.field(first, field: 1))
      if operation == 6 {
        mut stack.push(0)
        mut stack.push(target)
        mut stack.push(0)
      } else if operation == 5 {
        mut stack.push(0)
        mut stack.push(intrinsic::convert(self.field(first, field: 2)))
        mut stack.push(0)
        mut stack.push(0)
        mut stack.push(target)
        mut stack.push(0)
      } else if operation == 7 {
        if target < slots.length() {
          mut stack.push(1)
          mut stack.push(target)
          mut stack.push(slots[target])
          slots[target] = position
        }
        mut stack.push(0)
        mut stack.push(first + 1)
        mut stack.push(0)
      } else if operation == 8 {
        if assertion_holds(self.field(first, field: 1), text: text, position: position) {
          mut stack.push(0)
          mut stack.push(first + 1)
          mut stack.push(0)
        }
      } else if operation != 0 {
        mut threads.instructions.push(first)
        var index: USize = 0
        while index < slots.length()
          invariant index <= slots.length()
          decreases slots.length() - index
        {
          mut threads.slots.push(slots[index])
          index += 1
        }
      }
    }
  }
}

fn Regex.consumes(self, instruction: USize, code: UInt32) -> Bool
  cost time finite
{
  let operation = self.field(instruction, field: 0)
  if operation == 1 {
    return self.field(instruction, field: 1) == code
  }
  if operation == 2 {
    return code != 10
  }
  if operation == 3 || operation == 4 {
    let inside = self.in_ranges(self.field(instruction, field: 1), count: self.field(instruction, field: 2), code: code)
    return inside == (operation == 3)
  }
  false
}

fn Regex.run(self, text: StringSlice, from: USize, whole: Bool) -> Option[List[USize]]
  requires from <= text.length()
  cost time finite
{
  let count = self.instructions()
  let width = self.group_names.length().saturating_add(1).saturating_multiply(2)
  var marks: List[USize] = List.with_capacity(count)
  var filled: USize = 0
  while filled < count
    invariant filled <= count
    decreases count - filled
  {
    mut marks.push(0)
    filled += 1
  }
  var slots: List[USize] = List.with_capacity(width)
  filled = 0
  while filled < width
    invariant filled <= width
    decreases width - filled
  {
    mut slots.push(USize.maximum)
    filled += 1
  }
  var current = Threads(instructions: [], slots: [])
  var next = Threads(instructions: [], slots: [])
  var stack: List[USize] = []
  var matched: Option[List[USize]] = None
  var stamp: USize = 0
  var position = from
  var steps = (text.length() - from).saturating_add(1)
  while steps > 0
    invariant position <= text.length()
    decreases steps
  {
    steps -= 1
    stamp = stamp.saturating_add(1)
    if matched is None && (position == from || !whole) {
      var index: USize = 0
      while index < slots.length()
        invariant index <= slots.length()
        decreases slots.length() - index
      {
        slots[index] = USize.maximum
        index += 1
      }
      self.follow(
        text,
        position: position,
        instruction: 0,
        slots: mut slots,
        threads: mut current,
        marks: mut marks,
        stamp: stamp,
        stack: mut stack,
      )
    }
    if current.instructions.is_empty() && (whole || matched is Some(_)) {
      return matched
    }
    var code: UInt32 = 0
    var length: USize = 0
    if position < text.length() {
      let decoded = text.decode(position)
      code = decoded.character.code()
      length = decoded.length
    }
    var thread: USize = 0
    var cut = false
    while thread < current.instructions.length() && !cut
      invariant thread <= current.instructions.length()
      invariant position <= text.length()
      invariant length <= text.length() - position
      decreases current.instructions.length() - thread
    {
      let instruction = current.instructions[thread]
      let base = thread.saturating_multiply(width)
      var index: USize = 0
      while index < slots.length()
        invariant index <= slots.length()
        decreases slots.length() - index
      {
        let at = base.saturating_add(index)
        slots[index] = if at < current.slots.length() { current.slots[at] } else { USize.maximum }
        index += 1
      }
      if self.field(instruction, field: 0) == 9 {
        if !whole || position == text.length() {
          matched = Some(slots.copy())
          cut = true
        }
      } else if length > 0 && self.consumes(instruction, code: code) {
        self.follow(
          text,
          position: position + length,
          instruction: instruction.saturating_add(1),
          slots: mut slots,
          threads: mut next,
          marks: mut marks,
          stamp: stamp.saturating_add(1),
          stack: mut stack,
        )
      }
      thread += 1
    }
    mut current.instructions.clear()
    mut current.slots.clear()
    let carried = own current
    current = own next
    next = own carried
    if length == 0 {
      return matched
    }
    position += length
  }
  matched
}

fn match_from(slots: Slice[USize], text: StringSlice, offset: USize) -> Option[Match]
  ensures !(result is Some(matched) && (matched.start < offset || matched.end > text.length()))
  cost time O(1)
{
  if slots.length() < 2 {
    return None
  }
  let start = slots[0]
  let end = slots[1]
  if offset <= start && start <= end && end <= text.length() {
    Some(Match(start: start, end: end))
  } else {
    None
  }
}

public fn Regex.find_from(self, text: StringSlice, offset: USize) -> Option[Match]
  requires offset <= text.length()
  ensures match result {
    Some(matched) => offset <= matched.start && matched.end <= text.length()
    None => true
  }
  ensures identical(result, match self.run(text, from: offset, whole: false) {
      Some(slots) => match_from(slots.slice(), text: text, offset: offset)
      None => None
    })
  cost time finite
{
  match self.run(text, from: offset, whole: false) {
    Some(slots) => match_from(slots.slice(), text: text, offset: offset)
    None => None
  }
}

public fn Regex.is_match(self, text: StringSlice) -> Bool
  ensures result == (self.find_from(text, offset: 0) is Some(_))
  cost time finite
{
  self.find_from(text, offset: 0) is Some(_)
}

public fn Regex.is_full_match(self, text: StringSlice) -> Bool
  cost time finite
{
  self.run(text, from: 0, whole: true) is Some(_)
}

public fn Regex.find(self, text: StringSlice) -> Option[Match]
  ensures match result {
    Some(matched) => matched.end <= text.length()
    None => !self.is_match(text)
  }
  cost time finite
{
  self.find_from(text, offset: 0)
}

fn step_after(text: StringSlice, matched: Match) -> USize
  requires matched.end <= text.length()
  ensures result >= matched.end
  ensures result <= text.length() + 1
  ensures result > matched.start
  cost time O(1)
{
  if matched.end > matched.start {
    return matched.end
  }
  if matched.end < text.length() {
    matched.end + text.decode(matched.end).length
  } else {
    matched.end + 1
  }
}

public fn Regex.find_all(self, text: StringSlice) -> List[Match]
  cost time finite
{
  var matches: List[Match] = []
  var position: USize = 0
  while position <= text.length()
    decreases text.length() + 1 - position
  {
    match self.find_from(text, offset: position) {
      Some(next) => {
        position = step_after(text, matched: next)
        mut matches.push(next)
      }
      None => return matches
    }
  }
  matches
}

fn Regex.captures_of(self, slots: Slice[USize], text: StringSlice, offset: USize) -> Option[Captures]
  ensures (result is Some(_)) == (match_from(slots, text: text, offset: offset) is Some(_))
  cost time finite
{
  let whole = match match_from(slots, text: text, offset: offset) {
    Some(whole) => whole
    None => return None
  }
  var groups: List[Option[Match]] = [Some(whole)]
  var group: USize = 1
  while group <= self.group_names.length() && group < 100000000
    invariant 1 <= group
    decreases self.group_names.length() + 1 - group
  {
    var entry: Option[Match] = None
    if group * 2 + 1 < slots.length() {
      let start = slots[group * 2]
      let end = slots[group * 2 + 1]
      if start <= end && end <= text.length() {
        entry = Some(Match(start: start, end: end))
      }
    }
    mut groups.push(entry)
    group += 1
  }
  Some(Captures(groups: own groups, names: self.group_names.copy()))
}

fn Regex.captures_from(self, text: StringSlice, offset: USize) -> Option[Captures]
  requires offset <= text.length()
  cost time finite
{
  match self.run(text, from: offset, whole: false) {
    Some(slots) => self.captures_of(slots.slice(), text: text, offset: offset)
    None => None
  }
}

public fn Regex.captures(self, text: StringSlice) -> Option[Captures]
  ensures (result is Some(_)) == self.is_match(text)
  cost time finite
{
  match self.run(text, from: 0, whole: false) {
    Some(slots) => self.captures_of(slots.slice(), text: text, offset: 0)
    None => None
  }
}

public fn Regex.replace_first(self, text: StringSlice, replacement: StringSlice) -> String
  cost time finite
{
  match self.find_from(text, offset: 0) {
    Some(matched) => {
      var output = text.part(0, to: matched.start).to_string()
      mut output.push(replacement)
      mut output.push(text.part(matched.end, to: text.length()))
      output
    }
    None => text.to_string()
  }
}

public fn Regex.replace_all(self, text: StringSlice, replacement: StringSlice) -> String
  cost time finite
{
  var output = ""
  var copied_up_to: USize = 0
  var position: USize = 0
  while position <= text.length()
    invariant copied_up_to <= position
    invariant copied_up_to <= text.length()
    decreases text.length() + 1 - position
  {
    match self.find_from(text, offset: position) {
      Some(matched) => {
        mut output.push(text.part(copied_up_to, to: matched.start))
        mut output.push(replacement)
        copied_up_to = matched.end
        position = step_after(text, matched: matched)
      }
      None => {
        mut output.push(text.part(copied_up_to, to: text.length()))
        return output
      }
    }
  }
  mut output.push(text.part(copied_up_to, to: text.length()))
  output
}

public fn Regex.replace_all_with(
  self,
  text: StringSlice,
  replace: (fn(Captures) -> String cost time finite),
) -> String
  cost time finite
{
  var output = ""
  var copied_up_to: USize = 0
  var position: USize = 0
  while position <= text.length()
    invariant copied_up_to <= position
    invariant copied_up_to <= text.length()
    decreases text.length() + 1 - position
  {
    match self.captures_from(text, offset: position) {
      Some(captures) => {
        let whole = captures.whole()
        if whole.start < position || whole.end > text.length() {
          mut output.push(text.part(copied_up_to, to: text.length()))
          return output
        }
        mut output.push(text.part(copied_up_to, to: whole.start))
        mut output.push(replace(captures).slice())
        copied_up_to = whole.end
        position = step_after(text, matched: whole)
      }
      None => {
        mut output.push(text.part(copied_up_to, to: text.length()))
        return output
      }
    }
  }
  mut output.push(text.part(copied_up_to, to: text.length()))
  output
}

public fn Regex.split(self, text: StringSlice) -> List[StringSlice]
  cost time finite
{
  var pieces: List[StringSlice] = []
  var copied_up_to: USize = 0
  var position: USize = 0
  while position <= text.length()
    invariant copied_up_to <= position
    invariant copied_up_to <= text.length()
    decreases text.length() + 1 - position
  {
    match self.find_from(text, offset: position) {
      Some(matched) => {
        if matched.end > matched.start {
          mut pieces.push(text.part(copied_up_to, to: matched.start))
          copied_up_to = matched.end
        }
        position = step_after(text, matched: matched)
      }
      None => {
        mut pieces.push(text.part(copied_up_to, to: text.length()))
        return pieces
      }
    }
  }
  mut pieces.push(text.part(copied_up_to, to: text.length()))
  pieces
}

impl Equal for Regex {
  fn equal(self, other: Regex) -> Bool {
    self.pattern == other.pattern
  }
}

impl Display for Regex {
  fn display(self, output: mut TextBuilder) {
    mut output.write(self.pattern.slice())
  }
}

impl text::Parse for Regex {
  type Error = ParseError

  fn parse(text: StringSlice) -> Result[Regex, ParseError] {
    compile(text, placeholders: false)
  }
}
