use standard.core

public fn Range[Value: Ordered].is_empty(self) -> Bool
  ensures result == (if self.inclusive { self.start > self.stop } else { self.start >= self.stop })
  cost allocations == 0
{
  if self.inclusive { self.start > self.stop } else { self.start >= self.stop }
}

public fn Range[Value: Ordered].contains(self, value: Value) -> Bool
  ensures result == (self.start <= value && (if self.inclusive { value <= self.stop } else { value < self.stop }))
{
  self.start <= value && (if self.inclusive { value <= self.stop } else { value < self.stop })
}

impl Iterable for Range[Value: core.Countable] {
  type Element = Value

  fn count(self) -> UInt64
    ensures result == (match self.start.steps_to(self.stop) {
      Some(steps) => if self.inclusive { steps.saturating_add(1) } else { steps }
      None => 0
    })
    cost time O(1)
    cost allocations == 0
  {
    match self.start.steps_to(self.stop) {
      Some(steps) => if self.inclusive { steps.saturating_add(1) } else { steps }
      None => 0
    }
  }

  fn element(self, position: UInt64) lends Value
    requires position < self.count()
    ensures self.contains(result)
    cost time O(1)
    cost allocations == 0
  {
    match self.start.steps_to(self.stop) {
      Some(steps) => {
        if position < steps {
          match self.start.advanced(position) {
            Some(value) => value
            None => unreachable
          }
        } else {
          self.stop
        }
      }
      None => unreachable
    }
  }
}

impl Equal for Range[Value: core.Countable] {
  fn equal(self, other: Range[Value]) -> Bool
    ensures result == (if self.is_empty() || other.is_empty() {
      self.is_empty() && other.is_empty()
    } else {
      self.start == other.start && self.length() == other.length()
    })
  {
    if self.is_empty() || other.is_empty() {
      self.is_empty() && other.is_empty()
    } else {
      self.start == other.start && self.length() == other.length()
    }
  }
}

public opaque type Reversed[Value: core.Countable](range: Range[Value])

public fn Range[Value: core.Countable].reversed(self) -> Reversed[Value]
  cost time O(1)
{
  Reversed(range: Range(start: self.start, stop: self.stop, inclusive: self.inclusive))
}

impl Iterable for Reversed[Value: core.Countable] {
  type Element = Value

  fn count(self) -> UInt64
    ensures result == self.range.count()
    cost time O(1)
    cost allocations == 0
  {
    self.range.count()
  }

  fn element(self, position: UInt64) lends Value
    requires position < self.count()
    ensures self.range.contains(result)
    cost time O(1)
    cost allocations == 0
  {
    if self.range.inclusive && position == 0 {
      self.range.stop
    } else {
      let steps_back = if self.range.inclusive { position } else { position + 1 }
      match self.range.stop.retreated(steps_back) {
        Some(value) => value
        None => unreachable
      }
    }
  }
}

public opaque type Stepped[Value: core.Countable](range: Range[Value], step: UInt64)
  invariant step > 0

public fn Range[Value: core.Countable].step_by(self, step: UInt64) -> Stepped[Value]
  uses Panic unless step > 0
  cost time O(1)
{
  if step == 0 {
    Panic.crash("the step is zero")
  }
  Stepped(range: Range(start: self.start, stop: self.stop, inclusive: self.inclusive), step: step)
}

impl Iterable for Stepped[Value: core.Countable] {
  type Element = Value

  fn count(self) -> UInt64
    ensures self.range.count() == 0 ==> result == 0
    ensures self.range.count() > 0 ==> result == (self.range.count() - 1) / self.step + 1
    cost time O(1)
    cost allocations == 0
  {
    let whole = self.range.count()
    if whole == 0 { 0 } else { (whole - 1) / self.step + 1 }
  }

  fn element(self, position: UInt64) lends Value
    requires position < self.count()
    ensures self.range.contains(result)
    cost time O(1)
    cost allocations == 0
  {
    self.range.element(position * self.step)
  }
}

public fn Range[Value: core.Countable].length(self) -> Option[UInt64]
  cost time O(1)
  cost allocations == 0
{
  match self.start.steps_to(self.stop) {
    Some(count) => if self.inclusive { count.checked_add(1) } else { Some(count) }
    None => Some(0)
  }
}
