use standard::core

public fn Range[Value: Ordered].is_empty(self) -> Bool
  ensures result == (if self.inclusive { self.start > self.stop } else { self.start >= self.stop })
  cost time finite
{
  if self.inclusive { self.start > self.stop } else { self.start >= self.stop }
}

public fn Range[Value: Ordered].contains(self, value: Value) -> Bool
  ensures result == (self.start <= value && (if self.inclusive { value <= self.stop } else { value < self.stop }))
  cost time finite
{
  self.start <= value && (if self.inclusive { value <= self.stop } else { value < self.stop })
}

impl Iterable for Range[Value: core::Countable] {
  type Element = Value

  fn count(self) -> USize
    cost time finite
  {
    match self.start.steps_to(self.stop) {
      Some(steps) => if self.inclusive { steps.saturating_add(1) } else { steps }
      None => 0
    }
  }

  fn element(self, position: USize) lends Value
    requires position < self.count()
    ensures self.contains(result)
    cost time finite
  {
    match self.start.steps_to(self.stop) {
      Some(steps) => {
        if position < steps {
          match self.start.advanced(position) {
            Some(value) => value
            None => unreachable
          }
        } else {
          self.stop
        }
      }
      None => unreachable
    }
  }
}

public opaque type Reversed[Value: core::Countable](range: Range[Value])

public fn Range[Value: core::Countable].reversed(self) -> Reversed[Value]
  cost time O(1)
{
  Reversed(range: Range(start: self.start, stop: self.stop, inclusive: self.inclusive))
}

impl Iterable for Reversed[Value: core::Countable] {
  type Element = Value

  fn count(self) -> USize
    cost time finite
  {
    self.range.count()
  }

  fn element(self, position: USize) lends Value
    requires position < self.count()
    ensures self.range.contains(result)
    cost time finite
  {
    self.range.element(self.range.count() - 1 - position)
  }
}

public opaque type Stepped[Value: core::Countable](range: Range[Value], step: USize)
  invariant step > 0

public fn Range[Value: core::Countable].step_by(self, step: USize) -> Stepped[Value]
  requires step > 0
  cost time O(1)
{
  Stepped(range: Range(start: self.start, stop: self.stop, inclusive: self.inclusive), step: step)
}

impl Iterable for Stepped[Value: core::Countable] {
  type Element = Value

  fn count(self) -> USize
    cost time finite
  {
    let whole = self.range.count()
    if whole == 0 { 0 } else { (whole - 1) / self.step + 1 }
  }

  fn element(self, position: USize) lends Value
    requires position < self.count()
    ensures self.range.contains(result)
    cost time finite
  {
    self.range.element(position * self.step)
  }
}

public fn Range[Value: core::Countable].length(self) -> Option[USize]
  cost time O(1)
{
  match self.start.steps_to(self.stop) {
    Some(count) => if self.inclusive { count.checked_add(1) } else { Some(count) }
    None => Some(0)
  }
}
