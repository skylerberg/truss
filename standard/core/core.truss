use standard.cursors
use standard.intrinsic

public type Ordering = Less | Equal | Greater
  derives Equal

public fn Ordering.reversed(self) -> Ordering
  ensures identical(result, match self {
      Less => Ordering.Greater
      Equal => Ordering.Equal
      Greater => Ordering.Less
    })
  cost time O(1)
{
  match self {
    Less => Ordering.Greater
    Equal => Ordering.Equal
    Greater => Ordering.Less
  }
}

public fn Ordering.then(self, next: Ordering) -> Ordering
  ensures identical(result, if self == Ordering.Equal { next } else { self })
  cost time O(1)
{
  if self == Ordering.Equal { next } else { self }
}

public trait Equal {
  fn equal(self, other: Self) -> Bool

  fn not_equal(self, other: Self) -> Bool
    ensures result == !self.equal(other)
  {
    !self.equal(other)
  }

  law reflexive(value: Self) {
    value == value
  }

  law symmetric(first: Self, second: Self)
    requires first == second
  {
    second == first
  }

  law transitive(first: Self, second: Self, third: Self)
    requires first == second
    requires second == third
  {
    first == third
  }
}

public trait Ordered: Equal {
  fn compare(self, other: Self) -> Ordering

  fn max(own self, other: own Self) -> Self
    ensures identical(result, self) || identical(result, other)
    ensures self <= result && other <= result
  {
    if self.compare(other) == Ordering.Less { other } else { self }
  }

  fn min(own self, other: own Self) -> Self
    ensures identical(result, self) || identical(result, other)
    ensures result <= self && result <= other
  {
    if self.compare(other) == Ordering.Greater { other } else { self }
  }

  fn clamp(own self, low: own Self, high: own Self) -> Self
    uses Panic unless low <= high
    ensures low <= result && result <= high
    ensures low <= self && self <= high ==> identical(result, self)
    ensures self < low ==> identical(result, low)
    ensures self > high ==> identical(result, high)
  {
    if low > high {
      Panic.crash("the low bound is greater than the high bound")
    }
    if self.compare(low) == Ordering.Less {
      low
    } else if self.compare(high) == Ordering.Greater {
      high
    } else {
      self
    }
  }

  law agrees_with_equal(first: Self, second: Self) {
    (first.compare(second) == Ordering.Equal) == (first == second)
  }

  law antisymmetric(first: Self, second: Self) {
    (first.compare(second) == Ordering.Less) == (second.compare(first) == Ordering.Greater)
  }

  law transitive(first: Self, second: Self, third: Self)
    requires first <= second
    requires second <= third
  {
    first <= third
  }
}

internal theorem less_is_transitive[Element: Ordered](first: Element, second: Element, third: Element)
  requires first < second
  requires second < third
  ensures first < third
{
}

public trait Hash: Equal {
  fn hash(self, hasher: Hasher) -> Hasher

  law agrees_with_equal(first: Self, second: Self, hasher: Hasher)
    requires first == second
  {
    identical(first.hash(hasher), second.hash(hasher))
  }
}

public opaque type Hasher(state: UInt64)
  derives Plain

public fn Hasher.new() -> Hasher
  cost time O(1)
  cost allocations == 0
{
  Hasher(state: 0x243f_6a88_85a3_08d3)
}

fn folded_multiply(first: UInt64, second: UInt64) -> UInt64
  cost time O(1)
  cost allocations == 0
{
  intrinsic.bit_xor(intrinsic.wrapping_multiply(first, right: second), right: intrinsic.multiply_high(first, right: second))
}

public fn Hasher.write(self, value: UInt64) -> Hasher
  cost time O(1)
  cost allocations == 0
{
  Hasher(state: folded_multiply(intrinsic.bit_xor(self.state, right: value), second: 0x9e37_79b9_7f4a_7c15))
}

public fn Hasher.after_bytes(self, bytes: Sequence[UInt8], count: Integer) -> Hasher
  requires 0 <= count
  requires count <= bytes.length()
  ensures identical(result, if count == 0 {
      self
    } else {
      self.after_bytes(bytes, count: count - 1).write(intrinsic.convert(bytes[count - 1]))
    })
  decreases count
{
  if count == 0 {
    self
  } else {
    self.after_bytes(bytes, count: count - 1).write(intrinsic.convert(bytes[count - 1]))
  }
}

public fn Hasher.write_bytes(self, bytes: Slice[UInt8]) -> Hasher
  ensures identical(result, self.after_bytes(bytes.model(), count: bytes.length()).write(bytes.length()))
  cost time O(bytes.length())
  cost allocations == 0
{
  var hasher = self
  for index in 0..bytes.length()
    invariant identical(hasher, self.after_bytes(bytes.model(), count: index))
    cost time O(index)
  {
    hasher = hasher.write(intrinsic.convert(bytes[index]))
  }
  hasher.write(bytes.length())
}

public fn Hasher.finish(self) -> UInt64
  cost time O(1)
  cost allocations == 0
{
  folded_multiply(self.state, second: 0xc2b2_ae3d_27d4_eb4f)
}

public trait Default {
  fn default() -> Self
}

public trait Display {
  fn display(self, output: mut String)
}

public trait From[Source] {
  fn from(value: own Source) -> Self
}

public trait TryFrom[Source] {
  type Error
  fn try_from(value: own Source) -> Result[Self, Self.Error]
}

public trait Copyable {
  fn copy(self) -> Self
    ensures identical(result, self)
}

public trait Plain: Copyable {}

public trait Storable {}

public trait Add[Right] {
  type Output

  fn add_is_defined(self, right: Right) -> Bool

  fn add(self, right: Right) -> Self.Output
    uses Panic unless self.add_is_defined(right)
}

public trait Subtract[Right] {
  type Output

  fn subtract_is_defined(self, right: Right) -> Bool

  fn subtract(self, right: Right) -> Self.Output
    uses Panic unless self.subtract_is_defined(right)
}

public trait Multiply[Right] {
  type Output

  fn multiply_is_defined(self, right: Right) -> Bool

  fn multiply(self, right: Right) -> Self.Output
    uses Panic unless self.multiply_is_defined(right)
}

public trait Divide[Right] {
  type Output

  fn divide_is_defined(self, right: Right) -> Bool

  fn divide(self, right: Right) -> Self.Output
    uses Panic unless self.divide_is_defined(right)
}

public trait Remainder[Right] {
  type Output

  fn remainder_is_defined(self, right: Right) -> Bool

  fn remainder(self, right: Right) -> Self.Output
    uses Panic unless self.remainder_is_defined(right)
}

public trait Negate {
  type Output

  fn negate_is_defined(self) -> Bool

  fn negate(self) -> Self.Output
    uses Panic unless self.negate_is_defined()
}

public trait Model {
  type Value

  fn model(self) -> Self.Value
}

public trait Index {
  type Key
  type Output

  fn contains_key(self, key: Self.Key) -> Bool

  fn at(self, key: Self.Key) lends Self.Output
    requires self.contains_key(key)
}

public trait IndexMut: Index {
  fn at(mut self, key: Self.Key) lends mut Self.Output
    requires self.contains_key(key)
}

public trait IndexAssign: Index {
  fn accepts_key(self, key: Self.Key) -> Bool

  fn assign(mut self, key: own Self.Key, value: own Self.Output)
    requires self.accepts_key(key)
}

public trait Iterable {
  type Element

  fn count(self) -> UInt64

  fn element(self, position: UInt64) lends Self.Element
    requires position < self.count()

  fn fold[Total](
    self,
    initial: own Total,
    combine: (fn(total: own Total, element: Self.Element) -> Total uses generic Granted
      requires exists position in 0..self.count() => identical(element, self.element(position))),
  ) -> Total
    uses generic Granted
    cost time O(time(Self.count) + self.count() * (time(Self.element) + time(combine)))
    cost allocations <= allocations(Self.count) + self.count() * (allocations(Self.element) + allocations(combine))
  {
    var total = own initial
    for item in self {
      total = combine(own total, item)
    }
    total
  }

  fn map[Output](
    self,
    transform: (fn(element: Self.Element) -> Output uses generic Granted
      requires exists position in 0..self.count() => identical(element, self.element(position))),
  ) -> List[Output]
    uses generic Granted
    ensures result.length() == self.count()
    ensures forall i in 0..result.length() => transform.ensures(self.element(i), result.model()[i])
    cost time O(time(Self.count) + self.count() * (time(Self.element) + time(transform)))
  {
    var outputs: List[Output] = List.with_capacity(self.count())
    for item in self
      invariant outputs.length() == visited.length()
      invariant forall i in 0..visited.length() => transform.ensures(visited[i], outputs.model()[i])
    {
      mut outputs.push(transform(item))
    }
    outputs
  }

  fn filter_map[Output](
    self,
    transform: (fn(element: Self.Element) -> Option[Output] uses generic Granted
      requires exists position in 0..self.count() => identical(element, self.element(position))),
  ) -> List[Output]
    uses generic Granted
    ensures forall i in 0..result.length() =>
      exists position in 0..self.count() => transform.ensures(self.element(position), Some(result.model()[i]))
    cost time O(time(Self.count) + self.count() * (time(Self.element) + time(transform)))
  {
    var outputs: List[Output] = []
    for item in self
      invariant forall i in 0..outputs.length() =>
        exists position in 0..visited.length() => transform.ensures(visited[position], Some(outputs.model()[i]))
    {
      match transform(item) {
        Some(output) => mut outputs.push(own output)
        None => {}
      }
    }
    outputs
  }

  fn flat_map[Output](
    self,
    transform: (fn(element: Self.Element) -> List[Output] uses generic Granted
      requires exists position in 0..self.count() => identical(element, self.element(position))),
  ) -> List[Output]
    uses generic Granted
    cost time O(time(Self.count) + self.count() * (time(Self.element) + time(transform)) + result.length())
  {
    var results: List[Output] = []
    for item in self
      cost time O(visited.length() * (time(Self.element) + time(transform)) + results.length())
    {
      mut results.append(transform(item))
    }
    results
  }

  fn count_where(
    self,
    predicate: (fn(element: Self.Element) -> Bool uses generic Granted
      requires exists position in 0..self.count() => identical(element, self.element(position))),
  ) -> UInt64
    uses generic Granted
    cost time O(time(Self.count) + self.count() * (time(Self.element) + time(predicate)))
  {
    var count: UInt64 = 0
    for item in self {
      if predicate(item) {
        count = count.saturating_add(1)
      }
    }
    count
  }

  fn find(
    self,
    predicate: (fn(element: Self.Element) -> Bool uses generic Granted
      requires exists position in 0..self.count() => identical(element, self.element(position))),
  ) lends Option[Self.Element]
    uses generic Granted
    ensures match result {
      Some(found) => predicate.ensures(found, true)
      None => forall i in 0..self.count() => predicate.ensures(self.element(i), false)
    }
    cost time O(time(Self.count) + self.count() * (time(Self.element) + time(predicate)))
    cost allocations <= allocations(Self.count) + self.count() * (allocations(Self.element) + allocations(predicate))
  {
    for item in self
      invariant forall i in 0..visited.length() => predicate.ensures(visited[i], false)
    {
      if predicate(item) {
        return Some(item)
      }
    }
    None
  }
}

public trait Cursor {
  type Element
  capability Uses

  fn next(mut self) -> Option[Self.Element]
    uses Self.Uses

  fn to_list(own self) -> List[Self.Element]
    uses Self.Uses, RunForever unless Self: FiniteCursor
  {
    var cursor = own self
    var items: List[Self.Element] = []
    while mut cursor.next() is Some(item)
      decreases cursor.remaining() when Self: FiniteCursor
    {
      mut items.push(own item)
    }
    items
  }

  fn count(own self) -> UInt64
    uses Self.Uses, RunForever unless Self: FiniteCursor
  {
    var cursor = own self
    var count: UInt64 = 0
    while mut cursor.next() is Some(_)
      decreases cursor.remaining() when Self: FiniteCursor
    {
      count = count.saturating_add(1)
    }
    count
  }

  fn last(own self) -> Option[Self.Element]
    uses Self.Uses, RunForever unless Self: FiniteCursor
  {
    var cursor = own self
    var last: Option[Self.Element] = None
    while mut cursor.next() is Some(item)
      decreases cursor.remaining() when Self: FiniteCursor
    {
      last = Some(own item)
    }
    last
  }

  fn fold[Total](
    own self,
    initial: own Total,
    combine: (fn(own Total, own Self.Element) -> Total uses generic Granted),
  ) -> Total
    uses Self.Uses, generic Granted, RunForever unless Self: FiniteCursor
  {
    var cursor = own self
    var total = own initial
    while mut cursor.next() is Some(item)
      decreases cursor.remaining() when Self: FiniteCursor
    {
      total = combine(own total, own item)
    }
    total
  }

  fn find(mut self, predicate: fn(Self.Element) -> Bool) -> Option[Self.Element]
    uses Self.Uses, RunForever unless Self: FiniteCursor
  {
    while mut self.next() is Some(item)
      decreases self.remaining() when Self: FiniteCursor
    {
      if predicate(item) {
        return Some(own item)
      }
    }
    None
  }

  fn skip(own self, count: UInt64) -> cursors.Skip[Self]
    cost time O(1)
  {
    cursors.Skip(source: own self, left: count)
  }

  fn take(own self, count: UInt64) -> cursors.Take[Self]
    cost time O(1)
  {
    cursors.Take(source: own self, left: count)
  }

  fn step_by(own self, step: UInt64) -> cursors.StepBy[Self]
    uses Panic unless step > 0
    cost time O(1)
  {
    if step == 0 {
      Panic.crash("the step is zero")
    }
    cursors.StepBy(source: own self, step: step, started: false)
  }

  fn chain[Other: Cursor[Element = Self.Element]](own self, other: own Other) -> cursors.Chain[Self, Other]
    cost time O(1)
  {
    cursors.Chain(first: own self, second: own other, first_ended: false)
  }

  fn zip[Other: Cursor](own self, other: own Other) -> cursors.Zip[Self, Other]
    cost time O(1)
  {
    cursors.Zip(first: own self, second: own other)
  }

  fn enumerate(own self) -> cursors.Enumerate[Self]
    cost time O(1)
  {
    cursors.Enumerate(source: own self, index: 0)
  }

  fn peekable(own self) -> cursors.Peekable[Self]
    cost time O(1)
  {
    cursors.Peekable(source: own self, peeked: None)
  }
}

public trait FiniteCursor: Cursor {
  fn remaining(self) -> UInt64

  fn next(mut self) -> Option[Self.Element]
    uses Self.Uses
    ensures (result is Some(_)) ==> self.remaining() < old(self.remaining())
}

public trait Countable: Ordered + Plain {
  fn successor(self) -> Option[Self]
    cost time O(1)

  fn predecessor(self) -> Option[Self]
    cost time O(1)

  fn advanced(self, by: UInt64) -> Option[Self]
    cost time O(1)

  fn retreated(self, by: UInt64) -> Option[Self]
    cost time O(1)

  fn steps_to(self, other: Self) -> Option[UInt64]
    cost time O(1)

  law steps_to_follows_order(start: Self, stop: Self) {
    (start.steps_to(stop) is None) == (stop < start)
  }

  law advanced_stays_before(start: Self, stop: Self, by: UInt64) {
    match start.steps_to(stop) {
      Some(count) => by >= count || (match start.advanced(by) {
        Some(value) => start <= value && value < stop
        None => false
      })
      None => true
    }
  }

  law retreated_stays_within(start: Self, stop: Self, by: UInt64) {
    match start.steps_to(stop) {
      Some(count) => by == 0 || by > count || (match stop.retreated(by) {
        Some(value) => start <= value && value < stop
        None => false
      })
      None => true
    }
  }
}

public type Range[Value](start: Value, stop: Value, inclusive: Bool)

public tuple type Indexed[Element](index: UInt64, element: Element)
  derives Equal

public tuple type Pair[First, Second](first: First, second: Second)
  derives Equal, Hash, Ordered

public type ExitCode(code: UInt8)
  derives Equal

public let ExitCode.success: ExitCode = ExitCode(0)

public let ExitCode.failure: ExitCode = ExitCode(1)

impl Equal for Bool {
  fn equal(self, other: Bool) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    intrinsic.equal(self, right: other)
  }
}

impl Hash for Bool {
  fn hash(self, hasher: Hasher) -> Hasher
    cost time O(1)
    cost allocations == 0
  {
    hasher.write(if self { 1 } else { 0 })
  }
}

impl Equal for Character {
  fn equal(self, other: Character) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    intrinsic.equal(self, right: other)
  }
}

impl Ordered for Character {
  fn compare(self, other: Character) -> Ordering
    ensures (result == Ordering.Less) == (self.code() < other.code())
    ensures (result == Ordering.Equal) == (self.code() == other.code())
    cost time O(1)
    cost allocations == 0
  {
    if intrinsic.less(self, right: other) {
      Ordering.Less
    } else if intrinsic.equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Hash for Character {
  fn hash(self, hasher: Hasher) -> Hasher
    cost time O(1)
    cost allocations == 0
  {
    hasher.write(intrinsic.convert(self))
  }
}

impl Equal for Unit {
  fn equal(self, other: Unit) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    true
  }
}

public type ConversionError()
  derives Equal

impl Display for ConversionError {
  fn display(self, output: mut String)
  {
    mut output.push("the value does not fit the type")
  }
}

public type ParseIntegerError =
  | Empty
  | InvalidDigit(offset: UInt64)
  | OutOfRange
  derives Equal

impl Display for ParseIntegerError {
  fn display(self, output: mut String)
  {
    match self {
      Empty => mut output.push("the text has no digits")
      InvalidDigit(offset) => {
        mut output.push("the byte at offset ")
        offset.display(mut output)
        mut output.push(" is not a digit")
      }
      OutOfRange => mut output.push("the number does not fit the type")
    }
  }
}

public type ParseFloatError =
  | Empty
  | InvalidCharacter(offset: UInt64)
  derives Equal

impl Display for ParseFloatError {
  fn display(self, output: mut String)
  {
    match self {
      Empty => mut output.push("the text is empty")
      InvalidCharacter(offset) => {
        mut output.push("the byte at offset ")
        offset.display(mut output)
        mut output.push(" is not part of a number")
      }
    }
  }
}

impl Display for Bool {
  fn display(self, output: mut String) {
    if self { mut output.push("true") } else { mut output.push("false") }
  }
}

impl Display for Character {
  fn display(self, output: mut String) {
    mut output.push_character(self)
  }
}
