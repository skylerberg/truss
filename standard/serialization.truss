use standard::text

public trait Serialize {
  fn serialize[Sink: Serializer](self, sink: mut Sink)
}

public trait Deserialize {
  fn deserialize[Source: Deserializer](source: mut Source) -> Result[Self, Error]
}

public trait Serializer {
  fn null(mut self)
  fn bool(mut self, value: Bool)
  fn integer(mut self, value: Int64)
  fn unsigned(mut self, value: UInt64)
  fn float(mut self, value: Float64)
  fn text(mut self, value: StringSlice)
  fn begin_list(mut self, length: USize)
  fn end_list(mut self)
  fn begin_record(mut self, length: USize)
  fn field(mut self, name: StringSlice)
  fn end_record(mut self)
  fn begin_map(mut self, length: USize)
  fn key(mut self, key: StringSlice)
  fn end_map(mut self)
  fn begin_variant(mut self, name: StringSlice, length: USize)
  fn end_variant(mut self)
}

public type Kind = Absent | Null | Bool | Integer | Float | Text | List | Record
  derives Equal

public trait Deserializer {
  fn kind(self) -> Kind
  fn skip(mut self)
  fn bool(mut self) -> Result[Bool, Error]
  fn integer(mut self) -> Result[Int64, Error]
  fn unsigned(mut self) -> Result[UInt64, Error]
  fn float(mut self) -> Result[Float64, Error]
  fn text(mut self) -> Result[String, Error]
  fn begin_list(mut self) -> Result[Unit, Error]
  fn next_element(mut self) -> Bool
  fn end_list(mut self)
  fn begin_record(mut self) -> Result[Unit, Error]
  fn field(mut self, name: StringSlice) -> Bool
  fn end_record(mut self)
  fn begin_map(mut self) -> Result[Unit, Error]
  fn next_key(mut self) -> Option[String]
  fn end_map(mut self)
  fn variant(mut self) -> Result[String, Error]
  fn end_variant(mut self)
  fn error(self, message: StringSlice) -> Error
}

public type Error(path: String, message: String)
  derives Equal

impl Display for Error {
  fn display(self, output: mut TextBuilder)
  {
    if self.path.length() > 0 {
      mut output.write("at ")
      mut output.write(self.path.slice())
      mut output.write(": ")
    }
    mut output.write(self.message.slice())
  }
}

public fn required[Field: Deserialize, Source: Deserializer](source: mut Source, name: StringSlice) -> Result[Field, Error] {
  let _ = mut source.field(name)
  Field.deserialize(mut source)
}

public fn optional[Field: Deserialize, Source: Deserializer](
  source: mut Source,
  name: StringSlice,
) -> Result[Option[Field], Error] {
  if !mut source.field(name) {
    return Ok(None)
  }
  match Field.deserialize(mut source) {
    Ok(field) => Ok(Some(own field))
    Err(error) => Err(own error)
  }
}

public fn unknown_variant[Source: Deserializer](source: Source, name: String) -> Error {
  var message = "there is no variant `"
  mut message.push(name.slice())
  mut message.push("`")
  source.error(message.slice())
}

fn out_of_range[Source: Deserializer](source: Source, type_name: StringSlice) -> Error {
  var message = "expected a number that fits `"
  mut message.push(type_name)
  mut message.push("`")
  source.error(message.slice())
}

impl Serialize for Bool {
  fn serialize[Sink: Serializer](self, sink: mut Sink) {
    mut sink.bool(self)
  }
}

impl Deserialize for Bool {
  fn deserialize[Source: Deserializer](source: mut Source) -> Result[Bool, Error] {
    mut source.bool()
  }
}

impl Serialize for Int8 {
  fn serialize[Sink: Serializer](self, sink: mut Sink) {
    mut sink.integer(Int64.from(self))
  }
}

impl Deserialize for Int8 {
  fn deserialize[Source: Deserializer](source: mut Source) -> Result[Int8, Error] {
    match Int8.try_from(mut source.integer()?) {
      Ok(number) => Ok(number)
      Err(_) => Err(out_of_range(source, type_name: "Int8"))
    }
  }
}

