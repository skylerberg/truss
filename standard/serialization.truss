  fn serialize[Sink: Serializer](self, sink: mut Sink) {
    mut sink.float(Float64.from(self))
  }
}

impl Deserialize for Float32 {
  fn deserialize[Source: Deserializer](source: mut Source) -> Result[Float32, Error] {
    let number = mut source.float()?
    Ok(number.to_float32())
  }
}

impl Serialize for Float64 {
  fn serialize[Sink: Serializer](self, sink: mut Sink) {
    mut sink.float(self)
  }
}

impl Deserialize for Float64 {
  fn deserialize[Source: Deserializer](source: mut Source) -> Result[Float64, Error] {
