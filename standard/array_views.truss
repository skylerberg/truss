use standard::core
use standard::slice

public fn Array[Element, count: USize].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.slice().is_empty()
}

public fn Array[Element, count: USize].get(self, index: USize) lends Option[Element]
  cost time O(1)
{
  todo
}

public fn Array[Element, count: USize].first(self) lends Option[Element]
  cost time O(1)
{
  todo
}

public fn Array[Element, count: USize].last(self) lends Option[Element]
  cost time O(1)
{
  todo
}

public fn Array[Element, count: USize].split_first(self) lends Option[slice::SplitFirst[Element]]
  cost time O(1)
{
  todo
}

public fn Array[Element, count: USize].split_last(self) lends Option[slice::SplitLast[Element]]
  cost time O(1)
{
  todo
}

public fn Array[Element, count: USize].split_at(self, index: USize) -> core::Pair[Slice[Element], Slice[Element]]
  requires index <= self.length()
  ensures result.first.length() == index
  ensures result.second.length() == self.length() - index
  cost time O(1)
{
  self.slice().split_at(index)
}

public fn Array[Element: Equal, count: USize].contains(self, item: Element) -> Bool
  ensures result == (exists i in 0..self.length() => self[i] == item)
  cost time O(self.length())
{
  self.slice().contains(item)
}

public fn Array[Element: Equal, count: USize].index_of(self, item: Element) -> Option[USize]
  ensures match result {
    Some(index) => index < self.length() && self[index] == item
    None => !self.contains(item)
  }
  cost time O(self.length())
{
  self.slice().index_of(item)
}

public fn Array[Element: Equal, count: USize].last_index_of(self, item: Element) -> Option[USize]
  ensures match result {
    Some(index) => index < self.length() && self[index] == item
    None => !self.contains(item)
  }
  cost time O(self.length())
{
  self.slice().last_index_of(item)
}

public fn Array[Element, count: USize].find_index(self, matching: (fn(Element) -> Bool cost time finite)) -> Option[USize]
  ensures match result {
    Some(index) => index < self.length()
    None => true
  }
  cost time O(self.length() * time(matching))
{
  self.slice().find_index(matching)
}

public fn Array[Element: Equal, count: USize].starts_with(self, prefix: Slice[Element]) -> Bool
  cost time O(prefix.length())
{
  self.slice().starts_with(prefix)
}

public fn Array[Element: Equal, count: USize].ends_with(self, suffix: Slice[Element]) -> Bool
  cost time O(suffix.length())
{
  self.slice().ends_with(suffix)
}

public fn Array[Element: Equal, count: USize].find_slice(self, needle: Slice[Element]) -> Option[USize]
  ensures match result {
    Some(index) => index + needle.length() <= self.length()
    None => true
  }
  cost time O(self.length() + needle.length())
{
  self.slice().find_slice(needle)
}

public fn Array[Element: Ordered, count: USize].is_sorted(self) -> Bool
  cost time O(self.length())
{
  self.slice().is_sorted()
}

public fn Array[Element: Ordered, count: USize].binary_search(self, target: Element) -> Option[USize]
  requires self.is_sorted()
  ensures match result {
    Some(index) => index < self.length() && self[index] == target
    None => !self.contains(target)
  }
  cost time O(log(self.length()))
{
  self.slice().binary_search(target)
}

public fn Array[Element, count: USize].partition_point(self, before: (fn(Element) -> Bool cost time finite)) -> USize
  ensures result <= self.length()
  cost time O(log(self.length()) * time(before))
{
  self.slice().partition_point(before)
}

public fn Array[Element: Ordered, count: USize].minimum(self) lends Option[Element]
  cost time O(self.length())
{
  todo
}

public fn Array[Element: Ordered, count: USize].maximum(self) lends Option[Element]
  cost time O(self.length())
{
  todo
}

public fn Array[Element: Copyable, count: USize].to_list(self) -> List[Element]
  ensures result.length() == self.length()
  cost time O(self.length())
{
  self.slice().to_list()
}

public fn Array[Element: Copyable, count: USize].filter(self, keep: (fn(Element) -> Bool cost time finite)) -> List[Element]
  ensures result.length() <= self.length()
  cost time O(self.length() * time(keep))
{
  self.slice().filter(keep)
}

public fn Array[Element: Ordered + Copyable, count: USize].sorted(self) -> List[Element]
  ensures result.length() == self.length()
  ensures result.is_sorted()
  cost time O(self.length() * log(self.length()))
{
  self.slice().sorted()
}

public fn Array[Element: Copyable, count: USize].repeated(self, times: USize) -> List[Element]
  ensures result.length() == self.length() * times
  cost time O(self.length() * times)
{
  self.slice().repeated(times)
}

public fn Array[Element: Display, count: USize].join(self, separator: StringSlice) -> String
  cost time finite
{
  self.slice().join(separator)
}

public fn Array[Element, count: USize].enumerate(self) yields core::Indexed[Element]
  ensures finished ==> yielded.length() == self.length()
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].enumerate(mut self) yields mut core::Indexed[Element]
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].reversed(self) yields Element
  ensures finished ==> yielded.length() == self.length()
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].reversed(mut self) yields mut Element
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].windows(self, size: USize) yields Slice[Element]
  requires size > 0
  ensures result.length() == size
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].chunks(self, size: USize) yields Slice[Element]
  requires size > 0
  ensures result.length() <= size
  cost time O(self.length())
{
  todo
}

public fn Array[Element: Equal, count: USize].split(self, separator: Element) yields Slice[Element]
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].zip[Other](self, other: Slice[Other]) yields core::Pair[Element, Other]
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].zip[Other](mut self, other: mut Slice[Other]) yields mut core::Pair[Element, Other]
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].swap(mut self, first: USize, second: USize)
  requires first < self.length()
  requires second < self.length()
  ensures self.length() == old(self.length())
  cost time O(1)
{
  mut self[..].swap(first, second)
}

public fn Array[Element, count: USize].reverse(mut self)
  ensures self.length() == old(self.length())
  cost time O(self.length())
{
  mut self[..].reverse()
}

public fn Array[Element, count: USize].rotate_left(mut self, by: USize)
  requires by <= self.length()
  ensures self.length() == old(self.length())
  cost time O(self.length())
{
  mut self[..].rotate_left(by)
}

public fn Array[Element, count: USize].rotate_right(mut self, by: USize)
  requires by <= self.length()
  ensures self.length() == old(self.length())
  cost time O(self.length())
{
  mut self[..].rotate_right(by)
}

public fn Array[Element: Copyable, count: USize].fill(mut self, value: Element)
  ensures self.length() == old(self.length())
  cost time O(self.length())
{
  mut self[..].fill(value)
}

public fn Array[Element: Copyable, count: USize].copy_from(mut self, source: Slice[Element])
  requires source.length() == self.length()
  ensures self.length() == old(self.length())
  cost time O(self.length())
{
  mut self[..].copy_from(source)
}

public fn Array[Element, count: USize].update_each[capability Granted](
  mut self,
  change: (fn(mut Element) uses Granted cost time finite),
)
  uses Granted
  ensures self.length() == old(self.length())
  cost calls(change) == self.length()
  cost time O(self.length() * time(change))
{
  mut self[..].update_each(change)
}

public fn Array[Element: Ordered, count: USize].sort(mut self)
  ensures self.length() == old(self.length())
  ensures self.is_sorted()
  cost time O(self.length() * log(self.length()))
{
  mut self[..].sort()
}

public fn Array[Element, count: USize].sort_by(mut self, compare: (fn(Element, Element) -> Ordering cost time finite))
  ensures self.length() == old(self.length())
  cost time O(self.length() * log(self.length()) * time(compare))
{
  mut self[..].sort_by(compare)
}

public fn Array[Element, count: USize].sort_by_key[Key: Ordered](mut self, key: (fn(Element) -> Key cost time finite))
  ensures self.length() == old(self.length())
  cost time O(self.length() * log(self.length()) * time(key))
{
  mut self[..].sort_by_key(key)
}
