public fn List[Element].remove_range(mut self, range: Range[USize])
  requires range.start <= range.stop
  requires range.stop <= self.length()
  requires !range.inclusive
  ensures self.length() == old(self.length()) - (range.stop - range.start)
  cost time O(old(self.length()))
  cost allocations == 0
{
  todo
}

