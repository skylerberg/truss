use standard::intrinsic

public opaque type List[Element](storage: intrinsic::Storage[Element])
  derives Copyable

public opaque type Slice[Element](elements: intrinsic::View[Element])
  derives Plain

impl Model for List[Element] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::storage_model(self.storage)
  }
}

impl Model for Slice[Element] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::view_model(self.elements)
  }
}

public fn List[Element].with_capacity(capacity: USize) -> List[Element]
  ensures result.model().length() == 0
{
  List(storage: intrinsic::storage_with_capacity(capacity))
}

internal fn List[Element].from_storage(storage: own intrinsic::Storage[Element]) -> List[Element] {
  List(storage: own storage)
}

internal fn List[Element].elements(self) -> intrinsic::View[Element] {
  intrinsic::storage_view(self.storage)
}

public fn List[Element].length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
{
  intrinsic::storage_length(self.storage)
}

public fn List[Element].is_empty(self) -> Bool
  cost time O(1)
{
  self.length() == 0
}

public fn List[Element].push(mut self, item: own Element)
  ensures identical(self.model(), old(self.model()).append(item))
  cost amortized time O(1)
{
  intrinsic::storage_push(mut self.storage, value: own item)
}

public fn List[Element].pop(mut self) -> Option[Element] {
  if self.length() == 0 { None } else { Some(intrinsic::storage_pop(mut self.storage)) }
}

public fn List[Element].insert_at(mut self, position: USize, item: own Element)
  requires position <= self.length()
  cost time O(self.length())
{
  intrinsic::storage_insert(mut self.storage, index: position, value: own item)
}

public fn List[Element].partition_point(self, before: (fn(Element) -> Bool cost time finite)) -> USize
  cost time O(log(self.length()) * time(before))
{
  var low: USize = 0
  var high = self.length()
  while low < high
    invariant low <= high
    invariant high <= self.length()
    decreases high - low
    cost time O((log(self.length()) - log(high - low)) * time(before))
  {
    let middle = low + (high - low) / 2
    if before(self[middle]) {
      low = middle + 1
    } else {
      high = middle
    }
  }
  low
}

public fn List[Element].slice(self) -> Slice[Element]
  ensures identical(result.model(), self.model())
  cost time O(1)
{
  Slice(elements: intrinsic::storage_view(self.storage))
}

public fn List[Element].each(self) yields Element
  ensures identical(result, self[yielded.length()])
  ensures yielded.length() <= self.length()
  ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
  ensures finished ==> yielded.length() == self.length()
  ensures finished ==> identical(yielded, self.model())
  cost time O(self.length())
{
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    invariant yielded.length() == index
    invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    decreases self.length() - index
  {
    yield self[index]
    index += 1
  }
}

public fn List[Element].each(mut self) yields mut Element {
  for index in 0..self.length() {
    yield mut self[index]
  }
}

public fn List[Element].map[Output](self, transform: fn(Element) -> Output) -> List[Output] {
  var results: List[Output] = []
  for item in self {
    mut results.push(transform(item))
  }
  results
}

public fn List[Element].filter(self, keep: fn(Element) -> Bool) -> List[Element] {
  todo
}

public fn Slice[Element].length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
{
  intrinsic::view_length(self.elements)
}

public fn Slice[Element].each(self) yields Element
  ensures identical(result, self[yielded.length()])
  ensures yielded.length() <= self.length()
  ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
  ensures finished ==> yielded.length() == self.length()
  ensures finished ==> identical(yielded, self.model())
  cost time O(self.length())
{
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    invariant yielded.length() == index
    invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    decreases self.length() - index
  {
    yield self[index]
    index += 1
  }
}

impl Index for List[Element] {
  type Key = USize
  type Output = Element

  fn at(self, key: USize) lends Element
    requires key < self.length()
    ensures identical(result, self.model()[key])
    cost time O(1)
  {
    yield intrinsic::storage_at(self.storage, index: key)
  }

  fn at(mut self, key: USize) lends mut Element
    requires key < self.length()
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
  {
    yield intrinsic::storage_at_mut(mut self.storage, index: key)
  }
}

impl Index for Slice[Element] {
  type Key = USize
  type Output = Element

  fn at(self, key: USize) lends Element
    requires key < self.length()
    ensures identical(result, self.model()[key])
    cost time O(1)
  {
    yield intrinsic::view_at(self.elements, index: key)
  }

  fn at(mut self, key: USize) lends mut Element {
    todo
  }
}

impl Equal for List[Element: Equal] {
  fn equal(self, other: List[Element]) -> Bool {
    if self.length() != other.length() {
      return false
    }
    for index in 0..self.length() {
      if self[index] != other[index] {
        return false
      }
    }
    true
  }
}
