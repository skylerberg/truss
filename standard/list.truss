use standard::growth
use standard::intrinsic
use standard::list::slice

public opaque type List[Element](storage: intrinsic::Storage[Element])
  derives Copyable

public opaque type Slice[Element](elements: intrinsic::View[Element])
  derives Plain

public type SplitFirst[Element](first: Element, rest: Slice[Element])

public type SplitLast[Element](last: Element, rest: Slice[Element])

impl Model for List[Element] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::storage_model(self.storage)
  }
}

impl Model for Slice[Element] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::view_model(self.elements)
  }
}

public fn List[Element].with_capacity(capacity: USize) -> List[Element]
  ensures result.model().length() == 0
  cost time O(1)
{
  List(storage: intrinsic::storage_with_capacity(capacity))
}

internal fn List[Element].from_storage(storage: own intrinsic::Storage[Element]) -> List[Element]
  ensures identical(result.model(), intrinsic::storage_model(storage))
  cost time O(1)
  cost allocations == 0
{
  List(storage: own storage)
}

internal fn List[Element].elements(self) -> intrinsic::View[Element] {
  intrinsic::storage_view(self.storage)
}

public fn List[Element].length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_length(self.storage)
}

public transparent fn List[Element].is_empty(self) -> Bool
  cost time O(1)
  cost allocations == 0
{
  self.length() == 0
}

public fn List[Element].push(mut self, item: own Element)
  ensures identical(self.model(), old(self.model()).append(item))
  cost amortized time O(1)
{
  growth::push(mut self.storage, value: own item)
}

public fn List[Element].pop(mut self) -> Option[Element]
  ensures (result is Some(_)) == (old(self.length()) > 0)
  ensures self.length() + (if old(self.length()) > 0 { 1 } else { 0 }) == old(self.length())
  ensures forall i in 0..self.length() => identical(self.model()[i], old(self.model())[i])
  ensures !(result is Some(item) && !identical(item, old(self.model())[old(self.length()) - 1]))
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  if self.length() == 0 { None } else { Some(intrinsic::storage_pop(mut self.storage)) }
}

public fn List[Element].insert_at(mut self, position: USize, item: own Element)
  requires position <= self.length()
  ensures self.model().length() == old(self.model()).length() + 1
  ensures forall i in 0..position => identical(self.model()[i], old(self.model())[i])
  ensures identical(self.model()[position], item)
  ensures forall i: Integer =>
    position <= i && i < old(self.model()).length() ==>
      identical(self.model()[i + 1], old(self.model())[i])
  ensures forall i: Integer =>
    position < i && i < self.model().length() ==> identical(self.model()[i], old(self.model())[i - 1])
  cost time O(self.length())
{
  growth::reserve(mut self.storage, additional: 1)
  intrinsic::storage_insert(mut self.storage, index: position, value: own item)
}

public fn List[Element].partition_point(self, before: (fn(Element) -> Bool cost time finite)) -> USize
  requires forall i in 0..self.length() => forall j in i..self.length() =>
    before(self.model()[j]) ==> before(self.model()[i])
  ensures result <= self.length()
  ensures forall i in 0..result => before(self.model()[i])
  ensures forall i in result..self.length() => !before(self.model()[i])
  cost time O(log(self.length()) * time(before))
{
  self.slice().partition_point(before)
}

public fn List[Element].slice(self) -> Slice[Element]
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::storage_view(self.storage))
}

internal fn List[Element].slice_range(self, start: USize, stop: USize) -> Slice[Element]
  requires start <= stop
  requires stop <= self.length()
  ensures result.length() == stop - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice().slice_range(start, stop: stop)
}

internal fn List[Element].slice_from(self, start: USize) -> Slice[Element]
  requires start <= self.length()
  ensures result.length() == self.length() - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice_range(start, stop: self.length())
}

internal fn Slice[Element].slice_range(self, start: USize, stop: USize) -> Slice[Element]
  requires start <= stop
  requires stop <= self.length()
  ensures result.length() == stop - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::view_slice(self.elements, start, stop))
}

internal fn Slice[Element].slice_from(self, start: USize) -> Slice[Element]
  requires start <= self.length()
  ensures result.length() == self.length() - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice_range(start, stop: self.length())
}

impl Iterable for List[Element] {
  type Element = Element

  fn each(self) yields Element
    ensures identical(result, self[yielded.length()])
    ensures yielded.length() <= self.length()
    ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    ensures finished ==> yielded.length() == self.length()
    ensures finished ==> identical(yielded, self.model())
    cost time O(self.length())
  {
    var index: USize = 0
    while index < self.length()
      invariant index <= self.length()
      invariant yielded.length() == index
      invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
      decreases self.length() - index
    {
      yield self[index]
      index += 1
    }
  }
}

public fn List[Element].each(mut self) yields mut Element {
  for index in 0..self.length()
    invariant self.length() == old(self.length())
  {
    yield mut self[index]
  }
}

public fn List[Element].swap(mut self, first: USize, second: USize)
  requires first < self.length()
  requires second < self.length()
  ensures self.length() == old(self.length())
  ensures identical(self.model()[first], old(self.model())[second])
  ensures identical(self.model()[second], old(self.model())[first])
  ensures forall i in 0..self.length() =>
    i == first || i == second || identical(self.model()[i], old(self.model())[i])
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  intrinsic::storage_swap(mut self.storage, first: first, second: second)
}

public fn List[Element].reverse(mut self)
  ensures self.length() == old(self.length())
  ensures forall i in 0..self.length() =>
    identical(self.model()[i], old(self.model())[self.length() - 1 - i])
  ensures forall measure: (fn(Element) -> Integer cost time finite) =>
    self.model().sum(measure) == old(self.model()).sum(measure)
  ensures self.capacity() == old(self.capacity())
  cost time O(self.length())
  cost amortized time O(self.length())
{
  var low: USize = 0
  var high = self.length()
  while low + 1 < high
    invariant self.length() == old(self.length())
    invariant low + high == self.length()
    invariant forall i in 0..low =>
      identical(self.model()[i], old(self.model())[self.length() - 1 - i])
    invariant forall i in high..self.length() =>
      identical(self.model()[i], old(self.model())[self.length() - 1 - i])
    invariant forall i in low..high => identical(self.model()[i], old(self.model())[i])
    invariant forall measure: (fn(Element) -> Integer cost time finite) =>
      self.model().sum(measure) == old(self.model()).sum(measure)
    invariant intrinsic::storage_capacity(self.storage) == old(intrinsic::storage_capacity(self.storage))
    decreases high - low
  {
    high -= 1
    intrinsic::storage_swap(mut self.storage, first: low, second: high)
    low += 1
  }
}

public fn List[Element].each(own self) yields own Element
  ensures identical(result, self.model()[yielded.length()])
  ensures yielded.length() <= self.length()
  ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
  ensures finished ==> yielded.length() == self.length()
  ensures finished ==> identical(yielded, self.model())
  cost time O(self.length())
{
  var remaining = own self
  mut remaining.reverse()
  while remaining.length() > 0
    invariant remaining.length() + yielded.length() == self.length()
    invariant forall i in 0..remaining.length() =>
      identical(remaining.model()[i], self.model()[self.length() - 1 - i])
    invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    decreases remaining.length()
  {
    yield intrinsic::storage_pop(mut remaining.storage)
  }
}

public fn Array[Element, count: USize].to_list(own self) -> List[Element]
  ensures identical(result.model(), self.model())
  cost time O(count)
{
  List(storage: intrinsic::storage_from_array(own self))
}

public fn Slice[Element].length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::view_length(self.elements)
}

impl Iterable for Slice[Element] {
  type Element = Element

  fn each(self) yields Element
    ensures identical(result, self[yielded.length()])
    ensures yielded.length() <= self.length()
    ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    ensures finished ==> yielded.length() == self.length()
    ensures finished ==> identical(yielded, self.model())
    cost time O(self.length())
  {
    var index: USize = 0
    while index < self.length()
      invariant index <= self.length()
      invariant yielded.length() == index
      invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
      decreases self.length() - index
    {
      yield self[index]
      index += 1
    }
  }
}

public fn Slice[Element].each(mut self) yields mut Element
  cost time O(self.length())
{
  for index in 0..self.length()
    invariant self.length() == old(self.length())
  {
    yield mut self[index]
  }
}

impl Index for List[Element] {
  type Key = USize
  type Output = Element

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    key < self.length()
  }

  fn at(self, key: USize) lends Element
    requires key < self.length()
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    yield intrinsic::storage_at(self.storage, index: key)
  }

  fn at(mut self, key: USize) lends mut Element
    requires key < self.length()
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
    cost amortized time O(1)
    cost allocations == 0
  {
    yield intrinsic::storage_at_mut(mut self.storage, index: key)
  }
}

impl Index for Slice[Element] {
  type Key = USize
  type Output = Element

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    key < self.length()
  }

  fn at(self, key: USize) lends Element
    requires key < self.length()
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    yield intrinsic::view_at(self.elements, index: key)
  }

  fn at(mut self, key: USize) lends mut Element
    requires key < self.length()
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
    cost amortized time O(1)
    cost allocations == 0
  {
    yield intrinsic::view_at_mut(mut self.elements, index: key)
  }
}

impl Equal for List[Element: Equal] {
  fn equal(self, other: List[Element]) -> Bool
    ensures result == (self.length() == other.length()
      && forall i in 0..self.length() => self.model()[i] == other.model()[i])
  {
    if self.length() != other.length() {
      return false
    }
    var index: USize = 0
    while index < self.length()
      invariant index <= self.length()
      invariant forall i in 0..index => self.model()[i] == other.model()[i]
      decreases self.length() - index
    {
      if self[index] != other[index] {
        return false
      }
      index += 1
    }
    true
  }
}

public fn List[Element: Copyable].filled(value: Element, count: USize) -> List[Element]
  ensures result.length() == count
  ensures forall i in 0..count => identical(result.model()[i], value)
  cost time O(count * time(Element.copy))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], value)
  {
    intrinsic::storage_push(mut elements, value: value.copy())
  }
  List(storage: own elements)
}

public fn List[Element].generate(
  count: USize,
  make: (fn(index: USize) -> Element requires index < count cost time finite),
) -> List[Element]
  ensures result.length() == count
  ensures forall i in 0..count => identical(result.model()[i], make(i))
  cost calls(make) == count
  cost time O(count * time(make))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], make(i))
  {
    intrinsic::storage_push(mut elements, value: make(index))
  }
  List(storage: own elements)
}

public fn List[Element].collect[Source: Cursor[Element = Element]](source: own Source) -> List[Element]
  uses Source.Uses
{
  var items: List[Element] = []
  mut items.extend(own source)
  items
}

public transparent fn List[Element].capacity(self) -> USize
  ensures result >= self.length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_capacity(self.storage)
}

public fn List[Element].reserve(mut self, additional: USize)
  ensures identical(self.model(), old(self.model()))
  ensures self.capacity() >= self.length() + additional
  cost amortized time O(additional)
{
  growth::reserve(mut self.storage, additional: additional)
}

public fn List[Element].shrink_to_fit(mut self)
  ensures identical(self.model(), old(self.model()))
{
  intrinsic::storage_set_capacity(mut self.storage, capacity: self.length())
}

public fn List[Element].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
  cost allocations == 0
{
  while self.length() > 0
    decreases self.length()
    cost allocations == 0
  {
    let _ = intrinsic::storage_pop(mut self.storage)
  }
}

public fn List[Element].truncate(mut self, length: USize)
  ensures self.length() == (if length < old(self.length()) { length } else { old(self.length()) })
  ensures forall i in 0..self.length() => identical(self.model()[i], old(self.model())[i])
  cost time O(old(self.length()))
  cost allocations == 0
{
  while self.length() > length
    invariant self.length() == old(self.length()) || self.length() >= length
    invariant self.length() <= old(self.length())
    invariant forall i in 0..self.length() => identical(self.model()[i], old(self.model())[i])
    decreases self.length()
    cost allocations == 0
  {
    let _ = intrinsic::storage_pop(mut self.storage)
  }
}

public fn List[Element].remove_at(mut self, index: USize) -> Element
  requires index < self.length()
  ensures self.length() == old(self.length()) - 1
  ensures identical(result, old(self.model())[index])
  ensures forall i in 0..index => identical(self.model()[i], old(self.model())[i])
  ensures forall i in index..self.length() => identical(self.model()[i], old(self.model())[i + 1])
  cost time O(old(self.length()))
  cost allocations == 0
{
  intrinsic::storage_remove(mut self.storage, index: index)
}

public fn List[Element].swap_remove(mut self, index: USize) -> Element
  requires index < self.length()
  ensures self.length() == old(self.length()) - 1
  ensures identical(result, old(self.model())[index])
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_swap(mut self.storage, first: index, second: self.length() - 1)
  intrinsic::storage_pop(mut self.storage)
}

public fn List[Element].remove_range(mut self, range: Range[USize])
  requires range.start <= range.stop
  requires range.stop <= self.length()
  requires !range.inclusive
  ensures self.length() == old(self.length()) - (range.stop - range.start)
  cost time O(old(self.length()))
  cost allocations == 0
{
  let width = range.stop - range.start
  if width == 0 {
    return
  }
  var index = range.stop
  while index < self.length()
    invariant self.length() == old(self.length())
    invariant range.stop <= index
    invariant index <= self.length()
    decreases self.length() - index
    cost allocations == 0
  {
    intrinsic::storage_swap(mut self.storage, first: index - width, second: index)
    index += 1
  }
  var removed: USize = 0
  while removed < width
    invariant self.length() == old(self.length()) - removed
    invariant removed <= width
    decreases width - removed
    cost allocations == 0
  {
    let _ = intrinsic::storage_pop(mut self.storage)
    removed += 1
  }
}

public fn List[Element].split_off(mut self, at: USize) -> List[Element]
  requires at <= self.length()
  ensures self.length() == at
  ensures result.length() == old(self.length()) - at
  cost time O(result.length())
  cost amortized time O(result.length())
{
  let count = self.length() - at
  var tail: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  proof {
    assert identical(intrinsic::storage_model(tail), Sequence[Element].empty())
  }
  for index in 0..count
    invariant intrinsic::storage_length(tail) == index
    invariant intrinsic::storage_capacity(tail) == count
    invariant self.length() == old(self.length()) - index
    invariant intrinsic::storage_capacity(self.storage) == old(intrinsic::storage_capacity(self.storage))
    invariant forall measure: (fn(Element) -> Integer cost time finite) =>
      self.model().sum(measure) + intrinsic::storage_model(tail).sum(measure) == old(self.model()).sum(measure)
  {
    intrinsic::storage_push(mut tail, value: intrinsic::storage_pop(mut self.storage))
  }
  var moved = List(storage: own tail)
  mut moved.reverse()
  moved
}

public fn List[Element].append(mut self, other: own List[Element])
  ensures identical(self.model(), old(self.model()).concatenate(other.model()))
  cost amortized time O(other.length())
{
  var rest = own other
  mut rest.reverse()
  let count = rest.length()
  growth::reserve(mut self.storage, additional: count)
  let capacity = intrinsic::storage_capacity(self.storage)
  for index in 0..count
    invariant rest.length() == count - index
    invariant forall i in 0..rest.length() => identical(rest.model()[i], other.model()[count - 1 - i])
    invariant self.model().length() == old(self.model()).length() + index
    invariant forall i in 0..old(self.model()).length() =>
      identical(self.model()[i], old(self.model())[i])
    invariant forall i in 0..index =>
      identical(self.model()[old(self.model()).length() + i], other.model()[i])
    invariant intrinsic::storage_capacity(self.storage) == capacity
    invariant capacity >= old(self.model()).length() + count
  {
    intrinsic::storage_push(mut self.storage, value: intrinsic::storage_pop(mut rest.storage))
  }
}

public fn List[Element: Copyable].append_slice(mut self, items: Slice[Element])
  ensures self.length() == old(self.length()) + items.length()
  ensures identical(self.model(), old(self.model()).concatenate(items.model()))
  cost amortized time O(items.length() * (1 + time(Element.copy)))
{
  for index in 0..items.length()
    invariant self.model().length() == old(self.model()).length() + index
    invariant forall i in 0..old(self.model()).length() =>
      identical(self.model()[i], old(self.model())[i])
    invariant forall i in 0..index =>
      identical(self.model()[old(self.model()).length() + i], items.model()[i])
  {
    mut self.push(items[index].copy())
  }
}

public fn List[Element].extend[Source: Cursor[Element = Element]](mut self, items: own Source)
  uses Source.Uses
{
  var cursor = own items
  while mut cursor.next() is Some(item) {
    mut self.push(own item)
  }
}

public fn List[Element].retain(mut self, keep: (fn(Element) -> Bool cost time finite))
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(keep))
{
  let count = self.length()
  var retained_count: USize = 0
  for index in 0..count
    invariant self.length() == count
    invariant retained_count <= index
  {
    if keep(self[index]) {
      intrinsic::storage_swap(mut self.storage, first: retained_count, second: index)
      retained_count += 1
    }
  }
  mut self.truncate(retained_count)
}

public fn List[Element].filter(own self, keep: (fn(Element) -> Bool cost time finite)) -> List[Element]
  ensures result.length() <= self.length()
  cost time O(self.length() * time(keep))
{
  var retained = own self
  mut retained.retain(keep)
  retained
}

public fn List[Element: Equal].deduplicate(mut self)
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(Element.equal))
{
  let count = self.length()
  if count == 0 {
    return
  }
  var unique_count: USize = 1
  for index in 1..count
    invariant self.length() == count
    invariant 1 <= unique_count
    invariant unique_count <= index
  {
    if !(self[index] == self[unique_count - 1]) {
      intrinsic::storage_swap(mut self.storage, first: unique_count, second: index)
      unique_count += 1
    }
  }
  mut self.truncate(unique_count)
}

impl Default for List[Element] {
  fn default() -> List[Element] {
    []
  }
}

impl Ordered for List[Element: Ordered] {
  fn compare(self, other: List[Element]) -> Ordering
    ensures result == slice::lexicographic(self.model(), second: other.model(), from: 0)
  {
    self.slice().compare(other.slice())
  }
}

proof Ordered.agrees_with_equal for List[Element: Ordered] {
  slice::lexicographic_agrees_with_equal(first.model(), second: second.model(), from: 0)
}

proof Ordered.antisymmetric for List[Element: Ordered] {
  slice::lexicographic_is_antisymmetric(first.model(), second: second.model(), from: 0)
}

proof Ordered.transitive for List[Element: Ordered] {
  slice::lexicographic_is_transitive(first.model(), second: second.model(), third: third.model(), from: 0)
}

impl Hash for List[Element: Hash] {
  fn hash(self, hasher: mut Hasher) {
    self.slice().hash(mut hasher)
  }
}

impl Display for List[Element: Display] {
  fn display(self, output: mut TextBuilder) {
    self.slice().display(mut output)
  }
}

test "a list splits into two slices that view its elements" {
  let items: List[Int64] = [1, 2, 3, 4, 5]
  let halves = items.split_at(2)
  assert halves.first.length() == 2
  assert halves.second.length() == 3
  assert halves.first[1] == 2
  assert halves.second[0] == 3
  assert halves.second[2] == 5
  let ends = items.split_at(5)
  assert ends.first.length() == 5
  assert ends.second.length() == 0
}

fn set_first(part: mut Slice[Int64], value: Int64)
  requires part.length() > 0
{
  part[0] = value
}

test "an element is replaced through a slice of a list" {
  var items: List[Int64] = [1, 2, 3, 4]
  set_first(mut items[1..3], value: 20)
  assert items[0] == 1
  assert items[1] == 20
  assert items[2] == 3
  set_first(mut items[3..], value: 40)
  assert items[3] == 40
  assert items.length() == 4
}

test "reversed yields elements from the last to the first" {
  let items: List[Int64] = [1, 2, 3]
  var seen: List[Int64] = []
  for item in items.reversed() {
    mut seen.push(item)
  }
  assert seen.length() == 3
  assert seen[0] == 3
  assert seen[1] == 2
  assert seen[2] == 1
  let none: List[Int64] = []
  var count = 0
  for _ in none.reversed() {
    count += 1
  }
  assert count == 0
  let fixed: Array[Int64, 2] = [7, 8]
  var last = 0
  for item in fixed.reversed() {
    last = item
  }
  assert last == 7
}

test "windows yields every run of a size, and none when the list is shorter" {
  let items: List[Int64] = [1, 2, 3, 4]
  var sums: List[Int64] = []
  for window in items.windows(2) {
    assert window.length() == 2
    mut sums.push(window[0] + window[1])
  }
  assert sums.length() == 3
  assert sums[0] == 3
  assert sums[1] == 5
  assert sums[2] == 7
  var whole = 0
  for window in items.windows(4) {
    whole += 1
    assert window.length() == 4
  }
  assert whole == 1
  var none = 0
  for _ in items.windows(5) {
    none += 1
  }
  assert none == 0
}

test "chunks yields runs of a size, with a shorter last one" {
  let items: List[Int64] = [1, 2, 3, 4, 5]
  var lengths: List[USize] = []
  var firsts: List[Int64] = []
  for chunk in items.chunks(2) {
    mut lengths.push(chunk.length())
    mut firsts.push(chunk[0])
  }
  assert lengths.length() == 3
  assert lengths[0] == 2
  assert lengths[1] == 2
  assert lengths[2] == 1
  assert firsts[2] == 5
  var count = 0
  for chunk in items.chunks(9) {
    count += 1
    assert chunk.length() == 5
  }
  assert count == 1
  let none: List[Int64] = []
  var empty = 0
  for _ in none.chunks(3) {
    empty += 1
  }
  assert empty == 0
}

fn same_items(actual: Slice[Int64], expected: Slice[Int64]) -> Bool {
  if actual.length() != expected.length() {
    return false
  }
  for index in 0..actual.length() {
    if actual[index] != expected[index] {
      return false
    }
  }
  true
}

fn reverse_part(part: mut Slice[Int64]) {
  mut part.reverse()
}

fn double_each(part: mut Slice[Int64]) {
  for item in mut part {
    item = item * 2
  }
}

test "a list and a part of a list are reversed in place" {
  var items: List[Int64] = [1, 2, 3, 4, 5]
  mut items.reverse()
  assert same_items(items, expected: [5, 4, 3, 2, 1])
  reverse_part(mut items[1..4])
  assert same_items(items, expected: [5, 2, 3, 4, 1])
  var one: List[Int64] = [7]
  mut one.reverse()
  assert same_items(one, expected: [7])
  var none: List[Int64] = []
  mut none.reverse()
  assert none.length() == 0
}

test "rotating moves elements round, left and right" {
  var items: List[Int64] = [1, 2, 3, 4, 5]
  mut items.rotate_left(2)
  assert same_items(items, expected: [3, 4, 5, 1, 2])
  mut items.rotate_right(2)
  assert same_items(items, expected: [1, 2, 3, 4, 5])
  mut items.rotate_right(1)
  assert same_items(items, expected: [5, 1, 2, 3, 4])
  mut items.rotate_left(0)
  assert same_items(items, expected: [5, 1, 2, 3, 4])
  mut items.rotate_left(5)
  assert same_items(items, expected: [5, 1, 2, 3, 4])
}

test "fill and copy_from replace every element" {
  var items: List[Int64] = [1, 2, 3]
  mut items.fill(9)
  assert same_items(items, expected: [9, 9, 9])
  let source: List[Int64] = [4, 5, 6]
  mut items.copy_from(source)
  assert same_items(items, expected: [4, 5, 6])
}

test "update_each and a mut loop change elements where they are" {
  var items: List[Int64] = [1, 2, 3, 4]
  mut items.update_each(fn(item) { item = item + 10 })
  assert same_items(items, expected: [11, 12, 13, 14])
  double_each(mut items[2..])
  assert same_items(items, expected: [11, 12, 26, 28])
}

test "contains and the index searches compare elements" {
  let items: List[Int64] = [3, 1, 4, 1, 5]
  assert items.contains(4)
  assert !items.contains(9)
  assert items.index_of(1) == Some(1)
  assert items.last_index_of(1) == Some(3)
  assert items.index_of(9) is None
  assert items.last_index_of(9) is None
  assert items.find_index(fn(item) { item > 3 }) == Some(2)
  assert items.find_index(fn(item) { item > 9 }) is None
  let none: List[Int64] = []
  assert !none.contains(1)
  assert none.index_of(1) is None
  let fixed: Array[Int64, 3] = [7, 8, 7]
  assert fixed.contains(8)
  assert fixed.index_of(7) == Some(0)
  assert fixed.last_index_of(7) == Some(2)
  let words: List[String] = ["a${1}", "b${2}"]
  assert words.contains("b2")
  assert words.index_of("a1") == Some(0)
  assert !words.contains("c3")
}

test "starts_with and ends_with compare a run of elements" {
  let items: List[Int64] = [1, 2, 3, 4]
  assert items.starts_with([1, 2])
  assert items.starts_with([])
  assert !items.starts_with([2])
  assert !items.starts_with([1, 2, 3, 4, 5])
  assert items.ends_with([3, 4])
  assert items.ends_with([])
  assert !items.ends_with([3])
  assert items.ends_with([1, 2, 3, 4])
}

fn hash_of(items: Slice[Int64]) -> UInt64 {
  var hasher = Hasher.new()
  items.hash(mut hasher)
  hasher.finish()
}

test "partition_point finds where a sorted list stops satisfying a test" {
  let items: List[Int64] = [1, 3, 5, 7, 9]
  assert items.partition_point(fn(item) { item < 6 }) == 3
  assert items.partition_point(fn(item) { item < 0 }) == 0
  assert items.partition_point(fn(item) { item < 100 }) == 5
  assert items.partition_point(fn(item) { item < 1 }) == 0
  assert items.partition_point(fn(item) { item <= 1 }) == 1
  let none: List[Int64] = []
  assert none.partition_point(fn(item) { item < 6 }) == 0
}

test "slices and arrays are equal when their elements are" {
  let first: List[Int64] = [1, 2, 3]
  let second: List[Int64] = [1, 2, 3]
  let shorter: List[Int64] = [1, 2]
  let different: List[Int64] = [1, 2, 4]
  assert first.slice() == second.slice()
  assert first.slice() != shorter.slice()
  assert first.slice() != different.slice()
  assert first[1..] == second[1..]
  assert first[..2] == shorter[..]
  let fixed: Array[Int64, 3] = [1, 2, 3]
  let same: Array[Int64, 3] = [1, 2, 3]
  let other: Array[Int64, 3] = [3, 2, 1]
  assert fixed == same
  assert fixed != other
}

test "equal slices hash alike, and the length is part of the hash" {
  let first: List[Int64] = [1, 2, 3]
  let second: List[Int64] = [1, 2, 3]
  assert hash_of(first) == hash_of(second)
  assert hash_of(first) != hash_of(first[..2])
  let none: List[Int64] = []
  let zero: List[Int64] = [0]
  assert hash_of(none) != hash_of(zero)
}

test "a list is displayed with brackets and commas" {
  let items: List[Int64] = [1, 2, 3]
  assert "${items}" == "[1, 2, 3]"
  let one: List[Int64] = [7]
  assert "${one}" == "[7]"
  let none: List[Int64] = []
  assert "${none}" == "[]"
  let words: List[String] = ["a${1}", "b${2}"]
  assert "${words}" == "[a1, b2]"
  let fixed: Array[Int64, 2] = [4, 5]
  assert "${fixed}" == "[4, 5]"
  let part = fixed.slice()
  assert "${part}" == "[4, 5]"
}

test "to_list copies a slice, and filter copies the elements that pass" {
  let items: List[Int64] = [1, 2, 3, 4, 5, 6]
  let tail = items[2..].to_list()
  assert same_items(tail, expected: [3, 4, 5, 6])
  let even = items.filter(fn(item) { item % 2 == 0 })
  assert same_items(even, expected: [2, 4, 6])
  let none = items.filter(fn(item) { item > 10 })
  assert none.length() == 0
  let words: List[String] = ["a${1}", "bb${2}", "c${3}"]
  let short = words.filter(fn(word) { word.length() == 2 })
  assert short.length() == 2
  assert short[1] == "c3"
  let copies = words.to_list()
  assert copies.length() == 3
  assert copies[1] == "bb2"
}

test "get, first, and last lend an element, or nothing when there is none" {
  let words: List[String] = ["a${1}", "b${2}", "c${3}"]
  assert words.get(1) is Some(word) && word == "b2"
  assert words.get(3) is None
  assert words.first() is Some(word) && word == "a1"
  assert words.last() is Some(word) && word == "c3"
  let none: List[String] = []
  assert none.get(0) is None
  assert none.first() is None
  assert none.last() is None
  assert words[1..].first() is Some(word) && word == "b2"
  let fixed: Array[Int64, 3] = [7, 8, 9]
  assert fixed.get(2) is Some(item) && item == 9
  assert fixed.first() is Some(item) && item == 7
  assert fixed.last() is Some(item) && item == 9
  assert words.length() == 3
}

test "split_first and split_last lend one element and view the rest" {
  let items: List[Int64] = [1, 2, 3]
  assert items.split_first() is Some(split) && split.first == 1 && same_items(split.rest, expected: [2, 3])
  assert items.split_last() is Some(split) && split.last == 3 && same_items(split.rest, expected: [1, 2])
  let one: List[Int64] = [5]
  assert one.split_first() is Some(split) && split.first == 5 && split.rest.length() == 0
  let none: List[Int64] = []
  assert none.split_first() is None
  assert none.split_last() is None
}

test "enumerate yields each element with its index" {
  let words: List[String] = ["a${1}", "b${2}"]
  var seen: USize = 0
  for entry in words.enumerate() {
    assert entry.index == seen
    assert entry.element.length() == 2
    seen += 1
  }
  assert seen == 2
  var items: List[Int64] = [10, 20, 30]
  for entry in mut items.enumerate() {
    if entry.index > 0 {
      entry.element = entry.element + 1
    }
  }
  assert same_items(items, expected: [10, 21, 31])
}

test "zip yields pairs up to the shorter length, and lends both to change" {
  let numbers: List[Int64] = [1, 2, 3]
  let more: List[Int64] = [10, 20]
  var total = 0
  var count = 0
  for pair in numbers.zip(more) {
    total += pair.first * pair.second
    count += 1
  }
  assert count == 2
  assert total == 50
  var left: List[Int64] = [1, 2, 3]
  var right: List[Int64] = [10, 20, 30]
  for pair in mut left.zip(mut right[..]) {
    let first = pair.first
    pair.first = pair.second
    pair.second = first
  }
  assert same_items(left, expected: [10, 20, 30])
  assert same_items(right, expected: [1, 2, 3])
}

test "reversed lends elements to change, from the last to the first" {
  var items: List[Int64] = [1, 2, 3]
  var next = 100
  for item in mut items.reversed() {
    item = next
    next += 1
  }
  assert same_items(items, expected: [102, 101, 100])
}

test "a list is made of copies of a value, or of what a function gives for each index" {
  let zeros: List[Int64] = List.filled(0, count: 3)
  assert same_items(zeros, expected: [0, 0, 0])
  let words: List[String] = List.filled("ab${1}", count: 2)
  assert words.length() == 2
  assert words[1] == "ab1"
  let none: List[Int64] = List.filled(7, count: 0)
  assert none.length() == 0
  let doubles: List[USize] = List.generate(4, make: fn(index) { index * 2 })
  assert doubles.length() == 4
  assert doubles[0] == 0
  assert doubles[3] == 6
}

test "clear and truncate drop elements from the end and keep the room" {
  var items: List[Int64] = [1, 2, 3, 4, 5]
  let room = items.capacity()
  mut items.truncate(3)
  assert same_items(items, expected: [1, 2, 3])
  mut items.truncate(10)
  assert same_items(items, expected: [1, 2, 3])
  mut items.clear()
  assert items.length() == 0
  assert items.capacity() == room
  var words: List[String] = ["a${1}", "b${2}", "c${3}"]
  mut words.truncate(1)
  assert words.length() == 1
  assert words[0] == "a1"
  mut words.shrink_to_fit()
  assert words.capacity() == 1
  assert words[0] == "a1"
}

test "swap_remove, remove_range, and split_off take elements out" {
  var items: List[Int64] = [1, 2, 3, 4, 5, 6, 7]
  assert mut items.swap_remove(1) == 2
  assert same_items(items, expected: [1, 7, 3, 4, 5, 6])
  assert mut items.swap_remove(5) == 6
  assert same_items(items, expected: [1, 7, 3, 4, 5])
  mut items.remove_range(1..3)
  assert same_items(items, expected: [1, 4, 5])
  mut items.remove_range(1..1)
  assert same_items(items, expected: [1, 4, 5])
  mut items.remove_range(0..3)
  assert items.length() == 0
  var letters: List[Int64] = [10, 20, 30, 40, 50]
  mut letters.remove_range(0..2)
  assert same_items(letters, expected: [30, 40, 50])
  let tail = mut letters.split_off(1)
  assert same_items(letters, expected: [30])
  assert same_items(tail, expected: [40, 50])
  let everything = mut letters.split_off(0)
  assert letters.length() == 0
  assert same_items(everything, expected: [30])
}

test "retain, filter, and deduplicate keep elements in their order" {
  var items: List[Int64] = [1, 2, 3, 4, 5, 6]
  mut items.retain(fn(item) { item % 2 == 0 })
  assert same_items(items, expected: [2, 4, 6])
  mut items.retain(fn(item) { item > 100 })
  assert items.length() == 0
  let odd: List[Int64] = [1, 2, 3, 4, 5]
  let odds = own odd.filter(fn(item) { item % 2 == 1 })
  assert same_items(odds, expected: [1, 3, 5])
  var runs: List[Int64] = [1, 1, 2, 2, 2, 3, 1, 1]
  mut runs.deduplicate()
  assert same_items(runs, expected: [1, 2, 3, 1])
  var single: List[Int64] = [9]
  mut single.deduplicate()
  assert same_items(single, expected: [9])
  var empty: List[Int64] = []
  mut empty.deduplicate()
  assert empty.length() == 0
}

test "the smallest and the largest element are lent, the first of equals" {
  let items: List[Int64] = [3, 1, 4, 1, 5, 9, 2, 6]
  assert items.minimum() is Some(least) && least == 1
  assert items.maximum() is Some(greatest) && greatest == 9
  let part = items[4..]
  assert part.minimum() is Some(least) && least == 2
  let none: List[Int64] = []
  assert none.minimum() is None
  assert none.maximum() is None
  let fixed: Array[Int64, 3] = [7, -2, 7]
  assert fixed.minimum() is Some(least) && least == -2
  assert fixed.maximum() is Some(greatest) && greatest == 7
}

test "a slice is repeated, and split where an element is" {
  let items: List[Int64] = [1, 2]
  assert same_items(items.repeated(3), expected: [1, 2, 1, 2, 1, 2])
  assert items.repeated(0).length() == 0
  let fixed: Array[Int64, 1] = [5]
  assert same_items(fixed.repeated(2), expected: [5, 5])
  let fields: List[Int64] = [1, 0, 2, 3, 0, 0, 4]
  var lengths: List[USize] = []
  var total = 0
  for part in fields.split(0) {
    mut lengths.push(part.length())
    for item in part {
      total += item
    }
  }
  assert lengths.length() == 4
  assert lengths[0] == 1
  assert lengths[1] == 2
  assert lengths[2] == 0
  assert lengths[3] == 1
  assert total == 10
  let none: List[Int64] = []
  var parts = 0
  for part in none.split(0) {
    parts += 1
    assert part.length() == 0
  }
  assert parts == 1
}

test "append moves another list's elements onto the end, in order" {
  var items: List[Int64] = [1, 2]
  mut items.append([3, 4, 5])
  assert same_items(items, expected: [1, 2, 3, 4, 5])
  mut items.append([])
  assert same_items(items, expected: [1, 2, 3, 4, 5])
  var empty: List[Int64] = []
  mut empty.append([9])
  assert same_items(empty, expected: [9])
  var words: List[String] = ["a${1}"]
  let more: List[String] = ["b${2}", "c${3}"]
  mut words.append(own more)
  assert words.length() == 3
  assert words[0] == "a1"
  assert words[1] == "b2"
  assert words[2] == "c3"
}

test "binary_search finds an element of a sorted list, or reports that it is absent" {
  let numbers: List[Int64] = [1, 3, 5, 7, 9, 11]
  assert numbers.binary_search(1) == Some(0)
  assert numbers.binary_search(7) == Some(3)
  assert numbers.binary_search(11) == Some(5)
  assert numbers.binary_search(0) is None
  assert numbers.binary_search(6) is None
  assert numbers.binary_search(12) is None
  let none: List[Int64] = []
  assert none.binary_search(1) is None
  assert numbers[1..4].binary_search(5) == Some(1)
  let words: List[String] = ["apple", "banana", "cherry"]
  assert words.binary_search("banana") == Some(1)
  assert words.binary_search("blueberry") is None
}

test "find_slice finds the first place where a slice occurs" {
  let numbers: List[Int64] = [1, 2, 1, 2, 3, 1, 2, 3, 4]
  assert numbers.find_slice([1, 2, 3][..]) == Some(2)
  assert numbers.find_slice([1, 2, 3, 4][..]) == Some(5)
  assert numbers.find_slice([4][..]) == Some(8)
  assert numbers.find_slice([2, 2][..]) is None
  assert numbers.find_slice([1, 2, 1, 2, 3, 1, 2, 3, 4, 5][..]) is None
  let none: List[Int64] = []
  assert numbers.find_slice(none[..]) == Some(0)
  assert none.find_slice([1][..]) is None
  let repeated: List[Int64] = [0, 0, 0, 0, 1]
  assert repeated.find_slice([0, 0, 1][..]) == Some(2)
}

test "join writes each element with the separator between them" {
  let numbers: List[Int64] = [1, 2, 3]
  assert numbers.join(", ") == "1, 2, 3"
  assert numbers.join("") == "123"
  assert numbers[..1].join(", ") == "1"
  let none: List[Int64] = []
  assert none.join(", ") == ""
  let words: List[String] = ["a", "b"]
  assert words.join("-") == "a-b"
}

test "sort_by orders a list by a comparison" {
  var numbers: List[Int64] = [5, 3, 8, 1, 9, 2, 7, 3]
  mut numbers.sort_by(fn(first, second) { first.compare(second) })
  assert numbers == [1, 2, 3, 3, 5, 7, 8, 9]
  mut numbers.sort_by(fn(first, second) { second.compare(first) })
  assert numbers == [9, 8, 7, 5, 3, 3, 2, 1]
  var one: List[Int64] = [4]
  mut one.sort_by(fn(first, second) { first.compare(second) })
  assert one == [4]
  var none: List[Int64] = []
  mut none.sort_by(fn(first, second) { first.compare(second) })
  assert none.is_empty()
  var many: List[Int64] = []
  for value in 0..300 {
    mut many.push((value * 73) % 211)
  }
  mut many.sort_by(fn(first, second) { first.compare(second) })
  assert many.length() == 300 && many.is_sorted()
  var words: List[String] = ["pear", "fig", "banana"]
  mut words.sort_by(fn(first, second) { first.length().compare(second.length()) })
  assert words == ["fig", "pear", "banana"]
  mut words[1..].sort_by(fn(first, second) { first.compare(second) })
  assert words == ["fig", "banana", "pear"]
}

test "sort orders a list, and binary_search then finds its elements" {
  var numbers: List[Int64] = [5, 3, 8, 1, 9, 2, 7, 3]
  mut numbers.sort()
  assert numbers == [1, 2, 3, 3, 5, 7, 8, 9]
  assert numbers.is_sorted()
  assert numbers.binary_search(7) == Some(5)
  var one: List[Int64] = [4]
  mut one.sort()
  assert one == [4]
  var none: List[Int64] = []
  mut none.sort()
  assert none.is_empty()
  var two: List[Int64] = [2, 1]
  mut two.sort()
  assert two == [1, 2]
  var many: List[Int64] = []
  for value in 0..500 {
    mut many.push((value * 73) % 211)
  }
  mut many.sort()
  assert many.length() == 500 && many.is_sorted()
  assert many[0] == 0 && many[499] == 210
  var words: List[String] = ["pear", "fig", "banana", "apple"]
  mut words.sort()
  assert words == ["apple", "banana", "fig", "pear"]
  var part: List[Int64] = [9, 8, 7, 6, 5]
  mut part[1..4].sort()
  assert part == [9, 6, 7, 8, 5]
}

test "sorted returns a sorted copy and leaves the list as it was" {
  let numbers: List[Int64] = [3, 1, 2]
  assert numbers.sorted() == [1, 2, 3]
  assert numbers == [3, 1, 2]
  assert numbers[1..].sorted() == [1, 2]
  let none: List[Int64] = []
  assert none.sorted().is_empty()
}

test "sort_by_key orders a list by what a function gives for each element" {
  var words: List[String] = ["pear", "fig", "banana", "kiwi"]
  mut words.sort_by_key(fn(word) { word.length() })
  assert words[0] == "fig" && words[3] == "banana"
  assert words[1].length() == 4 && words[2].length() == 4
  var numbers: List[Int64] = [3, -1, 2, -5]
  mut numbers.sort_by_key(fn(number) { number * number })
  assert numbers == [-1, 2, 3, -5]
  let offset: Int64 = 10
  mut numbers.sort_by_key(fn(number) { (number - offset) * (number - offset) })
  assert numbers == [3, 2, -1, -5]
}

test "min_by and max_by lend the least and the greatest element by a comparison" {
  let words: List[String] = ["pear", "fig", "banana", "kiwi", "plum", "yam"]
  assert words.min_by(fn(first, second) { first.length().compare(second.length()) }) == Some("fig")
  assert words.max_by(fn(first, second) { first.length().compare(second.length()) }) == Some("banana")
  assert words.min_by(fn(first, second) { first.compare(second) }) == Some("banana")
  assert words.max_by(fn(first, second) { first.compare(second) }) == Some("yam")
  assert words[3..].min_by(fn(first, second) { first.length().compare(second.length()) }) == Some("yam")
  assert words[3..].max_by(fn(first, second) { first.length().compare(second.length()) }) == Some("plum")
  let one: List[Int64] = [4]
  assert one.min_by(fn(first, second) { first.compare(second) }) == Some(4)
  assert one.max_by(fn(first, second) { first.compare(second) }) == Some(4)
  let none: List[Int64] = []
  assert none.min_by(fn(first, second) { first.compare(second) }) is None
  assert none.max_by(fn(first, second) { first.compare(second) }) is None
}

test "append_slice adds a copy of each element of a slice" {
  var numbers: List[Int64] = [1, 2]
  let more: List[Int64] = [3, 4, 5]
  mut numbers.append_slice(more[1..])
  assert numbers == [1, 2, 4, 5]
  mut numbers.append_slice(more[..0])
  assert numbers == [1, 2, 4, 5]
  var words: List[String] = []
  let names: List[String] = ["a", "b"]
  mut words.append_slice(names.slice())
  mut words.append_slice(names.slice())
  assert words == ["a", "b", "a", "b"]
  assert names == ["a", "b"]
}
test "lists and slices are ordered by their first different element, then by length" {
  let low: List[Int64] = [1, 2, 3]
  let high: List[Int64] = [1, 3]
  let longer: List[Int64] = [1, 2, 3, 0]
  let none: List[Int64] = []
  assert low.compare(high) == Ordering.Less && high.compare(low) == Ordering.Greater
  assert low.compare(longer) == Ordering.Less && longer.compare(low) == Ordering.Greater
  assert low.compare(low.copy()) == Ordering.Equal
  assert none.compare(low) == Ordering.Less && none.compare(none.copy()) == Ordering.Equal
  assert low < high && low <= low.copy() && high > longer && longer >= low
  assert low[1..].compare(high[1..]) == Ordering.Less
  assert low[..2].compare(longer[..2]) == Ordering.Equal
  var rows: List[List[Int64]] = [[2, 1], [1, 5, 0], [], [1, 5]]
  mut rows.sort()
  assert rows == [[], [1, 5], [1, 5, 0], [2, 1]]
  let words: List[String] = ["b", "a"]
  let other: List[String] = ["b", "b"]
  assert words < other
}
