use standard.core
use standard.intrinsic

internal fn reserve[Element](storage: mut intrinsic.Storage[Element], additional: UInt64)
  ensures intrinsic.storage_capacity(storage) >= intrinsic.storage_length(storage) + additional
  ensures identical(intrinsic.storage_model(storage), old(intrinsic.storage_model(storage)))
  ensures old(intrinsic.storage_length(storage)) + additional <= old(intrinsic.storage_capacity(storage))
    ==> intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
  cost amortized time O(additional)
  cost allocations <= (if intrinsic.storage_length(storage) + additional > intrinsic.storage_capacity(storage) { 1 } else { 0 })
{
  let length = intrinsic.storage_length(storage)
  let current = intrinsic.storage_capacity(storage)
  if additional > core.maximum_length - length {
    intrinsic.crash("a storage cannot hold that many elements")
  }
  let needed = length + additional
  if needed > current {
    var capacity = current * 2
    if capacity < needed {
      capacity = needed
    }
    if capacity < 4 {
      capacity = 4
    }
    intrinsic.storage_set_capacity(mut storage, capacity: capacity)
  }
}

internal fn push[Element](storage: mut intrinsic.Storage[Element], value: own Element)
  ensures identical(intrinsic.storage_model(storage), old(intrinsic.storage_model(storage)).append(value))
  ensures old(intrinsic.storage_length(storage)) < old(intrinsic.storage_capacity(storage))
    ==> intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
  cost amortized time O(1)
  cost allocations <= (if intrinsic.storage_length(storage) < intrinsic.storage_capacity(storage) { 0 } else { 1 })
{
  reserve(mut storage, additional: 1)
  intrinsic.storage_push(mut storage, value: own value)
}
