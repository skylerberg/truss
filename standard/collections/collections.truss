use standard.map

public opaque type Deque[Element](front: List[Element], back: List[Element])
  cost potential if front.length() > back.length() { 8 * (front.length() - back.length()) } else { 8 * (back.length() - front.length()) }
  derives Copyable

public opaque type Heap[Element: Ordered](items: List[Element], largest_first: Bool)
  derives Copyable

public opaque type HeapCursor[Element: Ordered](heap: Heap[Element])

public opaque type SortedMap[Key: Ordered, Value](entries: List[map.Entry[Key, Value]])
  invariant forall i in 0..entries.length() => forall j in 0..entries.length() =>
    i < j ==> entries.model()[i].key < entries.model()[j].key
  derives Copyable

public type SortedMapKeys[Key, Value](entries: Slice[map.Entry[Key, Value]])

public type SortedMapValues[Key, Value](entries: Slice[map.Entry[Key, Value]])

public opaque type SortedSet[Element: Ordered](elements: List[Element])
  invariant forall i in 0..elements.length() => forall j in 0..elements.length() =>
    i < j ==> elements.model()[i] < elements.model()[j]
  derives Copyable

public opaque type LruCache[Key: Hash + Ordered + Copyable, Value](
  capacity: UInt64,
  entries: Map[Key, LruSlot[Value]],
  recency: Deque[LruUse[Key]],
  clock: UInt64,
)
  invariant capacity > 0

internal type LruSlot[Value](value: Value, stamp: UInt64)

internal type LruUse[Key](key: Key, stamp: UInt64)

public opaque type BitSet(words: List[UInt64], length: UInt64)
  invariant words.length() == length / 64 + (if length % 64 == 0 { 0 } else { 1 })
  invariant length % 64 == 0 || words[words.length() - 1] < power(2, length % 64)
  derives Copyable

internal type Numbered[Key, Value](key: Key, ordinal: UInt64, value: Value)

internal fn sorted_by_key[Key: Ordered, Value](items: own List[Numbered[Key, Value]]) -> List[Numbered[Key, Value]]
  ensures result.length() == items.length()
  cost time O(items.length() * log(items.length()) * (1 + time(Key.compare)))
  cost allocations <= 3 * items.length() * log(items.length()) * allocations(Key.compare)
{
  var sorted = own items
  mut sorted.sort_by(fn(first, second) {
    let order = first.key.compare(second.key)
    if order == Ordering.Equal { first.ordinal.compare(second.ordinal) } else { order }
  })
  sorted
}
