use standard::collections
use standard::intrinsic
use standard::list
use standard::list::slice
use standard::map

fn strictly_ascending[Element: Ordered](elements: Sequence[Element]) -> Bool
  ensures result == (forall first in 0..elements.length() => forall second in 0..elements.length() => first < second ==> elements[first] < elements[second])
  cost time finite
{
  forall i in 0..elements.length() => forall j in 0..elements.length() => i < j ==> elements[i] < elements[j]
}

theorem ascending_below[Element: Ordered](
  elements: Sequence[Element],
  element: Element,
  last: Integer,
  bound: Integer,
)
  requires strictly_ascending(elements)
  requires 0 <= bound
  requires bound <= last
  requires last < elements.length()
  requires elements[last] <= element
  ensures forall i in 0..bound => elements[i] < element
  decreases bound
  cost time finite
{
  if bound > 0 {
    ascending_below(elements, element: element, last: last, bound: bound - 1)
    slice::less_then_at_most(elements[bound - 1], second: elements[last], third: element)
  }
}

theorem ascending_above[Element: Ordered](
  elements: Sequence[Element],
  element: Element,
  first: Integer,
  bound: Integer,
)
  requires strictly_ascending(elements)
  requires 0 <= first
  requires first < bound
  requires bound <= elements.length()
  requires element <= elements[first]
  ensures forall i in bound..elements.length() => element < elements[i]
  decreases elements.length() - bound
  cost time finite
{
  if bound < elements.length() {
    ascending_above(elements, element: element, first: first, bound: bound + 1)
    slice::at_most_then_less(element, second: elements[first], third: elements[bound])
  }
}

fn collections::SortedSet[Element: Ordered].search(self, element: Element) -> Result[USize, USize]
  ensures match result {
    Ok(index) => index < self.elements.length()
      && self.elements.model()[index] == element
      && self.elements.model()[index] <= element
      && element <= self.elements.model()[index]
    Err(index) => index <= self.elements.length()
      && (forall i in 0..index => self.elements.model()[i] < element)
      && (forall i in index..self.elements.length() => element < self.elements.model()[i])
  }
  cost time O(log(self.elements.length()) * time(Element.compare))
{
  var low: USize = 0
  var high = self.elements.length()
  while low < high
    invariant low <= high
    invariant high <= self.elements.length()
    invariant forall i in 0..low => self.elements.model()[i] < element
    invariant forall i in high..self.elements.length() => element < self.elements.model()[i]
    decreases high - low
    cost time O((log(self.elements.length()) - log(high - low)) * time(Element.compare))
  {
    let middle = low + (high - low) / 2
    match self.elements[middle].compare(element) {
      Less => {
        proof {
          ascending_below(self.elements.model(), element: element, last: middle, bound: middle)
        }
        low = middle + 1
      }
      Greater => {
        proof {
          slice::greater_is_less_reversed(self.elements[middle], second: element)
          ascending_above(self.elements.model(), element: element, first: middle, bound: middle + 1)
        }
        high = middle
      }
      Equal => {
        proof {
          slice::equal_by_compare(self.elements[middle], second: element)
          slice::equal_is_at_most_reversed(self.elements[middle], second: element)
        }
        return Ok(middle)
      }
    }
  }
  Err(low)
}

theorem present_where_equal[Element: Ordered](set: collections::SortedSet[Element], element: Element, position: USize)
  requires position < set.elements.length()
  requires set.elements.model()[position] == element
  ensures set.search(element) is Ok(_)
  cost time finite
{
  match set.search(element) {
    Ok(_) => {}
    Err(after) => {
      if position < after {
        slice::less_is_not_equal(set.elements.model()[position], second: element)
      } else {
        slice::less_is_not_equal(element, second: set.elements.model()[position])
      }
    }
  }
}

theorem absent_where_split[Element: Ordered](set: collections::SortedSet[Element], element: Element, split: USize)
  requires split <= set.elements.length()
  requires forall i in 0..split => set.elements.model()[i] < element
  requires forall i in split..set.elements.length() => element < set.elements.model()[i]
  ensures set.search(element) is Err(_)
  cost time finite
{
  match set.search(element) {
    Ok(index) => {
      if index < split {
        slice::less_is_not_equal(set.elements.model()[index], second: element)
      } else {
        slice::less_is_not_equal(element, second: set.elements.model()[index])
      }
    }
    Err(_) => {}
  }
}

fn collections::SortedSet[Element: Ordered].index_at_or_after(self, element: Element) -> USize
  ensures result <= self.elements.length()
  ensures forall i in 0..result => self.elements.model()[i] < element
  ensures forall i in result..self.elements.length() => element <= self.elements.model()[i]
  cost time O(log(self.elements.length()) * time(Element.compare))
{
  match self.search(element) {
    Ok(index) => {
      proof {
        ascending_below(self.elements.model(), element: element, last: index, bound: index)
        ascending_above(self.elements.model(), element: element, first: index, bound: index + 1)
      }
      index
    }
    Err(index) => index
  }
}

fn collections::SortedSet[Element: Ordered].index_after(self, element: Element) -> USize
  ensures result <= self.elements.length()
  ensures forall i in 0..result => self.elements.model()[i] <= element
  ensures forall i in result..self.elements.length() => element < self.elements.model()[i]
  cost time O(log(self.elements.length()) * time(Element.compare))
{
  match self.search(element) {
    Ok(index) => {
      proof {
        ascending_below(self.elements.model(), element: element, last: index, bound: index)
        ascending_above(self.elements.model(), element: element, first: index, bound: index + 1)
      }
      index + 1
    }
    Err(index) => index
  }
}

type Numbered[Element](element: Element, ordinal: USize)

fn set_of[Element: Ordered](elements: own List[Element]) -> collections::SortedSet[Element]
  cost time finite
{
  var numbered: List[Numbered[Element]] = List.with_capacity(elements.length())
  for element in own elements {
    let ordinal = numbered.length()
    mut numbered.push(Numbered(element: own element, ordinal: ordinal))
  }
  mut numbered.sort_by(fn(first, second) {
    let order = first.element.compare(second.element)
    if order == Ordering.Equal { first.ordinal.compare(second.ordinal) } else { order }
  })
  var set: collections::SortedSet[Element] = collections::SortedSet.new()
  for item in own numbered
    invariant strictly_ascending(set.elements.model())
  {
    mut set.insert(own item.element)
  }
  set
}

fn merged[Element: Ordered](first: own List[Element], second: own List[Element]) -> List[Element]
  requires strictly_ascending(first.model())
  requires strictly_ascending(second.model())
  ensures strictly_ascending(result.model())
  cost time finite
{
  var left = own first
  var right = own second
  var descending: List[Element] = []
  while left.length() > 0 || right.length() > 0
    invariant strictly_ascending(left.model())
    invariant strictly_ascending(right.model())
    invariant forall i in 0..descending.length() => forall j in 0..descending.length() =>
      i < j ==> descending.model()[j] < descending.model()[i]
    invariant forall i in 0..left.length() => forall j in 0..descending.length() =>
      left.model()[i] < descending.model()[j]
    invariant forall i in 0..right.length() => forall j in 0..descending.length() =>
      right.model()[i] < descending.model()[j]
    decreases left.length() + right.length()
  {
    var from_left = right.length() == 0
    var from_right = left.length() == 0
    if left.length() > 0 && right.length() > 0 {
      let last_left = left.length() - 1
      let last_right = right.length() - 1
      match left[last_left].compare(right[last_right]) {
        Less => {
          proof {
            ascending_below(left.model(), element: right.model()[last_right], last: last_left, bound: last_left)
          }
          from_right = true
        }
        Greater => {
          proof {
            slice::greater_is_less_reversed(left[last_left], second: right[last_right])
            ascending_below(right.model(), element: left.model()[last_left], last: last_right, bound: last_right)
          }
          from_left = true
        }
        Equal => {
          proof {
            slice::equal_is_at_most_reversed(left[last_left], second: right[last_right])
            ascending_below(right.model(), element: left.model()[last_left], last: last_right, bound: last_right)
          }
          let _ = mut right.pop()
          from_left = true
        }
      }
    }
    if from_left {
      match mut left.pop() {
        Some(element) => {
          mut descending.push(own element)
        }
        None => {}
      }
    } else if from_right {
      match mut right.pop() {
        Some(element) => {
          mut descending.push(own element)
        }
        None => {}
      }
    }
  }
  mut descending.reverse()
  descending
}

fn combined[Element: Ordered + Copyable](
  first: List[Element],
  second: List[Element],
  keeps_first_only: Bool,
  keeps_shared: Bool,
  keeps_second_only: Bool,
) -> List[Element]
  requires strictly_ascending(first.model())
  requires strictly_ascending(second.model())
  ensures strictly_ascending(result.model())
  ensures result.length() <= first.length() + second.length()
  ensures !keeps_second_only ==> result.length() <= first.length()
  cost time O((first.length() + second.length()) * (time(Element.compare) + time(Element.copy)))
{
  match first.length().checked_add(second.length()) {
    Some(steps) => {
      let room = if keeps_second_only { steps } else { first.length() }
      var output: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(room)
      var index: USize = 0
      var other_index: USize = 0
      for _ in 0..steps
        invariant intrinsic::storage_capacity(output) == room
        invariant index <= first.length()
        invariant other_index <= second.length()
        invariant intrinsic::storage_length(output) <= index + other_index
        invariant !keeps_second_only ==> intrinsic::storage_length(output) <= index
        invariant strictly_ascending(intrinsic::storage_model(output))
        invariant forall i in 0..intrinsic::storage_length(output) => forall j in index..first.length() =>
          intrinsic::storage_model(output)[i] < first.model()[j]
        invariant forall i in 0..intrinsic::storage_length(output) => forall j in other_index..second.length() =>
          intrinsic::storage_model(output)[i] < second.model()[j]
      {
        if index < first.length() && other_index < second.length() {
          match first[index].compare(second[other_index]) {
            Less => {
              if keeps_first_only {
                proof {
                  ascending_above(second.model(), element: first.model()[index], first: other_index, bound: other_index + 1)
                }
                intrinsic::storage_push(mut output, value: first[index].copy())
              }
              index += 1
            }
            Greater => {
              if keeps_second_only {
                proof {
                  slice::greater_is_less_reversed(first[index], second: second[other_index])
                  ascending_above(first.model(), element: second.model()[other_index], first: index, bound: index + 1)
                }
                intrinsic::storage_push(mut output, value: second[other_index].copy())
              }
              other_index += 1
            }
            Equal => {
              if keeps_shared {
                proof {
                  ascending_above(second.model(), element: first.model()[index], first: other_index, bound: other_index + 1)
                }
                intrinsic::storage_push(mut output, value: first[index].copy())
              }
              index += 1
              other_index += 1
            }
          }
        } else if index < first.length() {
          if keeps_first_only {
            intrinsic::storage_push(mut output, value: first[index].copy())
          }
          index += 1
        } else if other_index < second.length() {
          if keeps_second_only {
            intrinsic::storage_push(mut output, value: second[other_index].copy())
          }
          other_index += 1
        }
      }
      List(storage: own output)
    }
    None => intrinsic::crash("two sorted sets cannot hold that many elements".slice())
  }
}

public fn collections::SortedSet[Element: Ordered].new() -> collections::SortedSet[Element]
  ensures result.length() == 0
  cost time O(1)
  cost allocations == 0
{
  collections::SortedSet(elements: [])
}

public fn collections::SortedSet[Element: Ordered].collect[Source: Cursor[Element = Element]](
  source: own Source,
) -> collections::SortedSet[Element]
  uses Source.Uses
{
  set_of(List.collect(own source))
}

public fn collections::SortedSet[Element: Ordered].length(self) -> USize
  ensures result == (self.elements.length())
  cost time O(1)
{
  self.elements.length()
}

public fn collections::SortedSet[Element: Ordered].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn collections::SortedSet[Element: Ordered].contains(self, element: Element) -> Bool
  ensures result == (self.search(element) is Ok(_))
  cost time O(log(self.length()) * time(Element.compare))
{
  self.search(element) is Ok(_)
}

public fn collections::SortedSet[Element: Ordered].insert(mut self, element: own Element)
  ensures self.contains(element)
  cost time O(old(self.length()) + log(old(self.length())) * time(Element.compare))
{
  let _ = mut self.insert_new(own element)
}

public fn collections::SortedSet[Element: Ordered].insert_new(mut self, element: own Element) -> Bool
  ensures self.contains(element)
  ensures result == !old(self.contains(element))
  cost time O(old(self.length()) + log(old(self.length())) * time(Element.compare))
{
  match self.search(element) {
    Ok(_) => false
    Err(index) => {
      mut self.elements.insert_at(index, item: own element)
      proof {
        present_where_equal(self, element: element, position: index)
      }
      true
    }
  }
}

public fn collections::SortedSet[Element: Ordered].remove(mut self, element: Element)
  ensures !self.contains(element)
  cost time O(old(self.length()) + log(old(self.length())) * time(Element.compare))
{
  let _ = mut self.take(element)
}

public fn collections::SortedSet[Element: Ordered].take(mut self, element: Element) -> Option[Element]
  ensures !self.contains(element)
  ensures (result is Some(_)) == old(self.contains(element))
  cost time O(old(self.length()) + log(old(self.length())) * time(Element.compare))
{
  match self.search(element) {
    Ok(index) => {
      proof {
        ascending_below(self.elements.model(), element: element, last: index, bound: index)
        ascending_above(self.elements.model(), element: element, first: index, bound: index + 1)
      }
      let removed = mut self.elements.remove_at(index)
      proof {
        absent_where_split(self, element: element, split: index)
      }
      Some(own removed)
    }
    Err(_) => None
  }
}

public fn collections::SortedSet[Element: Ordered].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
{
  mut self.elements.clear()
}

public fn collections::SortedSet[Element: Ordered].first(self) lends Option[Element]
  ensures (result is None) == (self.length() == 0)
  cost time O(1)
{
  if self.elements.length() > 0 {
    Some(self.elements[0])
  } else {
    None
  }
}

public fn collections::SortedSet[Element: Ordered].last(self) lends Option[Element]
  ensures (result is None) == (self.length() == 0)
  cost time O(1)
{
  if self.elements.length() > 0 {
    Some(self.elements[self.elements.length() - 1])
  } else {
    None
  }
}

public fn collections::SortedSet[Element: Ordered].pop_first(mut self) -> Option[Element]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(old(self.length()))
{
  if self.elements.length() == 0 {
    return None
  }
  Some(mut self.elements.remove_at(0))
}

public fn collections::SortedSet[Element: Ordered].pop_last(mut self) -> Option[Element]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(1)
{
  mut self.elements.pop()
}

public fn collections::SortedSet[Element: Ordered].at_or_before(self, element: Element) lends Option[Element]
  ensures !(result is Some(before) && element < before)
  cost time O(log(self.length()) * time(Element.compare))
{
  let position = self.index_after(element)
  if position > 0 {
    proof {
      slice::at_most_is_not_less_reversed(self.elements.model()[position - 1], second: element)
    }
    Some(self.elements[position - 1])
  } else {
    None
  }
}

public fn collections::SortedSet[Element: Ordered].at_or_after(self, element: Element) lends Option[Element]
  ensures !(result is Some(after) && after < element)
  cost time O(log(self.length()) * time(Element.compare))
{
  let position = self.index_at_or_after(element)
  if position < self.elements.length() {
    proof {
      slice::at_most_is_not_less_reversed(element, second: self.elements.model()[position])
    }
    Some(self.elements[position])
  } else {
    None
  }
}

public fn collections::SortedSet[Element: Ordered].in_range(self, range: Range[Element]) -> Slice[Element]
  ensures forall i in 0..result.length() => range.contains(result.model()[i])
  cost time O(self.length() + log(self.length()) * time(Element.compare))
{
  let first = self.index_at_or_after(range.start)
  let end = if range.inclusive { self.index_after(range.stop) } else { self.index_at_or_after(range.stop) }
  if first < end { self.elements[first..end] } else { self.elements[first..first] }
}

public fn collections::SortedSet[Element: Ordered].retain(mut self, keep: (fn(Element) -> Bool cost time finite))
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(keep))
{
  var elements = map::exchange(mut self.elements, value: [])
  let count = elements.length()
  var retained: USize = 0
  for index in 0..count
    invariant elements.length() == count
    invariant retained <= index
    invariant forall i in 0..retained => forall j in 0..retained =>
      i < j ==> elements.model()[i] < elements.model()[j]
    invariant forall i in 0..retained => forall j in index..count =>
      elements.model()[i] < elements.model()[j]
    invariant forall i in index..count =>
      forall j in index..count =>
        i < j ==> elements.model()[i] < elements.model()[j]
  {
    if keep(elements[index]) {
      mut elements.swap(retained, second: index)
      retained += 1
    }
  }
  mut elements.truncate(retained)
  self.elements = own elements
}

public fn collections::SortedSet[Element: Ordered].extend[Source: Cursor[Element = Element]](
  mut self,
  elements: own Source,
)
  uses Source.Uses
{
  let added = set_of(List.collect(own elements))
  if self.elements.is_empty() {
    self.elements = own added.elements
  } else if !added.elements.is_empty() {
    let current = map::exchange(mut self.elements, value: [])
    self.elements = merged(own current, second: own added.elements)
  }
}

public fn collections::SortedSet[Element: Ordered].is_subset_of(self, other: collections::SortedSet[Element]) -> Bool
  cost time O((self.length() + other.length()) * time(Element.compare))
{
  var index: USize = 0
  var other_index: USize = 0
  while index < self.elements.length() && other_index < other.elements.length()
    invariant index <= self.elements.length()
    invariant other_index <= other.elements.length()
    decreases (self.elements.length() - index) + (other.elements.length() - other_index)
    cost time O((index + other_index) * time(Element.compare))
  {
    match self.elements[index].compare(other.elements[other_index]) {
      Less => {
        return false
      }
      Greater => {
        other_index += 1
      }
      Equal => {
        index += 1
        other_index += 1
      }
    }
  }
  index == self.elements.length()
}

public fn collections::SortedSet[Element: Ordered].is_superset_of(self, other: collections::SortedSet[Element]) -> Bool
  cost time O((self.length() + other.length()) * time(Element.compare))
{
  other.is_subset_of(self)
}

public fn collections::SortedSet[Element: Ordered].is_disjoint_from(self, other: collections::SortedSet[Element]) -> Bool
  cost time O((self.length() + other.length()) * time(Element.compare))
{
  var index: USize = 0
  var other_index: USize = 0
  while index < self.elements.length() && other_index < other.elements.length()
    invariant index <= self.elements.length()
    invariant other_index <= other.elements.length()
    decreases (self.elements.length() - index) + (other.elements.length() - other_index)
    cost time O((index + other_index) * time(Element.compare))
  {
    match self.elements[index].compare(other.elements[other_index]) {
      Less => {
        index += 1
      }
      Greater => {
        other_index += 1
      }
      Equal => {
        return false
      }
    }
  }
  true
}

public fn collections::SortedSet[Element: Ordered + Copyable].union(
  self,
  other: collections::SortedSet[Element],
) -> collections::SortedSet[Element]
  ensures result.length() <= self.length() + other.length()
  cost time O((self.length() + other.length()) * (time(Element.compare) + time(Element.copy)))
{
  collections::SortedSet(
    elements: combined(
      self.elements,
      second: other.elements,
      keeps_first_only: true,
      keeps_shared: true,
      keeps_second_only: true,
    ),
  )
}

public fn collections::SortedSet[Element: Ordered + Copyable].intersection(
  self,
  other: collections::SortedSet[Element],
) -> collections::SortedSet[Element]
  ensures result.length() <= self.length()
  cost time O((self.length() + other.length()) * (time(Element.compare) + time(Element.copy)))
{
  collections::SortedSet(
    elements: combined(
      self.elements,
      second: other.elements,
      keeps_first_only: false,
      keeps_shared: true,
      keeps_second_only: false,
    ),
  )
}

public fn collections::SortedSet[Element: Ordered + Copyable].difference(
  self,
  other: collections::SortedSet[Element],
) -> collections::SortedSet[Element]
  ensures result.length() <= self.length()
  cost time O((self.length() + other.length()) * (time(Element.compare) + time(Element.copy)))
{
  collections::SortedSet(
    elements: combined(
      self.elements,
      second: other.elements,
      keeps_first_only: true,
      keeps_shared: false,
      keeps_second_only: false,
    ),
  )
}

impl Iterable for collections::SortedSet[Element: Ordered] {
  type Element = Element

  fn count(self) -> USize
    ensures result == self.length()
    cost time O(1)
  {
    self.elements.length()
  }

  fn element(self, position: USize) lends Element
    requires position < self.count()
    cost time O(1)
  {
    self.elements[position]
  }
}

public fn collections::SortedSet[Element: Ordered].cursor(own self) -> list::ListCursor[Element]
  ensures result.remaining() == self.length()
  cost time O(self.length())
  cost amortized time O(self.length())
{
  own self.elements.cursor()
}

public fn collections::SortedSet[Element: Ordered].reversed(self) -> list::Reversed[Element]
  ensures result.count() == self.length()
  cost time O(1)
{
  self.elements.slice().reversed()
}

impl Equal for collections::SortedSet[Element: Ordered] {
  fn equal(self, other: collections::SortedSet[Element]) -> Bool {
    self.elements == other.elements
  }
}

impl Hash for collections::SortedSet[Element: Ordered + Hash] {
  fn hash(self, hasher: mut Hasher) {
    self.elements.hash(mut hasher)
  }
}

impl Default for collections::SortedSet[Element: Ordered] {
  fn default() -> collections::SortedSet[Element] {
    collections::SortedSet.new()
  }
}

impl From[List[Element]] for collections::SortedSet[Element: Ordered] {
  fn from(value: own List[Element]) -> collections::SortedSet[Element] {
    set_of(own value)
  }
}
