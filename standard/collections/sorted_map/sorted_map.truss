use standard.collections
use standard.core
use standard.list
use standard.map

fn strictly_ascending[Key: Ordered, Value](entries: Sequence[map.Entry[Key, Value]]) -> Bool
  ensures result == (forall first in 0..entries.length() => forall second in 0..entries.length() => first < second ==> entries[first].key < entries[second].key)
{
  forall i in 0..entries.length() => forall j in 0..entries.length() => i < j ==> entries[i].key < entries[j].key
}

theorem ascending_below[Key: Ordered, Value](entries: Sequence[map.Entry[Key, Value]], key: Key, last: Integer)
  requires strictly_ascending(entries)
  requires 0 <= last
  requires last < entries.length()
  requires entries[last].key <= key
  ensures forall i in 0..last => entries[i].key < key
{
}

theorem ascending_above[Key: Ordered, Value](entries: Sequence[map.Entry[Key, Value]], key: Key, first: Integer)
  requires strictly_ascending(entries)
  requires 0 <= first
  requires first < entries.length()
  requires key <= entries[first].key
  ensures forall i in first + 1..entries.length() => key < entries[i].key
{
}

fn collections.SortedMap[Key: Ordered, Value].search(self, key: Key) -> Result[UInt64, UInt64]
  ensures match result {
    Ok(index) => index < self.entries.length()
      && self.entries.model()[index].key == key
      && self.entries.model()[index].key <= key
      && key <= self.entries.model()[index].key
    Err(index) => index <= self.entries.length()
      && (forall i in 0..index => self.entries.model()[i].key < key)
      && (forall i in index..self.entries.length() => key < self.entries.model()[i].key)
  }
  cost time O(log(self.entries.length()) * time(Key.compare))
  cost allocations <= log(self.entries.length()) * allocations(Key.compare)
{
  var low: UInt64 = 0
  var high = self.entries.length()
  while low < high
    invariant low <= high
    invariant high <= self.entries.length()
    invariant forall i in 0..low => self.entries.model()[i].key < key
    invariant forall i in high..self.entries.length() => key < self.entries.model()[i].key
    decreases high - low
    cost time O((log(self.entries.length()) - log(high - low)) * time(Key.compare))
    cost allocations <= (log(self.entries.length()) - log(high - low)) * allocations(Key.compare)
  {
    let middle = low + (high - low) / 2
    match self.entries[middle].key.compare(key) {
      Less => {
        proof {
          ascending_below(self.entries.model(), key: key, last: middle)
        }
        low = middle + 1
      }
      Greater => {
        proof {
          ascending_above(self.entries.model(), key: key, first: middle)
        }
        high = middle
      }
      Equal => {
        return Ok(middle)
      }
    }
  }
  Err(low)
}

theorem present_where_equal[Key: Ordered, Value](
  map: collections.SortedMap[Key, Value],
  key: Key,
  position: UInt64,
)
  requires position < map.entries.length()
  requires map.entries.model()[position].key == key
  ensures map.search(key) is Ok(_)
{
}

theorem absent_where_split[Key: Ordered, Value](
  map: collections.SortedMap[Key, Value],
  key: Key,
  split: UInt64,
)
  requires split <= map.entries.length()
  requires forall i in 0..split => map.entries.model()[i].key < key
  requires forall i in split..map.entries.length() => key < map.entries.model()[i].key
  ensures map.search(key) is Err(_)
{
}

theorem ascending_after_larger[Key: Ordered, Value](entries: Sequence[map.Entry[Key, Value]], entry: map.Entry[Key, Value])
  requires strictly_ascending(entries)
  requires entries.length() == 0 || entries[entries.length() - 1].key < entry.key
  ensures strictly_ascending(entries.append(entry))
{
  assert forall i in 0..entries.length() => {
    if i + 1 < entries.length() {
      core.less_is_transitive(entries[i].key, second: entries[entries.length() - 1].key, third: entry.key)
    }
    entries[i].key < entry.key
  }
}

fn ordered_entries[Key: Ordered, Value](entries: own List[map.Entry[Key, Value]]) -> List[map.Entry[Key, Value]]
  ensures strictly_ascending(result.model())
  ensures result.length() <= entries.length()
  cost time O(entries.length() * (1 + log(entries.length())) * (1 + time(Key.compare)))
{
  let count = entries.length()
  var numbered: List[collections.Numbered[Key, Value]] = List.with_capacity(count)
  for entry in own entries
    invariant numbered.length() == visited.length()
    invariant numbered.length() <= count
    cost time O(visited.length())
  {
    let ordinal = count - numbered.length()
    mut numbered.push(collections.Numbered(key: own entry.key, ordinal: ordinal, value: own entry.value))
  }
  let sorted = collections.sorted_by_key(own numbered)
  var ascending: List[map.Entry[Key, Value]] = List.with_capacity(count)
  for item in own sorted
    invariant strictly_ascending(ascending.model())
    invariant ascending.length() <= visited.length()
    cost time O(visited.length() * (1 + time(Key.compare)))
  {
    if ascending.length() == 0 || ascending[ascending.length() - 1].key < item.key {
      let entry = map.Entry(key: own item.key, value: own item.value)
      proof {
        ascending_after_larger(ascending.model(), entry: entry)
      }
      mut ascending.push(own entry)
    }
  }
  ascending
}

fn merged[Key: Ordered, Value](
  first: own List[map.Entry[Key, Value]],
  second: own List[map.Entry[Key, Value]],
) -> List[map.Entry[Key, Value]]
  requires strictly_ascending(first.model())
  requires strictly_ascending(second.model())
  ensures strictly_ascending(result.model())
{
  var left = own first
  var right = own second
  var descending: List[map.Entry[Key, Value]] = []
  while left.length() > 0 || right.length() > 0
    invariant strictly_ascending(left.model())
    invariant strictly_ascending(right.model())
    invariant forall i in 0..descending.length() => forall j in 0..descending.length() =>
      i < j ==> descending.model()[j].key < descending.model()[i].key
    invariant forall i in 0..left.length() => forall j in 0..descending.length() =>
      left.model()[i].key < descending.model()[j].key
    invariant forall i in 0..right.length() => forall j in 0..descending.length() =>
      right.model()[i].key < descending.model()[j].key
    decreases left.length() + right.length()
  {
    var from_left = right.length() == 0
    var from_right = left.length() == 0
    if left.length() > 0 && right.length() > 0 {
      let last_left = left.length() - 1
      let last_right = right.length() - 1
      match left[last_left].key.compare(right[last_right].key) {
        Less => {
          proof {
            ascending_below(left.model(), key: right.model()[last_right].key, last: last_left)
          }
          from_right = true
        }
        Greater => {
          proof {
            ascending_below(right.model(), key: left.model()[last_left].key, last: last_right)
          }
          from_left = true
        }
        Equal => {
          proof {
            ascending_below(left.model(), key: right.model()[last_right].key, last: last_left)
          }
          let _ = mut left.pop()
          from_right = true
        }
      }
    }
    if from_right {
      match mut right.pop() {
        Some(entry) => {
          mut descending.push(own entry)
        }
        None => {}
      }
    } else if from_left {
      match mut left.pop() {
        Some(entry) => {
          mut descending.push(own entry)
        }
        None => {}
      }
    }
  }
  mut descending.reverse()
  descending
}

public fn collections.SortedMap[Key: Ordered, Value].collect[Source: Cursor[Element = map.Entry[Key, Value]]](
  source: own Source,
) -> collections.SortedMap[Key, Value]
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  collections.SortedMap(entries: ordered_entries(List.collect(own source)))
}

public fn collections.SortedMap[Key: Ordered, Value].length(self) -> UInt64
  ensures result == (self.entries.length())
  cost time O(1)
  cost allocations == 0
{
  self.entries.length()
}

public fn collections.SortedMap[Key: Ordered, Value].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
  cost allocations == 0
{
  self.length() == 0
}

public fn collections.SortedMap[Key: Ordered, Value].contains(self, key: Key) -> Bool
  ensures result == (self.search(key) is Ok(_))
  cost time O(log(self.length()) * time(Key.compare))
  cost allocations <= log(self.length()) * allocations(Key.compare)
{
  self.search(key) is Ok(_)
}

public fn collections.SortedMap[Key: Ordered, Value].get(self, key: Key) lends Option[Value]
  ensures (result is Some(_)) == self.contains(key)
  cost time O(log(self.length()) * time(Key.compare))
  cost allocations <= log(self.length()) * allocations(Key.compare)
{
  match self.search(key) {
    Ok(index) => {
      Some(self.entries[index].value)
    }
    Err(_) => {
      None
    }
  }
}

fn collections.SortedMap[Key: Ordered, Value].replace_value_at(mut self, position: UInt64, value: own Value) -> Value
  requires position < self.entries.length()
  ensures self.entries.length() == old(self.entries.length())
  ensures forall i in 0..self.entries.length() =>
    identical(self.entries.model()[i].key, old(self.entries.model())[i].key)
  cost time O(1)
{
  let previous = map.exchange(mut self.entries[position].value, value: own value)
  proof {
    assert forall i in 0..self.entries.length() =>
      identical(self.entries.model()[i].key, old(self.entries.model())[i].key)
  }
  previous
}

fn collections.SortedMap[Key: Ordered, Value].find_or_insert(mut self, key: own Key, default: own Value) -> UInt64
  requires strictly_ascending(self.entries.model())
  ensures strictly_ascending(self.entries.model())
  ensures result < self.entries.length()
  ensures self.entries.model()[result].key == key
  ensures self.search(key) is Ok(_)
  cost time O(old(self.entries.length()) + log(old(self.entries.length())) * time(Key.compare))
{
  match self.search(key) {
    Ok(index) => {
      proof {
        present_where_equal(self, key: key, position: index)
      }
      index
    }
    Err(index) => {
      mut self.entries.insert_at(index, item: map.Entry(key: own key, value: own default))
      proof {
        present_where_equal(self, key: key, position: index)
      }
      index
    }
  }
}

public fn collections.SortedMap[Key: Ordered, Value].insert(mut self, key: own Key, value: own Value)
  ensures self.contains(key)
  ensures self.length() == old(self.length()) + (if old(self.contains(key)) { 0 } else { 1 })
  cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare))
{
  let _ = mut self.replace(own key, value: own value)
}

public fn collections.SortedMap[Key: Ordered, Value].replace(mut self, key: own Key, value: own Value) -> Option[Value]
  ensures self.contains(key)
  ensures (result is Some(_)) == old(self.contains(key))
  ensures self.length() == old(self.length()) + (if result is Some(_) { 0 } else { 1 })
  cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare))
{
  match self.search(key) {
    Ok(index) => {
      let previous = mut self.replace_value_at(index, value: own value)
      proof {
        present_where_equal(self, key: key, position: index)
      }
      Some(own previous)
    }
    Err(index) => {
      mut self.entries.insert_at(index, item: map.Entry(key: own key, value: own value))
      proof {
        present_where_equal(self, key: key, position: index)
      }
      None
    }
  }
}

public fn collections.SortedMap[Key: Ordered, Value].get_or_insert(
  mut self,
  key: own Key,
  default: own Value,
) lends mut Value
  cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare))
{
  let position = mut self.find_or_insert(own key, default: own default)
  mut self.entries[position].value
}

public fn collections.SortedMap[Key: Ordered, Value].update(
  mut self,
  key: own Key,
  default: own Value,
  change: (fn(mut Value) uses generic Granted),
)
  uses generic Granted
  ensures self.contains(key)
  cost calls(change) == 1
  cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare) + time(change))
{
  let position = mut self.find_or_insert(own key, default: own default)
  change(mut self.entries[position].value)
  proof {
    present_where_equal(self, key: key, position: position)
  }
}

fn collections.SortedMap[Key: Ordered, Value].take_entry(mut self, key: Key) -> Option[map.Entry[Key, Value]]
  requires strictly_ascending(self.entries.model())
  ensures strictly_ascending(self.entries.model())
  ensures self.search(key) is Err(_)
  ensures (result is Some(_)) == old(self.search(key) is Ok(_))
  cost time O(old(self.entries.length()) + log(old(self.entries.length())) * time(Key.compare))
{
  match self.search(key) {
    Ok(index) => {
      proof {
        ascending_below(self.entries.model(), key: key, last: index)
        ascending_above(self.entries.model(), key: key, first: index)
      }
      let entry = mut self.entries.remove_at(index)
      proof {
        absent_where_split(self, key: key, split: index)
      }
      Some(own entry)
    }
    Err(_) => None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].remove(mut self, key: Key)
  ensures !self.contains(key)
  cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare))
{
  let _ = mut self.take_entry(key)
}

public fn collections.SortedMap[Key: Ordered, Value].take(mut self, key: Key) -> Option[Value]
  ensures !self.contains(key)
  ensures (result is Some(_)) == old(self.contains(key))
  cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare))
{
  match mut self.take_entry(key) {
    Some(entry) => Some(own entry.value)
    None => None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
{
  mut self.entries.clear()
}

public fn collections.SortedMap[Key: Ordered, Value].first(self) lends Option[map.Entry[Key, Value]]
  ensures (result is None) == (self.length() == 0)
  cost time O(1)
{
  if self.entries.length() > 0 {
    Some(self.entries[0])
  } else {
    None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].last(self) lends Option[map.Entry[Key, Value]]
  ensures (result is None) == (self.length() == 0)
  cost time O(1)
{
  if self.entries.length() > 0 {
    Some(self.entries[self.entries.length() - 1])
  } else {
    None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].pop_first(mut self) -> Option[map.Entry[Key, Value]]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(old(self.length()))
{
  if self.entries.length() == 0 {
    return None
  }
  Some(mut self.entries.remove_at(0))
}

public fn collections.SortedMap[Key: Ordered, Value].pop_last(mut self) -> Option[map.Entry[Key, Value]]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(1)
{
  mut self.entries.pop()
}

fn collections.SortedMap[Key: Ordered, Value].index_at_or_after(self, key: Key) -> UInt64
  ensures result <= self.entries.length()
  ensures forall i in 0..result => self.entries.model()[i].key < key
  ensures forall i in result..self.entries.length() => key <= self.entries.model()[i].key
  cost time O(log(self.entries.length()) * time(Key.compare))
{
  match self.search(key) {
    Ok(index) => {
      proof {
        ascending_below(self.entries.model(), key: key, last: index)
        ascending_above(self.entries.model(), key: key, first: index)
      }
      index
    }
    Err(index) => index
  }
}

fn collections.SortedMap[Key: Ordered, Value].index_after(self, key: Key) -> UInt64
  ensures result <= self.entries.length()
  ensures forall i in 0..result => self.entries.model()[i].key <= key
  ensures forall i in result..self.entries.length() => key < self.entries.model()[i].key
  cost time O(log(self.entries.length()) * time(Key.compare))
{
  match self.search(key) {
    Ok(index) => {
      proof {
        ascending_below(self.entries.model(), key: key, last: index)
        ascending_above(self.entries.model(), key: key, first: index)
      }
      index + 1
    }
    Err(index) => index
  }
}

public fn collections.SortedMap[Key: Ordered, Value].at_or_before(self, key: Key) lends Option[map.Entry[Key, Value]]
  ensures !(result is Some(entry) && key < entry.key)
  cost time O(log(self.length()) * time(Key.compare))
{
  let position = self.index_after(key)
  if position > 0 {
    Some(self.entries[position - 1])
  } else {
    None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].at_or_after(self, key: Key) lends Option[map.Entry[Key, Value]]
  ensures !(result is Some(entry) && entry.key < key)
  cost time O(log(self.length()) * time(Key.compare))
{
  let position = self.index_at_or_after(key)
  if position < self.entries.length() {
    Some(self.entries[position])
  } else {
    None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].before(self, key: Key) lends Option[map.Entry[Key, Value]]
  ensures !(result is Some(entry) && !(entry.key < key))
  cost time O(log(self.length()) * time(Key.compare))
{
  let position = self.index_at_or_after(key)
  if position > 0 {
    Some(self.entries[position - 1])
  } else {
    None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].after(self, key: Key) lends Option[map.Entry[Key, Value]]
  ensures !(result is Some(entry) && !(key < entry.key))
  cost time O(log(self.length()) * time(Key.compare))
{
  let position = self.index_after(key)
  if position < self.entries.length() {
    Some(self.entries[position])
  } else {
    None
  }
}

public fn collections.SortedMap[Key: Ordered, Value].in_range(self, range: Range[Key]) -> Slice[map.Entry[Key, Value]]
  ensures forall i in 0..result.length() => range.contains(result.model()[i].key)
  cost time O(1 + log(self.length()) * time(Key.compare))
{
  let first = self.index_at_or_after(range.start)
  let end = if range.inclusive { self.index_after(range.stop) } else { self.index_at_or_after(range.stop) }
  if first < end { self.entries[first..end] } else { self.entries[first..first] }
}

public fn collections.SortedMap[Key: Ordered, Value].retain(
  mut self,
  keep: (fn(key: Key, value: Value) -> Bool uses generic Granted
    requires self.model().contains_key(key) && identical(self.model().get(key), value)),
)
  uses generic Granted
  ensures self.length() <= old(self.length())
  ensures forall key: Key => self.model().contains_key(key) ==> keep.ensures(key, self.model().get(key), true)
  cost time O(old(self.length()) * time(keep))
{
  var entries = map.exchange(mut self.entries, value: [])
  let count = entries.length()
  var retained: UInt64 = 0
  for index in 0..count
    invariant entries.length() == count
    invariant retained <= index
    invariant forall i in 0..retained => forall j in 0..retained =>
      i < j ==> entries.model()[i].key < entries.model()[j].key
    invariant forall i in 0..retained => forall j in index..count =>
      entries.model()[i].key < entries.model()[j].key
    invariant forall i in index..count => forall j in index..count =>
      i < j ==> entries.model()[i].key < entries.model()[j].key
    invariant forall i in 0..retained => keep.ensures(entries.model()[i].key, entries.model()[i].value, true)
    invariant forall i in index..count => identical(entries.model()[i], old(self.entries.model())[i])
  {
    if keep(entries[index].key, entries[index].value) {
      mut entries.swap(retained, second: index)
      retained += 1
    }
  }
  mut entries.truncate(retained)
  self.entries = own entries
}

public fn collections.SortedMap[Key: Ordered, Value].extend[Source: Cursor[Element = map.Entry[Key, Value]]](
  mut self,
  entries: own Source,
)
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  let added = ordered_entries(List.collect(own entries))
  if self.entries.is_empty() {
    self.entries = own added
  } else if !added.is_empty() {
    let current = map.exchange(mut self.entries, value: [])
    self.entries = merged(own current, second: own added)
  }
}

impl Model for collections.SortedMap[Key: Ordered, Value] {
  type Value = FiniteMap[Key, Value]

  fn model(self) -> FiniteMap[Key, Value]
    ensures identical(result, map.entries_model(self.entries.model()))
  {
    map.entries_model(self.entries.model())
  }
}

impl Index for collections.SortedMap[Key: Ordered, Value] {
  type Key = Key
  type Output = Value

  fn contains_key(self, key: Key) -> Bool
    ensures result == self.contains(key)
    cost time O(log(self.length()) * time(Key.compare))
    cost allocations <= log(self.length()) * allocations(Key.compare)
  {
    self.contains(key)
  }

  fn at(self, key: Key) lends Value
    requires self.contains(key)
    cost time O(log(self.length()) * time(Key.compare))
    cost allocations <= log(self.length()) * allocations(Key.compare)
  {
    self.entries[self.position_of(key)].value
  }
}

impl IndexMut for collections.SortedMap[Key: Ordered, Value] {
  fn at(mut self, key: Key) lends mut Value
    requires self.contains(key)
    cost time O(log(self.length()) * time(Key.compare))
    cost allocations <= log(self.length()) * allocations(Key.compare)
  {
    let position = self.position_of(key)
    mut self.entries[position].value
  }
}

fn collections.SortedMap[Key: Ordered, Value].position_of(self, key: Key) -> UInt64
  requires self.search(key) is Ok(_)
  ensures result < self.entries.length()
  ensures result == (match self.search(key) {
      Ok(index) => index
      Err(index) => index
    })
  cost time O(log(self.entries.length()) * time(Key.compare))
  cost allocations <= log(self.entries.length()) * allocations(Key.compare)
{
  match self.search(key) {
    Ok(index) => index
    Err(index) => index
  }
}

impl core.IndexAssign for collections.SortedMap[Key: Ordered, Value] {
  fn accepts_key(self, key: Key) -> Bool
    ensures result
    cost time O(1)
    cost allocations == 0
  {
    true
  }

  fn assign(mut self, key: own Key, value: own Value)
    ensures self.contains(key)
    cost time O(old(self.length()) + log(old(self.length())) * time(Key.compare))
  {
    mut self.insert(own key, value: own value)
  }
}

impl Iterable for collections.SortedMap[Key: Ordered, Value] {
  type Element = map.Entry[Key, Value]

  fn count(self) -> UInt64
    ensures result == self.length()
    cost time O(1)
  {
    self.entries.length()
  }

  fn element(self, position: UInt64) lends map.Entry[Key, Value]
    requires position < self.count()
    cost time O(1)
  {
    self.entries[position]
  }
}

impl IntoCursor for collections.SortedMap[Key: Ordered, Value] {
  type Cursor = list.ListCursor[map.Entry[Key, Value]]

  fn cursor(own self) -> list.ListCursor[map.Entry[Key, Value]]
    ensures result.remaining() == self.length()
    cost time O(self.length())
    cost amortized time O(self.length())
  {
    own self.entries.cursor()
  }
}

public fn collections.SortedMap[Key: Ordered, Value].reversed(self) -> list.Reversed[map.Entry[Key, Value]]
  ensures result.count() == self.length()
  cost time O(1)
{
  self.entries.slice().reversed()
}

public fn collections.SortedMap[Key: Ordered, Value].keys(self) -> collections.SortedMapKeys[Key, Value]
  ensures result.count() == self.length()
  cost time O(1)
{
  collections.SortedMapKeys(entries: self.entries.slice())
}

public fn collections.SortedMap[Key: Ordered, Value].values(self) -> collections.SortedMapValues[Key, Value]
  ensures result.count() == self.length()
  cost time O(1)
{
  collections.SortedMapValues(entries: self.entries.slice())
}

public fn collections.SortedMap[Key: Ordered, Value].value_at(mut self, position: UInt64) lends mut Value
  uses Panic unless position < self.length()
  ensures self.length() == old(self.length())
  cost time O(1)
{
  if position >= self.length() {
    Panic.crash("index out of bounds")
  }
  mut self.entries[position].value
}

public fn collections.SortedMap[Key: Ordered, Value].update_values(
  mut self,
  change: (fn(mut Value) uses generic Granted),
)
  uses generic Granted
  ensures self.length() == old(self.length())
  cost calls(change) == self.length()
  cost time O(self.length() * time(change))
{
  for position in 0..self.length()
    invariant self.length() == old(self.length())
  {
    change(mut self.value_at(position))
  }
}

impl Iterable for collections.SortedMapKeys[Key, Value] {
  type Element = Key

  fn count(self) -> UInt64
    ensures result == self.entries.length()
    cost time O(1)
  {
    self.entries.length()
  }

  fn element(self, position: UInt64) lends Key
    requires position < self.count()
    ensures identical(result, self.entries.model()[position].key)
    cost time O(1)
  {
    self.entries[position].key
  }
}

impl Iterable for collections.SortedMapValues[Key, Value] {
  type Element = Value

  fn count(self) -> UInt64
    ensures result == self.entries.length()
    cost time O(1)
  {
    self.entries.length()
  }

  fn element(self, position: UInt64) lends Value
    requires position < self.count()
    ensures identical(result, self.entries.model()[position].value)
    cost time O(1)
  {
    self.entries[position].value
  }
}

impl Equal for collections.SortedMap[Key: Ordered, Value: Equal] {
  fn equal(self, other: collections.SortedMap[Key, Value]) -> Bool
    ensures result == (self.entries.length() == other.entries.length()
      && forall i in 0..self.entries.length() =>
        self.entries.model()[i].key == other.entries.model()[i].key
          && self.entries.model()[i].value == other.entries.model()[i].value)
    cost time O(self.length() * (time(Key.equal) + time(Value.equal)))
    cost allocations <= self.length() * (allocations(Key.equal) + allocations(Value.equal))
  {
    if !(self.entries.length() == other.entries.length()) {
      return false
    }
    var index: UInt64 = 0
    while index < self.entries.length()
      invariant index <= self.entries.length()
      invariant forall i in 0..index =>
        self.entries.model()[i].key == other.entries.model()[i].key
          && self.entries.model()[i].value == other.entries.model()[i].value
      decreases self.entries.length() - index
      cost time O(index * (time(Key.equal) + time(Value.equal)))
      cost allocations <= index * (allocations(Key.equal) + allocations(Value.equal))
    {
      if !(self.entries[index].key == other.entries[index].key) || !(self.entries[index].value == other.entries[index].value) {
        return false
      }
      index += 1
    }
    true
  }
}

impl Default for collections.SortedMap[Key: Ordered, Value] {
  fn default() -> collections.SortedMap[Key, Value] {
    [:]
  }
}

impl FromEntries for collections.SortedMap[Key: Ordered, Value] {
  type Key = Key
  type Value = Value

  fn from_entries(entries: own List[map.Entry[Key, Value]]) -> collections.SortedMap[Key, Value]
    requires forall i in 0..entries.length() => forall j in 0..entries.length() =>
      i < j ==> !(entries.model()[i].key == entries.model()[j].key)
    ensures result.length() <= entries.length()
    cost time O(entries.length() * (1 + log(entries.length())) * (1 + time(Key.compare)))
  {
    collections.SortedMap(entries: ordered_entries(own entries))
  }
}
