use standard.collections
use standard.map
use standard.list

public fn collections.Deque[Element].with_capacity(capacity: UInt64) -> collections.Deque[Element]
  ensures result.length() == 0
{
  collections.Deque(front: [], back: List.with_capacity(capacity))
}

public fn collections.Deque[Element].collect[Source: Cursor[Element = Element]](
  source: own Source,
) -> collections.Deque[Element]
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  collections.Deque(front: [], back: List.collect(own source))
}

public fn collections.Deque[Element].length(self) -> UInt64
  ensures result == (self.front.length() + self.back.length())
  cost time O(1)
  cost allocations == 0
{
  self.front.length() + self.back.length()
}

public fn collections.Deque[Element].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
  cost allocations == 0
{
  self.length() == 0
}

public fn collections.Deque[Element].push_front(mut self, item: own Element)
  ensures self.length() == old(self.length()) + 1
  cost amortized time O(1)
{
  mut self.front.push(own item)
}

public fn collections.Deque[Element].push_back(mut self, item: own Element)
  ensures self.length() == old(self.length()) + 1
  cost amortized time O(1)
{
  mut self.back.push(own item)
}

public fn collections.Deque[Element].pop_front(mut self) -> Option[Element]
  ensures (result is None) == (old(self.length()) == 0)
  ensures self.length() + (if old(self.length()) > 0 { 1 } else { 0 }) == old(self.length())
  cost amortized time O(1)
{
  if self.front.is_empty() && !self.back.is_empty() {
    let half = self.back.length() - self.back.length() / 2
    var later = mut self.back.split_off(half)
    mut self.back.reverse()
    let earlier = map.exchange(mut self.back, value: own later)
    mut self.front.append(own earlier)
  }
  mut self.front.pop()
}

public fn collections.Deque[Element].pop_back(mut self) -> Option[Element]
  ensures (result is None) == (old(self.length()) == 0)
  ensures self.length() + (if old(self.length()) > 0 { 1 } else { 0 }) == old(self.length())
  cost amortized time O(1)
{
  if self.back.is_empty() && !self.front.is_empty() {
    let half = self.front.length() - self.front.length() / 2
    var earlier = mut self.front.split_off(half)
    mut self.front.reverse()
    let later = map.exchange(mut self.front, value: own earlier)
    mut self.back.append(own later)
  }
  mut self.back.pop()
}

public fn collections.Deque[Element].front(self) lends Option[Element]
  cost time O(1)
{
  if self.front.length() > 0 {
    Some(self.front[self.front.length() - 1])
  } else if self.back.length() > 0 {
    Some(self.back[0])
  } else {
    None
  }
}

public fn collections.Deque[Element].back(self) lends Option[Element]
  cost time O(1)
{
  if self.back.length() > 0 {
    Some(self.back[self.back.length() - 1])
  } else if self.front.length() > 0 {
    Some(self.front[0])
  } else {
    None
  }
}

public fn collections.Deque[Element].get(self, index: UInt64) lends Option[Element]
  cost time O(1)
{
  if index < self.front.length() {
    Some(self.front[self.front.length() - 1 - index])
  } else if index - self.front.length() < self.back.length() {
    Some(self.back[index - self.front.length()])
  } else {
    None
  }
}

public fn collections.Deque[Element].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
  cost allocations == 0
{
  mut self.front.clear()
  mut self.back.clear()
}

public fn collections.Deque[Element].reserve(mut self, additional: UInt64)
  ensures self.length() == old(self.length())
{
  mut self.back.reserve(additional)
}

public fn collections.Deque[Element].rotate_left(mut self, by: UInt64)
  uses Panic unless by <= self.length()
  ensures self.length() == old(self.length())
{
  for _ in 0..by
    invariant self.length() == old(self.length())
  {
    match mut self.pop_front() {
      Some(item) => mut self.push_back(own item)
      None => {}
    }
  }
}

public fn collections.Deque[Element].rotate_right(mut self, by: UInt64)
  uses Panic unless by <= self.length()
  ensures self.length() == old(self.length())
{
  for _ in 0..by
    invariant self.length() == old(self.length())
  {
    match mut self.pop_back() {
      Some(item) => mut self.push_front(own item)
      None => {}
    }
  }
}

public fn collections.Deque[Element].to_list(own self) -> List[Element]
  ensures result.length() == self.length()
  cost time O(self.length())
{
  var items = own self.front
  mut items.reverse()
  mut items.append(own self.back)
  items
}

public fn collections.Deque[Element: Equal].contains(self, item: Element) -> Bool
  cost time O(self.length() * time(Element.equal))
{
  for index in 0..self.front.length() {
    if self.front[index] == item {
      return true
    }
  }
  for index in 0..self.back.length() {
    if self.back[index] == item {
      return true
    }
  }
  false
}

public fn collections.Deque[Element].extend[Source: Cursor[Element = Element]](mut self, items: own Source)
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  var cursor = own items
  while mut cursor.next() is Some(item)
    decreases cursor.remaining() when Source: FiniteCursor
  {
    mut self.push_back(own item)
  }
}

impl Index for collections.Deque[Element] {
  type Key = UInt64
  type Output = Element

  fn contains_key(self, key: UInt64) -> Bool
    ensures result == (key < self.length())
    cost time O(1)
    cost allocations == 0
  {
    key < self.length()
  }

  fn at(self, key: UInt64) lends Element
    requires key < self.length()
    cost time O(1)
    cost allocations == 0
  {
    if key < self.front.length() {
      self.front[self.front.length() - 1 - key]
    } else {
      self.back[key - self.front.length()]
    }
  }
}

impl IndexMut for collections.Deque[Element] {
  fn at(mut self, key: UInt64) lends mut Element
    requires key < self.length()
    cost time O(1)
    cost allocations == 0
  {
    if key < self.front.length() {
      mut self.front[self.front.length() - 1 - key]
    } else {
      mut self.back[key - self.front.length()]
    }
  }
}

impl Iterable for collections.Deque[Element] {
  type Element = Element

  fn count(self) -> UInt64
    ensures result == self.length()
    cost time O(1)
  {
    self.front.length() + self.back.length()
  }

  fn element(self, position: UInt64) lends Element
    requires position < self.count()
    cost time O(1)
  {
    self[position]
  }
}

impl IterableMut for collections.Deque[Element] {
  fn element(mut self, position: UInt64) lends mut Element
    requires position < self.count()
    ensures self.front.length() == old(self.front.length())
    ensures self.back.length() == old(self.back.length())
    cost time O(1)
  {
    if position < self.front.length() {
      mut self.front[self.front.length() - 1 - position]
    } else {
      mut self.back[position - self.front.length()]
    }
  }
}

impl IntoCursor for collections.Deque[Element] {
  type Cursor = list.ListCursor[Element]

  fn cursor(own self) -> list.ListCursor[Element]
    cost time O(self.length())
    cost amortized time O(self.length())
  {
    var items = own self.front
    mut items.reverse()
    mut items.append(own self.back)
    own items.cursor()
  }
}

impl Equal for collections.Deque[Element: Equal] {
  fn equal(self, other: collections.Deque[Element]) -> Bool
    ensures result == (self.length() == other.length()
      && forall i in 0..self.length() => self[i] == other[i])
    cost time O(self.length() * time(Element.equal))
    cost allocations == 0
  {
    if !(self.length() == other.length()) {
      return false
    }
    var index: UInt64 = 0
    while index < self.length()
      invariant index <= self.length()
      invariant forall i in 0..index => self[i] == other[i]
      decreases self.length() - index
      cost time O(index * time(Element.equal))
      cost allocations == 0
    {
      if !(self[index] == other[index]) {
        return false
      }
      index += 1
    }
    true
  }
}

fn hash_positions[Element: Hash](hasher: Hasher, deque: collections.Deque[Element], count: UInt64) -> Hasher
  requires count <= deque.length()
  ensures identical(result, if count == 0 {
      hasher
    } else {
      deque[count - 1].hash(hash_positions(hasher, deque: deque, count: count - 1))
    })
  decreases count
{
  if count == 0 {
    hasher
  } else {
    deque[count - 1].hash(hash_positions(hasher, deque: deque, count: count - 1))
  }
}

theorem positions_hash_alike[Element: Hash](
  hasher: Hasher,
  first: collections.Deque[Element],
  second: collections.Deque[Element],
  count: UInt64,
)
  requires count <= first.length()
  requires count <= second.length()
  requires forall i in 0..count => first[i] == second[i]
  ensures identical(hash_positions(hasher, deque: first, count: count), hash_positions(hasher, deque: second, count: count))
  decreases count
{
  if count > 0 {
    positions_hash_alike(hasher, first: first, second: second, count: count - 1)
  }
}

impl Hash for collections.Deque[Element: Hash] {
  fn hash(self, hasher: Hasher) -> Hasher
    ensures identical(result, hash_positions(self.length().hash(hasher), deque: self, count: self.length()))
    cost time O(self.length() * time(Element.hash))
    cost allocations == 0
  {
    let start = self.length().hash(hasher)
    var state = start
    for index in 0..self.length()
      invariant identical(state, hash_positions(start, deque: self, count: index))
      cost time O(index * time(Element.hash))
    {
      state = self[index].hash(state)
    }
    state
  }
}

proof Hash.agrees_with_equal for collections.Deque[Element: Hash] {
  positions_hash_alike(first.length().hash(hasher), first: first, second: second, count: first.length())
}

impl Default for collections.Deque[Element] {
  fn default() -> collections.Deque[Element]
    ensures result.length() == 0
    cost time O(1)
    cost allocations == 0
  {
    []
  }
}

impl FromElements for collections.Deque[Element] {
  type Element = Element

  fn from_elements(elements: own List[Element]) -> collections.Deque[Element]
    ensures result.length() == elements.length()
    cost time O(1)
    cost allocations == 0
  {
    collections.Deque(front: [], back: own elements)
  }
}
