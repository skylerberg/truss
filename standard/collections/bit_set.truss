use standard::collections
use standard::intrinsic

fn word_count(length: USize) -> USize
  ensures result == length / 64 + (if length % 64 == 0 { 0 } else { 1 })
  cost time O(1)
  cost allocations == 0
{
  length / 64 + (if length % 64 == 0 { 0 } else { 1 })
}

fn used_bits(length: USize) -> UInt64
  ensures length % 64 == 0 ==> result == UInt64.maximum
  ensures length % 64 != 0 ==> result == power(2, length % 64) - 1
  cost time O(1)
  cost allocations == 0
{
  let used = length % 64
  let one: UInt64 = 1
  proof {
    assert power(2, used) <= power(2, 63)
  }
  if used == 0 { UInt64.maximum } else { (one << used) - 1 }
}

theorem ones_fit_below_the_bit_length(word: UInt64, bits: USize)
  requires bits < 64
  requires word < power(2, bits)
  ensures word.count_ones() <= bits
  cost time finite
{
}

theorem lowest_one_is_below_the_bit_length(word: UInt64, bits: USize)
  requires bits <= 64
  requires word != 0
  requires bits == 64 || word < power(2, bits)
  ensures word.trailing_zeros() < bits
  cost time finite
{
}

theorem all_ones_below_a_bit_are_counted(word: UInt64, bits: USize)
  requires bits <= 64
  requires word == power(2, bits) - 1
  ensures word.count_ones() == bits
  cost time finite
{
  assert power(2, bits) <= power(2, 64)
}

fn zero_words(count: USize) -> List[UInt64]
  ensures result.length() == count
  ensures forall i in 0..count => result.model()[i] == 0
  cost time O(count)
{
  var words: intrinsic::Storage[UInt64] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(words) == index
    invariant intrinsic::storage_capacity(words) == count
    invariant forall i in 0..index => intrinsic::storage_model(words)[i] == 0
  {
    intrinsic::storage_push(mut words, value: 0)
  }
  List(storage: own words)
}

fn fill_words(words: mut List[UInt64], value: UInt64)
  ensures words.length() == old(words.length())
  cost time O(words.length())
  cost allocations == 0
{
  var index: USize = 0
  while index < words.length()
    invariant index <= words.length()
    invariant words.length() == old(words.length())
    decreases words.length() - index
    cost time O(index)
    cost allocations == 0
  {
    words[index] = value
    index += 1
  }
}

fn copy_words(words: mut List[UInt64], source: List[UInt64], count: USize)
  requires count <= words.length()
  requires count <= source.length()
  ensures words.length() == old(words.length())
  cost time O(count)
  cost allocations == 0
{
  var index: USize = 0
  while index < count
    invariant index <= count
    invariant words.length() == old(words.length())
    decreases count - index
    cost time O(index)
    cost allocations == 0
  {
    words[index] = source[index]
    index += 1
  }
}

type Combination = Union | Intersection | Difference

fn combined(word: UInt64, other: UInt64, how: Combination) -> UInt64
  cost time O(1)
  cost allocations == 0
{
  match how {
    Union => word | other
    Intersection => word & other
    Difference => word & ~other
  }
}

fn combine_words(words: mut Slice[UInt64], other: Slice[UInt64], how: Combination)
  requires other.length() == words.length()
  ensures words.length() == old(words.length())
  cost time O(words.length())
  cost allocations == 0
{
  var index: USize = 0
  while index < words.length()
    invariant index <= words.length()
    invariant words.length() == old(words.length())
    decreases words.length() - index
    cost time O(index)
    cost allocations == 0
  {
    words[index] = combined(words[index], other: other[index], how: how)
    index += 1
  }
}

fn invert_words(words: mut List[UInt64])
  ensures words.length() == old(words.length())
  cost time O(words.length())
  cost allocations == 0
{
  var index: USize = 0
  while index < words.length()
    invariant index <= words.length()
    invariant words.length() == old(words.length())
    decreases words.length() - index
    cost time O(index)
    cost allocations == 0
  {
    words[index] = ~words[index]
    index += 1
  }
}

fn clear_unused_bits(words: mut List[UInt64], length: USize)
  requires words.length() == word_count(length)
  ensures words.length() == old(words.length())
  ensures length % 64 == 0 || words[words.length() - 1] < power(2, length % 64)
  cost time O(1)
  cost allocations == 0
{
  if length % 64 != 0 {
    let last = words.length() - 1
    words[last] = words[last] & used_bits(length)
  }
}

public fn collections::BitSet.new(length: USize) -> collections::BitSet
  ensures result.length() == length
  ensures result.count_ones() == 0
  cost time O(length)
{
  collections::BitSet(words: zero_words(word_count(length)), length: length)
}

public fn collections::BitSet.length(self) -> USize
  cost time O(1)
{
  self.length
}

public fn collections::BitSet.is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length == 0
}

internal fn collections::BitSet.bit(self, index: USize) -> Bool
  requires index < self.length
  cost time O(1)
  cost allocations == 0
{
  ((self.words[index / 64] >> (index % 64)) & 1) == 1
}

internal fn collections::BitSet.assign_bit(mut self, index: USize, value: Bool)
  requires index < self.length
  ensures self.length == old(self.length)
  cost time O(1)
  cost allocations == 0
{
  let one: UInt64 = 1
  let bit = one << (index % 64)
  let word = self.words[index / 64]
  self.words[index / 64] = if value { word | bit } else { word & ~bit }
}

public fn collections::BitSet.get(self, index: USize) -> Option[Bool]
  ensures (result is Some(_)) == (index < self.length())
  cost time O(1)
{
  if index < self.length { Some(self.bit(index)) } else { None }
}

public fn collections::BitSet.flip(mut self, index: USize)
  requires index < self.length()
  ensures self.length() == old(self.length())
  cost time O(1)
  cost allocations == 0
{
  let one: UInt64 = 1
  self.words[index / 64] = self.words[index / 64] ^ (one << (index % 64))
}

public fn collections::BitSet.fill(mut self, value: Bool)
  ensures self.length() == old(self.length())
  cost time O(self.length())
  cost allocations == 0
{
  fill_words(mut self.words, value: if value { UInt64.maximum } else { 0 })
  clear_unused_bits(mut self.words, length: self.length)
}

public fn collections::BitSet.resize(mut self, length: USize)
  ensures self.length() == length
  cost time O(length)
{
  let count = word_count(length)
  var words = zero_words(count)
  copy_words(mut words, source: self.words, count: if count < self.words.length() { count } else { self.words.length() })
  clear_unused_bits(mut words, length: length)
  self = collections::BitSet(words: own words, length: length)
}

public fn collections::BitSet.count_ones(self) -> USize
  ensures result <= self.length()
  ensures (forall i in 0..self.words.length() => self.words.model()[i] == 0) ==> result == 0
  ensures ((forall i in 0..self.length / 64 => self.words.model()[i] == UInt64.maximum)
    && (self.length % 64 == 0 || self.words.model()[self.length / 64] == power(2, self.length % 64) - 1))
    ==> result == self.length
  cost time O(self.length())
{
  let full = self.length / 64
  var count: USize = 0
  var index: USize = 0
  while index < full
    invariant index <= full
    invariant count <= 64 * index
    invariant (forall i in 0..index => self.words.model()[i] == 0) ==> count == 0
    invariant (forall i in 0..index => self.words.model()[i] == UInt64.maximum) ==> count == 64 * index
    decreases full - index
    cost time O(index)
  {
    proof {
      if self.words[index] == UInt64.maximum {
        all_ones_below_a_bit_are_counted(self.words[index], bits: 64)
      }
    }
    count += self.words[index].count_ones()
    index += 1
  }
  if self.length % 64 != 0 {
    proof {
      ones_fit_below_the_bit_length(self.words[full], bits: self.length % 64)
      if self.words[full] == used_bits(self.length) {
        all_ones_below_a_bit_are_counted(self.words[full], bits: self.length % 64)
      }
    }
    count += self.words[full].count_ones()
  }
  count
}

public fn collections::BitSet.count_zeros(self) -> USize
  ensures result <= self.length()
  ensures result == self.length() - self.count_ones()
  cost time O(self.length())
{
  self.length - self.count_ones()
}

public fn collections::BitSet.first_one(self) -> Option[USize]
  ensures match result {
    Some(index) => index < self.length()
    None => self.count_ones() == 0
  }
  cost time O(self.length())
{
  var index: USize = 0
  while index < self.words.length() && self.words[index] == 0
    invariant index <= self.words.length()
    invariant forall i in 0..index => self.words.model()[i] == 0
    decreases self.words.length() - index
    cost time O(index)
  {
    index += 1
  }
  if index == self.words.length() {
    return None
  }
  proof {
    if index == self.length / 64 {
      lowest_one_is_below_the_bit_length(self.words[index], bits: self.length % 64)
    } else {
      lowest_one_is_below_the_bit_length(self.words[index], bits: 64)
    }
  }
  Some(index * 64 + self.words[index].trailing_zeros())
}

public fn collections::BitSet.first_zero(self) -> Option[USize]
  ensures match result {
    Some(index) => index < self.length()
    None => self.count_zeros() == 0
  }
  cost time O(self.length())
{
  let full = self.length / 64
  var index: USize = 0
  while index < full && self.words[index] == UInt64.maximum
    invariant index <= full
    invariant forall i in 0..index => self.words.model()[i] == UInt64.maximum
    decreases full - index
    cost time O(index)
  {
    index += 1
  }
  if index < full {
    let zeros = UInt64.maximum - self.words[index]
    proof {
      lowest_one_is_below_the_bit_length(zeros, bits: 64)
    }
    return Some(index * 64 + zeros.trailing_zeros())
  }
  if self.length % 64 == 0 {
    return None
  }
  let zeros = used_bits(self.length) - self.words[full]
  if zeros == 0 {
    return None
  }
  proof {
    lowest_one_is_below_the_bit_length(zeros, bits: self.length % 64)
  }
  Some(full * 64 + zeros.trailing_zeros())
}

public fn collections::BitSet.ones(self) yields USize
  ensures result < self.length()
  cost time O(self.length())
{
  var index: USize = 0
  while index < self.words.length()
    invariant index <= self.words.length()
    decreases self.words.length() - index
    cost time O(index)
  {
    var rest = self.words[index]
    var remaining = rest.count_ones()
    while remaining > 0 && rest != 0
      invariant rest <= self.words.model()[index]
      invariant remaining <= 64
      decreases remaining
      cost time O(64 - remaining)
    {
      proof {
        if index == self.length / 64 {
          lowest_one_is_below_the_bit_length(rest, bits: self.length % 64)
        } else {
          lowest_one_is_below_the_bit_length(rest, bits: 64)
        }
      }
      yield index * 64 + rest.trailing_zeros()
      rest = rest & (rest - 1)
      remaining -= 1
    }
    index += 1
  }
}

internal fn collections::BitSet.combine(mut self, other: collections::BitSet, how: Combination)
  requires other.length == self.length
  ensures self.length == old(self.length)
  cost time O(self.length)
  cost allocations == 0
{
  let count = self.words.length()
  if count > 0 {
    let last = count - 1
    combine_words(mut self.words[..last], other: other.words[..last], how: how)
    self.words[last] = combined(self.words[last], other: other.words[last], how: how)
  }
}

public fn collections::BitSet.union_with(mut self, other: collections::BitSet)
  requires other.length() == self.length()
  ensures self.length() == old(self.length())
  cost time O(self.length())
  cost allocations == 0
{
  mut self.combine(other, how: Combination.Union)
}

public fn collections::BitSet.intersect_with(mut self, other: collections::BitSet)
  requires other.length() == self.length()
  ensures self.length() == old(self.length())
  cost time O(self.length())
  cost allocations == 0
{
  mut self.combine(other, how: Combination.Intersection)
}

public fn collections::BitSet.difference_with(mut self, other: collections::BitSet)
  requires other.length() == self.length()
  ensures self.length() == old(self.length())
  cost time O(self.length())
  cost allocations == 0
{
  mut self.combine(other, how: Combination.Difference)
}

public fn collections::BitSet.complement(mut self)
  ensures self.length() == old(self.length())
  cost time O(self.length())
  cost allocations == 0
{
  invert_words(mut self.words)
  clear_unused_bits(mut self.words, length: self.length)
}

impl Index for collections::BitSet {
  type Key = USize
  type Output = Bool

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
  {
    key < self.length()
  }

  fn at(self, key: USize) lends Bool
    requires key < self.length()
    cost time O(1)
  {
    let value = self.bit(key)
    yield value
  }

  fn at(mut self, key: USize) lends mut Bool
    requires key < self.length()
    cost time O(1)
  {
    var value = self.bit(key)
    yield mut value
    mut self.assign_bit(key, value: value)
  }
}

impl Iterable for collections::BitSet {
  type Element = Bool

  fn each(self) yields Bool
    ensures finished ==> yielded.length() == self.length()
    cost time O(self.length())
  {
    var index: USize = 0
    while index < self.length
      invariant index <= self.length
      invariant yielded.length() == index
      decreases self.length - index
      cost time O(index)
    {
      yield self.bit(index)
      index += 1
    }
  }
}

impl Equal for collections::BitSet {
  fn equal(self, other: collections::BitSet) -> Bool {
    self.length == other.length && self.words == other.words
  }
}

impl Hash for collections::BitSet {
  fn hash(self, hasher: mut Hasher) {
    self.length.hash(mut hasher)
    self.words.hash(mut hasher)
  }
}

fn positions(bits: collections::BitSet) -> List[USize] {
  var set_positions: List[USize] = []
  for position in bits.ones() {
    mut set_positions.push(position)
  }
  set_positions
}

fn with_ones(length: USize, ones: Slice[USize]) -> collections::BitSet {
  var bits = collections::BitSet.new(length)
  for position in ones {
    mut bits.flip(position)
  }
  bits
}

test "a new bit set holds only zeros" {
  let bits = collections::BitSet.new(130)
  assert bits.length() == 130 && !bits.is_empty()
  assert bits.count_ones() == 0 && bits.count_zeros() == 130
  assert bits.first_one() is None && bits.first_zero() == Some(0)
  assert bits.get(129) == Some(false) && bits.get(130) is None
  let none = collections::BitSet.new(0)
  assert none.is_empty() && none.count_ones() == 0 && none.count_zeros() == 0
  assert none.first_one() is None && none.first_zero() is None && none.get(0) is None
}

test "a bit is read, flipped, and assigned by its position" {
  var bits = collections::BitSet.new(130)
  mut bits.flip(0)
  mut bits.flip(63)
  mut bits.flip(64)
  mut bits.flip(129)
  assert bits[0] && bits[63] && bits[64] && bits[129] && !bits[1] && !bits[128]
  assert bits.count_ones() == 4 && bits.count_zeros() == 126
  assert positions(bits) == [0, 63, 64, 129]
  mut bits.flip(63)
  assert !bits[63] && bits.count_ones() == 3
  bits[5] = true
  bits[0] = false
  bits[64] = true
  assert positions(bits) == [5, 64, 129]
  assert bits.first_one() == Some(5) && bits.first_zero() == Some(0)
}

test "the first one and the first zero are found in any word" {
  var bits = collections::BitSet.new(200)
  mut bits.flip(199)
  assert bits.first_one() == Some(199)
  mut bits.fill(true)
  assert bits.count_ones() == 200 && bits.count_zeros() == 0
  assert bits.first_zero() is None && bits.first_one() == Some(0)
  mut bits.flip(70)
  assert bits.first_zero() == Some(70)
  mut bits.flip(70)
  mut bits.flip(199)
  assert bits.first_zero() == Some(199)
  var whole = collections::BitSet.new(128)
  mut whole.fill(true)
  assert whole.first_zero() is None && whole.count_ones() == 128
  mut whole.fill(false)
  assert whole.first_one() is None && whole.count_ones() == 0
}

test "a bit set is resized with zeros in the new positions" {
  var bits = collections::BitSet.new(70)
  mut bits.fill(true)
  mut bits.resize(200)
  assert bits.length() == 200 && bits.count_ones() == 70 && bits.first_zero() == Some(70)
  mut bits.resize(10)
  assert bits.length() == 10 && bits.count_ones() == 10
  mut bits.resize(64)
  assert bits.count_ones() == 10 && bits.first_zero() == Some(10)
  mut bits.resize(0)
  assert bits.is_empty() && bits.count_ones() == 0
}

test "two bit sets are united, intersected, subtracted, and inverted" {
  let left = with_ones(100, ones: [1, 2, 3, 70, 99].slice())
  let right = with_ones(100, ones: [2, 3, 4, 71, 99].slice())
  var union = left.copy()
  mut union.union_with(right)
  assert positions(union) == [1, 2, 3, 4, 70, 71, 99]
  var intersection = left.copy()
  mut intersection.intersect_with(right)
  assert positions(intersection) == [2, 3, 99]
  var difference = left.copy()
  mut difference.difference_with(right)
  assert positions(difference) == [1, 70]
  var inverse = left.copy()
  mut inverse.complement()
  assert inverse.count_ones() == 95 && !inverse[1] && inverse[0] && inverse[98] && !inverse[99]
  mut inverse.complement()
  assert inverse == left
}

test "a bit set gives each bit in order and is equal to a set with the same bits" {
  let bits = with_ones(5, ones: [1, 4].slice())
  var values: List[Bool] = []
  for value in bits {
    mut values.push(value)
  }
  assert values == [false, true, false, false, true]
  assert bits == with_ones(5, ones: [4, 1].slice())
  assert bits != with_ones(6, ones: [1, 4].slice())
  assert bits != with_ones(5, ones: [1].slice())
  var shrunk = with_ones(70, ones: [1, 4, 69].slice())
  mut shrunk.resize(5)
  assert shrunk == bits
  var first = Hasher.new()
  var second = Hasher.new()
  bits.hash(mut first)
  shrunk.hash(mut second)
  assert first.finish() == second.finish()
}
