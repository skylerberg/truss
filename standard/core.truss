public trait Countable: Ordered + Plain {
  fn successor(self) -> Option[Self]
    cost time O(1)

  fn predecessor(self) -> Option[Self]
    cost time O(1)

  fn advanced(self, by: USize) -> Option[Self]
    cost time O(1)

  fn retreated(self, by: USize) -> Option[Self]
    cost time O(1)

  fn steps_to(self, other: Self) -> Option[USize]
    cost time O(1)
}

public type Range[Value](start: Value, stop: Value, inclusive: Bool)

public type Indexed[Element](index: USize, element: Element)

public type Pair[First, Second](first: First, second: Second)

public type ExitCode(code: UInt8)

public let ExitCode.success: ExitCode = ExitCode(0)

public let ExitCode.failure: ExitCode = ExitCode(1)

impl Equal for Bool {
  fn equal(self, other: Bool) -> Bool {
    intrinsic::equal(self, right: other)
  }
}

impl Hash for Bool {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write(if self { 1 } else { 0 })
  }
}

impl Equal for Character {
  fn equal(self, other: Character) -> Bool {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for Character {
  fn compare(self, other: Character) -> Ordering {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Hash for Character {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write(intrinsic::convert(self))
  }
}

impl Equal for Unit {
  fn equal(self, other: Unit) -> Bool {
    true
  }
}

public type ConversionError()
  derives Equal

impl Display for ConversionError {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("the value does not fit the type")
  }
}

public type ParseIntegerError =
  | Empty
  | InvalidDigit(offset: USize)
  | OutOfRange
  derives Equal

impl Display for ParseIntegerError {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Empty => mut output.write("the text has no digits")
      InvalidDigit(offset) => {
        mut output.write("the byte at offset ")
        offset.display(mut output)
        mut output.write(" is not a digit")
      }
      OutOfRange => mut output.write("the number does not fit the type")
    }
  }
}

public type ParseFloatError =
  | Empty
  | Invalid(offset: USize)
  derives Equal

impl Display for ParseFloatError {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Empty => mut output.write("the text is empty")
      Invalid(offset) => {
        mut output.write("the byte at offset ")
        offset.display(mut output)
        mut output.write(" is not part of a number")
      }
    }
  }
}

impl Display for Bool {
  fn display(self, output: mut TextBuilder) {
    if self { mut output.write("true") } else { mut output.write("false") }
  }
}

impl Display for Character {
  fn display(self, output: mut TextBuilder) {
    mut output.write_character(self)
  }
}
