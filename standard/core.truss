use standard::cursors
use standard::intrinsic

public type Ordering = Less | Equal | Greater
  derives Equal

public fn Ordering.reversed(self) -> Ordering
  cost time O(1)
{
  match self {
    Less => Ordering.Greater
    Equal => Ordering.Equal
    Greater => Ordering.Less
  }
}

public fn Ordering.then(self, next: Ordering) -> Ordering
  cost time O(1)
{
  if self == Ordering.Equal { next } else { self }
}

public trait Equal {
  fn equal(self, other: Self) -> Bool

  fn not_equal(self, other: Self) -> Bool {
    !self.equal(other)
  }
}

public trait Ordered: Equal {
  fn compare(self, other: Self) -> Ordering

  fn max(own self, other: own Self) -> Self {
    if self.compare(other) == Ordering.Less { other } else { self }
  }

  fn min(own self, other: own Self) -> Self {
    if self.compare(other) == Ordering.Greater { other } else { self }
  }

  fn clamp(own self, low: own Self, high: own Self) -> Self
    requires low <= high
  {
    if self.compare(low) == Ordering.Less {
      low
    } else if self.compare(high) == Ordering.Greater {
      high
    } else {
      self
    }
  }
}

public trait Hash: Equal {
  fn hash(self, hasher: mut Hasher)
}

public opaque type Hasher(state: UInt64)
  derives Plain

public fn Hasher.new() -> Hasher {
  Hasher(state: 14695981039346656037)
}

public fn Hasher.write(mut self, value: UInt64) {
  self.state = intrinsic::wrapping_multiply(intrinsic::bit_xor(self.state, right: value), right: 1099511628211)
}

public fn Hasher.write_bytes(mut self, bytes: Slice[UInt8])
  cost time O(bytes.length())
{
  todo
}

public fn Hasher.finish(self) -> UInt64 {
  self.state
}

public trait Default {
  fn default() -> Self
}

public trait Display {
  fn display(self, output: mut TextBuilder)
}

public trait From[Source] {
  fn from(value: own Source) -> Self
}

public trait TryFrom[Source] {
  type Error
  fn try_from(value: own Source) -> Result[Self, Self.Error]
}

public trait Copyable {
  fn copy(self) -> Self
}

public trait Plain: Copyable {}

public trait Add[Right] {
  type Output
  fn add(self, right: Right) -> Self.Output
}

public trait Subtract[Right] {
  type Output
  fn subtract(self, right: Right) -> Self.Output
}

public trait Multiply[Right] {
  type Output
  fn multiply(self, right: Right) -> Self.Output
}

public trait Divide[Right] {
  type Output
  fn divide(self, right: Right) -> Self.Output
}

public trait Remainder[Right] {
  type Output
  fn remainder(self, right: Right) -> Self.Output
}

public trait Negate {
  type Output
  fn negate(self) -> Self.Output
}

public trait Model {
  type Value

  fn model(self) -> Self.Value
    cost time finite
}

public trait Index {
  type Key
  type Output
  fn at(self, key: Self.Key) lends Self.Output
  fn at(mut self, key: Self.Key) lends mut Self.Output
}

public trait Iterable {
  type Element

  fn each(self) yields Self.Element
    cost time finite

  fn fold[Total, capability Granted](
    self,
    initial: own Total,
    combine: (fn(own Total, Self.Element) -> Total uses Granted cost time finite),
  ) -> Total
    uses Granted
    cost time finite
  {
    todo
  }

  fn map[Output, capability Granted](
    self,
    transform: (fn(Self.Element) -> Output uses Granted cost time finite),
  ) -> List[Output]
    uses Granted
    cost time finite
  {
    var results: List[Output] = []
    for item in self {
      mut results.push(transform(item))
    }
    results
  }

  fn filter_map[Output, capability Granted](
    self,
    transform: (fn(Self.Element) -> Option[Output] uses Granted cost time finite),
  ) -> List[Output]
    uses Granted
    cost time finite
  {
    todo
  }

  fn flat_map[Output, capability Granted](
    self,
    transform: (fn(Self.Element) -> List[Output] uses Granted cost time finite),
  ) -> List[Output]
    uses Granted
    cost time finite
  {
    todo
  }

  fn count(self, matching: (fn(Self.Element) -> Bool cost time finite)) -> USize
    cost time finite
  {
    todo
  }

  fn find(self, matching: (fn(Self.Element) -> Bool cost time finite)) lends Option[Self.Element]
    cost time finite
  {
    todo
  }

  fn min_by(
    self,
    compare: (fn(Self.Element, Self.Element) -> Ordering cost time finite),
  ) lends Option[Self.Element]
    cost time finite
  {
    todo
  }

  fn max_by(
    self,
    compare: (fn(Self.Element, Self.Element) -> Ordering cost time finite),
  ) lends Option[Self.Element]
    cost time finite
  {
    todo
  }
}

