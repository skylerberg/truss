impl Display for Bool {
  fn display(self, output: mut TextBuilder) {
    if self { mut output.write("true") } else { mut output.write("false") }
  }
}

impl Display for Character {
  fn display(self, output: mut TextBuilder) {
    mut output.write_character(self)
  }
}
