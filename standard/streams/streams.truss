use standard.console
use standard.files
use standard.intrinsic
use standard.map
use standard.network
use standard.processes

public opaque type Handle(descriptor: intrinsic.Handle, number: UInt64)

public fn Handle.simulated(number: UInt64) -> Handle
  ensures result.number() == number
{
  Handle(descriptor: intrinsic.handle_from(-1), number: number)
}

public fn Handle.number(self) -> UInt64
  ensures result == (self.number)
  cost time O(1)
{
  self.number
}

public type Position =
  | FromStart(offset: UInt64)
  | FromCurrent(offset: Int64)
  | FromEnd(offset: Int64)
  derives Equal

public trait Reader {
  fn read(mut self, buffer: mut List[UInt8], limit: UInt64) -> Result[UInt64, SystemError]
    uses Handles
    ensures !(result is Ok(count) && (count > limit || buffer.length() != old(buffer.length()) + count))
    ensures !(result is Err(_) && buffer.length() != old(buffer.length()))

  fn read_to_end(mut self, buffer: mut List[UInt8]) -> Result[UInt64, SystemError]
    uses Handles, RunForever
  {
    let start = buffer.length()
    var more = true
    while more
      invariant buffer.length() >= start
    {
      let count = mut self.read(mut buffer, limit: 65536)?
      more = count > 0
    }
    Ok(buffer.length() - start)
  }

  fn read_exactly(mut self, buffer: mut List[UInt8], count: UInt64) -> Result[Unit, SystemError]
    uses Handles
  {
    var left = count
    while left > 0
      invariant left <= count
    {
      let got = mut self.read(mut buffer, limit: left)?
      if got == 0 {
        return Err(SystemError.UnexpectedEnd)
      }
      left -= got
    }
    Ok(Unit)
  }

  fn read_text(mut self) -> Result[String, SystemError]
    uses Handles, RunForever
  {
    var bytes: List[UInt8] = []
    let _ = mut self.read_to_end(mut bytes)?
    match String.from_utf8(own bytes) {
      Ok(text) => Ok(own text)
      Err(_) => Err(SystemError.InvalidData)
    }
  }

  fn skip(mut self, count: UInt64) -> Result[UInt64, SystemError]
    uses Handles, RunForever
  {
    var scratch: List[UInt8] = []
    var skipped: UInt64 = 0
    var more = true
    while more && skipped < count
      invariant skipped <= count
    {
      let left = count - skipped
      let limit: UInt64 = if left > 65536 { 65536 } else { left }
      let got = mut self.read(mut scratch, limit: limit)?
      skipped += got
      mut scratch.clear()
      more = got > 0
    }
    Ok(skipped)
  }
}

public trait Writer {
  fn write(mut self, bytes: List[UInt8]) -> Result[UInt64, SystemError]
    uses Handles
    ensures !(result is Ok(count) && count > bytes.length())

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles

  fn write_all(mut self, bytes: List[UInt8]) -> Result[Unit, SystemError]
    uses Handles
  {
    var written: UInt64 = 0
    while written < bytes.length()
      invariant written <= bytes.length()
    {
      let count = mut self.write(bytes[written..])?
      if count == 0 {
        return Err(SystemError.NothingWritten)
      }
      written += count
    }
    Ok(Unit)
  }

  fn write_text(mut self, text: String) -> Result[Unit, SystemError]
    uses Handles
  {
    mut self.write_all(text.bytes())
  }
}

public trait Duplex {
  fn receive(self, buffer: mut List[UInt8], limit: UInt64) -> Result[UInt64, SystemError]
    uses Handles, Tasks, RunForever
    ensures !(result is Ok(count) && (count > limit || buffer.length() != old(buffer.length()) + count))
    ensures !(result is Err(_) && buffer.length() != old(buffer.length()))

  fn send(self, bytes: List[UInt8]) -> Result[UInt64, SystemError]
    uses Handles, Tasks, RunForever
    ensures !(result is Ok(count) && count > bytes.length())

  fn close_sending(self) -> Result[Unit, SystemError]
    uses Handles, Tasks, RunForever

  fn send_all(self, bytes: List[UInt8]) -> Result[Unit, SystemError]
    uses Handles, Tasks, RunForever
  {
    var sent: UInt64 = 0
    while sent < bytes.length()
      invariant sent <= bytes.length()
    {
      let count = self.send(bytes[sent..])?
      if count == 0 {
        return Err(SystemError.NothingWritten)
      }
      sent += count
    }
    Ok(Unit)
  }

  fn receive_exactly(self, buffer: mut List[UInt8], count: UInt64) -> Result[Unit, SystemError]
    uses Handles, Tasks, RunForever
  {
    var left = count
    while left > 0
      invariant left <= count
    {
      let got = self.receive(mut buffer, limit: left)?
      if got == 0 {
        return Err(SystemError.UnexpectedEnd)
      }
      left -= got
    }
    Ok(Unit)
  }

  fn receive_to_end(self, buffer: mut List[UInt8]) -> Result[UInt64, SystemError]
    uses Handles, Tasks, RunForever
  {
    let start = buffer.length()
    var more = true
    while more
      invariant buffer.length() >= start
    {
      let count = self.receive(mut buffer, limit: 65536)?
      more = count > 0
    }
    Ok(buffer.length() - start)
  }
}

public trait Seek {
  fn seek(mut self, to: Position) -> Result[UInt64, SystemError]
    uses Handles

  fn position(mut self) -> Result[UInt64, SystemError]
    uses Handles
  {
    mut self.seek(Position.FromCurrent(offset: 0))
  }
}

public opaque type ByteReader(bytes: view List[UInt8], position: UInt64)
  invariant position <= bytes.length()

public fn ByteReader.new(bytes: List[UInt8]) -> ByteReader
  cost time O(1)
{
  ByteReader(bytes: bytes, position: 0)
}

public fn ByteReader.remaining(self) -> view List[UInt8]
  ensures result.length() == self.bytes.length() - self.position
  cost time O(1)
{
  self.bytes[self.position..]
}

impl Reader for ByteReader {
  fn read(mut self, buffer: mut List[UInt8], limit: UInt64) -> Result[UInt64, SystemError] {
    let left = self.bytes.length() - self.position
    let count = if limit < left { limit } else { left }
    mut buffer.append_items(self.bytes[self.position..self.position + count])
    self.position += count
    Ok(count)
  }
}

public opaque type ByteWriter(bytes: List[UInt8])

public fn ByteWriter.new() -> ByteWriter
  cost time O(1)
{
  ByteWriter(bytes: [])
}

public fn ByteWriter.written(self) -> view List[UInt8]
  cost time O(1)
{
  self.bytes
}

public fn ByteWriter.finish(own self) -> List[UInt8]
  cost time O(1)
{
  self.bytes
}

impl Writer for ByteWriter {
  fn write(mut self, bytes: List[UInt8]) -> Result[UInt64, SystemError] {
    mut self.bytes.append_items(bytes)
    Ok(bytes.length())
  }

  fn flush(mut self) -> Result[Unit, SystemError] {
    Ok(Unit)
  }
}

public opaque type ByteQueue(storage: List[UInt8], start: UInt64)
  invariant start <= storage.length()
  cost potential 4 * start

public fn ByteQueue.length(self) -> UInt64
  ensures result == self.storage.length() - self.start
  cost time O(1)
  cost allocations == 0
{
  self.storage.length() - self.start
}

public fn ByteQueue.is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
  cost allocations == 0
{
  self.length() == 0
}

public fn ByteQueue.bytes(self) -> view List[UInt8]
  ensures result.length() == self.length()
  cost time O(1)
  cost allocations == 0
{
  self.storage[self.start..]
}

public fn ByteQueue.take(mut self, count: UInt64) -> List[UInt8]
  uses Panic unless count <= self.length()
  ensures result.length() == count
  ensures self.length() == old(self.length()) - count
  cost time O(count)
  cost amortized time O(count)
  cost allocations <= 1
{
  if count > self.length() {
    Panic.crash("the queue holds fewer bytes")
  }
  let taken = self.storage[self.start..self.start + count].copy()
  self.start += count
  taken
}

public fn ByteQueue.take_all(mut self) -> List[UInt8]
  ensures result.length() == old(self.length())
  ensures self.length() == 0
  cost time O(old(self.length()))
  cost amortized time O(old(self.length()))
  cost allocations <= 1
{
  if self.start == 0 {
    return map.exchange(mut self.storage, value: [])
  }
  let taken = self.storage[self.start..].copy()
  self.start = self.storage.length()
  taken
}

public fn ByteQueue.skip(mut self, count: UInt64)
  uses Panic unless count <= self.length()
  ensures self.length() == old(self.length()) - count
  cost time O(1)
  cost amortized time O(count)
  cost allocations == 0
{
  if count > self.length() {
    Panic.crash("the queue holds fewer bytes")
  }
  self.start += count
}

public fn ByteQueue.clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.storage.length()))
  cost allocations == 0
{
  mut self.storage.clear()
  self.start = 0
}

fn compact(queue: mut ByteQueue)
  ensures queue.length() == old(queue.length())
  cost time O(old(queue.storage.length()))
  cost amortized time O(1)
  cost allocations == 0
{
  if queue.start > 0 && queue.start >= queue.storage.length() - queue.start {
    mut queue.storage.remove_range(0..queue.start)
    queue.start = 0
  }
}

public fn ByteQueue.append(mut self, bytes: List[UInt8])
  ensures self.length() == old(self.length()) + bytes.length()
  cost amortized time O(bytes.length())
{
  compact(mut self)
  mut self.storage.append_items(bytes)
}

public fn ByteQueue.append_list(mut self, bytes: own List[UInt8])
  ensures self.length() == old(self.length()) + bytes.length()
  cost amortized time O(bytes.length())
{
  if self.is_empty() {
    self.storage = own bytes
    self.start = 0
  } else {
    mut self.append(bytes)
  }
}

public fn ByteQueue.receive_from[Stream: Duplex](mut self, stream: Stream, limit: UInt64) -> Result[UInt64, SystemError]
  uses Handles, Tasks, RunForever
  ensures !(result is Ok(count) && (count > limit || self.length() != old(self.length()) + count))
  ensures !(result is Err(_) && self.length() != old(self.length()))
{
  compact(mut self)
  stream.receive(mut self.storage, limit: limit)
}

public fn ByteQueue.read_from[Source: Reader](mut self, source: mut Source, limit: UInt64) -> Result[UInt64, SystemError]
  uses Handles
  ensures !(result is Ok(count) && (count > limit || self.length() != old(self.length()) + count))
  ensures !(result is Err(_) && self.length() != old(self.length()))
{
  compact(mut self)
  mut source.read(mut self.storage, limit: limit)
}

impl FromElements for ByteQueue {
  type Element = UInt8

  fn from_elements(elements: own List[UInt8]) -> ByteQueue
    ensures result.length() == elements.length()
    cost time O(1)
    cost allocations == 0
  {
    ByteQueue(storage: own elements, start: 0)
  }
}

public opaque type BufferedReader[Source: Reader](source: Source, pending: ByteQueue, capacity: UInt64)
  invariant capacity > 0

public fn BufferedReader[Source: Reader].new(source: own Source, capacity: UInt64 = 65536) -> BufferedReader[Source] {
  BufferedReader(source: own source, pending: [], capacity: if capacity == 0 { 1 } else { capacity })
}

internal fn BufferedReader[Source: Reader].fill(mut self) -> Result[UInt64, SystemError]
  uses Handles
  ensures !(result is Ok(count) && self.pending.length() != old(self.pending.length()) + count)
{
  mut self.pending.read_from(mut self.source, limit: self.capacity)
}

public fn BufferedReader[Source: Reader].read_until(
  mut self,
  delimiter: UInt8,
  buffer: mut List[UInt8],
  limit: UInt64 = UInt64.maximum,
) -> Result[UInt64, SystemError]
  uses Handles, RunForever
  ensures !(result is Ok(count) && count > limit)
{
  var consumed: UInt64 = 0
  var more = true
  while more
    invariant self.capacity > 0
    invariant consumed <= limit
  {
    let unread = self.pending.bytes()
    var index: UInt64 = 0
    var at_delimiter = false
    let room = limit - consumed
    while index < unread.length() && !at_delimiter && index < room
      invariant index <= unread.length()
      invariant index <= room
      decreases unread.length() - index + (if at_delimiter { 0 } else { 1 })
    {
      at_delimiter = unread[index] == delimiter
      index += 1
    }
    mut buffer.append_items(unread[..index])
    mut self.pending.skip(index)
    consumed += index
    if at_delimiter || consumed == limit {
      more = false
    } else {
      let count = mut self.fill()?
      more = count > 0
    }
  }
  Ok(consumed)
}

public fn BufferedReader[Source: Reader].read_line(mut self) -> Result[Option[String], SystemError]
  uses Handles, RunForever
{
  var bytes: List[UInt8] = []
  let count = mut self.read_until(10, buffer: mut bytes)?
  if count == 0 {
    return Ok(None)
  }
  if bytes.length() > 0 && bytes[bytes.length() - 1] == 10 {
    mut bytes.truncate(bytes.length() - 1)
    if bytes.length() > 0 && bytes[bytes.length() - 1] == 13 {
      mut bytes.truncate(bytes.length() - 1)
    }
  }
  match String.from_utf8(own bytes) {
    Ok(text) => Ok(Some(own text))
    Err(_) => Err(SystemError.InvalidData)
  }
}

public fn BufferedReader[Source: Reader].peek(mut self, count: UInt64) -> Result[view List[UInt8], SystemError]
  uses Handles, RunForever
  ensures !(result is Ok(seen) && seen.length() > count)
{
  var more = true
  while more && self.pending.length() < count
    invariant self.capacity > 0
  {
    let got = mut self.fill()?
    more = got > 0
  }
  let available = self.pending.length()
  let shown = if available < count { available } else { count }
  let unread = self.pending.bytes()
  Ok(unread[..shown])
}

public fn BufferedReader[Source: Reader].buffered(self) -> UInt64 {
  self.pending.length()
}

public fn BufferedReader[Source: Reader].finish(own self) -> Source {
  self.source
}

public fn BufferedReader[Source: Reader].source(self) lends Source {
  self.source
}

public fn BufferedReader[Source: Reader].source(mut self) lends mut Source {
  mut self.source
}

impl Reader for BufferedReader[Source: Reader] {
  fn read(mut self, buffer: mut List[UInt8], limit: UInt64) -> Result[UInt64, SystemError]
    uses Handles
  {
    if self.pending.is_empty() {
      if limit >= self.capacity {
        return mut self.source.read(mut buffer, limit: limit)
      }
      let _ = mut self.fill()?
    }
    let available = self.pending.length()
    let count = if limit < available { limit } else { available }
    mut buffer.append_items(self.pending.bytes()[..count])
    mut self.pending.skip(count)
    Ok(count)
  }
}

impl Seek for BufferedReader[Source: Reader + Seek] {
  fn seek(mut self, to: Position) -> Result[UInt64, SystemError]
    uses Handles
  {
    let unread = self.pending.length()
    mut self.pending.clear()
    match to {
      FromCurrent(offset) => {
        let position = mut self.source.seek(Position.FromCurrent(offset: 0))?
        let target = if offset >= 0 {
          position.saturating_subtract(unread).saturating_add(offset.to_unsigned_bits())
        } else {
          position.saturating_subtract(unread).saturating_subtract(offset.unsigned_absolute())
        }
        mut self.source.seek(Position.FromStart(offset: target))
      }
      FromStart(offset) => mut self.source.seek(Position.FromStart(offset: offset))
      FromEnd(offset) => mut self.source.seek(Position.FromEnd(offset: offset))
    }
  }
}

public opaque type BufferedWriter[Sink: Writer](sink: Sink, pending: List[UInt8], capacity: UInt64)

public fn BufferedWriter[Sink: Writer].new(sink: own Sink, capacity: UInt64 = 65536) -> BufferedWriter[Sink] {
  BufferedWriter(sink: own sink, pending: [], capacity: capacity)
}

public fn BufferedWriter[Sink: Writer].write_line(mut self, text: String) -> Result[Unit, SystemError]
  uses Handles
{
  mut self.write_all(text.bytes())?
  mut self.write_all("\n".bytes())
}

public fn BufferedWriter[Sink: Writer].finish(own self) -> Sink
  uses Panic unless self.pending.length() == 0
{
  if self.pending.length() != 0 {
    Panic.crash("the writer holds bytes that were not flushed")
  }
  self.sink
}

impl Writer for BufferedWriter[Sink: Writer] {
  fn write(mut self, bytes: List[UInt8]) -> Result[UInt64, SystemError]
    uses Handles
  {
    if bytes.length() >= self.capacity {
      mut self.flush()?
      return mut self.sink.write(bytes)
    }
    if self.pending.length() > self.capacity - bytes.length() {
      mut self.flush()?
    }
    mut self.pending.append_items(bytes)
    Ok(bytes.length())
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
    ensures !(result is Ok(_) && self.pending.length() != 0)
  {
    mut self.sink.write_all(self.pending)?
    mut self.pending.clear()
    mut self.sink.flush()
  }
}

public fn copy[Source: Reader, Sink: Writer](source: mut Source, sink: mut Sink) -> Result[UInt64, SystemError]
  uses Handles, RunForever
{
  var scratch: List[UInt8] = []
  var copied: UInt64 = 0
  var more = true
  while more {
    let count = mut source.read(mut scratch, limit: 65536)?
    mut sink.write_all(scratch)?
    copied = copied.saturating_add(count)
    mut scratch.clear()
    more = count > 0
  }
  Ok(copied)
}

public opaque type Limited[Source: Reader](source: Source, left: UInt64)

public fn Limited[Source: Reader].new(source: own Source, limit: UInt64) -> Limited[Source] {
  Limited(source: own source, left: limit)
}

public fn Limited[Source: Reader].finish(own self) -> Source {
  self.source
}

impl Reader for Limited[Source: Reader] {
  fn read(mut self, buffer: mut List[UInt8], limit: UInt64) -> Result[UInt64, SystemError]
    uses Handles
  {
    let allowed: UInt64 = if self.left < limit { self.left } else { limit }
    if allowed == 0 {
      return Ok(0)
    }
    let count = mut self.source.read(mut buffer, limit: allowed)?
    self.left -= count
    Ok(count)
  }
}

public type NoHandles()

impl Handles for NoHandles {
  fn read(self, handle: Handle, buffer: mut List[UInt8], limit: UInt64) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn write(self, handle: Handle, bytes: List[UInt8]) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn read_at(
    self,
    handle: Handle,
    offset: UInt64,
    buffer: mut List[UInt8],
    limit: UInt64,
  ) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn write_at(self, handle: Handle, offset: UInt64, bytes: List[UInt8]) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn seek(self, handle: Handle, to: Position) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn set_length(self, handle: Handle, length: UInt64) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn synchronize(self, handle: Handle) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn metadata(self, handle: Handle) -> Result[files.Metadata, SystemError] {
    Err(SystemError.Closed)
  }

  fn close(self, handle: own Handle) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn shut_down(self, handle: Handle, direction: network.Direction) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn set_timeout(
    self,
    handle: Handle,
    direction: network.Direction,
    timeout: Option[Duration],
  ) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn accept(self, listener: Handle) -> Result[network.Accepted, SystemError] {
    Err(SystemError.Closed)
  }

  fn accept_local(self, listener: Handle) -> Result[Handle, SystemError] {
    Err(SystemError.Closed)
  }

  fn configure(self, socket: Handle, option: network.SocketOption) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn send_to(
    self,
    socket: Handle,
    bytes: List[UInt8],
    address: network.SocketAddress,
  ) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn receive_from(
    self,
    socket: Handle,
    buffer: mut List[UInt8],
    limit: UInt64,
  ) -> Result[network.Datagram, SystemError] {
    Err(SystemError.Closed)
  }

  fn wait(self, process: Handle) -> Result[processes.ExitStatus, SystemError] {
    Err(SystemError.Closed)
  }

  fn signal(self, process: Handle, signal: processes.Signal) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn terminal_size(self, terminal: Handle) -> Result[console.Size, SystemError] {
    Err(SystemError.Closed)
  }

  fn set_raw_mode(self, terminal: Handle, enabled: Bool) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }
}
