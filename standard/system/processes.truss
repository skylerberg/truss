use standard::growth
use standard::intrinsic
use standard::processes
use standard::system::calls
use standard::system::handles

internal type SystemProcesses()

impl Processes for SystemProcesses {
  fn run(self, command: processes::Command) -> Result[processes::Output, SystemError] {
    var texts: intrinsic::Storage[UInt8] = intrinsic::storage_empty()
    var starts: intrinsic::Storage[USize] = intrinsic::storage_empty()
    handles::with_file_error(add_ended_with_zero_byte(command.program.slice().bytes, texts: mut texts, starts: mut starts))?
    for argument in command.arguments {
      handles::with_file_error(add_ended_with_zero_byte(argument.slice().bytes, texts: mut texts, starts: mut starts))?
    }
    let first = intrinsic::view_address(intrinsic::storage_view(texts))
    let count = intrinsic::storage_length(starts)
    var addresses: intrinsic::Storage[USize] = intrinsic::storage_with_capacity(count + 1)
    for index in 0..count
      invariant intrinsic::storage_length(addresses) == yielded.length()
      invariant intrinsic::storage_capacity(addresses) == count + 1
    {
      let start = intrinsic::view_at(intrinsic::storage_view(starts), index: index)
      intrinsic::storage_push(mut addresses, value: first.wrapping_add(start))
    }
    intrinsic::storage_push(mut addresses, value: 0)
    var process: Int32 = 0
    let not_started = intrinsic::libc_posix_spawnp(
      mut process,
      program: intrinsic::storage_view(texts),
      arguments: intrinsic::storage_view(addresses),
    )
    if not_started != 0 {
      return Err(handles::file_error(not_started))
    }
    var status: Int32 = 0
    var waited = intrinsic::libc_waitpid(process, status: mut status, options: 0)
    while waited < 0 && calls::interrupted_by_signal() {
      waited = intrinsic::libc_waitpid(process, status: mut status, options: 0)
    }
    if waited < 0 {
      return Err(handles::file_error(intrinsic::libc_errno()))
    }
    let ending_signal = status & 127
    let ended =
      if ending_signal == 0 {
        processes::ExitStatus.Exited(code: intrinsic::convert((status >> 8) & 255))
      } else {
        processes::ExitStatus.Signaled(signal: processes::Signal.from_number(ending_signal))
      }
    Ok(processes::Output(status: ended, output: [], error_output: []))
  }

  fn spawn(self, command: processes::Command) -> Result[processes::Child, SystemError] {
    todo
  }
}

fn add_ended_with_zero_byte(
  bytes: intrinsic::View[UInt8],
  texts: mut intrinsic::Storage[UInt8],
  starts: mut intrinsic::Storage[USize],
) -> Result[Unit, Int32] {
  growth::push(mut starts, value: intrinsic::storage_length(texts))
  let start = intrinsic::storage_length(texts)
  let length = intrinsic::view_length(bytes)
  growth::reserve(mut texts, additional: length + 1)
  for index in 0..length
    invariant intrinsic::storage_length(texts) == start + yielded.length()
    invariant intrinsic::storage_capacity(texts) >= start + length + 1
  {
    let byte = intrinsic::view_at(bytes, index: index)
    if byte == 0 {
      return Err(intrinsic::libc_einval())
    }
    intrinsic::storage_push(mut texts, value: byte)
  }
  intrinsic::storage_push(mut texts, value: 0)
  Ok(Unit)
}
