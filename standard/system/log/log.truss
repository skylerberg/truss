use standard::intrinsic
use standard::log
use standard::system::calls

internal type SystemLog()

impl Log for SystemLog {
  fn record(self, record: log::Record) {
    var line = ""
    mut line.push("level=")
    match record.level {
      Debug => mut line.push("debug")
      Information => mut line.push("information")
      Warning => mut line.push("warning")
      Error => mut line.push("error")
    }
    mut line.push(" message=")
    quoted(mut line, text: record.message)
    for field in record.fields {
      mut line.push(" ")
      mut line.push(field.name)
      mut line.push("=")
      match field.value {
        String(value) => quoted(mut line, text: value)
        Integer(value) => mut line.push_signed(value)
        Float(value) => mut line.push_float64(value)
        Bool(value) => if value { mut line.push("true") } else { mut line.push("false") }
        Duration(value) => {
          mut line.push_signed(value.total_nanoseconds())
          mut line.push("ns")
        }
        Instant(value) => mut line.push_signed(value.unix_nanoseconds())
      }
    }
    mut line.push("\n")
    let _ = calls::write_fully(2, bytes: line.slice().bytes)
  }

  fn enabled(self, level: log::Level) -> Bool {
    level >= log::Level.Information
  }
}

fn quoted(line: mut String, text: StringSlice) {
  mut line.push_byte(34)
  let bytes = text.bytes
  for index in 0..intrinsic::view_length(bytes) {
    let byte = intrinsic::view_at(bytes, index: index)
    if byte == 34 || byte == 92 {
      mut line.push_byte(92)
      mut line.push_byte(byte)
    } else if byte == 10 {
      mut line.push_byte(92)
      mut line.push_byte(110)
    } else {
      mut line.push_byte(byte)
    }
  }
  mut line.push_byte(34)
}
