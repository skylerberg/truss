use standard.capabilities
use standard.console
use standard.system.calls
use standard.system.handles
use standard.system.lines

internal type SystemConsole(input: lines.LineInput)

impl Default for SystemConsole {
  fn default() -> SystemConsole
    cost time O(1)
    cost allocations == 0
  {
    SystemConsole(input: lines.LineInput.new())
  }
}

impl Console for SystemConsole
  uses RunForever, capabilities.System
{
  fn print(self, text: String) {
    let _ = calls.write_fully(1, bytes: text.storage)
  }

  fn print_line(self, text: String) {
    let _ = calls.write_fully(1, bytes: text.storage)
    let _ = calls.write_fully(1, bytes: "\n".storage)
  }

  fn print_error(self, text: String) {
    let _ = calls.write_fully(2, bytes: text.storage)
    let _ = calls.write_fully(2, bytes: "\n".storage)
  }

  fn read_line(mut self) -> Option[String] {
    match mut self.input.next_line(0) {
      Ok(line) => line
      Err(_) => None
    }
  }

  fn input(self) -> console.Input {
    console.Input.from_handle(handles.duplicate(0))
  }

  fn output(self) -> console.Output {
    console.Output.from_handle(handles.duplicate(1))
  }

  fn error_output(self) -> console.Output {
    console.Output.from_handle(handles.duplicate(2))
  }

  fn terminal(self) -> console.Terminal {
    console.Terminal.from_handle(handles.controlling_terminal())
  }
}
