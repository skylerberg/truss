use standard::files
use standard::intrinsic
use standard::system::calls
use standard::system::directories
use standard::system::handles

internal type SystemFileRead()

impl FileRead for SystemFileRead {
  fn read(self, file: Path) -> Result[List[UInt8], SystemError] {
    var handle = handles::open_to_read(file)?
    let bytes = handles::read_all(mut handle)?
    Ok(List.from_storage(own bytes))
  }

  fn read_text(self, file: Path) -> Result[String, SystemError] {
    var handle = handles::open_to_read(file)?
    let bytes = handles::read_all(mut handle)?
    Ok(String.from_bytes(own bytes))
  }

  fn open(self, file: Path) -> Result[files::FileReader, SystemError] {
    Ok(files::FileReader.new(files::File(handle: handles::open_with(file, flags: intrinsic::libc_o_rdonly())?)))
  }

  fn metadata(self, path: Path, follow_links: Bool) -> Result[files::Metadata, SystemError] {
    let status = handles::with_file_error(
      calls::status_of_path(path.text.slice().bytes, follow_links: follow_links),
    )?
    Ok(handles::metadata_from(intrinsic::storage_view(status)))
  }

  fn list(self, directory: Path) -> Result[List[files::DirectoryEntry], SystemError] {
    directories::entries(directory)
  }

  fn read_link(self, link: Path) -> Result[Path, SystemError] {
    let target = handles::with_file_error(calls::read_link(link.text.slice().bytes))?
    Ok(Path(text: String.from_bytes(own target)))
  }

  fn resolve(self, path: Path) -> Result[Path, SystemError] {
    let resolved = handles::with_file_error(calls::resolve(path.text.slice().bytes))?
    Ok(Path(text: String.from_bytes(own resolved)))
  }
}
