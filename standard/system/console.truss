use standard::console
use standard::streams
use standard::system::calls
use standard::system::lines

internal type SystemConsole(input: lines::LineInput)

internal fn SystemConsole.new() -> SystemConsole {
  SystemConsole(input: lines::LineInput.new())
}

impl Console for SystemConsole {
  fn print(self, text: StringSlice) {
    let _ = calls::write_fully(1, bytes: text.bytes)
  }

  fn print_line(self, text: StringSlice) {
    let _ = calls::write_fully(1, bytes: text.bytes)
    let _ = calls::write_fully(1, bytes: "\n".slice().bytes)
  }

  fn print_error(self, text: StringSlice) {
    let _ = calls::write_fully(2, bytes: text.bytes)
    let _ = calls::write_fully(2, bytes: "\n".slice().bytes)
  }

  fn read_line(mut self) -> Option[String] {
    match mut self.input.next_line(0) {
      Ok(line) => line
      Err(_) => None
    }
  }

  fn input(self) -> console::Input {
    console::Input.from_handle(streams::Handle.numbered(0))
  }

  fn output(self) -> console::Output {
    console::Output.from_handle(streams::Handle.numbered(1))
  }

  fn error_output(self) -> console::Output {
    console::Output.from_handle(streams::Handle.numbered(2))
  }

  fn terminal(self) -> console::Terminal {
    console::Terminal.from_handle(streams::Handle.numbered(1))
  }
}
