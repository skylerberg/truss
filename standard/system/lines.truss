use standard::intrinsic
use standard::system::calls

internal type LineInput(unread: intrinsic::Storage[UInt8], given: USize, ended: Bool)
  invariant given <= intrinsic::storage_length(unread)

internal fn LineInput.new() -> LineInput {
  LineInput(unread: intrinsic::storage_empty(), given: 0, ended: false)
}

internal fn LineInput.next_line(mut self, descriptor: Int32) -> Result[Option[String], Int32] {
  var end: USize = self.given
  var found = false
  var searching = true
  while searching
    invariant self.given <= end
    invariant end <= intrinsic::storage_length(self.unread)
    invariant found ==> end < intrinsic::storage_length(self.unread)
    invariant found ==> !searching
  {
    if end < intrinsic::storage_length(self.unread) {
      if intrinsic::view_at(intrinsic::storage_view(self.unread), index: end) == 10 {
        found = true
        searching = false
      } else {
        end += 1
      }
    } else if self.ended {
      searching = false
    } else {
      end -= self.given
      mut self.forget_what_was_given(65536)
      let read = calls::read_onto_end(descriptor, buffer: mut self.unread, count: 65536)?
      if read == 0 {
        self.ended = true
      }
    }
  }
  if !found && end == self.given {
    Ok(None)
  } else {
    let start = self.given
    var line: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(end - start)
    for index in start..end
      invariant intrinsic::storage_length(line) == index - start
      invariant intrinsic::storage_capacity(line) == end - start
    {
      intrinsic::storage_push(mut line, value: intrinsic::view_at(intrinsic::storage_view(self.unread), index: index))
    }
    self.given = if found { end + 1 } else { end }
    Ok(Some(String.from_bytes(own line)))
  }
}

fn LineInput.forget_what_was_given(mut self, room_to_read_into: USize)
  requires self.given <= intrinsic::storage_length(self.unread)
  requires room_to_read_into <= 65536
  ensures self.given == 0
  ensures intrinsic::storage_length(self.unread) == old(intrinsic::storage_length(self.unread)) - old(self.given)
{
  let length = intrinsic::storage_length(self.unread)
  let start = self.given
  var kept: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(length - start + room_to_read_into)
  for index in start..length
    invariant intrinsic::storage_length(kept) == index - start
    invariant intrinsic::storage_capacity(kept) == length - start + room_to_read_into
  {
    intrinsic::storage_push(mut kept, value: intrinsic::view_at(intrinsic::storage_view(self.unread), index: index))
  }
  self.unread = own kept
  self.given = 0
}
