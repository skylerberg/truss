use standard::intrinsic

use standard::system::calls

internal fn nanoseconds_from(seconds: Int64, nanoseconds: Int64) -> Int64 {
  let whole = if seconds > 9223372035 { 9223372035 } else if seconds < -9223372035 { -9223372035 } else { seconds }
  let part = if nanoseconds < 0 { 0 } else if nanoseconds > 999999999 { 999999999 } else { nanoseconds }
  whole * 1000000000 + part
}

internal fn instant_from(seconds: Int64, nanoseconds: Int64) -> Instant {
  Instant(nanoseconds: nanoseconds_from(seconds, nanoseconds: nanoseconds))
}

internal type SystemClock()

impl Clock for SystemClock {
  fn now(self) -> Instant {
    var seconds: Int64 = 0
    var nanoseconds: Int64 = 0
    let _ = intrinsic::libc_clock_gettime(
      intrinsic::libc_clock_realtime(),
      seconds: mut seconds,
      nanoseconds: mut nanoseconds,
    )
    instant_from(seconds, nanoseconds: nanoseconds)
  }

  fn monotonic(self) -> Duration {
    var seconds: Int64 = 0
    var nanoseconds: Int64 = 0
    let _ = intrinsic::libc_clock_gettime(
      intrinsic::libc_clock_monotonic(),
      seconds: mut seconds,
      nanoseconds: mut nanoseconds,
    )
    Duration(nanoseconds: nanoseconds_from(seconds, nanoseconds: nanoseconds))
  }

  fn sleep(self, duration: Duration) {
    if duration.nanoseconds > 0 {
      calls::sleep(duration.nanoseconds / 1000000000, nanoseconds: duration.nanoseconds % 1000000000)
    }
  }
}
