use standard::files
use standard::intrinsic
use standard::system::handles

internal type SystemFileWrite()

impl FileWrite for SystemFileWrite {
  fn write(self, file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError] {
    var handle = handles::open_to_write_from_empty(file)?
    handles::write_all(mut handle, bytes: contents.elements)
  }

  fn write_text(self, file: Path, contents: StringSlice) -> Result[Unit, SystemError] {
    var handle = handles::open_to_write_from_empty(file)?
    handles::write_all(mut handle, bytes: contents.bytes)
  }

  fn open(self, file: Path, mode: files::WriteMode) -> Result[files::File, SystemError] {
    let write_only_made_if_missing = intrinsic::libc_o_wronly() | intrinsic::libc_o_creat()
    let flags = match mode {
      Replace => write_only_made_if_missing | intrinsic::libc_o_trunc()
      Append => write_only_made_if_missing | intrinsic::libc_o_append()
      CreateNew => write_only_made_if_missing | intrinsic::libc_o_excl()
      Update => intrinsic::libc_o_rdwr() | intrinsic::libc_o_creat()
    }
    Ok(files::File(handle: handles::open_with(file, flags: flags)?))
  }

  fn create_directory(self, directory: Path) -> Result[Unit, SystemError] {
    todo
  }

  fn remove(self, path: Path) -> Result[Unit, SystemError] {
    todo
  }

  fn rename(self, from: Path, to: Path) -> Result[Unit, SystemError] {
    todo
  }

  fn link(self, target: Path, link: Path, kind: files::LinkKind) -> Result[Unit, SystemError] {
    todo
  }

  fn set_permissions(self, path: Path, permissions: files::Permissions) -> Result[Unit, SystemError] {
    todo
  }

  fn set_modified(self, path: Path, time: Instant) -> Result[Unit, SystemError] {
    todo
  }
}
