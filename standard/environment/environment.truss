public type OperatingSystem = Linux | MacOs | Windows | FreeBsd | Other
  derives Equal, Hash

public type Architecture = X86With64Bits | Arm64 | X86 | Arm | RiscV64 | WebAssembly32 | Other
  derives Equal, Hash

public type Platform(
  operating_system: OperatingSystem,
  architecture: Architecture,
  processor_count: USize,
  host_name: String,
  process_identifier: UInt32,
)

public type Variable(name: String, value: String)

public type Location = Home | Temporary | Executable | Configuration | Cache | Data
  derives Equal, Hash, Ordered

public opaque type FixedEnvironment(
  variables: Map[String, String],
  current_directory: Path,
  platform: Platform,
  locations: Map[Location, Path],
  local_zone: Option[String],
  zones: Map[String, List[UInt8]],
)

public fn FixedEnvironment.new(platform: own Platform, current_directory: own Path) -> FixedEnvironment {
  FixedEnvironment(
    variables: [:],
    current_directory: own current_directory,
    platform: own platform,
    locations: [:],
    local_zone: None,
    zones: [:],
  )
}

public fn FixedEnvironment.with_variable(own self, name: StringSlice, value: StringSlice) -> FixedEnvironment {
  var changed = own self
  mut changed.variables.insert(name.to_string(), value: value.to_string())
  changed
}

public fn FixedEnvironment.with_location(own self, location: Location, path: own Path) -> FixedEnvironment {
  var changed = own self
  mut changed.locations.insert(location, value: own path)
  changed
}

public fn FixedEnvironment.with_zone(own self, name: StringSlice, rules: own List[UInt8], local: Bool = false) -> FixedEnvironment {
  var changed = own self
  mut changed.zones.insert(name.to_string(), value: own rules)
  if local {
    changed.local_zone = Some(name.to_string())
  }
  changed
}

impl Environment for FixedEnvironment {
  fn variable(self, name: StringSlice) -> Option[String]
  {
    self.variables.get(name.to_string()).map(fn(value) { value.copy() })
  }

  fn variables(self) -> List[Variable]
  {
    var listed: List[Variable] = List.with_capacity(self.variables.length())
    for entry in self.variables {
      mut listed.push(Variable(name: entry.key.copy(), value: entry.value.copy()))
    }
    listed
  }

  fn current_directory(self) -> Result[Path, SystemError] {
    Ok(self.current_directory.copy())
  }

  fn platform(self) -> Platform {
    self.platform.copy()
  }

  fn location(self, location: Location) -> Option[Path]
  {
    self.locations.get(location).map(fn(value) { value.copy() })
  }

  fn local_zone(self) -> Option[String] {
    self.local_zone.copy()
  }

  fn zone_rules(self, name: StringSlice) -> Option[List[UInt8]]
  {
    self.zones.get(name.to_string()).map(fn(value) { value.copy() })
  }
}
