use standard::base64
use standard::cryptography
use standard::random

public type Error(message: String)
  derives Equal

impl Display for Error {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("the stored password hash is not an Argon2id PHC string: ")
    mut output.write(self.message.slice())
  }
}

type Stored(password_cost: cryptography::PasswordCost, salt: List[UInt8], tag: List[UInt8])

fn malformed(message: StringSlice) -> Error {
  Error(message: message.to_string())
}

fn is_usable(password_cost: cryptography::PasswordCost) -> Bool
  ensures result == (
    password_cost.parallelism >= 1 && password_cost.parallelism <= 16777215 && password_cost.iterations >= 1
      && password_cost.memory_kibibytes >= 8 * password_cost.parallelism
  )
{
  password_cost.parallelism >= 1 && password_cost.parallelism <= 16777215 && password_cost.iterations >= 1
    && password_cost.memory_kibibytes >= 8 * password_cost.parallelism
}

fn number(text: StringSlice, name: StringSlice) -> Result[UInt32, Error] {
  match text.strip_prefix(name) {
    Some(digits) => match UInt32.parse(digits) {
      Ok(value) => Ok(value)
      Err(_) => Err(malformed("a parameter that is not a decimal number"))
    }
    None => Err(malformed("parameters other than m, t and p in that order"))
  }
}

fn decoded(text: StringSlice) -> Result[List[UInt8], Error] {
  match base64::decode(text) {
    Ok(bytes) => Ok(own bytes)
    Err(_) => Err(malformed("a salt or hash that is not base64"))
  }
}

fn parse(stored: StringSlice) -> Result[Stored, Error] {
  var fields: List[StringSlice] = []
  for field in stored.split("$") {
    mut fields.push(field)
  }
  if fields.length() != 6 || !fields[0].is_empty() {
    return Err(malformed("a string that does not have five fields after a leading $"))
  }
  if fields[1] != "argon2id".slice() {
    return Err(malformed("an algorithm other than argon2id"))
  }
  if fields[2] != "v=19".slice() {
    return Err(malformed("an Argon2 version other than 19"))
  }
  var parameters: List[StringSlice] = []
  for parameter in fields[3].split(",") {
    mut parameters.push(parameter)
  }
  if parameters.length() != 3 {
    return Err(malformed("parameters other than m, t and p in that order"))
  }
  let password_cost = cryptography::PasswordCost(
    memory_kibibytes: number(parameters[0], name: "m=")?,
    iterations: number(parameters[1], name: "t=")?,
    parallelism: number(parameters[2], name: "p=")?,
  )
  if !is_usable(password_cost) {
    return Err(malformed("a cost that Argon2 does not allow"))
  }
  let salt = decoded(fields[4])?
  let tag = decoded(fields[5])?
  if salt.length() < 8 {
    return Err(malformed("a salt shorter than 8 bytes"))
  }
  if tag.length() < 4 || tag.length() > 1024 {
    return Err(malformed("a hash shorter than 4 bytes or longer than 1024"))
  }
  Ok(Stored(password_cost: password_cost, salt: own salt, tag: own tag))
}

public fn hash(password: StringSlice, password_cost: cryptography::PasswordCost = cryptography::PasswordCost()) -> String
  uses Random
  requires password_cost.parallelism >= 1 && password_cost.parallelism <= 16777215
  requires password_cost.iterations >= 1
  requires password_cost.memory_kibibytes >= 8 * password_cost.parallelism
{
  let salt = random::bytes(16)
  let tag = cryptography::argon2id(password.bytes(), salt: salt.slice(), password_cost: password_cost, length: 32)
  let salt_text = base64::encode(salt.slice(), padding: false)
  let tag_text = base64::encode(tag.slice(), padding: false)
  "$argon2id$v=19$m=${password_cost.memory_kibibytes},t=${password_cost.iterations},p=${password_cost.parallelism}$${salt_text}$${tag_text}"
}

public fn verify(password: StringSlice, stored: StringSlice) -> Result[Bool, Error] {
  let parts = parse(stored)?
  if !is_usable(parts.password_cost) || parts.salt.length() < 8 || parts.tag.length() < 4 || parts.tag.length() > 1024 {
    return Err(malformed("a cost that Argon2 does not allow"))
  }
  let tag = cryptography::argon2id(password.bytes(), salt: parts.salt.slice(), password_cost: parts.password_cost, length: parts.tag.length())
  Ok(cryptography::constant_time_equal(tag.slice(), second: parts.tag.slice()))
}

public fn needs_rehash(stored: StringSlice, password_cost: cryptography::PasswordCost = cryptography::PasswordCost()) -> Bool {
  match parse(stored) {
    Ok(parts) => {
      parts.password_cost.memory_kibibytes != password_cost.memory_kibibytes || parts.password_cost.iterations != password_cost.iterations
        || parts.password_cost.parallelism != password_cost.parallelism || parts.salt.length() < 16 || parts.tag.length() != 32
    }
    Err(_) => true
  }
}
