use standard::intrinsic
use standard::random

public type SendError = Closed | Cancelled
  derives Equal

impl Display for SendError {
  fn display(self, output: mut TextBuilder) {
    match self {
      Closed => mut output.write("the channel is closed")
      Cancelled => mut output.write("the task was cancelled")
    }
  }
}

type Queue[Message](
  incoming: List[Message],
  outgoing: List[Message],
  capacity: USize,
  enqueued_count: UInt64,
  dequeued_count: UInt64,
  closed: Bool,
)

type EnqueueOutcome[Message] =
  | Buffered
  | Offered(position: UInt64)
  | Full(message: Message)
  | Refused(message: Message)

type DequeueOutcome[Message](message: Option[Message], closed: Bool)

type Offer = Accepted | Pending | Withdrawn

fn Queue[Message].enqueue(mut self, message: own Message) -> EnqueueOutcome[Message] {
  if self.closed {
    return EnqueueOutcome.Refused(message: own message)
  }
  let limit = if self.capacity == 0 { 1 } else { self.capacity }
  if self.incoming.length().saturating_add(self.outgoing.length()) >= limit {
    return EnqueueOutcome.Full(message: own message)
  }
  mut self.incoming.push(own message)
  self.enqueued_count = self.enqueued_count.saturating_add(1)
  if self.capacity == 0 { EnqueueOutcome.Offered(position: self.enqueued_count) } else { EnqueueOutcome.Buffered }
}

fn Queue[Message].dequeue(mut self) -> DequeueOutcome[Message] {
  if self.outgoing.is_empty() {
    mut self.incoming.reverse()
    self.outgoing = own self.incoming
    self.incoming = []
  }
  let message = mut self.outgoing.pop()
  if message is Some(_) {
    self.dequeued_count = self.dequeued_count.saturating_add(1)
  }
  DequeueOutcome(message: own message, closed: self.closed)
}

fn Queue[Message].check_offer(mut self, position: UInt64, withdraw: Bool) -> Offer {
  if self.dequeued_count >= position {
    return Offer.Accepted
  }
  if !withdraw && !self.closed {
    return Offer.Pending
  }
  let _ = mut self.incoming.pop()
  self.enqueued_count = self.enqueued_count.saturating_subtract(1)
  Offer.Withdrawn
}

public opaque type Channel[Message: Storable](queue: intrinsic::Shared[Queue[Message]])
  derives Copyable

public fn Channel[Message: Storable].new(capacity: USize = 0) -> Channel[Message] {
  Channel(
    queue: intrinsic::shared_new(
      Queue(incoming: [], outgoing: [], capacity: capacity, enqueued_count: 0, dequeued_count: 0, closed: false),
    ),
  )
}

public fn Channel[Message: Storable].send(self, message: own Message) -> Result[Unit, SendError]
  uses Tasks
{
  let key = intrinsic::shared_key(self.queue)
  var unsent = own message
  while true {
    let ticket = Tasks.watch(key)
    match intrinsic::shared_update(self.queue, input: own unsent, change: fn(queue, offered) {
      mut queue.enqueue(own offered)
    }) {
      Buffered => {
        Tasks.wake(key)
        return Ok(Unit)
      }
      Offered(position) => {
        Tasks.wake(key)
        return self.await_receiver(position)
      }
      Refused(_) => return Err(SendError.Closed)
      Full(rejected) => {
        if Tasks.cancelled() {
          return Err(SendError.Cancelled)
        }
        unsent = own rejected
        Tasks.wait(key, ticket: ticket, reason: "sending to a full channel")
      }
    }
  }
}

fn Channel[Message: Storable].await_receiver(self, position: UInt64) -> Result[Unit, SendError]
  uses Tasks
{
  let key = intrinsic::shared_key(self.queue)
  while true {
    let ticket = Tasks.watch(key)
    let cancelled = Tasks.cancelled()
    match intrinsic::shared_update(self.queue, input: 0, change: fn(queue, _) {
      mut queue.check_offer(position, withdraw: cancelled)
    }) {
      Accepted => return Ok(Unit)
      Withdrawn => {
        Tasks.wake(key)
        return Err(if cancelled { SendError.Cancelled } else { SendError.Closed })
      }
      Pending => Tasks.wait(key, ticket: ticket, reason: "sending to a channel that no task is receiving from")
    }
  }
}

public fn Channel[Message: Storable].receive(self) -> Option[Message]
  uses Tasks
{
  let key = intrinsic::shared_key(self.queue)
  while true {
    let ticket = Tasks.watch(key)
    let dequeue = intrinsic::shared_update(self.queue, input: 0, change: fn(queue, _) {
      mut queue.dequeue()
    })
    match own dequeue.message {
      Some(message) => {
        Tasks.wake(key)
        return Some(own message)
      }
      None => {}
    }
    if dequeue.closed || Tasks.cancelled() {
      return None
    }
    Tasks.wait(key, ticket: ticket, reason: "receiving from an empty channel")
  }
}

public fn Channel[Message: Storable].try_receive(self) -> Option[Message]
  uses Tasks
{
  let dequeue = intrinsic::shared_update(self.queue, input: 0, change: fn(queue, _) {
    mut queue.dequeue()
  })
  if dequeue.message is Some(_) {
    Tasks.wake(intrinsic::shared_key(self.queue))
  }
  own dequeue.message
}

public fn Channel[Message: Storable].close(self)
  uses Tasks
{
  intrinsic::shared_update(self.queue, input: 0, change: fn(queue, _) {
    queue.closed = true
  })
  Tasks.wake(intrinsic::shared_key(self.queue))
}

public fn Channel[Message: Storable].messages(self) yields own Message
  uses Tasks
{
  while self.receive() is Some(message) {
    yield own message
  }
}

public fn with_timeout[Output, capability Granted](limit: Duration, work: (fn() -> Output uses Granted)) -> Option[Output]
  uses Tasks, Clock, Granted
{
  concurrent {
    return Some(work())
    {
      Clock.sleep(limit)
      return None
    }
  }
}

type Permit()

public opaque type Limiter(permits: Channel[Permit])
  derives Copyable

public fn Limiter.new(permits: USize) -> Limiter
  requires permits > 0
{
  Limiter(permits: Channel[Permit].new(capacity: permits))
}

public fn Limiter.hold[Output, capability Granted](self, work: (fn() -> Output uses Granted)) -> Option[Output]
  uses Tasks, Granted
{
  if self.permits.send(Permit()) is Err(_) {
    return None
  }
  let output = work()
  let _ = self.permits.try_receive()
  Some(own output)
}

type Status =
  | Ready
  | Finished
  | Joining(task_group: UInt64)
  | Waiting(reason: String)
  | Locking(mutex: UInt64)
  | Sleeping(deadline: Duration)

type Task(
  coroutine: USize,
  task_group: UInt64,
  status: Status,
  cancelled: Bool,
  watched_key: UInt64,
  ticket: UInt64,
  woken: Bool,
)

type TaskGroup(identifier: UInt64, parent: UInt64, cancelled: Bool)

type Decision =
  | Proceed
  | Suspend
  | Resume(coroutine: USize)
  | Deadlock(report: String)

let root_task: USize = 0

type Scheduler(
  generator: random::Generator,
  tasks: List[Task],
  groups: List[TaskGroup],
  locked: List[UInt64],
  running: USize,
  next: Option[USize],
  groups_opened: UInt64,
  tickets_issued: UInt64,
  elapsed: Duration,
)
  invariant running < tasks.length()
  invariant !(next is Some(task) && task >= tasks.length())

internal fn Scheduler.new(seed: UInt64) -> Scheduler {
  Scheduler(
    generator: random::Generator.seeded(seed),
    tasks: [
      Task(
        coroutine: 0,
        task_group: 0,
        status: Status.Ready,
        cancelled: false,
        watched_key: 0,
        ticket: 0,
        woken: false,
      ),
    ],
    groups: [],
    locked: [],
    running: root_task,
    next: None,
    groups_opened: 0,
    tickets_issued: 0,
    elapsed: Duration.zero,
  )
}

internal fn Scheduler.open(mut self) -> UInt64 {
  self.groups_opened = self.groups_opened.saturating_add(1)
  mut self.groups.push(
    TaskGroup(identifier: self.groups_opened, parent: self.tasks[self.running].task_group, cancelled: false),
  )
  self.groups_opened
}

internal fn Scheduler.group_index(self, task_group: UInt64) -> Option[USize]
  ensures !(result is Some(index) && index >= self.groups.length())
{
  self.groups.slice().find_index(fn(group) { group.identifier == task_group })
}

internal fn Scheduler.accepts_tasks(self, task_group: UInt64) -> Bool {
  match self.group_index(task_group) {
    Some(index) => !self.groups[index].cancelled
    None => false
  }
}

internal fn Scheduler.add_task(mut self, task_group: UInt64, coroutine: USize) {
  let task = Task(
    coroutine: coroutine,
    task_group: task_group,
    status: Status.Ready,
    cancelled: self.tasks[self.running].cancelled,
    watched_key: 0,
    ticket: 0,
    woken: false,
  )
  match self.tasks.slice().find_index(fn(other) { other.status is Finished }) {
    Some(finished) => self.tasks[finished] = own task
    None => mut self.tasks.push(own task)
  }
}

internal fn Scheduler.has_unfinished_task(self, task_group: UInt64) -> Bool {
  for task in self.tasks {
    if task.task_group == task_group && !(task.status is Finished) {
      return true
    }
  }
  false
}

internal fn Scheduler.join(mut self, task_group: UInt64) -> Bool {
  if self.has_unfinished_task(task_group) {
    self.tasks[self.running].status = Status.Joining(task_group: task_group)
    return false
  }
  if self.group_index(task_group) is Some(index) {
    let _ = mut self.groups.swap_remove(index)
  }
  true
}

internal fn Scheduler.cancel(mut self, task_group: UInt64) -> Bool {
  let index = match self.group_index(task_group) {
    Some(index) => index
    None => return false
  }
  if self.groups[index].cancelled {
    return false
  }
  self.groups[index].cancelled = true
  let count = self.tasks.length()
  var worklist: List[UInt64] = [task_group]
  while mut worklist.pop() is Some(group)
    invariant self.tasks.length() == count
    invariant self.running < count
    invariant !(self.next is Some(task) && task >= count)
  {
    for task in 0..count
      invariant self.tasks.length() == count
      invariant self.running < count
      invariant !(self.next is Some(other) && other >= count)
    {
      if self.tasks[task].task_group == group {
        self.tasks[task].cancelled = true
      }
    }
    for nested in self.groups {
      if nested.parent == group {
        mut worklist.push(nested.identifier)
      }
    }
  }
  true
}

internal fn Scheduler.watch(mut self, key: UInt64) -> UInt64 {
  self.tickets_issued = self.tickets_issued.wrapping_add(1)
  self.tasks[self.running].watched_key = key
  self.tasks[self.running].ticket = self.tickets_issued
  self.tasks[self.running].woken = false
  self.tickets_issued
}

internal fn Scheduler.wait(mut self, key: UInt64, ticket: UInt64, reason: own String) -> Bool {
  if self.tasks[self.running].cancelled
    || self.tasks[self.running].woken
    || self.tasks[self.running].watched_key != key
    || self.tasks[self.running].ticket != ticket
  {
    return false
  }
  self.tasks[self.running].status = Status.Waiting(reason: own reason)
  true
}

internal fn Scheduler.wake(mut self, key: UInt64) {
  let count = self.tasks.length()
  for task in 0..count
    invariant self.tasks.length() == count
    invariant self.running < count
    invariant !(self.next is Some(other) && other >= count)
  {
    if self.tasks[task].watched_key == key {
      self.tasks[task].woken = true
    }
  }
}

internal fn Scheduler.lock(mut self, mutex: UInt64) -> Bool {
  if self.locked.contains(mutex) {
    self.tasks[self.running].status = Status.Locking(mutex: mutex)
    return false
  }
  mut self.locked.push(mutex)
  true
}

internal fn Scheduler.unlock(mut self, mutex: UInt64) {
  if self.locked.index_of(mutex) is Some(index) {
    let _ = mut self.locked.swap_remove(index)
  }
}

internal fn Scheduler.sleep(mut self, duration: Duration) -> Bool {
  if self.tasks[self.running].cancelled || duration <= Duration.zero {
    return false
  }
  self.tasks[self.running].status = Status.Sleeping(deadline: self.elapsed + duration)
  true
}

internal fn Scheduler.advance(mut self, by: Duration) {
  if by > Duration.zero {
    self.elapsed = self.elapsed + by
  }
}

internal fn Scheduler.earliest_deadline(self) -> Option[Duration] {
  var earliest: Option[Duration] = None
  for task in self.tasks {
    if task.status is Sleeping(deadline) {
      if !(earliest is Some(other) && other <= deadline) {
        earliest = Some(deadline)
      }
    }
  }
  earliest
}

internal fn Scheduler.can_run(self, task: USize) -> Bool
  requires task < self.tasks.length()
{
  match self.tasks[task].status {
    Ready => true
    Finished => false
    Joining(task_group) => !self.has_unfinished_task(task_group)
    Waiting(_) => self.tasks[task].woken || self.tasks[task].cancelled
    Locking(mutex) => !self.locked.contains(mutex)
    Sleeping(deadline) => deadline <= self.elapsed || self.tasks[task].cancelled
  }
}

internal fn Scheduler.runnable_count(self) -> USize {
  var count: USize = 0
  for task in 0..self.tasks.length() {
    if self.can_run(task) {
      count = count.saturating_add(1)
    }
  }
  count
}

internal fn Scheduler.pick_runnable(mut self) -> Option[USize]
  ensures !(result is Some(task) && task >= self.tasks.length())
{
  var runnable = self.runnable_count()
  if runnable == 0 {
    match self.earliest_deadline() {
      Some(deadline) if deadline > self.elapsed => self.elapsed = deadline
      _ => return None
    }
    runnable = self.runnable_count()
    if runnable == 0 {
      return None
    }
  }
  var skipped = mut self.generator.index(runnable)
  for task in 0..self.tasks.length() {
    if self.can_run(task) {
      if skipped == 0 {
        return Some(task)
      }
      skipped -= 1
    }
  }
  None
}

internal fn Scheduler.deadlock_report(self) -> String {
  var report = "Deadlock: no task can run."
  for task in 0..self.tasks.length() {
    match self.tasks[task].status {
      Joining(_) => mut report.push("\n  Task ${task} is waiting for the tasks that it spawned.")
      Waiting(reason) => mut report.push("\n  Task ${task} is ${reason}.")
      Locking(_) => mut report.push("\n  Task ${task} is blocked on the mutex of a `mut` capability implementation.")
      _ => {}
    }
  }
  report
}

internal fn Scheduler.choose_next(mut self) -> Decision {
  let caller = self.running
  let chosen = match self.next {
    Some(task) => task
    None => match mut self.pick_runnable() {
      Some(task) => task
      None => return Decision.Deadlock(report: self.deadlock_report())
    }
  }
  if chosen != caller && caller != root_task {
    self.next = Some(chosen)
    return Decision.Suspend
  }
  self.next = None
  self.tasks[chosen].status = Status.Ready
  self.running = chosen
  if chosen == caller { Decision.Proceed } else { Decision.Resume(coroutine: self.tasks[chosen].coroutine) }
}

internal fn Scheduler.return_to_root(mut self, suspended: Bool) {
  if !suspended {
    self.tasks[self.running].status = Status.Finished
  }
  self.running = root_task
}

fn switch_task(scheduler: intrinsic::Shared[Scheduler])
  uses Tasks, Panic
{
  while true {
    let decision = intrinsic::shared_update(scheduler, input: 0, change: fn(state, _) {
      mut state.choose_next()
    })
    match decision {
      Proceed => return
      Suspend => {
        intrinsic::coroutine_suspend()
        return
      }
      Resume(coroutine) => {
        let suspended = intrinsic::coroutine_resume(coroutine)
        intrinsic::shared_update(scheduler, input: 0, change: fn(state, _) {
          mut state.return_to_root(suspended)
        })
      }
      Deadlock(report) => Panic.crash(report)
    }
  }
}

public opaque type SeededTasks(scheduler: intrinsic::Shared[Scheduler])

public fn SeededTasks.new(seed: UInt64) -> SeededTasks {
  SeededTasks(scheduler: intrinsic::shared_new(Scheduler.new(seed)))
}

internal fn SeededTasks.elapsed(self) -> Duration
  uses Tasks
{
  intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
    scheduler.elapsed
  })
}

internal fn SeededTasks.advance(self, by: Duration)
  uses Tasks
{
  intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
    mut scheduler.advance(by)
  })
}

internal fn SeededTasks.sleep(self, duration: Duration)
  uses Tasks, Panic
{
  let blocked = intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
    mut scheduler.sleep(duration)
  })
  if blocked {
    switch_task(self.scheduler)
  }
}

impl Tasks for SeededTasks
  uses Panic
{
  fn open(self) -> UInt64 {
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      mut scheduler.open()
    })
  }

  fn spawn(self, task_group: UInt64, work: own fn(UInt64), item: UInt64) -> Bool {
    let accepted = intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      scheduler.accepts_tasks(task_group)
    })
    if !accepted {
      return false
    }
    let coroutine = intrinsic::coroutine_start(work, item: item)
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      mut scheduler.add_task(task_group, coroutine: coroutine)
    })
    let switch = switch_task
    switch(self.scheduler)
    true
  }

  fn join(self, task_group: UInt64) {
    while true {
      let joined = intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
        mut scheduler.join(task_group)
      })
      if joined {
        return
      }
      let switch = switch_task
      switch(self.scheduler)
    }
  }

  fn cancel(self, task_group: UInt64) -> Bool {
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      mut scheduler.cancel(task_group)
    })
  }

  fn cancelled(self) -> Bool {
    let switch = switch_task
    switch(self.scheduler)
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      scheduler.tasks[scheduler.running].cancelled
    })
  }

  fn watch(self, key: UInt64) -> UInt64 {
    let switch = switch_task
    switch(self.scheduler)
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      mut scheduler.watch(key)
    })
  }

  fn wait(self, key: UInt64, ticket: UInt64, reason: StringSlice) {
    let blocked = intrinsic::shared_update(
      self.scheduler,
      input: reason.to_string(),
      change: fn(scheduler, description) {
        mut scheduler.wait(key, ticket: ticket, reason: own description)
      },
    )
    if blocked {
      let switch = switch_task
      switch(self.scheduler)
    }
  }

  fn wake(self, key: UInt64) {
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      mut scheduler.wake(key)
    })
  }

  fn lock(self, mutex: UInt64) {
    while true {
      let switch = switch_task
      switch(self.scheduler)
      let locked = intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
        mut scheduler.lock(mutex)
      })
      if locked {
        return
      }
    }
  }

  fn unlock(self, mutex: UInt64) {
    intrinsic::shared_update(self.scheduler, input: 0, change: fn(scheduler, _) {
      mut scheduler.unlock(mutex)
    })
  }

  fn yield_now(self) {
    let switch = switch_task
    switch(self.scheduler)
  }
}

fn counted(count: Int64) -> List[Int64] {
  var numbers: List[Int64] = []
  for number in 0..count {
    mut numbers.push(number)
  }
  numbers
}

fn produce(numbers: Channel[Int64], count: Int64)
  uses Tasks
{
  for number in 0..count {
    let _ = numbers.send(number)
  }
  numbers.close()
}

fn collect[Message: Storable](messages: Channel[Message]) -> List[Message]
  uses Tasks
{
  var received: List[Message] = []
  for message in messages.messages() {
    mut received.push(own message)
  }
  received
}

fn includes(orders: List[List[Int64]], order: List[Int64]) -> Bool {
  for other in orders {
    if other == order {
      return true
    }
  }
  false
}

test "a channel delivers messages in the order they were sent" {
  provide SeededTasks.new(1) {
    let numbers = Channel[Int64].new(capacity: 3)
    assert numbers.send(1) is Ok(_)
    assert numbers.send(2) is Ok(_)
    assert numbers.send(3) is Ok(_)
    assert numbers.receive() == Some(1)
    assert numbers.try_receive() == Some(2)
    assert numbers.receive() == Some(3)
    assert numbers.try_receive() is None
  }
}

test "a copy of a channel refers to the same queue" {
  provide SeededTasks.new(2) {
    let texts = Channel[String].new(capacity: 2)
    let other = texts.copy()
    assert other.send("sent ${1}") is Ok(_)
    assert texts.receive() == Some("sent 1")
    texts.close()
    assert other.send("late") is Err(Closed)
  }
}

test "a closed channel refuses messages and delivers the messages it holds" {
  provide SeededTasks.new(3) {
    let numbers = Channel[Int64].new(capacity: 2)
    assert numbers.send(1) is Ok(_)
    numbers.close()
    assert numbers.send(2) is Err(Closed)
    assert numbers.receive() == Some(1)
    assert numbers.receive() is None
    assert "${SendError.Closed}" == "the channel is closed"
    assert "${SendError.Cancelled}" == "the task was cancelled"
  }
}

fn produce_from(numbers: Channel[Int64], first: Int64, count: Int64)
  uses Tasks
{
  for index in 0..count {
    let _ = numbers.send(first + 2 * index)
  }
}

fn with_parity(numbers: List[Int64], parity: Int64) -> List[Int64] {
  var selected: List[Int64] = []
  for number in numbers {
    if number % 2 == parity {
      mut selected.push(number)
    }
  }
  selected
}

fn stepping(first: Int64, count: Int64) -> List[Int64] {
  var numbers: List[Int64] = []
  for index in 0..count {
    mut numbers.push(first + 2 * index)
  }
  numbers
}

test "the messages of each sender arrive in the order it sent them" {
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let numbers = Channel[Int64].new(capacity: 2)
      concurrent {
        {
          concurrent {
            produce_from(numbers, first: 0, count: 6)
            produce_from(numbers, first: 1, count: 6)
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      assert received.length() == 12
      assert with_parity(received, parity: 0) == stepping(0, count: 6)
      assert with_parity(received, parity: 1) == stepping(1, count: 6)
    }
  }
}

test "send waits while the channel is full and receive waits while it is empty" {
  let capacities: List[USize] = [0, 1, 2, 64]
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    for capacity in capacities {
      provide SeededTasks.new(seed) {
        let numbers = Channel[Int64].new(capacity: capacity)
        concurrent {
          produce(numbers, count: 12)
          let received = collect(numbers)
        }
        assert received == counted(12)
      }
    }
  }
}

test "a send to a channel of capacity 0 returns after a task has received the message" {
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let numbers = Channel[Int64].new()
      concurrent {
        {
          for number in 0..6 {
            assert numbers.send(number) is Ok(_)
            assert numbers.try_receive() is None
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      assert received == counted(6)
    }
  }
}

test "every message of several senders arrives once, in each sender's order" {
  let senders: USize = 4
  let steps: USize = 5
  let seeds: UInt64 = 24
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let numbers = Channel[USize].new(capacity: 2)
      concurrent {
        {
          concurrent for sender in 0..senders {
            for step in 0..steps {
              let _ = numbers.send(sender * 10 + step)
            }
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      var next: List[USize] = [0, 0, 0, 0]
      for number in received {
        let sender = number / 10
        assert sender < 4 && number % 10 == next[sender]
        next[sender] = next[sender] + 1
      }
      assert next == [5, 5, 5, 5]
    }
  }
}

test "the order in which tasks run depends on the seed" {
  var orders: List[List[Int64]] = []
  let seeds: UInt64 = 64
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let numbers = Channel[Int64].new(capacity: 3)
      concurrent for sender in 0..3 {
        let _ = numbers.send(sender)
      }
      numbers.close()
      let order = collect(numbers)
      if !includes(orders, order: order) {
        mut orders.push(own order)
      }
    }
  }
  assert orders.length() == 6
}

test "one seed gives one order" {
  var first: List[Int64] = []
  for attempt in 0..3 {
    provide SeededTasks.new(7) {
      let numbers = Channel[Int64].new(capacity: 8)
      concurrent for sender in 0..8 {
        let _ = numbers.send(sender)
      }
      numbers.close()
      let order = collect(numbers)
      if attempt == 0 {
        first = own order
      } else {
        assert order == first
      }
    }
  }
}

fn receive_or_leave(numbers: Channel[Int64]) -> Int64
  uses Tasks
{
  concurrent {
    {
      let _ = numbers.receive()
      return 1
    }
    return 2
  }
}

test "leaving a concurrent block cancels a task that waits to receive" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      assert receive_or_leave(Channel[Int64].new()) == 2
    }
  }
}

fn send_or_leave(numbers: Channel[Int64], outcomes: Channel[Bool])
  uses Tasks
{
  concurrent {
    {
      let outcome = numbers.send(5)
      let _ = outcomes.send(outcome is Err(Cancelled))
    }
    return
  }
}

test "a cancelled send fails with Cancelled and leaves no message in the channel" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let outcomes = Channel[Bool].new(capacity: 1)
      let unbuffered = Channel[Int64].new()
      send_or_leave(unbuffered, outcomes: outcomes)
      assert outcomes.try_receive() == Some(true)
      assert unbuffered.try_receive() is None
      concurrent {
        produce(unbuffered, count: 3)
        let received = collect(unbuffered)
      }
      assert received == counted(3)

      let full = Channel[Int64].new(capacity: 1)
      assert full.send(4) is Ok(_)
      send_or_leave(full, outcomes: outcomes)
      assert outcomes.try_receive() == Some(true)
      assert full.try_receive() == Some(4)
      assert full.try_receive() is None
    }
  }
}

fn count_until_cancelled() -> Int64
  uses Tasks
{
  var polls = 0
  concurrent {
    {
      while !Tasks.cancelled() {
        polls += 1
      }
      return polls
    }
    return -1
  }
}

test "a task that polls Tasks.cancelled lets the other tasks run" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      assert count_until_cancelled() == -1
    }
  }
}

type StoppedClock(never: Channel[Int64])

impl Clock for StoppedClock
  uses Tasks
{
  fn now(self) -> Instant {
    Instant.from_unix_nanoseconds(0)
  }

  fn monotonic(self) -> Duration {
    Duration.seconds(0)
  }

  fn sleep(self, duration: Duration) {
    let _ = self.never.receive()
  }
}

type InstantClock()

impl Clock for InstantClock {
  fn now(self) -> Instant {
    Instant.from_unix_nanoseconds(0)
  }

  fn monotonic(self) -> Duration {
    Duration.seconds(0)
  }

  fn sleep(self, duration: Duration) {}
}

test "with_timeout returns the output of work that ends before the limit" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      provide StoppedClock(never: Channel[Int64].new()) {
        assert with_timeout(Duration.seconds(1), work: fn() { 7 }) == Some(7)
      }
    }
  }
}

test "with_timeout cancels work that is still waiting at the limit" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed), InstantClock() {
      let never = Channel[Int64].new()
      assert with_timeout(Duration.seconds(1), work: fn() { never.receive() }) is None
    }
  }
}

fn hold_each(limiter: Limiter, events: Channel[Int64])
  uses Tasks
{
  concurrent for _ in 0..6 {
    let _ = limiter.hold(fn() {
      let _ = events.send(1)
      Tasks.yield_now()
      let _ = events.send(-1)
    })
  }
  events.close()
}

test "a limiter runs at most as many tasks at once as it has permits" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let events = Channel[Int64].new(capacity: 12)
      hold_each(Limiter.new(2), events: events)
      var holding = 0
      var most = 0
      var held = 0
      for event in events.messages() {
        holding += event
        if event == 1 {
          held += 1
        }
        if holding > most {
          most = holding
        }
      }
      assert held == 6 && holding == 0 && most <= 2
    }
  }
}

capability Accounts {
  fn deposit(amount: Int64)
  fn balance() -> Int64
}

type Bank(balance: Int64)

impl Accounts for Bank {
  fn deposit(mut self, amount: Int64) {
    self.balance += amount
  }

  fn balance(self) -> Int64 {
    self.balance
  }
}

test "tasks change the state of one capability implementation" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    var bank = Bank(balance: 0)
    provide mut bank, SeededTasks.new(seed) {
      concurrent {
        Accounts.deposit(10)
        Accounts.deposit(5)
        concurrent for amount in 1..=4 {
          Accounts.deposit(amount)
        }
      }
      assert Accounts.balance() == 25
    }
    assert bank.balance == 25
  }
}

type SlowBank(balance: Int64)

impl Accounts for SlowBank
  uses Tasks
{
  fn deposit(mut self, amount: Int64) {
    let before = self.balance
    Tasks.yield_now()
    self.balance = before + amount
  }

  fn balance(self) -> Int64 {
    self.balance
  }
}

test "calls of a `mut` capability implementation are mutually exclusive" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      var bank = SlowBank(balance: 0)
      provide mut bank {
        concurrent for amount in 1..=6 {
          Accounts.deposit(amount)
        }
        assert Accounts.balance() == 21
      }
    }
  }
}

test "tasks spawn tasks of their own" {
  let seeds: UInt64 = 16
  for seed in 0..seeds {
    provide SeededTasks.new(seed) {
      let numbers = Channel[Int64].new(capacity: 4)
      concurrent {
        {
          concurrent for outer in 0..3 {
            concurrent for inner in 0..3 {
              let _ = numbers.send(outer * 3 + inner)
            }
          }
          numbers.close()
        }
        let received = collect(numbers)
      }
      var sum = 0
      for number in received {
        sum += number
      }
      assert received.length() == 9 && sum == 36
    }
  }
}
