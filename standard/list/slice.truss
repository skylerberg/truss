use standard::intrinsic
use standard::core
use standard::list

public fn Slice[Element].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn Slice[Element].get(self, index: USize) lends Option[Element]

  ensures (result is Some(_)) == (index < self.length())
  ensures !(result is Some(element) && !identical(element, self.model()[index]))
  cost time O(1)
{
  if index < self.length() {
    yield Some(self[index])
  } else {
    yield None
  }
}

public fn Slice[Element].first(self) lends Option[Element]

  ensures (result is Some(_)) == (self.length() > 0)
  ensures !(result is Some(element) && !identical(element, self.model()[0]))
  cost time O(1)
{
  if self.length() > 0 {
    yield Some(self[0])
  } else {
    yield None
  }
}

public fn Slice[Element].last(self) lends Option[Element]

  ensures (result is Some(_)) == (self.length() > 0)
  ensures !(result is Some(element) && !identical(element, self.model()[self.length() - 1]))
  cost time O(1)
{
  if self.length() > 0 {
    yield Some(self[self.length() - 1])
  } else {
    yield None
  }
}

public fn Slice[Element].split_first(self) lends Option[list::SplitFirst[Element]]

  ensures (result is Some(_)) == (self.length() > 0)
  cost time O(1)
{
  if self.length() > 0 {
    yield Some(list::SplitFirst(first: self[0], rest: self.slice_range(1, stop: self.length())))
  } else {
    yield None
  }
}

public fn Slice[Element].split_last(self) lends Option[list::SplitLast[Element]]

  ensures (result is Some(_)) == (self.length() > 0)
  cost time O(1)
{
  if self.length() > 0 {
    yield Some(list::SplitLast(last: self[self.length() - 1], rest: self.slice_range(0, stop: self.length() - 1)))
  } else {
    yield None
  }
}

public fn Slice[Element].split_at(self, index: USize) -> core::Pair[Slice[Element], Slice[Element]]
  requires index <= self.length()
  ensures result.first.length() == index
  ensures result.second.length() == self.length() - index
  cost time O(1)
{
  core::Pair(
    first: self.slice_range(0, stop: index),
    second: self.slice_range(index, stop: self.length()),
  )
}

public fn Slice[Element: Equal].contains(self, item: Element) -> Bool

  ensures result == (exists i in 0..self.length() => self.model()[i] == item)
  cost time O(self.length() * time(Element.equal))
{
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    invariant forall i in 0..index => !(self.model()[i] == item)
    decreases self.length() - index
    cost time O(index * time(Element.equal))
  {
    if self[index] == item {
      return true
    }
    index += 1
  }
  false
}

public fn Slice[Element: Equal].index_of(self, item: Element) -> Option[USize]

  ensures match result {
    Some(index) => index < self.length() && self.model()[index] == item
      && (forall i in 0..index => !(self.model()[i] == item))
    None => !self.contains(item)
  }
  cost time O(self.length() * time(Element.equal))
{
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    invariant forall i in 0..index => !(self.model()[i] == item)
    decreases self.length() - index
    cost time O(index * time(Element.equal))
  {
    if self[index] == item {
      return Some(index)
    }
    index += 1
  }
  None
}

public fn Slice[Element: Equal].last_index_of(self, item: Element) -> Option[USize]

  ensures match result {
    Some(index) => index < self.length() && self.model()[index] == item
      && (forall i: USize => index < i && i < self.length() ==> !(self.model()[i] == item))
    None => !self.contains(item)
  }
  cost time O(self.length() * time(Element.equal))
{
  var index = self.length()
  while index > 0
    invariant index <= self.length()
    invariant forall i in index..self.length() => !(self.model()[i] == item)
    decreases index
    cost time O((self.length() - index) * time(Element.equal))
  {
    index -= 1
    if self[index] == item {
      return Some(index)
    }
  }
  None
}

public fn Slice[Element].find_index(self, matching: (fn(Element) -> Bool cost time finite)) -> Option[USize]

  ensures match result {
    Some(index) => index < self.length() && matching(self.model()[index])
      && (forall i in 0..index => !matching(self.model()[i]))
    None => forall i in 0..self.length() => !matching(self.model()[i])
  }
  cost time O(self.length() * time(matching))
{
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    invariant forall i in 0..index => !matching(self.model()[i])
    decreases self.length() - index
    cost time O(index * time(matching))
  {
    if matching(self[index]) {
      return Some(index)
    }
    index += 1
  }
  None
}

public fn Slice[Element: Equal].starts_with(self, prefix: Slice[Element]) -> Bool

  ensures result == (prefix.length() <= self.length()
    && forall i in 0..prefix.length() => self.model()[i] == prefix.model()[i])
  cost time O(prefix.length() * time(Element.equal))
{
  if prefix.length() > self.length() {
    return false
  }
  var index: USize = 0
  while index < prefix.length()
    invariant index <= prefix.length()
    invariant forall i in 0..index => self.model()[i] == prefix.model()[i]
    decreases prefix.length() - index
    cost time O(index * time(Element.equal))
  {
    if self[index] != prefix[index] {
      return false
    }
    index += 1
  }
  true
}

public fn Slice[Element: Equal].ends_with(self, suffix: Slice[Element]) -> Bool

  ensures result == (suffix.length() <= self.length()
    && forall i in 0..suffix.length() => self.model()[self.length() - suffix.length() + i] == suffix.model()[i])
  cost time O(suffix.length() * time(Element.equal))
{
  if suffix.length() > self.length() {
    return false
  }
  let start = self.length() - suffix.length()
  var index: USize = 0
  while index < suffix.length()
    invariant index <= suffix.length()
    invariant forall i in 0..index => self.model()[start + i] == suffix.model()[i]
    decreases suffix.length() - index
    cost time O(index * time(Element.equal))
  {
    if self[start + index] != suffix[index] {
      return false
    }
    index += 1
  }
  true
}

fn failure_table[Element: Equal](needle: Slice[Element]) -> List[USize]
  ensures result.length() == needle.length()
  ensures forall i in 0..result.length() => result.model()[i] <= i
  cost time O(needle.length() * time(Element.equal))
{
  var table: intrinsic::Storage[USize] = intrinsic::storage_with_capacity(needle.length())
  if needle.length() == 0 {
    return List(storage: own table)
  }
  intrinsic::storage_push(mut table, value: 0)
  var matched: USize = 0
  var index: USize = 1
  while index < needle.length()
    invariant 1 <= index
    invariant index <= needle.length()
    invariant matched < index
    invariant intrinsic::storage_length(table) == index
    invariant intrinsic::storage_capacity(table) == needle.length()
    invariant forall i in 0..index => intrinsic::storage_model(table)[i] <= i
    decreases needle.length() - index
    cost time O((4 * index - matched) * time(Element.equal))
  {
    let before = matched
    while matched > 0 && needle[index] != needle[matched]
      invariant matched <= before
      decreases matched
      cost time O((before - matched + 1) * time(Element.equal))
    {
      matched = intrinsic::view_at(intrinsic::storage_view(table), index: matched - 1)
    }
    if needle[index] == needle[matched] {
      matched += 1
    }
    intrinsic::storage_push(mut table, value: matched)
    index += 1
  }
  List(storage: own table)
}

fn matched_after[Element: Equal](
  haystack: Slice[Element],
  needle: Slice[Element],
  table: Slice[USize],
  matched: USize,
  index: USize,
) -> USize
  requires index < haystack.length()
  requires matched < needle.length()
  requires table.length() == needle.length()
  requires forall i in 0..table.length() => table.model()[i] <= i
  ensures result <= matched + 1
  ensures result <= needle.length()
  cost time O((matched + 3 - result) * time(Element.equal))
{
  var current = matched
  while current > 0 && haystack[index] != needle[current]
    invariant current <= matched
    decreases current
    cost time O((matched - current + 1) * time(Element.equal))
  {
    current = table[current - 1]
  }
  if haystack[index] == needle[current] { current + 1 } else { current }
}

fn find_with_table[Element: Equal](haystack: Slice[Element], needle: Slice[Element], table: Slice[USize]) -> Option[USize]
  requires needle.length() > 0
  requires table.length() == needle.length()
  requires forall i in 0..table.length() => table.model()[i] <= i
  ensures match result {
    Some(index) => index + needle.length() <= haystack.length()
    None => true
  }
  cost time O(haystack.length() * time(Element.equal))
{
  var found = false
  var first: USize = 0
  var matched: USize = 0
  var index: USize = 0
  while index < haystack.length() && !found
    invariant index <= haystack.length()
    invariant matched < needle.length()
    invariant matched <= index
    invariant found ==> first + needle.length() <= haystack.length()
    decreases haystack.length() - index
    cost time O((4 * index - matched) * time(Element.equal))
  {
    matched = matched_after(haystack, needle: needle, table: table, matched: matched, index: index)
    index += 1
    if matched == needle.length() {
      found = true
      first = index - matched
      matched = table[matched - 1]
    }
  }
  if found { Some(first) } else { None }
}

public fn Slice[Element: Equal].find_slice(self, needle: Slice[Element]) -> Option[USize]
  ensures match result {
    Some(index) => index + needle.length() <= self.length()
    None => true
  }
  cost time O(self.length() * time(Element.equal) + needle.length() * time(Element.equal))
{
  if needle.length() == 0 {
    return Some(0)
  }
  let table = failure_table(needle)
  find_with_table(self, needle: needle, table: table.slice())
}

public transparent fn Slice[Element: Ordered].is_sorted(self) -> Bool
  cost time finite
{
  forall i in 1..self.length() => self[i - 1] <= self[i]
}

internal theorem at_most_then_less[Element: Ordered](first: Element, second: Element, third: Element)
  requires first <= second
  requires second < third
  ensures first < third
  cost time finite
{
}

internal theorem less_then_at_most[Element: Ordered](first: Element, second: Element, third: Element)
  requires first < second
  requires second <= third
  ensures first < third
  cost time finite
{
}

internal theorem less_is_not_equal[Element: Ordered](first: Element, second: Element)
  requires first < second
  ensures !(first == second)
  ensures !(second == first)
  cost time finite
{
}

internal theorem greater_is_less_reversed[Element: Ordered](first: Element, second: Element)
  requires first.compare(second) == Ordering.Greater
  ensures second < first
  cost time finite
{
}

internal theorem equal_by_compare[Element: Ordered](first: Element, second: Element)
  requires first.compare(second) == Ordering.Equal
  ensures first == second
  cost time finite
{
}

internal theorem equal_is_at_most_reversed[Element: Ordered](first: Element, second: Element)
  requires first.compare(second) == Ordering.Equal
  ensures second <= first
  cost time finite
{
}

internal theorem at_most_is_not_less_reversed[Element: Ordered](first: Element, second: Element)
  requires first <= second
  ensures !(second < first)
  cost time finite
{
}

theorem sorted_between[Element: Ordered](items: Slice[Element], first: USize, second: USize)
  requires items.is_sorted()
  requires first <= second
  requires second < items.length()
  ensures items[first] <= items[second]
  decreases second - first
  cost time finite
{
  if first < second {
    sorted_between(items, first: first, second: second - 1)
    assert items[second - 1] <= items[second]
  }
}

theorem sorted_below[Element: Ordered](items: Slice[Element], target: Element, last: USize, bound: USize)
  requires items.is_sorted()
  requires last < items.length()
  requires bound <= last + 1
  requires bound <= items.length()
  requires items[last] < target
  ensures forall i in 0..bound => items[i] < target
  ensures forall i in 0..items.length() => i < bound ==> !(items.model()[i] == target)
  decreases bound
  cost time finite
{
  if bound > 0 {
    sorted_below(items, target: target, last: last, bound: bound - 1)
    sorted_between(items, first: bound - 1, second: last)
    at_most_then_less(items[bound - 1], second: items[last], third: target)
    less_is_not_equal(items[bound - 1], second: target)
  }
}

theorem sorted_above[Element: Ordered](items: Slice[Element], target: Element, first: USize, bound: USize)
  requires items.is_sorted()
  requires first <= bound
  requires bound <= items.length()
  requires first < items.length()
  requires target < items[first]
  ensures forall i in bound..items.length() => target < items[i]
  ensures forall i in bound..items.length() => !(items.model()[i] == target)
  decreases items.length() - bound
  cost time finite
{
  if bound < items.length() {
    sorted_above(items, target: target, first: first, bound: bound + 1)
    sorted_between(items, first: first, second: bound)
    less_then_at_most(target, second: items[first], third: items[bound])
    less_is_not_equal(target, second: items[bound])
  }
}

public fn Slice[Element: Ordered].binary_search(self, target: Element) -> Option[USize]
  requires forall i in 1..self.length() => self.model()[i - 1] <= self.model()[i]
  ensures match result {
    Some(index) => index < self.length() && self[index] == target
    None => !self.contains(target)
  }
  cost time O(log(self.length()) * time(Element.compare))
{
  proof {
    sorted_from_model(self, bound: self.length())
  }
  var low: USize = 0
  var high = self.length()
  while low < high
    invariant low <= high
    invariant high <= self.length()
    invariant forall i in 0..low => !(self.model()[i] == target)
    invariant forall i in high..self.length() => !(self.model()[i] == target)
    decreases high - low
    cost time O((log(self.length()) - log(high - low)) * time(Element.compare))
  {
    let middle = low + (high - low) / 2
    match self[middle].compare(target) {
      Less => {
        proof {
          sorted_below(self, target: target, last: middle, bound: middle + 1)
        }
        low = middle + 1
      }
      Greater => {
        proof {
          greater_is_less_reversed(self[middle], second: target)
          sorted_above(self, target: target, first: middle, bound: middle)
        }
        high = middle
      }
      Equal => {
        proof {
          equal_by_compare(self[middle], second: target)
        }
        return Some(middle)
      }
    }
  }
  None
}

public fn Slice[Element].partition_point(self, before: (fn(Element) -> Bool cost time finite)) -> USize
  requires forall i in 0..self.length() => forall j in i..self.length() =>
    before(self.model()[j]) ==> before(self.model()[i])
  ensures result <= self.length()
  ensures forall i in 0..result => before(self.model()[i])
  ensures forall i in result..self.length() => !before(self.model()[i])
  cost time O(log(self.length()) * time(before))
{
  var low: USize = 0
  var high = self.length()
  while low < high
    invariant low <= high
    invariant high <= self.length()
    invariant forall i in 0..low => before(self.model()[i])
    invariant forall i in high..self.length() => !before(self.model()[i])
    decreases high - low
    cost time O((log(self.length()) - log(high - low)) * time(before))
  {
    let middle = low + (high - low) / 2
    if before(self[middle]) {
      low = middle + 1
    } else {
      high = middle
    }
  }
  low
}

public fn Slice[Element: Ordered].minimum(self) lends Option[Element]
  ensures (result is Some(_)) == (self.length() > 0)
  cost time O(self.length() * time(Element.compare))
{
  if self.length() == 0 {
    yield None
  } else {
    var best: USize = 0
    for index in 1..self.length()
      invariant best < self.length()
    {
      if self[index] < self[best] {
        best = index
      }
    }
    yield Some(self[best])
  }
}

public fn Slice[Element: Ordered].maximum(self) lends Option[Element]
  ensures (result is Some(_)) == (self.length() > 0)
  cost time O(self.length() * time(Element.compare))
{
  if self.length() == 0 {
    yield None
  } else {
    var best: USize = 0
    for index in 1..self.length()
      invariant best < self.length()
    {
      if self[index] > self[best] {
        best = index
      }
    }
    yield Some(self[best])
  }
}

public fn Slice[Element: Copyable].to_list(self) -> List[Element]
  ensures identical(result.model(), self.model())
  cost time O(self.length() * time(Element.copy))
{
  var copy: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(self.length())
  for index in 0..self.length()
    invariant intrinsic::storage_length(copy) == yielded.length()
    invariant intrinsic::storage_capacity(copy) == self.length()
    invariant forall i in 0..yielded.length() =>
      identical(intrinsic::storage_model(copy)[i], self.model()[i])
  {
    intrinsic::storage_push(mut copy, value: self[index].copy())
  }
  List(storage: own copy)
}

public fn Slice[Element: Copyable].filter(self, keep: (fn(Element) -> Bool cost time finite)) -> List[Element]
  ensures result.length() <= self.length()
  ensures forall i in 0..result.length() => keep(result.model()[i])
  cost time O(self.length() * (time(keep) + time(Element.copy)))
{
  var kept: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(self.length())
  for index in 0..self.length()
    invariant intrinsic::storage_length(kept) <= yielded.length()
    invariant intrinsic::storage_capacity(kept) == self.length()
    invariant forall i in 0..intrinsic::storage_length(kept) => keep(intrinsic::storage_model(kept)[i])
  {
    if keep(self[index]) {
      intrinsic::storage_push(mut kept, value: self[index].copy())
    }
  }
  List(storage: own kept)
}

public fn Slice[Element: Ordered + Copyable].sorted(self) -> List[Element]
  ensures result.length() == self.length()
  ensures result.is_sorted()
  cost time O(self.length() * time(Element.copy) + self.length() * log(self.length()) * time(Element.compare))
{
  var copy = self.to_list()
  mut copy.sort()
  copy
}

public fn Slice[Element: Copyable].repeated(self, times: USize) -> List[Element]
  ensures result.length() == self.length() * times
  cost time O(self.length() * times * time(Element.copy))
{
  if self.length() == 0 || times == 0 {
    return []
  }
  match self.length().checked_multiply(times) {
    Some(total) => {
      var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(total)
      for position in 0..total
        invariant intrinsic::storage_length(elements) == yielded.length()
        invariant intrinsic::storage_capacity(elements) == total
      {
        intrinsic::storage_push(mut elements, value: self[position % self.length()].copy())
      }
      List(storage: own elements)
    }
    None => intrinsic::crash("a list cannot hold that many elements".slice())
  }
}

public fn Slice[Element: Display].join(self, separator: StringSlice) -> String
  cost time finite
{
  var output = TextBuilder.new()
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    decreases self.length() - index
  {
    if index > 0 {
      mut output.write(separator)
    }
    self[index].display(mut output)
    index += 1
  }
  own output.finish()
}

public fn Slice[Element].enumerate(self) yields core::Indexed[Element]

  ensures result.index == yielded.length()
  ensures identical(result.element, self.model()[yielded.length()])
  ensures yielded.length() <= self.length()
  ensures finished ==> yielded.length() == self.length()
  cost time O(self.length())
{
  var index: USize = 0
  while index < self.length()
    invariant index <= self.length()
    invariant yielded.length() == index
    decreases self.length() - index
  {
    yield core::Indexed(index: index, element: self[index])
    index += 1
  }
}

public fn Slice[Element].enumerate(mut self) yields mut core::Indexed[Element]

  cost time O(self.length())
{
  var index: USize = 0
  while index < self.length()
    invariant self.length() == old(self.length())
    invariant index <= self.length()
    decreases self.length() - index
  {
    yield core::Indexed(index: index, element: mut self[index])
    index += 1
  }
}

public fn Slice[Element].reversed(self) yields Element
  ensures finished ==> yielded.length() == self.length()
  cost time O(self.length())
{
  var index = self.length()
  while index > 0
    invariant index <= self.length()
    invariant yielded.length() == self.length() - index
    decreases index
  {
    index -= 1
    yield self[index]
  }
}

public fn Slice[Element].reversed(mut self) yields mut Element
  cost time O(self.length())
{
  var index = self.length()
  while index > 0
    invariant self.length() == old(self.length())
    invariant index <= self.length()
    decreases index
  {
    index -= 1
    yield mut self[index]
  }
}

public fn Slice[Element].windows(self, size: USize) yields Slice[Element]
  requires size > 0
  ensures result.length() == size
  ensures yielded.length() <= self.length()
  cost time O(self.length())
{
  var start: USize = 0
  while size <= self.length() - start
    invariant start <= self.length()
    invariant yielded.length() == start
    decreases self.length() - start
  {
    yield self.slice_range(start, stop: start + size)
    start += 1
  }
}

public fn Slice[Element].chunks(self, size: USize) yields Slice[Element]
  requires size > 0
  ensures result.length() <= size
  ensures yielded.length() <= self.length()
  cost time O(self.length())
{
  var start: USize = 0
  while start < self.length()
    invariant start <= self.length()
    invariant yielded.length() <= start
    decreases self.length() - start
  {
    let stop = if size < self.length() - start { start + size } else { self.length() }
    yield self.slice_range(start, stop: stop)
    start = stop
  }
}

public fn Slice[Element: Equal].split(self, separator: Element) yields Slice[Element]
  ensures yielded.length() <= self.length() + 1
  cost time O(self.length() * time(Element.equal))
{
  var start: USize = 0
  var index: USize = 0
  while index < self.length()
    invariant start <= index
    invariant index <= self.length()
    invariant yielded.length() <= index
    decreases self.length() - index
  {
    if self[index] == separator {
      yield self.slice_range(start, stop: index)
      start = index + 1
    }
    index += 1
  }
  yield self.slice_range(start, stop: self.length())
}

public fn Slice[Element].zip[Other](self, other: Slice[Other]) yields core::Pair[Element, Other]

  ensures identical(result.first, self.model()[yielded.length()])
  ensures identical(result.second, other.model()[yielded.length()])
  ensures yielded.length() <= self.length()
  ensures yielded.length() <= other.length()
  cost time O(self.length())
{
  var index: USize = 0
  while index < self.length() && index < other.length()
    invariant index <= self.length()
    invariant index <= other.length()
    invariant yielded.length() == index
    decreases self.length() - index
  {
    yield core::Pair(first: self[index], second: other[index])
    index += 1
  }
}

public fn Slice[Element].zip[Other](mut self, other: mut Slice[Other]) yields mut core::Pair[Element, Other]

  cost time O(self.length())
{
  var index: USize = 0
  while index < self.length() && index < other.length()
    invariant self.length() == old(self.length())
    invariant other.length() == old(other.length())
    invariant index <= self.length()
    decreases self.length() - index
  {
    yield core::Pair(first: mut self[index], second: mut other[index])
    index += 1
  }
}

public fn Slice[Element].swap(mut self, first: USize, second: USize)
  requires first < self.length()
  requires second < self.length()
  ensures self.length() == old(self.length())
  ensures identical(self.model()[first], old(self.model())[second])
  ensures identical(self.model()[second], old(self.model())[first])
  ensures forall i in 0..self.length() =>
    i == first || i == second || identical(self.model()[i], old(self.model())[i])
  cost time O(1)
{
  intrinsic::view_swap(mut self.elements, first: first, second: second)
}

internal fn Slice[Element].reverse_between(mut self, start: USize, stop: USize)
  requires start <= stop
  requires stop <= self.length()
  ensures self.length() == old(self.length())
  ensures forall i in start..stop => identical(self.model()[i], old(self.model())[start + stop - 1 - i])
  ensures forall i in 0..start => identical(self.model()[i], old(self.model())[i])
  ensures forall i in stop..self.length() => identical(self.model()[i], old(self.model())[i])
  cost time O(stop - start)
{
  var low = start
  var high = stop
  while low + 1 < high
    invariant self.length() == old(self.length())
    invariant start <= low
    invariant high <= stop
    invariant low <= high
    invariant low + high == start + stop
    invariant forall i in start..low => identical(self.model()[i], old(self.model())[start + stop - 1 - i])
    invariant forall i in high..stop => identical(self.model()[i], old(self.model())[start + stop - 1 - i])
    invariant forall i in low..high => identical(self.model()[i], old(self.model())[i])
    invariant forall i in 0..start => identical(self.model()[i], old(self.model())[i])
    invariant forall i in stop..self.length() => identical(self.model()[i], old(self.model())[i])
    decreases high - low
    cost time O(low - start)
  {
    high -= 1
    mut self.swap(low, second: high)
    low += 1
  }
}

public fn Slice[Element].reverse(mut self)
  ensures self.length() == old(self.length())
  ensures forall i in 0..self.length() =>
    identical(self.model()[i], old(self.model())[self.length() - 1 - i])
  cost time O(self.length())
{
  mut self.reverse_between(0, stop: self.length())
}

public fn Slice[Element].rotate_left(mut self, by: USize)
  requires by <= self.length()
  ensures self.length() == old(self.length())
  ensures forall i: Integer =>
    0 <= i && i < self.length() - by ==> identical(self.model()[i], old(self.model())[i + by])
  ensures forall i: Integer =>
    self.length() - by <= i && i < self.length() ==>
      identical(self.model()[i], old(self.model())[i + by - self.length()])
  cost time O(self.length())
{
  mut self.reverse_between(0, stop: by)
  mut self.reverse_between(by, stop: self.length())
  mut self.reverse_between(0, stop: self.length())
}

public fn Slice[Element].rotate_right(mut self, by: USize)
  requires by <= self.length()
  ensures self.length() == old(self.length())
  ensures forall i in by..self.length() => identical(self.model()[i], old(self.model())[i - by])
  ensures forall i in 0..by => identical(self.model()[i], old(self.model())[i + self.length() - by])
  cost time O(self.length())
{
  mut self.rotate_left(self.length() - by)
}

public fn Slice[Element: Copyable].fill(mut self, value: Element)
  ensures self.length() == old(self.length())
  ensures forall i in 0..self.length() => identical(self.model()[i], value)
  cost time O(self.length() * time(Element.copy))
{
  for index in 0..self.length()
    invariant self.length() == old(self.length())
    invariant forall i in 0..yielded.length() => identical(self.model()[i], value)
  {
    self[index] = value.copy()
  }
}

public fn Slice[Element: Copyable].copy_from(mut self, source: Slice[Element])
  requires source.length() == self.length()
  ensures self.length() == old(self.length())
  ensures forall i in 0..self.length() => identical(self.model()[i], source.model()[i])
  cost time O(self.length() * time(Element.copy))
{
  for index in 0..self.length()
    invariant self.length() == old(self.length())
    invariant forall i in 0..yielded.length() => identical(self.model()[i], source.model()[i])
  {
    self[index] = source[index].copy()
  }
}

public fn Slice[Element].update_each[capability Granted](
  mut self,
  change: (fn(mut Element) uses Granted cost time finite),
)
  uses Granted
  ensures self.length() == old(self.length())
  cost calls(change) == self.length()
  cost time O(self.length() * time(change))
{
  for index in 0..self.length()
    invariant self.length() == old(self.length())
  {
    change(mut self[index])
  }
}

fn parent_holds[Element: Ordered](items: Sequence[Element], limit: Integer, parent: Integer) -> Bool
  requires limit <= items.length()
  requires 0 <= parent
  requires parent < limit / 2
  cost time finite
{
  items[2 * parent + 1] <= items[parent] && (2 * parent + 2 >= limit || items[2 * parent + 2] <= items[parent])
}

fn is_heap_from[Element: Ordered](items: Sequence[Element], limit: Integer, floor: Integer) -> Bool
  requires limit <= items.length()
  requires 0 <= floor
  cost time finite
{
  forall parent in floor..limit / 2 => parent_holds(items, limit: limit, parent: parent)
}

fn is_heap_except[Element: Ordered](items: Sequence[Element], limit: Integer, floor: Integer, hole: Integer) -> Bool
  requires limit <= items.length()
  requires 0 <= floor
  cost time finite
{
  forall parent in floor..limit / 2 => parent == hole || parent_holds(items, limit: limit, parent: parent)
}

fn children_are_at_most[Element: Ordered](items: Sequence[Element], limit: Integer, hole: Integer, above: Integer) -> Bool
  requires limit <= items.length()
  requires 0 <= hole
  requires 0 <= above
  requires above < items.length()
  cost time finite
{
  hole >= limit / 2
    || (items[2 * hole + 1] <= items[above] && (2 * hole + 2 >= limit || items[2 * hole + 2] <= items[above]))
}

theorem less_is_at_most[Element: Ordered](first: Element, second: Element)
  requires first < second
  ensures first <= second
  cost time finite
{
}

theorem not_less_is_at_least[Element: Ordered](first: Element, second: Element)
  requires !(first < second)
  ensures second <= first
  cost time finite
{
}

theorem at_most_chain[Element: Ordered](first: Element, second: Element, third: Element)
  requires first <= second
  requires second <= third
  ensures first <= third
  cost time finite
{
}

theorem swap_keeps_heap_except[Element: Ordered](
  before: Slice[Element],
  after: Slice[Element],
  limit: USize,
  floor: USize,
  hole: USize,
  child: USize,
  bound: USize,
)
  requires before.length() == after.length()
  requires limit <= before.length()
  requires floor <= hole
  requires hole < limit / 2
  requires child == 2 * hole + 1 || child == 2 * hole + 2
  requires child < limit
  requires bound <= limit / 2
  requires is_heap_except(before.model(), limit: limit, floor: floor, hole: hole)
  requires hole > floor ==> children_are_at_most(before.model(), limit: limit, hole: hole, above: (hole - 1) / 2)
  requires identical(after.model()[hole], before.model()[child])
  requires identical(after.model()[child], before.model()[hole])
  requires forall i in 0..before.length() => i == hole || i == child || identical(after.model()[i], before.model()[i])
  requires parent_holds(after.model(), limit: limit, parent: hole)
  ensures forall parent in floor..limit =>
    parent >= bound || parent == child || parent_holds(after.model(), limit: limit, parent: parent)
  decreases bound
  cost time finite
{
  if bound > floor {
    swap_keeps_heap_except(
      before,
      after: after,
      limit: limit,
      floor: floor,
      hole: hole,
      child: child,
      bound: bound - 1,
    )
    if bound - 1 != child && bound - 1 != hole {
      assert parent_holds(before.model(), limit: limit, parent: bound - 1)
      assert parent_holds(after.model(), limit: limit, parent: bound - 1)
    }
  }
}

theorem swap_keeps_bound[Element: Ordered](
  before: Slice[Element],
  after: Slice[Element],
  limit: USize,
  top: USize,
  first: USize,
  second: USize,
  bound: USize,
)
  requires before.length() == after.length()
  requires limit <= top
  requires top < before.length()
  requires first < limit
  requires second < limit
  requires bound <= limit
  requires forall i in 0..limit => before[i] <= before[top]
  requires identical(after.model()[first], before.model()[second])
  requires identical(after.model()[second], before.model()[first])
  requires forall i in 0..before.length() => i == first || i == second || identical(after.model()[i], before.model()[i])
  ensures forall i in 0..limit => i >= bound || after[i] <= after[top]
  decreases bound
  cost time finite
{
  if bound > 0 {
    swap_keeps_bound(
      before,
      after: after,
      limit: limit,
      top: top,
      first: first,
      second: second,
      bound: bound - 1,
    )
    assert before[bound - 1] <= before[top]
    assert before[first] <= before[top]
    assert before[second] <= before[top]
    assert after[bound - 1] <= after[top]
  }
}

fn sink_once[Element: Ordered](
  items: mut Slice[Element],
  hole: USize,
  limit: USize,
  floor: USize,
  top: USize,
) -> USize
  requires limit <= items.length()
  requires floor <= hole
  requires hole < limit / 2
  requires is_heap_except(items.model(), limit: limit, floor: floor, hole: hole)
  requires hole <= floor || children_are_at_most(items.model(), limit: limit, hole: hole, above: (hole - 1) / 2)
  requires top >= items.length() || limit <= top
  requires top >= items.length() || (forall i in 0..limit => items[i] <= items[top])
  ensures items.length() == old(items.length())
  ensures result == hole || result == 2 * hole + 1 || result == 2 * hole + 2
  ensures result < limit
  ensures result == hole ==> is_heap_from(items.model(), limit: limit, floor: floor)
  ensures result != hole ==> is_heap_except(items.model(), limit: limit, floor: floor, hole: result)
  ensures result != hole ==> children_are_at_most(items.model(), limit: limit, hole: result, above: hole)
  ensures forall i in limit..items.length() => identical(items.model()[i], old(items.model())[i])
  ensures top < items.length() ==> forall i in 0..limit => items[i] <= items[top]
  cost time O(time(Element.compare))
{
  let left = 2 * hole + 1
  var child = left
  if left + 1 < limit {
    if items[left] < items[left + 1] {
      proof {
        less_is_at_most(items[left], second: items[left + 1])
      }
      child = left + 1
    } else {
      proof {
        not_less_is_at_least(items[left], second: items[left + 1])
      }
    }
  }
  if items[hole] < items[child] {
    proof {
      less_is_at_most(items[hole], second: items[child])
      assert child >= limit / 2 || parent_holds(items.model(), limit: limit, parent: child)
    }
    mut items.swap(hole, second: child)
    proof {
      assert items[child] <= items[hole]
      assert items[left] <= items[hole]
      assert left + 1 >= limit || items[left + 1] <= items[hole]
      assert parent_holds(items.model(), limit: limit, parent: hole)
      swap_keeps_heap_except(
        old(items),
        after: items,
        limit: limit,
        floor: floor,
        hole: hole,
        child: child,
        bound: limit / 2,
      )
      if top < items.length() {
        swap_keeps_bound(
          old(items),
          after: items,
          limit: limit,
          top: top,
          first: hole,
          second: child,
          bound: limit,
        )
      }
    }
    child
  } else {
    proof {
      not_less_is_at_least(items[hole], second: items[child])
      if left + 1 < limit {
        if child == left {
          at_most_chain(items[left + 1], second: items[child], third: items[hole])
        } else {
          at_most_chain(items[left], second: items[child], third: items[hole])
        }
      }
      assert items[left] <= items[hole]
      assert left + 1 >= limit || items[left + 1] <= items[hole]
      assert parent_holds(items.model(), limit: limit, parent: hole)
    }
    hole
  }
}

fn settle[Element: Ordered](items: mut Slice[Element], start: USize, limit: USize, top: USize)
  requires limit <= items.length()
  requires is_heap_except(items.model(), limit: limit, floor: start, hole: start)
  requires top >= items.length() || limit <= top
  requires top >= items.length() || (forall i in 0..limit => items[i] <= items[top])
  ensures items.length() == old(items.length())
  ensures is_heap_from(items.model(), limit: limit, floor: start)
  ensures forall i in limit..items.length() => identical(items.model()[i], old(items.model())[i])
  ensures top < items.length() ==> forall i in 0..limit => items[i] <= items[top]
  cost time O(log(items.length()) * time(Element.compare))
{
  if start >= limit / 2 {
    return
  }
  var hole = start
  var width: USize = 1
  var settled = false
  while !settled && hole < limit / 2
    invariant items.length() == old(items.length())
    invariant start <= hole
    invariant hole < limit
    invariant 1 <= width
    invariant width <= limit
    invariant width <= items.length()
    invariant settled || width - 1 <= hole
    invariant !settled ==> is_heap_except(items.model(), limit: limit, floor: start, hole: hole)
    invariant !settled && hole > start ==> children_are_at_most(items.model(), limit: limit, hole: hole, above: (hole - 1) / 2)
    invariant settled ==> is_heap_from(items.model(), limit: limit, floor: start)
    invariant forall i in limit..items.length() => identical(items.model()[i], old(items.model())[i])
    invariant top < items.length() ==> forall i in 0..limit => items[i] <= items[top]
    decreases limit - hole + (if settled { 0 } else { 1 })
    cost time O(log(width) * time(Element.compare))
  {
    let next = sink_once(mut items, hole: hole, limit: limit, floor: start, top: top)
    width = 2 * width
    if next == hole {
      settled = true
    } else {
      hole = next
    }
  }
}

theorem heap_item_is_at_most_root[Element: Ordered](items: Slice[Element], limit: USize, index: USize)
  requires limit <= items.length()
  requires is_heap_from(items.model(), limit: limit, floor: 0)
  requires index < limit
  ensures items[index] <= items[0]
  decreases index
  cost time finite
{
  if index > 0 {
    let parent = (index - 1) / 2
    heap_item_is_at_most_root(items, limit: limit, index: parent)
    assert parent_holds(items.model(), limit: limit, parent: parent)
    assert index == 2 * parent + 1 || index == 2 * parent + 2
    assert items[index] <= items[parent]
    at_most_chain(items[index], second: items[parent], third: items[0])
  }
}

theorem heap_root_is_largest[Element: Ordered](items: Slice[Element], limit: USize, bound: USize)
  requires limit <= items.length()
  requires is_heap_from(items.model(), limit: limit, floor: 0)
  requires bound <= limit
  ensures forall i in 0..items.length() => i < bound ==> items[i] <= items[0]
  decreases bound
  cost time finite
{
  if bound > 0 {
    heap_root_is_largest(items, limit: limit, bound: bound - 1)
    heap_item_is_at_most_root(items, limit: limit, index: bound - 1)
  }
}

fn build_heap[Element: Ordered](items: mut Slice[Element])
  ensures items.length() == old(items.length())
  ensures is_heap_from(items.model(), limit: items.length(), floor: 0)
  cost time O(items.length() * log(items.length()) * time(Element.compare))
{
  let count = items.length()
  var start = count / 2
  while start > 0
    invariant items.length() == count
    invariant start <= count / 2
    invariant is_heap_from(items.model(), limit: count, floor: start)
    decreases start
    cost time O((count / 2 - start) * log(count) * time(Element.compare))
  {
    start -= 1
    settle(mut items, start: start, limit: count, top: count)
  }
}

theorem moving_root_keeps_heap[Element: Ordered](before: Slice[Element], after: Slice[Element], limit: USize, bound: USize)
  requires before.length() == after.length()
  requires 2 <= limit
  requires limit <= before.length()
  requires bound <= (limit - 1) / 2
  requires is_heap_from(before.model(), limit: limit, floor: 0)
  requires forall i in 0..before.length() => i == 0 || i == limit - 1 || identical(after.model()[i], before.model()[i])
  ensures forall parent in 0..limit => parent >= bound || parent == 0 || parent_holds(after.model(), limit: limit - 1, parent: parent)
  decreases bound
  cost time finite
{
  if bound > 0 {
    moving_root_keeps_heap(before, after: after, limit: limit, bound: bound - 1)
    if bound - 1 != 0 {
      assert parent_holds(before.model(), limit: limit, parent: bound - 1)
      assert parent_holds(after.model(), limit: limit - 1, parent: bound - 1)
    }
  }
}

theorem moved_root_is_largest[Element: Ordered](before: Slice[Element], after: Slice[Element], limit: USize, bound: USize)
  requires before.length() == after.length()
  requires 2 <= limit
  requires limit <= before.length()
  requires bound <= limit - 1
  requires forall i in 0..before.length() => i < limit ==> before[i] <= before[0]
  requires identical(after.model()[0], before.model()[limit - 1])
  requires identical(after.model()[limit - 1], before.model()[0])
  requires forall i in 0..before.length() => i == 0 || i == limit - 1 || identical(after.model()[i], before.model()[i])
  ensures forall i in 0..limit - 1 => i >= bound || after[i] <= after[limit - 1]
  decreases bound
  cost time finite
{
  if bound > 0 {
    moved_root_is_largest(before, after: after, limit: limit, bound: bound - 1)
    assert before[bound - 1] <= before[0]
    assert before[limit - 1] <= before[0]
    assert after[bound - 1] <= after[limit - 1]
  }
}

theorem unchanged_tail_stays_sorted[Element: Ordered](before: Slice[Element], after: Slice[Element], from: USize, bound: USize)
  requires before.length() == after.length()
  requires from <= bound
  requires bound <= before.length()
  requires forall i in 1..before.length() => i > from ==> before[i - 1] <= before[i]
  requires forall i in from..before.length() => identical(after.model()[i], before.model()[i])
  ensures forall i in 1..after.length() => i > from && i < bound ==> after[i - 1] <= after[i]
  decreases bound - from
  cost time finite
{
  if bound > from {
    unchanged_tail_stays_sorted(before, after: after, from: from, bound: bound - 1)
    if bound - 1 > from {
      assert before[bound - 2] <= before[bound - 1]
      assert after[bound - 2] <= after[bound - 1]
    }
  }
}

fn put_largest_last[Element: Ordered](items: mut Slice[Element], unsorted: USize)
  requires 2 <= unsorted
  requires unsorted <= items.length()
  requires is_heap_from(items.model(), limit: unsorted, floor: 0)
  requires unsorted >= items.length() || (forall i in 0..unsorted => items[i] <= items[unsorted])
  ensures items.length() == old(items.length())
  ensures is_heap_except(items.model(), limit: unsorted - 1, floor: 0, hole: 0)
  ensures forall i in 0..unsorted - 1 => items[i] <= items[unsorted - 1]
  ensures identical(items.model()[unsorted - 1], old(items.model())[0])
  ensures forall i in unsorted..items.length() => identical(items.model()[i], old(items.model())[i])
  ensures unsorted >= items.length() || items[unsorted - 1] <= items[unsorted]
  cost time O(1)
{
  let last = unsorted - 1
  proof {
    heap_root_is_largest(items, limit: unsorted, bound: unsorted)
    assert unsorted >= items.length() || items[0] <= items[unsorted]
  }
  mut items.swap(0, second: last)
  proof {
    moving_root_keeps_heap(old(items), after: items, limit: unsorted, bound: last / 2)
    moved_root_is_largest(old(items), after: items, limit: unsorted, bound: last)
  }
}

fn move_largest_to_end[Element: Ordered](items: mut Slice[Element], unsorted: USize)
  requires 2 <= unsorted
  requires unsorted <= items.length()
  requires is_heap_from(items.model(), limit: unsorted, floor: 0)
  requires forall i in 1..items.length() => i <= unsorted || items[i - 1] <= items[i]
  requires unsorted >= items.length() || (forall i in 0..unsorted => items[i] <= items[unsorted])
  ensures items.length() == old(items.length())
  ensures is_heap_from(items.model(), limit: unsorted - 1, floor: 0)
  ensures forall i in 1..items.length() => i > unsorted - 1 ==> items[i - 1] <= items[i]
  ensures forall i in 0..unsorted - 1 => items[i] <= items[unsorted - 1]
  cost time O(log(items.length()) * time(Element.compare))
{
  put_largest_last(mut items, unsorted: unsorted)
  settle(mut items, start: 0, limit: unsorted - 1, top: unsorted - 1)
  proof {
    assert forall i in unsorted..items.length() => identical(items.model()[i], old(items.model())[i])
    unchanged_tail_stays_sorted(old(items), after: items, from: unsorted, bound: items.length())
    assert unsorted >= items.length() || items[unsorted - 1] <= items[unsorted]
  }
}

fn drain_heap[Element: Ordered](items: mut Slice[Element])
  requires is_heap_from(items.model(), limit: items.length(), floor: 0)
  ensures items.length() == old(items.length())
  ensures items.is_sorted()
  cost time O(items.length() * log(items.length()) * time(Element.compare))
{
  let count = items.length()
  var unsorted = count
  while unsorted >= 2
    invariant items.length() == count
    invariant unsorted <= count
    invariant is_heap_from(items.model(), limit: unsorted, floor: 0)
    invariant forall i in 1..count => i > unsorted ==> items[i - 1] <= items[i]
    invariant unsorted < count ==> forall i in 0..unsorted => items[i] <= items[unsorted]
    decreases unsorted
    cost time O((count - unsorted) * log(count) * time(Element.compare))
  {
    move_largest_to_end(mut items, unsorted: unsorted)
    unsorted -= 1
  }
}

theorem sorted_in_model[Element: Ordered](items: Slice[Element], bound: USize)
  requires items.is_sorted()
  requires bound <= items.length()
  ensures forall i in 1..items.length() => i < bound ==> items.model()[i - 1] <= items.model()[i]
  decreases bound
  cost time finite
{
  if bound > 1 {
    sorted_in_model(items, bound: bound - 1)
    assert items[bound - 2] <= items[bound - 1]
    assert items.model()[bound - 2] <= items.model()[bound - 1]
  }
}

public theorem is_sorted_orders_model[Element: Ordered](items: Slice[Element])
  requires items.is_sorted()
  ensures forall i in 1..items.length() => items.model()[i - 1] <= items.model()[i]
  cost time finite
{
  sorted_in_model(items, bound: items.length())
}

internal theorem sorted_from_model[Element: Ordered](items: Slice[Element], bound: USize)
  requires forall i in 1..items.length() => items.model()[i - 1] <= items.model()[i]
  requires bound <= items.length()
  ensures forall i in 1..items.length() => i < bound ==> items[i - 1] <= items[i]
  decreases bound
  cost time finite
{
  if bound > 1 {
    sorted_from_model(items, bound: bound - 1)
    assert items.model()[bound - 2] <= items.model()[bound - 1]
    assert items[bound - 2] <= items[bound - 1]
  }
}

public fn Slice[Element: Ordered].sort(mut self)
  ensures self.length() == old(self.length())
  ensures self.is_sorted()
  ensures forall i in 1..self.length() => self.model()[i - 1] <= self.model()[i]
  cost time O(self.length() * log(self.length()) * time(Element.compare))
{
  build_heap(mut self)
  drain_heap(mut self)
  proof {
    sorted_in_model(self, bound: self.length())
  }
}

fn sift_down_by[Element](
  items: mut Slice[Element],
  position: USize,
  limit: USize,
  room: USize,
  compare: (fn(Element, Element) -> Ordering cost time finite),
)
  requires 1 <= position
  requires limit <= items.length()
  ensures items.length() == old(items.length())
  decreases room
  cost time O(log(room) * time(compare))
{
  if room >= 2 && position <= limit / 2 {
    var largest = 2 * position
    if largest < limit && compare(items[largest - 1], items[largest]) == Ordering.Less {
      largest = largest + 1
    }
    if compare(items[position - 1], items[largest - 1]) == Ordering.Less {
      mut items.swap(position - 1, second: largest - 1)
      sift_down_by(mut items, position: largest, limit: limit, room: room / 2, compare: compare)
    }
  }
}

fn build_heap_by[Element](items: mut Slice[Element], compare: (fn(Element, Element) -> Ordering cost time finite))
  ensures items.length() == old(items.length())
  cost time O(items.length() * log(items.length()) * time(compare))
{
  let count = items.length()
  var position = count / 2
  while position >= 1
    invariant items.length() == count
    invariant position <= count / 2
    decreases position
    cost time O((count / 2 - position) * log(count) * time(compare))
  {
    sift_down_by(mut items, position: position, limit: count, room: count, compare: compare)
    position -= 1
  }
}

fn drain_heap_by[Element](items: mut Slice[Element], compare: (fn(Element, Element) -> Ordering cost time finite))
  ensures items.length() == old(items.length())
  cost time O(items.length() * log(items.length()) * time(compare))
{
  let count = items.length()
  var unsorted = count
  while unsorted >= 2
    invariant items.length() == count
    invariant unsorted <= count
    decreases unsorted
    cost time O((count - unsorted) * log(count) * time(compare))
  {
    unsorted -= 1
    mut items.swap(0, second: unsorted)
    sift_down_by(mut items, position: 1, limit: unsorted, room: count, compare: compare)
  }
}

public fn Slice[Element].sort_by(mut self, compare: (fn(Element, Element) -> Ordering cost time finite))
  ensures self.length() == old(self.length())
  cost time O(self.length() * log(self.length()) * time(compare))
{
  build_heap_by(mut self, compare: compare)
  drain_heap_by(mut self, compare: compare)
}

public fn Slice[Element].sort_by_key[Key: Ordered](mut self, key: (fn(Element) -> Key cost time finite))
  ensures self.length() == old(self.length())
  cost time finite
{
  mut self.sort_by(fn(first, second) { key(first).compare(key(second)) })
}

internal fn Slice[Element].extreme_position(
  self,
  compare: (fn(Element, Element) -> Ordering cost time finite),
  greatest: Bool,
) -> USize
  requires self.length() > 0
  ensures result < self.length()
  cost time O(self.length() * time(compare))
{
  var best: USize = 0
  var index: USize = 1
  while index < self.length()
    invariant best < index
    invariant 1 <= index
    invariant index <= self.length()
    decreases self.length() - index
    cost time O(index * time(compare))
  {
    let order = compare(self[index], self[best])
    if (greatest && order != Ordering.Less) || (!greatest && order == Ordering.Less) {
      best = index
    }
    index += 1
  }
  best
}

public fn Slice[Element].min_by(
  self,
  compare: (fn(Element, Element) -> Ordering cost time finite),
) lends Option[Element]
  ensures (result is Some(_)) == (self.length() > 0)
  cost time O(self.length() * time(compare))
{
  if self.length() > 0 {
    let position = self.extreme_position(compare, greatest: false)
    yield Some(self[position])
  } else {
    yield None
  }
}

public fn Slice[Element].max_by(
  self,
  compare: (fn(Element, Element) -> Ordering cost time finite),
) lends Option[Element]
  ensures (result is Some(_)) == (self.length() > 0)
  cost time O(self.length() * time(compare))
{
  if self.length() > 0 {
    let position = self.extreme_position(compare, greatest: true)
    yield Some(self[position])
  } else {
    yield None
  }
}

impl Equal for Slice[Element: Equal] {
  fn equal(self, other: Slice[Element]) -> Bool
    ensures result == (self.length() == other.length()
      && forall i in 0..self.length() => self.model()[i] == other.model()[i])
  {
    if self.length() != other.length() {
      return false
    }
    var index: USize = 0
    while index < self.length()
      invariant index <= self.length()
      invariant forall i in 0..index => self.model()[i] == other.model()[i]
      decreases self.length() - index
    {
      if self[index] != other[index] {
        return false
      }
      index += 1
    }
    true
  }
}

public transparent fn lexicographic[Element: Ordered](
  first: Sequence[Element],
  second: Sequence[Element],
  from: Integer,
) -> Ordering
  requires 0 <= from
  decreases first.length() - from
  cost time finite
{
  if from < first.length() && from < second.length() {
    if first[from].compare(second[from]) == Ordering.Equal {
      lexicographic(first, second: second, from: from + 1)
    } else {
      first[from].compare(second[from])
    }
  } else if first.length() < second.length() {
    Ordering.Less
  } else if first.length() > second.length() {
    Ordering.Greater
  } else {
    Ordering.Equal
  }
}

internal theorem lexicographic_agrees_with_equal[Element: Ordered](
  first: Sequence[Element],
  second: Sequence[Element],
  from: Integer,
)
  requires 0 <= from
  ensures (lexicographic(first, second: second, from: from) == Ordering.Equal)
    == (first.length() == second.length() && forall i in from..first.length() => first[i] == second[i])
  decreases first.length() - from
  cost time finite
{
  if from < first.length() && from < second.length() {
    lexicographic_agrees_with_equal(first, second: second, from: from + 1)
    assert (first[from].compare(second[from]) == Ordering.Equal) == (first[from] == second[from])
  }
}

internal theorem lexicographic_is_antisymmetric[Element: Ordered](
  first: Sequence[Element],
  second: Sequence[Element],
  from: Integer,
)
  requires 0 <= from
  ensures (lexicographic(first, second: second, from: from) == Ordering.Less)
    == (lexicographic(first: second, second: first, from: from) == Ordering.Greater)
  decreases first.length() - from
  cost time finite
{
  if from < first.length() && from < second.length() {
    assert (first[from].compare(second[from]) == Ordering.Less)
      == (second[from].compare(first[from]) == Ordering.Greater)
    assert (second[from].compare(first[from]) == Ordering.Less)
      == (first[from].compare(second[from]) == Ordering.Greater)
    lexicographic_is_antisymmetric(first, second: second, from: from + 1)
  }
}

internal theorem lexicographic_is_transitive[Element: Ordered](
  first: Sequence[Element],
  second: Sequence[Element],
  third: Sequence[Element],
  from: Integer,
)
  requires 0 <= from
  requires lexicographic(first, second: second, from: from) != Ordering.Greater
  requires lexicographic(first: second, second: third, from: from) != Ordering.Greater
  ensures lexicographic(first, second: third, from: from) != Ordering.Greater
  decreases first.length() - from
  cost time finite
{
  if from < first.length() && from < second.length() && from < third.length() {
    assert first[from] <= second[from]
    assert second[from] <= third[from]
    assert first[from] <= third[from]
    if first[from].compare(third[from]) == Ordering.Equal {
      assert third[from] <= first[from]
      assert second[from] <= first[from]
      assert third[from] <= second[from]
      lexicographic_is_transitive(first, second: second, third: third, from: from + 1)
    }
  }
}

impl Ordered for Slice[Element: Ordered] {
  fn compare(self, other: Slice[Element]) -> Ordering
    ensures result == lexicographic(self.model(), second: other.model(), from: 0)
  {
    var index: USize = 0
    while index < self.length() && index < other.length()
      invariant index <= self.length()
      invariant index <= other.length()
      invariant lexicographic(self.model(), second: other.model(), from: 0)
        == lexicographic(self.model(), second: other.model(), from: index)
      decreases self.length() - index
    {
      let order = self[index].compare(other[index])
      if order != Ordering.Equal {
        return order
      }
      index += 1
    }
    self.length().compare(other.length())
  }
}

proof Ordered.agrees_with_equal for Slice[Element: Ordered] {
  lexicographic_agrees_with_equal(first.model(), second: second.model(), from: 0)
}

proof Ordered.antisymmetric for Slice[Element: Ordered] {
  lexicographic_is_antisymmetric(first.model(), second: second.model(), from: 0)
}

proof Ordered.transitive for Slice[Element: Ordered] {
  lexicographic_is_transitive(first.model(), second: second.model(), third: third.model(), from: 0)
}

impl Hash for Slice[Element: Hash] {
  fn hash(self, hasher: mut Hasher)
  {
    mut hasher.write(intrinsic::convert(self.length()))
    for index in 0..self.length() {
      self[index].hash(mut hasher)
    }
  }
}

impl Display for Slice[Element: Display] {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("[")
    for index in 0..self.length() {
      if index > 0 {
        mut output.write(", ")
      }
      self[index].display(mut output)
    }
    mut output.write("]")
  }
}
