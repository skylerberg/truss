public fn Array[Element, count: USize].length(self) -> USize
  ensures result == count
  cost time O(1)
  cost allocations == 0
{
  count
}

public fn Array[Element, count: USize].slice(self) -> Slice[Element]
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::array_view(self))
}

internal fn Array[Element, count: USize].slice_range(self, start: USize, stop: USize) -> Slice[Element]
  requires start <= stop
  requires stop <= count
  ensures result.length() == stop - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice().slice_range(start, stop: stop)
}

impl Model for Array[Element, count: USize] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::array_model(self)
  }
}

impl Index for Array[Element, count: USize] {
  type Key = USize
  type Output = Element

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    key < count
  }

  fn at(self, key: USize) lends Element
    requires key < count
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    yield intrinsic::view_at(intrinsic::array_view(self), index: key)
  }

  fn at(mut self, key: USize) lends mut Element
    requires key < count
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
    cost allocations == 0
  {
    yield intrinsic::array_at_mut(mut self, index: key)
  }
}

