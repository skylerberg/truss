use standard::intrinsic
use standard::list::slice

public fn Array[Element: Copyable, count: USize].filled(value: Element) -> Array[Element, count]
  ensures forall i in 0..count => identical(result.model()[i], value)
  cost time O(count * time(Element.copy))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], value)
  {
    intrinsic::storage_push(mut elements, value: value.copy())
  }
  intrinsic::array_from_storage(own elements)
}

public fn Array[Element, count: USize].generate(
  make: (fn(index: USize) -> Element requires index < count cost time finite),
) -> Array[Element, count]
  ensures forall i in 0..count => identical(result.model()[i], make(i))
  cost calls(make) == count
  cost time O(count * time(make))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], make(i))
  {
    intrinsic::storage_push(mut elements, value: make(index))
  }
  intrinsic::array_from_storage(own elements)
}

public fn Array[Element, count: USize].length(self) -> USize
  ensures result == count
  cost time O(1)
  cost allocations == 0
{
  count
}

public fn Array[Element, count: USize].slice(self) -> Slice[Element]
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::array_view(self))
}

internal fn Array[Element, count: USize].slice_range(self, start: USize, stop: USize) -> Slice[Element]
  requires start <= stop
  requires stop <= count
  ensures result.length() == stop - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice().slice_range(start, stop: stop)
}

internal fn Array[Element, count: USize].slice_from(self, start: USize) -> Slice[Element]
  requires start <= count
  ensures result.length() == count - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice_range(start, stop: count)
}

impl Model for Array[Element, count: USize] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::array_model(self)
  }
}

impl Index for Array[Element, count: USize] {
  type Key = USize
  type Output = Element

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    key < count
  }

  fn at(self, key: USize) lends Element
    requires key < count
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    yield intrinsic::view_at(intrinsic::array_view(self), index: key)
  }

  fn at(mut self, key: USize) lends mut Element
    requires key < count
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
    cost allocations == 0
  {
    yield intrinsic::array_at_mut(mut self, index: key)
  }
}

impl Iterable for Array[Element, count: USize] {
  type Element = Element

  fn each(self) yields Element
    ensures identical(result, self.model()[yielded.length()])
    ensures yielded.length() <= count
    ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    ensures finished ==> yielded.length() == count
    ensures finished ==> identical(yielded, self.model())
    cost time O(count)
  {
    var index: USize = 0
    while index < count
      invariant index <= count
      invariant yielded.length() == index
      invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
      decreases count - index
    {
      yield self[index]
      index += 1
    }
  }
}

public fn Array[Element, count: USize].each(mut self) yields mut Element
  cost time O(count)
{
  for index in 0..count {
    yield mut self[index]
  }
}

public fn Array[Element, count: USize].each(own self) yields own Element
  ensures identical(result, self.model()[yielded.length()])
  ensures yielded.length() <= count
  ensures forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
  ensures finished ==> yielded.length() == count
  ensures finished ==> identical(yielded, self.model())
  cost time O(count)
{
  var remaining = own self.to_list()
  mut remaining.reverse()
  while remaining.length() > 0
    invariant remaining.length() + yielded.length() == count
    invariant forall i in 0..remaining.length() =>
      identical(remaining.model()[i], self.model()[count - 1 - i])
    invariant forall i in 0..yielded.length() => identical(yielded[i], self.model()[i])
    decreases remaining.length()
  {
    yield intrinsic::storage_pop(mut remaining.storage)
  }
}

public fn Array[Element, count: USize].map_each[Output, capability Granted](
  own self,
  transform: (fn(own Element) -> Output uses Granted cost time finite),
) -> Array[Output, count]
  uses Granted
  cost calls(transform) == count
  cost time O(count * time(transform))
{
  var remaining = own self.to_list()
  mut remaining.reverse()
  var outputs: intrinsic::Storage[Output] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant remaining.length() + index == count
    invariant intrinsic::storage_length(outputs) == index
    invariant intrinsic::storage_capacity(outputs) == count
  {
    var item = intrinsic::storage_pop(mut remaining.storage)
    intrinsic::storage_push(mut outputs, value: transform(own item))
  }
  intrinsic::array_from_storage(own outputs)
}

impl Equal for Array[Element: Equal, count: USize] {
  fn equal(self, other: Array[Element, count]) -> Bool
    ensures result == (forall i in 0..count => self.model()[i] == other.model()[i])
  {
    self.slice() == other.slice()
  }
}

impl Ordered for Array[Element: Ordered, count: USize] {
  fn compare(self, other: Array[Element, count]) -> Ordering
    ensures result == slice::lexicographic(self.model(), second: other.model(), from: 0)
  {
    self.slice().compare(other.slice())
  }
}

proof Ordered.agrees_with_equal for Array[Element: Ordered, count: USize] {
  slice::lexicographic_agrees_with_equal(first.model(), second: second.model(), from: 0)
}

proof Ordered.antisymmetric for Array[Element: Ordered, count: USize] {
  slice::lexicographic_is_antisymmetric(first.model(), second: second.model(), from: 0)
}

proof Ordered.transitive for Array[Element: Ordered, count: USize] {
  slice::lexicographic_is_transitive(first.model(), second: second.model(), third: third.model(), from: 0)
}

impl Hash for Array[Element: Hash, count: USize] {
  fn hash(self, hasher: mut Hasher)
  {
    self.slice().hash(mut hasher)
  }
}

impl Display for Array[Element: Display, count: USize] {
  fn display(self, output: mut TextBuilder)
  {
    self.slice().display(mut output)
  }
}

fn same_items(actual: Slice[Int64], expected: Slice[Int64]) -> Bool {
  if actual.length() != expected.length() {
    return false
  }
  for index in 0..actual.length() {
    if actual[index] != expected[index] {
      return false
    }
  }
  true
}

test "a loop goes over an array's elements in order, and can change them" {
  let fixed: Array[Int64, 4] = [1, 2, 3, 4]
  var total = 0
  var last = 0
  for item in fixed {
    total += item
    last = item
  }
  assert total == 10
  assert last == 4
  var changed: Array[Int64, 3] = [1, 2, 3]
  for item in mut changed {
    item = item * 10
  }
  assert same_items(changed[..], expected: [10, 20, 30])
  let words: Array[String, 2] = ["a${1}", "bb${2}"]
  var lengths: USize = 0
  for word in words {
    lengths += word.length()
  }
  assert lengths == 5
}

test "an array is swapped, reversed, and rotated in place" {
  var fixed: Array[Int64, 5] = [1, 2, 3, 4, 5]
  mut fixed.swap(0, second: 4)
  assert same_items(fixed[..], expected: [5, 2, 3, 4, 1])
  mut fixed.reverse()
  assert same_items(fixed[..], expected: [1, 4, 3, 2, 5])
  mut fixed.rotate_left(2)
  assert same_items(fixed[..], expected: [3, 2, 5, 1, 4])
  mut fixed.rotate_right(1)
  assert same_items(fixed[..], expected: [4, 3, 2, 5, 1])
}

test "fill, copy_from, and update_each replace an array's elements" {
  var fixed: Array[Int64, 3] = [1, 2, 3]
  mut fixed.fill(7)
  assert same_items(fixed[..], expected: [7, 7, 7])
  let source: List[Int64] = [4, 5, 6]
  mut fixed.copy_from(source)
  assert same_items(fixed[..], expected: [4, 5, 6])
  mut fixed.update_each(fn(item) { item = item - 4 })
  assert same_items(fixed[..], expected: [0, 1, 2])
}

test "an array lends its elements to change with their indexes, in pairs, and back to front" {
  var fixed: Array[Int64, 3] = [10, 20, 30]
  for entry in mut fixed.enumerate() {
    if entry.index == 2 {
      entry.element = 0
    }
  }
  assert same_items(fixed[..], expected: [10, 20, 0])
  var other: List[Int64] = [1, 2, 3]
  for pair in mut fixed.zip(mut other[..]) {
    pair.first = pair.first + pair.second
    pair.second = 0
  }
  assert same_items(fixed[..], expected: [11, 22, 3])
  assert same_items(other, expected: [0, 0, 0])
  var next = 1
  for item in mut fixed.reversed() {
    item = next
    next += 1
  }
  assert same_items(fixed[..], expected: [3, 2, 1])
}

test "an array is made of copies of one value, or of what a function gives for each index" {
  let zeros: Array[Int64, 4] = Array.filled(0)
  assert same_items(zeros[..], expected: [0, 0, 0, 0])
  let words: Array[String, 3] = Array.filled("ab${1}")
  assert words[0] == "ab1"
  assert words[2] == "ab1"
  let squares: Array[Int64, 5] = Array.generate(fn(index) { counted_square(index) })
  assert same_items(squares[..], expected: [0, 1, 4, 9, 16])
  let none: Array[Int64, 0] = Array.filled(7)
  assert none[..].length() == 0
}

fn counted_square(index: USize) -> Int64 {
  var total = 0
  for _ in 0..index {
    for _ in 0..index {
      total += 1
    }
  }
  total
}

test "an array's elements are each given to a function, which makes a new array" {
  let numbers: Array[Int64, 3] = [1, 2, 3]
  let doubled: Array[Int64, 3] = numbers.map_each(fn(item) { item * 2 })
  assert same_items(doubled[..], expected: [2, 4, 6])
  let words: Array[String, 2] = ["a${1}", "bb${2}"]
  let lengths: Array[USize, 2] = own words.map_each(fn(word) { word.length() })
  assert lengths[0] == 2
  assert lengths[1] == 3
}

test "an array is searched, joined, and sorted by a comparison" {
  var numbers: Array[Int64, 6] = [4, 1, 5, 2, 6, 3]
  assert numbers.find_slice([5, 2][..]) == Some(2)
  assert numbers.find_slice([2, 5][..]) is None
  assert numbers.join("+") == "4+1+5+2+6+3"
  mut numbers.sort_by(fn(first, second) { first.compare(second) })
  assert numbers == [1, 2, 3, 4, 5, 6]
  assert numbers.binary_search(4) == Some(3)
  assert numbers.binary_search(7) is None
}

test "an array is sorted in place, by key, and into a list" {
  var numbers: Array[Int64, 6] = [4, 1, 5, 2, 6, 3]
  assert numbers.sorted() == [1, 2, 3, 4, 5, 6]
  assert numbers == [4, 1, 5, 2, 6, 3]
  mut numbers.sort_by_key(fn(number) { -number })
  assert numbers == [6, 5, 4, 3, 2, 1]
  mut numbers.sort()
  assert numbers == [1, 2, 3, 4, 5, 6] && numbers.is_sorted()
}

test "an array lends its least and its greatest element by a comparison" {
  let numbers: Array[Int64, 5] = [5, 3, 8, 1, 8]
  assert numbers.min_by(fn(first, second) { first.compare(second) }) == Some(1)
  assert numbers.max_by(fn(first, second) { first.compare(second) }) == Some(8)
}
test "arrays are ordered by their first different element" {
  let low: Array[Int64, 3] = [1, 2, 3]
  let high: Array[Int64, 3] = [1, 3, 0]
  assert low.compare(high) == Ordering.Less && high.compare(low) == Ordering.Greater
  assert low.compare(low.copy()) == Ordering.Equal
  assert low < high && high >= low
}
