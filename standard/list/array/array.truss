use standard::intrinsic
use standard::list::slice

public fn Array[Element: Copyable, count: UInt64].filled(value: Element) -> Array[Element, count]
  ensures forall i in 0..count => identical(result.model()[i], value)
  cost time O(count * time(Element.copy))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], value)
  {
    intrinsic::storage_push(mut elements, value: value.copy())
  }
  intrinsic::array_from_storage(own elements)
}

public fn Array[Element, count: UInt64].generate(
  make: (fn(index: UInt64) -> Element uses generic Granted requires index < count),
) -> Array[Element, count]
  uses generic Granted
  ensures forall i in 0..count => make.ensures(i, result.model()[i])
  cost calls(make) == count
  cost time O(count * time(make))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => make.ensures(i, intrinsic::storage_model(elements)[i])
  {
    intrinsic::storage_push(mut elements, value: make(index))
  }
  intrinsic::array_from_storage(own elements)
}

public fn Array[Element, count: UInt64].length(self) -> UInt64
  ensures result == count
  cost time O(1)
  cost allocations == 0
{
  count
}

public fn Array[Element, count: UInt64].slice(self) -> Slice[Element]
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::array_view(self))
}

impl Model for Array[Element, count: UInt64] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    ensures identical(result, intrinsic::array_model(self))
  {
    intrinsic::array_model(self)
  }
}

impl Index for Array[Element, count: UInt64] {
  type Key = UInt64
  type Output = Element

  fn contains_key(self, key: UInt64) -> Bool
    ensures result == (key < count)
    cost time O(1)
    cost allocations == 0
  {
    key < count
  }

  fn at(self, key: UInt64) lends Element
    requires key < count
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    self[key]
  }
}

impl IndexMut for Array[Element, count: UInt64] {
  fn at(mut self, key: UInt64) lends mut Element
    requires key < count
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: final(result)))
    cost time O(1)
    cost allocations == 0
  {
    mut self[key]
  }
}

impl Iterable for Array[Element, count: UInt64] {
  type Element = Element

  fn count(self) -> UInt64
    ensures result == count
    cost time O(1)
    cost allocations == 0
  {
    count
  }

  fn element(self, position: UInt64) lends Element
    requires position < self.count()
    ensures identical(result, self.model()[position])
    cost time O(1)
    cost allocations == 0
  {
    self[position]
  }
}

public fn Array[Element, count: UInt64].element(mut self, position: UInt64) lends mut Element
  uses Panic unless position < self.count()
  ensures identical(result, old(self.model())[position])
  ensures identical(self.model(), old(self.model()).update(position, value: final(result)))
  cost time O(1)
  cost allocations == 0
{
  if position >= self.count() {
    Panic.crash("index out of bounds")
  }
  mut self[position]
}

public fn Array[Element, count: UInt64].map_each[Output](
  own self,
  transform: (fn(element: own Element) -> Output uses generic Granted
    requires self.model().contains(element)),
) -> Array[Output, count]
  uses generic Granted
  ensures forall i in 0..count => transform.ensures(self.model()[i], result.model()[i])
  cost calls(transform) == count
  cost time O(count * time(transform))
{
  var remaining = own self.to_list()
  mut remaining.reverse()
  var outputs: intrinsic::Storage[Output] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant remaining.length() + index == count
    invariant intrinsic::storage_length(outputs) == index
    invariant intrinsic::storage_capacity(outputs) == count
    invariant forall i in 0..remaining.length() =>
      identical(remaining.model()[i], old(self.model())[count - 1 - i])
    invariant forall i in 0..index =>
      transform.ensures(old(self.model())[i], intrinsic::storage_model(outputs)[i])
  {
    var item = intrinsic::storage_pop(mut remaining.storage)
    intrinsic::storage_push(mut outputs, value: transform(own item))
  }
  intrinsic::array_from_storage(own outputs)
}

impl Equal for Array[Element: Equal, count: UInt64] {
  fn equal(self, other: Array[Element, count]) -> Bool
    ensures result == (forall i in 0..count => self.model()[i] == other.model()[i])
    cost time O(count * time(Element.equal))
    cost allocations <= count * allocations(Element.equal)
  {
    self.slice() == other.slice()
  }
}

impl Ordered for Array[Element: Ordered, count: UInt64] {
  fn compare(self, other: Array[Element, count]) -> Ordering
    ensures result == slice::lexicographic(self.model(), second: other.model(), from: 0)
    cost time O(count * time(Element.compare))
    cost allocations <= count * allocations(Element.compare)
  {
    self.slice().compare(other.slice())
  }
}

proof Ordered.agrees_with_equal for Array[Element: Ordered, count: UInt64] {
  slice::lexicographic_agrees_with_equal(first.model(), second: second.model(), from: 0)
}

proof Ordered.antisymmetric for Array[Element: Ordered, count: UInt64] {
  slice::lexicographic_is_antisymmetric(first.model(), second: second.model(), from: 0)
}

proof Ordered.transitive for Array[Element: Ordered, count: UInt64] {
  slice::lexicographic_is_transitive(first.model(), second: second.model(), third: third.model(), from: 0)
}

impl Hash for Array[Element: Hash, count: UInt64] {
  fn hash(self, hasher: Hasher) -> Hasher
    ensures identical(result, slice::hash_elements(hasher.write(count), items: self.model(), count: count))
    cost time O(count * time(Element.hash))
    cost allocations <= count * allocations(Element.hash)
  {
    self.slice().hash(hasher)
  }
}

proof Hash.agrees_with_equal for Array[Element: Hash, count: UInt64] {
  slice::elements_hash_alike(hasher.write(count), first: first.model(), second: second.model(), count: count)
}

impl Display for Array[Element: Display, count: UInt64] {
  fn display(self, output: mut String)
  {
    self.slice().display(mut output)
  }
}
