use standard::core
use standard::growth
use standard::intrinsic
use standard::list::slice

public opaque type List[Element](storage: intrinsic::Storage[Element])
  derives Copyable

public opaque type Slice[Element](elements: intrinsic::View[Element])
  derives Plain

public type SplitFirst[Element](first: Element, rest: Slice[Element])

public type SplitLast[Element](last: Element, rest: Slice[Element])

public type Enumerated[Element](elements: Slice[Element])

impl Iterable for Enumerated[Element] {
  type Element = core::Indexed[Element]

  fn count(self) -> USize
    ensures result == self.elements.length()
    cost time O(1)
    cost allocations == 0
  {
    self.elements.length()
  }

  fn element(self, position: USize) lends core::Indexed[Element]
    requires position < self.count()
    ensures result.index == position
    ensures identical(result.element, self.elements.model()[position])
    cost time O(1)
    cost allocations == 0
  {
    core::Indexed(index: position, element: self.elements[position])
  }
}

public type Reversed[Element](elements: Slice[Element])

impl Iterable for Reversed[Element] {
  type Element = Element

  fn count(self) -> USize
    ensures result == self.elements.length()
    cost time O(1)
    cost allocations == 0
  {
    self.elements.length()
  }

  fn element(self, position: USize) lends Element
    requires position < self.count()
    ensures identical(result, self.elements.model()[self.elements.length() - 1 - position])
    cost time O(1)
    cost allocations == 0
  {
    self.elements[self.elements.length() - 1 - position]
  }
}

public type Windows[Element](elements: Slice[Element], size: USize)
  invariant size > 0

impl Iterable for Windows[Element] {
  type Element = Slice[Element]

  fn count(self) -> USize
    ensures result <= self.elements.length()
    cost time O(1)
    cost allocations == 0
  {
    if self.size <= self.elements.length() { self.elements.length() - self.size + 1 } else { 0 }
  }

  fn element(self, position: USize) lends Slice[Element]
    requires position < self.count()
    ensures result.length() == self.size
    cost time O(1)
    cost allocations == 0
  {
    self.elements.slice_range(position, stop: position + self.size)
  }
}

public type Chunks[Element](elements: Slice[Element], size: USize)
  invariant size > 0

impl Iterable for Chunks[Element] {
  type Element = Slice[Element]

  fn count(self) -> USize
    ensures result <= self.elements.length()
    cost time O(1)
    cost allocations == 0
  {
    if self.elements.length() == 0 { 0 } else { (self.elements.length() - 1) / self.size + 1 }
  }

  fn element(self, position: USize) lends Slice[Element]
    requires position < self.count()
    ensures result.length() <= self.size
    cost time O(1)
    cost allocations == 0
  {
    let start = position * self.size
    let stop = if self.size < self.elements.length() - start { start + self.size } else { self.elements.length() }
    self.elements.slice_range(start, stop: stop)
  }
}

public type Zipped[Element, Other](first: Slice[Element], second: Slice[Other])

impl Iterable for Zipped[Element, Other] {
  type Element = core::Pair[Element, Other]

  fn count(self) -> USize
    ensures result <= self.first.length()
    ensures result <= self.second.length()
    cost time O(1)
    cost allocations == 0
  {
    if self.first.length() < self.second.length() { self.first.length() } else { self.second.length() }
  }

  fn element(self, position: USize) lends core::Pair[Element, Other]
    requires position < self.count()
    ensures identical(result.first, self.first.model()[position])
    ensures identical(result.second, self.second.model()[position])
    cost time O(1)
    cost allocations == 0
  {
    core::Pair(first: self.first[position], second: self.second[position])
  }
}

impl Model for List[Element] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::storage_model(self.storage)
  }
}

impl Model for Slice[Element] {
  type Value = Sequence[Element]

  fn model(self) -> Sequence[Element]
    cost time finite
  {
    intrinsic::view_model(self.elements)
  }
}

public fn List[Element].with_capacity(capacity: USize) -> List[Element]
  ensures result.model().length() == 0
  cost time O(1)
{
  List(storage: intrinsic::storage_with_capacity(capacity))
}

internal fn List[Element].from_storage(storage: own intrinsic::Storage[Element]) -> List[Element]
  ensures identical(result.model(), intrinsic::storage_model(storage))
  cost time O(1)
  cost allocations == 0
{
  List(storage: own storage)
}

internal fn List[Element].elements(self) -> intrinsic::View[Element] {
  intrinsic::storage_view(self.storage)
}

public fn List[Element].length(self) -> USize
  ensures result == self.model().length()
  ensures result == (intrinsic::storage_length(self.storage))
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_length(self.storage)
}

public fn List[Element].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
  cost allocations == 0
{
  self.length() == 0
}

public fn List[Element].push(mut self, item: own Element)
  ensures identical(self.model(), old(self.model()).append(item))
  cost amortized time O(1)
{
  growth::push(mut self.storage, value: own item)
}

public fn List[Element].pop(mut self) -> Option[Element]
  ensures (result is Some(_)) == (old(self.length()) > 0)
  ensures self.length() + (if old(self.length()) > 0 { 1 } else { 0 }) == old(self.length())
  ensures forall i in 0..self.length() => identical(self.model()[i], old(self.model())[i])
  ensures !(result is Some(item) && !identical(item, old(self.model())[old(self.length()) - 1]))
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  if self.length() == 0 { None } else { Some(intrinsic::storage_pop(mut self.storage)) }
}

public fn List[Element].insert_at(mut self, position: USize, item: own Element)
  requires position <= self.length()
  ensures self.model().length() == old(self.model()).length() + 1
  ensures forall i in 0..position => identical(self.model()[i], old(self.model())[i])
  ensures identical(self.model()[position], item)
  ensures forall i: Integer =>
    position <= i && i < old(self.model()).length() ==>
      identical(self.model()[i + 1], old(self.model())[i])
  ensures forall i: Integer =>
    position < i && i < self.model().length() ==> identical(self.model()[i], old(self.model())[i - 1])
  cost time O(self.length())
{
  growth::reserve(mut self.storage, additional: 1)
  intrinsic::storage_insert(mut self.storage, index: position, value: own item)
}

public fn List[Element].partition_point(self, before: (fn(Element) -> Bool cost time finite)) -> USize
  requires forall i in 0..self.length() => forall j in i..self.length() =>
    before(self.model()[j]) ==> before(self.model()[i])
  ensures result <= self.length()
  ensures forall i in 0..result => before(self.model()[i])
  ensures forall i in result..self.length() => !before(self.model()[i])
  cost time O(log(self.length()) * time(before))
{
  self.slice().partition_point(before)
}

public fn List[Element].slice(self) -> Slice[Element]
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::storage_view(self.storage))
}

internal fn List[Element].slice_range(self, start: USize, stop: USize) -> Slice[Element]
  requires start <= stop
  requires stop <= self.length()
  ensures result.length() == stop - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice().slice_range(start, stop: stop)
}

internal fn List[Element].slice_from(self, start: USize) -> Slice[Element]
  requires start <= self.length()
  ensures result.length() == self.length() - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice().slice_from(start)
}

internal fn Slice[Element].slice_range(self, start: USize, stop: USize) -> Slice[Element]
  requires start <= stop
  requires stop <= self.length()
  ensures result.length() == stop - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  Slice(elements: intrinsic::view_slice(self.elements, start, stop))
}

internal fn Slice[Element].slice_from(self, start: USize) -> Slice[Element]
  requires start <= self.length()
  ensures result.length() == self.length() - start
  ensures forall index in 0..result.length() =>
    identical(result.model()[index], self.model()[start + index])
  cost time O(1)
  cost allocations == 0
{
  self.slice_range(start, stop: self.length())
}

impl Iterable for List[Element] {
  type Element = Element

  fn count(self) -> USize
    ensures result == self.length()
    cost time O(1)
    cost allocations == 0
  {
    self.length()
  }

  fn element(self, position: USize) lends Element
    requires position < self.count()
    ensures identical(result, self.model()[position])
    cost time O(1)
    cost allocations == 0
  {
    self[position]
  }
}

public fn List[Element].element(mut self, position: USize) lends mut Element
  requires position < self.count()
  ensures identical(result, old(self.model())[position])
  ensures identical(self.model(), old(self.model()).update(position, value: yielded[0]))
  ensures self.length() == old(self.length())
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  mut self[position]
}

public fn List[Element].swap(mut self, first: USize, second: USize)
  requires first < self.length()
  requires second < self.length()
  ensures self.length() == old(self.length())
  ensures identical(self.model()[first], old(self.model())[second])
  ensures identical(self.model()[second], old(self.model())[first])
  ensures forall i in 0..self.length() =>
    i == first || i == second || identical(self.model()[i], old(self.model())[i])
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  intrinsic::storage_swap(mut self.storage, first: first, second: second)
}

public fn List[Element].reverse(mut self)
  ensures self.length() == old(self.length())
  ensures forall i in 0..self.length() =>
    identical(self.model()[i], old(self.model())[self.length() - 1 - i])
  ensures forall measure: (fn(Element) -> Integer cost time finite) =>
    self.model().sum(measure) == old(self.model()).sum(measure)
  ensures self.capacity() == old(self.capacity())
  cost time O(self.length())
  cost amortized time O(self.length())
{
  var low: USize = 0
  var high = self.length()
  while low + 1 < high
    invariant self.length() == old(self.length())
    invariant low + high == self.length()
    invariant forall i in 0..low =>
      identical(self.model()[i], old(self.model())[self.length() - 1 - i])
    invariant forall i in high..self.length() =>
      identical(self.model()[i], old(self.model())[self.length() - 1 - i])
    invariant forall i in low..high => identical(self.model()[i], old(self.model())[i])
    invariant forall measure: (fn(Element) -> Integer cost time finite) =>
      self.model().sum(measure) == old(self.model()).sum(measure)
    invariant intrinsic::storage_capacity(self.storage) == old(intrinsic::storage_capacity(self.storage))
    decreases high - low
  {
    high -= 1
    intrinsic::storage_swap(mut self.storage, first: low, second: high)
    low += 1
  }
}

public opaque type ListCursor[Element](reversed: List[Element])

public fn ListCursor[Element].remaining(self) -> USize
  ensures result == self.reversed.length()
  cost time O(1)
  cost allocations == 0
{
  self.reversed.length()
}

impl Cursor for ListCursor[Element] {
  type Element = Element

  fn next(mut self) -> Option[Element]
    ensures (result is Some(_)) == (old(self.remaining()) > 0)
    ensures (result is Some(_)) ==> self.remaining() + 1 == old(self.remaining())
    ensures (result is None) ==> self.remaining() == old(self.remaining())
    cost time O(1)
    cost allocations == 0
  {
    mut self.reversed.pop()
  }
}

public fn List[Element].cursor(own self) -> ListCursor[Element]
  ensures result.remaining() == self.length()
  cost time O(self.length())
  cost amortized time O(self.length())
{
  var reversed = own self
  mut reversed.reverse()
  ListCursor(reversed: own reversed)
}

public fn Array[Element, count: USize].to_list(own self) -> List[Element]
  ensures identical(result.model(), self.model())
  cost time O(count)
{
  List(storage: intrinsic::storage_from_array(own self))
}

public fn Array[Element, count: USize].cursor(own self) -> ListCursor[Element]
  ensures result.remaining() == count
  cost time O(count)
  cost amortized time O(count)
{
  own self.to_list().cursor()
}

public type SliceCursor[Element: Plain](elements: Slice[Element], offset: USize)
  invariant offset <= elements.length()

public fn SliceCursor[Element: Plain].remaining(self) -> USize
  ensures result == self.elements.length() - self.offset
  cost time O(1)
  cost allocations == 0
{
  self.elements.length() - self.offset
}

impl Cursor for SliceCursor[Element: Plain] {
  type Element = Element

  fn next(mut self) -> Option[Element]
    ensures (result is Some(_)) == (old(self.remaining()) > 0)
    ensures (result is Some(_)) ==> self.remaining() + 1 == old(self.remaining())
    ensures (result is None) ==> self.remaining() == old(self.remaining())
    cost time O(1)
    cost allocations == 0
  {
    if self.offset < self.elements.length() {
      let element = self.elements[self.offset]
      self.offset += 1
      Some(element)
    } else {
      None
    }
  }
}

public fn Slice[Element: Plain].cursor(self) -> SliceCursor[Element]
  ensures result.remaining() == self.length()
  cost time O(1)
  cost allocations == 0
{
  SliceCursor(elements: self, offset: 0)
}

public fn List[Element: Plain].cursor(self) -> SliceCursor[Element]
  ensures result.remaining() == self.length()
  cost time O(1)
  cost allocations == 0
{
  self.slice().cursor()
}

public fn Array[Element: Plain, count: USize].cursor(self) -> SliceCursor[Element]
  ensures result.remaining() == count
  cost time O(1)
  cost allocations == 0
{
  self.slice().cursor()
}

public fn Slice[Element].length(self) -> USize
  ensures result == self.model().length()
  ensures result == (intrinsic::view_length(self.elements))
  cost time O(1)
  cost allocations == 0
{
  intrinsic::view_length(self.elements)
}

impl Iterable for Slice[Element] {
  type Element = Element

  fn count(self) -> USize
    ensures result == self.length()
    cost time O(1)
    cost allocations == 0
  {
    self.length()
  }

  fn element(self, position: USize) lends Element
    requires position < self.count()
    ensures identical(result, self.model()[position])
    cost time O(1)
    cost allocations == 0
  {
    self[position]
  }
}

public fn Slice[Element].element(mut self, position: USize) lends mut Element
  requires position < self.count()
  ensures identical(result, old(self.model())[position])
  ensures identical(self.model(), old(self.model()).update(position, value: yielded[0]))
  ensures self.length() == old(self.length())
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  mut self[position]
}

impl Index for List[Element] {
  type Key = USize
  type Output = Element

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    key < self.length()
  }

  fn at(self, key: USize) lends Element
    requires key < self.length()
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    intrinsic::storage_at(self.storage, index: key)
  }
}

impl IndexMut for List[Element] {
  fn at(mut self, key: USize) lends mut Element
    requires key < self.length()
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
    cost amortized time O(1)
    cost allocations == 0
  {
    intrinsic::storage_at_mut(mut self.storage, index: key)
  }
}

impl Index for Slice[Element] {
  type Key = USize
  type Output = Element

  fn contains_key(self, key: USize) -> Bool
    cost time O(1)
    cost allocations == 0
  {
    key < self.length()
  }

  fn at(self, key: USize) lends Element
    requires key < self.length()
    ensures identical(result, self.model()[key])
    cost time O(1)
    cost allocations == 0
  {
    intrinsic::view_at(self.elements, index: key)
  }
}

impl IndexMut for Slice[Element] {
  fn at(mut self, key: USize) lends mut Element
    requires key < self.length()
    ensures identical(result, old(self.model())[key])
    ensures identical(self.model(), old(self.model()).update(key, value: yielded[0]))
    cost time O(1)
    cost amortized time O(1)
    cost allocations == 0
  {
    intrinsic::view_at_mut(mut self.elements, index: key)
  }
}

impl Equal for List[Element: Equal] {
  fn equal(self, other: List[Element]) -> Bool
    ensures result == (self.length() == other.length()
      && forall i in 0..self.length() => self.model()[i] == other.model()[i])
  {
    if self.length() != other.length() {
      return false
    }
    var index: USize = 0
    while index < self.length()
      invariant index <= self.length()
      invariant forall i in 0..index => self.model()[i] == other.model()[i]
      decreases self.length() - index
    {
      if self[index] != other[index] {
        return false
      }
      index += 1
    }
    true
  }
}

public fn List[Element: Copyable].filled(value: Element, count: USize) -> List[Element]
  ensures result.length() == count
  ensures forall i in 0..count => identical(result.model()[i], value)
  cost time O(count * time(Element.copy))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], value)
  {
    intrinsic::storage_push(mut elements, value: value.copy())
  }
  List(storage: own elements)
}

public fn List[Element].generate(
  count: USize,
  make: (fn(index: USize) -> Element requires index < count cost time finite),
) -> List[Element]
  ensures result.length() == count
  ensures forall i in 0..count => identical(result.model()[i], make(i))
  cost calls(make) == count
  cost time O(count * time(make))
{
  var elements: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  for index in 0..count
    invariant intrinsic::storage_length(elements) == index
    invariant intrinsic::storage_capacity(elements) == count
    invariant forall i in 0..index => identical(intrinsic::storage_model(elements)[i], make(i))
  {
    intrinsic::storage_push(mut elements, value: make(index))
  }
  List(storage: own elements)
}

public fn List[Element].collect[Source: Cursor[Element = Element]](source: own Source) -> List[Element]
  uses Source.Uses
{
  var items: List[Element] = []
  mut items.extend(own source)
  items
}

public fn List[Element].capacity(self) -> USize
  ensures result >= self.length()
  ensures result == (intrinsic::storage_capacity(self.storage))
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_capacity(self.storage)
}

public fn List[Element].reserve(mut self, additional: USize)
  ensures identical(self.model(), old(self.model()))
  ensures self.capacity() >= self.length() + additional
  cost amortized time O(additional)
{
  growth::reserve(mut self.storage, additional: additional)
}

public fn List[Element].shrink_to_fit(mut self)
  ensures identical(self.model(), old(self.model()))
{
  intrinsic::storage_set_capacity(mut self.storage, capacity: self.length())
}

public fn List[Element].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
  cost allocations == 0
{
  while self.length() > 0
    decreases self.length()
    cost allocations == 0
  {
    let _ = intrinsic::storage_pop(mut self.storage)
  }
}

public fn List[Element].truncate(mut self, length: USize)
  ensures self.length() == (if length < old(self.length()) { length } else { old(self.length()) })
  ensures forall i in 0..self.length() => identical(self.model()[i], old(self.model())[i])
  cost time O(old(self.length()))
  cost allocations == 0
{
  while self.length() > length
    invariant self.length() == old(self.length()) || self.length() >= length
    invariant self.length() <= old(self.length())
    invariant forall i in 0..self.length() => identical(self.model()[i], old(self.model())[i])
    decreases self.length()
    cost allocations == 0
  {
    let _ = intrinsic::storage_pop(mut self.storage)
  }
}

public fn List[Element].remove_at(mut self, index: USize) -> Element
  requires index < self.length()
  ensures self.length() == old(self.length()) - 1
  ensures identical(result, old(self.model())[index])
  ensures forall i in 0..index => identical(self.model()[i], old(self.model())[i])
  ensures forall i in index..self.length() => identical(self.model()[i], old(self.model())[i + 1])
  cost time O(old(self.length()))
  cost allocations == 0
{
  intrinsic::storage_remove(mut self.storage, index: index)
}

public fn List[Element].swap_remove(mut self, index: USize) -> Element
  requires index < self.length()
  ensures self.length() == old(self.length()) - 1
  ensures identical(result, old(self.model())[index])
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_swap(mut self.storage, first: index, second: self.length() - 1)
  intrinsic::storage_pop(mut self.storage)
}

public fn List[Element].remove_range(mut self, range: Range[USize])
  requires range.start <= range.stop
  requires range.stop <= self.length()
  requires !range.inclusive
  ensures self.length() == old(self.length()) - (range.stop - range.start)
  cost time O(old(self.length()))
  cost allocations == 0
{
  let width = range.stop - range.start
  if width == 0 {
    return
  }
  var index = range.stop
  while index < self.length()
    invariant self.length() == old(self.length())
    invariant range.stop <= index
    invariant index <= self.length()
    decreases self.length() - index
    cost allocations == 0
  {
    intrinsic::storage_swap(mut self.storage, first: index - width, second: index)
    index += 1
  }
  var removed: USize = 0
  while removed < width
    invariant self.length() == old(self.length()) - removed
    invariant removed <= width
    decreases width - removed
    cost allocations == 0
  {
    let _ = intrinsic::storage_pop(mut self.storage)
    removed += 1
  }
}

public fn List[Element].split_off(mut self, at: USize) -> List[Element]
  requires at <= self.length()
  ensures self.length() == at
  ensures result.length() == old(self.length()) - at
  cost time O(result.length())
  cost amortized time O(result.length())
{
  let count = self.length() - at
  var tail: intrinsic::Storage[Element] = intrinsic::storage_with_capacity(count)
  proof {
    assert identical(intrinsic::storage_model(tail), Sequence[Element].empty())
  }
  for index in 0..count
    invariant intrinsic::storage_length(tail) == index
    invariant intrinsic::storage_capacity(tail) == count
    invariant self.length() == old(self.length()) - index
    invariant intrinsic::storage_capacity(self.storage) == old(intrinsic::storage_capacity(self.storage))
    invariant forall measure: (fn(Element) -> Integer cost time finite) =>
      self.model().sum(measure) + intrinsic::storage_model(tail).sum(measure) == old(self.model()).sum(measure)
  {
    intrinsic::storage_push(mut tail, value: intrinsic::storage_pop(mut self.storage))
  }
  var moved = List(storage: own tail)
  mut moved.reverse()
  moved
}

public fn List[Element].append(mut self, other: own List[Element])
  ensures identical(self.model(), old(self.model()).concatenate(other.model()))
  cost amortized time O(other.length())
{
  var rest = own other
  mut rest.reverse()
  let count = rest.length()
  growth::reserve(mut self.storage, additional: count)
  let capacity = intrinsic::storage_capacity(self.storage)
  for index in 0..count
    invariant rest.length() == count - index
    invariant forall i in 0..rest.length() => identical(rest.model()[i], other.model()[count - 1 - i])
    invariant self.model().length() == old(self.model()).length() + index
    invariant forall i in 0..old(self.model()).length() =>
      identical(self.model()[i], old(self.model())[i])
    invariant forall i in 0..index =>
      identical(self.model()[old(self.model()).length() + i], other.model()[i])
    invariant intrinsic::storage_capacity(self.storage) == capacity
    invariant capacity >= old(self.model()).length() + count
  {
    intrinsic::storage_push(mut self.storage, value: intrinsic::storage_pop(mut rest.storage))
  }
}

public fn List[Element: Copyable].append_slice(mut self, items: Slice[Element])
  ensures self.length() == old(self.length()) + items.length()
  ensures identical(self.model(), old(self.model()).concatenate(items.model()))
  cost amortized time O(items.length() * (1 + time(Element.copy)))
{
  for index in 0..items.length()
    invariant self.model().length() == old(self.model()).length() + index
    invariant forall i in 0..old(self.model()).length() =>
      identical(self.model()[i], old(self.model())[i])
    invariant forall i in 0..index =>
      identical(self.model()[old(self.model()).length() + i], items.model()[i])
  {
    mut self.push(items[index].copy())
  }
}

public fn List[Element].extend[Source: Cursor[Element = Element]](mut self, items: own Source)
  uses Source.Uses
{
  var cursor = own items
  while mut cursor.next() is Some(item) {
    mut self.push(own item)
  }
}

public fn List[Element].retain(mut self, keep: (fn(Element) -> Bool cost time finite))
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(keep))
{
  let count = self.length()
  var retained_count: USize = 0
  for index in 0..count
    invariant self.length() == count
    invariant retained_count <= index
  {
    if keep(self[index]) {
      intrinsic::storage_swap(mut self.storage, first: retained_count, second: index)
      retained_count += 1
    }
  }
  mut self.truncate(retained_count)
}

public fn List[Element].filter(own self, keep: (fn(Element) -> Bool cost time finite)) -> List[Element]
  ensures result.length() <= self.length()
  cost time O(self.length() * time(keep))
{
  var retained = own self
  mut retained.retain(keep)
  retained
}

public fn List[Element: Equal].deduplicate(mut self)
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(Element.equal))
{
  let count = self.length()
  if count == 0 {
    return
  }
  var unique_count: USize = 1
  for index in 1..count
    invariant self.length() == count
    invariant 1 <= unique_count
    invariant unique_count <= index
  {
    if !(self[index] == self[unique_count - 1]) {
      intrinsic::storage_swap(mut self.storage, first: unique_count, second: index)
      unique_count += 1
    }
  }
  mut self.truncate(unique_count)
}

impl Default for List[Element] {
  fn default() -> List[Element] {
    []
  }
}

impl Ordered for List[Element: Ordered] {
  fn compare(self, other: List[Element]) -> Ordering
    ensures result == slice::lexicographic(self.model(), second: other.model(), from: 0)
  {
    self.slice().compare(other.slice())
  }
}

proof Ordered.agrees_with_equal for List[Element: Ordered] {
  slice::lexicographic_agrees_with_equal(first.model(), second: second.model(), from: 0)
}

proof Ordered.antisymmetric for List[Element: Ordered] {
  slice::lexicographic_is_antisymmetric(first.model(), second: second.model(), from: 0)
}

proof Ordered.transitive for List[Element: Ordered] {
  slice::lexicographic_is_transitive(first.model(), second: second.model(), third: third.model(), from: 0)
}

impl Hash for List[Element: Hash] {
  fn hash(self, hasher: mut Hasher) {
    self.slice().hash(mut hasher)
  }
}

impl Display for List[Element: Display] {
  fn display(self, output: mut TextBuilder) {
    self.slice().display(mut output)
  }
}
