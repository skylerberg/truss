public fn Array[Element, count: USize].split_at(self, index: USize) -> core::Pair[Slice[Element], Slice[Element]]
  requires index <= self.length()
  ensures result.first.length() == index
  ensures result.second.length() == self.length() - index
  cost time O(1)
{
  self.slice().split_at(index)
}

public fn Array[Element: Equal, count: USize].contains(self, item: Element) -> Bool

  ensures result == (exists i in 0..self.length() => self.model()[i] == item)
  cost time O(self.length() * time(Element.equal))
{
  self.slice().contains(item)
}

public fn Array[Element: Equal, count: USize].index_of(self, item: Element) -> Option[USize]

  ensures match result {
    Some(index) => index < self.length() && self.model()[index] == item
      && (forall i in 0..index => !(self.model()[i] == item))
    None => !self.contains(item)
  }
  cost time O(self.length() * time(Element.equal))
{
  self.slice().index_of(item)
}

public fn Array[Element: Equal, count: USize].last_index_of(self, item: Element) -> Option[USize]

  ensures match result {
    Some(index) => index < self.length() && self.model()[index] == item
      && (forall i: USize => index < i && i < self.length() ==> !(self.model()[i] == item))
    None => !self.contains(item)
  }
  cost time O(self.length() * time(Element.equal))
{
  self.slice().last_index_of(item)
}

public fn Array[Element, count: USize].find_index(self, matching: (fn(Element) -> Bool cost time finite)) -> Option[USize]

  ensures match result {
    Some(index) => index < self.length() && matching(self.model()[index])
      && (forall i in 0..index => !matching(self.model()[i]))
    None => forall i in 0..self.length() => !matching(self.model()[i])
  }
  cost time O(self.length() * time(matching))
{
  self.slice().find_index(matching)
}

public fn Array[Element: Equal, count: USize].starts_with(self, prefix: Slice[Element]) -> Bool

  ensures result == (prefix.length() <= self.length()
    && forall i in 0..prefix.length() => self.model()[i] == prefix.model()[i])
  cost time O(prefix.length() * time(Element.equal))
{
  self.slice().starts_with(prefix)
}

public fn Array[Element: Equal, count: USize].ends_with(self, suffix: Slice[Element]) -> Bool

  ensures result == (suffix.length() <= self.length()
    && forall i in 0..suffix.length() => self.model()[self.length() - suffix.length() + i] == suffix.model()[i])
  cost time O(suffix.length() * time(Element.equal))
{
  self.slice().ends_with(suffix)
}

public fn Array[Element: Equal, count: USize].find_slice(self, needle: Slice[Element]) -> Option[USize]
  ensures match result {
    Some(index) => index + needle.length() <= self.length()
    None => true
  }
  cost time O(self.length() + needle.length())
{
  todo
}

public fn Array[Element: Ordered, count: USize].is_sorted(self) -> Bool
  cost time O(self.length())
{
  todo
}

public fn Array[Element: Ordered, count: USize].binary_search(self, target: Element) -> Option[USize]
  requires self.is_sorted()
  ensures match result {
    Some(index) => index < self.length() && self[index] == target
    None => !self.contains(target)
  }
  cost time O(log(self.length()))
{
  todo
}

public fn Array[Element, count: USize].partition_point(self, before: (fn(Element) -> Bool cost time finite)) -> USize
  requires forall i in 0..self.length() => forall j in i..self.length() =>
    before(self.model()[j]) ==> before(self.model()[i])
  ensures result <= self.length()
  ensures forall i in 0..result => before(self.model()[i])
  ensures forall i in result..self.length() => !before(self.model()[i])
  cost time O(log(self.length()) * time(before))
{
  self.slice().partition_point(before)
}

