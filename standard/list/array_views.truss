public fn Array[Element, count: USize].reversed(self) yields Element
  ensures finished ==> yielded.length() == self.length()
  cost time O(self.length())
{
  var index = self.length()
  while index > 0
    invariant index <= self.length()
    invariant yielded.length() == self.length() - index
    decreases index
  {
    index -= 1
    yield self[index]
  }
}

public fn Array[Element, count: USize].reversed(mut self) yields mut Element
  cost time O(self.length())
{
  todo
}

public fn Array[Element, count: USize].windows(self, size: USize) yields Slice[Element]
  requires size > 0
  ensures result.length() == size
  cost time O(self.length())
{
  for window in self.slice().windows(size) {
    yield window
  }
}

public fn Array[Element, count: USize].chunks(self, size: USize) yields Slice[Element]
  requires size > 0
  ensures result.length() <= size
  cost time O(self.length())
{
  for chunk in self.slice().chunks(size) {
    yield chunk
  }
}

