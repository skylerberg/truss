impl TryFrom[UInt64] for Int64 {
  type Error = core::ConversionError

  fn try_from(value: own UInt64) -> Result[Int64, core::ConversionError]
    ensures (result is Ok(_)) == (value <= 9223372036854775807)
    ensures !(result is Ok(converted) && converted != value)
    cost time O(1)
  {
    if intrinsic::fits[UInt64, Int64](value) { Ok(intrinsic::convert(value)) } else { Err(core::ConversionError()) }
  }
}

