impl Divide[ISize] for ISize {
  type Output = ISize

  fn divide_is_defined(self, right: ISize) -> Bool
    cost time O(1)
  {
    right != 0 && !(self == ISize.minimum && right == -1)
  }

  fn divide(self, right: ISize) -> ISize
    requires right != 0 && !(self == ISize.minimum && right == -1)
    cost time O(1)
  {
    intrinsic::divide(self, right)
  }
}

