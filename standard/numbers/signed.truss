use standard::core
use standard::intrinsic

impl Equal for Int8 {
  fn equal(self, other: Int8) -> Bool
    cost time O(1)
  {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for Int8 {
  fn compare(self, other: Int8) -> Ordering
    ensures result == (if self < other { Ordering.Less } else if self == other { Ordering.Equal } else { Ordering.Greater })
    cost time O(1)
  {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Default for Int8 {
  fn default() -> Int8
    cost time O(1)
  {
    0
  }
}

impl Display for Int8 {
  fn display(self, output: mut TextBuilder) {
    mut output.write_signed(intrinsic::convert(self))
  }
}

impl Add[Int8] for Int8 {
  type Output = Int8

  fn add_is_defined(self, right: Int8) -> Bool
    cost time O(1)
  {
    !intrinsic::add_overflows(self, right: right)
  }

  fn add(self, right: Int8) -> Int8
    requires !intrinsic::add_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::add(self, right)
  }
}

impl Subtract[Int8] for Int8 {
  type Output = Int8

  fn subtract_is_defined(self, right: Int8) -> Bool
    cost time O(1)
  {
    !intrinsic::subtract_overflows(self, right: right)
  }

  fn subtract(self, right: Int8) -> Int8
    requires !intrinsic::subtract_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::subtract(self, right)
  }
}

impl Multiply[Int8] for Int8 {
  type Output = Int8

  fn multiply_is_defined(self, right: Int8) -> Bool
    cost time O(1)
  {
    !intrinsic::multiply_overflows(self, right: right)
  }

  fn multiply(self, right: Int8) -> Int8
    requires !intrinsic::multiply_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::multiply(self, right)
  }
}

impl Divide[Int8] for Int8 {
  type Output = Int8

  fn divide_is_defined(self, right: Int8) -> Bool
    cost time O(1)
  {
    right != 0 && !(self == Int8.minimum && right == -1)
  }

  fn divide(self, right: Int8) -> Int8
    requires right != 0 && !(self == Int8.minimum && right == -1)
    cost time O(1)
  {
    intrinsic::divide(self, right)
  }
}

impl Remainder[Int8] for Int8 {
  type Output = Int8

  fn remainder_is_defined(self, right: Int8) -> Bool
    cost time O(1)
  {
    right != 0 && !(self == Int8.minimum && right == -1)
  }

  fn remainder(self, right: Int8) -> Int8
    requires right != 0 && !(self == Int8.minimum && right == -1)
    cost time O(1)
  {
    intrinsic::remainder(self, right)
  }
}

impl Negate for Int8 {
  type Output = Int8

  fn negate_is_defined(self) -> Bool
    cost time O(1)
  {
    self != Int8.minimum
  }

  fn negate(self) -> Int8
    requires self != Int8.minimum
    cost time O(1)
  {
    intrinsic::negate(self)
  }
}

impl Hash for Int8 {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write(intrinsic::convert(self))
  }
}

public let Int8.minimum: Int8 = -128

public let Int8.maximum: Int8 = 127

impl TryFrom[Int16] for Int8 {
  type Error = core::ConversionError

  fn try_from(value: own Int16) -> Result[Int8, core::ConversionError]
    ensures (result is Ok(_)) == (-128 <= value && value <= 127)
    ensures !(result is Ok(converted) && converted != value)
    cost time O(1)
  {
    if intrinsic::fits[Int16, Int8](value) { Ok(intrinsic::convert(value)) } else { Err(core::ConversionError()) }
  }
}

