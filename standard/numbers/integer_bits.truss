use standard::intrinsic


public transparent fn Int8.to_big_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public transparent fn Int8.to_little_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public transparent fn Int8.from_big_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
  cost time O(1)
{
  UInt8.from_big_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int8.from_little_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
  cost time O(1)
{
  UInt8.from_little_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int16.to_big_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public transparent fn Int16.to_little_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public transparent fn Int16.from_big_endian_bytes(bytes: Array[UInt8, 2]) -> Int16
  cost time O(1)
{
  UInt16.from_big_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int16.from_little_endian_bytes(bytes: Array[UInt8, 2]) -> Int16
  cost time O(1)
{
  UInt16.from_little_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int32.to_big_endian_bytes(self) -> Array[UInt8, 4]
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public transparent fn Int32.to_little_endian_bytes(self) -> Array[UInt8, 4]
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public transparent fn Int32.from_big_endian_bytes(bytes: Array[UInt8, 4]) -> Int32
  cost time O(1)
{
  UInt32.from_big_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int32.from_little_endian_bytes(bytes: Array[UInt8, 4]) -> Int32
  cost time O(1)
{
  UInt32.from_little_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int64.to_big_endian_bytes(self) -> Array[UInt8, 8]
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public transparent fn Int64.to_little_endian_bytes(self) -> Array[UInt8, 8]
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public transparent fn Int64.from_big_endian_bytes(bytes: Array[UInt8, 8]) -> Int64
  cost time O(1)
{
  UInt64.from_big_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int64.from_little_endian_bytes(bytes: Array[UInt8, 8]) -> Int64
  cost time O(1)
{
  UInt64.from_little_endian_bytes(bytes).to_signed_bits()
}

public transparent fn UInt8.to_big_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  [self]
}

public transparent fn UInt8.to_little_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  [self]
}

public transparent fn UInt8.from_big_endian_bytes(bytes: Array[UInt8, 1]) -> UInt8
  cost time O(1)
{
  bytes[0]
}

public transparent fn UInt8.from_little_endian_bytes(bytes: Array[UInt8, 1]) -> UInt8
  cost time O(1)
{
  bytes[0]
}

public transparent fn UInt16.to_big_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  [intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public transparent fn UInt16.to_little_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255)]
}

public transparent fn UInt16.from_big_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt16](bytes[0]) << 8) | intrinsic::convert[UInt8, UInt16](bytes[1])
}

public transparent fn UInt16.from_little_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt16](bytes[0]) | (intrinsic::convert[UInt8, UInt16](bytes[1]) << 8)
}

public transparent fn UInt32.to_big_endian_bytes(self) -> Array[UInt8, 4]
  cost time O(1)
{
  [intrinsic::convert((self >> 24) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public transparent fn UInt32.to_little_endian_bytes(self) -> Array[UInt8, 4]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 24) & 255)]
}

public transparent fn UInt32.from_big_endian_bytes(bytes: Array[UInt8, 4]) -> UInt32
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt32](bytes[0]) << 24) | (intrinsic::convert[UInt8, UInt32](bytes[1]) << 16) | (intrinsic::convert[UInt8, UInt32](bytes[2]) << 8) | intrinsic::convert[UInt8, UInt32](bytes[3])
}

public transparent fn UInt32.from_little_endian_bytes(bytes: Array[UInt8, 4]) -> UInt32
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt32](bytes[0]) | (intrinsic::convert[UInt8, UInt32](bytes[1]) << 8) | (intrinsic::convert[UInt8, UInt32](bytes[2]) << 16) | (intrinsic::convert[UInt8, UInt32](bytes[3]) << 24)
}

public transparent fn UInt64.to_big_endian_bytes(self) -> Array[UInt8, 8]
  cost time O(1)
{
  [intrinsic::convert((self >> 56) & 255), intrinsic::convert((self >> 48) & 255), intrinsic::convert((self >> 40) & 255), intrinsic::convert((self >> 32) & 255), intrinsic::convert((self >> 24) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public transparent fn UInt64.to_little_endian_bytes(self) -> Array[UInt8, 8]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 24) & 255), intrinsic::convert((self >> 32) & 255), intrinsic::convert((self >> 40) & 255), intrinsic::convert((self >> 48) & 255), intrinsic::convert((self >> 56) & 255)]
}

public transparent fn UInt64.from_big_endian_bytes(bytes: Array[UInt8, 8]) -> UInt64
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt64](bytes[0]) << 56) | (intrinsic::convert[UInt8, UInt64](bytes[1]) << 48) | (intrinsic::convert[UInt8, UInt64](bytes[2]) << 40) | (intrinsic::convert[UInt8, UInt64](bytes[3]) << 32) | (intrinsic::convert[UInt8, UInt64](bytes[4]) << 24) | (intrinsic::convert[UInt8, UInt64](bytes[5]) << 16) | (intrinsic::convert[UInt8, UInt64](bytes[6]) << 8) | intrinsic::convert[UInt8, UInt64](bytes[7])
}

public transparent fn UInt64.from_little_endian_bytes(bytes: Array[UInt8, 8]) -> UInt64
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt64](bytes[0]) | (intrinsic::convert[UInt8, UInt64](bytes[1]) << 8) | (intrinsic::convert[UInt8, UInt64](bytes[2]) << 16) | (intrinsic::convert[UInt8, UInt64](bytes[3]) << 24) | (intrinsic::convert[UInt8, UInt64](bytes[4]) << 32) | (intrinsic::convert[UInt8, UInt64](bytes[5]) << 40) | (intrinsic::convert[UInt8, UInt64](bytes[6]) << 48) | (intrinsic::convert[UInt8, UInt64](bytes[7]) << 56)
}

test "rotating moves bits round the ends" {
  let byte: UInt8 = 0b1000_0001
  assert byte.rotate_left(1) == 0b0000_0011
  assert byte.rotate_right(1) == 0b1100_0000
  assert byte.rotate_left(8) == byte
  assert byte.rotate_left(9) == 0b0000_0011
  let word: UInt32 = 0x12345678
  assert word.rotate_left(8) == 0x34567812
  assert word.rotate_right(8) == 0x78123456
  let negative: Int8 = -128
  assert negative.rotate_left(1) == 1
}

test "swap_bytes and reverse_bits reverse their units" {
  let word: UInt32 = 0x12345678
  assert word.swap_bytes() == 0x78563412
  let pair: UInt16 = 0xABCD
  assert pair.swap_bytes() == 0xCDAB
  let byte: UInt8 = 0b0000_0110
  assert byte.swap_bytes() == byte
  assert byte.reverse_bits() == 0b0110_0000
  let one: UInt8 = 1
  assert one.reverse_bits() == 128
  let low: UInt32 = 1
  assert low.reverse_bits() == 0x80000000
  let wide: UInt64 = 0x00000000000000FF
  assert wide.reverse_bits() == 0xFF00000000000000
  let mixed: UInt16 = 0x8001
  assert mixed.reverse_bits() == 0x8001
  let signed: Int16 = 1
  assert signed.reverse_bits() == Int16.minimum
}

test "checked shifts refuse an amount of the width or more, and wrapping shifts reduce it" {
  let one: UInt8 = 1
  assert one.checked_shift_left(7) == Some(128)
  assert one.checked_shift_left(8) is None
  assert one.checked_shift_left(0) == Some(1)
  let top: UInt8 = 128
  assert top.checked_shift_right(7) == Some(1)
  assert top.checked_shift_right(8) is None
  assert one.wrapping_shift_left(9) == 2
  assert top.wrapping_shift_right(15) == 1
  let negative: Int8 = -128
  assert negative.checked_shift_right(1) == Some(-64)
  assert negative.checked_shift_right(7) == Some(-1)
  let small: Int32 = 3
  assert small.checked_shift_left(4) == Some(48)
  assert small.checked_shift_left(32) is None
}

test "an integer's bits are read as the other signedness" {
  let minus_one: Int8 = -1
  assert minus_one.to_unsigned_bits() == 255
  assert Int8.minimum.to_unsigned_bits() == 128
  assert Int8.maximum.to_unsigned_bits() == 127
  let zero: Int8 = 0
  assert zero.to_unsigned_bits() == 0
  let high: UInt8 = 255
  assert high.to_signed_bits() == -1
  let half: UInt8 = 128
  assert half.to_signed_bits() == Int8.minimum
  let below: UInt8 = 127
  assert below.to_signed_bits() == 127
  assert Int64.minimum.to_unsigned_bits() == 9223372036854775808
  assert UInt64.maximum.to_signed_bits() == -1
  let round: Int32 = -123456
  assert round.to_unsigned_bits().to_signed_bits() == round
}

test "an integer converts to and from bytes in both orders" {
  let word: UInt32 = 0x12345678
  let big = word.to_big_endian_bytes()
  assert big[0] == 0x12
  assert big[1] == 0x34
  assert big[2] == 0x56
  assert big[3] == 0x78
  let little = word.to_little_endian_bytes()
  assert little[0] == 0x78
  assert little[3] == 0x12
  assert UInt32.from_big_endian_bytes(big) == word
  assert UInt32.from_little_endian_bytes(little) == word
  assert UInt32.from_little_endian_bytes(big) == 0x78563412
  let negative: Int16 = -2
  let bytes = negative.to_big_endian_bytes()
  assert bytes[0] == 0xFF
  assert bytes[1] == 0xFE
  assert Int16.from_big_endian_bytes(bytes) == negative
  let wide: UInt64 = 0x0102030405060708
  let wide_bytes = wide.to_little_endian_bytes()
  assert wide_bytes[0] == 8
  assert wide_bytes[7] == 1
  assert UInt64.from_little_endian_bytes(wide_bytes) == wide
  let byte: UInt8 = 200
  assert byte.to_big_endian_bytes()[0] == 200
  assert UInt8.from_little_endian_bytes(byte.to_little_endian_bytes()) == 200
  assert Int64.from_big_endian_bytes(Int64.minimum.to_big_endian_bytes()) == Int64.minimum
}

test "an integer counts its ones, its zeros, and the zeros at each end" {
  let byte: UInt8 = 0b0010_1000
  assert byte.count_ones() == 2
  assert byte.count_zeros() == 6
  assert byte.leading_zeros() == 2
  assert byte.trailing_zeros() == 3
  let word: UInt32 = 1
  assert word.leading_zeros() == 31
  assert word.trailing_zeros() == 0
  let wide: UInt64 = 0x8000_0000_0000_0000
  assert wide.leading_zeros() == 0
  assert wide.trailing_zeros() == 63
  assert wide.count_ones() == 1
  let size: USize = 0xff00
  assert size.count_ones() == 8
  assert size.trailing_zeros() == 8
  assert size.leading_zeros() == 48
}

test "zero and the signed integers count the bits of their whole width" {
  let none: UInt16 = 0
  assert none.count_ones() == 0
  assert none.count_zeros() == 16
  assert none.leading_zeros() == 16
  assert none.trailing_zeros() == 16
  let all: Int8 = -1
  assert all.count_ones() == 8
  assert all.count_zeros() == 0
  assert all.leading_zeros() == 0
  assert all.trailing_zeros() == 0
  let least: Int32 = Int32.minimum
  assert least.count_ones() == 1
  assert least.leading_zeros() == 0
  assert least.trailing_zeros() == 31
  let small: Int16 = 6
  assert small.leading_zeros() == 13
  assert small.trailing_zeros() == 1
  let zero: Int64 = 0
  assert zero.leading_zeros() == 64
  assert zero.trailing_zeros() == 64
  let pointer_sized: ISize = -2
  assert pointer_sized.count_ones() == 63
  assert pointer_sized.trailing_zeros() == 1
}
