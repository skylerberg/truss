use standard::intrinsic


public transparent fn Int8.count_ones(self) -> USize
  ensures result <= 8
  cost time O(1)
{
  intrinsic::count_ones(self)
}

public transparent fn Int8.count_zeros(self) -> USize
  ensures result <= 8
  cost time O(1)
{
  8 - intrinsic::count_ones(self)
}

public transparent fn Int8.leading_zeros(self) -> USize
  ensures result <= 8
  cost time O(1)
{
  intrinsic::leading_zeros(self)
}

public transparent fn Int8.trailing_zeros(self) -> USize
  ensures result <= 8
  cost time O(1)
{
  intrinsic::trailing_zeros(self)
}

public transparent fn Int8.rotate_left(self, amount: USize) -> Int8
  cost time O(1)
{
  intrinsic::rotate_left(self, amount: amount)
}

public transparent fn Int8.rotate_right(self, amount: USize) -> Int8
  cost time O(1)
{
  intrinsic::rotate_right(self, amount: amount)
}

public transparent fn Int8.reverse_bits(self) -> Int8
  cost time O(1)
{
  self.to_unsigned_bits().reverse_bits().to_signed_bits()
}

public transparent fn Int8.swap_bytes(self) -> Int8
  cost time O(1)
{
  intrinsic::swap_bytes(self)
}

public fn Int8.checked_shift_left(self, amount: USize) -> Option[Int8]
  ensures (result is None) == (amount >= 8)
  cost time O(1)
{
  if amount >= 8 { None } else { Some(self << amount) }
}

public fn Int8.checked_shift_right(self, amount: USize) -> Option[Int8]
  ensures (result is None) == (amount >= 8)
  cost time O(1)
{
  if amount >= 8 { None } else { Some(self >> amount) }
}

public transparent fn Int8.wrapping_shift_left(self, amount: USize) -> Int8
  cost time O(1)
{
  self << (amount % 8)
}

public transparent fn Int8.wrapping_shift_right(self, amount: USize) -> Int8
  cost time O(1)
{
  self >> (amount % 8)
}

public fn Int8.to_unsigned_bits(self) -> UInt8
  ensures self >= 0 ==> result == self
  ensures self < 0 ==> result == self + power(2, 8)
  cost time O(1)
{
  if self >= 0 {
    intrinsic::convert(self)
  } else {
    let below: UInt8 = intrinsic::convert(-(self + 1))
    UInt8.maximum - below
  }
}

public transparent fn Int8.to_big_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public transparent fn Int8.to_little_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public transparent fn Int8.from_big_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
  cost time O(1)
{
  UInt8.from_big_endian_bytes(bytes).to_signed_bits()
}

public transparent fn Int8.from_little_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
  cost time O(1)
{
  UInt8.from_little_endian_bytes(bytes).to_signed_bits()
}

