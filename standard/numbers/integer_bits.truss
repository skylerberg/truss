public transparent fn UInt16.reverse_bits(self) -> UInt16
  cost time O(1)
{
  let halves = ((self & 0xF0F0) >> 4) | ((self & 0x0F0F) << 4)
  let quarters = ((halves & 0xCCCC) >> 2) | ((halves & 0x3333) << 2)
  let pairs = ((quarters & 0xAAAA) >> 1) | ((quarters & 0x5555) << 1)
  intrinsic::swap_bytes(pairs)
}

public transparent fn UInt16.swap_bytes(self) -> UInt16
  cost time O(1)
{
  intrinsic::swap_bytes(self)
}

public fn UInt16.checked_shift_left(self, amount: USize) -> Option[UInt16]
  ensures (result is None) == (amount >= 16)
  cost time O(1)
{
  if amount >= 16 { None } else { Some(self << amount) }
}

public fn UInt16.checked_shift_right(self, amount: USize) -> Option[UInt16]
  ensures (result is None) == (amount >= 16)
  cost time O(1)
{
  if amount >= 16 { None } else { Some(self >> amount) }
}

public transparent fn UInt16.wrapping_shift_left(self, amount: USize) -> UInt16
  cost time O(1)
{
  self << (amount % 16)
}

public transparent fn UInt16.wrapping_shift_right(self, amount: USize) -> UInt16
  cost time O(1)
{
  self >> (amount % 16)
}

public fn UInt16.to_signed_bits(self) -> Int16
  ensures self < 32768 ==> result == self
  ensures self >= 32768 ==> result == self - power(2, 16)
  cost time O(1)
{
  if self < 32768 {
    intrinsic::convert(self)
  } else {
    let below: Int16 = intrinsic::convert(UInt16.maximum - self)
    -below - 1
  }
}

public transparent fn UInt16.to_big_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  [intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public transparent fn UInt16.to_little_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255)]
}

public transparent fn UInt16.from_big_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt16](bytes[0]) << 8) | intrinsic::convert[UInt8, UInt16](bytes[1])
}

public transparent fn UInt16.from_little_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt16](bytes[0]) | (intrinsic::convert[UInt8, UInt16](bytes[1]) << 8)
}

