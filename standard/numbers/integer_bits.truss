public transparent fn UInt8.wrapping_shift_right(self, amount: USize) -> UInt8
  cost time O(1)
{
  self >> (amount % 8)
}

public fn UInt8.to_signed_bits(self) -> Int8
  ensures self < 128 ==> result == self
  ensures self >= 128 ==> result == self - power(2, 8)
  cost time O(1)
{
  if self < 128 {
    intrinsic::convert(self)
  } else {
    let below: Int8 = intrinsic::convert(UInt8.maximum - self)
    -below - 1
  }
}

