public transparent fn UInt8.reverse_bits(self) -> UInt8
  cost time O(1)
{
  let halves = ((self & 0xF0) >> 4) | ((self & 0x0F) << 4)
  let quarters = ((halves & 0xCC) >> 2) | ((halves & 0x33) << 2)
  let pairs = ((quarters & 0xAA) >> 1) | ((quarters & 0x55) << 1)
  pairs
}

