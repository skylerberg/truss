    cost time O(1)
  {
    intrinsic::remainder(self, right)
  }
}

impl Negate for Int64 {
  type Output = Int64

  fn negate_is_defined(self) -> Bool
    ensures result == (self != Int64.minimum)
    cost time O(1)
  {
    self != Int64.minimum
  }

  fn negate(self) -> Int64
    requires self != Int64.minimum
    ensures result == -self
    cost time O(1)
  {
    intrinsic::negate(self)
  }
}

impl Hash for Int64 {
  fn hash(self, hasher: mut Hasher)
    cost allocations == 0
  {
    mut hasher.write(intrinsic::convert(self))
  }
}

public let Int64.minimum: Int64 = -9223372036854775808

public let Int64.maximum: Int64 = 9223372036854775807

impl From[Int8] for Int64 {
  fn from(value: own Int8) -> Int64
    ensures result == value
    cost time O(1)
  {
    intrinsic::convert(value)
  }
}

impl From[Int16] for Int64 {
  fn from(value: own Int16) -> Int64
    ensures result == value
    cost time O(1)
  {
    intrinsic::convert(value)
  }
}

