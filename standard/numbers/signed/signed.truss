    ensures result == (UInt64.from_little_endian_bytes(bytes).to_signed_bits())
    cost time O(1)
  {
    UInt64.from_little_endian_bytes(bytes).to_signed_bits()
  }

  fn reverse_bits(self) -> Int64
    cost time O(1)
  {
    self.to_unsigned_bits().reverse_bits().to_signed_bits()
  }
}

impl SignedInteger for Int64 {
  type Unsigned = UInt64
}
