impl FixedWidthInteger for Int8 {
  fn minimum_value() -> Int8
    ensures result == Int8.minimum
    cost time O(1)
  {
    Int8.minimum
  }

  fn maximum_value() -> Int8
    ensures result == Int8.maximum
    cost time O(1)
  {
    Int8.maximum
  }

  fn bit_width() -> UInt64
    ensures result == Int8.bits
    cost time O(1)
  {
    Int8.bits
  }

  type Bytes = Array[UInt8, 1]

  fn to_big_endian_bytes(self) -> Array[UInt8, 1]
    ensures identical(result, self.to_unsigned_bits().to_big_endian_bytes())
    cost time O(1)
  {
    self.to_unsigned_bits().to_big_endian_bytes()
  }

  fn to_little_endian_bytes(self) -> Array[UInt8, 1]
    ensures identical(result, self.to_unsigned_bits().to_little_endian_bytes())
    cost time O(1)
  {
    self.to_unsigned_bits().to_little_endian_bytes()
  }

  fn from_big_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
    ensures result == (UInt8.from_big_endian_bytes(bytes).to_signed_bits())
    cost time O(1)
  {
    UInt8.from_big_endian_bytes(bytes).to_signed_bits()
  }

  fn from_little_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
    ensures result == (UInt8.from_little_endian_bytes(bytes).to_signed_bits())
    cost time O(1)
  {
    UInt8.from_little_endian_bytes(bytes).to_signed_bits()
  }

  fn reverse_bits(self) -> Int8
    cost time O(1)
  {
    self.to_unsigned_bits().reverse_bits().to_signed_bits()
  }
}

impl SignedInteger for Int8 {
  type Unsigned = UInt8
}

