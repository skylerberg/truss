  0x4DB309A479ED07E0, 0x211FCC0D986849D8, 0xE967BF10FE825C4E, 0x71E0D76A9F1179B1, 0x0E590D4546D5D81D, 0x51EF5096988B4E24,
  0x5335925E1F5710D6, 0xE802F6F5A72CD50C, 0x2203B4B310F80A4F, 0xB54250EFEA9B0671, 0x6292E52BE541C80E, 0x7B379E76DE923A12,
  0xCD02C30A4B1B644B, 0xC04373CCDDE23D5E, 0xF05450C0155ACCB5, 0xD634B2780D58BFF1, 0x8BC1DF1610AEEFED, 0x6EB256DB94DAABE9,
  0xE52F76493D08AB71, 0x5E7B53DB8C4AD64E, 0x361A28D26F5D8BE1, 0x81D05983859A776D, 0x22446FE467011548, 0xAAD58BDD80C15A9A,
  0x2AC5776A7078D8A0, 0x7576D5450C970EC8, 0xD2D48A964FBCD27A, 0x63C4D69DF1D6038C, 0x7CB60C456E4B8470, 0xDBE38F56C9DE658C,
  0x12DC732C7C55FEEF, 0x0BC9C7FBCDB5BF55, 0x4EBC39FAC1232F2A, 0x226B4879716BFAF5, 0x35830D4BE6E37CD9, 0x02E3D09EE09C5C0F,
  0x439CC4C698C37313, 0x2A41FAFC1F7A27EC, 0xB4D279BB2758B1E7, 0x22071829F12EDE61, 0x35446F1A36BD4AFC, 0xC2958AE0C46C9DBC,
  0xF33AED98F587C52B, 0xD804D47F9974DB3A, 0x4E06099F7FD21209, 0xA1878C075FC6968C, 0x24F4B7849BDC1E17, 0x6E31E565C2D3259D,
  0x89BE5EBF3387EF04, 0x5616FB378034F562, 0xAB9CBA05604232BB, 0x5683E886B852BF6A, 0xB61271543333B7A2, 0xA3970DA94000A58B,
  0x8C7CD1139000CEEE, 0x37CE02AC3A008154, 0x45C183574880A1AA, 0xD731E42D1AA0CA14, 0x867F2E9C30A47E4C, 0x281EFA433CCD9DE0,
  0x7226B8D40C010558, 0x4EB067090F0146AE, 0x912E4065A960CC2C, 0xF579D07F13B8FF37, 0x32D8449ED8A73F05, 0x7FC72AE347688763,
  0x1FB8F59C1942A93C, 0xE7A733031F93538B, 0xF0C87FE1F3BC1437, 0x2CFA9FDA70AB1945, 0xB83947D10CD5DF96, 0xB323CCE2A805ABBE,
  0x1FECC01B520716AD, 0xA7E7F0222688DC59, 0xA8F0F615581589B7, 0xD32D339AAE1AEC25, 0x07F8808159A1A72E, 0x04FB5050D805087D,
  0x863A24650E064A9C, 0xE7C8AD7E5187DD43, 0x70DD6C6EF2F4EA4A, 0x4D14C78AAFB224DD, 0xA059F96D5B9EAE14, 0x24383BE459432CCC,
  0xED464ADD6F93F7FF, 0x2897DD94CB78F5FF, 0x195EEA7CFF2B99BF, 0x9FB6A51C3EF6802F, 0xC7A44E634EB4203B, 0xB98D61FC2261284A,
  0x93F85D3D957CB92E, 0x38F6748CFADBE77A, 0x473411B03992E158, 0x8C808B0E23FBCCD7, 0xAFA0ADD1ACFAC00D, 0x9B88D94618397010,
  0xA13587CBCF23E60A, 0x4982E9BEC2ECDF8D, 0x1BE3A42E73A81770, 0x716E469D08490EA6, 0x8DC9D8444A5B524F, 0x313C4E555CF226E3,
  0xDEC5B0F55A17584E, 0x56771D32B09D2E62, 0x6C14E47F5CC479FA, 0x438D0ECF99FACC3C, 0x1470528380797F4B, 0x598C67246097DF1E,
  0x77F7C076BC5EEB73, 0x95F5B0946B76A64F, 0x7B731CB986544FE3, 0x0D27F1F3F3F4B1EE, 0x9071EE70F0F1DE6A, 0xB48E6A0D2D2E5604,
]

let small_powers_of_ten: Array[UInt64, 20] = [
  1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000, 100000000000,
  1000000000000, 10000000000000, 100000000000000, 1000000000000000, 10000000000000000, 100000000000000000,
  1000000000000000000, 10000000000000000000,
]

let limb_base: UInt64 = 1000000000
let largest_count: UInt64 = 4611686018427387903

type Precision =
  | Single
  | Double

type Scaler(high: UInt64, low: UInt64, shift: UInt64)

type ScaledDecimal(significand: UInt64, exponent: Int64)

type Digits =
  | Short(digits: Array[UInt8, 20], count: UInt64)
  | Long(digits: intrinsic::Storage[UInt8])

type DecimalDigits(digits: Digits, point: Int64)

type ExactDigits(digits: intrinsic::Storage[UInt8], point: Int64)

type Decoded =
  | NotANumber
  | Infinite(is_negative: Bool)
  | Finite(is_negative: Bool, mantissa: UInt64, exponent: Int64)

type DecimalText(significand: UInt64, exponent: Int64, is_negative: Bool, is_truncated: Bool)

type ReadText =
  | NotANumberText
  | InfinityText(is_negative: Bool)
  | Number(text: DecimalText)
  | Unreadable(error: core::ParseFloatError)

fn mantissa_bits(precision: Precision) -> UInt64
  ensures (precision is Single && result == 23) || (precision is Double && result == 52)
{
  match precision {
    Single => 23
    Double => 52
  }
}

fn implicit_bit(precision: Precision) -> UInt64
  ensures (precision is Single && result == 8388608) || (precision is Double && result == 4503599627370496)
{
  match precision {
    Single => 8388608
    Double => 4503599627370496
  }
}

fn exponent_field(precision: Precision) -> UInt64
  ensures (precision is Single && result == 255) || (precision is Double && result == 2047)
{
  match precision {
    Single => 255
    Double => 2047
  }
}

fn minimum_exponent(precision: Precision) -> Int64
  ensures (precision is Single && result == -189) || (precision is Double && result == -1085)
{
  match precision {
    Single => -189
    Double => -1085
  }
}

fn subnormal_exponent(precision: Precision) -> Int64
  ensures (precision is Single && result == -149) || (precision is Double && result == -1074)
{
  match precision {
    Single => -149
    Double => -1074
  }
}

fn sign_mask(is_negative: Bool, precision: Precision) -> UInt64 {
  if !is_negative {
    return 0
  }
  match precision {
    Single => 2147483648
    Double => 9223372036854775808
  }
}

fn zero_bits(is_negative: Bool, precision: Precision) -> UInt64 {
  sign_mask(is_negative, precision: precision)
}

fn infinity_bits(is_negative: Bool, precision: Precision) -> UInt64 {
  sign_mask(is_negative, precision: precision) | (exponent_field(precision) * implicit_bit(precision))
}

fn not_a_number_bits(precision: Precision) -> UInt64 {
  (exponent_field(precision) * implicit_bit(precision)) | (implicit_bit(precision) / 2)
}

fn floor_log10_of_power_of_two(exponent: Int64) -> Int64
  requires -4000 <= exponent && exponent <= 4000
  ensures -1300 <= result && result <= 1300
{
  let product = exponent * 78913
  let quotient = product / 262144
  if product % 262144 < 0 { quotient - 1 } else { quotient }
}

fn floor_log2_of_power_of_ten(exponent: Int64) -> Int64
  requires -4000 <= exponent && exponent <= 4000
  ensures -14000 <= result && result <= 14000
{
  let product = exponent * 108853
  let quotient = product / 32768
  if product % 32768 < 0 { quotient - 1 } else { quotient }
}

fn floor_log10_of_three_quarters_power_of_two(exponent: Int64) -> Int64
  requires -4000 <= exponent && exponent <= 4000
  ensures -1300 <= result && result <= 1300
{
  let product = exponent * 631305 - 261663
  let quotient = product / 2097152
  if product % 2097152 < 0 { quotient - 1 } else { quotient }
}

fn leading_zeros(value: UInt64) -> UInt64
  requires value >= 1
  ensures result <= 63
{
  let zeros = intrinsic::leading_zeros(value)
  if zeros > 63 {
    intrinsic::crash("a nonzero word with 64 leading zeros")
  }
  zeros
}

fn scaler(decimal: Int64, shift: Int64) -> Scaler
  requires -2000 <= decimal && decimal <= 2000
{
  let index = decimal + 348
  if index < 0 || index >= 696 {
    intrinsic::crash("a power of ten outside the table of float conversion")
  }
  if shift < 0 || shift >= 64 {
    intrinsic::crash("a scaling shift outside a word in float conversion")
  }
  let position: UInt64 = intrinsic::convert(index)
  Scaler(high: power_of_ten_high[position], low: power_of_ten_low[position], shift: intrinsic::convert(shift))
}

fn scale(value: UInt64, scaler: Scaler) -> UInt64 {
  let shift = scaler.shift % 64
  let high = intrinsic::multiply_high(value, right: scaler.high)
  let middle = intrinsic::wrapping_multiply(value, right: scaler.high)
  if (high & ((1 << shift) - 1)) != 0 {
    return (high >> shift) | 1
  }
  let correction = intrinsic::multiply_high(value, right: scaler.low)
  let corrected = if middle < correction { intrinsic::wrapping_subtract(high, right: 1) } else { high }
  let is_inexact = intrinsic::wrapping_subtract(middle, right: correction) > 1
  (corrected >> shift) | (if is_inexact { 1 } else { 0 })
}

fn unrounded_floor(value: UInt64) -> UInt64 {
  value >> 2
}

fn unrounded_ceiling(value: UInt64) -> UInt64 {
  intrinsic::wrapping_add(value, right: 3) >> 2
}

fn unrounded_round(value: UInt64) -> UInt64 {
  intrinsic::wrapping_add(value, right: 1 + ((value >> 2) & 1)) >> 2
}

fn unrounded_divide(value: UInt64, divisor: UInt64) -> UInt64
  requires divisor > 0
{
  (value / divisor) | (value & 1) | (if value % divisor != 0 { 1 } else { 0 })
}

fn least_unrounded(value: UInt64) -> UInt64 {
  intrinsic::wrapping_subtract(intrinsic::wrapping_multiply(value, right: 4), right: 2)
}

fn digit_count(value: UInt64) -> UInt64
  requires value >= 1
  ensures 1 <= result && result <= 20
{
  let width: Int64 = intrinsic::convert(64 - leading_zeros(value))
  let estimate = floor_log10_of_power_of_two(width)
  if estimate < 0 || estimate > 19 {
    intrinsic::crash("a digit count outside a word in float conversion")
  }
  let position: UInt64 = intrinsic::convert(estimate)
  let count = if value >= small_powers_of_ten[position] { position + 1 } else { position }
  if count < 1 {
    intrinsic::crash("a nonzero word without digits")
  }
  count
}

fn decode(bits: UInt64, precision: Precision) -> Decoded
  ensures !(result is Finite(is_negative: _, mantissa, exponent) && (mantissa >= 9007199254740992 || exponent < -1074 || exponent > 971))
{
  let implicit = implicit_bit(precision)
  let field = exponent_field(precision)
  let fraction = bits % implicit
  let biased = (bits / implicit) % (field + 1)
  let is_negative = (bits / implicit / (field + 1)) % 2 == 1
  if biased == field {
    return if fraction != 0 { Decoded.NotANumber } else { Decoded.Infinite(is_negative: is_negative) }
  }
  if biased == 0 {
    return Decoded.Finite(is_negative: is_negative, mantissa: fraction, exponent: subnormal_exponent(precision))
  }
  let shift: Int64 = intrinsic::convert(biased)
  Decoded.Finite(is_negative: is_negative, mantissa: fraction + implicit, exponent: subnormal_exponent(precision) + shift - 1)
}

fn shortest(mantissa: UInt64, exponent: Int64, precision: Precision) -> ScaledDecimal
  requires 1 <= mantissa && mantissa < 9007199254740992
  requires -1074 <= exponent && exponent <= 971
  ensures -1400 <= result.exponent && result.exponent <= 1400
{
  let shift = leading_zeros(mantissa)
  let justified = mantissa << shift
  let binary = exponent - intrinsic::convert[UInt64, Int64](shift)
  var gap: UInt64 = 63 - mantissa_bits(precision)
  var decimal: Int64 = 0
  var lower: UInt64 = 0
  var upper: UInt64 = 0
  if justified == 9223372036854775808 && binary > minimum_exponent(precision) {
    decimal = 0 - floor_log10_of_three_quarters_power_of_two(binary + intrinsic::convert[UInt64, Int64](gap))
    lower = justified - (1 << (gap - 2))
    upper = intrinsic::wrapping_add(justified, right: 1 << (gap - 1))
  } else {
    if binary < minimum_exponent(precision) {
      let widening: UInt64 = intrinsic::convert(minimum_exponent(precision) - binary)
      if widening > 63 - gap {
        intrinsic::crash("a subnormal gap outside a word in float conversion")
      }
      gap = gap + widening
    }
    decimal = 0 - floor_log10_of_power_of_two(binary + intrinsic::convert[UInt64, Int64](gap))
    lower = intrinsic::wrapping_subtract(justified, right: 1 << (gap - 1))
    upper = intrinsic::wrapping_add(justified, right: 1 << (gap - 1))
  }
  let odd = (justified >> gap) & 1
  let scaling = scaler(decimal, shift: 0 - (binary + floor_log2_of_power_of_ten(decimal) + 3))
  let smallest = unrounded_ceiling(intrinsic::wrapping_add(scale(lower, scaler: scaling), right: odd))
  let largest = unrounded_floor(intrinsic::wrapping_subtract(scale(upper, scaler: scaling), right: odd))
  let shorter = largest / 10
  if intrinsic::wrapping_multiply(shorter, right: 10) >= smallest {
    return ScaledDecimal(significand: shorter, exponent: 1 - decimal)
  }
  if smallest < largest {
    return ScaledDecimal(significand: unrounded_round(scale(justified, scaler: scaling)), exponent: 0 - decimal)
  }
  ScaledDecimal(significand: smallest, exponent: 0 - decimal)
}

fn fixed_width(mantissa: UInt64, exponent: Int64, count: UInt64, limit: Int64) -> ScaledDecimal
  requires 1 <= mantissa && mantissa < 9007199254740992
  requires -1074 <= exponent && exponent <= 971
  requires 1 <= count && count <= 18
  requires 0 <= limit && limit <= 100000
  ensures -1400 <= result.exponent && result.exponent <= 1400
{
  let shift = leading_zeros(mantissa)
  let justified = mantissa << shift
  let binary = exponent - intrinsic::convert[UInt64, Int64](shift)
  let digits: Int64 = intrinsic::convert(count)
  var decimal = digits - 1 - floor_log10_of_power_of_two(binary + 63)
  let scaling = scaler(decimal, shift: 0 - (binary + floor_log2_of_power_of_ten(decimal) + 3))
  var scaled = scale(justified, scaler: scaling)
  if scaled >= least_unrounded(small_powers_of_ten[count]) {
    scaled = unrounded_divide(scaled, divisor: 10)
    decimal -= 1
  }
  while decimal > limit
    invariant -1400 <= decimal && decimal <= 1400
    decreases decimal - limit
  {
    scaled = unrounded_divide(scaled, divisor: 10)
    decimal -= 1
  }
  ScaledDecimal(significand: unrounded_round(scaled), exponent: 0 - decimal)
}

fn no_digits() -> DecimalDigits
  ensures result.point == 0
{
  DecimalDigits(digits: Digits.Short(digits: Array.filled(48), count: 0), point: 0)
}

fn length_of(digits: Digits) -> UInt64
  ensures result <= 1000
{
  let length = match digits {
    Short(digits: _, count) => count
    Long(digits: storage) => intrinsic::storage_length(storage)
  }
  if length > 1000 {
    intrinsic::crash("more digits than a float has in float conversion")
  }
  length
}

fn digit_at(digits: Digits, position: Int64) -> UInt8 {
  if position < 0 {
    return 48
  }
  let index: UInt64 = intrinsic::convert(position)
  match digits {
    Short(digits: buffer, count) => if index < count && index < 20 { buffer[index] } else { 48 }
    Long(digits: storage) => if index < intrinsic::storage_length(storage) { intrinsic::view_at(intrinsic::storage_view(storage), index: index) } else { 48 }
  }
}

fn push_digit(digits: mut intrinsic::Storage[UInt8], value: UInt8) {
  if intrinsic::storage_length(digits) >= intrinsic::storage_capacity(digits) {
    growth::reserve(mut digits, additional: 1)
  }
  intrinsic::storage_push(mut digits, value: value)
}

fn digits_of(number: ScaledDecimal) -> DecimalDigits
  requires -1400 <= number.exponent && number.exponent <= 1400
  ensures -1400 <= result.point && result.point <= 1420
{
  if number.significand == 0 {
    return no_digits()
  }
  let count = digit_count(number.significand)
  var digits: Array[UInt8, 20] = Array.filled(48)
  var rest = number.significand
  for offset in 0..count {
    let digit: UInt8 = intrinsic::convert(rest % 10)
    digits[count - 1 - offset] = digit + 48
    rest = rest / 10
  }
  var kept = count
  while kept > 0 && digits[kept - 1] == 48
    invariant kept <= count
    decreases kept
  {
    kept -= 1
  }
  let written: Int64 = intrinsic::convert(count)
  DecimalDigits(digits: Digits.Short(digits: digits, count: kept), point: written + number.exponent)
}

fn trim_trailing_zeros(digits: mut intrinsic::Storage[UInt8]) {
  for _ in 0..intrinsic::storage_length(digits) {
    let length = intrinsic::storage_length(digits)
    if length == 0 || intrinsic::view_at(intrinsic::storage_view(digits), index: length - 1) != 48 {
      return
    }
    let _ = intrinsic::storage_pop(mut digits)
  }
}

fn push_limb(limbs: mut intrinsic::Storage[UInt64], value: UInt64) {
  if intrinsic::storage_length(limbs) >= intrinsic::storage_capacity(limbs) {
    growth::reserve(mut limbs, additional: 1)
  }
  intrinsic::storage_push(mut limbs, value: value)
}

fn limbs_of(value: UInt64) -> intrinsic::Storage[UInt64] {
  var limbs: intrinsic::Storage[UInt64] = intrinsic::storage_with_capacity(0)
  push_limb(mut limbs, value: value % limb_base)
  push_limb(mut limbs, value: (value / limb_base) % limb_base)
  push_limb(mut limbs, value: value / limb_base / limb_base)
  limbs
}

fn multiplied(limbs: intrinsic::View[UInt64], factor: UInt64) -> intrinsic::Storage[UInt64] {
  var product: intrinsic::Storage[UInt64] = intrinsic::storage_with_capacity(0)
  var carry: UInt64 = 0
  for index in 0..intrinsic::view_length(limbs) {
    let part = intrinsic::wrapping_multiply(intrinsic::view_at(limbs, index: index), right: factor)
    let total = intrinsic::wrapping_add(part, right: carry)
    push_limb(mut product, value: total % limb_base)
    carry = total / limb_base
  }
  for _ in 0..3 {
    if carry == 0 {
      break
    }
    push_limb(mut product, value: carry % limb_base)
    carry = carry / limb_base
  }
  product
}

fn multiplied_by_power(limbs: own intrinsic::Storage[UInt64], base: UInt64, count: UInt64) -> intrinsic::Storage[UInt64]
  requires base == 2 || base == 5 || base == 10
{
  let step: UInt64 = if base == 2 { 29 } else if base == 5 { 13 } else { 9 }
  let step_factor: UInt64 = if base == 2 { 536870912 } else if base == 5 { 1220703125 } else { 1000000000 }
  var product = own limbs
  for _ in 0..count / step {
    product = multiplied(intrinsic::storage_view(product), factor: step_factor)
  }
  var rest: UInt64 = 1
  for _ in 0..count % step {
    rest = intrinsic::wrapping_multiply(rest, right: base)
  }
  multiplied(intrinsic::storage_view(product), factor: rest)
}

fn multiplied_by_power_of_ten(limbs: own intrinsic::Storage[UInt64], count: UInt64) -> intrinsic::Storage[UInt64] {
  var shifted: intrinsic::Storage[UInt64] = intrinsic::storage_with_capacity(0)
  for _ in 0..count / 9 {
    push_limb(mut shifted, value: 0)
  }
  for index in 0..intrinsic::storage_length(limbs) {
    push_limb(mut shifted, value: intrinsic::view_at(intrinsic::storage_view(limbs), index: index))
  }
  multiplied_by_power(own shifted, base: 10, count: count % 9)
}

fn significant_limbs(limbs: intrinsic::View[UInt64]) -> UInt64
  ensures result <= intrinsic::view_length(limbs)
{
  var count = intrinsic::view_length(limbs)
  while count > 0 && intrinsic::view_at(limbs, index: count - 1) == 0
    invariant count <= intrinsic::view_length(limbs)
    decreases count
  {
    count -= 1
  }
  count
}

fn compare_limbs(left: intrinsic::View[UInt64], right: intrinsic::View[UInt64]) -> Int64 {
  let left_count = significant_limbs(left)
  let right_count = significant_limbs(right)
  if left_count != right_count {
    return if left_count < right_count { -1 } else { 1 }
  }
  for offset in 0..left_count {
    let index = left_count - 1 - offset
    if index < intrinsic::view_length(right) {
      let first = intrinsic::view_at(left, index: index)
      let second = intrinsic::view_at(right, index: index)
      if first != second {
        return if first < second { -1 } else { 1 }
      }
    }
  }
  0
}

fn decimal_of_limbs(limbs: intrinsic::View[UInt64]) -> intrinsic::Storage[UInt8] {
  var digits: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(0)
  let count = significant_limbs(limbs)
  for offset in 0..count {
    let limb = intrinsic::view_at(limbs, index: count - 1 - offset)
    for place in 0..9 {
      let digit: UInt8 = intrinsic::convert((limb / small_powers_of_ten[8 - place]) % 10)
      if offset > 0 || intrinsic::storage_length(digits) > 0 || digit != 0 {
        push_digit(mut digits, value: digit + 48)
      }
    }
  }
  digits
}

fn exact_digits(mantissa: UInt64, exponent: Int64) -> ExactDigits
  requires 1 <= mantissa && mantissa < 9007199254740992
  requires -1074 <= exponent && exponent <= 971
  ensures -2000 <= result.point && result.point <= 2000
{
  let limbs = if exponent >= 0 {
    multiplied_by_power(limbs_of(mantissa), base: 2, count: intrinsic::convert(exponent))
  } else {
    multiplied_by_power(limbs_of(mantissa), base: 5, count: intrinsic::convert(0 - exponent))
  }
  var digits = decimal_of_limbs(intrinsic::storage_view(limbs))
  let length = intrinsic::storage_length(digits)
  if length > 1000 {
    intrinsic::crash("more digits than a float has in float conversion")
  }
  let written: Int64 = intrinsic::convert(length)
  trim_trailing_zeros(mut digits)
  ExactDigits(digits: own digits, point: if exponent < 0 { written + exponent } else { written })
}

fn rounded(number: own ExactDigits, keep: Int64) -> DecimalDigits
  requires -2000 <= number.point && number.point <= 2000
  requires keep <= 200000
  ensures -2000 <= result.point && result.point <= 2001
{
  var digits = own number.digits
  let point = number.point
  let length = intrinsic::storage_length(digits)
  if keep < 0 {
    return no_digits()
  }
  let kept: UInt64 = intrinsic::convert(keep)
  if kept >= length {
    return DecimalDigits(digits: Digits.Long(digits: own digits), point: point)
  }
  let view = intrinsic::storage_view(digits)
  let next_digit = intrinsic::view_at(view, index: kept)
  let has_more_digits = kept + 1 < length
  let is_odd = kept > 0 && intrinsic::view_at(view, index: kept - 1) % 2 == 1
  let rounds_up = next_digit > 53 || (next_digit == 53 && (has_more_digits || is_odd))
  intrinsic::storage_shorten(mut digits, length: kept)
  if !rounds_up {
    trim_trailing_zeros(mut digits)
    return DecimalDigits(digits: Digits.Long(digits: own digits), point: point)
  }
  for _ in 0..kept {
    let last = intrinsic::storage_length(digits)
    if last == 0 || intrinsic::view_at(intrinsic::storage_view(digits), index: last - 1) != 57 {
      break
    }
    let _ = intrinsic::storage_pop(mut digits)
  }
  let last = intrinsic::storage_length(digits)
  if last == 0 {
    push_digit(mut digits, value: 49)
    return DecimalDigits(digits: Digits.Long(digits: own digits), point: point + 1)
  }
  let digit = intrinsic::view_at(intrinsic::storage_view(digits), index: last - 1)
  if digit < 48 || digit > 56 {
    intrinsic::crash("a digit that is not a decimal digit in float conversion")
  }
  let _ = intrinsic::storage_pop(mut digits)
  push_digit(mut digits, value: digit + 1)
  DecimalDigits(digits: Digits.Long(digits: own digits), point: point)
}

fn write_zeros(output: mut intrinsic::Storage[UInt8], count: Int64) {
  if count > 0 {
    let zeros: UInt64 = intrinsic::convert(count)
    growth::reserve(mut output, additional: zeros)
    for _ in 0..zeros {
      writing::byte(mut output, value: 48)
    }
  }
}

fn write_digits(output: mut intrinsic::Storage[UInt8], digits: Digits, from: Int64, to: Int64)
  requires -100000 <= from && to <= 100000
{
  for position in from..to {
    writing::byte(mut output, value: digit_at(digits, position: position))
  }
}

fn write_exponent(output: mut intrinsic::Storage[UInt8], exponent: Int64) {
  writing::byte(mut output, value: 101)
  writing::signed(mut output, value: exponent)
}

fn write_named(output: mut intrinsic::Storage[UInt8], decoded: Decoded) -> Bool {
  match decoded {
    NotANumber => {
      writing::append(mut output, bytes: "NaN".slice().bytes)
      true
    }
    Infinite(is_negative) => {
      writing::append(mut output, bytes: if is_negative { "-infinity".slice().bytes } else { "infinity".slice().bytes })
      true
    }
    Finite(is_negative: _, mantissa: _, exponent: _) => false
  }
}

fn write_shortest_layout(output: mut intrinsic::Storage[UInt8], is_negative: Bool, number: DecimalDigits)
  requires -2000 <= number.point && number.point <= 2001
{
  growth::reserve(mut output, additional: 32)
  if is_negative {
    writing::byte(mut output, value: 45)
  }
  let digits = number.digits
  let length = length_of(digits)
  if length == 0 {
    writing::append(mut output, bytes: "0.0".slice().bytes)
    return
  }
  let count: Int64 = intrinsic::convert(length)
  let point = number.point
  let exponent = point - 1
  if exponent < -6 || exponent >= 21 {
    write_digits(mut output, digits: digits, from: 0, to: 1)
    if count > 1 {
      writing::byte(mut output, value: 46)
      write_digits(mut output, digits: digits, from: 1, to: count)
    }
    write_exponent(mut output, exponent: exponent)
  } else if point <= 0 {
    writing::append(mut output, bytes: "0.".slice().bytes)
    write_zeros(mut output, count: 0 - point)
    write_digits(mut output, digits: digits, from: 0, to: count)
  } else if point >= count {
    write_digits(mut output, digits: digits, from: 0, to: count)
    write_zeros(mut output, count: point - count)
    writing::append(mut output, bytes: ".0".slice().bytes)
  } else {
    write_digits(mut output, digits: digits, from: 0, to: point)
    writing::byte(mut output, value: 46)
    write_digits(mut output, digits: digits, from: point, to: count)
  }
}

fn write_shortest_of(output: mut intrinsic::Storage[UInt8], bits: UInt64, precision: Precision) {
  let decoded = decode(bits, precision: precision)
  if write_named(mut output, decoded: decoded) {
    return
  }
  if decoded is Finite(is_negative, mantissa, exponent) {
    let number = if mantissa == 0 { no_digits() } else { digits_of(shortest(mantissa, exponent: exponent, precision: precision)) }
    write_shortest_layout(mut output, is_negative: is_negative, number: number)
  }
}

internal fn write_shortest_float64(output: mut intrinsic::Storage[UInt8], value: Float64) {
  write_shortest_of(mut output, bits: intrinsic::to_bits(value), precision: Precision.Double)
}

internal fn write_shortest_float32(output: mut intrinsic::Storage[UInt8], value: Float32) {
  let bits: UInt32 = intrinsic::to_bits(value)
  write_shortest_of(mut output, bits: intrinsic::convert(bits), precision: Precision.Single)
}

fn bounded_decimals(decimals: UInt64) -> Int64
  ensures 0 <= result && result <= 100000
{
  if decimals > 100000 { 100000 } else { intrinsic::convert(decimals) }
}

fn decimal_count(decimals: UInt64) -> Int64
  ensures 0 <= result && result <= 4611686018427387903
{
  if decimals > largest_count {
    intrinsic::crash("more decimals than a text can hold")
  }
  intrinsic::convert(decimals)
}

fn fixed_digits(mantissa: UInt64, exponent: Int64, decimals: UInt64) -> DecimalDigits
  requires 1 <= mantissa && mantissa < 9007199254740992
  requires -1074 <= exponent && exponent <= 971
  ensures -2000 <= result.point && result.point <= 2001
{
  let places = bounded_decimals(decimals)
  let leading = exponent + 52
  let count = if leading >= 0 {
    1 + floor_log10_of_power_of_two(1 + leading) + places
  } else {
    1 + places - floor_log10_of_power_of_two(0 - leading)
  }
  if count <= 0 {
    return no_digits()
  }
  if count <= 18 {
    return digits_of(fixed_width(mantissa, exponent: exponent, count: intrinsic::convert(count), limit: places))
  }
  let exact = exact_digits(mantissa, exponent: exponent)
  let point = exact.point
  rounded(own exact, keep: point + places)
}

fn scientific_digits(mantissa: UInt64, exponent: Int64, decimals: UInt64) -> DecimalDigits
  requires 1 <= mantissa && mantissa < 9007199254740992
  requires -1074 <= exponent && exponent <= 971
  ensures -2000 <= result.point && result.point <= 2001
{
  if decimals < 18 {
    return digits_of(fixed_width(mantissa, exponent: exponent, count: decimals + 1, limit: 100000))
  }
  rounded(exact_digits(mantissa, exponent: exponent), keep: bounded_decimals(decimals) + 1)
}

internal fn write_fixed(output: mut intrinsic::Storage[UInt8], value: Float64, decimals: UInt64) {
  let decoded = decode(intrinsic::to_bits(value), precision: Precision.Double)
  if write_named(mut output, decoded: decoded) {
    return
  }
  if decoded is Finite(is_negative, mantissa, exponent) {
    let number = if mantissa == 0 { no_digits() } else { fixed_digits(mantissa, exponent: exponent, decimals: decimals) }
    let digits = number.digits
    let is_zero = length_of(digits) == 0
    let count = decimal_count(decimals)
    let integer_digits: Int64 = if number.point > 1 && !is_zero { number.point } else { 1 }
    growth::reserve(mut output, additional: intrinsic::convert(count + integer_digits + 2))
    if is_negative {
      writing::byte(mut output, value: 45)
    }
    if number.point <= 0 || is_zero {
      writing::byte(mut output, value: 48)
    } else {
      write_digits(mut output, digits: digits, from: 0, to: number.point)
    }
    if count > 0 {
      writing::byte(mut output, value: 46)
      let start = if is_zero { 0 } else { number.point }
      for offset in 0..count {
        writing::byte(mut output, value: digit_at(digits, position: start + offset))
      }
    }
  }
}

internal fn write_scientific(output: mut intrinsic::Storage[UInt8], value: Float64, decimals: UInt64) {
  let decoded = decode(intrinsic::to_bits(value), precision: Precision.Double)
  if write_named(mut output, decoded: decoded) {
    return
  }
  if decoded is Finite(is_negative, mantissa, exponent) {
    let number = if mantissa == 0 { no_digits() } else { scientific_digits(mantissa, exponent: exponent, decimals: decimals) }
    let digits = number.digits
    let is_zero = length_of(digits) == 0
    let count = decimal_count(decimals)
    growth::reserve(mut output, additional: intrinsic::convert(count + 12))
    if is_negative {
      writing::byte(mut output, value: 45)
    }
    writing::byte(mut output, value: digit_at(digits, position: 0))
    if count > 0 {
      writing::byte(mut output, value: 46)
      for offset in 0..count {
        writing::byte(mut output, value: digit_at(digits, position: 1 + offset))
      }
    }
    write_exponent(mut output, exponent: if is_zero { 0 } else { number.point - 1 })
  }
}

fn is_digit(byte: UInt8) -> Bool
  ensures result == (48 <= byte && byte <= 57)
{
  48 <= byte && byte <= 57
}

fn is_named(text: intrinsic::View[UInt8], from: UInt64, bytes: intrinsic::View[UInt8]) -> Bool {
  let length = intrinsic::view_length(bytes)
  if from > intrinsic::view_length(text) || intrinsic::view_length(text) - from != length {
    return false
  }
  for index in 0..length {
    if intrinsic::view_at(text, index: from + index) != intrinsic::view_at(bytes, index: index) {
      return false
    }
  }
  true
}

fn signed_count(count: UInt64) -> Int64
  ensures 0 <= result && result <= 4611686018427387903
{
  if count > largest_count {
    intrinsic::crash("a text longer than memory in float conversion")
  }
  intrinsic::convert(count)
}

fn read_exponent(text: intrinsic::View[UInt8], from: UInt64) -> Int64
  ensures -1000000000000000 <= result && result <= 1000000000000000
{
  var is_negative = false
  var written: Int64 = 0
  for index in from..intrinsic::view_length(text)
    invariant 0 <= written && written <= 1000000000000000
  {
    let byte = intrinsic::view_at(text, index: index)
    if byte == 45 {
      is_negative = true
    } else if 48 <= byte && byte <= 57 && written < 100000000000000 {
      let digit: Int64 = intrinsic::convert(byte - 48)
      written = written * 10 + digit
    }
  }
  if is_negative { 0 - written } else { written }
}

fn accumulated(significand: UInt64, byte: UInt8) -> UInt64
  requires significand < 1000000000000000000
  requires 48 <= byte && byte <= 57
  ensures result < 10000000000000000000
{
  let digit: UInt64 = intrinsic::convert(byte - 48)
  significand * 10 + digit
}

fn read_text(text: intrinsic::View[UInt8]) -> ReadText
  ensures !(result is Number(text: decimal) && decimal.significand >= 10000000000000000000)
{
  let length = intrinsic::view_length(text)
  if length == 0 {
    return ReadText.Unreadable(error: core::ParseFloatError.Empty)
  }
  let first = intrinsic::view_at(text, index: 0)
  let is_negative = first == 45
  let from: UInt64 = if is_negative || first == 43 { 1 } else { 0 }
  if is_named(text, from: from, bytes: "NaN".slice().bytes) {
    return ReadText.NotANumberText
  }
  if is_named(text, from: from, bytes: "infinity".slice().bytes) {
    return ReadText.InfinityText(is_negative: is_negative)
  }
  var stop = length
  var significand: UInt64 = 0
  var digits: UInt64 = 0
  var fraction: UInt64 = 0
  var dropped: UInt64 = 0
  var is_truncated = false
  var is_fraction = false
  for index in from..length
    invariant significand < 10000000000000000000
    invariant digits <= index && fraction <= index && dropped <= index
  {
    let byte = intrinsic::view_at(text, index: index)
    if byte == 46 && !is_fraction {
      is_fraction = true
    } else if 48 <= byte && byte <= 57 {
      digits += 1
      if significand == 0 && byte == 48 {
        if is_fraction {
          fraction += 1
        }
      } else if significand < 1000000000000000000 {
        significand = accumulated(significand, byte: byte)
        if is_fraction {
          fraction += 1
        }
      } else {
        if byte != 48 {
          is_truncated = true
        }
        if !is_fraction {
          dropped += 1
        }
      }
    } else {
      stop = index
      break
    }
  }
  if digits == 0 {
    return ReadText.Unreadable(error: core::ParseFloatError.InvalidCharacter(offset: from))
  }
  var exponent = signed_count(dropped) - signed_count(fraction)
  if stop < length && (intrinsic::view_at(text, index: stop) == 101 || intrinsic::view_at(text, index: stop) == 69) {
    var start = stop + 1
    if start < length && (intrinsic::view_at(text, index: start) == 43 || intrinsic::view_at(text, index: start) == 45) {
      start += 1
    }
    var end = length
    for index in start..length {
      if !is_digit(intrinsic::view_at(text, index: index)) {
        end = index
        break
      }
    }
    if end == start {
      return ReadText.Unreadable(error: core::ParseFloatError.InvalidCharacter(offset: start))
    }
    exponent = exponent + read_exponent(text, from: stop + 1)
    stop = end
  }
  if stop < length {
    return ReadText.Unreadable(error: core::ParseFloatError.InvalidCharacter(offset: stop))
  }
  ReadText.Number(text: DecimalText(significand: significand, exponent: exponent, is_negative: is_negative, is_truncated: is_truncated))
}

fn packed(is_negative: Bool, significand: UInt64, binary: Int64, precision: Precision) -> UInt64
  requires -20000 <= binary && binary <= 20000
{
  let implicit = implicit_bit(precision)
  let sign = sign_mask(is_negative, precision: precision)
  if significand < implicit {
    return sign | significand
  }
  if significand >= implicit * 2 {
    intrinsic::crash("a rounded significand wider than its float in float conversion")
  }
  let field = binary - subnormal_exponent(precision) + 1
  let largest: Int64 = intrinsic::convert(exponent_field(precision))
  if field >= largest {
    return infinity_bits(is_negative, precision: precision)
  }
  if field < 1 {
    intrinsic::crash("a normal float below the normal exponents in float conversion")
  }
  let biased: UInt64 = intrinsic::convert(field)
  sign | (significand - implicit) | (biased * implicit)
}

fn nearest_bits(significand: UInt64, exponent: Int64, is_negative: Bool, precision: Precision) -> UInt64
  requires significand >= 1
  requires -400 <= exponent && exponent <= 400
{
  let width: Int64 = intrinsic::convert(mantissa_bits(precision))
  let unused = leading_zeros(significand)
  let used: Int64 = 64 - intrinsic::convert[UInt64, Int64](unused)
  let decimal_log2 = floor_log2_of_power_of_ten(exponent)
  var binary = width + 1 - used - decimal_log2
  let limit = 0 - subnormal_exponent(precision)
  if binary > limit {
    binary = limit
  }
  let shift = 0 - (binary - (64 - used) + decimal_log2 + 3)
  if shift >= 64 {
    return zero_bits(is_negative, precision: precision)
  }
  var scaled = scale(significand << unused, scaler: scaler(exponent, shift: shift))
  if scaled >= least_unrounded(implicit_bit(precision) * 2) {
    scaled = (scaled >> 1) | (scaled & 1)
    binary -= 1
  }
  packed(is_negative, significand: unrounded_round(scaled), binary: 0 - binary, precision: precision)
}

fn all_digits(text: intrinsic::View[UInt8]) -> ExactDigits
  ensures -5000000000000000000 <= result.point && result.point <= 1000000000000000
{
  var digits: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(0)
  var fraction: UInt64 = 0
  var is_fraction = false
  var exponent_start = intrinsic::view_length(text)
  for index in 0..intrinsic::view_length(text)
    invariant fraction <= index
  {
    let byte = intrinsic::view_at(text, index: index)
    if byte == 101 || byte == 69 {
      exponent_start = index + 1
      break
    }
    if byte == 46 {
      is_fraction = true
    } else if is_digit(byte) {
      if is_fraction {
        fraction += 1
      }
      if intrinsic::storage_length(digits) > 0 || byte != 48 {
        push_digit(mut digits, value: byte)
      }
    }
  }
  ExactDigits(digits: own digits, point: read_exponent(text, from: exponent_start) - signed_count(fraction))
}

fn limbs_of_digits(digits: intrinsic::View[UInt8]) -> intrinsic::Storage[UInt64] {
  let count = intrinsic::view_length(digits)
  var limbs: intrinsic::Storage[UInt64] = intrinsic::storage_with_capacity(0)
  var end = count
  while end > 0
    invariant end <= count
    decreases end
  {
    let start = if end > 9 { end - 9 } else { 0 }
    var limb: UInt64 = 0
    for index in start..end {
      let byte: UInt64 = intrinsic::convert(intrinsic::view_at(digits, index: index))
      limb = intrinsic::wrapping_add(intrinsic::wrapping_multiply(limb, right: 10), right: intrinsic::wrapping_subtract(byte, right: 48))
    }
    push_limb(mut limbs, value: limb)
    end = start
  }
  limbs
}

fn rounds_to_upper(text: intrinsic::View[UInt8], lower: UInt64, precision: Precision) -> Bool {
  let parts = match decode(lower, precision: precision) {
    Finite(is_negative: _, mantissa, exponent) => ScaledDecimal(significand: mantissa, exponent: exponent)
    _ => ScaledDecimal(significand: 0, exponent: subnormal_exponent(precision))
  }
  if parts.exponent < -1074 || parts.exponent > 971 || parts.significand >= 9007199254740992 {
    intrinsic::crash("a decoded float outside its format in float conversion")
  }
  let number = all_digits(text)
  let midpoint_exponent = parts.exponent - 1
  var left = limbs_of_digits(intrinsic::storage_view(number.digits))
  var right = limbs_of(parts.significand * 2 + 1)
  if number.point >= 0 {
    left = multiplied_by_power_of_ten(own left, count: intrinsic::convert(number.point))
  } else {
    right = multiplied_by_power_of_ten(own right, count: intrinsic::convert(0 - number.point))
  }
  if midpoint_exponent >= 0 {
    right = multiplied_by_power(own right, base: 2, count: intrinsic::convert(midpoint_exponent))
  } else {
    left = multiplied_by_power(own left, base: 2, count: intrinsic::convert(0 - midpoint_exponent))
  }
  let order = compare_limbs(intrinsic::storage_view(left), right: intrinsic::storage_view(right))
  order > 0 || (order == 0 && parts.significand % 2 == 1)
}

fn parsed_bits(text: intrinsic::View[UInt8], precision: Precision, overflow: Int64, underflow: Int64) -> Result[UInt64, core::ParseFloatError]
  requires -400 <= underflow && overflow <= 400
{
  match read_text(text) {
    Unreadable(error) => Err(error)
    NotANumberText => Ok(not_a_number_bits(precision))
    InfinityText(is_negative) => Ok(infinity_bits(is_negative, precision: precision))
    Number(number) => {
      if number.significand == 0 || number.exponent < underflow {
        return Ok(zero_bits(number.is_negative, precision: precision))
      }
      if number.exponent > overflow {
        return Ok(infinity_bits(number.is_negative, precision: precision))
      }
      let lower = nearest_bits(number.significand, exponent: number.exponent, is_negative: number.is_negative, precision: precision)
      if !number.is_truncated {
        return Ok(lower)
      }
      let upper = nearest_bits(number.significand + 1, exponent: number.exponent, is_negative: number.is_negative, precision: precision)
      if lower == upper || !rounds_to_upper(text, lower: lower, precision: precision) {
        return Ok(lower)
      }
      Ok(upper)
    }
  }
}

internal fn parse_float64(text: intrinsic::View[UInt8]) -> Result[Float64, core::ParseFloatError] {
  match parsed_bits(text, precision: Precision.Double, overflow: 310, underflow: -345) {
    Ok(bits) => Ok(intrinsic::from_bits[UInt64, Float64](bits))
    Err(error) => Err(error)
  }
}

internal fn parse_float32(text: intrinsic::View[UInt8]) -> Result[Float32, core::ParseFloatError] {
  match parsed_bits(text, precision: Precision.Single, overflow: 40, underflow: -70) {
    Ok(bits) => Ok(intrinsic::from_bits[UInt32, Float32](intrinsic::convert(bits % 4294967296)))
    Err(error) => Err(error)
  }
}
