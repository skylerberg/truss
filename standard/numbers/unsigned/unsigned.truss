impl Equal for USize {
  fn equal(self, other: USize) -> Bool
    cost time O(1)
  {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for USize {
  fn compare(self, other: USize) -> Ordering
    ensures result == (if self < other { Ordering.Less } else if self == other { Ordering.Equal } else { Ordering.Greater })
    cost time O(1)
  {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Default for USize {
  fn default() -> USize
    cost time O(1)
  {
    0
  }
}

impl Display for USize {
  fn display(self, output: mut TextBuilder) {
    mut output.write_unsigned(intrinsic::convert(self))
  }
}

impl Add[USize] for USize {
  type Output = USize

  fn add_is_defined(self, right: USize) -> Bool
    cost time O(1)
  {
    !intrinsic::add_overflows(self, right: right)
  }

  fn add(self, right: USize) -> USize
    requires !intrinsic::add_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::add(self, right)
  }
}

