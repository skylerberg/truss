use standard::core
use standard::intrinsic

impl Equal for UInt8 {
  fn equal(self, other: UInt8) -> Bool
    cost time O(1)
  {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for UInt8 {
  fn compare(self, other: UInt8) -> Ordering
    ensures result == (if self < other { Ordering.Less } else if self == other { Ordering.Equal } else { Ordering.Greater })
    cost time O(1)
  {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Default for UInt8 {
  fn default() -> UInt8
    cost time O(1)
  {
    0
  }
}

impl Display for UInt8 {
  fn display(self, output: mut TextBuilder) {
    mut output.write_unsigned(intrinsic::convert(self))
  }
}

impl Add[UInt8] for UInt8 {
  type Output = UInt8

  fn add_is_defined(self, right: UInt8) -> Bool
    cost time O(1)
  {
    !intrinsic::add_overflows(self, right: right)
  }

  fn add(self, right: UInt8) -> UInt8
    requires !intrinsic::add_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::add(self, right)
  }
}

impl Subtract[UInt8] for UInt8 {
  type Output = UInt8

  fn subtract_is_defined(self, right: UInt8) -> Bool
    cost time O(1)
  {
    !intrinsic::subtract_overflows(self, right: right)
  }

  fn subtract(self, right: UInt8) -> UInt8
    requires !intrinsic::subtract_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::subtract(self, right)
  }
}

impl Multiply[UInt8] for UInt8 {
  type Output = UInt8

  fn multiply_is_defined(self, right: UInt8) -> Bool
    cost time O(1)
  {
    !intrinsic::multiply_overflows(self, right: right)
  }

  fn multiply(self, right: UInt8) -> UInt8
    requires !intrinsic::multiply_overflows(self, right: right)
    cost time O(1)
  {
    intrinsic::multiply(self, right)
  }
}

impl Divide[UInt8] for UInt8 {
  type Output = UInt8

  fn divide_is_defined(self, right: UInt8) -> Bool
    cost time O(1)
  {
    right != 0
  }

  fn divide(self, right: UInt8) -> UInt8
    requires right != 0
    cost time O(1)
  {
    intrinsic::divide(self, right)
  }
}

impl Remainder[UInt8] for UInt8 {
  type Output = UInt8

  fn remainder_is_defined(self, right: UInt8) -> Bool
    cost time O(1)
  {
    right != 0
  }

  fn remainder(self, right: UInt8) -> UInt8
    requires right != 0
    cost time O(1)
  {
    intrinsic::remainder(self, right)
  }
}

impl Hash for UInt8 {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write(intrinsic::convert(self))
  }
}

public let UInt8.minimum: UInt8 = 0

public let UInt8.maximum: UInt8 = 255

impl TryFrom[Int8] for UInt8 {
  type Error = core::ConversionError

  fn try_from(value: own Int8) -> Result[UInt8, core::ConversionError]
    ensures (result is Ok(_)) == (0 <= value)
    ensures !(result is Ok(converted) && converted != value)
    cost time O(1)
  {
    if intrinsic::fits[Int8, UInt8](value) { Ok(intrinsic::convert(value)) } else { Err(core::ConversionError()) }
  }
}

impl TryFrom[Int16] for UInt8 {
  type Error = core::ConversionError

  fn try_from(value: own Int16) -> Result[UInt8, core::ConversionError]
    ensures (result is Ok(_)) == (0 <= value && value <= 255)
    ensures !(result is Ok(converted) && converted != value)
    cost time O(1)
  {
    if intrinsic::fits[Int16, UInt8](value) { Ok(intrinsic::convert(value)) } else { Err(core::ConversionError()) }
  }
}

