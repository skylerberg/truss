impl FixedWidthInteger for UInt8 {
  fn minimum_value() -> UInt8
    ensures result == UInt8.minimum
    cost time O(1)
  {
    UInt8.minimum
  }

  fn maximum_value() -> UInt8
    ensures result == UInt8.maximum
    cost time O(1)
  {
    UInt8.maximum
  }

  fn bit_width() -> UInt64
    ensures result == UInt8.bits
    cost time O(1)
  {
    UInt8.bits
  }

  type Bytes = Array[UInt8, 1]

  fn to_big_endian_bytes(self) -> Array[UInt8, 1]
    cost time O(1)
  {
    [self]
  }

  fn to_little_endian_bytes(self) -> Array[UInt8, 1]
    cost time O(1)
  {
    [self]
  }

  fn from_big_endian_bytes(bytes: Array[UInt8, 1]) -> UInt8
    ensures result == (bytes[0])
    cost time O(1)
  {
    bytes[0]
  }

  fn from_little_endian_bytes(bytes: Array[UInt8, 1]) -> UInt8
    ensures result == (bytes[0])
    cost time O(1)
  {
    bytes[0]
  }

  fn reverse_bits(self) -> UInt8
    cost time O(1)
  {
    intrinsic::convert(integers::reverse_uint64_bits(intrinsic::convert(self)) >> 56)
  }
}

impl UnsignedInteger for UInt8 {
  type Signed = Int8

  fn integer_square_root(self) -> UInt8
    ensures result * result <= self
    ensures self < (result + 1) * (result + 1)
    cost time O(8)
  {
    var result: UInt8 = 0
    var width: UInt8 = 16
    while width > 1
      invariant width >= 1
      invariant result + width <= 16
      invariant result * result <= self
      invariant self < (result + width) * (result + width)
      decreases width
      cost time O(log(15) - log(width - 1))
    {
      let half = width / 2
      let candidate = result + half
      if candidate * candidate <= self {
        result = candidate
        width = width - half
      } else {
        width = half
      }
    }
    result
  }
}

impl FixedWidthInteger for UInt16 {
  fn minimum_value() -> UInt16
    ensures result == UInt16.minimum
    cost time O(1)
  {
    UInt16.minimum
  }

  fn maximum_value() -> UInt16
    ensures result == UInt16.maximum
    cost time O(1)
  {
    UInt16.maximum
  }

  fn bit_width() -> UInt64
    ensures result == UInt16.bits
    cost time O(1)
  {
    UInt16.bits
  }

  type Bytes = Array[UInt8, 2]

  fn to_big_endian_bytes(self) -> Array[UInt8, 2]
    cost time O(1)
  {
    [intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
  }

  fn to_little_endian_bytes(self) -> Array[UInt8, 2]
    cost time O(1)
  {
    [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255)]
  }

  fn from_big_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
    ensures result == ((intrinsic::convert[UInt8, UInt16](bytes[0]) << 8) | intrinsic::convert[UInt8, UInt16](bytes[1]))
    cost time O(1)
  {
    (intrinsic::convert[UInt8, UInt16](bytes[0]) << 8) | intrinsic::convert[UInt8, UInt16](bytes[1])
  }

  fn from_little_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
    ensures result == (intrinsic::convert[UInt8, UInt16](bytes[0]) | (intrinsic::convert[UInt8, UInt16](bytes[1]) << 8))
    cost time O(1)
  {
    intrinsic::convert[UInt8, UInt16](bytes[0]) | (intrinsic::convert[UInt8, UInt16](bytes[1]) << 8)
  }

  fn reverse_bits(self) -> UInt16
    cost time O(1)
  {
    intrinsic::convert(integers::reverse_uint64_bits(intrinsic::convert(self)) >> 48)
  }
}

impl UnsignedInteger for UInt16 {
  type Signed = Int16

  fn integer_square_root(self) -> UInt16
    ensures result * result <= self
    ensures self < (result + 1) * (result + 1)
    cost time O(16)
  {
    var result: UInt16 = 0
    var width: UInt16 = 256
    while width > 1
      invariant width >= 1
      invariant result + width <= 256
      invariant result * result <= self
      invariant self < (result + width) * (result + width)
      decreases width
      cost time O(log(255) - log(width - 1))
    {
      let half = width / 2
      let candidate = result + half
      if candidate * candidate <= self {
        result = candidate
        width = width - half
      } else {
        width = half
      }
    }
    result
  }
}

