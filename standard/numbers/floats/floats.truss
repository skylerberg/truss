use standard::intrinsic

impl Equal for Float32 {
  fn equal(self, other: Float32) -> Bool
    cost time O(1)
    ensures result == (intrinsic::equal(self, right: other))
    cost allocations == 0
  {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for Float32 {
  fn compare(self, other: Float32) -> Ordering
    cost time O(1)
    ensures (result == Ordering.Less) == intrinsic::less(self, right: other)
    ensures (result == Ordering.Equal) == intrinsic::equal(self, right: other)
    cost allocations == 0
  {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Default for Float32 {
  fn default() -> Float32 {
    0.0
  }
}

impl Display for Float32 {
  fn display(self, output: mut String) {
    mut output.push_float32(self)
  }
}

impl Add[Float32] for Float32 {
  type Output = Float32

  fn add_is_defined(self, right: Float32) -> Bool
    ensures result
    cost time O(1)
  {
    true
  }

  fn add(self, right: Float32) -> Float32
    ensures identical(result, intrinsic::add(self, right))
  {
    intrinsic::add(self, right)
  }
}

