impl Hash for Float32 {
  fn hash(self, hasher: mut Hasher)
    cost time O(1)
    cost allocations == 0
  {
    mut hasher.write(if self == 0.0 { 0 } else { intrinsic::convert(intrinsic::to_bits[Float32, UInt32](self)) })
  }
}

impl Equal for Float64 {
  fn equal(self, other: Float64) -> Bool
    cost time O(1)
    ensures result == (intrinsic::equal(self, right: other))
    cost allocations == 0
  {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for Float64 {
  fn compare(self, other: Float64) -> Ordering
    cost time O(1)
    ensures (result == Ordering.Less) == intrinsic::less(self, right: other)
    ensures (result == Ordering.Equal) == intrinsic::equal(self, right: other)
    cost allocations == 0
  {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

theorem float64_less_then_less(first: Float64, second: Float64, third: Float64)
  requires intrinsic::less(first, right: second)
  requires intrinsic::less(second, right: third)
  ensures first <= third
{
}

theorem float64_less_then_equal(first: Float64, second: Float64, third: Float64)
  requires intrinsic::less(first, right: second)
  requires intrinsic::equal(second, right: third)
  ensures first <= third
{
}

theorem float64_equal_then_less(first: Float64, second: Float64, third: Float64)
  requires intrinsic::equal(first, right: second)
  requires intrinsic::less(second, right: third)
  ensures first <= third
{
}

theorem float64_equal_then_equal(first: Float64, second: Float64, third: Float64)
  requires intrinsic::equal(first, right: second)
  requires intrinsic::equal(second, right: third)
  ensures first <= third
{
}

proof Ordered.transitive for Float64 {
  if intrinsic::less(first, right: second) {
    if intrinsic::less(second, right: third) {
      float64_less_then_less(first, second: second, third: third)
    } else {
      float64_less_then_equal(first, second: second, third: third)
    }
  } else {
    if intrinsic::less(second, right: third) {
      float64_equal_then_less(first, second: second, third: third)
    } else {
      float64_equal_then_equal(first, second: second, third: third)
    }
  }
}

