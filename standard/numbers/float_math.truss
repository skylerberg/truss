public fn Float64.to_float32(self) -> Float32
  cost time O(1)
{
  if intrinsic::is_nan(self) {
    Float32.not_a_number
  } else if self.absolute() >= 3.4028235677973366e38 {
    if self < 0.0 { Float32.negative_infinity } else { Float32.infinity }
  } else {
    intrinsic::convert(self)
  }
}
