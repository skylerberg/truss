impl TryFrom[Float64] for UInt16 {
  type Error = core::ConversionError

  fn try_from(value: own Float64) -> Result[UInt16, core::ConversionError]
  {
    if value == intrinsic::truncate(value) && intrinsic::fits[Float64, UInt16](value) {
      Ok(intrinsic::convert(value))
    } else {
      Err(core::ConversionError())
    }
  }
}

