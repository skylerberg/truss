use standard::core
use standard::growth
use standard::intrinsic
use standard::text

public let Float32.infinity: Float32 = 1.0 / 0.0

public let Float32.negative_infinity: Float32 = 0.0 - (1.0 / 0.0)

public let Float32.not_a_number: Float32 = 0.0 / 0.0

public let Float32.maximum: Float32 = 3.4028235e38

public let Float32.minimum: Float32 = -3.4028235e38

public let Float32.smallest_positive_normal: Float32 = 1.1754944e-38

public let Float32.epsilon: Float32 = 1.1920929e-7

public fn Float32.is_infinite(self) -> Bool
  ensures result == ((self.to_bits() & 0x7fff_ffff) == 0x7f80_0000)
  cost time O(1)
{
  (self.to_bits() & 0x7fff_ffff) == 0x7f80_0000
}

public fn Float32.is_finite(self) -> Bool
  ensures result == ((self.to_bits() & 0x7fff_ffff) < 0x7f80_0000)
  cost time O(1)
{
  (self.to_bits() & 0x7fff_ffff) < 0x7f80_0000
}

public fn Float32.is_negative(self) -> Bool
  ensures result == (self.to_bits() >= 0x8000_0000)
  cost time O(1)
{
  self.to_bits() >= 0x8000_0000
}

public fn Float32.absolute(self) -> Float32
  ensures identical(result, Float32.from_bits(self.to_bits() & 0x7fff_ffff))
  cost time O(1)
{
  Float32.from_bits(self.to_bits() & 0x7fff_ffff)
}

public fn Float32.floor(self) -> Float32
  ensures identical(result, intrinsic::floor(self))
  cost time O(1)
{
  intrinsic::floor(self)
}

public fn Float32.ceiling(self) -> Float32
  ensures identical(result, intrinsic::ceiling(self))
  cost time O(1)
{
  intrinsic::ceiling(self)
}

public fn Float32.round(self) -> Float32
  cost time O(1)
{
  let whole = intrinsic::truncate(self)
  let one: Float32 = 1.0
  if (self - whole).absolute() >= 0.5 { whole + one.copy_sign(self) } else { whole }
}

public fn Float32.round_to_even(self) -> Float32
  ensures identical(result, intrinsic::round_to_even(self))
  cost time O(1)
{
  intrinsic::round_to_even(self)
}

public fn Float32.truncate(self) -> Float32
  ensures identical(result, intrinsic::truncate(self))
  cost time O(1)
{
  intrinsic::truncate(self)
}

public fn Float32.fraction(self) -> Float32
  ensures identical(result, self - intrinsic::truncate(self))
  cost time O(1)
{
  self - intrinsic::truncate(self)
}

public fn Float32.sign(self) -> Float32
  ensures identical(result, if intrinsic::is_nan(self) || self == 0.0 {
      self
    } else if self < 0.0 {
      -1.0
    } else {
      1.0
    })
  cost time O(1)
{
  if intrinsic::is_nan(self) || self == 0.0 {
    self
  } else if self < 0.0 {
    -1.0
  } else {
    1.0
  }
}

