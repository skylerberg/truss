impl TryFrom[Float64] for Int8 {
  type Error = core::ConversionError

  fn try_from(value: own Float64) -> Result[Int8, core::ConversionError]
  {
    if value == intrinsic::truncate(value) && intrinsic::fits[Float64, Int8](value) {
      Ok(intrinsic::convert(value))
    } else {
      Err(core::ConversionError())
    }
  }
}

