public fn Float32.copy_sign(self, sign: Float32) -> Float32
  cost time O(1)
{
  Float32.from_bits((self.to_bits() & 0x7fff_ffff) | (sign.to_bits() & 0x8000_0000))
}

public fn Float32.hypotenuse(self, other: Float32) -> Float32
  cost time O(1)
{
  let first = self.absolute()
  let second = other.absolute()
  if first.is_infinite() || second.is_infinite() {
    return Float32.infinity
  }
  let larger = if first < second { second } else { first }
  let smaller = if first < second { first } else { second }
  if larger == 0.0 || intrinsic::is_nan(larger) {
    return larger
  }
  let ratio = smaller / larger
  larger * intrinsic::square_root(1.0 + ratio * ratio)
}

public fn Float32.ieee_not_equal(self, other: Float32) -> Bool
  cost time O(1)
{
  !intrinsic::ieee_equal(self, right: other)
}

public fn Float32.ieee_less_or_equal(self, other: Float32) -> Bool
  cost time O(1)
{
  intrinsic::ieee_less(self, right: other) || intrinsic::ieee_equal(self, right: other)
}

public fn Float32.ieee_greater(self, other: Float32) -> Bool
  cost time O(1)
{
  intrinsic::ieee_less(other, right: self)
}

public fn Float32.ieee_greater_or_equal(self, other: Float32) -> Bool
  cost time O(1)
{
  intrinsic::ieee_less(other, right: self) || intrinsic::ieee_equal(self, right: other)
}

public fn Float32.power_integer(self, exponent: Int32) -> Float32
  cost time O(1)
{
  let magnitude = exponent.unsigned_absolute()
  var result: Float32 = 1.0
  var square = self
  var bit: USize = 0
  while bit < 32 && (magnitude >> bit) != 0
    invariant bit <= 32
    decreases 32 - bit
  {
    if (magnitude >> bit) % 2 == 1 {
      result = result * square
    }
    square = square * square
    bit += 1
  }
  if exponent < 0 { 1.0 / result } else { result }
}

public fn Float32.fused_multiply_add(self, multiplier: Float32, addend: Float32) -> Float32
  cost time O(1)
{
  intrinsic::fused_multiply_add(self, multiplier: multiplier, addend: addend)
}

public fn Float32.to_bits(self) -> UInt32
  cost time O(1)
{
  intrinsic::to_bits[Float32, UInt32](self)
}

public fn Float32.from_bits(bits: UInt32) -> Float32
  cost time O(1)
{
  intrinsic::from_bits[UInt32, Float32](bits)
}

public fn Float32.sum(items: Slice[Float32]) -> Float32
  cost time O(items.length())
{
  var total: Float32 = 0.0
  var lost: Float32 = 0.0
  for item in items {
    let next = total + item
    if total.absolute() >= item.absolute() {
      lost = lost + ((total - next) + item)
    } else {
      lost = lost + ((item - next) + total)
    }
    total = next
  }
  if lost.is_finite() { total + lost } else { total }
}

