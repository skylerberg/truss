public let Float64.infinity: Float64 = 1.0 / 0.0

public let Float64.negative_infinity: Float64 = 0.0 - (1.0 / 0.0)

public let Float64.not_a_number: Float64 = 0.0 / 0.0

public let Float64.maximum: Float64 = 1.7976931348623157e308

public let Float64.minimum: Float64 = -1.7976931348623157e308

public let Float64.smallest_positive_normal: Float64 = 2.2250738585072014e-308

public let Float64.epsilon: Float64 = 2.220446049250313e-16

public fn Float64.is_infinite(self) -> Bool
  ensures result == ((self.to_bits() & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000)
  cost time O(1)
{
  (self.to_bits() & 0x7fff_ffff_ffff_ffff) == 0x7ff0_0000_0000_0000
}

public fn Float64.is_finite(self) -> Bool
  ensures result == ((self.to_bits() & 0x7fff_ffff_ffff_ffff) < 0x7ff0_0000_0000_0000)
  cost time O(1)
{
  (self.to_bits() & 0x7fff_ffff_ffff_ffff) < 0x7ff0_0000_0000_0000
}

public fn Float64.is_negative(self) -> Bool
  ensures result == (self.to_bits() >= 0x8000_0000_0000_0000)
  cost time O(1)
{
  self.to_bits() >= 0x8000_0000_0000_0000
}

public fn Float64.absolute(self) -> Float64
  ensures identical(result, Float64.from_bits(self.to_bits() & 0x7fff_ffff_ffff_ffff))
  cost time O(1)
{
  Float64.from_bits(self.to_bits() & 0x7fff_ffff_ffff_ffff)
}

