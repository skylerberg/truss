impl TryFrom[Float32] for Int8 {
  type Error = core::ConversionError

  fn try_from(value: own Float32) -> Result[Int8, core::ConversionError]
  {
    if value == intrinsic::truncate(value) && intrinsic::fits[Float32, Int8](value) {
      Ok(intrinsic::convert(value))
    } else {
      Err(core::ConversionError())
    }
  }
}

