public fn Float64.fraction(self) -> Float64
  ensures identical(result, self - intrinsic::truncate(self))
  cost time O(1)
{
  self - intrinsic::truncate(self)
}

public fn Float64.sign(self) -> Float64
  ensures identical(result, if intrinsic::is_nan(self) || self == 0.0 {
      self
    } else if self < 0.0 {
      -1.0
    } else {
      1.0
    })
  cost time O(1)
{
  if intrinsic::is_nan(self) || self == 0.0 {
    self
  } else if self < 0.0 {
    -1.0
  } else {
    1.0
  }
}

internal type Parts(fraction: Float64, exponent: Int64)

internal fn Float64.split_exponent(self) -> Parts
  ensures -1100 <= result.exponent && result.exponent <= 1100
  cost time O(1)
{
  if self == 0.0 || !self.is_finite() {
    return Parts(fraction: self, exponent: 0)
  }
  let small = self.absolute() < 2.2250738585072014e-308
  let value = if small { self * 4503599627370496.0 } else { self }
  let bits = value.to_bits()
  let field: Int64 = intrinsic::convert((bits >> 52) & 2047)
  let fraction = Float64.from_bits((bits & 0x800f_ffff_ffff_ffff) | 0x3fe0_0000_0000_0000)
  Parts(fraction: fraction, exponent: field - 1022 - (if small { 52 } else { 0 }))
}

internal fn Float64.scaled_by_power(self, power: Int64) -> Float64
  cost time O(1)
{
  if self == 0.0 || !self.is_finite() {
    return self
  }
  let parts = self.split_exponent()
  let bounded: Int64 = if power > 4000 { 4000 } else if power < -4000 { -4000 } else { power }
  let total = parts.exponent + bounded
  if total < -1074 {
    let zero: Float64 = 0.0
    return zero.copy_sign(self)
  }
  if total > 1024 {
    return Float64.infinity.copy_sign(self)
  }
  let subnormal = total < -1020
  let field: UInt64 = intrinsic::convert(total + 1022 + (if subnormal { 53 } else { 0 }))
  let scaled = Float64.from_bits((parts.fraction.to_bits() & 0x800f_ffff_ffff_ffff) | (field << 52))
  if subnormal { scaled * 1.1102230246251565e-16 } else { scaled }
}

internal fn Float64.raised_to_whole(self, start: Float64, whole: UInt64) -> Parts
  ensures -540000 <= result.exponent && result.exponent <= 540000
  cost time O(1)
{
  let parts = self.split_exponent()
  var mantissa = start
  var power_of_two: Int64 = 0
  var base = parts.fraction
  var base_power = parts.exponent
  var remaining = whole
  var bit: Int64 = 0
  var stopped = false
  while bit < 64 && remaining != 0 && !stopped
    invariant 0 <= bit && bit <= 64
    invariant -8200 <= base_power && base_power <= 8200
    invariant -8200 * (bit + 1) <= power_of_two && power_of_two <= 8200 * (bit + 1)
    decreases 64 - bit + (if stopped { 0 } else { 1 })
  {
    if base_power < -4096 || base_power > 4096 {
      power_of_two += base_power
      stopped = true
      bit += 1
    } else {
      if remaining % 2 == 1 {
        mantissa = mantissa * base
        power_of_two += base_power
      }
      base = base * base
      base_power = base_power * 2
      if base < 0.5 {
        base = base + base
        base_power -= 1
      }
      remaining = remaining / 2
      bit += 1
    }
  }
  Parts(fraction: mantissa, exponent: power_of_two)
}

internal type Double(high: Float64, low: Float64)

internal fn exact_sum(first: Float64, second: Float64) -> Double
  cost time O(1)
{
  let high = first + second
  let virtual = high - first
  Double(high: high, low: (first - (high - virtual)) + (second - virtual))
}

internal fn Float64.precise_logarithm(self) -> Double
  cost time O(1)
{
  let parts = self.split_exponent()
  let low_half = parts.fraction < 0.7071067811865476
  let fraction = if low_half { parts.fraction * 2.0 } else { parts.fraction }
  let power = (parts.exponent - (if low_half { 1 } else { 0 })).to_float64()
  let above = fraction - 1.0
  let below = fraction + 1.0
  let below_rest = fraction - (below - 1.0)
  let ratio = above / below
  let ratio_rest = (intrinsic::fused_multiply_add(-ratio, multiplier: below, addend: above) - ratio * below_rest) / below
  let square = ratio * ratio
  let fourth = square * square
  let odd = square * (0.6666666666666735 + fourth * (0.2857142874366239 + fourth * (0.1818357216161805 + fourth * 0.14798198605116586)))
  let even = fourth * (0.3999999999940942 + fourth * (0.22222198432149784 + fourth * 0.15313837699209373))
  let leading = exact_sum(power * 0.6931471803691238, second: ratio + ratio)
  let with_series = exact_sum(leading.high, second: ratio * (odd + even))
  let whole = exact_sum(with_series.high, second: power * 1.9082149292705877e-10)
  Double(high: whole.high, low: leading.low + with_series.low + whole.low + 2.0 * ratio_rest)
}

internal fn Float32.widened(self) -> Float64
  cost time O(1)
{
  intrinsic::convert(self)
}

internal fn Float64.is_odd_integer(self) -> Bool
  cost time O(1)
{
  if self.absolute() >= 9007199254740992.0 {
    return false
  }
  let whole = intrinsic::truncate(self)
  if whole != self || !intrinsic::fits[Float64, Int64](whole) {
    return false
  }
  intrinsic::convert[Float64, Int64](whole) % 2 != 0
}

public fn Float64.cube_root(self) -> Float64
  cost time O(1)
{
  if self == 0.0 || !self.is_finite() {
    return self
  }
  let magnitude = self.absolute()
  let first = (magnitude.logarithm() / 3.0).exponential()
  let ratio = first * first / magnitude * first
  let second = first * ((ratio + 2.0) / (2.0 * ratio + 1.0))
  let again = second * second / magnitude * second
  let third = second * ((again + 2.0) / (2.0 * again + 1.0))
  third.copy_sign(self)
}

public fn Float64.exponential(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) || self == Float64.infinity {
    return self
  }
  if self < -745.1332191019411 {
    return 0.0
  }
  if self > 709.782712893384 {
    return Float64.infinity
  }
  if self > -3.725290298461914e-09 && self < 3.725290298461914e-09 {
    return 1.0 + self
  }
  let scaled = if self < 0.0 { 1.4426950408889634 * self - 0.5 } else { 1.4426950408889634 * self + 0.5 }
  let count: Int64 = if intrinsic::fits[Float64, Int64](scaled) { intrinsic::convert(scaled) } else { 0 }
  let steps = count.to_float64()
  let high = self - steps * 0.6931471803691238
  let low = steps * 1.9082149292705877e-10
  let rest = high - low
  let square = rest * rest
  let correction = rest - square * (0.16666666666666666 + square * (-0.0027777777777015593 + square * (6.613756321437934e-05 + square * (-1.6533902205465252e-06 + square * 4.1381367970572385e-08))))
  let value = 1.0 - ((low - (rest * correction) / (2.0 - correction)) - high)
  value.scaled_by_power(count)
}

public fn Float64.exponential_minus_one(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) || self == Float64.infinity {
    return self
  }
  let power = self.exponential()
  if power == 1.0 {
    return self
  }
  if power == Float64.infinity {
    return power
  }
  let below = power - 1.0
  if below == -1.0 {
    return -1.0
  }
  below * self / power.logarithm()
}

public fn Float64.logarithm(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) || self == Float64.infinity {
    return self
  }
  if self < 0.0 {
    return Float64.not_a_number
  }
  if self == 0.0 {
    return Float64.negative_infinity
  }
  let parts = self.split_exponent()
  let low_half = parts.fraction < 0.7071067811865476
  let fraction = if low_half { parts.fraction * 2.0 } else { parts.fraction }
  let power = (parts.exponent - (if low_half { 1 } else { 0 })).to_float64()
  let above = fraction - 1.0
  let ratio = above / (2.0 + above)
  let square = ratio * ratio
  let fourth = square * square
  let odd = square * (0.6666666666666735 + fourth * (0.2857142874366239 + fourth * (0.1818357216161805 + fourth * 0.14798198605116586)))
  let even = fourth * (0.3999999999940942 + fourth * (0.22222198432149784 + fourth * 0.15313837699209373))
  let series = odd + even
  let half_square = 0.5 * above * above
  power * 0.6931471803691238 - ((half_square - (ratio * (half_square + series) + power * 1.9082149292705877e-10)) - above)
}

public fn Float64.logarithm_2(self) -> Float64
  cost time O(1)
{
  let parts = self.split_exponent()
  if parts.fraction == 0.5 {
    return (parts.exponent - 1).to_float64()
  }
  parts.fraction.logarithm() * 1.4426950408889634 + parts.exponent.to_float64()
}

public fn Float64.logarithm_10(self) -> Float64
  cost time O(1)
{
  self.logarithm_2() * 0.3010299956639812
}

public fn Float64.logarithm_one_plus(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) || self == Float64.infinity {
    return self
  }
  let sum = 1.0 + self
  if sum == 1.0 {
    return self
  }
  sum.logarithm() * (self / (sum - 1.0))
}

let four_over_pi: Array[UInt64, 20] = [
  0x1, 0x45f306dc9c882a53, 0xf84eafa3ea69bb81, 0xb6c52b3278872083,
  0xfca2c757bd778ac3, 0x6e48dc74849ba5c0, 0xc925dd413a32439, 0xfc3bd63962534e7d,
  0xd1046bea5d768909, 0xd338e04d68befc82, 0x7323ac7306a673e9, 0x3908bf177bf25076,
  0x3ff12fffbc0b301f, 0xde5e2316b414da3e, 0xda6cfd9e4f96136e, 0x9e8c7ecd3cbfd45a,
  0xea4f758fd7cbe2f6, 0x7a0e73ef14a525d4, 0xd7f6bf623f1aba10, 0xac06608df8f6d757,
]

internal type Reduced(octant: UInt64, angle: Float64)

internal fn pi_bits(digit: USize, shift: USize) -> UInt64
  requires digit + 1 < 20
  requires shift < 64
  cost time O(1)
{
  if shift == 0 {
    four_over_pi[digit]
  } else {
    (four_over_pi[digit] << shift) | (four_over_pi[digit + 1] >> (64 - shift))
  }
}

internal fn Float64.reduced_exactly(self) -> Reduced
  ensures result.octant < 8
  cost time O(1)
{
  let bits = self.to_bits()
  let field: Int64 = intrinsic::convert((bits >> 52) & 2047)
  let place = field - 1014
  if place < 0 || place >= 1088 {
    return Reduced(octant: 0, angle: self)
  }
  let mantissa = (bits & 0x000f_ffff_ffff_ffff) | 0x0010_0000_0000_0000
  let digit: USize = intrinsic::convert(place / 64)
  let shift: USize = intrinsic::convert(place % 64)
  let first = pi_bits(digit, shift: shift)
  let second = pi_bits(digit + 1, shift: shift)
  let third = pi_bits(digit + 2, shift: shift)
  let second_low = second.wrapping_multiply(mantissa)
  let low = second_low.wrapping_add(intrinsic::multiply_high(third, right: mantissa))
  let carry: UInt64 = if low < second_low { 1 } else { 0 }
  let high = first.wrapping_multiply(mantissa).wrapping_add(intrinsic::multiply_high(second, right: mantissa)).wrapping_add(carry)
  let octant = high >> 61
  let fraction = (high << 3) | (low >> 61)
  let zeros = fraction.leading_zeros()
  let part: Float64 = if zeros >= 64 {
    0.0
  } else {
    let lift = zeros + 1
    let shifted: UInt64 = match fraction.checked_shift_left(lift) {
      Some(moved) => moved
      None => 0
    }
    let top = shifted | (low >> (64 - lift))
    let exponent: UInt64 = intrinsic::convert(1023 - lift)
    Float64.from_bits((top >> 12) | (exponent << 52))
  }
  if octant % 2 == 1 {
    Reduced(octant: (octant + 1) % 8, angle: (part - 1.0) * 0.7853981633974483)
  } else {
    Reduced(octant: octant, angle: part * 0.7853981633974483)
  }
}

internal fn Float64.reduced(self) -> Reduced
  ensures result.octant < 8
  cost time O(1)
{
  if self >= 536870912.0 {
    return self.reduced_exactly()
  }
  let count = self * 1.2732395447351628
  let whole: UInt64 = if intrinsic::fits[Float64, UInt64](count) { intrinsic::convert(count) } else { 0 }
  let even: UInt64 = if whole % 2 == 1 && whole < UInt64.maximum { whole + 1 } else { whole }
  let steps = even.to_float64()
  Reduced(octant: even % 8, angle: ((self - steps * 0.7853981256484985) - steps * 3.774894707930798e-08) - steps * 2.6951514290790595e-15)
}

internal fn sine_near_zero(rest: Float64) -> Float64
  cost time O(1)
{
  let square = rest * rest
  rest + rest * square * (((((1.5896230157654656e-10 * square + -2.5050747762857807e-08) * square + 2.7557313621385722e-06) * square + -0.0001984126982958954) * square + 0.008333333333322118) * square + -0.1666666666666663)
}

internal fn cosine_near_zero(rest: Float64) -> Float64
  cost time O(1)
{
  let square = rest * rest
  1.0 - 0.5 * square + square * square * (((((-1.1358536521387682e-11 * square + 2.087570084197473e-09) * square + -2.755731417929674e-07) * square + 2.4801587288851704e-05) * square + -0.0013888888888873056) * square + 0.041666666666666595)
}

internal fn arctangent_near_zero(value: Float64) -> Float64
  cost time O(1)
{
  let square = value * value
  let series = square * ((((-0.8750608600031904 * square + -16.157537187333652) * square + -75.00855792314705) * square + -122.88666844901361) * square + -64.85021904942025) / (((((square + 24.858464901423062) * square + 165.02700983169885) * square + 432.88106049129027) * square + 485.3903996359137) * square + 194.5506571482614)
  value * series + value
}

internal fn arctangent_of_positive(value: Float64) -> Float64
  cost time O(1)
{
  if value <= 0.66 {
    arctangent_near_zero(value)
  } else if value > 2.414213562373095 {
    1.5707963267948966 - arctangent_near_zero(1.0 / value) + 6.123233995736766e-17
  } else {
    0.7853981633974483 + arctangent_near_zero((value - 1.0) / (value + 1.0)) + 3.061616997868383e-17
  }
}

public fn Float64.sine(self) -> Float64
  cost time O(1)
{
  if self == 0.0 || intrinsic::is_nan(self) {
    return self
  }
  if self.is_infinite() {
    return Float64.not_a_number
  }
  let reduced = self.absolute().reduced()
  let flipped = reduced.octant > 3
  let octant = if flipped { reduced.octant - 4 } else { reduced.octant }
  let result_before_sign = if octant == 1 || octant == 2 { cosine_near_zero(reduced.angle) } else { sine_near_zero(reduced.angle) }
  if (self < 0.0) != flipped { -result_before_sign } else { result_before_sign }
}

public fn Float64.cosine(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) {
    return self
  }
  if self.is_infinite() {
    return Float64.not_a_number
  }
  let reduced = self.absolute().reduced()
  let flipped = reduced.octant > 3
  let octant = if flipped { reduced.octant - 4 } else { reduced.octant }
  let result_before_sign = if octant == 1 || octant == 2 { sine_near_zero(reduced.angle) } else { cosine_near_zero(reduced.angle) }
  if flipped != (octant > 1) { -result_before_sign } else { result_before_sign }
}

public fn Float64.tangent(self) -> Float64
  cost time O(1)
{
  if self == 0.0 || intrinsic::is_nan(self) {
    return self
  }
  if self.is_infinite() {
    return Float64.not_a_number
  }
  let reduced = self.absolute().reduced()
  let angle = reduced.angle
  let square = angle * angle
  let near = if square > 1.0e-14 {
    angle + angle * (square * ((-13093.693918138379 * square + 1153516.6483858742) * square + -17956525.197648488) / ((((square + 13681.296347069296) * square + -1320892.3444021097) * square + 25008380.18233579) * square + -53869575.592945464))
  } else {
    angle
  }
  let result_before_sign = if reduced.octant % 4 >= 2 { -1.0 / near } else { near }
  if self < 0.0 { -result_before_sign } else { result_before_sign }
}

public fn Float64.arcsine(self) -> Float64
  cost time O(1)
{
  if self == 0.0 || intrinsic::is_nan(self) {
    return self
  }
  let magnitude = self.absolute()
  if magnitude > 1.0 {
    return Float64.not_a_number
  }
  let other = intrinsic::square_root(1.0 - magnitude * magnitude)
  let result_before_sign = if magnitude > 0.7 {
    1.5707963267948966 - arctangent_of_positive(other / magnitude)
  } else {
    arctangent_of_positive(magnitude / other)
  }
  result_before_sign.copy_sign(self)
}

public fn Float64.arccosine(self) -> Float64
  cost time O(1)
{
  1.5707963267948966 - self.arcsine()
}

public fn Float64.arctangent(self) -> Float64
  cost time O(1)
{
  if self == 0.0 || intrinsic::is_nan(self) {
    return self
  }
  arctangent_of_positive(self.absolute()).copy_sign(self)
}

public fn Float64.hyperbolic_sine(self) -> Float64
  cost time O(1)
{
  if !self.is_finite() {
    return self
  }
  let magnitude = self.absolute()
  if magnitude < 3.725290298461914e-09 {
    return self
  }
  if magnitude > 709.0 {
    let half = (magnitude * 0.5).exponential()
    return (half * 0.5 * half).copy_sign(self)
  }
  let grown = magnitude.exponential_minus_one()
  ((grown + grown / (grown + 1.0)) * 0.5).copy_sign(self)
}

public fn Float64.hyperbolic_cosine(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) {
    return self
  }
  let magnitude = self.absolute()
  if magnitude > 709.0 {
    let half = (magnitude * 0.5).exponential()
    return half * 0.5 * half
  }
  let power = magnitude.exponential()
  (power + 1.0 / power) * 0.5
}

public fn Float64.hyperbolic_tangent(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) {
    return self
  }
  let magnitude = self.absolute()
  let one: Float64 = 1.0
  if magnitude > 22.0 {
    return one.copy_sign(self)
  }
  let grown = (2.0 * magnitude).exponential_minus_one()
  (grown / (grown + 2.0)).copy_sign(self)
}

public fn Float64.inverse_hyperbolic_sine(self) -> Float64
  cost time O(1)
{
  if !self.is_finite() {
    return self
  }
  let magnitude = self.absolute()
  if magnitude < 3.725290298461914e-09 {
    return self
  }
  let result_before_sign = if magnitude > 268435456.0 {
    magnitude.logarithm() + 0.6931471805599453
  } else if magnitude > 2.0 {
    (2.0 * magnitude + 1.0 / (intrinsic::square_root(magnitude * magnitude + 1.0) + magnitude)).logarithm()
  } else {
    let square = magnitude * magnitude
    (magnitude + square / (1.0 + intrinsic::square_root(1.0 + square))).logarithm_one_plus()
  }
  result_before_sign.copy_sign(self)
}

public fn Float64.inverse_hyperbolic_cosine(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) {
    return self
  }
  if self < 1.0 {
    return Float64.not_a_number
  }
  if self >= 268435456.0 {
    self.logarithm() + 0.6931471805599453
  } else if self > 2.0 {
    (2.0 * self - 1.0 / (self + intrinsic::square_root(self * self - 1.0))).logarithm()
  } else {
    let above = self - 1.0
    (above + intrinsic::square_root(2.0 * above + above * above)).logarithm_one_plus()
  }
}

public fn Float64.inverse_hyperbolic_tangent(self) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) {
    return self
  }
  let magnitude = self.absolute()
  if magnitude > 1.0 {
    return Float64.not_a_number
  }
  if magnitude == 1.0 {
    return Float64.infinity.copy_sign(self)
  }
  if magnitude < 3.725290298461914e-09 {
    return self
  }
  let double = magnitude + magnitude
  let result_before_sign = if magnitude < 0.5 {
    0.5 * (double + double * magnitude / (1.0 - magnitude)).logarithm_one_plus()
  } else {
    0.5 * (double / (1.0 - magnitude)).logarithm_one_plus()
  }
  result_before_sign.copy_sign(self)
}

public fn Float64.to_degrees(self) -> Float64
  ensures identical(result, self * 57.29577951308232)
  cost time O(1)
{
  self * 57.29577951308232
}

public fn Float64.to_radians(self) -> Float64
  ensures identical(result, self * 0.017453292519943295)
  cost time O(1)
{
  self * 0.017453292519943295
}

public fn Float64.power(self, exponent: Float64) -> Float64
  cost time O(1)
{
  if exponent == 0.0 || self == 1.0 {
    return 1.0
  }
  if exponent == 1.0 {
    return self
  }
  if intrinsic::is_nan(self) || intrinsic::is_nan(exponent) {
    return Float64.not_a_number
  }
  let odd = exponent.is_odd_integer()
  if self == 0.0 {
    if exponent < 0.0 {
      return if odd { Float64.infinity.copy_sign(self) } else { Float64.infinity }
    }
    return if odd { self } else { 0.0 }
  }
  if exponent.is_infinite() {
    if self == -1.0 {
      return 1.0
    }
    return if (self.absolute() < 1.0) == (exponent > 0.0) { 0.0 } else { Float64.infinity }
  }
  if self.is_infinite() {
    if exponent < 0.0 {
      return if odd && self < 0.0 { -0.0 } else { 0.0 }
    }
    return if odd && self < 0.0 { Float64.negative_infinity } else { Float64.infinity }
  }
  if exponent == 0.5 {
    return intrinsic::square_root(self)
  }
  if exponent == -0.5 {
    return 1.0 / intrinsic::square_root(self)
  }
  let whole = intrinsic::truncate(exponent) == exponent
  if !whole && self < 0.0 {
    return Float64.not_a_number
  }
  let base = self.absolute()
  let steps = exponent.absolute()
  let result_before_sign = if whole && steps <= 64.0 && intrinsic::fits[Float64, UInt64](steps) {
    let raised = base.raised_to_whole(1.0, whole: intrinsic::convert(steps))
    if exponent < 0.0 {
      (1.0 / raised.fraction).scaled_by_power(-raised.exponent)
    } else {
      raised.fraction.scaled_by_power(raised.exponent)
    }
  } else {
    let logarithm = base.precise_logarithm()
    let high = exponent * logarithm.high
    let low = intrinsic::fused_multiply_add(exponent, multiplier: logarithm.high, addend: -high) + exponent * logarithm.low
    let grown = high.exponential()
    if grown.is_finite() && grown != 0.0 {
      intrinsic::fused_multiply_add(grown, multiplier: low, addend: grown)
    } else {
      grown
    }
  }
  if odd && self < 0.0 { -result_before_sign } else { result_before_sign }
}

public fn Float64.logarithm_base(self, base: Float64) -> Float64
  cost time O(1)
{
  self.logarithm() / base.logarithm()
}

public fn Float64.arctangent_2(self, x: Float64) -> Float64
  cost time O(1)
{
  if intrinsic::is_nan(self) || intrinsic::is_nan(x) {
    return Float64.not_a_number
  }
  let zero: Float64 = 0.0
  let straight: Float64 = 3.141592653589793
  let right: Float64 = 1.5707963267948966
  if self == 0.0 {
    return if x.is_negative() { straight.copy_sign(self) } else { zero.copy_sign(self) }
  }
  if x == 0.0 {
    return right.copy_sign(self)
  }
  if x.is_infinite() {
    let diagonal: Float64 = if x > 0.0 { 0.7853981633974483 } else { 2.356194490192345 }
    let level: Float64 = if x > 0.0 { 0.0 } else { 3.141592653589793 }
    return if self.is_infinite() { diagonal.copy_sign(self) } else { level.copy_sign(self) }
  }
  if self.is_infinite() {
    return right.copy_sign(self)
  }
  let angle = (self / x).arctangent()
  if x < 0.0 {
    if angle <= 0.0 { angle + 3.141592653589793 } else { angle - 3.141592653589793 }
  } else {
    angle
  }
}

public fn Float64.copy_sign(self, sign: Float64) -> Float64
  ensures identical(result, Float64.from_bits((self.to_bits() & 0x7fff_ffff_ffff_ffff) | (sign.to_bits() & 0x8000_0000_0000_0000)))
  cost time O(1)
{
  Float64.from_bits((self.to_bits() & 0x7fff_ffff_ffff_ffff) | (sign.to_bits() & 0x8000_0000_0000_0000))
}

public fn Float64.hypotenuse(self, other: Float64) -> Float64
  cost time O(1)
{
  let first = self.absolute()
  let second = other.absolute()
  if first.is_infinite() || second.is_infinite() {
    return Float64.infinity
  }
  let larger = if first < second { second } else { first }
  let smaller = if first < second { first } else { second }
  if larger == 0.0 || intrinsic::is_nan(larger) {
    return larger
  }
  let ratio = smaller / larger
  larger * intrinsic::square_root(1.0 + ratio * ratio)
}

public fn Float64.ieee_not_equal(self, other: Float64) -> Bool
  ensures result == (!intrinsic::ieee_equal(self, right: other))
  cost time O(1)
{
  !intrinsic::ieee_equal(self, right: other)
}

public fn Float64.ieee_less_or_equal(self, other: Float64) -> Bool
  ensures result == (intrinsic::ieee_less(self, right: other) || intrinsic::ieee_equal(self, right: other))
  cost time O(1)
{
  intrinsic::ieee_less(self, right: other) || intrinsic::ieee_equal(self, right: other)
}

public fn Float64.ieee_greater(self, other: Float64) -> Bool
  ensures result == (intrinsic::ieee_less(other, right: self))
  cost time O(1)
{
  intrinsic::ieee_less(other, right: self)
}

public fn Float64.ieee_greater_or_equal(self, other: Float64) -> Bool
  ensures result == (intrinsic::ieee_less(other, right: self) || intrinsic::ieee_equal(self, right: other))
  cost time O(1)
{
  intrinsic::ieee_less(other, right: self) || intrinsic::ieee_equal(self, right: other)
}

public fn Float64.power_integer(self, exponent: Int32) -> Float64
  cost time O(1)
{
  let magnitude = exponent.unsigned_absolute()
  var result: Float64 = 1.0
  var square = self
  var bit: USize = 0
  while bit < 32 && (magnitude >> bit) != 0
    invariant bit <= 32
    decreases 32 - bit
  {
    if (magnitude >> bit) % 2 == 1 {
      result = result * square
    }
    square = square * square
    bit += 1
  }
  if exponent < 0 { 1.0 / result } else { result }
}

public fn Float64.fused_multiply_add(self, multiplier: Float64, addend: Float64) -> Float64
  ensures identical(result, intrinsic::fused_multiply_add(self, multiplier: multiplier, addend: addend))
  cost time O(1)
{
  intrinsic::fused_multiply_add(self, multiplier: multiplier, addend: addend)
}

public fn Float64.to_bits(self) -> UInt64
  cost time O(1)
{
  intrinsic::to_bits[Float64, UInt64](self)
}

public fn Float64.from_bits(bits: UInt64) -> Float64
  ensures identical(result, intrinsic::from_bits[UInt64, Float64](bits))
  cost time O(1)
{
  intrinsic::from_bits[UInt64, Float64](bits)
}

public fn Float64.sum(items: Slice[Float64]) -> Float64
  cost time O(items.length())
{
  var total: Float64 = 0.0
  var lost: Float64 = 0.0
  for item in items {
    let next = total + item
    if total.absolute() >= item.absolute() {
      lost = lost + ((total - next) + item)
    } else {
      lost = lost + ((item - next) + total)
    }
    total = next
  }
  if lost.is_finite() { total + lost } else { total }
}

public fn Float64.to_fixed(self, decimals: USize) -> String
  cost time finite
{
  format_fixed(self, decimals: decimals)
}

public fn Float64.to_scientific(self, decimals: USize) -> String
  cost time finite
{
  format_scientific(self, decimals: decimals)
}

impl text::Parse for Float64 {
  type Error = core::ParseFloatError

  fn parse(text: StringSlice) -> Result[Float64, core::ParseFloatError] {
    parse_float64(text)
  }
}

