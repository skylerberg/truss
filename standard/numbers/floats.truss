use standard::intrinsic

impl Equal for Float32 {
  fn equal(self, other: Float32) -> Bool {
    intrinsic::equal(self, right: other)
  }
}

impl Ordered for Float32 {
  fn compare(self, other: Float32) -> Ordering {
    if intrinsic::less(self, right: other) {
      Ordering.Less
    } else if intrinsic::equal(self, right: other) {
      Ordering.Equal
    } else {
      Ordering.Greater
    }
  }
}

impl Default for Float32 {
  fn default() -> Float32 {
    0.0
  }
}

impl Display for Float32 {
  fn display(self, output: mut TextBuilder) {
    mut output.write_float32(self)
  }
}

impl Add[Float32] for Float32 {
  type Output = Float32

  fn add_is_defined(self, right: Float32) -> Bool
    cost time O(1)
  {
    true
  }

  fn add(self, right: Float32) -> Float32 {
    intrinsic::add(self, right)
  }
}

impl Subtract[Float32] for Float32 {
  type Output = Float32

  fn subtract_is_defined(self, right: Float32) -> Bool
    cost time O(1)
  {
    true
  }

  fn subtract(self, right: Float32) -> Float32 {
    intrinsic::subtract(self, right)
  }
}

impl Multiply[Float32] for Float32 {
  type Output = Float32

  fn multiply_is_defined(self, right: Float32) -> Bool
    cost time O(1)
  {
    true
  }

  fn multiply(self, right: Float32) -> Float32 {
    intrinsic::multiply(self, right)
  }
}

impl Divide[Float32] for Float32 {
  type Output = Float32

  fn divide_is_defined(self, right: Float32) -> Bool
    cost time O(1)
  {
    true
  }

  fn divide(self, right: Float32) -> Float32 {
    intrinsic::divide(self, right)
  }
}

impl Remainder[Float32] for Float32 {
  type Output = Float32

  fn remainder_is_defined(self, right: Float32) -> Bool
    cost time O(1)
  {
    true
  }

  fn remainder(self, right: Float32) -> Float32 {
    intrinsic::remainder(self, right)
  }
}

impl Negate for Float32 {
  type Output = Float32

  fn negate_is_defined(self) -> Bool
    cost time O(1)
  {
    true
  }

  fn negate(self) -> Float32 {
    intrinsic::negate(self)
  }
}

impl Hash for Float32 {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write(intrinsic::convert(intrinsic::to_bits[Float32, UInt32](self)))
  }
}

public transparent fn Float32.ieee_equal(self, other: Float32) -> Bool
  cost time O(1)
  cost allocations == 0
{
  intrinsic::ieee_equal(self, right: other)
}

public transparent fn Float32.ieee_less(self, other: Float32) -> Bool
  cost time O(1)
  cost allocations == 0
{
  intrinsic::ieee_less(self, right: other)
}

public transparent fn Float32.is_nan(self) -> Bool
  cost time O(1)
  cost allocations == 0
{
  intrinsic::is_nan(self)
}

public transparent fn Float32.square_root(self) -> Float32
  cost time O(1)
  cost allocations == 0
{
  intrinsic::square_root(self)
}

