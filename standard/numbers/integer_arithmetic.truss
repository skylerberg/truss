test "floor division rounds down for each combination of signs" {
  let seven: Int64 = 7
  let minus_seven: Int64 = -7
  assert seven.floor_divide(2) == 3
  assert minus_seven.floor_divide(2) == -4
  assert seven.floor_divide(-2) == -4
  assert minus_seven.floor_divide(-2) == 3
  let six: Int64 = 6
  assert six.floor_divide(-3) == -2
}

test "floor modulo has the sign of the divisor" {
  let seven: Int64 = 7
  let minus_seven: Int64 = -7
  assert seven.floor_modulo(3) == 1
  assert minus_seven.floor_modulo(3) == 2
  assert seven.floor_modulo(-3) == -2
  assert minus_seven.floor_modulo(-3) == -1
  let six: Int64 = 6
  assert six.floor_modulo(-3) == 0
}

test "floor division works at the lowest value of a type and on unsigned types" {
  let lowest: Int8 = -128
  assert lowest.floor_divide(127) == -2
  assert lowest.floor_modulo(127) == 126
  let byte: UInt8 = 200
  assert byte.floor_divide(7) == 28
  assert byte.floor_modulo(7) == 4
}

test "checked division refuses a zero divisor and the one quotient that does not fit" {
  let ten: Int32 = 10
  assert ten.checked_divide(3) == Some(3)
  assert ten.checked_divide(0) is None
  assert Int32.minimum.checked_divide(-1) is None
  assert Int32.minimum.checked_divide(1) == Some(Int32.minimum)
  assert ten.checked_remainder(3) == Some(1)
  assert ten.checked_remainder(0) is None
  assert Int32.minimum.checked_remainder(-1) is None
  let unsigned: UInt8 = 200
  assert unsigned.checked_divide(7) == Some(28)
  assert unsigned.checked_divide(0) is None
  assert unsigned.checked_remainder(7) == Some(4)
  assert unsigned.checked_remainder(0) is None
}

test "saturating subtraction and multiplication stop at the ends of the type" {
  let low: Int8 = -100
  let high: Int8 = 100
  assert low.saturating_subtract(100) == -128
  assert high.saturating_subtract(-100) == 127
  assert high.saturating_subtract(30) == 70
  assert high.saturating_multiply(2) == 127
  assert high.saturating_multiply(-2) == -128
  assert low.saturating_multiply(-2) == 127
  assert low.saturating_multiply(1) == -100
  let small: UInt8 = 3
  assert small.saturating_subtract(5) == 0
  assert small.saturating_subtract(1) == 2
  assert small.saturating_multiply(100) == 255
  assert small.saturating_multiply(4) == 12
}

test "absolute values, negation, and sign handle the lowest value" {
  let minus_five: Int16 = -5
  assert minus_five.absolute() == 5
  assert minus_five.checked_absolute() == Some(5)
  assert Int16.minimum.checked_absolute() is None
  assert minus_five.unsigned_absolute() == 5
  assert Int16.minimum.unsigned_absolute() == 32768
  assert Int16.maximum.unsigned_absolute() == 32767
  assert minus_five.checked_negate() == Some(5)
  assert Int16.minimum.checked_negate() is None
  assert minus_five.wrapping_negate() == 5
  assert Int16.minimum.wrapping_negate() == Int16.minimum
  assert minus_five.sign() == -1
  let zero: Int16 = 0
  assert zero.sign() == 0
  assert Int16.maximum.sign() == 1
}

test "the difference of two integers fits the unsigned type" {
  assert Int8.minimum.absolute_difference(Int8.maximum) == 255
  assert Int8.maximum.absolute_difference(Int8.minimum) == 255
  let minus_three: Int8 = -3
  assert minus_three.absolute_difference(-10) == 7
  assert minus_three.absolute_difference(4) == 7
  let seven: Int8 = 7
  assert seven.absolute_difference(7) == 0
  let nine: UInt64 = 9
  assert nine.absolute_difference(20) == 11
  assert nine.absolute_difference(2) == 7
}

test "powers are checked, wrap, or saturate" {
  let three: Int32 = 3
  assert three.checked_power(0) == Some(1)
  assert three.checked_power(1) == Some(3)
  assert three.checked_power(5) == Some(243)
  assert three.checked_power(19) == Some(1162261467)
  assert three.checked_power(20) is None
  let minus_two: Int8 = -2
  assert minus_two.checked_power(7) == Some(-128)
  assert minus_two.checked_power(8) is None
  assert minus_two.saturating_power(8) == 127
  assert minus_two.saturating_power(9) == -128
  assert minus_two.saturating_power(3) == -8
  assert minus_two.wrapping_power(8) == 0
  assert minus_two.wrapping_power(7) == -128
  let two: UInt8 = 2
  assert two.checked_power(7) == Some(128)
  assert two.checked_power(8) is None
  assert two.saturating_power(8) == 255
  assert two.wrapping_power(9) == 0
  let zero: UInt8 = 0
  assert zero.checked_power(0) == Some(1)
}

test "sums are exact, checked, wrapping, or saturating" {
  let mixed: List[Int8] = [100, 100, -100, -90]
  assert Int8.sum(mixed) == 10
  assert Int8.wrapping_sum(mixed) == 10
  assert Int8.checked_sum(mixed) is None
  assert Int8.saturating_sum(mixed) == -63
  let small: List[Int8] = [1, 2, 3]
  assert Int8.sum(small) == 6
  assert Int8.checked_sum(small) == Some(6)
  let none: List[UInt32] = []
  assert UInt32.sum(none) == 0
  assert UInt32.checked_sum(none) == Some(0)
  let large: List[UInt8] = [200, 100]
  assert UInt8.wrapping_sum(large) == 44
  assert UInt8.saturating_sum(large) == 255
  assert UInt8.checked_sum(large) is None
}

test "powers of two, divisors, multiples, and square roots of unsigned integers" {
  let zero: UInt8 = 0
  let one: UInt8 = 1
  let five: UInt8 = 5
  let eight: UInt8 = 8
  assert !zero.is_power_of_two()
  assert one.is_power_of_two()
  assert eight.is_power_of_two()
  assert !five.is_power_of_two()
  assert zero.next_power_of_two() == Some(1)
  assert one.next_power_of_two() == Some(1)
  assert five.next_power_of_two() == Some(8)
  assert eight.next_power_of_two() == Some(8)
  let big: UInt8 = 129
  assert big.next_power_of_two() is None
  let top: UInt8 = 128
  assert top.next_power_of_two() == Some(128)
  let first: UInt32 = 84
  assert first.greatest_common_divisor(36) == 12
  assert first.greatest_common_divisor(0) == 84
  let nothing: UInt32 = 0
  assert nothing.greatest_common_divisor(0) == 0
  assert nothing.greatest_common_divisor(9) == 9
  assert first.least_common_multiple(36) == Some(252)
  assert first.least_common_multiple(0) == Some(0)
  let huge: UInt32 = 4294967295
  assert huge.least_common_multiple(4294967294) is None
  assert nothing.integer_square_root() == 0
  assert first.integer_square_root() == 9
  assert huge.integer_square_root() == 65535
  let square: UInt16 = 625
  assert square.integer_square_root() == 25
  let below: UInt16 = 624
  assert below.integer_square_root() == 24
}

test "an integer is parsed from decimal digits with an optional sign" {
  assert Int32.parse("0") == Ok(0)
  assert Int32.parse("42") == Ok(42)
  assert Int32.parse("+42") == Ok(42)
  assert Int32.parse("-42") == Ok(-42)
  assert Int32.parse("-0") == Ok(0)
  assert Int32.parse("007") == Ok(7)
  assert UInt8.parse("255") == Ok(255)
  assert UInt8.parse("+255") == Ok(255)
  assert UInt64.parse("18446744073709551615") == Ok(18446744073709551615)
}

test "parsing reaches both ends of a type and refuses the next value" {
  assert Int8.parse("127") == Ok(127)
  assert Int8.parse("128") == Err(core::ParseIntegerError.OutOfRange)
  assert Int8.parse("-128") == Ok(-128)
  assert Int8.parse("-129") == Err(core::ParseIntegerError.OutOfRange)
  assert Int64.parse("9223372036854775807") == Ok(9223372036854775807)
  assert Int64.parse("9223372036854775808") == Err(core::ParseIntegerError.OutOfRange)
  assert Int64.parse("-9223372036854775808") == Ok(Int64.minimum)
  assert Int64.parse("-9223372036854775809") == Err(core::ParseIntegerError.OutOfRange)
  assert UInt8.parse("256") == Err(core::ParseIntegerError.OutOfRange)
  assert UInt64.parse("18446744073709551616") == Err(core::ParseIntegerError.OutOfRange)
  assert UInt64.parse("99999999999999999999999999") == Err(core::ParseIntegerError.OutOfRange)
}

test "parsing says what is wrong with text that is not an integer" {
  assert Int32.parse("") == Err(core::ParseIntegerError.Empty)
  assert Int32.parse("-") == Err(core::ParseIntegerError.Empty)
  assert Int32.parse("+") == Err(core::ParseIntegerError.Empty)
  assert Int32.parse("12a") == Err(core::ParseIntegerError.InvalidDigit(offset: 2))
  assert Int32.parse(" 12") == Err(core::ParseIntegerError.InvalidDigit(offset: 0))
  assert Int32.parse("1 2") == Err(core::ParseIntegerError.InvalidDigit(offset: 1))
  assert Int32.parse("--1") == Err(core::ParseIntegerError.InvalidDigit(offset: 1))
  assert UInt32.parse("-1") == Err(core::ParseIntegerError.InvalidDigit(offset: 0))
  assert Int32.parse("1_000") == Err(core::ParseIntegerError.InvalidDigit(offset: 1))
}

test "an integer is parsed in any radix from 2 to 36, in either case" {
  assert Int32.parse_radix("ff", radix: 16) == Ok(255)
  assert Int32.parse_radix("FF", radix: 16) == Ok(255)
  assert Int32.parse_radix("-7f", radix: 16) == Ok(-127)
  assert UInt8.parse_radix("11111111", radix: 2) == Ok(255)
  assert UInt8.parse_radix("100000000", radix: 2) == Err(core::ParseIntegerError.OutOfRange)
  assert Int32.parse_radix("z", radix: 36) == Ok(35)
  assert Int32.parse_radix("Zz", radix: 36) == Ok(1295)
  assert Int32.parse_radix("8", radix: 8) == Err(core::ParseIntegerError.InvalidDigit(offset: 0))
  assert Int32.parse_radix("12", radix: 2) == Err(core::ParseIntegerError.InvalidDigit(offset: 1))
  assert Int32.parse_radix("g", radix: 16) == Err(core::ParseIntegerError.InvalidDigit(offset: 0))
  assert ISize.parse_radix("-80", radix: 16) == Ok(-128)
  assert USize.parse_radix("777", radix: 8) == Ok(511)
}

test "the integer square root of a 64-bit number is exact at the top of its range" {
  let top: UInt64 = 18446744073709551615
  assert top.integer_square_root() == 4294967295
  let square: UInt64 = 18446744065119617025
  assert square.integer_square_root() == 4294967295
  let below: UInt64 = 18446744065119617024
  assert below.integer_square_root() == 4294967294
  let small: USize = 17
  assert small.integer_square_root() == 4
  let nothing: USize = 0
  assert nothing.integer_square_root() == 0
}

test "an integer is formatted in a radix, with a sign and leading zeros" {
  let answer: Int32 = 42
  assert answer.format() == "42"
  assert answer.format(radix: 2) == "101010"
  assert answer.format(radix: 16) == "2a"
  assert answer.format(radix: 16, uppercase: true) == "2A"
  assert answer.format(minimum_digits: 5) == "00042"
  assert answer.format(radix: 36) == "16"
  let negative: Int32 = -42
  assert negative.format() == "-42"
  assert negative.format(radix: 16, minimum_digits: 4) == "-002a"
  let zero: Int32 = 0
  assert zero.format() == "0"
  assert zero.format(minimum_digits: 3) == "000"
  assert zero.format(minimum_digits: 0) == "0"
}

test "formatting reaches both ends of each type" {
  assert Int8.minimum.format() == "-128"
  assert Int8.maximum.format(radix: 2) == "1111111"
  assert Int64.minimum.format() == "-9223372036854775808"
  assert Int64.maximum.format(radix: 16) == "7fffffffffffffff"
  assert UInt64.maximum.format() == "18446744073709551615"
  assert UInt64.maximum.format(radix: 2).length() == 64
  assert UInt64.maximum.format(radix: 36, uppercase: true) == "3W5E11264SGSF"
  let byte: UInt8 = 255
  assert byte.format(radix: 16, minimum_digits: 4, uppercase: true) == "00FF"
}

test "a formatted integer parses back to itself" {
  assert Int64.parse(Int64.minimum.format()) == Ok(Int64.minimum)
  assert UInt64.parse_radix(UInt64.maximum.format(radix: 7), radix: 7) == Ok(UInt64.maximum)
  let value: Int16 = -12345
  assert Int16.parse_radix(value.format(radix: 36), radix: 36) == Ok(value)
}
