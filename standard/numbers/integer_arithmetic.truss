public fn UInt8.integer_square_root(self) -> UInt8
  ensures result * result <= self
  ensures self < (result + 1) * (result + 1)
  cost time O(8)
{
  var result: UInt8 = 0
  var width: UInt8 = 16
  while width > 1
    invariant width >= 1
    invariant result + width <= 16
    invariant result * result <= self
    invariant self < (result + width) * (result + width)
    decreases width
    cost time O(log(15) - log(width - 1))
  {
    let half = width / 2
    let candidate = result + half
    if candidate * candidate <= self {
      result = candidate
      width = width - half
    } else {
      width = half
    }
  }
  result
}

public fn UInt16.integer_square_root(self) -> UInt16
  ensures result * result <= self
  ensures self < (result + 1) * (result + 1)
  cost time O(16)
{
  var result: UInt16 = 0
  var width: UInt16 = 256
  while width > 1
    invariant width >= 1
    invariant result + width <= 256
    invariant result * result <= self
    invariant self < (result + width) * (result + width)
    decreases width
    cost time O(log(255) - log(width - 1))
  {
    let half = width / 2
    let candidate = result + half
    if candidate * candidate <= self {
      result = candidate
      width = width - half
    } else {
      width = half
    }
  }
  result
}

