public fn UInt8.total(items: Slice[UInt8]) -> Integer
  cost time finite
{
  items.model().sum(fn(item) { item })
}

public fn UInt8.sum(items: Slice[UInt8]) -> UInt8
  requires UInt8.minimum <= UInt8.total(items) && UInt8.total(items) <= UInt8.maximum
  ensures result == UInt8.total(items)
  cost time O(items.length())
{
  UInt8.wrapping_sum(items)
}

public fn UInt8.checked_sum(items: Slice[UInt8]) -> Option[UInt8]
  cost time O(items.length())
{
  var total: UInt8 = 0
  for item in items {
    total = total.checked_add(item)?
  }
  Some(total)
}

public fn UInt8.saturating_sum(items: Slice[UInt8]) -> UInt8
  cost time O(items.length())
{
  var total: UInt8 = 0
