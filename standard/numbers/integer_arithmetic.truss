  var width: UInt32 = 65536
  while width > 1
    invariant width >= 1
    invariant result + width <= 65536
    invariant result * result <= self
    invariant self < (result + width) * (result + width)
    decreases width
    cost time O(log(65535) - log(width - 1))
  {
    let half = width / 2
    let candidate = result + half
    if candidate * candidate <= self {
      result = candidate
      width = width - half
    } else {
      width = half
    }
  }
  result
}

impl core::Countable for UInt32 {
  fn successor(self) -> Option[UInt32]
    cost time O(1)
  {
    self.checked_add(1)
  }

  fn predecessor(self) -> Option[UInt32]
    cost time O(1)
  {
    self.checked_subtract(1)
  }

  fn advanced(self, by: USize) -> Option[UInt32]
    cost time O(1)
    ensures (result is None) == (self + by > UInt32.maximum)
    ensures !(result is Some(value) && value != self + by)
  {
    let room: USize = intrinsic::convert(UInt32.maximum - self)
    if by > room { None } else { Some(self + intrinsic::convert(by)) }
  }

  fn retreated(self, by: USize) -> Option[UInt32]
    cost time O(1)
    ensures (result is None) == (by > self)
    ensures !(result is Some(value) && value != self - by)
  {
    let room: USize = intrinsic::convert(self)
    if by > room { None } else { Some(self - intrinsic::convert(by)) }
  }

  fn steps_to(self, other: UInt32) -> Option[USize]
    cost time O(1)
    ensures (result is None) == (other < self)
    ensures !(result is Some(steps) && steps != other - self)
  {
    if other < self { None } else { Some(intrinsic::convert(other - self)) }
  }
}

public let UInt64.bits: USize = 64

public fn UInt64.checked_divide(self, other: UInt64) -> Option[UInt64]
  ensures (result is None) == (other == 0)
  ensures !(result is Some(quotient) && quotient != self / other)
  cost time O(1)
{
  if other == 0 { None } else { Some(self / other) }
}

public fn UInt64.checked_remainder(self, other: UInt64) -> Option[UInt64]
  ensures (result is None) == (other == 0)
  ensures !(result is Some(remainder) && remainder != self % other)
  cost time O(1)
{
  if other == 0 { None } else { Some(self % other) }
}

public fn UInt64.checked_power(self, exponent: UInt32) -> Option[UInt64]
  cost time O(log(exponent))
{
  var result: UInt64 = 1
  var base = self
  var remaining = exponent
  while remaining > 1
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.checked_multiply(base)?
    }
    base = base.checked_multiply(base)?
    remaining = remaining / 2
  }
  if remaining == 1 { result.checked_multiply(base) } else { Some(result) }
}

public fn UInt64.wrapping_power(self, exponent: UInt32) -> UInt64
  cost time O(log(exponent))
{
  var result: UInt64 = 1
  var base = self
  var remaining = exponent
  while remaining > 0
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.wrapping_multiply(base)
    }
    base = base.wrapping_multiply(base)
    remaining = remaining / 2
  }
  result
}

public fn UInt64.saturating_power(self, exponent: UInt32) -> UInt64
  cost time O(log(exponent))
{
  match self.checked_power(exponent) {
    Some(power) => power
    None => UInt64.maximum
  }
}

public fn UInt64.saturating_subtract(self, other: UInt64) -> UInt64
  ensures self < other ==> result == 0
  ensures self >= other ==> result == self - other
  cost time O(1)
{
  if self < other { 0 } else { self - other }
}

public fn UInt64.saturating_multiply(self, other: UInt64) -> UInt64
  ensures self * other > UInt64.maximum ==> result == UInt64.maximum
  ensures self * other <= UInt64.maximum ==> result == self * other
  cost time O(1)
{
  if intrinsic::multiply_overflows(self, right: other) {
    UInt64.maximum
  } else {
    intrinsic::multiply(self, right: other)
  }
}

public fn UInt64.floor_divide(self, divisor: UInt64) -> UInt64
  requires divisor != 0
  ensures result == self / divisor
  cost time O(1)
{
  self / divisor
}

public fn UInt64.floor_modulo(self, divisor: UInt64) -> UInt64
  requires divisor != 0
  ensures result == self % divisor
  cost time O(1)
{
  self % divisor
}

public fn UInt64.absolute_difference(self, other: UInt64) -> UInt64
  ensures result == self - other || result == other - self
  cost time O(1)
{
  if self >= other { self - other } else { other - self }
}

