use standard::core

public let Int8.bits: USize = 8

public fn Int8.checked_divide(self, other: Int8) -> Option[Int8]
  ensures (result is None) == (other == 0 || (self == Int8.minimum && other == -1))
  cost time O(1)
{
  todo
}

public fn Int8.checked_remainder(self, other: Int8) -> Option[Int8]
  ensures (result is None) == (other == 0 || (self == Int8.minimum && other == -1))
  cost time O(1)
{
  todo
}

public fn Int8.checked_power(self, exponent: UInt32) -> Option[Int8]
  cost time O(log(exponent))
{
  todo
}

public fn Int8.wrapping_power(self, exponent: UInt32) -> Int8
  cost time O(log(exponent))
{
  todo
}

public fn Int8.saturating_power(self, exponent: UInt32) -> Int8
  cost time O(log(exponent))
{
  todo
}

public fn Int8.saturating_subtract(self, other: Int8) -> Int8
  cost time O(1)
{
  todo
}

public fn Int8.saturating_multiply(self, other: Int8) -> Int8
  cost time O(1)
{
  todo
}

public fn Int8.floor_divide(self, divisor: Int8) -> Int8
  requires divisor != 0
  requires self != Int8.minimum || divisor != -1
  ensures divisor > 0 ==> result * divisor <= self && self < (result + 1) * divisor
  ensures divisor < 0 ==> result * divisor >= self && self > (result + 1) * divisor
  cost time O(1)
{
  let quotient = self / divisor
  if self % divisor != 0 && (self < 0) != (divisor < 0) { quotient - 1 } else { quotient }
}

public fn Int8.floor_modulo(self, divisor: Int8) -> Int8
  requires divisor != 0
  requires self != Int8.minimum || divisor != -1
  ensures divisor > 0 ==> 0 <= result && result < divisor
  ensures divisor < 0 ==> divisor < result && result <= 0
  ensures result == self - self.floor_divide(divisor) * divisor
  cost time O(1)
{
  let remainder = self % divisor
  if remainder != 0 && (remainder < 0) != (divisor < 0) { remainder + divisor } else { remainder }
}

