    None => if self < 0 && exponent % 2 == 1 { Int64.minimum } else { Int64.maximum }
  }
}

public fn Int64.saturating_subtract(self, other: Int64) -> Int64
  ensures self - other < Int64.minimum ==> result == Int64.minimum
  ensures self - other > Int64.maximum ==> result == Int64.maximum
  ensures Int64.minimum <= self - other && self - other <= Int64.maximum ==> result == self - other
  cost time O(1)
{
  if intrinsic::subtract_overflows(self, right: other) {
    if other > 0 { Int64.minimum } else { Int64.maximum }
  } else {
    intrinsic::subtract(self, right: other)
  }
}

public fn Int64.saturating_multiply(self, other: Int64) -> Int64
  ensures self * other < Int64.minimum ==> result == Int64.minimum
  ensures self * other > Int64.maximum ==> result == Int64.maximum
  ensures Int64.minimum <= self * other && self * other <= Int64.maximum ==> result == self * other
  cost time O(1)
{
  if intrinsic::multiply_overflows(self, right: other) {
    if (self < 0) != (other < 0) { Int64.minimum } else { Int64.maximum }
  } else {
    intrinsic::multiply(self, right: other)
  }
}

public fn Int64.floor_divide(self, divisor: Int64) -> Int64
  requires divisor != 0
  requires self != Int64.minimum || divisor != -1
  ensures divisor > 0 ==> result * divisor <= self && self < (result + 1) * divisor
  ensures divisor < 0 ==> result * divisor >= self && self > (result + 1) * divisor
  cost time O(1)
{
  let quotient = self / divisor
  if self % divisor != 0 && (self < 0) != (divisor < 0) { quotient - 1 } else { quotient }
}

public fn Int64.floor_modulo(self, divisor: Int64) -> Int64
  requires divisor != 0
  requires self != Int64.minimum || divisor != -1
  ensures divisor > 0 ==> 0 <= result && result < divisor
  ensures divisor < 0 ==> divisor < result && result <= 0
  ensures result == self - self.floor_divide(divisor) * divisor
  cost time O(1)
{
  let remainder = self % divisor
  if remainder != 0 && (remainder < 0) != (divisor < 0) { remainder + divisor } else { remainder }
}

public fn Int64.absolute_difference(self, other: Int64) -> UInt64
  ensures result == self - other || result == other - self
  ensures result >= 0
  cost time O(1)
{
  let high = if self >= other { self } else { other }
  let low = if self >= other { other } else { self }
  if low >= 0 || high < 0 {
    intrinsic::convert(high - low)
  } else {
    let above: UInt64 = intrinsic::convert(high)
