public fn Int64.checked_power(self, exponent: UInt32) -> Option[Int64]
  cost time O(log(exponent))
{
  var result: Int64 = 1
  var base = self
  var remaining = exponent
  while remaining > 1
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.checked_multiply(base)?
    }
    base = base.checked_multiply(base)?
    remaining = remaining / 2
  }
  if remaining == 1 { result.checked_multiply(base) } else { Some(result) }
}

public fn Int64.wrapping_power(self, exponent: UInt32) -> Int64
  cost time O(log(exponent))
{
  var result: Int64 = 1
  var base = self
  var remaining = exponent
  while remaining > 0
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.wrapping_multiply(base)
    }
    base = base.wrapping_multiply(base)
    remaining = remaining / 2
  }
  result
}

public fn Int64.saturating_power(self, exponent: UInt32) -> Int64
  cost time O(log(exponent))
{
