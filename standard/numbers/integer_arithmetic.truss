use standard::core
use standard::intrinsic

public let Int8.bits: USize = 8

impl core::Countable for Int8 {
  fn successor(self) -> Option[Int8]
    cost time O(1)
  {
    self.checked_add(1)
  }

  fn predecessor(self) -> Option[Int8]
    cost time O(1)
  {
    self.checked_subtract(1)
  }

  fn advanced(self, by: USize) -> Option[Int8]
    cost time O(1)
    ensures (result is None) == (self + by > Int8.maximum)
    ensures !(result is Some(value) && value != self + by)
  {
    let room: USize = intrinsic::convert(Int8.maximum.absolute_difference(self))
    let limit: USize = intrinsic::convert(Int8.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self + intrinsic::convert(by))
    } else {
      let rest: Int8 = intrinsic::convert(by - limit - 1)
      Some(self + Int8.maximum + rest + 1)
    }
  }

  fn retreated(self, by: USize) -> Option[Int8]
    cost time O(1)
    ensures (result is None) == (self - by < Int8.minimum)
    ensures !(result is Some(value) && value != self - by)
  {
    let room: USize = intrinsic::convert(self.absolute_difference(Int8.minimum))
    let limit: USize = intrinsic::convert(Int8.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self - intrinsic::convert(by))
    } else {
      let rest: Int8 = intrinsic::convert(by - limit - 1)
      Some(self - Int8.maximum - rest - 1)
    }
  }

  fn steps_to(self, other: Int8) -> Option[USize]
    cost time O(1)
    ensures (result is None) == (other < self)
    ensures !(result is Some(steps) && steps != other - self)
  {
    if other < self { None } else { Some(intrinsic::convert(other.absolute_difference(self))) }
  }
}

