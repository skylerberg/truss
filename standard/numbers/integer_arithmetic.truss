use standard::core
use standard::intrinsic

public let Int8.bits: USize = 8

public fn Int8.checked_divide(self, other: Int8) -> Option[Int8]
  ensures (result is None) == (other == 0 || (self == Int8.minimum && other == -1))
  ensures !(result is Some(quotient) && quotient != self / other)
  cost time O(1)
{
  if other == 0 || (self == Int8.minimum && other == -1) { None } else { Some(self / other) }
}

public fn Int8.checked_remainder(self, other: Int8) -> Option[Int8]
  ensures (result is None) == (other == 0 || (self == Int8.minimum && other == -1))
  ensures !(result is Some(remainder) && remainder != self % other)
  cost time O(1)
{
  if other == 0 || (self == Int8.minimum && other == -1) { None } else { Some(self % other) }
}

public fn Int8.checked_power(self, exponent: UInt32) -> Option[Int8]
  cost time O(log(exponent))
{
  var result: Int8 = 1
  var base = self
  var remaining = exponent
  while remaining > 1
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.checked_multiply(base)?
    }
    base = base.checked_multiply(base)?
    remaining = remaining / 2
  }
  if remaining == 1 { result.checked_multiply(base) } else { Some(result) }
}

public fn Int8.wrapping_power(self, exponent: UInt32) -> Int8
  cost time O(log(exponent))
{
  var result: Int8 = 1
  var base = self
  var remaining = exponent
  while remaining > 0
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.wrapping_multiply(base)
    }
    base = base.wrapping_multiply(base)
    remaining = remaining / 2
  }
  result
}

public fn Int8.saturating_power(self, exponent: UInt32) -> Int8
  cost time O(log(exponent))
{
  match self.checked_power(exponent) {
    Some(power) => power
    None => if self < 0 && exponent % 2 == 1 { Int8.minimum } else { Int8.maximum }
  }
}

public fn Int8.saturating_subtract(self, other: Int8) -> Int8
  ensures self - other < Int8.minimum ==> result == Int8.minimum
  ensures self - other > Int8.maximum ==> result == Int8.maximum
  ensures Int8.minimum <= self - other && self - other <= Int8.maximum ==> result == self - other
  cost time O(1)
{
  if intrinsic::subtract_overflows(self, right: other) {
    if other > 0 { Int8.minimum } else { Int8.maximum }
  } else {
    intrinsic::subtract(self, right: other)
  }
}

public fn Int8.saturating_multiply(self, other: Int8) -> Int8
  ensures self * other < Int8.minimum ==> result == Int8.minimum
  ensures self * other > Int8.maximum ==> result == Int8.maximum
  ensures Int8.minimum <= self * other && self * other <= Int8.maximum ==> result == self * other
  cost time O(1)
{
  if intrinsic::multiply_overflows(self, right: other) {
    if (self < 0) != (other < 0) { Int8.minimum } else { Int8.maximum }
  } else {
    intrinsic::multiply(self, right: other)
  }
}

public fn Int8.floor_divide(self, divisor: Int8) -> Int8
  requires divisor != 0
  requires self != Int8.minimum || divisor != -1
  ensures divisor > 0 ==> result * divisor <= self && self < (result + 1) * divisor
  ensures divisor < 0 ==> result * divisor >= self && self > (result + 1) * divisor
  cost time O(1)
{
  let quotient = self / divisor
  if self % divisor != 0 && (self < 0) != (divisor < 0) { quotient - 1 } else { quotient }
}

public fn Int8.floor_modulo(self, divisor: Int8) -> Int8
  requires divisor != 0
  requires self != Int8.minimum || divisor != -1
  ensures divisor > 0 ==> 0 <= result && result < divisor
  ensures divisor < 0 ==> divisor < result && result <= 0
  ensures result == self - self.floor_divide(divisor) * divisor
  cost time O(1)
{
  let remainder = self % divisor
  if remainder != 0 && (remainder < 0) != (divisor < 0) { remainder + divisor } else { remainder }
}

public fn Int8.absolute_difference(self, other: Int8) -> UInt8
  ensures result == self - other || result == other - self
  ensures result >= 0
  cost time O(1)
{
  let high = if self >= other { self } else { other }
  let low = if self >= other { other } else { self }
  if low >= 0 || high < 0 {
    intrinsic::convert(high - low)
  } else {
    let above: UInt8 = intrinsic::convert(high)
    above + low.unsigned_absolute()
  }
}

