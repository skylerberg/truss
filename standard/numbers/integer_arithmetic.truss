public fn Int8.total(items: Slice[Int8]) -> Integer
  cost time finite
{
  items.model().sum(fn(item) { item })
}

public fn Int8.sum(items: Slice[Int8]) -> Int8
  requires Int8.minimum <= Int8.total(items) && Int8.total(items) <= Int8.maximum
  ensures result == Int8.total(items)
  cost time O(items.length())
{
  Int8.wrapping_sum(items)
}

public fn Int8.checked_sum(items: Slice[Int8]) -> Option[Int8]
  cost time O(items.length())
{
  var total: Int8 = 0
  for item in items {
    total = total.checked_add(item)?
  }
  Some(total)
}

public fn Int8.saturating_sum(items: Slice[Int8]) -> Int8
  cost time O(items.length())
{
  var total: Int8 = 0
  for item in items {
    total = total.saturating_add(item)
  }
  total
}

public fn Int8.wrapping_sum(items: Slice[Int8]) -> Int8
  ensures exists wraps: Integer => result + wraps * 256 == Int8.total(items)
  cost time O(items.length())
{
  var total: Int8 = 0
  for item in items
    invariant exists wraps: Integer => total + wraps * 256 == yielded.sum(fn(value) { value })
  {
    total = total.wrapping_add(item)
  }
  total
}

public fn Int8.absolute(self) -> Int8
  requires self != Int8.minimum
  ensures result >= 0
  ensures result == self || result == -self
  cost time O(1)
{
  if self < 0 { -self } else { self }
}

public fn Int8.checked_absolute(self) -> Option[Int8]
  ensures (result is None) == (self == Int8.minimum)
  ensures !(result is Some(magnitude) && (magnitude < 0 || (magnitude != self && magnitude != -self)))
  cost time O(1)
{
  if self == Int8.minimum { None } else { Some(self.absolute()) }
}

public fn Int8.unsigned_absolute(self) -> UInt8
  ensures result == self || result == -self
  cost time O(1)
{
  if self >= 0 {
    intrinsic::convert(self)
  } else {
    let below: UInt8 = intrinsic::convert(-(self + 1))
    below + 1
  }
}

public fn Int8.checked_negate(self) -> Option[Int8]
  ensures (result is None) == (self == Int8.minimum)
  ensures !(result is Some(negated) && negated != -self)
  cost time O(1)
{
  if self == Int8.minimum { None } else { Some(-self) }
}

public fn Int8.wrapping_negate(self) -> Int8
  ensures self == Int8.minimum ==> result == Int8.minimum
  ensures self != Int8.minimum ==> result == -self
  cost time O(1)
{
  intrinsic::wrapping_subtract(0, right: self)
}

public fn Int8.sign(self) -> Int8
  ensures -1 <= result && result <= 1
  ensures (result == 0) == (self == 0)
  ensures (result == 1) == (self > 0)
  cost time O(1)
{
  if self < 0 { -1 } else if self > 0 { 1 } else { 0 }
}

public fn Int8.is_negative(self) -> Bool
  cost time O(1)
{
  self < 0
}

public fn Int8.is_positive(self) -> Bool
  cost time O(1)
{
  self > 0
}

impl core::Countable for Int8 {
  fn successor(self) -> Option[Int8]
    cost time O(1)
  {
    self.checked_add(1)
  }

  fn predecessor(self) -> Option[Int8]
    cost time O(1)
  {
    self.checked_subtract(1)
  }

  fn advanced(self, by: USize) -> Option[Int8]
    cost time O(1)
    ensures (result is None) == (self + by > Int8.maximum)
    ensures !(result is Some(value) && value != self + by)
  {
    let room: USize = intrinsic::convert(Int8.maximum.absolute_difference(self))
    let limit: USize = intrinsic::convert(Int8.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self + intrinsic::convert(by))
    } else {
      let rest: Int8 = intrinsic::convert(by - limit - 1)
      Some(self + Int8.maximum + rest + 1)
    }
  }

  fn retreated(self, by: USize) -> Option[Int8]
    cost time O(1)
    ensures (result is None) == (self - by < Int8.minimum)
    ensures !(result is Some(value) && value != self - by)
  {
    let room: USize = intrinsic::convert(self.absolute_difference(Int8.minimum))
    let limit: USize = intrinsic::convert(Int8.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self - intrinsic::convert(by))
    } else {
      let rest: Int8 = intrinsic::convert(by - limit - 1)
      Some(self - Int8.maximum - rest - 1)
    }
  }

  fn steps_to(self, other: Int8) -> Option[USize]
    cost time O(1)
    ensures (result is None) == (other < self)
    ensures !(result is Some(steps) && steps != other - self)
  {
    if other < self { None } else { Some(intrinsic::convert(other.absolute_difference(self))) }
  }
}

