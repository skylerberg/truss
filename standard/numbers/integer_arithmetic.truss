}

public fn UInt8.wrapping_sum(items: Slice[UInt8]) -> UInt8
  ensures exists wraps: Integer => result + wraps * 256 == UInt8.total(items)
  cost time O(items.length())
{
  var total: UInt8 = 0
  for item in items
    invariant exists wraps: Integer => total + wraps * 256 == yielded.sum(fn(value) { value })
  {
    total = total.wrapping_add(item)
  }
  total
}

public fn UInt8.is_power_of_two(self) -> Bool
  ensures result ==> self > 0
  cost time O(1)
{
  self != 0 && (self & (self - 1)) == 0
}

public fn UInt8.next_power_of_two(self) -> Option[UInt8]
  cost time O(1)
{
  if self <= 1 {
    return Some(1)
  }
  let used = UInt8.bits.saturating_subtract(intrinsic::leading_zeros(self - 1))
  if used >= UInt8.bits {
    None
  } else {
    let one: UInt8 = 1
    Some(one << used)
  }
}

public fn UInt8.greatest_common_divisor(self, other: UInt8) -> UInt8
  ensures (result == 0) == (self == 0 && other == 0)
  cost time O(log(self) + log(other))
{
  var first = if self >= other { self } else { other }
  var second = if self >= other { other } else { self }
  while second != 0
    invariant second <= first
    invariant (first == 0) == (self == 0 && other == 0)
    decreases second
    cost time O(log(self) + log(other) - log(first) - log(second))
  {
    let remainder = first % second
    proof {
      assert second > first / 2 ==> remainder == first - second
    }
    first = second
    second = remainder
  }
  first
}

public fn UInt8.least_common_multiple(self, other: UInt8) -> Option[UInt8]
  cost time O(log(self) + log(other))
{
  if self == 0 || other == 0 {
    Some(0)
  } else {
    (self / self.greatest_common_divisor(other)).checked_multiply(other)
  }
}

public fn UInt8.integer_square_root(self) -> UInt8
  ensures result * result <= self
  ensures self < (result + 1) * (result + 1)
  cost time O(8)
{
  var result: UInt8 = 0
  var width: UInt8 = 16
  while width > 1
    invariant width >= 1
    invariant result + width <= 16
    invariant result * result <= self
    invariant self < (result + width) * (result + width)
    decreases width
    cost time O(log(15) - log(width - 1))
  {
    let half = width / 2
    let candidate = result + half
    if candidate * candidate <= self {
      result = candidate
      width = width - half
    } else {
      width = half
    }
  }
  result
}

impl core::Countable for UInt8 {
  fn successor(self) -> Option[UInt8]
    cost time O(1)
  {
    self.checked_add(1)
  }

  fn predecessor(self) -> Option[UInt8]
    cost time O(1)
  {
    self.checked_subtract(1)
  }

  fn advanced(self, by: USize) -> Option[UInt8]
    cost time O(1)
    ensures (result is None) == (self + by > UInt8.maximum)
    ensures !(result is Some(value) && value != self + by)
  {
    let room: USize = intrinsic::convert(UInt8.maximum - self)
    if by > room { None } else { Some(self + intrinsic::convert(by)) }
  }

  fn retreated(self, by: USize) -> Option[UInt8]
    cost time O(1)
    ensures (result is None) == (by > self)
    ensures !(result is Some(value) && value != self - by)
  {
    let room: USize = intrinsic::convert(self)
    if by > room { None } else { Some(self - intrinsic::convert(by)) }
  }

  fn steps_to(self, other: UInt8) -> Option[USize]
    cost time O(1)
    ensures (result is None) == (other < self)
    ensures !(result is Some(steps) && steps != other - self)
  {
    if other < self { None } else { Some(intrinsic::convert(other - self)) }
  }
}

