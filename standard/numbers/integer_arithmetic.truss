public fn UInt64.total(items: Slice[UInt64]) -> Integer
  cost time finite
{
  items.model().sum(fn(item) { item })
}

public fn UInt64.sum(items: Slice[UInt64]) -> UInt64
  requires UInt64.minimum <= UInt64.total(items) && UInt64.total(items) <= UInt64.maximum
  ensures result == UInt64.total(items)
  cost time O(items.length())
{
  UInt64.wrapping_sum(items)
}

public fn UInt64.checked_sum(items: Slice[UInt64]) -> Option[UInt64]
  cost time O(items.length())
{
  var total: UInt64 = 0
  for item in items {
    total = total.checked_add(item)?
  }
  Some(total)
}

public fn UInt64.saturating_sum(items: Slice[UInt64]) -> UInt64
  cost time O(items.length())
{
  var total: UInt64 = 0
  for item in items {
    total = total.saturating_add(item)
  }
  total
}

public fn UInt64.wrapping_sum(items: Slice[UInt64]) -> UInt64
  ensures exists wraps: Integer => result + wraps * 18446744073709551616 == UInt64.total(items)
  cost time O(items.length())
{
  var total: UInt64 = 0
  for item in items
    invariant exists wraps: Integer => total + wraps * 18446744073709551616 == yielded.sum(fn(value) { value })
  {
    total = total.wrapping_add(item)
  }
  total
}

public fn UInt64.is_power_of_two(self) -> Bool
  ensures result ==> self > 0
  cost time O(1)
{
  self != 0 && (self & (self - 1)) == 0
}

public fn UInt64.next_power_of_two(self) -> Option[UInt64]
  cost time O(1)
{
  if self <= 1 {
    return Some(1)
  }
  let used = UInt64.bits.saturating_subtract(intrinsic::leading_zeros(self - 1))
  if used >= UInt64.bits {
    None
  } else {
    let one: UInt64 = 1
    Some(one << used)
  }
}

public fn UInt64.greatest_common_divisor(self, other: UInt64) -> UInt64
  ensures (result == 0) == (self == 0 && other == 0)
  cost time O(log(self) + log(other))
{
  var first = if self >= other { self } else { other }
  var second = if self >= other { other } else { self }
  while second != 0
    invariant second <= first
    invariant (first == 0) == (self == 0 && other == 0)
    decreases second
    cost time O(log(self) + log(other) - log(first) - log(second))
  {
    let remainder = first % second
    proof {
      assert second > first / 2 ==> remainder == first - second
    }
    first = second
    second = remainder
  }
  first
}

public fn UInt64.least_common_multiple(self, other: UInt64) -> Option[UInt64]
  cost time O(log(self) + log(other))
{
  if self == 0 || other == 0 {
    Some(0)
  } else {
    (self / self.greatest_common_divisor(other)).checked_multiply(other)
  }
}

public fn UInt64.integer_square_root(self) -> UInt64
  ensures result * result <= self
  ensures self < (result + 1) * (result + 1)
  cost time O(64)
{
  var result: UInt64 = 0
  var width: UInt64 = 4294967296
  while width > 1
    invariant width >= 1
    invariant result + width <= 4294967296
    invariant result * result <= self
    invariant self < (result + width) * (result + width)
    decreases width
    cost time O(log(4294967295) - log(width - 1))
  {
    let half = width / 2
    let candidate = result + half
    if candidate * candidate <= self {
      result = candidate
      width = width - half
    } else {
      width = half
    }
  }
  result
}

