    ensures !(result is Some(value) && value != self - by)
  {
    let room: USize = intrinsic::convert(self.absolute_difference(ISize.minimum))
    let limit: USize = intrinsic::convert(ISize.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self - intrinsic::convert(by))
    } else {
      let rest: ISize = intrinsic::convert(by - limit - 1)
      Some(self - ISize.maximum - rest - 1)
    }
  }

  fn steps_to(self, other: ISize) -> Option[USize]
    cost time O(1)
    ensures (result is None) == (other < self)
    ensures !(result is Some(steps) && steps != other - self)
  {
    if other < self { None } else { Some(intrinsic::convert(other.absolute_difference(self))) }
  }
}

public let UInt8.bits: USize = 8

public fn UInt8.checked_divide(self, other: UInt8) -> Option[UInt8]
  ensures (result is None) == (other == 0)
  ensures !(result is Some(quotient) && quotient != self / other)
  cost time O(1)
{
  if other == 0 { None } else { Some(self / other) }
}

public fn UInt8.checked_remainder(self, other: UInt8) -> Option[UInt8]
  ensures (result is None) == (other == 0)
  ensures !(result is Some(remainder) && remainder != self % other)
  cost time O(1)
{
  if other == 0 { None } else { Some(self % other) }
}

public fn UInt8.checked_power(self, exponent: UInt32) -> Option[UInt8]
  cost time O(log(exponent))
{
  var result: UInt8 = 1
  var base = self
  var remaining = exponent
  while remaining > 1
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.checked_multiply(base)?
    }
    base = base.checked_multiply(base)?
    remaining = remaining / 2
  }
  if remaining == 1 { result.checked_multiply(base) } else { Some(result) }
}

public fn UInt8.wrapping_power(self, exponent: UInt32) -> UInt8
  cost time O(log(exponent))
{
  var result: UInt8 = 1
  var base = self
  var remaining = exponent
  while remaining > 0
    decreases remaining
    cost time O(log(exponent) - log(remaining))
  {
    if remaining % 2 == 1 {
      result = result.wrapping_multiply(base)
    }
    base = base.wrapping_multiply(base)
    remaining = remaining / 2
  }
  result
}

public fn UInt8.saturating_power(self, exponent: UInt32) -> UInt8
  cost time O(log(exponent))
{
  match self.checked_power(exponent) {
    Some(power) => power
    None => UInt8.maximum
  }
}

public fn UInt8.saturating_subtract(self, other: UInt8) -> UInt8
  ensures self < other ==> result == 0
  ensures self >= other ==> result == self - other
  cost time O(1)
{
  if self < other { 0 } else { self - other }
}

public fn UInt8.saturating_multiply(self, other: UInt8) -> UInt8
  ensures self * other > UInt8.maximum ==> result == UInt8.maximum
  ensures self * other <= UInt8.maximum ==> result == self * other
  cost time O(1)
{
  if intrinsic::multiply_overflows(self, right: other) {
    UInt8.maximum
  } else {
    intrinsic::multiply(self, right: other)
  }
}

public fn UInt8.floor_divide(self, divisor: UInt8) -> UInt8
  requires divisor != 0
  ensures result == self / divisor
  cost time O(1)
{
  self / divisor
}

public fn UInt8.floor_modulo(self, divisor: UInt8) -> UInt8
  requires divisor != 0
  ensures result == self % divisor
  cost time O(1)
{
  self % divisor
}

public fn UInt8.absolute_difference(self, other: UInt8) -> UInt8
  ensures result == self - other || result == other - self
  cost time O(1)
{
  if self >= other { self - other } else { other - self }
}

