impl core::Countable for Int32 {
  fn successor(self) -> Option[Int32]
    cost time O(1)
  {
    self.checked_add(1)
  }

  fn predecessor(self) -> Option[Int32]
    cost time O(1)
  {
    self.checked_subtract(1)
  }

  fn advanced(self, by: USize) -> Option[Int32]
    cost time O(1)
    ensures (result is None) == (self + by > Int32.maximum)
    ensures !(result is Some(value) && value != self + by)
  {
    let room: USize = intrinsic::convert(Int32.maximum.absolute_difference(self))
    let limit: USize = intrinsic::convert(Int32.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self + intrinsic::convert(by))
    } else {
      let rest: Int32 = intrinsic::convert(by - limit - 1)
      Some(self + Int32.maximum + rest + 1)
    }
  }

  fn retreated(self, by: USize) -> Option[Int32]
    cost time O(1)
    ensures (result is None) == (self - by < Int32.minimum)
    ensures !(result is Some(value) && value != self - by)
  {
    let room: USize = intrinsic::convert(self.absolute_difference(Int32.minimum))
    let limit: USize = intrinsic::convert(Int32.maximum)
    if by > room {
      None
    } else if by <= limit {
      Some(self - intrinsic::convert(by))
    } else {
      let rest: Int32 = intrinsic::convert(by - limit - 1)
      Some(self - Int32.maximum - rest - 1)
    }
  }

  fn steps_to(self, other: Int32) -> Option[USize]
    cost time O(1)
    ensures (result is None) == (other < self)
    ensures !(result is Some(steps) && steps != other - self)
  {
    if other < self { None } else { Some(intrinsic::convert(other.absolute_difference(self))) }
  }
}

