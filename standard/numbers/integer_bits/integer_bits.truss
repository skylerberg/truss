use standard::intrinsic


public fn Int8.to_big_endian_bytes(self) -> Array[UInt8, 1]
  ensures identical(result, self.to_unsigned_bits().to_big_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public fn Int8.to_little_endian_bytes(self) -> Array[UInt8, 1]
  ensures identical(result, self.to_unsigned_bits().to_little_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public fn Int8.from_big_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
  ensures result == (UInt8.from_big_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt8.from_big_endian_bytes(bytes).to_signed_bits()
}

public fn Int8.from_little_endian_bytes(bytes: Array[UInt8, 1]) -> Int8
  ensures result == (UInt8.from_little_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt8.from_little_endian_bytes(bytes).to_signed_bits()
}

public fn Int16.to_big_endian_bytes(self) -> Array[UInt8, 2]
  ensures identical(result, self.to_unsigned_bits().to_big_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public fn Int16.to_little_endian_bytes(self) -> Array[UInt8, 2]
  ensures identical(result, self.to_unsigned_bits().to_little_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public fn Int16.from_big_endian_bytes(bytes: Array[UInt8, 2]) -> Int16
  ensures result == (UInt16.from_big_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt16.from_big_endian_bytes(bytes).to_signed_bits()
}

public fn Int16.from_little_endian_bytes(bytes: Array[UInt8, 2]) -> Int16
  ensures result == (UInt16.from_little_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt16.from_little_endian_bytes(bytes).to_signed_bits()
}

public fn Int32.to_big_endian_bytes(self) -> Array[UInt8, 4]
  ensures identical(result, self.to_unsigned_bits().to_big_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public fn Int32.to_little_endian_bytes(self) -> Array[UInt8, 4]
  ensures identical(result, self.to_unsigned_bits().to_little_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public fn Int32.from_big_endian_bytes(bytes: Array[UInt8, 4]) -> Int32
  ensures result == (UInt32.from_big_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt32.from_big_endian_bytes(bytes).to_signed_bits()
}

public fn Int32.from_little_endian_bytes(bytes: Array[UInt8, 4]) -> Int32
  ensures result == (UInt32.from_little_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt32.from_little_endian_bytes(bytes).to_signed_bits()
}

public fn Int64.to_big_endian_bytes(self) -> Array[UInt8, 8]
  ensures identical(result, self.to_unsigned_bits().to_big_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_big_endian_bytes()
}

public fn Int64.to_little_endian_bytes(self) -> Array[UInt8, 8]
  ensures identical(result, self.to_unsigned_bits().to_little_endian_bytes())
  cost time O(1)
{
  self.to_unsigned_bits().to_little_endian_bytes()
}

public fn Int64.from_big_endian_bytes(bytes: Array[UInt8, 8]) -> Int64
  ensures result == (UInt64.from_big_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt64.from_big_endian_bytes(bytes).to_signed_bits()
}

public fn Int64.from_little_endian_bytes(bytes: Array[UInt8, 8]) -> Int64
  ensures result == (UInt64.from_little_endian_bytes(bytes).to_signed_bits())
  cost time O(1)
{
  UInt64.from_little_endian_bytes(bytes).to_signed_bits()
}

public fn UInt8.to_big_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  [self]
}

public fn UInt8.to_little_endian_bytes(self) -> Array[UInt8, 1]
  cost time O(1)
{
  [self]
}

public fn UInt8.from_big_endian_bytes(bytes: Array[UInt8, 1]) -> UInt8
  ensures result == (bytes[0])
  cost time O(1)
{
  bytes[0]
}

public fn UInt8.from_little_endian_bytes(bytes: Array[UInt8, 1]) -> UInt8
  ensures result == (bytes[0])
  cost time O(1)
{
  bytes[0]
}

public fn UInt16.to_big_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  [intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public fn UInt16.to_little_endian_bytes(self) -> Array[UInt8, 2]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255)]
}

public fn UInt16.from_big_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
  ensures result == ((intrinsic::convert[UInt8, UInt16](bytes[0]) << 8) | intrinsic::convert[UInt8, UInt16](bytes[1]))
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt16](bytes[0]) << 8) | intrinsic::convert[UInt8, UInt16](bytes[1])
}

public fn UInt16.from_little_endian_bytes(bytes: Array[UInt8, 2]) -> UInt16
  ensures result == (intrinsic::convert[UInt8, UInt16](bytes[0]) | (intrinsic::convert[UInt8, UInt16](bytes[1]) << 8))
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt16](bytes[0]) | (intrinsic::convert[UInt8, UInt16](bytes[1]) << 8)
}

public fn UInt32.to_big_endian_bytes(self) -> Array[UInt8, 4]
  cost time O(1)
{
  [intrinsic::convert((self >> 24) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public fn UInt32.to_little_endian_bytes(self) -> Array[UInt8, 4]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 24) & 255)]
}

public fn UInt32.from_big_endian_bytes(bytes: Array[UInt8, 4]) -> UInt32
  ensures result == ((intrinsic::convert[UInt8, UInt32](bytes[0]) << 24) | (intrinsic::convert[UInt8, UInt32](bytes[1]) << 16) | (intrinsic::convert[UInt8, UInt32](bytes[2]) << 8) | intrinsic::convert[UInt8, UInt32](bytes[3]))
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt32](bytes[0]) << 24) | (intrinsic::convert[UInt8, UInt32](bytes[1]) << 16) | (intrinsic::convert[UInt8, UInt32](bytes[2]) << 8) | intrinsic::convert[UInt8, UInt32](bytes[3])
}

public fn UInt32.from_little_endian_bytes(bytes: Array[UInt8, 4]) -> UInt32
  ensures result == (intrinsic::convert[UInt8, UInt32](bytes[0]) | (intrinsic::convert[UInt8, UInt32](bytes[1]) << 8) | (intrinsic::convert[UInt8, UInt32](bytes[2]) << 16) | (intrinsic::convert[UInt8, UInt32](bytes[3]) << 24))
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt32](bytes[0]) | (intrinsic::convert[UInt8, UInt32](bytes[1]) << 8) | (intrinsic::convert[UInt8, UInt32](bytes[2]) << 16) | (intrinsic::convert[UInt8, UInt32](bytes[3]) << 24)
}

public fn UInt64.to_big_endian_bytes(self) -> Array[UInt8, 8]
  cost time O(1)
{
  [intrinsic::convert((self >> 56) & 255), intrinsic::convert((self >> 48) & 255), intrinsic::convert((self >> 40) & 255), intrinsic::convert((self >> 32) & 255), intrinsic::convert((self >> 24) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 0) & 255)]
}

public fn UInt64.to_little_endian_bytes(self) -> Array[UInt8, 8]
  cost time O(1)
{
  [intrinsic::convert((self >> 0) & 255), intrinsic::convert((self >> 8) & 255), intrinsic::convert((self >> 16) & 255), intrinsic::convert((self >> 24) & 255), intrinsic::convert((self >> 32) & 255), intrinsic::convert((self >> 40) & 255), intrinsic::convert((self >> 48) & 255), intrinsic::convert((self >> 56) & 255)]
}

public fn UInt64.from_big_endian_bytes(bytes: Array[UInt8, 8]) -> UInt64
  ensures result == ((intrinsic::convert[UInt8, UInt64](bytes[0]) << 56) | (intrinsic::convert[UInt8, UInt64](bytes[1]) << 48) | (intrinsic::convert[UInt8, UInt64](bytes[2]) << 40) | (intrinsic::convert[UInt8, UInt64](bytes[3]) << 32) | (intrinsic::convert[UInt8, UInt64](bytes[4]) << 24) | (intrinsic::convert[UInt8, UInt64](bytes[5]) << 16) | (intrinsic::convert[UInt8, UInt64](bytes[6]) << 8) | intrinsic::convert[UInt8, UInt64](bytes[7]))
  cost time O(1)
{
  (intrinsic::convert[UInt8, UInt64](bytes[0]) << 56) | (intrinsic::convert[UInt8, UInt64](bytes[1]) << 48) | (intrinsic::convert[UInt8, UInt64](bytes[2]) << 40) | (intrinsic::convert[UInt8, UInt64](bytes[3]) << 32) | (intrinsic::convert[UInt8, UInt64](bytes[4]) << 24) | (intrinsic::convert[UInt8, UInt64](bytes[5]) << 16) | (intrinsic::convert[UInt8, UInt64](bytes[6]) << 8) | intrinsic::convert[UInt8, UInt64](bytes[7])
}

public fn UInt64.from_little_endian_bytes(bytes: Array[UInt8, 8]) -> UInt64
  ensures result == (intrinsic::convert[UInt8, UInt64](bytes[0]) | (intrinsic::convert[UInt8, UInt64](bytes[1]) << 8) | (intrinsic::convert[UInt8, UInt64](bytes[2]) << 16) | (intrinsic::convert[UInt8, UInt64](bytes[3]) << 24) | (intrinsic::convert[UInt8, UInt64](bytes[4]) << 32) | (intrinsic::convert[UInt8, UInt64](bytes[5]) << 40) | (intrinsic::convert[UInt8, UInt64](bytes[6]) << 48) | (intrinsic::convert[UInt8, UInt64](bytes[7]) << 56))
  cost time O(1)
{
  intrinsic::convert[UInt8, UInt64](bytes[0]) | (intrinsic::convert[UInt8, UInt64](bytes[1]) << 8) | (intrinsic::convert[UInt8, UInt64](bytes[2]) << 16) | (intrinsic::convert[UInt8, UInt64](bytes[3]) << 24) | (intrinsic::convert[UInt8, UInt64](bytes[4]) << 32) | (intrinsic::convert[UInt8, UInt64](bytes[5]) << 40) | (intrinsic::convert[UInt8, UInt64](bytes[6]) << 48) | (intrinsic::convert[UInt8, UInt64](bytes[7]) << 56)
}
