use standard::core
use standard::intrinsic
use standard::text

internal fn digit_value(byte: UInt8) -> UInt64
  ensures result <= 36
  cost time O(1)
{
  if byte >= 48 && byte <= 57 {
    intrinsic::convert(byte - 48)
  } else if byte >= 97 && byte <= 122 {
    intrinsic::convert(byte - 87)
  } else if byte >= 65 && byte <= 90 {
    intrinsic::convert(byte - 55)
  } else {
    36
  }
}

internal fn parse_magnitude(
  text: StringSlice,
  start: USize,
  radix: UInt32,
  limit: UInt64,
) -> Result[UInt64, core::ParseIntegerError]
  requires 2 <= radix && radix <= 36
  requires start <= text.length()
  ensures !(result is Ok(value) && value > limit)
  cost time O(text.length())
{
  if start == text.length() {
    return Err(core::ParseIntegerError.Empty)
  }
  let base: UInt64 = intrinsic::convert(radix)
  var value: UInt64 = 0
  var index = start
  while index < text.length()
    invariant index <= text.length()
    invariant value <= limit
    decreases text.length() - index
  {
    let digit = digit_value(text.byte(index))
    if digit >= base {
      return Err(core::ParseIntegerError.InvalidDigit(offset: index))
    }
    if digit > limit || value > (limit - digit) / base {
      return Err(core::ParseIntegerError.OutOfRange)
    }
    value = value * base + digit
    index += 1
  }
  Ok(value)
}


impl text::Parse for Int8 {
  type Error = core::ParseIntegerError

  fn parse(text: StringSlice) -> Result[Int8, core::ParseIntegerError] {
    Int8.parse_radix(text, radix: 10)
  }
}

public fn Int8.parse_radix(text: StringSlice, radix: UInt32) -> Result[Int8, core::ParseIntegerError]
  requires 2 <= radix && radix <= 36
  cost time O(text.length())
{
  if text.length() > 0 && text.byte(0) == 45 {
    let magnitude = parse_magnitude(text, start: 1, radix: radix, limit: 128)?
    if magnitude == 0 {
      Ok(0)
    } else {
      let below: Int8 = intrinsic::convert(magnitude - 1)
      Ok(-below - 1)
    }
  } else {
    let start: USize = if text.length() > 0 && text.byte(0) == 43 { 1 } else { 0 }
    let magnitude = parse_magnitude(text, start: start, radix: radix, limit: 127)?
    Ok(intrinsic::convert(magnitude))
  }
}

public fn Int8.format(self, radix: UInt32 = 10, minimum_digits: USize = 1, uppercase: Bool = false) -> String
  requires 2 <= radix && radix <= 36
  cost time O(minimum_digits + Int8.bits)
{
  todo
}

