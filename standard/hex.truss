use standard::intrinsic

public type DecodeError =
  | InvalidCharacter(offset: USize)
  | OddLength
  derives Equal

impl Display for DecodeError {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      InvalidCharacter(offset) => {
        mut output.write("the byte at offset ")
        offset.display(mut output)
        mut output.write(" is not a hexadecimal digit")
      }
      OddLength => mut output.write("the text has an odd number of digits")
    }
  }
}

public fn encode(bytes: Slice[UInt8], uppercase: Bool = false) -> String
  ensures result.length() == 2 * bytes.length()
  cost time O(bytes.length())
  cost allocations <= 1
{
  if bytes.length() > USize.maximum / 2 {
    intrinsic::crash("a string cannot hold that many bytes".slice())
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(2 * bytes.length())
  for index in 0..bytes.length()
    invariant intrinsic::storage_length(output) == 2 * index
    invariant intrinsic::storage_capacity(output) == 2 * bytes.length()
  {
    let byte = bytes[index]
    intrinsic::storage_push(mut output, value: (byte / 16).digit_byte(uppercase: uppercase))
    intrinsic::storage_push(mut output, value: (byte % 16).digit_byte(uppercase: uppercase))
  }
  String(storage: own output)
}

public fn decode(text: StringSlice) -> Result[List[UInt8], DecodeError]
  ensures match result {
    Ok(bytes) => 2 * bytes.length() == text.length()
    Err(_) => true
  }
  cost time O(text.length())
  cost allocations <= 1
{
  if text.length() % 2 != 0 {
    return Err(DecodeError.OddLength)
  }
  var bytes: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(text.length() / 2)
  var index: USize = 0
  while index < text.length()
    invariant index <= text.length()
    invariant index % 2 == 0
    invariant 2 * intrinsic::storage_length(bytes) == index
    invariant intrinsic::storage_capacity(bytes) == text.length() / 2
    decreases text.length() - index
    cost time O(index)
    cost allocations == 0
  {
    let high = text.byte(index).digit_value()
    if high >= 16 {
      return Err(DecodeError.InvalidCharacter(offset: index))
    }
    let low = text.byte(index + 1).digit_value()
    if low >= 16 {
      return Err(DecodeError.InvalidCharacter(offset: index + 1))
    }
    intrinsic::storage_push(mut bytes, value: high * 16 + low)
    index += 2
  }
  Ok(List(storage: own bytes))
}

test "bytes encode as two hexadecimal digits each" {
  let bytes: List[UInt8] = [0, 1, 15, 16, 171, 255]
  assert encode(bytes) == "00010f10abff"
  assert encode(bytes, uppercase: true) == "00010F10ABFF"
  let none: List[UInt8] = []
  assert encode(none) == ""
}

test "hexadecimal text decodes to bytes, in either case" {
  assert decode("00010f10ABff") is Ok(bytes) && bytes.length() == 6 && bytes[2] == 15 && bytes[4] == 171
    && bytes[5] == 255
  assert decode("") is Ok(bytes) && bytes.length() == 0
}

test "decoding says what is wrong with text that is not hexadecimal" {
  assert decode("abc") == Err(DecodeError.OddLength)
  assert decode("ag") == Err(DecodeError.InvalidCharacter(offset: 1))
  assert decode("zz") == Err(DecodeError.InvalidCharacter(offset: 0))
  assert decode("00 1") == Err(DecodeError.InvalidCharacter(offset: 2))
  assert "${DecodeError.OddLength}" == "the text has an odd number of digits"
  assert "${DecodeError.InvalidCharacter(offset: 4)}" == "the byte at offset 4 is not a hexadecimal digit"
}

test "encoding and decoding undo each other" {
  let bytes: List[UInt8] = [222, 173, 190, 239]
  assert decode(encode(bytes)) is Ok(decoded) && decoded == bytes
}
