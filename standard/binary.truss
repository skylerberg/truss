public opaque type Encoder(bytes: List[UInt8])

public fn Encoder.new() -> Encoder
  ensures result.length() == 0
  cost time O(1)
  cost allocations == 0
{
  Encoder(bytes: [])
}

public fn Encoder.onto(bytes: own List[UInt8]) -> Encoder
  ensures result.length() == bytes.length()
  cost time O(1)
  cost allocations == 0
{
  Encoder(bytes: own bytes)
}

public fn Encoder.length(self) -> USize
  cost time O(1)
{
  self.bytes.length()
}

public fn Encoder.written(self) -> Slice[UInt8]
  cost time O(1)
{
  self.bytes.slice()
}

public fn Encoder.finish(own self) -> List[UInt8]
  cost time O(1)
  cost allocations == 0
{
  self.bytes
}

public fn Encoder.bytes(mut self, bytes: Slice[UInt8])
  ensures self.length() == old(self.length()) + bytes.length()
  cost amortized time O(bytes.length())
{
  todo
}

public fn Encoder.uint8(mut self, value: UInt8)
  ensures self.length() == old(self.length()) + 1
  cost amortized time O(1)
{
  todo
}

public fn Encoder.uint16(mut self, value: UInt16, order: ByteOrder = ByteOrder.BigEndian)
  ensures self.length() == old(self.length()) + 2
  cost amortized time O(1)
{
  todo
}

public fn Encoder.uint32(mut self, value: UInt32, order: ByteOrder = ByteOrder.BigEndian)
  ensures self.length() == old(self.length()) + 4
  cost amortized time O(1)
{
  todo
}

