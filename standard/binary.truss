  todo
}

public fn Encoder.int16(mut self, value: Int16, order: ByteOrder = ByteOrder.BigEndian)
  ensures self.length() == old(self.length()) + 2
  cost amortized time O(1)
{
  todo
}

public fn Encoder.int32(mut self, value: Int32, order: ByteOrder = ByteOrder.BigEndian)
  ensures self.length() == old(self.length()) + 4
  cost amortized time O(1)
{
  todo
