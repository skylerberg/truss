public type ByteOrder = BigEndian | LittleEndian
  derives Equal

public type DecodeError =
  | UnexpectedEnd(needed: USize, available: USize)
  | Overlong
  derives Equal

impl Display for DecodeError {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

public opaque type Decoder(bytes: Slice[UInt8], position: USize)

public fn Decoder.new(bytes: Slice[UInt8]) -> Decoder
  ensures result.position() == 0
  cost time O(1)
{
  Decoder(bytes: bytes, position: 0)
}

public fn Decoder.position(self) -> USize
  cost time O(1)
{
  self.position
}

public fn Decoder.remaining(self) -> Slice[UInt8]
  cost time O(1)
{
  todo
}

public fn Decoder.is_at_end(self) -> Bool
  cost time O(1)
{
  todo
}

public fn Decoder.skip(mut self, count: USize) -> Result[Unit, DecodeError]
  cost time O(1)
{
  todo
}

public fn Decoder.bytes(mut self, count: USize) -> Result[Slice[UInt8], DecodeError]
  ensures match result {
    Ok(taken) => taken.length() == count
    Err(_) => true
  }
  cost time O(1)
{
  todo
}

