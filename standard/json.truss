impl Display for Value {
  fn display(self, output: mut TextBuilder) {
    self.write(mut output)
  }
}

impl text::Parse for Value {
  type Error = ParseError

  fn parse(text: StringSlice) -> Result[Value, ParseError] {
    todo
  }
}

impl FromTemplate for Value {
  type Part = Value

  fn from_template(template: Template[Value]) -> Value
    requires is_valid_template(template.literals)
  {
    todo
  }
}

public fn is_valid_template(literals: Slice[text::Literal]) -> Bool
  cost time finite
{
  todo
}

impl From[Bool] for Value {
  fn from(value: own Bool) -> Value {
    Value.Bool(value)
  }
}

impl From[Int64] for Value {
  fn from(value: own Int64) -> Value {
    Value.Number(Number.from(value))
  }
}

impl From[String] for Value {
  fn from(value: own String) -> Value {
    Value.String(own value)
  }
}

impl From[StringSlice] for Value {
  fn from(value: own StringSlice) -> Value {
    Value.String(value.to_string())
  }
}

impl From[List[Value]] for Value {
  fn from(value: own List[Value]) -> Value {
    Value.Array(own value)
  }
}

impl From[Map[String, Value]] for Value {
  fn from(value: own Map[String, Value]) -> Value {
    Value.Object(own value)
  }
}

public type DecodeError(path: String, message: String)
  derives Equal

impl Display for DecodeError {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

public type Error =
  | Parse(error: ParseError)
  | Decode(error: DecodeError)
  derives Equal

impl Display for Error {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

public type ReadError =
  | System(error: SystemError)
  | Parse(error: ParseError)
  derives Equal

impl Display for ReadError {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

public trait Encode {
  fn to_json(self) -> Value
}

public trait Decode {
  fn from_json(value: Value) -> Result[Self, DecodeError]
}

public fn encode[Item: Encode](item: Item) -> String {
  todo
}

public fn encode_pretty[Item: Encode](item: Item, indent: USize = 2) -> String {
  todo
}

public fn decode[Item: Decode](text: StringSlice) -> Result[Item, Error] {
  todo
}

public fn Value.field[Field: Decode](self, name: StringSlice) -> Result[Field, DecodeError] {
  todo
}

public fn Value.optional_field[Field: Decode](self, name: StringSlice) -> Result[Option[Field], DecodeError] {
  todo
}

public fn read_from[Source: streams::Reader](source: mut Source, maximum_depth: USize = 128) -> Result[Value, ReadError]
  uses Handles
{
  todo
}

public fn write_to[Sink: streams::Writer](value: Value, sink: mut Sink) -> Result[Unit, SystemError]
  uses Handles
{
  todo
}

