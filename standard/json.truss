impl Encode for UInt64 {
  fn to_json(self) -> Value
  {
    match Int64.try_from(self) {
      Ok(integer) => Value.Number(value: Number.from(integer))
      Err(_) => match Number.from_float64(self.to_float64()) {
        Some(number) => Value.Number(value: number)
        None => Value.Null
      }
    }
  }
}

impl Decode for UInt64 {
  fn from_json(value: Value) -> Result[UInt64, DecodeError]
  {
    match UInt64.try_from(expect_integer(value)?) {
      Ok(number) => Ok(number)
      Err(_) => Err(type_mismatch("a number that fits `UInt64`"))
    }
  }
}

