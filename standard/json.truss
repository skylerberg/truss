  fn to_json(self) -> Value
  {
    match Number.from_float64(Float64.from(self)) {
      Some(number) => Value.Number(value: number)
      None => Value.Null
    }
  }
}

impl Decode for Float32 {
  fn from_json(value: Value) -> Result[Float32, DecodeError]
  {
    match value {
      Number(number) => Ok(number.to_float64().to_float32())
      _ => Err(type_mismatch("a number"))
    }
  }
}

impl Encode for Float64 {
  fn to_json(self) -> Value
  {
    match Number.from_float64(self) {
      Some(number) => Value.Number(value: number)
      None => Value.Null
    }
  }
}

impl Decode for Float64 {
  fn from_json(value: Value) -> Result[Float64, DecodeError]
  {
