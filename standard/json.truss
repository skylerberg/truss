impl Encode for String {
  fn to_json(self) -> Value
  {
    Value.String(value: self.copy())
  }
}

impl Decode for String {
  fn from_json(value: Value) -> Result[String, DecodeError]
  {
    match value {
      String(text) => Ok(text.copy())
      _ => Err(type_mismatch("a string"))
    }
  }
}

impl Encode for Value {
  fn to_json(self) -> Value
  {
    self.copy()
  }
}

impl Decode for Value {
  fn from_json(value: Value) -> Result[Value, DecodeError]
  {
    Ok(value.copy())
  }
}

impl Encode for List[Element: Encode] {
  fn to_json(self) -> Value
  {
    var items: List[Value] = List.with_capacity(self.length())
    for item in self {
      mut items.push(item.to_json())
    }
    Value.Array(items: own items)
  }
}

impl Decode for List[Element: Decode] {
  fn from_json(value: Value) -> Result[List[Element], DecodeError]
  {
    match value {
      Array(items) => {
        var decoded: List[Element] = List.with_capacity(items.length())
        for index in 0..items.length() {
          match Element.from_json(items[index]) {
            Ok(item) => mut decoded.push(own item)
            Err(error) => return Err(prefix_path(index.format().slice(), error: own error))
          }
        }
        Ok(own decoded)
      }
      _ => Err(type_mismatch("an array"))
    }
  }
}

impl Encode for Option[Inner: Encode] {
  fn to_json(self) -> Value
  {
    match self {
      Some(inner) => inner.to_json()
      None => Value.Null
    }
  }
}

impl Decode for Option[Inner: Decode] {
  fn from_json(value: Value) -> Result[Option[Inner], DecodeError]
  {
    if value.is_null() {
      return Ok(None)
    }
    match Inner.from_json(value) {
      Ok(inner) => Ok(Some(own inner))
      Err(error) => Err(own error)
    }
  }
}

impl Encode for Map[Key: Hash + Ordered + Display, Member: Encode] {
  fn to_json(self) -> Value
  {
    var members: Map[String, Value] = Map.with_capacity(self.length())
    for entry in self {
      mut members.insert("${entry.key}", value: entry.value.to_json())
    }
    Value.Object(members: own members)
  }
}

impl Decode for Map[Key: Hash + Ordered + text::Parse, Member: Decode] {
  fn from_json(value: Value) -> Result[Map[Key, Member], DecodeError]
  {
    match value {
      Object(members) => {
        var decoded: Map[Key, Member] = Map.with_capacity(members.length())
        for entry in members {
          match Key.parse(entry.key.slice()) {
            Ok(key) => match Member.from_json(entry.value) {
              Ok(member) => mut decoded.insert(own key, value: own member)
              Err(error) => return Err(prefix_path(entry.key.slice(), error: own error))
            }
            Err(_) => return Err(prefix_path(entry.key.slice(), error: type_mismatch("a key of the map's type")))
          }
        }
        Ok(own decoded)
      }
      _ => Err(type_mismatch("an object"))
    }
  }
}
