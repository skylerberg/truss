use standard::random

public opaque type Set[Element: Hash + Ordered](elements: List[Element])
  invariant forall i in 0..elements.length() => forall j in 0..elements.length() =>
    i < j ==> !(elements.model()[i] == elements.model()[j])
  derives Copyable

impl Model for Set[Element: Hash + Ordered] {
  type Value = FiniteSet[Element]

  fn model(self) -> FiniteSet[Element]
    cost time finite
  {
    self.elements.model().elements()
  }
}

public transparent fn contains_equal[Element: Equal](set: FiniteSet[Element], value: Element) -> Bool
  cost time finite
{
  exists other: Element => set.contains(other) && other == value
}

public transparent fn Set[Element: Hash + Ordered].length(self) -> USize
  ensures result == self.model().size()
  cost time O(1)
{
  self.elements.length()
}

internal fn Set[Element: Hash + Ordered].index_of(self, element: Element) -> USize
  ensures result <= self.elements.length()
  ensures result < self.elements.length() ==> self.elements.model()[result] == element
  ensures forall i in 0..self.elements.length() => i == result || !(self.elements.model()[i] == element)
  ensures (result < self.elements.length()) == contains_equal(self.model(), value: element)
  cost time O(self.elements.length() * time(Element.equal))
{
  var index: USize = 0
  var match_index = self.elements.length()
  while index < self.elements.length() && match_index == self.elements.length()
    invariant index <= self.elements.length()
    invariant match_index <= self.elements.length()
    invariant match_index < self.elements.length() ==> self.elements.model()[match_index] == element
    invariant match_index == self.elements.length() ==>
      forall i in 0..index => !(self.elements.model()[i] == element)
    decreases self.elements.length() - index
    cost time O(index * time(Element.equal))
  {
    if self.elements[index] == element {
      match_index = index
    }
    index += 1
  }
  proof {
    assert forall i in 0..self.elements.model().length() =>
      self.model().contains(self.elements.model()[i])
  }
  match_index
}

public fn Set[Element: Hash + Ordered].contains(self, element: Element) -> Bool
  ensures result == contains_equal(self.model(), value: element)
  cost time O(self.length() * time(Element.equal))
{
  var is_present = self.index_of(element) < self.elements.length()
  is_present
}

internal fn Set[Element: Hash + Ordered].insert_absent(mut self, element: own Element)
  requires !contains_equal(self.model(), value: element)
  ensures contains_equal(self.model(), value: element)
  ensures forall other: Element => old(self.model()).contains(other) ==> self.model().contains(other)
  ensures forall other: Element =>
    self.model().contains(other) ==> old(self.model()).contains(other) || identical(other, element)
  ensures self.elements.length() == old(self.elements.length()) + 1
  ensures forall i in 0..old(self.elements.length()) =>
    identical(self.elements.model()[i], old(self.elements.model())[i])
  ensures identical(self.elements.model()[old(self.elements.length())], element)
  ensures identical(
    self.elements.model(),
    old(self.elements.model()).append(self.elements.model()[old(self.elements.length())]),
  )
  cost time O(1 + old(self.elements.length()))
  cost amortized time O(1)
{
  let position = self.elements.length()
  proof {
    assert forall i in 0..self.elements.model().length() =>
      self.model().contains(self.elements.model()[i])
    assert forall i in 0..self.elements.model().length() => !(self.elements.model()[i] == element)
  }
  mut self.elements.push(own element)
  proof {
    assert forall i in 0..old(self.elements.model()).length() =>
      identical(self.elements.model()[i], old(self.elements.model())[i])
    assert self.elements.model().elements().contains(self.elements.model()[position])
  }
}

public fn Set[Element: Hash + Ordered].insert(mut self, element: own Element)
  ensures contains_equal(self.model(), value: element)
  ensures forall other: Element => old(self.model()).contains(other) ==> self.model().contains(other)
  ensures forall other: Element =>
    self.model().contains(other) ==> old(self.model()).contains(other) || identical(other, element)
  ensures contains_equal(old(self.model()), value: element) ==> identical(self.model(), old(self.model()))
  ensures self.length()
    == old(self.length()) + (if contains_equal(old(self.model()), value: element) { 0 } else { 1 })
  cost time O(1 + old(self.length()) * (1 + time(Element.equal)))
  cost amortized time O(1 + old(self.length()) * (1 + time(Element.equal)))
{
  if self.index_of(element) == self.elements.length() {
    mut self.insert_absent(own element)
  }
}

public fn Set[Element: Hash + Ordered].with_capacity(capacity: USize) -> Set[Element]
  ensures result.length() == 0
  ensures forall value: Element => !result.model().contains(value)
  cost time O(1)
{
  Set(elements: List.with_capacity(capacity))
}

public fn Set[Element: Hash + Ordered].seeded() -> Set[Element]
  uses Random
  ensures result.length() == 0
{
  Set(elements: [])
}

public fn Set[Element: Hash + Ordered].collect[Source: Cursor[Element = Element]](source: own Source) -> Set[Element]
  uses Source.Uses
{
  var set: Set[Element] = []
  mut set.extend(own source)
  set
}

public fn Set[Element: Hash + Ordered].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn Set[Element: Hash + Ordered].insert_new(mut self, element: own Element) -> Bool
  ensures self.contains(element)
  ensures result == !old(self.contains(element))
  cost time O(1 + old(self.length()) * (1 + time(Element.equal)))
  cost amortized time O(1 + old(self.length()) * (1 + time(Element.equal)))
{
  let is_new = self.index_of(element) == self.elements.length()
  if is_new {
    mut self.insert_absent(own element)
  }
  is_new
}

public fn Set[Element: Hash + Ordered].remove(mut self, element: Element)
  ensures !self.contains(element)
  cost time O(old(self.length()) * time(Element.equal))
{
  let position = self.index_of(element)
  if position < self.elements.length() {
    let _ = mut self.elements.remove_at(position)
  }
  proof {
    assert self.index_of(element) == self.elements.length()
  }
}

public fn Set[Element: Hash + Ordered].take(mut self, element: Element) -> Option[Element]
  ensures !self.contains(element)
  ensures (result is Some(_)) == old(self.contains(element))
  cost time O(old(self.length()) * time(Element.equal))
{
  let position = self.index_of(element)
  if position == self.elements.length() {
    return None
  }
  let removed_element = mut self.elements.remove_at(position)
  proof {
    assert self.index_of(element) == self.elements.length()
  }
  Some(own removed_element)
}

public fn Set[Element: Hash + Ordered].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
  cost allocations == 0
{
  mut self.elements.clear()
}

public fn Set[Element: Hash + Ordered].reserve(mut self, additional: USize)
  ensures identical(self.model(), old(self.model()))
  ensures self.length() == old(self.length())
{
  mut self.elements.reserve(additional)
}

public fn Set[Element: Hash + Ordered].retain(mut self, keep: (fn(Element) -> Bool cost time finite))
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(keep))
{
  let count = self.elements.length()
  var kept_count: USize = 0
  for index in 0..count
    invariant self.elements.length() == count
    invariant kept_count <= index
    invariant forall i in 0..self.elements.length() => forall j in 0..self.elements.length() =>
      i < j ==> !(self.elements.model()[i] == self.elements.model()[j])
  {
    if keep(self.elements[index]) {
      mut self.elements.swap(kept_count, second: index)
      kept_count += 1
    }
  }
  mut self.elements.truncate(kept_count)
}

public fn Set[Element: Hash + Ordered].extend[Source: Cursor[Element = Element]](mut self, elements: own Source)
  uses Source.Uses
{
  var cursor = own elements
  while mut cursor.next() is Some(element)
    invariant forall i in 0..self.elements.length() => forall j in 0..self.elements.length() =>
      i < j ==> !(self.elements.model()[i] == self.elements.model()[j])
  {
    mut self.insert(own element)
  }
}

public fn Set[Element: Hash + Ordered].remove_all(mut self, other: Set[Element])
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * (1 + other.length() * time(Element.equal)))
{
  let count = self.elements.length()
  var kept_count: USize = 0
  for index in 0..count
    invariant self.elements.length() == count
    invariant kept_count <= index
    invariant forall i in 0..self.elements.length() => forall j in 0..self.elements.length() =>
      i < j ==> !(self.elements.model()[i] == self.elements.model()[j])
  {
    if !other.contains(self.elements[index]) {
      mut self.elements.swap(kept_count, second: index)
      kept_count += 1
    }
  }
  mut self.elements.truncate(kept_count)
}

public fn Set[Element: Hash + Ordered].is_subset_of(self, other: Set[Element]) -> Bool
  ensures result == (forall value: Element =>
    self.model().contains(value) ==> contains_equal(other.model(), value: value))
  cost time O(self.length() * (1 + other.length() * time(Element.equal)))
{
  var index: USize = 0
  while index < self.elements.length()
    invariant index <= self.elements.length()
    invariant forall i in 0..index => contains_equal(other.model(), value: self.elements.model()[i])
    decreases self.elements.length() - index
    cost time O(index * (1 + other.length() * time(Element.equal)))
  {
    if !other.contains(self.elements[index]) {
      proof {
        assert self.model().contains(self.elements.model()[index])
      }
      return false
    }
    index += 1
  }
  true
}

public fn Set[Element: Hash + Ordered].is_superset_of(self, other: Set[Element]) -> Bool
  ensures result == (forall value: Element =>
    other.model().contains(value) ==> contains_equal(self.model(), value: value))
  cost time O(other.length() * (1 + self.length() * time(Element.equal)))
{
  other.is_subset_of(self)
}

public fn Set[Element: Hash + Ordered].is_disjoint_from(self, other: Set[Element]) -> Bool
  ensures result == (forall value: Element =>
    self.model().contains(value) ==> !contains_equal(other.model(), value: value))
  cost time O(self.length() * (1 + other.length() * time(Element.equal)))
{
  var index: USize = 0
  while index < self.elements.length()
    invariant index <= self.elements.length()
    invariant forall i in 0..index => !contains_equal(other.model(), value: self.elements.model()[i])
    decreases self.elements.length() - index
    cost time O(index * (1 + other.length() * time(Element.equal)))
  {
    if other.contains(self.elements[index]) {
      proof {
        assert self.model().contains(self.elements.model()[index])
      }
      return false
    }
    index += 1
  }
  true
}

public fn Set[Element: Hash + Ordered + Copyable].union(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length() + other.length()
{
  var union = self.copy()
  for index in 0..other.elements.length()
    invariant union.elements.length() <= self.elements.length() + index
    invariant forall i in 0..union.elements.length() => forall j in 0..union.elements.length() =>
      i < j ==> !(union.elements.model()[i] == union.elements.model()[j])
  {
    mut union.insert(other.elements[index].copy())
  }
  union
}

public fn Set[Element: Hash + Ordered + Copyable].intersection(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length()
{
  var intersection: Set[Element] = []
  for index in 0..self.elements.length()
    invariant intersection.elements.length() <= index
    invariant forall i in 0..intersection.elements.length() => forall j in 0..intersection.elements.length() =>
      i < j ==> !(intersection.elements.model()[i] == intersection.elements.model()[j])
  {
    if other.contains(self.elements[index]) {
      mut intersection.insert(self.elements[index].copy())
    }
  }
  intersection
}

public fn Set[Element: Hash + Ordered + Copyable].difference(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length()
{
  var difference: Set[Element] = []
  for index in 0..self.elements.length()
    invariant difference.elements.length() <= index
    invariant forall i in 0..difference.elements.length() => forall j in 0..difference.elements.length() =>
      i < j ==> !(difference.elements.model()[i] == difference.elements.model()[j])
  {
    if !other.contains(self.elements[index]) {
      mut difference.insert(self.elements[index].copy())
    }
  }
  difference
}

public fn Set[Element: Hash + Ordered + Copyable].symmetric_difference(self, other: Set[Element]) -> Set[Element]
  ensures result.length() <= self.length() + other.length()
{
  var symmetric_difference = self.difference(other)
  for index in 0..other.elements.length()
    invariant symmetric_difference.elements.length() <= self.elements.length() + index
    invariant forall i in 0..symmetric_difference.elements.length() => forall j in 0..symmetric_difference.elements.length() =>
      i < j ==> !(symmetric_difference.elements.model()[i] == symmetric_difference.elements.model()[j])
  {
    if !self.contains(other.elements[index]) {
      mut symmetric_difference.insert(other.elements[index].copy())
    }
  }
  symmetric_difference
}

impl Iterable for Set[Element: Hash + Ordered] {
  type Element = Element

  fn each(self) yields Element
    ensures finished ==> yielded.length() == self.length()
    cost time O(self.length())
  {
    var index: USize = 0
    while index < self.elements.length()
      invariant index <= self.elements.length()
      invariant yielded.length() == index
      decreases self.elements.length() - index
    {
      yield self.elements[index]
      index += 1
    }
  }
}

public fn Set[Element: Hash + Ordered].each(own self) yields own Element
  cost time O(self.length())
{
  for element in own self.elements {
    yield own element
  }
}

internal fn Set[Element: Hash + Ordered].elements_included_in(self, other: Set[Element]) -> Bool
  ensures result == (forall i in 0..self.elements.length() => exists j in 0..other.elements.length() =>
    self.elements.model()[i] == other.elements.model()[j])
  cost time O(self.elements.length() * (1 + other.elements.length() * time(Element.equal)))
{
  var index: USize = 0
  while index < self.elements.length()
    invariant index <= self.elements.length()
    invariant forall i in 0..index => exists j in 0..other.elements.length() =>
      self.elements.model()[i] == other.elements.model()[j]
    decreases self.elements.length() - index
    cost time O(index * (1 + other.elements.length() * time(Element.equal)))
  {
    if other.index_of(self.elements[index]) == other.elements.length() {
      return false
    }
    index += 1
  }
  true
}

impl Equal for Set[Element: Hash + Ordered] {
  fn equal(self, other: Set[Element]) -> Bool {
    self.elements.length() == other.elements.length() && self.elements_included_in(other) && other.elements_included_in(self)
  }
}

impl Hash for Set[Element: Hash + Ordered] {
  fn hash(self, hasher: mut Hasher) {
    var combined: UInt64 = 0
    for index in 0..self.elements.length() {
      var one = Hasher.new()
      self.elements[index].hash(mut one)
      combined = combined.wrapping_add(one.finish())
    }
    mut hasher.write(combined)
    mut hasher.write(UInt64.from(self.elements.length()))
  }
}

impl Default for Set[Element: Hash + Ordered] {
  fn default() -> Set[Element] {
    []
  }
}

impl From[List[Element]] for Set[Element: Hash + Ordered] {
  fn from(value: own List[Element]) -> Set[Element] {
    var set: Set[Element] = Set.with_capacity(value.length())
    for element in own value
      invariant forall i in 0..set.elements.length() => forall j in 0..set.elements.length() =>
      i < j ==> !(set.elements.model()[i] == set.elements.model()[j])
    {
      mut set.insert(own element)
    }
    set
  }
}

fn order(set: Set[Int64]) -> String {
  var text = ""
  for element in set {
    mut text.push("${element} ")
  }
  text
}

fn sample() -> Set[Int64] {
  [3, 1, 2]
}

test "a set holds each element once" {
  var seen: Set[String] = []
  assert seen.is_empty() && seen.length() == 0
  mut seen.insert("a")
  mut seen.insert("b")
  mut seen.insert("a")
  assert seen.length() == 2 && !seen.is_empty()
  assert seen.contains("a") && seen.contains("b") && !seen.contains("c")
  assert mut seen.insert_new("c")
  assert !mut seen.insert_new("c")
  assert seen.length() == 3
}

test "a set is walked in the order its elements were first inserted" {
  var numbers = sample()
  assert order(numbers) == "3 1 2 "
  mut numbers.insert(1)
  assert order(numbers) == "3 1 2 "
  mut numbers.remove(1)
  mut numbers.insert(1)
  assert order(numbers) == "3 2 1 "
  let repeated: Set[Int64] = [5, 4, 5, 4, 6]
  assert order(repeated) == "5 4 6 "
}

test "remove, take, clear, and retain take elements out of a set" {
  var numbers = sample()
  mut numbers.remove(9)
  assert numbers.length() == 3
  mut numbers.remove(3)
  assert numbers.length() == 2 && !numbers.contains(3)
  assert mut numbers.take(1) == Some(1)
  assert mut numbers.take(1) is None
  assert order(numbers) == "2 "
  var evens: Set[Int64] = [1, 2, 3, 4, 5, 6]
  mut evens.retain(fn(element) { element % 2 == 0 })
  assert order(evens) == "2 4 6 "
  mut evens.remove_all([4, 9, 2])
  assert order(evens) == "6 "
  mut evens.clear()
  assert evens.is_empty() && !evens.contains(6)
}

test "sets are compared as wholes" {
  let small: Set[Int64] = [1, 2]
  let large: Set[Int64] = [2, 3, 1]
  let other: Set[Int64] = [7, 8]
  let empty: Set[Int64] = []
  assert small.is_subset_of(large) && !large.is_subset_of(small)
  assert large.is_superset_of(small) && !small.is_superset_of(large)
  assert small.is_subset_of(small) && empty.is_subset_of(small)
  assert small.is_disjoint_from(other) && !small.is_disjoint_from(large) && empty.is_disjoint_from(empty)
  let same: Set[Int64] = [2, 1]
  assert small == same && small != large && small != other && empty == []
}

test "union, intersection, and the differences make new sets" {
  let first: Set[Int64] = [1, 2, 3]
  let second: Set[Int64] = [3, 4, 2]
  assert order(first.union(second)) == "1 2 3 4 "
  assert order(first.intersection(second)) == "2 3 "
  assert order(first.difference(second)) == "1 "
  assert order(second.difference(first)) == "4 "
  assert order(first.symmetric_difference(second)) == "1 4 "
  assert first.length() == 3 && second.length() == 3
}

test "a set is made from a list or a cursor, and gives its elements away" {
  let items: List[Int64] = [4, 4, 2, 4, 9]
  let numbers: Set[Int64] = Set.from(items.copy())
  assert order(numbers) == "4 2 9 "
  var collected: Set[Int64] = Set.collect(items.each())
  assert collected == numbers
  let more: List[Int64] = [9, 1]
  mut collected.extend(more.each())
  assert order(collected) == "4 2 9 1 "
  var sum: Int64 = 0
  for element in own collected {
    sum += element
  }
  assert sum == 16
}

test "equal sets hash alike, whatever order they were made in" {
  let first: Set[Int64] = [1, 2, 3]
  let second: Set[Int64] = [3, 1, 2]
  let third: Set[Int64] = [1, 2, 4]
  var one = Hasher.new()
  var two = Hasher.new()
  var three = Hasher.new()
  first.hash(mut one)
  second.hash(mut two)
  third.hash(mut three)
  assert one.finish() == two.finish() && one.finish() != three.finish()
}

test "a copy of a set changes on its own" {
  var numbers = sample()
  var copied = numbers.copy()
  mut copied.insert(10)
  mut numbers.reserve(50)
  assert numbers.length() == 3 && copied.length() == 4
  let roomy: Set[Int64] = Set.with_capacity(8)
  let fresh: Set[Int64] = Set.default()
  assert roomy.is_empty() && roomy == fresh
}

test "a seeded set starts empty and holds what is put in it" {
  provide random::SeededRandom.new(11) {
    var seeded: Set[Int64] = Set.seeded()
    assert seeded.is_empty()
    mut seeded.insert(4)
    assert seeded.contains(4) && seeded.length() == 1
  }
}
