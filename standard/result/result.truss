public type Result[Value, Error] =
  | Ok(value: Value)
  | Err(error: Error)
  derives Equal, Hash, Ordered

public fn Result[Value, Error].is_ok(self) -> Bool
  ensures result == (self is Ok(_))
  cost time O(1)
{
  self is Ok(_)
}

public fn Result[Value, Error].is_err(self) -> Bool
  ensures result == (self is Err(_))
  cost time O(1)
{
  self is Err(_)
}

public fn Result[Value, Error].ok(own self) -> Option[Value]
  cost time O(1)
{
  match own self {
    Ok(value) => Some(own value)
    Err(_) => None
  }
}

public fn Result[Value, Error].err(own self) -> Option[Error]
  cost time O(1)
{
  match own self {
    Ok(_) => None
    Err(error) => Some(own error)
  }
}

public fn Result[Value, Error].map[Output](
  own self,
  transform: (fn(own Value) -> Output uses generic Granted),
) -> Result[Output, Error]
  uses generic Granted
  cost time O(time(transform))
  cost allocations <= allocations(transform)
  cost allocated_bytes <= allocated_bytes(transform)
{
  match own self {
    Ok(value) => Ok(transform(own value))
    Err(error) => Err(own error)
  }
}

public fn Result[Value, Error].map_error[Other](
  own self,
  transform: (fn(own Error) -> Other uses generic Granted),
) -> Result[Value, Other]
  uses generic Granted
  cost time O(time(transform))
  cost allocations <= allocations(transform)
  cost allocated_bytes <= allocated_bytes(transform)
{
  match own self {
    Ok(value) => Ok(own value)
    Err(error) => Err(transform(own error))
  }
}

public fn Result[Value, Error].and_then[Output](
  own self,
  next: (fn(own Value) -> Result[Output, Error] uses generic Granted),
) -> Result[Output, Error]
  uses generic Granted
  cost time O(time(next))
  cost allocations <= allocations(next)
  cost allocated_bytes <= allocated_bytes(next)
{
  match own self {
    Ok(value) => next(own value)
    Err(error) => Err(own error)
  }
}

public fn Result[Value, Error].or_else[Other](
  own self,
  recover: (fn(own Error) -> Result[Value, Other] uses generic Granted),
) -> Result[Value, Other]
  uses generic Granted
  cost time O(time(recover))
  cost allocations <= allocations(recover)
  cost allocated_bytes <= allocated_bytes(recover)
{
  match own self {
    Ok(value) => Ok(own value)
    Err(error) => recover(own error)
  }
}

public fn Result[Value, Error].unwrap_or(own self, default: own Value) -> Value
  ensures !(self is Ok(held) && !identical(result, held))
  ensures !(self is Err(_) && !identical(result, default))
  cost time O(1)
{
  match own self {
    Ok(value) => value
    Err(_) => default
  }
}

public fn Result[Value, Error].unwrap_or_else(
  own self,
  recover: (fn(own Error) -> Value uses generic Granted),
) -> Value
  uses generic Granted
  cost time O(time(recover))
  cost allocations <= allocations(recover)
  cost allocated_bytes <= allocated_bytes(recover)
{
  match own self {
    Ok(value) => value
    Err(error) => recover(own error)
  }
}

public fn Result[Value, Error].expect(own self, message: StringSlice) -> Value
  uses Panic unless self is Ok(_)
  ensures self is Ok(held) && identical(result, held)
  cost time O(1)
{
  match own self {
    Ok(value) => value
    Err(_) => Panic.crash(message)
  }
}
