use standard::cryptography
use standard::hex
use standard::intrinsic
use standard::random
use standard::text

public opaque type Uuid(high: UInt64, low: UInt64)
  derives Plain, Equal, Hash, Ordered

public let Uuid.nil: Uuid = Uuid(high: 0, low: 0)

public type ParseError =
  | InvalidLength
  | InvalidCharacter(offset: USize)
  derives Equal

impl Display for ParseError {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      InvalidLength => mut output.write("a UUID is 32 hexadecimal digits, or 36 characters with its hyphens")
      InvalidCharacter(offset) => {
        mut output.write("the text is not a UUID at offset ")
        offset.display(mut output)
      }
    }
  }
}

public fn random() -> Uuid
  uses Random
{
  let high = (Random.next() & 0xffff_ffff_ffff_0fff) | 0x4000
  let low = (Random.next() & 0x3fff_ffff_ffff_ffff) | 0x8000_0000_0000_0000
  Uuid(high: high, low: low)
}

public fn time_ordered() -> Uuid
  uses Random, Clock
{
  let now = Clock.now().unix_milliseconds()
  let milliseconds: UInt64 = if now < 0 { 0 } else { intrinsic::convert(now) }
  let high = ((milliseconds % 0x1_0000_0000_0000) << 16) | 0x7000 | (Random.next() & 0x0fff)
  let low = (Random.next() & 0x3fff_ffff_ffff_ffff) | 0x8000_0000_0000_0000
  Uuid(high: high, low: low)
}

public fn from_name(namespace: Uuid, name: Slice[UInt8]) -> Uuid
  cost time O(name.length())
{
  let prefix = namespace.bytes()
  var hasher = cryptography::Sha1.new()
  mut hasher.update(prefix.slice())
  mut hasher.update(name)
  let digest = own hasher.finish()
  let high = UInt64.from_big_endian_bytes(
    [digest[0], digest[1], digest[2], digest[3], digest[4], digest[5], digest[6], digest[7]],
  )
  let low = UInt64.from_big_endian_bytes(
    [digest[8], digest[9], digest[10], digest[11], digest[12], digest[13], digest[14], digest[15]],
  )
  Uuid(high: (high & 0xffff_ffff_ffff_0fff) | 0x5000, low: (low & 0x3fff_ffff_ffff_ffff) | 0x8000_0000_0000_0000)
}

public fn Uuid.from_bytes(bytes: Array[UInt8, 16]) -> Uuid
  cost time O(1)
{
  Uuid(
    high: UInt64.from_big_endian_bytes([bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5], bytes[6], bytes[7]]),
    low: UInt64.from_big_endian_bytes([bytes[8], bytes[9], bytes[10], bytes[11], bytes[12], bytes[13], bytes[14], bytes[15]]),
  )
}

public fn Uuid.bytes(self) -> Array[UInt8, 16]
  cost time O(1)
{
  let high = self.high.to_big_endian_bytes()
  let low = self.low.to_big_endian_bytes()
  [
    high[0], high[1], high[2], high[3], high[4], high[5], high[6], high[7],
    low[0], low[1], low[2], low[3], low[4], low[5], low[6], low[7],
  ]
}

public fn Uuid.version(self) -> UInt8
  ensures result < 16
  cost time O(1)
{
  intrinsic::convert((self.high >> 12) % 16)
}

public fn Uuid.is_nil(self) -> Bool
  cost time O(1)
{
  self == Uuid.nil
}

impl Display for Uuid {
  fn display(self, output: mut TextBuilder)
  {
    let bytes = self.bytes()
    let digits = hex::encode(bytes[..])
    let text = digits.slice()
    mut output.write(text.part(0, to: 8))
    mut output.write("-")
    mut output.write(text.part(8, to: 12))
    mut output.write("-")
    mut output.write(text.part(12, to: 16))
    mut output.write("-")
    mut output.write(text.part(16, to: 20))
    mut output.write("-")
    mut output.write(text.part(20, to: 32))
  }
}

internal fn is_hyphen_place(index: USize) -> Bool
  cost time O(1)
{
  index == 8 || index == 13 || index == 18 || index == 23
}

impl text::Parse for Uuid {
  type Error = ParseError

  fn parse(text: StringSlice) -> Result[Uuid, ParseError]
  {
    let hyphenated = text.length() == 36
    if !hyphenated && text.length() != 32 {
      return Err(ParseError.InvalidLength)
    }
    var high: UInt64 = 0
    var low: UInt64 = 0
    var digits: USize = 0
    for index in 0..text.length()
      invariant digits <= index
    {
      let byte = text.byte(index)
      if hyphenated && is_hyphen_place(index) {
        if byte != 45 {
          return Err(ParseError.InvalidCharacter(offset: index))
        }
      } else {
        let value: UInt64 = intrinsic::convert(byte.digit_value())
        if value >= 16 {
          return Err(ParseError.InvalidCharacter(offset: index))
        }
        if digits < 16 {
          high = (high << 4) | value
        } else {
          low = (low << 4) | value
        }
        digits += 1
      }
    }
    Ok(Uuid(high: high, low: low))
  }
}

fn same_bytes(actual: Slice[UInt8], expected: Slice[UInt8]) -> Bool {
  if actual.length() != expected.length() {
    return false
  }
  for index in 0..actual.length() {
    if actual[index] != expected[index] {
      return false
    }
  }
  true
}


type FixedClock(milliseconds: Int64)

impl Clock for FixedClock {
  fn now(self) -> Instant {
    match Instant.from_unix_milliseconds(self.milliseconds) {
      Some(instant) => instant
      None => Instant.from_unix_nanoseconds(0)
    }
  }

  fn monotonic(self) -> Duration {
    Duration.milliseconds(0)
  }

  fn sleep(mut self, duration: Duration) {
    self.milliseconds += duration.total_milliseconds()
  }
}

test "a random UUID and a time-ordered UUID say their version" {
  provide random::SeededRandom.new(7) {
    let uuid_value = random()
    assert uuid_value.version() == 4
    assert "${uuid_value}" == "b358faf7-4ef9-465a-875c-3d964f482cd2"
    assert !uuid_value.is_nil()
  }
  provide random::SeededRandom.new(7) {
    provide FixedClock(milliseconds: 1700000000000) {
      let uuid_value = time_ordered()
      assert uuid_value.version() == 7
      assert "${uuid_value}" == "018bcfe5-6800-765a-875c-3d964f482cd2"
    }
  }
}

test "a UUID is sixteen bytes, displayed in five groups" {
  let bytes: Array[UInt8, 16] = [0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255]
  let uuid_value = Uuid.from_bytes(bytes)
  assert "${uuid_value}" == "00112233-4455-6677-8899-aabbccddeeff"
  assert same_bytes(uuid_value.bytes()[..], expected: bytes[..])
  assert uuid_value.version() == 6
  assert "${Uuid.nil}" == "00000000-0000-0000-0000-000000000000"
  assert Uuid.nil.is_nil()
}

test "a UUID is read with its hyphens or without, in either case" {
  let expected = Uuid.from_bytes([0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255])
  assert Uuid.parse("00112233-4455-6677-8899-aabbccddeeff") == Ok(expected)
  assert Uuid.parse("00112233445566778899AABBCCDDEEFF") == Ok(expected)
  assert Uuid.parse("00112233-4455-6677-8899-aabbccddeef") == Err(ParseError.InvalidLength)
  assert Uuid.parse("") == Err(ParseError.InvalidLength)
  assert Uuid.parse("00112233-4455-6677-8899-aabbccddeefg") == Err(ParseError.InvalidCharacter(offset: 35))
  assert Uuid.parse("00112233+4455-6677-8899-aabbccddeeff") == Err(ParseError.InvalidCharacter(offset: 8))
  assert Uuid.parse("0011223-34455-6677-8899-aabbccddeeff") == Err(ParseError.InvalidCharacter(offset: 7))
  assert Uuid.parse("0011223344556677-899AABBCCDDEEFF") == Err(ParseError.InvalidCharacter(offset: 16))
  assert "${ParseError.InvalidCharacter(offset: 8)}" == "the text is not a UUID at offset 8"
}

test "a UUID made from a name is the same every time, and says it is version 5" {
  assert Uuid.parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8") is Ok(namespace)
    && "${from_name(namespace, name: "example.com".bytes())}" == "cfbff0d1-9375-5685-968c-48ce8b15ae17"
    && from_name(namespace, name: "example.com".bytes()).version() == 5
  assert Uuid.parse("6ba7b811-9dad-11d1-80b4-00c04fd430c8") is Ok(namespace)
    && "${from_name(namespace, name: "https://example.com/a".bytes())}" == "6639460f-3425-5329-8097-a58f06127860"
  assert "${from_name(Uuid.nil, name: "".bytes())}" == "e129f27c-5103-5c5c-844b-cdf0a15e160d"
}
