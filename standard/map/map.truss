use standard::core
use standard::list

public opaque type Map[Key: Hash + Ordered, Value](entries: List[Entry[Key, Value]])
  invariant forall i in 0..entries.length() => forall j in 0..entries.length() =>
    i < j ==> !(entries.model()[i].key == entries.model()[j].key)
  derives Copyable

public type Entry[Key, Value](key: Key, value: Value)

internal fn entries_model[Key, Value](entries: Sequence[Entry[Key, Value]]) -> FiniteMap[Key, Value]
  ensures identical(result, entries.to_map(fn(entry) { entry.key }, value: fn(entry) { entry.value }))
  cost time finite
{
  entries.to_map(fn(entry) { entry.key }, value: fn(entry) { entry.value })
}

impl Model for Map[Key: Hash + Ordered, Value] {
  type Value = FiniteMap[Key, Value]

  fn model(self) -> FiniteMap[Key, Value]
    cost time finite
  {
    entries_model(self.entries.model())
  }
}

public fn contains_equal_key[Key: Equal, Value](map: FiniteMap[Key, Value], key: Key) -> Bool
  ensures result == (exists other: Key => map.contains_key(other) && other == key)
  cost time finite
{
  exists other: Key => map.contains_key(other) && other == key
}

public fn Map[Key: Hash + Ordered, Value].length(self) -> USize
  ensures result == self.model().size()
  ensures result == (self.entries.length())
  cost time O(1)
{
  self.entries.length()
}

internal fn Map[Key: Hash + Ordered, Value].index_of(self, key: Key) -> USize
  ensures result <= self.entries.length()
  ensures result < self.entries.length() ==> self.entries.model()[result].key == key
  ensures forall i in 0..self.entries.length() => i == result || !(self.entries.model()[i].key == key)
  ensures (result < self.entries.length()) == contains_equal_key(self.model(), key: key)
  cost time O(self.entries.length() * time(Key.equal))
{
  var index: USize = 0
  var match_index = self.entries.length()
  while index < self.entries.length() && match_index == self.entries.length()
    invariant index <= self.entries.length()
    invariant match_index <= self.entries.length()
    invariant match_index < self.entries.length() ==> self.entries.model()[match_index].key == key
    invariant match_index == self.entries.length() ==>
      forall i in 0..index => !(self.entries.model()[i].key == key)
    decreases self.entries.length() - index
    cost time O(index * time(Key.equal))
  {
    if self.entries[index].key == key {
      match_index = index
    }
    index += 1
  }
  proof {
    assert identical(self.model(), entries_model(self.entries.model()))
    assert forall i in 0..self.entries.model().length() =>
      self.model().contains_key(self.entries.model()[i].key)
  }
  match_index
}

internal fn exchange[Value](place: mut Value, value: own Value) -> Value
  ensures identical(place, value)
  ensures identical(result, old(place))
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  let previous = own place
  place = own value
  previous
}

internal fn Map[Key: Hash + Ordered, Value].replace_value_at(mut self, position: USize, value: own Value) -> Value
  requires position < self.entries.length()
  ensures self.entries.length() == old(self.entries.length())
  ensures identical(result, old(self.entries.model())[position].value)
  ensures identical(self.entries.model()[position].value, value)
  ensures forall i in 0..self.entries.length() =>
    identical(self.entries.model()[i].key, old(self.entries.model())[i].key)
  ensures forall i in 0..self.entries.length() =>
    i == position || identical(self.entries.model()[i], old(self.entries.model())[i])
  ensures identical(self.model().get(old(self.entries.model())[position].key), value)
  ensures forall other: Key => self.model().contains_key(other) == old(self.model()).contains_key(other)
  ensures forall other: Key =>
    old(self.model()).contains_key(other) && !identical(other, old(self.entries.model())[position].key) ==>
      identical(self.model().get(other), old(self.model()).get(other))
  ensures identical(
    self.entries.model(),
    old(self.entries.model()).update(position, value: self.entries.model()[position]),
  )
  cost time O(1)
  cost amortized time O(1)
  cost allocations == 0
{
  proof {
    assert identical(self.model(), entries_model(self.entries.model()))
  }
  let previous = exchange(mut self.entries[position].value, value: own value)
  proof {
    assert identical(
      self.entries.model(),
      old(self.entries.model()).update(position, value: self.entries.model()[position]),
    )
    assert identical(self.model(), entries_model(self.entries.model()))
    assert forall i in 0..self.entries.length() =>
      identical(self.entries.model()[i].key, old(self.entries.model())[i].key)
    assert forall i in 0..self.entries.length() =>
      i == position || identical(self.entries.model()[i], old(self.entries.model())[i])
    assert forall i in 0..old(self.entries.model()).length() =>
      entries_model(self.entries.model()).contains_key(old(self.entries.model())[i].key)
    assert forall j in 0..self.entries.model().length() =>
      entries_model(old(self.entries.model())).contains_key(self.entries.model()[j].key)
    assert forall i in 0..self.entries.model().length() =>
      forall j in 0..self.entries.model().length() =>
        i == j || !identical(self.entries.model()[i].key, self.entries.model()[j].key)
    assert forall i in 0..old(self.entries.model()).length() =>
      forall j in 0..old(self.entries.model()).length() =>
        i == j || !identical(old(self.entries.model())[i].key, old(self.entries.model())[j].key)
    assert forall other: Key =>
      entries_model(self.entries.model()).contains_key(other)
        == entries_model(old(self.entries.model())).contains_key(other)
    assert forall other: Key =>
      old(self.model()).contains_key(other) && !identical(other, old(self.entries.model())[position].key) ==>
        identical(self.model().get(other), old(self.model()).get(other))
  }
  previous
}

public fn Map[Key: Hash + Ordered, Value].contains(self, key: Key) -> Bool
  ensures result == contains_equal_key(self.model(), key: key)
  cost time O(self.length() * time(Key.equal))
{
  self.index_of(key) < self.entries.length()
}

public fn Map[Key: Hash + Ordered, Value].insert(mut self, key: own Key, value: own Value)
  ensures exists other: Key =>
    self.model().contains_key(other) && other == key && identical(self.model().get(other), value)
  ensures forall other: Key =>
    !(other == key) ==> self.model().contains_key(other) == old(self.model()).contains_key(other)
  ensures forall other: Key =>
    !(other == key) && old(self.model()).contains_key(other) ==>
      identical(self.model().get(other), old(self.model()).get(other))
  ensures self.length()
    == old(self.length()) + (if contains_equal_key(old(self.model()), key: key) { 0 } else { 1 })
  ensures self.contains(key)
  cost time O(1 + old(self.length()) * (1 + time(Key.equal)))
  cost amortized time O(1 + old(self.length()) * (1 + time(Key.equal)))
{
  let position = self.index_of(key)
  if position < self.entries.length() {
    let _ = mut self.replace_value_at(position, value: own value)
  } else {
    mut self.push_entry(own key, value: own value)
  }
}

internal fn Map[Key: Hash + Ordered, Value].insert_absent(mut self, key: own Key, value: own Value)
  requires !contains_equal_key(self.model(), key: key)
  ensures exists other: Key =>
    self.model().contains_key(other) && other == key && identical(self.model().get(other), value)
  ensures forall other: Key =>
    !(other == key) ==> self.model().contains_key(other) == old(self.model()).contains_key(other)
  ensures forall other: Key =>
    !(other == key) && old(self.model()).contains_key(other) ==>
      identical(self.model().get(other), old(self.model()).get(other))
  ensures self.length() == old(self.length()) + 1
  cost time O(1 + old(self.length()))
  cost amortized time O(1)
{
  mut self.push_entry(own key, value: own value)
}

internal fn Map[Key: Hash + Ordered, Value].push_entry(mut self, key: own Key, value: own Value)
  requires !contains_equal_key(self.model(), key: key)
  ensures exists other: Key =>
    self.model().contains_key(other) && other == key && identical(self.model().get(other), value)
  ensures forall other: Key =>
    !(other == key) ==> self.model().contains_key(other) == old(self.model()).contains_key(other)
  ensures forall other: Key =>
    !(other == key) && old(self.model()).contains_key(other) ==>
      identical(self.model().get(other), old(self.model()).get(other))
  ensures self.entries.length() == old(self.entries.length()) + 1
  ensures forall i in 0..old(self.entries.length()) =>
    identical(self.entries.model()[i], old(self.entries.model())[i])
  ensures identical(self.entries.model()[old(self.entries.length())].key, key)
  ensures identical(self.entries.model()[old(self.entries.length())].value, value)
  ensures identical(
    self.entries.model(),
    old(self.entries.model()).append(self.entries.model()[old(self.entries.length())]),
  )
  cost time O(1 + old(self.entries.length()))
  cost amortized time O(1)
{
  let position = self.entries.length()
  proof {
    assert identical(self.model(), entries_model(self.entries.model()))
    assert forall i in 0..self.entries.model().length() =>
      self.model().contains_key(self.entries.model()[i].key)
    assert forall i in 0..self.entries.model().length() => !(self.entries.model()[i].key == key)
  }
  mut self.entries.push(Entry(key: own key, value: own value))
  proof {
    assert identical(self.model(), entries_model(self.entries.model()))
    assert forall i in 0..old(self.entries.model()).length() =>
      identical(self.entries.model()[i], old(self.entries.model())[i])
    assert forall i in 0..old(self.entries.model()).length() =>
      entries_model(self.entries.model()).contains_key(old(self.entries.model())[i].key)
    assert forall i in 0..old(self.entries.model()).length() =>
      entries_model(old(self.entries.model())).contains_key(old(self.entries.model())[i].key)
    assert forall j in 0..self.entries.model().length() =>
      j == position || entries_model(old(self.entries.model())).contains_key(self.entries.model()[j].key)
    assert forall i in 0..self.entries.model().length() =>
      forall j in 0..self.entries.model().length() =>
        i == j || !identical(self.entries.model()[i].key, self.entries.model()[j].key)
    assert forall i in 0..old(self.entries.model()).length() =>
      forall j in 0..old(self.entries.model()).length() =>
        i == j || !identical(old(self.entries.model())[i].key, old(self.entries.model())[j].key)
    assert forall other: Key =>
      !(other == key) ==> self.model().contains_key(other) == old(self.model()).contains_key(other)
    assert forall other: Key =>
      !(other == key) && old(self.model()).contains_key(other) ==>
        identical(self.model().get(other), old(self.model()).get(other))
  }
}

internal fn Map[Key: Hash + Ordered, Value].find_or_insert(mut self, key: own Key, default: own Value) -> USize
  ensures result < self.entries.length()
  ensures self.entries.model()[result].key == key
  ensures contains_equal_key(self.model(), key: key)
  ensures self.entries.length() == old(self.entries.length()) ==>
    identical(self.entries.model(), old(self.entries.model()))
  ensures self.entries.length() == old(self.entries.length())
    || (self.entries.length() == old(self.entries.length()) + 1
      && identical(
        self.entries.model(),
        old(self.entries.model()).append(self.entries.model()[old(self.entries.length())]),
      ))
  cost time O(1 + old(self.length()) * (1 + time(Key.equal)))
  cost amortized time O(1 + old(self.length()) * (1 + time(Key.equal)))
{
  let position = self.index_of(key)
  if position == self.entries.length() {
    mut self.push_entry(own key, value: own default)
  }
  position
}

public fn Map[Key: Hash + Ordered, Value].with_capacity(capacity: USize) -> Map[Key, Value]
  ensures result.length() == 0
  ensures forall key: Key => !result.model().contains_key(key)
  cost time O(1)
{
  Map(entries: List.with_capacity(capacity))
}

public fn Map[Key: Hash + Ordered, Value].seeded() -> Map[Key, Value]
  uses Random
  ensures result.length() == 0
{
  Map(entries: [])
}

public fn Map[Key: Hash + Ordered, Value].collect[Source: Cursor[Element = Entry[Key, Value]]](
  source: own Source,
) -> Map[Key, Value]
  uses Source.Uses
{
  var map: Map[Key, Value] = [:]
  mut map.extend(own source)
  map
}

public fn Map[Key: Hash + Ordered, Value].is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn Map[Key: Hash + Ordered, Value].get(self, key: Key) lends Option[Value]
  ensures (result is Some(_)) == self.contains(key)
  cost time O(self.length() * time(Key.equal))
{
  let position = self.index_of(key)
  if position < self.entries.length() {
    Some(self.entries[position].value)
  } else {
    None
  }
}

public fn Map[Key: Hash + Ordered, Value].replace(mut self, key: own Key, value: own Value) -> Option[Value]
  ensures self.contains(key)
  ensures (result is Some(_)) == old(self.contains(key))
  cost time O(1 + old(self.length()) * (1 + time(Key.equal)))
  cost amortized time O(1 + old(self.length()) * (1 + time(Key.equal)))
{
  let position = self.index_of(key)
  if position < self.entries.length() {
    Some(mut self.replace_value_at(position, value: own value))
  } else {
    mut self.push_entry(own key, value: own value)
    None
  }
}

public fn Map[Key: Hash + Ordered, Value].get_or_insert(mut self, key: own Key, default: own Value) lends mut Value
  cost time O(1 + old(self.length()) * (1 + time(Key.equal)))
{
  let position = mut self.find_or_insert(own key, default: own default)
  mut self.entries[position].value
}

public fn Map[Key: Hash + Ordered, Value].update[capability Granted](
  mut self,
  key: own Key,
  default: own Value,
  change: (fn(mut Value) uses Granted cost time finite),
)
  uses Granted
  ensures self.contains(key)
  cost calls(change) == 1
  cost time O(1 + old(self.length()) * (1 + time(Key.equal)) + time(change))
{
  let position = mut self.find_or_insert(own key, default: own default)
  change(mut self.entries[position].value)
}

public fn Map[Key: Hash + Ordered, Value].remove(mut self, key: Key)
  ensures !self.contains(key)
  cost time O(old(self.length()) * time(Key.equal))
{
  let position = self.index_of(key)
  if position < self.entries.length() {
    let _ = mut self.entries.remove_at(position)
  }
  proof {
    assert self.index_of(key) == self.entries.length()
  }
}

public fn Map[Key: Hash + Ordered, Value].take(mut self, key: Key) -> Option[Value]
  ensures !self.contains(key)
  ensures (result is Some(_)) == old(self.contains(key))
  cost time O(old(self.length()) * time(Key.equal))
{
  let position = self.index_of(key)
  if position == self.entries.length() {
    return None
  }
  let removed_entry = mut self.entries.remove_at(position)
  proof {
    assert self.index_of(key) == self.entries.length()
  }
  Some(own removed_entry.value)
}

public fn Map[Key: Hash + Ordered, Value].clear(mut self)
  ensures self.length() == 0
  cost time O(old(self.length()))
  cost allocations == 0
{
  mut self.entries.clear()
}

public fn Map[Key: Hash + Ordered, Value].reserve(mut self, additional: USize)
  ensures identical(self.model(), old(self.model()))
  ensures self.length() == old(self.length())
{
  mut self.entries.reserve(additional)
}

public fn Map[Key: Hash + Ordered, Value].retain(
  mut self,
  keep: (fn(Entry[Key, Value]) -> Bool cost time finite),
)
  ensures self.length() <= old(self.length())
  cost time O(old(self.length()) * time(keep))
{
  let count = self.entries.length()
  var kept_count: USize = 0
  for index in 0..count
    invariant self.entries.length() == count
    invariant kept_count <= index
    invariant forall i in 0..self.entries.length() => forall j in 0..self.entries.length() =>
      i < j ==> !(self.entries.model()[i].key == self.entries.model()[j].key)
  {
    if keep(self.entries[index]) {
      mut self.entries.swap(kept_count, second: index)
      kept_count += 1
    }
  }
  mut self.entries.truncate(kept_count)
}

public fn Map[Key: Hash + Ordered, Value].extend[Source: Cursor[Element = Entry[Key, Value]]](
  mut self,
  entries: own Source,
)
  uses Source.Uses
{
  var cursor = own entries
  while mut cursor.next() is Some(entry)
    invariant forall i in 0..self.entries.length() => forall j in 0..self.entries.length() =>
      i < j ==> !(self.entries.model()[i].key == self.entries.model()[j].key)
  {
    mut self.insert(own entry.key, value: own entry.value)
  }
}

impl Index for Map[Key: Hash + Ordered, Value] {
  type Key = Key
  type Output = Value

  fn contains_key(self, key: Key) -> Bool
    ensures result == self.contains(key)
    cost time finite
  {
    self.contains(key)
  }

  fn at(self, key: Key) lends Value
    requires self.contains(key)
    cost time O(self.length() * time(Key.equal))
  {
    self.entries[self.index_of(key)].value
  }

  fn at(mut self, key: Key) lends mut Value
    requires self.contains(key)
    cost time O(self.length() * time(Key.equal))
  {
    let position = self.index_of(key)
    mut self.entries[position].value
  }
}

impl core::IndexAssign for Map[Key: Hash + Ordered, Value] {
  fn assign(mut self, key: own Key, value: own Value)
    ensures exists other: Key =>
      self.model().contains_key(other) && other == key && identical(self.model().get(other), value)
    ensures forall other: Key =>
      !(other == key) ==> self.model().contains_key(other) == old(self.model()).contains_key(other)
    ensures forall other: Key =>
      !(other == key) && old(self.model()).contains_key(other) ==>
        identical(self.model().get(other), old(self.model()).get(other))
    ensures self.length()
      == old(self.length()) + (if contains_equal_key(old(self.model()), key: key) { 0 } else { 1 })
    ensures self.contains(key)
    cost time O(1 + old(self.length()) * (1 + time(Key.equal)))
  {
    mut self.insert(own key, value: own value)
  }
}

impl Iterable for Map[Key: Hash + Ordered, Value] {
  type Element = Entry[Key, Value]

  fn count(self) -> USize
    ensures result == self.length()
    cost time O(1)
  {
    self.entries.length()
  }

  fn element(self, position: USize) lends Entry[Key, Value]
    requires position < self.count()
    cost time O(1)
  {
    self.entries[position]
  }
}

public fn Map[Key: Hash + Ordered, Value].cursor(own self) -> list::ListCursor[Entry[Key, Value]]
  ensures result.remaining() == self.length()
  cost time O(self.length())
  cost amortized time O(self.length())
{
  own self.entries.cursor()
}

public type Keys[Key, Value](entries: Slice[Entry[Key, Value]])

impl Iterable for Keys[Key, Value] {
  type Element = Key

  fn count(self) -> USize
    ensures result == self.entries.length()
    cost time O(1)
  {
    self.entries.length()
  }

  fn element(self, position: USize) lends Key
    requires position < self.count()
    ensures identical(result, self.entries.model()[position].key)
    cost time O(1)
  {
    self.entries[position].key
  }
}

public type Values[Key, Value](entries: Slice[Entry[Key, Value]])

impl Iterable for Values[Key, Value] {
  type Element = Value

  fn count(self) -> USize
    ensures result == self.entries.length()
    cost time O(1)
  {
    self.entries.length()
  }

  fn element(self, position: USize) lends Value
    requires position < self.count()
    ensures identical(result, self.entries.model()[position].value)
    cost time O(1)
  {
    self.entries[position].value
  }
}

public fn Map[Key: Hash + Ordered, Value].keys(self) -> Keys[Key, Value]
  ensures result.count() == self.length()
  cost time O(1)
{
  Keys(entries: self.entries.slice())
}

public fn Map[Key: Hash + Ordered, Value].values(self) -> Values[Key, Value]
  ensures result.count() == self.length()
  cost time O(1)
{
  Values(entries: self.entries.slice())
}

public fn Map[Key: Hash + Ordered, Value].value_at(mut self, position: USize) lends mut Value
  requires position < self.length()
  ensures self.length() == old(self.length())
  cost time O(1)
{
  mut self.entries[position].value
}

public fn Map[Key: Hash + Ordered, Value].update_values[capability Granted](
  mut self,
  change: (fn(mut Value) uses Granted cost time finite),
)
  uses Granted
  ensures self.length() == old(self.length())
  cost calls(change) == self.length()
  cost time O(self.length() * time(change))
{
  for position in 0..self.length()
    invariant self.length() == old(self.length())
  {
    change(mut self.value_at(position))
  }
}

internal fn Map[Key: Hash + Ordered, Value: Equal].entries_included_in(self, other: Map[Key, Value]) -> Bool
  ensures result == (forall i in 0..self.entries.length() => exists j in 0..other.entries.length() =>
    self.entries.model()[i].key == other.entries.model()[j].key
      && self.entries.model()[i].value == other.entries.model()[j].value)
  cost time O(self.entries.length() * (1 + other.entries.length() * time(Key.equal) + time(Value.equal)))
{
  var index: USize = 0
  while index < self.entries.length()
    invariant index <= self.entries.length()
    invariant forall i in 0..index => exists j in 0..other.entries.length() =>
      self.entries.model()[i].key == other.entries.model()[j].key
        && self.entries.model()[i].value == other.entries.model()[j].value
    decreases self.entries.length() - index
    cost time O(index * (1 + other.entries.length() * time(Key.equal) + time(Value.equal)))
  {
    let position = other.index_of(self.entries[index].key)
    if position == other.entries.length() || !(self.entries[index].value == other.entries[position].value) {
      return false
    }
    index += 1
  }
  true
}

internal theorem entries_inclusion_is_transitive[Key: Hash + Ordered, Value: Equal](
  first: Map[Key, Value],
  second: Map[Key, Value],
  third: Map[Key, Value],
)
  requires first.entries_included_in(second)
  requires second.entries_included_in(third)
  ensures first.entries_included_in(third)
  cost time finite
{
}

impl Equal for Map[Key: Hash + Ordered, Value: Equal] {
  fn equal(self, other: Map[Key, Value]) -> Bool {
    self.entries.length() == other.entries.length() && self.entries_included_in(other) && other.entries_included_in(self)
  }
}

proof Equal.transitive for Map[Key: Hash + Ordered, Value: Equal] {
  entries_inclusion_is_transitive(first, second: second, third: third)
  entries_inclusion_is_transitive(first: third, second: second, third: first)
}

impl Default for Map[Key: Hash + Ordered, Value] {
  fn default() -> Map[Key, Value] {
    [:]
  }
}

impl From[List[Entry[Key, Value]]] for Map[Key: Hash + Ordered, Value] {
  fn from(value: own List[Entry[Key, Value]]) -> Map[Key, Value] {
    var map: Map[Key, Value] = Map.with_capacity(value.length())
    for entry in own value
      invariant forall i in 0..map.entries.length() => forall j in 0..map.entries.length() =>
        i < j ==> !(map.entries.model()[i].key == map.entries.model()[j].key)
    {
      mut map.insert(own entry.key, value: own entry.value)
    }
    map
  }
}
