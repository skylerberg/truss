use standard::intrinsic

public opaque type Generator(state: Array[UInt64, 4])
  derives Plain

internal fn splitmix64(state: UInt64) -> UInt64
  cost time O(1)
{
  let first = (state ^ (state >> 30)).wrapping_multiply(0xbf58476d1ce4e5b9)
  let second = (first ^ (first >> 27)).wrapping_multiply(0x94d049bb133111eb)
  second ^ (second >> 31)
}

internal fn rejection_threshold(bound: UInt64) -> UInt64
  requires bound > 0
  ensures result < bound
  cost time O(1)
{
  (UInt64.maximum - bound + 1) % bound
}

internal fn range_width(from: Int64, to: Int64) -> UInt64
  requires from <= to
  ensures result == to - from
  cost time O(1)
{
  to.to_unsigned_bits().wrapping_subtract(from.to_unsigned_bits())
}

internal fn add_offset(start: Int64, offset: UInt64) -> Int64
  requires start + offset <= Int64.maximum
  ensures result == start + offset
  cost time O(1)
{
  start.to_unsigned_bits().wrapping_add(offset).to_signed_bits()
}

internal fn Generator.jump(mut self)
  cost time O(1)
{
  let masks: Array[UInt64, 4] = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa, 0x39abdc4529b1661c]
  var jumped: Array[UInt64, 4] = [0, 0, 0, 0]
  let words: USize = 4
  let bits: USize = 64
  for word in 0..words {
    for bit in 0..bits {
      if (masks[word] >> bit) % 2 == 1 {
        jumped[0] = jumped[0] ^ self.state[0]
        jumped[1] = jumped[1] ^ self.state[1]
        jumped[2] = jumped[2] ^ self.state[2]
        jumped[3] = jumped[3] ^ self.state[3]
      }
      let _ = mut self.next()
    }
  }
  self.state = jumped
}

public fn Generator.seeded(seed: UInt64) -> Generator
  cost time O(1)
{
  let first = seed.wrapping_add(0x9e3779b97f4a7c15)
  let second = first.wrapping_add(0x9e3779b97f4a7c15)
  let third = second.wrapping_add(0x9e3779b97f4a7c15)
  let fourth = third.wrapping_add(0x9e3779b97f4a7c15)
  Generator(state: [splitmix64(first), splitmix64(second), splitmix64(third), splitmix64(fourth)])
}

public fn Generator.new() -> Generator
  uses Random
{
  let state: Array[UInt64, 4] = [Random.next(), Random.next(), Random.next(), Random.next()]
  if state[0] == 0 && state[1] == 0 && state[2] == 0 && state[3] == 0 {
    Generator.seeded(0)
  } else {
    Generator(state: state)
  }
}

public fn Generator.next(mut self) -> UInt64
  cost time O(1)
{
  let result = self.state[1].wrapping_multiply(5).rotate_left(7).wrapping_multiply(9)
  let shifted = self.state[1] << 17
  self.state[2] = self.state[2] ^ self.state[0]
  self.state[3] = self.state[3] ^ self.state[1]
  self.state[1] = self.state[1] ^ self.state[2]
  self.state[0] = self.state[0] ^ self.state[3]
  self.state[2] = self.state[2] ^ shifted
  self.state[3] = self.state[3].rotate_left(45)
  result
}

public fn Generator.split(mut self) -> Generator
  cost time O(1)
{
  let branch = Generator(state: self.state)
  mut self.jump()
  branch
}

public fn Generator.below(mut self, bound: UInt64) -> UInt64
  requires bound > 0
  ensures result < bound
  cost time O(1)
{
  let rejected = rejection_threshold(bound)
  let attempts: USize = 64
  for _ in 0..attempts {
    let value = mut self.next()
    if value >= rejected {
      return value % bound
    }
  }
  mut self.next() % bound
}

public fn Generator.integer(mut self, range: Range[Int64]) -> Int64
  requires !range.is_empty()
  ensures range.contains(result)
  cost time O(1)
{
  let last = if range.inclusive { range.stop } else { range.stop - 1 }
  let span = range_width(range.start, to: last)
  if span == UInt64.maximum {
    return mut self.next().to_signed_bits()
  }
  add_offset(range.start, offset: mut self.below(span + 1))
}

public fn Generator.index(mut self, length: USize) -> USize
  requires length > 0
  ensures result < length
  cost time O(1)
{
  intrinsic::convert(mut self.below(intrinsic::convert(length)))
}

public fn Generator.unit(mut self) -> Float64
  ensures 0.0 <= result && result < 1.0
  cost time O(1)
{
  let value = (mut self.next() >> 11).to_float64() * 1.1102230246251565e-16
  if value >= 0.0 && value < 1.0 { value } else { 0.0 }
}

public fn Generator.fraction(mut self, low: Float64, high: Float64) -> Float64
  requires low < high
  cost time O(1)
{
  low + (high - low) * mut self.unit()
}

public fn Generator.normal(mut self, mean: Float64 = 0.0, deviation: Float64 = 1.0) -> Float64
  requires deviation >= 0.0
  cost time O(1)
{
  let first = 1.0 - mut self.unit()
  let second = mut self.unit()
  let radius = (-2.0 * first.logarithm()).square_root()
  mean + deviation * radius * (6.283185307179586 * second).cosine()
}

public fn Generator.chance(mut self, probability: Float64) -> Bool
  requires 0.0 <= probability && probability <= 1.0
  cost time O(1)
{
  mut self.unit() < probability
}

public fn Generator.fill(mut self, buffer: mut Slice[UInt8])
  ensures buffer.length() == old(buffer.length())
  cost time O(buffer.length())
{
  var word: UInt64 = 0
  for index in 0..buffer.length()
    invariant buffer.length() == old(buffer.length())
  {
    if index % 8 == 0 {
      word = mut self.next()
    }
    buffer[index] = intrinsic::convert(word % 256)
    word = word / 256
  }
}

public fn Generator.shuffle[Element](mut self, items: mut Slice[Element])
  ensures items.length() == old(items.length())
  cost time O(items.length())
{
  var remaining = items.length()
  while remaining > 1
    invariant items.length() == old(items.length())
    invariant remaining <= items.length()
    decreases remaining
  {
    let chosen = mut self.index(remaining)
    remaining -= 1
    mut items.swap(chosen, second: remaining)
  }
}

public fn Generator.choose[Element](mut self, items: Slice[Element]) -> Option[USize]
  ensures match result {
    Some(index) => index < items.length()
    None => items.length() == 0
  }
  cost time O(1)
{
  if items.length() == 0 { None } else { Some(mut self.index(items.length())) }
}

public fn Generator.sample(mut self, population: USize, count: USize) -> List[USize]
  requires count <= population
  ensures result.length() == count
  ensures forall i in 0..result.length() => result.model()[i] < population
  cost time finite
{
  var chosen: List[USize] = List.with_capacity(count)
  let start = population - count
  var position = start
  while position < population
    invariant start <= position
    invariant position <= population
    invariant chosen.length() == position - start
    invariant forall i in 0..chosen.length() => chosen.model()[i] < population
    decreases population - position
  {
    let candidate = mut self.index(position + 1)
    if chosen.contains(candidate) {
      mut chosen.push(position)
    } else {
      mut chosen.push(candidate)
    }
    position += 1
  }
  chosen
}

public fn bytes(count: USize) -> List[UInt8]
  uses Random
  ensures result.length() == count
{
  var output: List[UInt8] = []
  mut output.reserve(count)
  var word: UInt64 = 0
  for index in 0..count
    invariant output.length() == index
  {
    if index % 8 == 0 {
      word = Random.next()
    }
    mut output.push(intrinsic::convert(word % 256))
    word = word / 256
  }
  output
}

public fn below(bound: UInt64) -> UInt64
  uses Random
  requires bound > 0
  ensures result < bound
{
  let rejected = rejection_threshold(bound)
  let attempts: USize = 64
  for _ in 0..attempts {
    let value = Random.next()
    if value >= rejected {
      return value % bound
    }
  }
  Random.next() % bound
}

public type SeededRandom(generator: Generator)

public fn SeededRandom.new(seed: UInt64) -> SeededRandom {
  SeededRandom(generator: Generator.seeded(seed))
}

impl Random for SeededRandom {
  fn next(mut self) -> UInt64 {
    mut self.generator.next()
  }
}
