  fn connect(self, address: SocketAddress, timeout: Option[Duration]) -> Result[Connection, SystemError] {
    todo
  }

  fn open_datagram(self) -> Result[DatagramSocket, SystemError] {
    Err(SystemError.PermissionDenied)
  }
