  | Version4(octets: Array[UInt8, 4])
  | Version6(octets: Array[UInt8, 16])
  derives Equal, Hash, Ordered

public let IpAddress.loopback: IpAddress = IpAddress.Version4([127, 0, 0, 1])

public let IpAddress.unspecified: IpAddress = IpAddress.Version4([0, 0, 0, 0])

