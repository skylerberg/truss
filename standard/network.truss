public type Direction = Receiving | Sending | Both
  derives Equal

public opaque type Connection(handle: streams::Handle, local: SocketAddress, peer: SocketAddress)

public fn Connection.from_handle(handle: own streams::Handle, local: SocketAddress, peer: SocketAddress) -> Connection {
  Connection(handle: own handle, local: local, peer: peer)
}

public fn Connection.local_address(self) -> SocketAddress
  cost time O(1)
{
  self.local
}

public fn Connection.peer_address(self) -> SocketAddress
  cost time O(1)
{
  self.peer
}

public fn Connection.set_read_timeout(mut self, timeout: Option[Duration]) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.set_timeout(self.handle, direction: Direction.Receiving, timeout: timeout)
}

public fn Connection.set_write_timeout(mut self, timeout: Option[Duration]) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.set_timeout(self.handle, direction: Direction.Sending, timeout: timeout)
}

public fn Connection.shut_down(mut self, direction: Direction) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.shut_down(self.handle, direction: direction)
}

impl streams::Reader for Connection {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.read(self.handle, buffer: mut buffer, limit: limit)
  }
}

impl streams::Writer for Connection {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.write(self.handle, bytes: bytes)
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
  {
    Ok(Unit)
  }
}

public type Accepted(handle: streams::Handle, peer: SocketAddress)

public opaque type Listener(handle: streams::Handle, local: SocketAddress)

public fn Listener.from_handle(handle: own streams::Handle, local: SocketAddress) -> Listener {
  Listener(handle: own handle, local: local)
}

public fn Listener.local_address(self) -> SocketAddress
  cost time O(1)
{
  self.local
}

public fn Listener.accept(mut self) -> Result[Connection, SystemError]
  uses Handles
{
  let accepted = Handles.accept(self.handle)?
  Ok(Connection(handle: own accepted.handle, local: self.local, peer: accepted.peer))
}

public fn Listener.connections(mut self) yields own Result[Connection, SystemError]
  uses Handles
{
  while true {
    yield mut self.accept()
  }
}

public type Datagram(length: USize, from: SocketAddress)

public opaque type DatagramSocket(handle: streams::Handle, local: SocketAddress)

public fn DatagramSocket.from_handle(handle: own streams::Handle, local: SocketAddress) -> DatagramSocket {
  DatagramSocket(handle: own handle, local: local)
}

public fn DatagramSocket.local_address(self) -> SocketAddress
  cost time O(1)
{
  self.local
}

public fn DatagramSocket.send_to(mut self, bytes: Slice[UInt8], address: SocketAddress) -> Result[USize, SystemError]
  uses Handles
{
  Handles.send_to(self.handle, bytes: bytes, address: address)
}

public fn DatagramSocket.receive_from(mut self, buffer: mut List[UInt8], limit: USize) -> Result[Datagram, SystemError]
  uses Handles
{
  Handles.receive_from(self.handle, buffer: mut buffer, limit: limit)
}

public fn DatagramSocket.set_read_timeout(mut self, timeout: Option[Duration]) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.set_timeout(self.handle, direction: Direction.Receiving, timeout: timeout)
}

