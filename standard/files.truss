public type FilesWithin(root: Path)

impl FileRead for FilesWithin
  uses FileRead
{
  fn read(self, file: Path) -> Result[List[UInt8], SystemError] {
    FileRead.read(self.root.join_within(file)?)
  }

  fn read_text(self, file: Path) -> Result[String, SystemError] {
    FileRead.read_text(self.root.join_within(file)?)
  }

  fn open(self, file: Path) -> Result[FileReader, SystemError] {
    FileRead.open(self.root.join_within(file)?)
  }

  fn metadata(self, path: Path, follow_links: Bool) -> Result[Metadata, SystemError] {
    FileRead.metadata(self.root.join_within(path)?, follow_links: follow_links)
  }

  fn list(self, directory: Path) -> Result[List[DirectoryEntry], SystemError] {
    FileRead.list(self.root.join_within(directory)?)
  }

  fn read_link(self, link: Path) -> Result[Path, SystemError] {
    FileRead.read_link(self.root.join_within(link)?)
  }

  fn resolve(self, path: Path) -> Result[Path, SystemError] {
    todo
  }
}

impl FileWrite for FilesWithin
  uses FileWrite
{
  fn write(self, file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError] {
    FileWrite.write(self.root.join_within(file)?, contents: contents)
  }

  fn write_text(self, file: Path, contents: StringSlice) -> Result[Unit, SystemError] {
    FileWrite.write_text(self.root.join_within(file)?, contents: contents)
  }

  fn open(self, file: Path, mode: WriteMode) -> Result[File, SystemError] {
    FileWrite.open(self.root.join_within(file)?, mode: mode)
  }

  fn create_directory(self, directory: Path) -> Result[Unit, SystemError] {
    FileWrite.create_directory(self.root.join_within(directory)?)
  }

  fn remove(self, path: Path) -> Result[Unit, SystemError] {
    FileWrite.remove(self.root.join_within(path)?)
  }

  fn rename(self, from: Path, to: Path) -> Result[Unit, SystemError] {
    FileWrite.rename(self.root.join_within(from)?, to: self.root.join_within(to)?)
  }

  fn link(self, target: Path, link: Path, kind: LinkKind) -> Result[Unit, SystemError] {
    FileWrite.link(self.root.join_within(target)?, link: self.root.join_within(link)?, kind: kind)
  }

  fn set_permissions(self, path: Path, permissions: Permissions) -> Result[Unit, SystemError] {
    FileWrite.set_permissions(self.root.join_within(path)?, permissions: permissions)
  }

  fn set_modified(self, path: Path, time: Instant) -> Result[Unit, SystemError] {
    FileWrite.set_modified(self.root.join_within(path)?, time: time)
  }
}

public type ReadOnlyFiles()

impl FileWrite for ReadOnlyFiles {
  fn write(self, file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn write_text(self, file: Path, contents: StringSlice) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn open(self, file: Path, mode: WriteMode) -> Result[File, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn create_directory(self, directory: Path) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn remove(self, path: Path) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn rename(self, from: Path, to: Path) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn link(self, target: Path, link: Path, kind: LinkKind) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn set_permissions(self, path: Path, permissions: Permissions) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn set_modified(self, path: Path, time: Instant) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }
}

