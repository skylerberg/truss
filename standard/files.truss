use standard::console
use standard::intrinsic
use standard::network
use standard::processes
use standard::streams
use standard::text

public opaque type Path(text: String)
  derives Copyable

public fn Path.new(text: StringSlice) -> Path {
  Path(text: text.to_string())
}

public fn Path.from_bytes(bytes: own List[UInt8]) -> Option[Path]
  cost time O(bytes.length())
{
  match String.from_utf8(own bytes) {
    Ok(text) => Some(Path(text: own text))
    Err(_) => None
  }
}

public fn Path.text(self) -> Option[StringSlice]
  cost time O(1)
{
  Some(self.text.slice())
}

public fn Path.bytes(self) -> Slice[UInt8]
  cost time O(1)
{
  self.text.bytes()
}

internal type Span(start: USize, end: USize)

internal fn Span.is_empty(self) -> Bool
  cost time O(1)
  cost allocations == 0
{
  self.start == self.end
}

internal fn next_component(text: StringSlice, from: USize) -> Span
  requires from <= text.length()
  ensures from <= result.start
  ensures result.start <= result.end
  ensures result.end <= text.length()
  ensures result.start == text.length() || text.byte(result.start) != 47
  ensures result.end == text.length() || text.byte(result.end) == 47
  cost time O(result.end - from)
  cost allocations == 0
{
  var start = from
  while start < text.length() && text.byte(start) == 47
    invariant from <= start
    invariant start <= text.length()
    decreases text.length() - start
    cost time O(start - from)
    cost allocations == 0
  {
    start += 1
  }
  var end = start
  while end < text.length() && text.byte(end) != 47
    invariant start <= end
    invariant end <= text.length()
    decreases text.length() - end
    cost time O(end - start)
    cost allocations == 0
  {
    end += 1
  }
  Span(start: start, end: end)
}

internal fn last_component(text: StringSlice) -> Span
  ensures result.start <= result.end
  ensures result.end <= text.length()
  cost time O(text.length())
  cost allocations == 0
{
  var end = text.length()
  while end > 0 && text.byte(end - 1) == 47
    invariant end <= text.length()
    decreases end
    cost time O(text.length() - end)
    cost allocations == 0
  {
    end -= 1
  }
  var start = end
  while start > 0 && text.byte(start - 1) != 47
    invariant start <= end
    decreases start
    cost time O(end - start)
    cost allocations == 0
  {
    start -= 1
  }
  Span(start: start, end: end)
}

internal fn is_dot_or_dot_dot(text: StringSlice, span: Span) -> Bool
  requires span.start <= span.end
  requires span.end <= text.length()
  cost time O(1)
  cost allocations == 0
{
  let length = span.end - span.start
  (length == 1 && text.byte(span.start) == 46)
    || (length == 2 && text.byte(span.start) == 46 && text.byte(span.start + 1) == 46)
}

internal fn extension_start(text: StringSlice, name: Span) -> USize
  requires name.start <= name.end
  requires name.end <= text.length()
  ensures name.start <= result
  ensures result <= name.end
  cost time O(text.length())
  cost allocations == 0
{
  var index = name.end
  while index > name.start + 1
    invariant name.start <= index
    invariant index <= name.end
    decreases index
    cost time O(name.end - index)
    cost allocations == 0
  {
    index -= 1
    if text.byte(index) == 46 {
      return index
    }
  }
  name.end
}

internal fn join_paths(first: StringSlice, second: StringSlice) -> Path
  ensures result.text.length() <= first.length() + second.length() + 1
  cost time O(first.length() + second.length())
{
  if second.length() > 0 && second.byte(0) == 47 {
    return Path(text: second.to_string())
  }
  if first.length() == 0 {
    return Path(text: second.to_string())
  }
  if first.length() > USize.maximum / 4 || second.length() > USize.maximum / 4 {
    intrinsic::crash("a path cannot hold that many bytes".slice())
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(first.length() + 1 + second.length())
  first.copy_onto(mut output)
  if first.byte(first.length() - 1) != 47 {
    intrinsic::storage_push(mut output, value: 47)
  }
  second.copy_onto(mut output)
  Path(text: String(storage: own output))
}

public fn Path.is_absolute(self) -> Bool
  cost time O(1)
{
  self.text.length() > 0 && self.text.slice().byte(0) == 47
}

public fn Path.join(self, part: StringSlice) -> Path
  cost time O(self.text.length() + part.length())
{
  join_paths(self.text.slice(), second: part)
}

public fn Path.join_path(self, other: Path) -> Path
  cost time O(self.text.length() + other.text.length())
{
  join_paths(self.text.slice(), second: other.text.slice())
}

public fn Path.join_confined(self, part: Path) -> Result[Path, SystemError]
  ensures match result {
    Ok(joined) => joined.starts_with(self)
    Err(_) => true
  }
  cost time O(self.text.length() + part.text.length())
{
  if part.is_absolute() {
    return Err(SystemError.PermissionDenied)
  }
  let inner = part.normalized()
  let part_text = inner.text.slice()
  if part_text.length() >= 2 && part_text.byte(0) == 46 && part_text.byte(1) == 46 && (part_text.length() == 2 || part_text.byte(2) == 47) {
    return Err(SystemError.PermissionDenied)
  }
  let joined = if part_text.length() == 1 && part_text.byte(0) == 46 {
    Path(text: self.text.slice().to_string())
  } else {
    self.join_path(inner)
  }
  if joined.starts_with(self) { Ok(own joined) } else { Err(SystemError.PermissionDenied) }
}

public fn Path.parent(self) -> Option[Path]
  cost time O(self.text.length())
{
  let text = self.text.slice()
  let name = last_component(text)
  if name.is_empty() {
    return None
  }
  var end = name.start
  while end > 1 && text.byte(end - 1) == 47
    invariant end <= name.start
    decreases end
    cost time O(name.start - end)
  {
    end -= 1
  }
  Some(Path(text: text.part(0, to: end).to_string()))
}

public fn Path.file_name(self) -> Option[StringSlice]
  cost time O(self.text.length())
{
  let text = self.text.slice()
  let name = last_component(text)
  if name.is_empty() || is_dot_or_dot_dot(text, span: name) {
    None
  } else {
    Some(text.part(name.start, to: name.end))
  }
}

public fn Path.stem(self) -> Option[StringSlice]
  cost time O(self.text.length())
{
  let text = self.text.slice()
  let name = last_component(text)
  if name.is_empty() || is_dot_or_dot_dot(text, span: name) {
    None
  } else {
    Some(text.part(name.start, to: extension_start(text, name: name)))
  }
}

public fn Path.extension(self) -> Option[StringSlice]
  cost time O(self.text.length())
{
  let text = self.text.slice()
  let name = last_component(text)
  if name.is_empty() || is_dot_or_dot_dot(text, span: name) {
    return None
  }
  let dot = extension_start(text, name: name)
  if dot == name.end { None } else { Some(text.part(dot + 1, to: name.end)) }
}

public fn Path.with_extension(self, extension: StringSlice) -> Path
  cost time O(self.text.length() + extension.length())
{
  let text = self.text.slice()
  let name = last_component(text)
  if name.is_empty() || is_dot_or_dot_dot(text, span: name) {
    return Path(text: text.to_string())
  }
  let stem = text.part(0, to: extension_start(text, name: name))
  if stem.length() > USize.maximum / 4 || extension.length() > USize.maximum / 4 {
    intrinsic::crash("a path cannot hold that many bytes".slice())
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(stem.length() + 1 + extension.length())
  stem.copy_onto(mut output)
  if extension.length() > 0 {
    intrinsic::storage_push(mut output, value: 46)
    extension.copy_onto(mut output)
  }
  Path(text: String(storage: own output))
}

public fn Path.with_file_name(self, name: StringSlice) -> Path
  cost time O(self.text.length() + name.length())
{
  let text = self.text.slice()
  let last = last_component(text)
  if last.is_empty() || is_dot_or_dot_dot(text, span: last) {
    return join_paths(text, second: name)
  }
  let before = text.part(0, to: last.start)
  if before.length() > USize.maximum / 4 || name.length() > USize.maximum / 4 {
    intrinsic::crash("a path cannot hold that many bytes".slice())
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(before.length() + name.length())
  before.copy_onto(mut output)
  name.copy_onto(mut output)
  Path(text: String(storage: own output))
}

public fn Path.components(self) yields StringSlice
  ensures yielded.length() <= self.text.length()
  cost time O(self.text.length())
{
  let text = self.text.slice()
  var from: USize = 0
  while from < text.length()
    invariant from <= text.length()
    invariant yielded.length() <= from
    decreases text.length() - from
    cost time O(from)
  {
    let span = next_component(text, from: from)
    if span.is_empty() {
      return
    }
    yield text.part(span.start, to: span.end)
    from = span.end
  }
}

internal fn parent_length(output: intrinsic::Storage[UInt8], floor: USize) -> USize
  requires floor <= intrinsic::storage_length(output)
  ensures floor <= result
  ensures result <= intrinsic::storage_length(output)
  cost time O(intrinsic::storage_length(output) - result)
  cost allocations == 0
{
  var length = intrinsic::storage_length(output)
  while length > floor && intrinsic::storage_at(output, index: length - 1) != 47
    invariant floor <= length
    invariant length <= intrinsic::storage_length(output)
    decreases length
    cost time O(intrinsic::storage_length(output) - length)
    cost allocations == 0
  {
    length -= 1
  }
  if length > floor { length - 1 } else { length }
}

public fn Path.normalized(self) -> Path
  ensures result.text.length() <= self.text.length() + 1
  cost time O(self.text.length())
{
  let text = self.text.slice()
  let absolute = self.is_absolute()
  if text.length() > USize.maximum / 4 {
    intrinsic::crash("a path cannot hold that many bytes".slice())
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(text.length() + 1)
  if absolute {
    intrinsic::storage_push(mut output, value: 47)
  }
  var floor = intrinsic::storage_length(output)
  var index: USize = 0
  while index < text.length()
    invariant index <= text.length()
    invariant index == 0 || index == text.length() || text.byte(index) == 47
    invariant !absolute || (text.length() > 0 && text.byte(0) == 47)
    invariant floor <= intrinsic::storage_length(output)
    invariant intrinsic::storage_length(output) <= index + 1
    invariant index == 0 ==> floor == intrinsic::storage_length(output)
    invariant index == 0 && !absolute ==> intrinsic::storage_length(output) == 0
    invariant intrinsic::storage_capacity(output) == text.length() + 1
    decreases text.length() - index
    cost time O(3 * index + 1 - intrinsic::storage_length(output))
  {
    let span = next_component(text, from: index)
    if span.is_empty() {
      index = text.length()
    } else {
      let length = intrinsic::storage_length(output)
      if is_dot_or_dot_dot(text, span: span) {
        if span.end - span.start == 2 {
          if length > floor {
            intrinsic::storage_shorten(mut output, length: parent_length(output, floor: floor))
          } else if !absolute {
            if length > 0 {
              intrinsic::storage_push(mut output, value: 47)
            }
            intrinsic::storage_push(mut output, value: 46)
            intrinsic::storage_push(mut output, value: 46)
            floor = intrinsic::storage_length(output)
          }
        }
      } else {
        if length > floor || (length > 0 && !absolute) {
          intrinsic::storage_push(mut output, value: 47)
        }
        text.part(span.start, to: span.end).copy_onto(mut output)
      }
      index = span.end
    }
  }
  if intrinsic::storage_length(output) == 0 {
    intrinsic::storage_push(mut output, value: 46)
  }
  Path(text: String(storage: own output))
}

public fn Path.starts_with(self, base: Path) -> Bool
  cost time O(self.text.length() + base.text.length())
{
  if self.is_absolute() != base.is_absolute() {
    return false
  }
  let text = self.text.slice()
  let prefix = base.text.slice()
  var mine: USize = 0
  var theirs: USize = 0
  while theirs < prefix.length()
    invariant mine <= text.length()
    invariant theirs <= prefix.length()
    decreases prefix.length() - theirs
    cost time O(mine + theirs)
  {
    let wanted = next_component(prefix, from: theirs)
    if wanted.is_empty() {
      return true
    }
    let component = next_component(text, from: mine)
    if component.end - component.start != wanted.end - wanted.start {
      return false
    }
    if !text.part(component.start, to: component.end).matches_at(prefix.part(wanted.start, to: wanted.end), offset: 0) {
      return false
    }
    mine = component.end
    theirs = wanted.end
  }
  true
}

public fn Path.relative_to(self, base: Path) -> Option[Path]
  cost time O(self.text.length() + base.text.length())
{
  if self.is_absolute() != base.is_absolute() {
    return None
  }
  let text = self.text.slice()
  let prefix = base.text.slice()
  var mine: USize = 0
  var theirs: USize = 0
  while theirs < prefix.length()
    invariant mine <= text.length()
    invariant theirs <= prefix.length()
    decreases prefix.length() - theirs
    cost time O(mine + theirs)
  {
    let wanted = next_component(prefix, from: theirs)
    if wanted.is_empty() {
      theirs = prefix.length()
    } else {
      let component = next_component(text, from: mine)
      if component.end - component.start != wanted.end - wanted.start {
        return None
      }
      if !text.part(component.start, to: component.end).matches_at(prefix.part(wanted.start, to: wanted.end), offset: 0) {
        return None
      }
      mine = component.end
      theirs = wanted.end
    }
  }
  let rest = next_component(text, from: mine)
  Some(Path(text: text.part(rest.start, to: text.length()).to_string()))
}

impl Equal for Path {
  fn equal(self, other: Path) -> Bool {
    self.text == other.text
  }
}

impl Ordered for Path {
  fn compare(self, other: Path) -> Ordering {
    self.text.compare(other.text)
  }
}

impl Hash for Path {
  fn hash(self, hasher: mut Hasher) {
    self.text.hash(mut hasher)
  }
}

impl Display for Path {
  fn display(self, output: mut TextBuilder) {
    mut output.write(self.text.slice())
  }
}

public type FileKind = File | Directory | SymbolicLink | Other
  derives Equal, Hash

public opaque type Permissions(mode: UInt32)
  derives Plain, Equal, Hash
  invariant mode <= 0o7777

public fn Permissions.from_mode(mode: UInt32) -> Permissions
  requires mode <= 0o7777
  cost time O(1)
{
  Permissions(mode: mode)
}

public fn Permissions.mode(self) -> UInt32
  ensures result <= 0o7777
  cost time O(1)
{
  self.mode
}

public fn Permissions.is_read_only(self) -> Bool
  cost time O(1)
{
  (self.mode & 0o222) == 0
}

public fn Permissions.is_executable(self) -> Bool
  cost time O(1)
{
  (self.mode & 0o111) != 0
}

public type Metadata(
  kind: FileKind,
  length: UInt64,
  permissions: Permissions,
  modified: Instant,
  accessed: Option[Instant],
  created: Option[Instant],
)
  derives Equal

public transparent fn Metadata.is_file(self) -> Bool
  cost time O(1)
{
  self.kind == FileKind.File
}

public transparent fn Metadata.is_directory(self) -> Bool
  cost time O(1)
{
  self.kind == FileKind.Directory
}

public type DirectoryEntry(name: String, kind: FileKind)
  derives Equal

public type WriteMode =
  | Replace
  | Append
  | CreateNew
  | Update
  derives Equal

public type LinkKind = Symbolic | Hard
  derives Equal

public opaque type FileReader(reader: streams::BufferedReader[File])

internal fn FileReader.new(file: own File) -> FileReader {
  FileReader(reader: streams::BufferedReader[File].new(own file))
}

internal fn FileReader.opened(simulated_handle: UInt64) -> FileReader {
  FileReader.new(File.opened(simulated_handle))
}

public fn FileReader.read_line(mut self) -> Result[Option[String], SystemError]
  uses Handles
{
  mut self.reader.read_line()
}

public fn FileReader.lines(mut self) yields own Result[String, SystemError]
  uses Handles
{
  var more = true
  while more {
    match mut self.reader.read_line() {
      Ok(Some(line)) => yield Ok(own line)
      Ok(None) => {
        more = false
      }
      Err(error) => {
        more = false
        yield Err(error)
      }
    }
  }
}

public fn FileReader.metadata(self) -> Result[Metadata, SystemError]
  uses Handles
{
  self.reader.source().metadata()
}

public fn FileReader.close(own self) -> Result[Unit, SystemError]
  uses Handles
{
  own self.reader.finish().close()
}

impl streams::Reader for FileReader {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    mut self.reader.read(mut buffer, limit: limit)
  }
}

impl streams::Seek for FileReader {
  fn seek(mut self, to: streams::Position) -> Result[UInt64, SystemError]
    uses Handles
  {
    mut self.reader.seek(to)
  }
}

public opaque type FileWriter(file: File)

public fn FileWriter.write(mut self, text: StringSlice) -> Result[Unit, SystemError]
  uses Handles
{
  mut self.file.write_text(text)
}

public fn FileWriter.write_line(mut self, text: StringSlice) -> Result[Unit, SystemError]
  uses Handles
{
  mut self.file.write_text(text)?
  mut self.file.write_text("\n")
}

public fn FileWriter.write_bytes(mut self, bytes: Slice[UInt8]) -> Result[Unit, SystemError]
  uses Handles
{
  mut self.file.write_all(bytes)
}

public fn FileWriter.flush(mut self) -> Result[Unit, SystemError]
  uses Handles
{
  Ok(Unit)
}

public opaque type File(handle: streams::Handle)

internal fn File.opened(simulated_handle: UInt64) -> File {
  File(handle: streams::Handle.simulated(simulated_handle))
}

public fn File.read_at(mut self, offset: UInt64, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
  uses Handles
{
  Handles.read_at(self.handle, offset: offset, buffer: mut buffer, limit: limit)
}

public fn File.write_at(mut self, offset: UInt64, bytes: Slice[UInt8]) -> Result[USize, SystemError]
  uses Handles
{
  Handles.write_at(self.handle, offset: offset, bytes: bytes)
}

public fn File.set_length(mut self, length: UInt64) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.set_length(self.handle, length: length)
}

public fn File.synchronize(mut self) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.synchronize(self.handle)
}

public fn File.metadata(self) -> Result[Metadata, SystemError]
  uses Handles
{
  Handles.metadata(self.handle)
}

public fn File.close(own self) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.close(own self.handle)
}

impl streams::Reader for File {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.read(self.handle, buffer: mut buffer, limit: limit)
  }
}

impl streams::Writer for File {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.write(self.handle, bytes: bytes)
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
  {
    Ok(Unit)
  }
}

impl streams::Seek for File {
  fn seek(mut self, to: streams::Position) -> Result[UInt64, SystemError]
    uses Handles
  {
    Handles.seek(self.handle, to: to)
  }
}

public fn is_present(path: Path) -> Bool
  uses FileRead
{
  FileRead.metadata(path, follow_links: true).is_ok()
}

public fn write_with[Output, capability Granted](
  file: Path,
  write: (fn(mut FileWriter) -> Result[Output, SystemError] uses Granted),
  mode: WriteMode = WriteMode.Replace,
) -> Result[Output, SystemError]
  uses FileWrite, Handles, Granted
{
  let opened = FileWrite.open(file, mode: mode)?
  var writer = FileWriter(file: own opened)
  let output = write(mut writer)?
  mut writer.flush()?
  Ok(own output)
}

fn write_new_file(file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError]
  uses FileWrite, Handles
{
  var opened = FileWrite.open(file, mode: WriteMode.CreateNew)?
  let written = match mut opened.write_all(contents) {
    Ok(_) => mut opened.synchronize()
    Err(error) => Err(error)
  }
  let closed = own opened.close()
  match written {
    Ok(_) => closed
    Err(error) => Err(error)
  }
}

public fn write_atomically(file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError]
  uses FileWrite, Handles, Random
{
  let name = match file.file_name() {
    Some(name) => name
    None => return Err(SystemError.InvalidInput)
  }
  var temporary_name = name.to_string()
  mut temporary_name.push(".")
  mut temporary_name.push(Random.next().format(radix: 16, minimum_digits: 16).slice())
  mut temporary_name.push(".tmp")
  let temporary = file.with_file_name(temporary_name.slice())
  let written = write_new_file(temporary, contents: contents)
  let renamed = match written {
    Ok(_) => FileWrite.rename(temporary, to: file)
    Err(error) => Err(error)
  }
  if renamed is Err(_) {
    let _ = FileWrite.remove(temporary)
  }
  renamed
}

public fn append(file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError]
  uses FileWrite, Handles
{
  var opened = FileWrite.open(file, mode: WriteMode.Append)?
  let written = mut opened.write_all(contents)
  let closed = own opened.close()
  match written {
    Ok(_) => closed
    Err(error) => Err(error)
  }
}

public fn append_text(file: Path, contents: StringSlice) -> Result[Unit, SystemError]
  uses FileWrite, Handles
{
  append(file, contents: contents.bytes())
}

public fn copy(from: Path, to: Path) -> Result[UInt64, SystemError]
  uses FileRead, FileWrite, Handles
{
  let permissions = FileRead.metadata(from, follow_links: true)?.permissions
  var source = FileRead.open(from)?
  let copied = match FileWrite.open(to, mode: WriteMode.Replace) {
    Ok(opened) => {
      var sink = own opened
      let count = streams::copy(mut source, sink: mut sink)
      let closed = own sink.close()
      match closed {
        Ok(_) => count
        Err(error) => Err(error)
      }
    }
    Err(error) => Err(error)
  }
  let closed = own source.close()
  let count = copied?
  closed?
  FileWrite.set_permissions(to, permissions: permissions)?
  Ok(count)
}

public fn create_directories(directory: Path) -> Result[Unit, SystemError]
  uses FileRead, FileWrite
{
  var prefix = if directory.is_absolute() { Path.new("/") } else { Path.new("") }
  for component in directory.components() {
    prefix = prefix.join(component)
    match FileWrite.create_directory(prefix) {
      Ok(_) => {}
      Err(AlreadyExists) => {
        if !FileRead.metadata(prefix, follow_links: true)?.is_directory() {
          return Err(SystemError.NotADirectory)
        }
      }
      Err(error) => return Err(error)
    }
  }
  Ok(Unit)
}

public fn remove_all(path: Path) -> Result[Unit, SystemError]
  uses FileRead, FileWrite
{
  if FileRead.metadata(path, follow_links: false)?.is_directory() {
    for entry in FileRead.list(path)? {
      remove_all(path.join(entry.name.slice()))?
    }
  }
  FileWrite.remove(path)
}

public fn create_temporary_directory(parent: Path, prefix: StringSlice) -> Result[Path, SystemError]
  uses FileWrite, Random
{
  var failure = SystemError.AlreadyExists
  for _ in 0..16 {
    var name = prefix.to_string()
    mut name.push(Random.next().format(radix: 16, minimum_digits: 16).slice())
    let directory = parent.join(name.slice())
    match FileWrite.create_directory(directory) {
      Ok(_) => return Ok(own directory)
      Err(AlreadyExists) => {}
      Err(error) => {
        failure = error
        break
      }
    }
  }
  Err(failure)
}

public type WalkEntry(path: Path, kind: FileKind, depth: USize)
  derives Equal

let walk_depth_limit: USize = 256

public fn walk(root: Path, follow_links: Bool = false) -> Result[List[WalkEntry], SystemError]
  uses FileRead
{
  let kind = FileRead.metadata(root, follow_links: follow_links)?.kind
  var unvisited: List[WalkEntry] = [WalkEntry(path: root.copy(), kind: kind, depth: 0)]
  var entries: List[WalkEntry] = []
  while mut unvisited.pop() is Some(entry) {
    if entry.kind == FileKind.Directory {
      if entry.depth >= walk_depth_limit {
        return Err(SystemError.InvalidInput)
      }
      var children = FileRead.list(entry.path)?
      mut children.reverse()
      for child in children {
        let path = entry.path.join(child.name.slice())
        let child_kind = if follow_links && child.kind == FileKind.SymbolicLink {
          FileRead.metadata(path, follow_links: true)?.kind
        } else {
          child.kind
        }
        mut unvisited.push(WalkEntry(path: own path, kind: child_kind, depth: entry.depth + 1))
      }
    }
    mut entries.push(own entry)
  }
  Ok(own entries)
}

type CharacterRange(first: Character, last: Character)

type GlobToken =
  | AnyCharacters
  | AnyCharacter
  | Literal(character: Character)
  | OneOf(ranges: List[CharacterRange], negated: Bool)

type GlobComponent =
  | AnyDirectories
  | Name(tokens: List[GlobToken])

type ParsedClass(token: GlobToken, end: USize)

public opaque type Glob(components: List[GlobComponent], absolute: Bool)
  derives Copyable

fn wildcard_matches(
  pattern_length: USize,
  text_length: USize,
  is_wildcard: (fn(pattern_index: USize) -> Bool requires pattern_index < pattern_length cost time finite),
  matches_one: (
    fn(pattern_index: USize, text_index: USize) -> Bool
      requires pattern_index < pattern_length && text_index < text_length
      cost time finite
  ),
) -> Bool
  cost time finite
{
  var text: USize = 0
  var pattern: USize = 0
  var wildcard: Option[USize] = None
  var retry: USize = 0
  while text < text_length
    invariant text <= text_length
    invariant pattern <= pattern_length
    invariant retry <= text
    invariant !(wildcard is Some(index) && index >= pattern_length)
    decreases (if wildcard is None { text_length + 1 } else { text_length - retry }),
      text_length - text,
      pattern_length - pattern
  {
    if pattern < pattern_length && is_wildcard(pattern) {
      wildcard = Some(pattern)
      retry = text
      pattern += 1
    } else if pattern < pattern_length && matches_one(pattern, text) {
      text += 1
      pattern += 1
    } else {
      match wildcard {
        Some(index) => {
          retry += 1
          text = retry
          pattern = index + 1
        }
        None => return false
      }
    }
  }
  while pattern < pattern_length && is_wildcard(pattern)
    invariant pattern <= pattern_length
    decreases pattern_length - pattern
  {
    pattern += 1
  }
  pattern == pattern_length
}

fn GlobToken.matches(self, character: Character) -> Bool
  cost time finite
{
  match self {
    AnyCharacters => false
    AnyCharacter => true
    Literal(literal) => literal == character
    OneOf(ranges, negated) => {
      var listed = false
      for range in ranges {
        if range.first <= character && character <= range.last {
          listed = true
        }
      }
      listed != negated
    }
  }
}

fn name_matches(tokens: Slice[GlobToken], name: StringSlice) -> Bool
  cost time finite
{
  var characters: List[Character] = []
  for character in name.characters() {
    mut characters.push(character)
  }
  wildcard_matches(
    tokens.length(),
    text_length: characters.length(),
    is_wildcard: fn(index) { tokens[index] is AnyCharacters },
    matches_one: fn(index, position) { tokens[index].matches(characters[position]) },
  )
}

fn parse_class(pattern: StringSlice, from: USize) -> Result[ParsedClass, GlobError]
  requires from < pattern.length()
  ensures !(result is Ok(parsed) && (parsed.end <= from || parsed.end > pattern.length()))
  cost time finite
{
  var ranges: List[CharacterRange] = []
  var index = from + 1
  var negated = false
  if index < pattern.length() && (pattern.byte(index) == 33 || pattern.byte(index) == 94) {
    negated = true
    index += 1
  }
  while index < pattern.length()
    invariant from < index
    invariant index <= pattern.length()
    decreases pattern.length() - index
  {
    let decoded = pattern.decode(index)
    var next = index + decoded.length
    if decoded.character == Character"]" {
      if ranges.is_empty() {
        return Err(GlobError(offset: from))
      }
      return Ok(ParsedClass(token: GlobToken.OneOf(ranges: own ranges, negated: negated), end: next))
    }
    var first = decoded.character
    if first == Character"\\" {
      if next >= pattern.length() {
        return Err(GlobError(offset: from))
      }
      let escaped = pattern.decode(next)
      first = escaped.character
      next = next + escaped.length
    }
    var last = first
    if next < pattern.length() && pattern.byte(next) == 45 && next + 1 < pattern.length() && pattern.byte(next + 1) != 93 {
      let upper = pattern.decode(next + 1)
      last = upper.character
      next = next + 1 + upper.length
    }
    mut ranges.push(CharacterRange(first: first, last: last))
    index = next
  }
  Err(GlobError(offset: from))
}

impl FromTemplate for Glob {
  type Part = Never

  fn from_template(template: Template[Never]) -> Glob
    requires is_valid_glob(template.literals)
  {
    match Glob.parse(template.literals[0].text()) {
      Ok(glob) => glob
      Err(_) => Glob(components: [], absolute: false)
    }
  }
}

public fn is_valid_glob(literals: Slice[text::Literal]) -> Bool
  cost time finite
{
  literals.length() == 1 && Glob.parse(literals[0].text()) is Ok(_)
}

public fn Glob.parse(pattern: StringSlice) -> Result[Glob, GlobError]
  cost time finite
{
  var components: List[GlobComponent] = []
  var tokens: List[GlobToken] = []
  var index: USize = 0
  while index < pattern.length()
    invariant index <= pattern.length()
    decreases pattern.length() - index
  {
    let decoded = pattern.decode(index)
    let next = index + decoded.length
    if decoded.character == Character"/" {
      if !tokens.is_empty() {
        mut components.push(GlobComponent.Name(tokens: own tokens))
        tokens = []
      }
      index = next
    } else if decoded.character == Character"*" {
      if next < pattern.length() && pattern.byte(next) == 42 {
        let after = next + 1
        if !tokens.is_empty() || (after < pattern.length() && pattern.byte(after) != 47) {
          return Err(GlobError(offset: index))
        }
        mut components.push(GlobComponent.AnyDirectories)
        index = after
      } else {
        mut tokens.push(GlobToken.AnyCharacters)
        index = next
      }
    } else if decoded.character == Character"?" {
      mut tokens.push(GlobToken.AnyCharacter)
      index = next
    } else if decoded.character == Character"[" {
      let class = parse_class(pattern, from: index)?
      mut tokens.push(class.token.copy())
      index = class.end
    } else if decoded.character == Character"\\" {
      if next >= pattern.length() {
        return Err(GlobError(offset: index))
      }
      let escaped = pattern.decode(next)
      mut tokens.push(GlobToken.Literal(character: escaped.character))
      index = next + escaped.length
    } else {
      mut tokens.push(GlobToken.Literal(character: decoded.character))
      index = next
    }
  }
  if !tokens.is_empty() {
    mut components.push(GlobComponent.Name(tokens: own tokens))
  }
  Ok(Glob(components: own components, absolute: pattern.length() > 0 && pattern.byte(0) == 47))
}

public fn Glob.matches(self, path: Path) -> Bool
  cost time finite
{
  if self.absolute != path.is_absolute() {
    return false
  }
  var names: List[String] = []
  for name in path.components() {
    mut names.push(name.to_string())
  }
  wildcard_matches(
    self.components.length(),
    text_length: names.length(),
    is_wildcard: fn(index) { self.components[index] is AnyDirectories },
    matches_one: fn(index, position) {
      match self.components[index] {
        AnyDirectories => false
        Name(tokens) => name_matches(tokens.slice(), name: names[position].slice())
      }
    },
  )
}

public fn Glob.find(self, root: Path) -> Result[List[Path], SystemError]
  uses FileRead
{
  var paths: List[Path] = []
  for entry in walk(root)? {
    let matches = if self.absolute {
      self.matches(entry.path)
    } else {
      match entry.path.relative_to(root) {
        Some(relative) => self.matches(relative)
        None => false
      }
    }
    if entry.depth > 0 && matches {
      mut paths.push(entry.path.copy())
    }
  }
  Ok(own paths)
}

public type GlobError(offset: USize)
  derives Equal

impl Display for GlobError {
  fn display(self, output: mut TextBuilder) {
    mut output.write("the glob is not valid at byte ")
    self.offset.display(mut output)
  }
}

public type FilesWithin(root: Path)

impl FileRead for FilesWithin
  uses FileRead
{
  fn read(self, file: Path) -> Result[List[UInt8], SystemError] {
    FileRead.read(self.root.join_confined(file)?)
  }

  fn read_text(self, file: Path) -> Result[String, SystemError] {
    FileRead.read_text(self.root.join_confined(file)?)
  }

  fn open(self, file: Path) -> Result[FileReader, SystemError] {
    FileRead.open(self.root.join_confined(file)?)
  }

  fn metadata(self, path: Path, follow_links: Bool) -> Result[Metadata, SystemError] {
    FileRead.metadata(self.root.join_confined(path)?, follow_links: follow_links)
  }

  fn list(self, directory: Path) -> Result[List[DirectoryEntry], SystemError] {
    FileRead.list(self.root.join_confined(directory)?)
  }

  fn read_link(self, link: Path) -> Result[Path, SystemError] {
    FileRead.read_link(self.root.join_confined(link)?)
  }

  fn resolve(self, path: Path) -> Result[Path, SystemError] {
    let root = FileRead.resolve(self.root)?
    let resolved = FileRead.resolve(self.root.join_confined(path)?)?
    match resolved.relative_to(root) {
      Some(relative) => Ok(own relative)
      None => Err(SystemError.PermissionDenied)
    }
  }
}

impl FileWrite for FilesWithin
  uses FileWrite
{
  fn write(self, file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError] {
    FileWrite.write(self.root.join_confined(file)?, contents: contents)
  }

  fn write_text(self, file: Path, contents: StringSlice) -> Result[Unit, SystemError] {
    FileWrite.write_text(self.root.join_confined(file)?, contents: contents)
  }

  fn open(self, file: Path, mode: WriteMode) -> Result[File, SystemError] {
    FileWrite.open(self.root.join_confined(file)?, mode: mode)
  }

  fn create_directory(self, directory: Path) -> Result[Unit, SystemError] {
    FileWrite.create_directory(self.root.join_confined(directory)?)
  }

  fn remove(self, path: Path) -> Result[Unit, SystemError] {
    FileWrite.remove(self.root.join_confined(path)?)
  }

  fn rename(self, from: Path, to: Path) -> Result[Unit, SystemError] {
    FileWrite.rename(self.root.join_confined(from)?, to: self.root.join_confined(to)?)
  }

  fn link(self, target: Path, link: Path, kind: LinkKind) -> Result[Unit, SystemError] {
    FileWrite.link(self.root.join_confined(target)?, link: self.root.join_confined(link)?, kind: kind)
  }

  fn set_permissions(self, path: Path, permissions: Permissions) -> Result[Unit, SystemError] {
    FileWrite.set_permissions(self.root.join_confined(path)?, permissions: permissions)
  }

  fn set_modified(self, path: Path, time: Instant) -> Result[Unit, SystemError] {
    FileWrite.set_modified(self.root.join_confined(path)?, time: time)
  }
}

public type ReadOnlyFiles()

impl FileWrite for ReadOnlyFiles {
  fn write(self, file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn write_text(self, file: Path, contents: StringSlice) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn open(self, file: Path, mode: WriteMode) -> Result[File, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn create_directory(self, directory: Path) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn remove(self, path: Path) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn rename(self, from: Path, to: Path) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn link(self, target: Path, link: Path, kind: LinkKind) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn set_permissions(self, path: Path, permissions: Permissions) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }

  fn set_modified(self, path: Path, time: Instant) -> Result[Unit, SystemError] {
    Err(SystemError.PermissionDenied)
  }
}

type InodeKind =
  | Bytes(contents: List[UInt8])
  | Directory
  | Link(target: Path)

type Inode(kind: InodeKind, permissions: Permissions, modified: Instant, link_count: USize)

type OpenFile(handle: UInt64, inode: UInt64, position: UInt64, readable: Bool, writable: Bool, appending: Bool)

type Located(path: Path, inode: Option[UInt64])

type Named(path: Path, inode: UInt64)

type Renamed(from: Path, to: Path, inode: UInt64)

let last_console_handle: UInt64 = 2

let followed_links_limit: USize = 32

let largest_file: USize = 1073741824

public opaque type MemoryFiles(
  names: Map[Path, UInt64],
  inodes: Map[UInt64, Inode],
  open_files: List[OpenFile],
  inodes_made: UInt64,
  handles_made: UInt64,
  time: Instant,
)

public fn MemoryFiles.new() -> MemoryFiles {
  var files = MemoryFiles(
    names: [:],
    inodes: [:],
    open_files: [],
    inodes_made: 0,
    handles_made: last_console_handle,
    time: Instant.epoch,
  )
  let root = mut files.add_inode(InodeKind.Directory, permissions: Permissions.from_mode(0o755))
  mut files.names.insert(Path.new("/"), value: root)
  files
}

public fn MemoryFiles.with_text(own self, file: Path, contents: StringSlice) -> MemoryFiles {
  own self.with_bytes(file, contents: contents.bytes())
}

public fn MemoryFiles.with_bytes(own self, file: Path, contents: Slice[UInt8]) -> MemoryFiles {
  var changed = own self
  var directory = Path.new("/")
  var components = reversed_components(file)
  while mut components.pop() is Some(name) {
    let path = directory.join(name.slice())
    mut changed.remove_tree(path, keep_directory: !components.is_empty())
    if components.is_empty() {
      let inode = mut changed.add_inode(
        InodeKind.Bytes(contents: contents.to_list()),
        permissions: Permissions.from_mode(0o644),
      )
      mut changed.names.insert(own path, value: inode)
    } else {
      if !changed.names.contains(path) {
        let inode = mut changed.add_inode(InodeKind.Directory, permissions: Permissions.from_mode(0o755))
        mut changed.names.insert(path.copy(), value: inode)
      }
      directory = own path
    }
  }
  changed
}

public fn MemoryFiles.contents(self, file: Path) -> Option[List[UInt8]] {
  match self.read_bytes(file) {
    Ok(bytes) => Some(own bytes)
    Err(_) => None
  }
}

public fn MemoryFiles.text(self, file: Path) -> Option[String] {
  match self.read_bytes(file) {
    Ok(bytes) => match String.from_utf8(own bytes) {
      Ok(text) => Some(own text)
      Err(_) => None
    }
    Err(_) => None
  }
}

public fn MemoryFiles.paths(self) -> List[Path] {
  var paths: List[Path] = []
  for entry in self.names {
    if self.kind_of(entry.value) == Some(FileKind.File) {
      mut paths.push(entry.key.copy())
    }
  }
  paths
}

internal fn MemoryFiles.set_time(mut self, now: Instant) {
  self.time = now
}

fn reversed_components(path: Path) -> List[String] {
  var components: List[String] = []
  for component in path.components() {
    mut components.push(component.to_string())
  }
  mut components.reverse()
  components
}

fn offset_from(base: UInt64, by: Int64) -> Option[UInt64] {
  if by >= 0 {
    base.checked_add(by.to_unsigned_bits())
  } else {
    base.checked_subtract(by.unsigned_absolute())
  }
}

fn overwrite(contents: mut List[UInt8], at: UInt64, bytes: Slice[UInt8]) -> Result[Unit, SystemError] {
  let limit: UInt64 = intrinsic::convert(largest_file)
  if at > limit || bytes.length() > largest_file {
    return Err(SystemError.OutOfStorage)
  }
  let start: USize = intrinsic::convert(at)
  while contents.length() < start {
    mut contents.push(0)
  }
  for index in 0..bytes.length() {
    let position = start + index
    if position < contents.length() {
      contents[position] = bytes[index]
    } else {
      mut contents.push(bytes[index])
    }
  }
  Ok(Unit)
}

internal fn MemoryFiles.add_inode(mut self, kind: own InodeKind, permissions: Permissions) -> UInt64 {
  self.inodes_made = self.inodes_made.saturating_add(1)
  mut self.inodes.insert(
    self.inodes_made,
    value: Inode(kind: own kind, permissions: permissions, modified: self.time, link_count: 1),
  )
  self.inodes_made
}

internal fn MemoryFiles.kind_of(self, inode: UInt64) -> Option[FileKind] {
  match self.inodes.get(inode) {
    Some(entry) => match entry.kind {
      Bytes(_) => Some(FileKind.File)
      Directory => Some(FileKind.Directory)
      Link(_) => Some(FileKind.SymbolicLink)
    }
    None => None
  }
}

internal fn MemoryFiles.locate(self, path: Path, follow_last: Bool) -> Result[Located, SystemError] {
  var unresolved = reversed_components(path)
  var current = Path.new("/")
  var followed: USize = 0
  while mut unresolved.pop() is Some(name) {
    if name == "." {
      continue
    }
    if name == ".." {
      current = current.parent().unwrap_or(Path.new("/"))
      continue
    }
    let candidate = current.join(name.slice())
    let inode = match self.names.get(candidate) {
      Some(number) => number
      None => {
        if unresolved.is_empty() {
          return Ok(Located(path: own candidate, inode: None))
        }
        return Err(SystemError.NotFound)
      }
    }
    match self.inodes.get(inode) {
      Some(entry) => match entry.kind {
        Link(target) => {
          if unresolved.is_empty() && !follow_last {
            return Ok(Located(path: own candidate, inode: Some(inode)))
          }
          if followed >= followed_links_limit {
            return Err(SystemError.InvalidInput)
          }
          followed += 1
          mut unresolved.append(reversed_components(target))
          if target.is_absolute() {
            current = Path.new("/")
          }
        }
        Directory => {
          current = own candidate
        }
        Bytes(_) => {
          if !unresolved.is_empty() {
            return Err(SystemError.NotADirectory)
          }
          current = own candidate
        }
      }
      None => return Err(SystemError.NotFound)
    }
  }
  let inode = match self.names.get(current) {
    Some(number) => Some(number)
    None => None
  }
  Ok(Located(path: own current, inode: inode))
}

internal fn MemoryFiles.existing(self, path: Path, follow_last: Bool) -> Result[UInt64, SystemError] {
  match self.locate(path, follow_last: follow_last)?.inode {
    Some(inode) => Ok(inode)
    None => Err(SystemError.NotFound)
  }
}

internal fn MemoryFiles.has_entries(self, directory: Path) -> Bool {
  for entry in self.names {
    if entry.key.parent() is Some(parent) && parent == directory {
      return true
    }
  }
  false
}

internal fn MemoryFiles.is_open(self, inode: UInt64) -> Bool {
  for open in self.open_files {
    if open.inode == inode {
      return true
    }
  }
  false
}

internal fn MemoryFiles.forget_if_unreachable(mut self, inode: UInt64) {
  let unnamed = match self.inodes.get(inode) {
    Some(unnamed) => unnamed.link_count == 0
    None => false
  }
  if unnamed && !self.is_open(inode) {
    mut self.inodes.remove(inode)
  }
}

internal fn MemoryFiles.remove_name(mut self, path: Path, inode: UInt64) {
  mut self.names.remove(path)
  match mut self.inodes.take(inode) {
    Some(entry) => {
      var changed = own entry
      changed.link_count = changed.link_count.saturating_subtract(1)
      mut self.inodes.insert(inode, value: own changed)
    }
    None => {}
  }
  mut self.forget_if_unreachable(inode)
}

internal fn MemoryFiles.remove_tree(mut self, path: Path, keep_directory: Bool) {
  var removed: List[Named] = []
  for entry in self.names {
    let is_directory = self.kind_of(entry.value) == Some(FileKind.Directory)
    let removes_entry = if entry.key == path {
      !(keep_directory && is_directory)
    } else {
      !keep_directory && entry.key.starts_with(path)
    }
    if removes_entry {
      mut removed.push(Named(path: entry.key.copy(), inode: entry.value))
    }
  }
  for name in removed {
    mut self.remove_name(name.path, inode: name.inode)
  }
}

internal fn MemoryFiles.read_bytes(self, file: Path) -> Result[List[UInt8], SystemError] {
  let inode = self.existing(file, follow_last: true)?
  match self.inodes.get(inode) {
    Some(entry) => match entry.kind {
      Bytes(contents) => {
        if (entry.permissions.mode() & 0o444) == 0 {
          return Err(SystemError.PermissionDenied)
        }
        Ok(contents.copy())
      }
      Directory => Err(SystemError.IsADirectory)
      Link(_) => Err(SystemError.NotFound)
    }
    None => Err(SystemError.NotFound)
  }
}

internal fn MemoryFiles.replace_contents(mut self, inode: UInt64, contents: own List[UInt8]) -> Result[Unit, SystemError] {
  match mut self.inodes.take(inode) {
    Some(entry) => {
      var changed = own entry
      let outcome: Result[Unit, SystemError] = match changed.kind {
        Bytes(_) => if changed.permissions.is_read_only() { Err(SystemError.PermissionDenied) } else { Ok(Unit) }
        Directory => Err(SystemError.IsADirectory)
        Link(_) => Err(SystemError.NotFound)
      }
      if outcome is Ok(_) {
        changed.kind = InodeKind.Bytes(contents: own contents)
        changed.modified = self.time
      }
      mut self.inodes.insert(inode, value: own changed)
      outcome
    }
    None => Err(SystemError.NotFound)
  }
}

internal fn MemoryFiles.write_bytes(mut self, file: Path, contents: own List[UInt8]) -> Result[Unit, SystemError] {
  let located = self.locate(file, follow_last: true)?
  match located.inode {
    Some(inode) => mut self.replace_contents(inode, contents: own contents)
    None => {
      let inode = mut self.add_inode(InodeKind.Bytes(contents: own contents), permissions: Permissions.from_mode(0o644))
      mut self.names.insert(own located.path, value: inode)
      Ok(Unit)
    }
  }
}

internal fn MemoryFiles.change_inode(
  mut self,
  path: Path,
  permissions: Option[Permissions],
  modified: Option[Instant],
) -> Result[Unit, SystemError] {
  let inode = self.existing(path, follow_last: true)?
  match mut self.inodes.take(inode) {
    Some(entry) => {
      var changed = own entry
      if permissions is Some(new_permissions) {
        changed.permissions = new_permissions
      }
      if modified is Some(new_time) {
        changed.modified = new_time
      }
      mut self.inodes.insert(inode, value: own changed)
      Ok(Unit)
    }
    None => Err(SystemError.NotFound)
  }
}

internal fn MemoryFiles.metadata_of(self, inode: UInt64) -> Result[Metadata, SystemError] {
  match self.inodes.get(inode) {
    Some(entry) => {
      let length: USize = match entry.kind {
        Bytes(contents) => contents.length()
        Directory => 0
        Link(target) => target.bytes().length()
      }
      let kind = match entry.kind {
        Bytes(_) => FileKind.File
        Directory => FileKind.Directory
        Link(_) => FileKind.SymbolicLink
      }
      Ok(Metadata(
        kind: kind,
        length: intrinsic::convert(length),
        permissions: entry.permissions,
        modified: entry.modified,
        accessed: None,
        created: None,
      ))
    }
    None => Err(SystemError.NotFound)
  }
}

internal fn MemoryFiles.add_open_file(mut self, inode: UInt64, readable: Bool, writable: Bool, appending: Bool) -> UInt64 {
  self.handles_made = self.handles_made.saturating_add(1)
  mut self.open_files.push(
    OpenFile(
      handle: self.handles_made,
      inode: inode,
      position: 0,
      readable: readable,
      writable: writable,
      appending: appending,
    ),
  )
  self.handles_made
}

internal fn MemoryFiles.open_file_index(self, handle: streams::Handle) -> Option[USize]
  ensures !(result is Some(index) && index >= self.open_files.length())
{
  let number = handle.number()
  self.open_files.slice().find_index(fn(open) { open.handle == number })
}

internal fn MemoryFiles.length_of(self, inode: UInt64) -> UInt64 {
  match self.inodes.get(inode) {
    Some(entry) => match entry.kind {
      Bytes(contents) => intrinsic::convert(contents.length())
      _ => 0
    }
    None => 0
  }
}

internal fn MemoryFiles.copy_out(self, inode: UInt64, from: UInt64, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
  ensures !(result is Ok(count) && (count > limit || buffer.length() != old(buffer.length()) + count))
  ensures !(result is Err(_) && buffer.length() != old(buffer.length()))
{
  match self.inodes.get(inode) {
    Some(entry) => match entry.kind {
      Bytes(contents) => {
        let length: UInt64 = intrinsic::convert(contents.length())
        if from >= length {
          return Ok(0)
        }
        let start: USize = intrinsic::convert(from)
        let available = contents.length() - start
        let count = if limit < available { limit } else { available }
        mut buffer.append_slice(contents.slice_range(start, stop: start + count))
        Ok(count)
      }
      Directory => Err(SystemError.IsADirectory)
      Link(_) => Err(SystemError.InvalidInput)
    }
    None => Err(SystemError.Closed)
  }
}

internal fn MemoryFiles.copy_in(mut self, inode: UInt64, at: UInt64, bytes: Slice[UInt8]) -> Result[Unit, SystemError]
  ensures self.open_files.length() == old(self.open_files.length())
{
  match mut self.inodes.take(inode) {
    Some(entry) => {
      var changed = own entry
      let outcome: Result[Unit, SystemError] = match mut changed.kind {
        Bytes(contents) => overwrite(mut contents, at: at, bytes: bytes)
        Directory => Err(SystemError.IsADirectory)
        Link(_) => Err(SystemError.InvalidInput)
      }
      changed.modified = self.time
      mut self.inodes.insert(inode, value: own changed)
      outcome
    }
    None => Err(SystemError.Closed)
  }
}

internal fn MemoryFiles.resize(mut self, inode: UInt64, length: UInt64) -> Result[Unit, SystemError] {
  let limit: UInt64 = intrinsic::convert(largest_file)
  if length > limit {
    return Err(SystemError.OutOfStorage)
  }
  let wanted: USize = intrinsic::convert(length)
  match mut self.inodes.take(inode) {
    Some(entry) => {
      var changed = own entry
      let outcome: Result[Unit, SystemError] = match mut changed.kind {
        Bytes(contents) => {
          if wanted < contents.length() {
            mut contents.truncate(wanted)
          }
          while contents.length() < wanted {
            mut contents.push(0)
          }
          Ok(Unit)
        }
        Directory => Err(SystemError.IsADirectory)
        Link(_) => Err(SystemError.InvalidInput)
      }
      changed.modified = self.time
      mut self.inodes.insert(inode, value: own changed)
      outcome
    }
    None => Err(SystemError.Closed)
  }
}

internal fn MemoryFiles.open_to_read(mut self, file: Path) -> Result[UInt64, SystemError] {
  let inode = self.existing(file, follow_last: true)?
  if self.kind_of(inode) == Some(FileKind.Directory) {
    return Err(SystemError.IsADirectory)
  }
  if (self.metadata_of(inode)?.permissions.mode() & 0o444) == 0 {
    return Err(SystemError.PermissionDenied)
  }
  Ok(mut self.add_open_file(inode, readable: true, writable: false, appending: false))
}

internal fn MemoryFiles.open_to_write(mut self, file: Path, mode: WriteMode) -> Result[UInt64, SystemError] {
  let located = self.locate(file, follow_last: true)?
  let inode = match located.inode {
    Some(existing) => {
      if mode == WriteMode.CreateNew {
        return Err(SystemError.AlreadyExists)
      }
      if self.kind_of(existing) == Some(FileKind.Directory) {
        return Err(SystemError.IsADirectory)
      }
      if self.metadata_of(existing)?.permissions.is_read_only() {
        return Err(SystemError.PermissionDenied)
      }
      if mode == WriteMode.Replace {
        mut self.replace_contents(existing, contents: [])?
      }
      existing
    }
    None => {
      let inode = mut self.add_inode(InodeKind.Bytes(contents: []), permissions: Permissions.from_mode(0o644))
      mut self.names.insert(own located.path, value: inode)
      inode
    }
  }
  let handle = mut self.add_open_file(
    inode,
    readable: mode == WriteMode.Update,
    writable: true,
    appending: mode == WriteMode.Append,
  )
  Ok(handle)
}

impl FileRead for MemoryFiles {
  fn read(self, file: Path) -> Result[List[UInt8], SystemError] {
    self.read_bytes(file)
  }

  fn read_text(self, file: Path) -> Result[String, SystemError] {
    match String.from_utf8(self.read_bytes(file)?) {
      Ok(text) => Ok(own text)
      Err(_) => Err(SystemError.InvalidData)
    }
  }

  fn open(mut self, file: Path) -> Result[FileReader, SystemError] {
    Ok(FileReader.opened(mut self.open_to_read(file)?))
  }

  fn metadata(self, path: Path, follow_links: Bool) -> Result[Metadata, SystemError] {
    self.metadata_of(self.existing(path, follow_last: follow_links)?)
  }

  fn list(self, directory: Path) -> Result[List[DirectoryEntry], SystemError] {
    let located = self.locate(directory, follow_last: true)?
    let inode = match located.inode {
      Some(number) => number
      None => return Err(SystemError.NotFound)
    }
    if self.kind_of(inode) != Some(FileKind.Directory) {
      return Err(SystemError.NotADirectory)
    }
    var entries: List[DirectoryEntry] = []
    for entry in self.names {
      if entry.key.parent() is Some(parent) && parent == located.path {
        if entry.key.file_name() is Some(name) && self.kind_of(entry.value) is Some(kind) {
          mut entries.push(DirectoryEntry(name: name.to_string(), kind: kind))
        }
      }
    }
    Ok(own entries)
  }

  fn read_link(self, link: Path) -> Result[Path, SystemError] {
    let inode = self.existing(link, follow_last: false)?
    match self.inodes.get(inode) {
      Some(entry) => match entry.kind {
        Link(target) => Ok(target.copy())
        _ => Err(SystemError.InvalidInput)
      }
      None => Err(SystemError.NotFound)
    }
  }

  fn resolve(self, path: Path) -> Result[Path, SystemError] {
    let located = self.locate(path, follow_last: true)?
    match located.inode {
      Some(_) => Ok(own located.path)
      None => Err(SystemError.NotFound)
    }
  }
}

impl FileWrite for MemoryFiles {
  fn write(mut self, file: Path, contents: Slice[UInt8]) -> Result[Unit, SystemError] {
    mut self.write_bytes(file, contents: contents.to_list())
  }

  fn write_text(mut self, file: Path, contents: StringSlice) -> Result[Unit, SystemError] {
    mut self.write_bytes(file, contents: contents.to_bytes())
  }

  fn open(mut self, file: Path, mode: WriteMode) -> Result[File, SystemError] {
    Ok(File.opened(mut self.open_to_write(file, mode: mode)?))
  }

  fn create_directory(mut self, directory: Path) -> Result[Unit, SystemError] {
    let located = self.locate(directory, follow_last: false)?
    if located.inode is Some(_) {
      return Err(SystemError.AlreadyExists)
    }
    let inode = mut self.add_inode(InodeKind.Directory, permissions: Permissions.from_mode(0o755))
    mut self.names.insert(own located.path, value: inode)
    Ok(Unit)
  }

  fn remove(mut self, path: Path) -> Result[Unit, SystemError] {
    let located = self.locate(path, follow_last: false)?
    let inode = match located.inode {
      Some(number) => number
      None => return Err(SystemError.NotFound)
    }
    if located.path == Path.new("/") {
      return Err(SystemError.PermissionDenied)
    }
    if self.kind_of(inode) == Some(FileKind.Directory) && self.has_entries(located.path) {
      return Err(SystemError.DirectoryNotEmpty)
    }
    mut self.remove_name(located.path, inode: inode)
    Ok(Unit)
  }

  fn rename(mut self, from: Path, to: Path) -> Result[Unit, SystemError] {
    let source = self.locate(from, follow_last: false)?
    let moved = match source.inode {
      Some(number) => number
      None => return Err(SystemError.NotFound)
    }
    let target = self.locate(to, follow_last: false)?
    if source.path == target.path {
      return Ok(Unit)
    }
    if source.path == Path.new("/") || target.path.starts_with(source.path) {
      return Err(SystemError.InvalidInput)
    }
    let moves_directory = self.kind_of(moved) == Some(FileKind.Directory)
    if target.inode is Some(replaced) {
      let replaces_directory = self.kind_of(replaced) == Some(FileKind.Directory)
      if moves_directory && !replaces_directory {
        return Err(SystemError.NotADirectory)
      }
      if !moves_directory && replaces_directory {
        return Err(SystemError.IsADirectory)
      }
      if replaces_directory && self.has_entries(target.path) {
        return Err(SystemError.DirectoryNotEmpty)
      }
      mut self.remove_name(target.path, inode: replaced)
    }
    var renamed: List[Renamed] = []
    for entry in self.names {
      if entry.key == source.path {
        mut renamed.push(Renamed(from: entry.key.copy(), to: target.path.copy(), inode: entry.value))
      } else if entry.key.relative_to(source.path) is Some(below) {
        mut renamed.push(Renamed(from: entry.key.copy(), to: target.path.join_path(below), inode: entry.value))
      }
    }
    for name in renamed {
      mut self.names.remove(name.from)
      mut self.names.insert(name.to.copy(), value: name.inode)
    }
    Ok(Unit)
  }

  fn link(mut self, target: Path, link: Path, kind: LinkKind) -> Result[Unit, SystemError] {
    let located = self.locate(link, follow_last: false)?
    if located.inode is Some(_) {
      return Err(SystemError.AlreadyExists)
    }
    match kind {
      Symbolic => {
        let inode = mut self.add_inode(InodeKind.Link(target: target.copy()), permissions: Permissions.from_mode(0o777))
        mut self.names.insert(own located.path, value: inode)
        Ok(Unit)
      }
      Hard => {
        let inode = self.existing(target, follow_last: false)?
        if self.kind_of(inode) == Some(FileKind.Directory) {
          return Err(SystemError.PermissionDenied)
        }
        match mut self.inodes.take(inode) {
          Some(entry) => {
            var changed = own entry
            changed.link_count = changed.link_count.saturating_add(1)
            mut self.inodes.insert(inode, value: own changed)
          }
          None => return Err(SystemError.NotFound)
        }
        mut self.names.insert(own located.path, value: inode)
        Ok(Unit)
      }
    }
  }

  fn set_permissions(mut self, path: Path, permissions: Permissions) -> Result[Unit, SystemError] {
    mut self.change_inode(path, permissions: Some(permissions), modified: None)
  }

  fn set_modified(mut self, path: Path, time: Instant) -> Result[Unit, SystemError] {
    mut self.change_inode(path, permissions: None, modified: Some(time))
  }
}

impl Handles for MemoryFiles {
  fn read(mut self, handle: streams::Handle, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    if !self.open_files[index].readable {
      return Err(SystemError.InvalidInput)
    }
    let count = self.copy_out(
      self.open_files[index].inode,
      from: self.open_files[index].position,
      buffer: mut buffer,
      limit: limit,
    )?
    self.open_files[index].position = self.open_files[index].position.saturating_add(intrinsic::convert(count))
    Ok(count)
  }

  fn write(mut self, handle: streams::Handle, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    if !self.open_files[index].writable {
      return Err(SystemError.InvalidInput)
    }
    let inode = self.open_files[index].inode
    let at = if self.open_files[index].appending { self.length_of(inode) } else { self.open_files[index].position }
    mut self.copy_in(inode, at: at, bytes: bytes)?
    self.open_files[index].position = at.saturating_add(intrinsic::convert(bytes.length()))
    Ok(bytes.length())
  }

  fn read_at(
    mut self,
    handle: streams::Handle,
    offset: UInt64,
    buffer: mut List[UInt8],
    limit: USize,
  ) -> Result[USize, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    if !self.open_files[index].readable {
      return Err(SystemError.InvalidInput)
    }
    self.copy_out(self.open_files[index].inode, from: offset, buffer: mut buffer, limit: limit)
  }

  fn write_at(mut self, handle: streams::Handle, offset: UInt64, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    if !self.open_files[index].writable {
      return Err(SystemError.InvalidInput)
    }
    let inode = self.open_files[index].inode
    mut self.copy_in(inode, at: offset, bytes: bytes)?
    Ok(bytes.length())
  }

  fn seek(mut self, handle: streams::Handle, to: streams::Position) -> Result[UInt64, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    let position = match to {
      FromStart(offset) => Some(offset)
      FromCurrent(offset) => offset_from(self.open_files[index].position, by: offset)
      FromEnd(offset) => offset_from(self.length_of(self.open_files[index].inode), by: offset)
    }
    match position {
      Some(new_position) => {
        self.open_files[index].position = new_position
        Ok(new_position)
      }
      None => Err(SystemError.InvalidInput)
    }
  }

  fn set_length(mut self, handle: streams::Handle, length: UInt64) -> Result[Unit, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    if !self.open_files[index].writable {
      return Err(SystemError.InvalidInput)
    }
    let inode = self.open_files[index].inode
    mut self.resize(inode, length: length)
  }

  fn synchronize(mut self, handle: streams::Handle) -> Result[Unit, SystemError] {
    match self.open_file_index(handle) {
      Some(_) => Ok(Unit)
      None => Err(SystemError.Closed)
    }
  }

  fn metadata(mut self, handle: streams::Handle) -> Result[Metadata, SystemError] {
    match self.open_file_index(handle) {
      Some(index) => self.metadata_of(self.open_files[index].inode)
      None => Err(SystemError.Closed)
    }
  }

  fn close(mut self, handle: own streams::Handle) -> Result[Unit, SystemError] {
    let index = match self.open_file_index(handle) {
      Some(index) => index
      None => return Err(SystemError.Closed)
    }
    let closed = mut self.open_files.swap_remove(index)
    mut self.forget_if_unreachable(closed.inode)
    Ok(Unit)
  }

  fn shut_down(mut self, handle: streams::Handle, direction: network::Direction) -> Result[Unit, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn set_timeout(
    mut self,
    handle: streams::Handle,
    direction: network::Direction,
    timeout: Option[Duration],
  ) -> Result[Unit, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn accept(mut self, listener: streams::Handle) -> Result[network::Accepted, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn send_to(
    mut self,
    socket: streams::Handle,
    bytes: Slice[UInt8],
    address: network::SocketAddress,
  ) -> Result[USize, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn receive_from(
    mut self,
    socket: streams::Handle,
    buffer: mut List[UInt8],
    limit: USize,
  ) -> Result[network::Datagram, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn wait(mut self, process: streams::Handle) -> Result[processes::ExitStatus, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn signal(mut self, process: streams::Handle, signal: processes::Signal) -> Result[Unit, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn terminal_size(mut self, terminal: streams::Handle) -> Result[console::Size, SystemError] {
    Err(SystemError.Unsupported)
  }

  fn set_raw_mode(mut self, terminal: streams::Handle, enabled: Bool) -> Result[Unit, SystemError] {
    Err(SystemError.Unsupported)
  }
}
