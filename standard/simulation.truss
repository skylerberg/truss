impl Clock for World
  uses Panic
{
  fn now(self) -> Instant {
    provide self.tasks {
      Tasks.yield_now()
      self.start + self.tasks.elapsed()
    }
  }

  fn monotonic(self) -> Duration {
    provide self.tasks {
      Tasks.yield_now()
      self.tasks.elapsed()
    }
  }

  fn sleep(self, duration: Duration) {
    provide self.tasks {
      self.tasks.sleep(duration)
    }
  }
}

impl Random for World
  uses Panic
{
  fn next(self) -> UInt64 {
    self.preemption_point()
    intrinsic::shared_update(self.state, input: 0, change: fn(state, _) {
      mut state.generator.next()
    })
  }
}

