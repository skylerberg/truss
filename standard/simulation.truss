impl Tasks for World
  uses Panic
{
  fn open(self) -> UInt64 {
    provide self.tasks {
      Tasks.open()
    }
  }

  fn spawn(self, task_group: UInt64, work: own fn(UInt64), item: UInt64) -> Bool {
    provide self.tasks {
      Tasks.spawn(task_group, work: work, item: item)
    }
  }

  fn join(self, task_group: UInt64) {
    provide self.tasks {
      Tasks.join(task_group)
    }
  }

  fn cancel(self, task_group: UInt64) -> Bool {
    provide self.tasks {
      Tasks.cancel(task_group)
    }
  }

  fn cancelled(self) -> Bool {
    provide self.tasks {
      Tasks.cancelled()
    }
  }

  fn watch(self, key: UInt64) -> UInt64 {
    provide self.tasks {
      Tasks.watch(key)
    }
  }

  fn wait(self, key: UInt64, ticket: UInt64, reason: StringSlice) {
    provide self.tasks {
      Tasks.wait(key, ticket: ticket, reason: reason)
    }
  }

  fn wake(self, key: UInt64) {
    provide self.tasks {
      Tasks.wake(key)
    }
  }

  fn lock(self, mutex: UInt64) {
    provide self.tasks {
      Tasks.lock(mutex)
    }
  }

  fn unlock(self, mutex: UInt64) {
    provide self.tasks {
      Tasks.unlock(mutex)
    }
  }

  fn yield_now(self) {
    provide self.tasks {
      Tasks.yield_now()
    }
  }
}

