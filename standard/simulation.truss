use standard::console
use standard::environment
use standard::files
use standard::log
use standard::network
use standard::processes
use standard::random
use standard::streams

public type Operation = Open | Read | Write | Connect | Accept | Resolve | Spawn
  derives Equal, Hash

type Fault(operation: Operation, error: SystemError)

public opaque type World(
  files: files::MemoryFiles,
  console: console::CapturedConsole,
  log: log::CapturedLog,
  environment: environment::FixedEnvironment,
  generator: random::Generator,
  now: Instant,
  elapsed: Duration,
  hosts: Map[String, network::IpAddress],
  programs: Map[String, fn(processes::Command) -> processes::Output],
  faults: List[Fault],
  pending_signals: List[processes::Signal],
  next_handle: UInt64,
)

public fn World.new(seed: UInt64 = 0) -> World {
  todo
}

public fn World.with_file(own self, path: Path, contents: StringSlice) -> World {
  todo
}

public fn World.with_variable(own self, name: StringSlice, value: StringSlice) -> World {
  todo
}

public fn World.with_input(own self, lines: own List[String]) -> World {
  todo
}

public fn World.with_host(own self, name: StringSlice, address: network::IpAddress) -> World {
  todo
}

public fn World.with_program(
  own self,
  name: StringSlice,
  respond: own fn(processes::Command) -> processes::Output,
) -> World {
  todo
}

public fn World.with_time(own self, now: Instant) -> World {
  todo
}

public fn World.output(self) -> StringSlice
  cost time O(1)
{
  self.console.output()
}

public fn World.errors(self) -> StringSlice
  cost time O(1)
{
  self.console.errors()
}

public fn World.records(self) -> Slice[log::Record]
  cost time O(1)
{
  self.log.records.slice()
}

public fn World.file_text(self, path: Path) -> Option[String] {
  self.files.text(path)
}

public fn World.file_bytes(self, path: Path) lends Option[List[UInt8]] {
  todo
}

public fn World.now(self) -> Instant
  cost time O(1)
{
  self.now
}

public fn World.advance(mut self, by: Duration)
  requires !by.is_negative()
{
  todo
}

public fn World.fail_next(mut self, operation: Operation, error: SystemError) {
  mut self.faults.push(Fault(operation: operation, error: error.copy()))
}

public fn World.deliver(mut self, signal: processes::Signal) {
  mut self.pending_signals.push(signal.copy())
}

