public type Form = Composed | Decomposed | CompatibilityComposed | CompatibilityDecomposed
  derives Equal

public type Category =
  | Letter
  | Mark
  | Number
  | Punctuation
  | Symbol
  | Separator
  | Control
  | Format
  | Surrogate
  | PrivateUse
  | Unassigned
  derives Equal, Hash

