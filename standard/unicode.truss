use standard::console
use standard::text::string_slice
use standard::text::unicode_tables

public type Form = Composed | Decomposed | CompatibilityComposed | CompatibilityDecomposed
  derives Equal

public type Category =
  | Letter
  | Mark
  | Number
  | Punctuation
  | Symbol
  | Separator
  | Control
  | Format
  | Surrogate
  | PrivateUse
  | Unassigned
  derives Equal, Hash

fn is_compatibility(form: Form) -> Bool
  cost time O(1)
{
  match form {
    Composed => false
    Decomposed => false
    CompatibilityComposed => true
    CompatibilityDecomposed => true
  }
}

fn is_composed(form: Form) -> Bool
  cost time O(1)
{
  match form {
    Composed => true
    Decomposed => false
    CompatibilityComposed => true
    CompatibilityDecomposed => false
  }
}

fn first_changed_code(form: Form) -> UInt32
  cost time O(1)
{
  match form {
    Composed => 768
    Decomposed => 192
    CompatibilityComposed => 160
    CompatibilityDecomposed => 160
  }
}

fn is_below(text: StringSlice, limit: UInt32) -> Bool
  cost time finite
{
  for character in text.characters() {
    if character.code() >= limit {
      return false
    }
  }
  true
}

fn append_decomposition(codes: mut List[UInt32], code: UInt32, compatible: Bool)
  cost time finite
{
  if code < 160 {
    mut codes.push(code)
  } else if code >= 44032 && code < 55204 {
    let syllable = code - 44032
    mut codes.push(4352 + syllable / 588)
    mut codes.push(4449 + syllable % 588 / 28)
    if syllable % 28 != 0 {
      mut codes.push(4519 + syllable % 28)
    }
  } else {
    var decomposed = false
    if compatible {
      decomposed = unicode_tables::append_compatibility_decomposition(mut codes, code: code)
    }
    if !decomposed {
      decomposed = unicode_tables::append_canonical_decomposition(mut codes, code: code)
    }
    if !decomposed {
      mut codes.push(code)
    }
  }
}

fn with_combining_classes(codes: Slice[UInt32]) -> List[UInt32]
  cost time finite
{
  var entries: List[UInt32] = []
  for index in 0..codes.length() {
    let code = codes[index] % 2097152
    mut entries.push(unicode_tables::combining_class_of(code) % 256 * 2097152 + code)
  }
  entries
}

fn reorder(entries: mut List[UInt32])
  ensures entries.length() == old(entries.length())
  cost time finite
{
  var position: USize = 1
  while position < entries.length()
    invariant entries.length() == old(entries.length())
    decreases entries.length() - position
  {
    var at = position
    while at > 0 && entries[at] >= 2097152 && entries[at - 1] / 2097152 > entries[at] / 2097152
      invariant at <= position
      invariant position < entries.length()
      invariant entries.length() == old(entries.length())
      decreases at
    {
      mut entries.swap(at - 1, second: at)
      at -= 1
    }
    position += 1
  }
}

fn composite_of(first: UInt32, second: UInt32) -> Option[UInt32]
  cost time O(1)
{
  if first >= 4352 && first < 4371 && second >= 4449 && second < 4470 {
    Some(44032 + ((first - 4352) * 21 + (second - 4449)) * 28)
  } else if first >= 44032 && first < 55204 && (first - 44032) % 28 == 0 && second > 4519 && second < 4547 {
    Some(first + (second - 4519))
  } else {
    unicode_tables::composition_of(first, second: second)
  }
}

fn compose(entries: Slice[UInt32]) -> List[UInt32]
  cost time finite
{
  var output: List[UInt32] = []
  var starter: USize = 0
  var has_starter = false
  var last_class: UInt32 = 0
  for position in 0..entries.length()
    invariant !has_starter || starter < output.length()
  {
    let code = entries[position] % 2097152
    let class = entries[position] / 2097152
    var composed = false
    if has_starter && (last_class < class || last_class == 0) {
      match composite_of(output[starter], second: code) {
        Some(composite) => {
          output[starter] = composite
          composed = true
        }
        None => {}
      }
    }
    if !composed {
      if class == 0 {
        starter = output.length()
        has_starter = true
      }
      last_class = class
      mut output.push(code)
    }
  }
  output
}

fn encoded(codes: Slice[UInt32]) -> String
  cost time finite
{
  var output = ""
  for index in 0..codes.length() {
    string_slice::push_scalar(mut output, code: codes[index] % 2097152)
  }
  output
}

public fn normalize(text: StringSlice, form: Form = Form.Composed) -> String
  cost time finite
{
  if is_below(text, limit: first_changed_code(form)) {
    return text.to_string()
  }
  let compatible = is_compatibility(form)
  var codes: List[UInt32] = []
  for character in text.characters() {
    append_decomposition(mut codes, code: character.code(), compatible: compatible)
  }
  var entries = with_combining_classes(codes.slice())
  reorder(mut entries)
  if is_composed(form) {
    encoded(compose(entries.slice()).slice())
  } else {
    encoded(entries.slice())
  }
}

public fn is_normalized(text: StringSlice, form: Form = Form.Composed) -> Bool
  cost time finite
{
  is_below(text, limit: first_changed_code(form)) || normalize(text, form: form).slice() == text
}

public fn fold_case(text: StringSlice) -> String
  cost time O(text.length())
{
  var output = ""
  for character in text.characters() {
    let code = character.code()
    match unicode_tables::fold_expansion_of(code) {
      Some(expansion) => string_slice::push_expansion(mut output, expansion: expansion)
      None => mut output.push_character(character.or_scalar(unicode_tables::folded_of(code)))
    }
  }
  output
}

public fn equal_ignoring_case(first: StringSlice, second: StringSlice) -> Bool
  cost time finite
{
  fold_case(first) == fold_case(second)
}

public fn category(character: Character) -> Category
  cost time O(1)
{
  match unicode_tables::category_number_of(character.code()) {
    0 => Category.Letter
    1 => Category.Mark
    2 => Category.Number
    3 => Category.Punctuation
    4 => Category.Symbol
    5 => Category.Separator
    6 => Category.Control
    7 => Category.Format
    8 => Category.Surrogate
    9 => Category.PrivateUse
    _ => Category.Unassigned
  }
}

public fn display_width(character: Character) -> USize
  ensures result <= 2
  cost time O(1)
{
  let code = character.code()
  if unicode_tables::is_zero_width(code) {
    0
  } else if unicode_tables::is_wide(code) {
    2
  } else {
    1
  }
}

test "fold_case removes the differences of case" {
  assert fold_case("Hello WÖRLD") == "hello wörld"
  assert fold_case("Straße") == "strasse"
  assert fold_case("ΟΔΥΣΣΕΥΣ") == "οδυσσευσ"
  assert fold_case("ﬃ") == "ffi"
  assert fold_case("中文 123") == "中文 123"
}

test "equal_ignoring_case compares folded text" {
  assert equal_ignoring_case("Straße", second: "STRASSE")
  assert equal_ignoring_case("ΟΔΥΣΣΕΥΣ", second: "οδυσσευς")
  assert equal_ignoring_case("", second: "")
  assert !equal_ignoring_case("résumé", second: "resume")
  assert !equal_ignoring_case("a", second: "ab")
}

test "a character has one general category" {
  assert category(Character"a") == Category.Letter
  assert category(Character"中") == Category.Letter
  assert category(Character"\u{301}") == Category.Mark
  assert category(Character"7") == Category.Number
  assert category(Character"½") == Category.Number
  assert category(Character"!") == Category.Punctuation
  assert category(Character"€") == Category.Symbol
  assert category(Character" ") == Category.Separator
  assert category(Character"\n") == Category.Control
  assert category(Character"\u{200D}") == Category.Format
  assert category(Character"\u{E000}") == Category.PrivateUse
  assert category(Character"\u{F0000}") == Category.PrivateUse
  assert category(Character"\u{378}") == Category.Unassigned
  assert category(Character"\u{10FFFF}") == Category.Unassigned
}

test "a character is as wide as zero, one, or two columns" {
  assert display_width(Character"a") == 1
  assert display_width(Character"é") == 1
  assert display_width(Character"中") == 2
  assert display_width(Character"ｱ") == 1
  assert display_width(Character"Ａ") == 2
  assert display_width(Character"😀") == 2
  assert display_width(Character"\u{301}") == 0
  assert display_width(Character"\u{200D}") == 0
  assert display_width(Character"\n") == 0
  assert console::display_width("abc") == 3
  assert console::display_width("日本語") == 6
  assert console::display_width("e\u{301}") == 1
  assert console::display_width("") == 0
}

test "normalize composes and decomposes canonical equivalents" {
  assert normalize("e\u{301}") == "\u{E9}"
  assert normalize("\u{E9}", form: Form.Decomposed) == "e\u{301}"
  assert normalize("A\u{30A}") == "\u{C5}"
  assert normalize("\u{212B}") == "\u{C5}"
  assert normalize("\u{212B}", form: Form.Decomposed) == "A\u{30A}"
  assert normalize("\u{2126}", form: Form.Decomposed) == "\u{3A9}"
  assert normalize("\u{1F600}e\u{301}") == "\u{1F600}\u{E9}"
  assert normalize("plain text") == "plain text"
  assert normalize("") == ""
}

test "normalize orders combining marks by their class" {
  assert normalize("a\u{301}\u{323}", form: Form.Decomposed) == "a\u{323}\u{301}"
  assert normalize("a\u{301}\u{323}") == "\u{1EA1}\u{301}"
  assert normalize("a\u{315}\u{300}\u{5AE}b", form: Form.Decomposed) == "a\u{5AE}\u{300}\u{315}b"
  assert normalize("a\u{315}\u{300}\u{5AE}b") == "\u{E0}\u{5AE}\u{315}b"
  assert normalize("\u{3A9}\u{301}\u{345}") == "\u{38F}\u{345}"
  assert normalize("\u{301}a") == "\u{301}a"
}

test "normalize leaves a character that composition excludes decomposed" {
  assert normalize("\u{958}") == "\u{915}\u{93C}"
  assert normalize("\u{958}", form: Form.Decomposed) == "\u{915}\u{93C}"
}

test "normalize composes two starters" {
  assert normalize("\u{CC6}\u{CD5}") == "\u{CC7}"
  assert normalize("\u{CC6}\u{CD5}", form: Form.Decomposed) == "\u{CC6}\u{CD5}"
}

test "normalize decomposes and composes Hangul syllables by arithmetic" {
  assert normalize("\u{D55C}", form: Form.Decomposed) == "\u{1112}\u{1161}\u{11AB}"
  assert normalize("\u{1112}\u{1161}\u{11AB}") == "\u{D55C}"
  assert normalize("\u{AC00}", form: Form.Decomposed) == "\u{1100}\u{1161}"
  assert normalize("\u{AC00}\u{11A8}") == "\u{AC01}"
  assert normalize("\u{1100}\u{1161}\u{11A8}") == "\u{AC01}"
}

test "normalize replaces compatibility characters only in the compatibility forms" {
  assert normalize("\u{FB01}") == "\u{FB01}"
  assert normalize("\u{FB01}", form: Form.Decomposed) == "\u{FB01}"
  assert normalize("\u{FB01}", form: Form.CompatibilityComposed) == "fi"
  assert normalize("\u{FB01}", form: Form.CompatibilityDecomposed) == "fi"
  assert normalize("\u{2460}", form: Form.CompatibilityComposed) == "1"
  assert normalize("\u{BD}", form: Form.CompatibilityComposed) == "1\u{2044}2"
  assert normalize("\u{FF76}\u{FF9E}", form: Form.CompatibilityComposed) == "\u{30AC}"
  assert normalize("\u{FF76}\u{FF9E}", form: Form.CompatibilityDecomposed) == "\u{30AB}\u{3099}"
  assert normalize("\u{FDFA}", form: Form.CompatibilityDecomposed).slice().characters().count() == 18
}

test "the four forms of one string differ" {
  assert normalize("\u{1E9B}\u{323}") == "\u{1E9B}\u{323}"
  assert normalize("\u{1E9B}\u{323}", form: Form.Decomposed) == "\u{17F}\u{323}\u{307}"
  assert normalize("\u{1E9B}\u{323}", form: Form.CompatibilityComposed) == "\u{1E69}"
  assert normalize("\u{1E9B}\u{323}", form: Form.CompatibilityDecomposed) == "s\u{323}\u{307}"
}

test "is_normalized tells whether normalize would change the text" {
  assert is_normalized("plain text")
  assert is_normalized("")
  assert is_normalized("\u{E9}")
  assert !is_normalized("e\u{301}")
  assert is_normalized("e\u{301}", form: Form.Decomposed)
  assert !is_normalized("\u{E9}", form: Form.Decomposed)
  assert is_normalized("\u{FB01}")
  assert !is_normalized("\u{FB01}", form: Form.CompatibilityComposed)
  assert !is_normalized("a\u{301}\u{323}", form: Form.Decomposed)
  assert is_normalized("\u{D55C}")
  assert !is_normalized("\u{D55C}", form: Form.CompatibilityDecomposed)
}
