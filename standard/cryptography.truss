public type Cipher = ChaCha20Poly1305 | Aes256Gcm
  derives Equal

public type AuthenticationError()
  derives Equal

impl Display for AuthenticationError {
  fn display(self, output: mut TextBuilder) {
    mut output.write("the data is not what the key sealed")
  }
}

public fn seal(
  key: SecretKey,
  nonce: Nonce,
  plaintext: Slice[UInt8],
  associated_data: Slice[UInt8],
  cipher: Cipher = Cipher.ChaCha20Poly1305,
) -> List[UInt8]
  ensures result.length() == plaintext.length() + 16
  cost time O(plaintext.length() + associated_data.length())
{
  todo
}

public fn open(
  key: SecretKey,
  nonce: Nonce,
  sealed: Slice[UInt8],
  associated_data: Slice[UInt8],
  cipher: Cipher = Cipher.ChaCha20Poly1305,
) -> Result[List[UInt8], AuthenticationError]
  ensures match result {
    Ok(plaintext) => plaintext.length() + 16 == sealed.length()
    Err(_) => true
  }
  cost time O(sealed.length() + associated_data.length())
{
  todo
}

