public fn constant_time_equal(first: Slice[UInt8], second: Slice[UInt8]) -> Bool
  cost time O(first.length() + second.length())
  cost allocations == 0
{
  if first.length() != second.length() {
    return false
  }
  var difference: UInt8 = 0
  for index in 0..first.length()
    cost allocations == 0
  {
    difference = difference | (first[index] ^ second[index])
  }
  difference == 0
}

