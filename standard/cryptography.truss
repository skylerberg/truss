public fn hmac_sha256(key: Slice[UInt8], message: Slice[UInt8]) -> Array[UInt8, 32]
  cost time O(key.length() + message.length())
  cost allocations == 0
{
  var code = HmacSha256.new(key)
  mut code.update(message)
  own code.finish()
}

public fn hmac_sha384(key: Slice[UInt8], message: Slice[UInt8]) -> Array[UInt8, 48]
  cost time O(key.length() + message.length())
  cost allocations == 0
{
