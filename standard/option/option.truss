use standard.core

public type Option[Value] =
  | Some(value: Value)
  | None
  derives Equal, Hash, Ordered

public fn Option[Value].is_some(self) -> Bool
  ensures result == (self is Some(_))
  cost time O(1)
{
  self is Some(_)
}

public fn Option[Value].is_none(self) -> Bool
  ensures result == (self is None)
  cost time O(1)
{
  self is None
}

public fn Option[Value: Equal].contains(self, value: Value) -> Bool
  ensures result == (match self {
      Some(held) => held == value
      None => false
    })
{
  match self {
    Some(held) => held == value
    None => false
  }
}

public fn Option[Value].unwrap_or(own self, default: own Value) -> Value
  ensures !(self is Some(held) && !identical(result, held))
  ensures !(self is None && !identical(result, default))
  cost time O(1)
{
  match own self {
    Some(value) => value
    None => default
  }
}

public fn Option[Value].unwrap_or_else(
  own self,
  make: (fn() -> Value uses generic Granted),
) -> Value
  uses generic Granted
  ensures match self {
    Some(value) => identical(result, value)
    None => make.ensures(result)
  }
  cost time O(time(make))
  cost allocations <= allocations(make)
  cost allocated_bytes <= allocated_bytes(make)
{
  match own self {
    Some(value) => value
    None => make()
  }
}

public fn Option[Value].map[Output](
  own self,
  transform: (fn(value: own Value) -> Output uses generic Granted
    requires self is Some(held) && identical(held, value)),
) -> Option[Output]
  uses generic Granted
  ensures match self {
    Some(value) => result is Some(output) && transform.ensures(value, output)
    None => result is None
  }
  cost time O(time(transform))
  cost allocations <= allocations(transform)
  cost allocated_bytes <= allocated_bytes(transform)
{
  match own self {
    Some(value) => Some(transform(own value))
    None => None
  }
}

public fn Option[Value].map[Output](
  self,
  transform: (fn(value: Value) -> Output uses generic Granted
    requires self is Some(held) && identical(held, value)),
) -> Option[Output]
  uses generic Granted
  ensures match self {
    Some(value) => result is Some(output) && transform.ensures(value, output)
    None => result is None
  }
  cost time O(time(transform))
  cost allocations <= allocations(transform)
  cost allocated_bytes <= allocated_bytes(transform)
{
  match self {
    Some(value) => Some(transform(value))
    None => None
  }
}

public fn Option[Value].and_then[Output](
  own self,
  next: (fn(value: own Value) -> Option[Output] uses generic Granted
    requires self is Some(held) && identical(held, value)),
) -> Option[Output]
  uses generic Granted
  ensures match self {
    Some(value) => next.ensures(value, result)
    None => result is None
  }
  cost time O(time(next))
  cost allocations <= allocations(next)
  cost allocated_bytes <= allocated_bytes(next)
{
  match own self {
    Some(value) => next(own value)
    None => None
  }
}

public fn Option[Value].and_then[Output](
  self,
  next: (fn(value: Value) -> Option[Output] uses generic Granted
    requires self is Some(held) && identical(held, value)),
) -> Option[Output]
  uses generic Granted
  ensures match self {
    Some(value) => next.ensures(value, result)
    None => result is None
  }
  cost time O(time(next))
  cost allocations <= allocations(next)
  cost allocated_bytes <= allocated_bytes(next)
{
  match self {
    Some(value) => next(value)
    None => None
  }
}

public fn Option[Value].filter(
  own self,
  keep: (fn(value: Value) -> Bool uses generic Granted requires self is Some(held) && identical(held, value)),
) -> Option[Value]
  uses generic Granted
  ensures match self {
    Some(value) => match result {
      Some(kept) => identical(kept, value) && keep.ensures(value, true)
      None => keep.ensures(value, false)
    }
    None => result is None
  }
  cost time O(time(keep))
  cost allocations <= allocations(keep)
  cost allocated_bytes <= allocated_bytes(keep)
{
  match own self {
    Some(value) => if keep(value) { Some(own value) } else { None }
    None => None
  }
}

public fn Option[Value].or(own self, other: own Option[Value]) -> Option[Value]
  cost time O(1)
{
  match own self {
    Some(value) => Some(own value)
    None => other
  }
}

public fn Option[Value].or_else(
  own self,
  make: (fn() -> Option[Value] uses generic Granted),
) -> Option[Value]
  uses generic Granted
  ensures match self {
    Some(value) => result is Some(held) && identical(held, value)
    None => make.ensures(result)
  }
  cost time O(time(make))
  cost allocations <= allocations(make)
  cost allocated_bytes <= allocated_bytes(make)
{
  match own self {
    Some(value) => Some(own value)
    None => make()
  }
}

public fn Option[Value].zip[Other](own self, other: own Option[Other]) -> Option[core.Pair[Value, Other]]
  cost time O(1)
{
  match own self, own other {
    Some(first), Some(second) => Some(core.Pair(first: own first, second: own second))
    _, _ => None
  }
}

public fn Option[Value].ok_or[Error](own self, error: own Error) -> Result[Value, Error]
  cost time O(1)
{
  match own self {
    Some(value) => Ok(own value)
    None => Err(own error)
  }
}

public fn Option[Value].ok_or_else[Error](
  own self,
  make: (fn() -> Error uses generic Granted),
) -> Result[Value, Error]
  uses generic Granted
  ensures match self {
    Some(value) => result is Ok(held) && identical(held, value)
    None => result is Err(error) && make.ensures(error)
  }
  cost time O(time(make))
  cost allocations <= allocations(make)
  cost allocated_bytes <= allocated_bytes(make)
{
  match own self {
    Some(value) => Ok(own value)
    None => Err(make())
  }
}

public fn Option[Value].take(mut self) -> Option[Value]
  ensures self is None
  ensures identical(result, old(self))
  cost time O(1)
{
  let previous = own self
  self = None
  previous
}

public fn Option[Value].replace(mut self, value: own Value) -> Option[Value]
  ensures self is Some(_)
  ensures identical(result, old(self))
  cost time O(1)
{
  let previous = own self
  self = Some(own value)
  previous
}

public fn Option[Value].get_or_insert(mut self, value: own Value) lends mut Value
  cost time O(1)
{
  if self is None {
    self = Some(own value)
  }
  match mut self {
    Some(inner) => mut inner
    None => unreachable
  }
}

public fn Option[Value].expect(own self, message: String) -> Value
  uses Panic unless self is Some(_)
  ensures self is Some(held) && identical(result, held)
  cost time O(1)
{
  match own self {
    Some(value) => value
    None => Panic.crash(message)
  }
}

public fn Option[Value].expect(self, message: String) lends Value
  uses Panic unless self is Some(_)
  ensures self is Some(held) && identical(result, held)
  cost time O(1)
{
  match self {
    Some(value) => value
    None => Panic.crash(message)
  }
}

impl Default for Option[Value] {
  fn default() -> Option[Value]
    ensures result is None
    cost time O(1)
    cost allocations == 0
  {
    None
  }
}
