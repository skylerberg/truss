use standard::growth
use standard::intrinsic
use standard::writing

public opaque type String(storage: intrinsic::Storage[UInt8])
  derives Copyable

public opaque type StringSlice(bytes: intrinsic::View[UInt8])
  derives Plain

public opaque type TextBuilder(text: String)

public trait FromTemplate {
  type Part
  fn from_template(template: Template[Self.Part]) -> Self
}

public opaque type Literal(text: StringSlice)
  derives Plain

public type Template[Part](literals: List[Literal], parts: List[Part])

impl Model for String {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    cost time finite
  {
    intrinsic::storage_model(self.storage)
  }
}

impl Model for StringSlice {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    cost time finite
  {
    intrinsic::view_model(self.bytes)
  }
}

impl Model for Literal {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    cost time finite
  {
    self.text.model()
  }
}

public fn String.length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_length(self.storage)
}

public fn String.is_empty(self) -> Bool
  ensures result == (self.model().length() == 0)
  cost time O(1)
{
  self.length() == 0
}

internal fn push_bytes(storage: mut intrinsic::Storage[UInt8], text: StringSlice)
  requires intrinsic::storage_length(storage) + text.length() <= intrinsic::storage_capacity(storage)
  ensures identical(intrinsic::storage_model(storage), old(intrinsic::storage_model(storage)).concatenate(text.model()))
  ensures intrinsic::storage_capacity(storage) == old(intrinsic::storage_capacity(storage))
  cost time O(text.length())
  cost allocations == 0
{
  for index in 0..text.length()
    invariant intrinsic::storage_length(storage) == old(intrinsic::storage_length(storage)) + index
    invariant forall i in 0..old(intrinsic::storage_length(storage)) =>
      identical(intrinsic::storage_model(storage)[i], old(intrinsic::storage_model(storage))[i])
    invariant forall i in 0..index =>
      identical(intrinsic::storage_model(storage)[old(intrinsic::storage_length(storage)) + i], text.model()[i])
    invariant intrinsic::storage_capacity(storage) == old(intrinsic::storage_capacity(storage))
    cost allocations == 0
  {
    intrinsic::storage_push(mut storage, value: intrinsic::view_at(text.bytes, index: index))
  }
}

public fn String.push(mut self, text: StringSlice)
  ensures identical(self.model(), old(self.model()).concatenate(text.model()))
  cost amortized time O(text.length())
{
  growth::reserve(mut self.storage, additional: text.length())
  push_bytes(mut self.storage, text: text)
}

public fn String.slice(self) -> StringSlice
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  StringSlice(bytes: intrinsic::storage_view(self.storage))
}

public fn String.trim(self) -> StringSlice
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.slice().trim()
}

internal fn String.from_bytes(bytes: own intrinsic::Storage[UInt8]) -> String {
  if valid_utf8(intrinsic::storage_view(bytes)) {
    String(storage: own bytes)
  } else {
    String(storage: replaced(intrinsic::storage_view(bytes)))
  }
}

fn valid_utf8(bytes: intrinsic::View[UInt8]) -> Bool {
  var at: USize = 0
  var valid = true
  while valid && at < intrinsic::view_length(bytes) {
    let step = utf8_sequence(bytes, at)
    if step == 0 {
      valid = false
    } else {
      at += step
    }
  }
  valid
}

fn replaced(bytes: intrinsic::View[UInt8]) -> intrinsic::Storage[UInt8] {
  var fixed: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(intrinsic::view_length(bytes))
  var at: USize = 0
  while at < intrinsic::view_length(bytes) {
    let step = utf8_sequence(bytes, at)
    if step == 0 {
      growth::push(mut fixed, value: 239)
      growth::push(mut fixed, value: 191)
      growth::push(mut fixed, value: 189)
      at += 1
    } else {
      for index in at..at + step {
        growth::push(mut fixed, value: intrinsic::view_at(bytes, index: index))
      }
      at += step
    }
  }
  fixed
}

fn utf8_sequence(bytes: intrinsic::View[UInt8], at: USize) -> USize
  requires at < intrinsic::view_length(bytes)
  ensures result <= intrinsic::view_length(bytes) - at
{
  let first = intrinsic::view_at(bytes, index: at)
  let length: USize =
    if first < 128 { 1 } else if (first & 224) == 192 { 2 } else if (first & 240) == 224 { 3 } else if (first & 248) == 240 { 4 } else { 0 }
  if length == 0 || length > intrinsic::view_length(bytes) - at {
    0
  } else {
    let mask: UInt8 = if length == 1 { 127 } else if length == 2 { 31 } else if length == 3 { 15 } else { 7 }
    var code: UInt32 = intrinsic::convert(first & mask)
    var continued = true
    for index in at + 1..at + length {
      let byte = intrinsic::view_at(bytes, index: index)
      if (byte & 192) != 128 {
        continued = false
      }
      let low: UInt32 = intrinsic::convert(byte & 63)
      code = (code << 6) | low
    }
    let overlong = (length == 2 && code < 128) || (length == 3 && code < 2048) || (length == 4 && code < 65536)
    if !continued || overlong || code > 1114111 || (code >= 55296 && code <= 57343) { 0 } else { length }
  }
}

public fn StringSlice.length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::view_length(self.bytes)
}

public fn StringSlice.byte(self, index: USize) -> UInt8
  requires index < self.length()
  ensures result == self.model()[index]
  cost time O(1)
  cost allocations == 0
{
  intrinsic::view_at(self.bytes, index: index)
}

public fn Literal.text(self) -> StringSlice
  ensures identical(result.model(), self.model())
  cost time O(1)
{
  self.text
}

public fn StringSlice.to_string(self) -> String
  ensures result.length() == self.length()
  cost time O(self.length())
  cost allocations <= 1
{
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(self.length())
  self.copy_onto(mut output)
  String(storage: own output)
}

public fn TextBuilder.new() -> TextBuilder
  cost time O(1)
{
  TextBuilder(text: String(storage: intrinsic::storage_empty()))
}

public fn TextBuilder.write(mut self, text: StringSlice)
  cost amortized time O(text.length())
{
  mut self.text.push(text)
}

public fn TextBuilder.finish(own self) -> String
  cost time O(1)
{
  self.text
}

internal fn TextBuilder.write_byte(mut self, byte: UInt8)
  cost time finite
{
  writing::byte(mut self.text.storage, value: byte)
}

internal fn TextBuilder.write_float32(mut self, value: Float32)
  cost time finite
{
  writing::float32(mut self.text.storage, value: value)
}

internal fn TextBuilder.write_float64(mut self, value: Float64)
  cost time finite
{
  writing::float64(mut self.text.storage, value: value)
}

public fn TextBuilder.write_character(mut self, character: Character)
  cost time finite
{
  writing::character(mut self.text.storage, value: character)
}

internal fn TextBuilder.write_unsigned(mut self, value: UInt64)
  cost time finite
{
  writing::unsigned(mut self.text.storage, value: value)
}

internal fn TextBuilder.write_signed(mut self, value: Int64)
  cost time finite
{
  writing::signed(mut self.text.storage, value: value)
}

impl Equal for String {
  fn equal(self, other: String) -> Bool
    ensures result == identical(self.model(), other.model())
  {
    self.slice() == other.slice()
  }
}

impl Ordered for String {
  fn compare(self, other: String) -> Ordering {
    let order = intrinsic::compare_bytes(intrinsic::storage_view(self.storage), right: intrinsic::storage_view(other.storage))
    if order < 0 { Ordering.Less } else if order > 0 { Ordering.Greater } else { Ordering.Equal }
  }
}

impl Hash for String {
  fn hash(self, hasher: mut Hasher) {
    let bytes = intrinsic::storage_view(self.storage)
    for index in 0..intrinsic::view_length(bytes) {
      mut hasher.write(intrinsic::convert(intrinsic::view_at(bytes, index: index)))
    }
  }
}

impl Display for String {
  fn display(self, output: mut TextBuilder) {
    mut output.write(self.slice())
  }
}

impl Equal for StringSlice {
  fn equal(self, other: StringSlice) -> Bool
    ensures result == identical(self.model(), other.model())
  {
    intrinsic::compare_bytes(self.bytes, right: other.bytes) == 0
  }
}

impl Display for StringSlice {
  fn display(self, output: mut TextBuilder) {
    mut output.write(self)
  }
}

public trait Parse {
  type Error
  fn parse(text: StringSlice) -> Result[Self, Self.Error]
}

impl Parse for String {
  type Error = Never

  fn parse(text: StringSlice) -> Result[String, Never] {
    Ok(text.to_string())
  }
}

public type Utf8Error(valid_up_to: USize)
  derives Equal

impl Display for Utf8Error {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("the bytes are not UTF-8 at offset ")
    self.valid_up_to.display(mut output)
  }
}

public type Utf16Error(valid_up_to: USize)
  derives Equal

impl Display for Utf16Error {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("the units are not UTF-16 at index ")
    self.valid_up_to.display(mut output)
  }
}

public fn String.with_capacity(capacity: USize) -> String
  ensures result.length() == 0
{
  String(storage: intrinsic::storage_with_capacity(capacity))
}

public fn String.from_utf8(bytes: own List[UInt8]) -> Result[String, Utf8Error]
  cost time O(bytes.length())
  cost allocations == 0
{
  let text = String(storage: own bytes.storage)
  var offset: USize = 0
  while offset < text.length()
    invariant offset <= text.length()
    decreases text.length() - offset
    cost time O(offset)
    cost allocations == 0
  {
    let decoded = text.slice().decode(offset)
    if decoded.length == 1 && text.slice().byte(offset) >= 128 {
      return Err(Utf8Error(valid_up_to: offset))
    }
    offset += decoded.length
  }
  Ok(own text)
}

internal fn StringSlice.malformed_length(self, offset: USize) -> USize
  requires offset < self.length()
  ensures 1 <= result && result <= 3
  ensures result <= self.length() - offset
  cost time O(1)
  cost allocations == 0
{
  let lead = self.byte(offset)
  let wanted: USize = if lead >= 194 && lead <= 223 {
    2
  } else if lead >= 224 && lead <= 239 {
    3
  } else if lead >= 240 && lead <= 244 {
    4
  } else {
    1
  }
  if wanted == 1 || offset + 1 >= self.length() {
    return 1
  }
  let second = self.byte(offset + 1)
  let low: UInt8 = if lead == 224 { 160 } else if lead == 240 { 144 } else { 128 }
  let high: UInt8 = if lead == 237 { 159 } else if lead == 244 { 143 } else { 191 }
  if second < low || second > high {
    return 1
  }
  if wanted == 2 || offset + 2 >= self.length() {
    return 2
  }
  let third = self.byte(offset + 2)
  if third < 128 || third > 191 || wanted == 3 {
    return 2
  }
  3
}

internal fn StringSlice.is_malformed_at(self, offset: USize) -> Bool
  requires offset < self.length()
  cost time O(1)
  cost allocations == 0
{
  self.decode(offset).length == 1 && self.byte(offset) >= 128
}

internal fn reverse_run(storage: mut intrinsic::Storage[UInt8], from: USize, to: USize)
  requires from <= to
  requires to <= intrinsic::storage_length(storage)
  ensures intrinsic::storage_length(storage) == old(intrinsic::storage_length(storage))
  ensures intrinsic::storage_capacity(storage) == old(intrinsic::storage_capacity(storage))
  cost time O(to - from)
  cost allocations == 0
{
  var low = from
  var high = to
  while low + 1 < high
    invariant from <= low
    invariant low <= high
    invariant high <= to
    invariant intrinsic::storage_length(storage) == old(intrinsic::storage_length(storage))
    invariant intrinsic::storage_capacity(storage) == old(intrinsic::storage_capacity(storage))
    decreases high - low
    cost time O(low - from)
    cost allocations == 0
  {
    high -= 1
    intrinsic::storage_swap(mut storage, first: low, second: high)
    low += 1
  }
}

public fn String.from_utf8_lossy(bytes: Slice[UInt8]) -> String
  cost time O(bytes.length())
{
  let text = StringSlice(bytes: bytes.elements)
  if text.length() > USize.maximum / 4 {
    intrinsic::crash("a string cannot hold that many bytes".slice())
  }
  var budget: USize = 0
  var offset: USize = 0
  while offset < text.length()
    invariant offset <= text.length()
    invariant budget <= 2 * offset
    decreases text.length() - offset
    cost time O(offset)
  {
    if text.is_malformed_at(offset) {
      let run = text.malformed_length(offset)
      budget += 3 - run
      offset += run
    } else {
      offset += text.decode(offset).length
    }
  }
  let capacity = text.length() + budget
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(capacity)
  var position: USize = 0
  while position < text.length()
    invariant position <= text.length()
    invariant intrinsic::storage_length(output) + (text.length() - position) + budget <= capacity
    invariant intrinsic::storage_capacity(output) == capacity
    decreases text.length() - position
    cost time O(position)
  {
    if text.is_malformed_at(position) {
      let run = text.malformed_length(position)
      if budget >= 3 - run {
        intrinsic::storage_push(mut output, value: 239)
        intrinsic::storage_push(mut output, value: 191)
        intrinsic::storage_push(mut output, value: 189)
        budget -= 3 - run
      }
      position += run
    } else {
      let length = text.decode(position).length
      text.part(position, to: position + length).copy_onto(mut output)
      position += length
    }
  }
  String(storage: own output)
}

public fn String.from_utf16(units: Slice[UInt16]) -> Result[String, Utf16Error]
  cost time O(units.length())
{
  if units.length() > USize.maximum / 4 {
    intrinsic::crash("a string cannot hold that many bytes".slice())
  }
  var size: USize = 0
  var index: USize = 0
  while index < units.length()
    invariant index <= units.length()
    invariant size <= 3 * index
    decreases units.length() - index
    cost time O(index)
  {
    let unit = units[index]
    if unit < 55296 || unit > 57343 {
      size += if unit < 128 { 1 } else if unit < 2048 { 2 } else { 3 }
      index += 1
    } else if unit <= 56319 && index + 1 < units.length() && units[index + 1] >= 56320 && units[index + 1] <= 57343 {
      size += 4
      index += 2
    } else {
      return Err(Utf16Error(valid_up_to: index))
    }
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(size)
  var room = size
  var position: USize = 0
  while position < units.length()
    invariant position <= units.length()
    invariant intrinsic::storage_length(output) + room == size
    invariant intrinsic::storage_capacity(output) == size
    decreases units.length() - position
    cost time O(position)
  {
    let unit: UInt32 = intrinsic::convert(units[position])
    var code = unit
    var step: USize = 1
    if unit >= 55296 && unit <= 56319 && position + 1 < units.length() {
      let low: UInt32 = intrinsic::convert(units[position + 1])
      if low >= 56320 && low <= 57343 {
        code = 65536 + (unit - 55296) * 1024 + (low - 56320)
        step = 2
      }
    }
    let character: Character = if code >= 55296 && code <= 57343 { Character"\u{fffd}" } else { intrinsic::convert(code) }
    if room >= character.utf8_length() {
      character.encode_onto(mut output)
      room -= character.utf8_length()
    }
    position += step
  }
  Ok(String(storage: own output))
}

public fn String.collect[Source: Cursor[Element = Character]](source: own Source) -> String
  uses Source.Uses
{
  var cursor = own source
  var text: String = ""
  while mut cursor.next() is Some(character) {
    mut text.push_character(character)
  }
  text
}

public fn String.capacity(self) -> USize
  ensures result >= self.length()
  cost time O(1)
{
  intrinsic::storage_capacity(self.storage)
}

public fn String.reserve(mut self, additional: USize)
  ensures identical(self.model(), old(self.model()))
{
  growth::reserve(mut self.storage, additional: additional)
}

public fn String.clear(mut self)
  ensures self.length() == 0
  ensures self.capacity() == old(self.capacity())
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_shorten(mut self.storage, length: 0)
}

public fn String.push_character(mut self, character: Character)
  ensures self.length() == old(self.length()) + character.utf8_length()
  cost amortized time O(1)
{
  let code = character.code()
  if code < 128 {
    growth::push(mut self.storage, value: intrinsic::convert(code))
  } else if code < 2048 {
    growth::push(mut self.storage, value: intrinsic::convert(192 + code / 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code % 64))
  } else if code < 65536 {
    growth::push(mut self.storage, value: intrinsic::convert(224 + code / 4096))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code / 64 % 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code % 64))
  } else {
    growth::push(mut self.storage, value: intrinsic::convert(240 + code / 262144))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code / 4096 % 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code / 64 % 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code % 64))
  }
}

public fn String.pop_character(mut self) -> Option[Character]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(1)
  cost allocations == 0
{
  if self.length() == 0 {
    return None
  }
  let start = self.slice().previous_start(self.length())
  let character = self.slice().decode(start).character
  intrinsic::storage_shorten(mut self.storage, length: start)
  Some(character)
}

public fn String.insert(mut self, offset: USize, text: StringSlice)
  requires offset <= self.length()
  requires self.is_boundary(offset)
  ensures self.length() == old(self.length()) + text.length()
  cost amortized time O(old(self.length()) + text.length())
{
  let end = self.length() + text.length()
  growth::reserve(mut self.storage, additional: text.length())
  text.copy_onto(mut self.storage)
  reverse_run(mut self.storage, from: offset, to: end)
  reverse_run(mut self.storage, from: offset, to: offset + text.length())
  reverse_run(mut self.storage, from: offset + text.length(), to: end)
}

public fn String.remove_range(mut self, from: USize, to: USize)
  requires from <= to
  requires to <= self.length()
  requires self.is_boundary(from)
  requires self.is_boundary(to)
  ensures self.length() == old(self.length()) - (to - from)
  cost time O(old(self.length()))
  cost allocations == 0
{
  let width = to - from
  if width == 0 {
    return
  }
  var index = to
  while index < self.length()
    invariant self.length() == old(self.length())
    invariant to <= index
    invariant index <= self.length()
    decreases self.length() - index
    cost allocations == 0
  {
    intrinsic::storage_swap(mut self.storage, first: index - width, second: index)
    index += 1
  }
  intrinsic::storage_shorten(mut self.storage, length: self.length() - width)
}

public fn String.truncate(mut self, length: USize)
  requires length <= self.length()
  requires self.is_boundary(length)
  ensures self.length() == length
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_shorten(mut self.storage, length: length)
}

impl Default for String {
  fn default() -> String {
    ""
  }
}

impl From[Character] for String {
  fn from(value: own Character) -> String
  {
    var text = String(storage: intrinsic::storage_with_capacity(4))
    mut text.push_character(value)
    text
  }
}

public fn String.to_bytes(own self) -> List[UInt8]
  ensures result.length() == self.length()
  cost time O(1)
  cost allocations == 0
{
  List(storage: own self.storage)
}

public fn TextBuilder.with_capacity(capacity: USize) -> TextBuilder {
  TextBuilder(text: String.with_capacity(capacity))
}

public fn TextBuilder.length(self) -> USize
  cost time O(1)
{
  self.text.length()
}

test "a string's bytes are its UTF-8 encoding" {
  let text = "h\u{e9}llo"
  let bytes = text.bytes()
  assert bytes.length() == 6
  assert bytes[0] == 104
  assert bytes[1] == 195
  assert bytes[2] == 169
  assert bytes[5] == 111
  assert "".bytes().length() == 0
}

fn same(actual: StringSlice, expected: StringSlice) -> Bool {
  actual == expected
}

test "is_ascii is true only when every byte is ASCII" {
  assert "hello".is_ascii()
  assert "".is_ascii()
  assert !"h\u{e9}llo".is_ascii()
}

test "characters decodes each UTF-8 sequence" {
  var seen: List[Character] = []
  for character in "a\u{e9}\u{20ac}\u{1F600}z".characters() {
    mut seen.push(character)
  }
  assert seen.length() == 5
  assert seen[0] == Character"a"
  assert seen[1] == Character"\u{e9}"
  assert seen[2] == Character"\u{20ac}"
  assert seen[3] == Character"\u{1F600}"
  assert seen[4] == Character"z"
  assert "a\u{e9}\u{20ac}\u{1F600}z".character_count() == 5
  assert "".character_count() == 0
}

test "characters_with_offsets gives the byte offset of each character" {
  var offsets: List[USize] = []
  for entry in "a\u{e9}\u{20ac}z".characters_with_offsets() {
    mut offsets.push(entry.index)
  }
  assert offsets.length() == 4
  assert offsets[0] == 0
  assert offsets[1] == 1
  assert offsets[2] == 3
  assert offsets[3] == 6
}

test "the first and last characters are whole characters" {
  assert "".first_character() is None
  assert "".last_character() is None
  assert "x".first_character() == Some(Character"x")
  assert "x".last_character() == Some(Character"x")
  assert "\u{20ac}uro".first_character() == Some(Character"\u{20ac}")
  assert "caf\u{e9}".last_character() == Some(Character"\u{e9}")
  assert "smile \u{1F600}".last_character() == Some(Character"\u{1F600}")
}

test "a substring is taken at character boundaries" {
  let text = "caf\u{e9} au lait"
  assert same(text.substring(0, to: 3), expected: "caf")
  assert same(text.substring(3, to: 5), expected: "\u{e9}")
  assert same(text.substring(5, to: 5), expected: "")
  assert text.get_substring(0, to: 5) == Some("caf\u{e9}".slice())
  assert text.get_substring(0, to: 4) is None
  assert text.get_substring(4, to: 5) is None
  assert text.get_substring(6, to: 2) is None
  assert text.get_substring(0, to: 99) is None
  let halves = text.split_at(5)
  assert same(halves.first, expected: "caf\u{e9}")
  assert same(halves.second, expected: " au lait")
}

test "prefixes and suffixes are tested and stripped" {
  let text = "prefix-body-suffix"
  assert text.starts_with("prefix")
  assert text.starts_with("")
  assert !text.starts_with("refix")
  assert !text.starts_with("prefix-body-suffix-and-more")
  assert text.ends_with("suffix")
  assert text.ends_with("")
  assert !text.ends_with("suffi")
  assert text.strip_prefix("prefix-") == Some("body-suffix".slice())
  assert text.strip_prefix("body") is None
  assert text.strip_suffix("-suffix") == Some("prefix-body".slice())
  assert text.strip_suffix("prefix") is None
  assert text.strip_prefix(text) == Some("".slice())
}

test "trimming removes Unicode white space from the ends only" {
  assert same("  hello world \n".trim(), expected: "hello world")
  assert same("  hello ".trim_start(), expected: "hello ")
  assert same("  hello ".trim_end(), expected: "  hello")
  assert same("\u{a0}\u{2003}wide\u{3000}".trim(), expected: "wide")
  assert same("".trim(), expected: "")
  assert same("   ".trim(), expected: "")
  assert same("none".trim(), expected: "none")
  assert same("\u{e9}t\u{e9}".trim(), expected: "\u{e9}t\u{e9}")
}

test "to_bytes copies a string's bytes" {
  let bytes = "h\u{e9}".to_bytes()
  assert bytes.length() == 3
  assert bytes[0] == 104
  assert bytes[1] == 195
  assert bytes[2] == 169
}

test "strings compare without regard to ASCII case, and order by bytes" {
  assert "Hello".equal_ignoring_ascii_case("hELLO")
  assert !"Hello".equal_ignoring_ascii_case("Hell")
  assert !"Hello".equal_ignoring_ascii_case("Hallo")
  assert !"\u{c9}".equal_ignoring_ascii_case("\u{e9}")
  assert "apple".slice() < "banana".slice()
  assert "apple".slice() < "apples".slice()
  assert "b".slice() > "apple".slice()
  assert "same".slice() == "same".slice()
}

test "ASCII case conversion changes only ASCII letters and keeps the length" {
  assert "Hello, World 1!".to_ascii_uppercase() == "HELLO, WORLD 1!"
  assert "Hello, World 1!".to_ascii_lowercase() == "hello, world 1!"
  assert "\u{e9}t\u{c9}".to_ascii_uppercase() == "\u{e9}T\u{c9}"
  assert "".to_ascii_uppercase() == ""
}

test "a string is repeated and reversed by characters" {
  assert "ab".repeated(3) == "ababab"
  assert "ab".repeated(0) == ""
  assert "".repeated(5) == ""
  assert "x".repeated(1) == "x"
  assert "abc".reversed() == "cba"
  assert "a\u{e9}\u{20ac}\u{1F600}".reversed() == "\u{1F600}\u{20ac}\u{e9}a"
  assert "".reversed() == ""
}

test "a string converts to UTF-16, with a pair of units past U+FFFF" {
  let units = "a\u{e9}\u{20ac}\u{1F600}".to_utf16()
  assert units.length() == 5
  assert units[0] == 97
  assert units[1] == 233
  assert units[2] == 8364
  assert units[3] == 55357
  assert units[4] == 56832
  assert "".to_utf16().length() == 0
}

test "find gives the first match and find_last the last" {
  let text = "one two one two one"
  assert text.find("one") == Some(0)
  assert text.find("two") == Some(4)
  assert text.find("three") is None
  assert text.find("") == Some(0)
  assert text.find(text) == Some(0)
  assert text.find("one two one two one!") is None
  assert text.find_last("one") == Some(16)
  assert text.find_last("two") == Some(12)
  assert text.find_last("three") is None
  assert text.find_last("") == Some(19)
  assert "aaaa".find("aa") == Some(0)
  assert "aaaa".find_last("aa") == Some(2)
  assert "aabaabaaab".find("aaab") == Some(6)
  assert "abababc".find("ababc") == Some(2)
  assert "caf\u{e9} cr\u{e8}me".find("cr\u{e8}") == Some(6)
  assert "".find("a") is None
}

test "contains and occurrences count matches that do not overlap" {
  assert "haystack".contains("st")
  assert "haystack".contains("")
  assert !"haystack".contains("needle")
  assert "banana".occurrences("an") == 2
  assert "banana".occurrences("a") == 3
  assert "aaaa".occurrences("aa") == 2
  assert "aaaaa".occurrences("aa") == 2
  assert "banana".occurrences("x") == 0
  assert "".occurrences("x") == 0
}

test "split yields the parts between separators, empty ones included" {
  var parts: List[String] = []
  for part in "a,b,,c".split(",") {
    mut parts.push(part.to_string())
  }
  assert parts.length() == 4
  assert parts[0] == "a"
  assert parts[1] == "b"
  assert parts[2] == ""
  assert parts[3] == "c"
  var ends: List[String] = []
  for part in ",x,".split(",") {
    mut ends.push(part.to_string())
  }
  assert ends.length() == 3
  assert ends[0] == ""
  assert ends[1] == "x"
  assert ends[2] == ""
  var whole = 0
  for part in "no separator".split("--") {
    whole += 1
    assert same(part, expected: "no separator")
  }
  assert whole == 1
  var long: List[String] = []
  for part in "one<>two<>three".split("<>") {
    mut long.push(part.to_string())
  }
  assert long.length() == 3
  assert long[1] == "two"
  var empty = 0
  for part in "".split(",") {
    empty += 1
    assert part.is_empty()
  }
  assert empty == 1
}

test "split_at_most stops splitting when it has the parts asked for" {
  var parts: List[String] = []
  for part in "a=b=c=d".split_at_most("=", parts: 2) {
    mut parts.push(part.to_string())
  }
  assert parts.length() == 2
  assert parts[0] == "a"
  assert parts[1] == "b=c=d"
  var one: List[String] = []
  for part in "a=b".split_at_most("=", parts: 1) {
    mut one.push(part.to_string())
  }
  assert one.length() == 1
  assert one[0] == "a=b"
  var many: List[String] = []
  for part in "a=b".split_at_most("=", parts: 9) {
    mut many.push(part.to_string())
  }
  assert many.length() == 2
}

test "split_once splits at the first separator and split_once_last at the last" {
  assert "key=value=more".split_once("=") is Some(pair) && same(pair.first, expected: "key")
    && same(pair.second, expected: "value=more")
  assert "key=value=more".split_once_last("=") is Some(pair) && same(pair.first, expected: "key=value")
    && same(pair.second, expected: "more")
  assert "none".split_once("=") is None
  assert "none".split_once_last("=") is None
  assert "=".split_once("=") is Some(pair) && pair.first.is_empty() && pair.second.is_empty()
}

fn collected(parts: List[String], expected: Slice[String]) -> Bool {
  if parts.length() != expected.length() {
    return false
  }
  for index in 0..parts.length() {
    if parts[index] != expected[index] {
      return false
    }
  }
  true
}

test "find_character gives the byte offset of the first character that matches" {
  let text = "caf\u{e9} 42"
  assert text.find_character(fn(character) { character.is_ascii_digit() }) == Some(6)
  assert text.find_character(fn(character) { character == Character"\u{e9}" }) == Some(3)
  assert text.find_character(fn(character) { character == Character"c" }) == Some(0)
  assert text.find_character(fn(character) { character == Character"z" }) is None
  assert "".find_character(fn(character) { character.is_ascii() }) is None
}

test "trim_matching removes matching characters from both ends" {
  assert same("xxhixx".trim_matching(fn(character) { character == Character"x" }), expected: "hi")
  assert same("123abc456".trim_matching(fn(character) { character.is_ascii_digit() }), expected: "abc")
  assert same("xxxx".trim_matching(fn(character) { character == Character"x" }), expected: "")
  assert same("hi".trim_matching(fn(character) { character == Character"x" }), expected: "hi")
  assert same("\u{e9}a\u{e9}".trim_matching(fn(character) { character == Character"\u{e9}" }), expected: "a")
  assert same("".trim_matching(fn(character) { character == Character"x" }), expected: "")
}

test "split_matching splits at each character that matches" {
  var parts: List[String] = []
  for part in "a1b22c".split_matching(fn(character) { character.is_ascii_digit() }) {
    mut parts.push(part.to_string())
  }
  assert collected(parts, expected: ["a", "b", "", "c"])
  var one: List[String] = []
  for part in "plain".split_matching(fn(character) { character.is_ascii_digit() }) {
    mut one.push(part.to_string())
  }
  assert collected(one, expected: ["plain"])
}

test "split_whitespace yields the words, however much white space is between them" {
  var words: List[String] = []
  for word in "  the quick\t\tbrown\u{a0}fox \n".split_whitespace() {
    mut words.push(word.to_string())
  }
  assert collected(words, expected: ["the", "quick", "brown", "fox"])
  var none = 0
  for _ in "   \n ".split_whitespace() {
    none += 1
  }
  assert none == 0
  var empty = 0
  for _ in "".split_whitespace() {
    empty += 1
  }
  assert empty == 0
  var single: List[String] = []
  for word in "word".split_whitespace() {
    mut single.push(word.to_string())
  }
  assert collected(single, expected: ["word"])
}

test "lines yields each line without its line break" {
  var lines: List[String] = []
  for line in "first\nsecond\r\nthird".lines() {
    mut lines.push(line.to_string())
  }
  assert collected(lines, expected: ["first", "second", "third"])
  var ended: List[String] = []
  for line in "one\n\ntwo\n".lines() {
    mut ended.push(line.to_string())
  }
  assert collected(ended, expected: ["one", "", "two"])
  var none = 0
  for _ in "".lines() {
    none += 1
  }
  assert none == 0
  var only = 0
  for line in "\n".lines() {
    only += 1
    assert line.is_empty()
  }
  assert only == 1
}

test "characters are pushed onto a string as UTF-8" {
  var text = "a${1}"
  mut text.push_character(Character"b")
  mut text.push_character(Character"\u{e9}")
  mut text.push_character(Character"\u{20ac}")
  mut text.push_character(Character"\u{1F600}")
  assert text == "a1b\u{e9}\u{20ac}\u{1F600}"
  assert text.length() == 12
  assert String.from(Character"\u{e9}") == "\u{e9}"
  assert String.from(Character"z").length() == 1
}

test "clear empties a string, which can then be added to" {
  var text = "abc${1}"
  mut text.clear()
  assert text.is_empty()
  mut text.push("x")
  assert text == "x"
}

test "from_utf8 takes valid bytes and says where invalid ones start" {
  let valid: List[UInt8] = [104, 195, 169]
  assert String.from_utf8(own valid) is Ok(text) && text == "h\u{e9}"
  let none: List[UInt8] = []
  assert String.from_utf8(own none) is Ok(text) && text.is_empty()
  let replacement: List[UInt8] = [239, 191, 189]
  assert String.from_utf8(own replacement) is Ok(text) && text.length() == 3
  let cut_short: List[UInt8] = [104, 195]
  assert String.from_utf8(own cut_short) is Err(error) && error.valid_up_to == 1
  let stray: List[UInt8] = [97, 128, 98]
  assert String.from_utf8(own stray) is Err(error) && error.valid_up_to == 1
  let overlong: List[UInt8] = [192, 128]
  assert String.from_utf8(own overlong) is Err(error) && error.valid_up_to == 0
  let surrogate: List[UInt8] = [97, 98, 237, 160, 128]
  assert String.from_utf8(own surrogate) is Err(error) && error.valid_up_to == 2
  let too_large: List[UInt8] = [244, 144, 128, 128]
  assert String.from_utf8(own too_large) is Err(error) && error.valid_up_to == 0
}

test "replace swaps every occurrence that does not overlap the one before" {
  assert "a-b-c".replace("-", replacement: "+") == "a+b+c"
  assert "a-b-c".replace("-", replacement: "") == "abc"
  assert "a-b-c".replace("-", replacement: " and ") == "a and b and c"
  assert "aaaa".replace("aa", replacement: "b") == "bb"
  assert "aaa".replace("aa", replacement: "b") == "ba"
  assert "abc".replace("x", replacement: "y") == "abc"
  assert "abc".replace("abcd", replacement: "y") == "abc"
  assert "".replace("x", replacement: "y") == ""
  assert "abc".replace("abc", replacement: "") == ""
  assert "h\u{e9}llo h\u{e9}llo".replace("\u{e9}", replacement: "e") == "hello hello"
  assert "xyxyx".replace("xyx", replacement: "-") == "-yx"
}

test "replace_first swaps only the first occurrence" {
  assert "a-b-c".replace_first("-", replacement: "+") == "a+b-c"
  assert "abc".replace_first("x", replacement: "y") == "abc"
  assert "abc".replace_first("c", replacement: "") == "ab"
  assert "abc".replace_first("a", replacement: "xyz") == "xyzbc"
  assert "ab".replace_first("abc", replacement: "y") == "ab"
}

test "padding fills up to a width counted in characters" {
  assert "7".pad_start(3, fill: Character"0") == "007"
  assert "7".pad_end(3) == "7  "
  assert "abc".pad_start(3) == "abc"
  assert "abcd".pad_start(3) == "abcd"
  assert "".pad_end(2, fill: Character"-") == "--"
  assert "h\u{e9}".pad_start(4, fill: Character"\u{2022}") == "\u{2022}\u{2022}h\u{e9}"
  assert "x".pad_end(3, fill: Character"\u{1f600}").length() == 9
}

test "pop_character takes the last character whatever its length" {
  var text: String = "a\u{e9}\u{20ac}\u{1f600}"
  assert mut text.pop_character() == Some(Character"\u{1f600}")
  assert mut text.pop_character() == Some(Character"\u{20ac}")
  assert mut text.pop_character() == Some(Character"\u{e9}")
  assert text == "a"
  assert mut text.pop_character() == Some(Character"a")
  assert mut text.pop_character() is None
  assert text.is_empty()
}

test "insert and remove_range change the middle of a string" {
  var text: String = "hello world"
  mut text.insert(5, text: ",")
  assert text == "hello, world"
  mut text.insert(0, text: ">> ")
  assert text == ">> hello, world"
  mut text.insert(text.length(), text: "!")
  assert text == ">> hello, world!"
  mut text.insert(3, text: "")
  assert text == ">> hello, world!"
  mut text.remove_range(0, to: 3)
  assert text == "hello, world!"
  mut text.remove_range(5, to: 6)
  assert text == "hello world!"
  mut text.remove_range(4, to: 4)
  assert text == "hello world!"
  mut text.remove_range(5, to: text.length())
  assert text == "hello"
  var accented: String = "caf\u{e9}"
  mut accented.insert(3, text: "f")
  assert accented == "caff\u{e9}"
  mut accented.remove_range(4, to: 6)
  assert accented == "caff"
}

test "bytes that are not text become the replacement character, once for each broken sequence" {
  let valid: List[UInt8] = [104, 195, 169]
  assert String.from_utf8_lossy(valid) == "h\u{e9}"
  let none: List[UInt8] = []
  assert String.from_utf8_lossy(none) == ""
  let stray: List[UInt8] = [97, 128, 98]
  assert String.from_utf8_lossy(stray) == "a\u{fffd}b"
  let cut_short: List[UInt8] = [104, 226, 130]
  assert String.from_utf8_lossy(cut_short) == "h\u{fffd}"
  let cut_in_middle: List[UInt8] = [226, 130, 97]
  assert String.from_utf8_lossy(cut_in_middle) == "\u{fffd}a"
  let overlong: List[UInt8] = [192, 128]
  assert String.from_utf8_lossy(overlong) == "\u{fffd}\u{fffd}"
  let surrogate: List[UInt8] = [237, 160, 128]
  assert String.from_utf8_lossy(surrogate) == "\u{fffd}\u{fffd}\u{fffd}"
  let four: List[UInt8] = [240, 159, 152, 97]
  assert String.from_utf8_lossy(four) == "\u{fffd}a"
  let whole: List[UInt8] = [240, 159, 152, 128, 255]
  assert String.from_utf8_lossy(whole) == "\u{1f600}\u{fffd}"
}

test "UTF-16 units become a string, and a lone surrogate says where it is" {
  let plain: List[UInt16] = [104, 233, 8364]
  assert String.from_utf16(plain) is Ok(text) && text == "h\u{e9}\u{20ac}"
  let pair: List[UInt16] = [55357, 56832, 33]
  assert String.from_utf16(pair) is Ok(text) && text == "\u{1f600}!"
  let none: List[UInt16] = []
  assert String.from_utf16(none) is Ok(text) && text.is_empty()
  let lone_high: List[UInt16] = [97, 55357]
  assert String.from_utf16(lone_high) is Err(error) && error.valid_up_to == 1
  let lone_low: List[UInt16] = [56832, 97]
  assert String.from_utf16(lone_low) is Err(error) && error.valid_up_to == 0
  let wrong_order: List[UInt16] = [97, 98, 56832, 55357]
  assert String.from_utf16(wrong_order) is Err(error) && error.valid_up_to == 2
  assert String.from_utf16(wrong_order) is Err(error) && "${error}" == "the units are not UTF-16 at index 2"
  let round_trip = "a\u{1f600}\u{e9}"
  assert String.from_utf16(round_trip.to_utf16()) is Ok(text) && text == round_trip
  let stray: List[UInt8] = [97, 128, 98]
  assert String.from_utf8(own stray) is Err(error) && "${error}" == "the bytes are not UTF-8 at offset 1"
}

test "truncate and clear shorten a string and keep its room" {
  var text: String = "h\u{e9}llo world"
  mut text.push("!")
  let room = text.capacity()
  mut text.truncate(6)
  assert text == "h\u{e9}llo"
  assert text.capacity() == room
  mut text.truncate(6)
  assert text == "h\u{e9}llo"
  mut text.push(" again")
  assert text == "h\u{e9}llo again"
  mut text.truncate(0)
  assert text.is_empty()
  mut text.push("abc")
  mut text.clear()
  assert text.is_empty()
  assert text.capacity() == room
  mut text.push("xyz")
  assert text == "xyz"
  var literal: String = "constant"
  mut literal.truncate(3)
  assert literal == "con"
  mut literal.push("e")
  assert literal == "cone"
}

test "a string's uppercase uses the full mappings" {
  assert "hello, wörld".to_uppercase() == "HELLO, WÖRLD"
  assert "straße".to_uppercase() == "STRASSE"
  assert "ﬁn ŉ".to_uppercase() == "FIN ʼN"
  assert "\u{1F0} \u{390}".to_uppercase() == "J\u{30C} \u{399}\u{308}\u{301}"
  assert "中文 123".to_uppercase() == "中文 123"
  assert "".to_uppercase() == ""
  assert "мир".slice().to_uppercase() == "МИР"
}

test "a string's lowercase uses the final sigma at the end of a word" {
  assert "HELLO, WÖRLD".to_lowercase() == "hello, wörld"
  assert "ΟΔΥΣΣΕΥΣ".to_lowercase() == "οδυσσευς"
  assert "ΣΑΣ ΣΑΣ".to_lowercase() == "σας σας"
  assert "Σ".to_lowercase() == "σ"
  assert "ΑΣ'Α ΑΣ'".to_lowercase() == "ασ'α ας'"
  assert "ΑΣ.Α ΑΣ1".to_lowercase() == "ασ.α ας1"
  assert "İstanbul".to_lowercase() == "i̇stanbul"
  assert "ǅ".to_lowercase() == "ǆ"
  assert "".to_lowercase() == ""
}

fn joined_graphemes(text: StringSlice) -> String {
  var output = ""
  for grapheme in text.graphemes() {
    if output.length() > 0 {
      mut output.push("|")
    }
    mut output.push(grapheme)
  }
  output
}

test "graphemes keep a base character with its marks" {
  assert joined_graphemes("abc") == "a|b|c"
  assert joined_graphemes("e\u{301}a") == "e\u{301}|a"
  assert joined_graphemes("a\u{301}\u{323}b") == "a\u{301}\u{323}|b"
  assert joined_graphemes("\u{301}a") == "\u{301}|a"
  assert joined_graphemes("\u{BA8}\u{BBF}a") == "\u{BA8}\u{BBF}|a"
  assert joined_graphemes("\u{600}12") == "\u{600}1|2"
  assert joined_graphemes("") == ""
}

test "graphemes keep a carriage return with its line feed and split at other controls" {
  assert joined_graphemes("a\r\nb") == "a|\r\n|b"
  assert joined_graphemes("\n\r") == "\n|\r"
  assert joined_graphemes("a\tb") == "a|\t|b"
  assert joined_graphemes("\r\u{301}") == "\r|\u{301}"
  assert joined_graphemes("a\u{200D}b") == "a\u{200D}|b"
}

test "graphemes keep the jamo of a Hangul syllable together" {
  assert joined_graphemes("\u{1100}\u{1161}\u{11A8}") == "\u{1100}\u{1161}\u{11A8}"
  assert joined_graphemes("\u{AC00}\u{11A8}") == "\u{AC00}\u{11A8}"
  assert joined_graphemes("\u{AC01}\u{1100}") == "\u{AC01}|\u{1100}"
  assert joined_graphemes("\u{D55C}\u{AE00}") == "\u{D55C}|\u{AE00}"
  assert joined_graphemes("\u{1100}\u{1100}\u{1161}\u{1161}") == "\u{1100}\u{1100}\u{1161}\u{1161}"
  assert joined_graphemes("\u{AC01}\u{1161}") == "\u{AC01}|\u{1161}"
}

test "graphemes pair regional indicators and join emoji sequences" {
  assert joined_graphemes("\u{1F1FA}\u{1F1F8}\u{1F1EB}\u{1F1F7}") == "\u{1F1FA}\u{1F1F8}|\u{1F1EB}\u{1F1F7}"
  assert joined_graphemes("\u{1F1FA}\u{1F1F8}\u{1F1EB}") == "\u{1F1FA}\u{1F1F8}|\u{1F1EB}"
  assert joined_graphemes("a\u{1F1FA}\u{1F1F8}b") == "a|\u{1F1FA}\u{1F1F8}|b"
  assert joined_graphemes("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}") == "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}"
  assert joined_graphemes("\u{1F44D}\u{1F3FD}a") == "\u{1F44D}\u{1F3FD}|a"
  assert joined_graphemes("\u{1F468}\u{200D}a") == "\u{1F468}\u{200D}|a"
  assert joined_graphemes("\u{2764}\u{FE0F}\u{200D}\u{1F525}") == "\u{2764}\u{FE0F}\u{200D}\u{1F525}"
}

test "graphemes join an Indic linker to the consonant after it" {
  assert joined_graphemes("\u{915}\u{94D}\u{937}") == "\u{915}\u{94D}\u{937}"
  assert joined_graphemes("\u{915}\u{94D}a") == "\u{915}\u{94D}|a"
  assert joined_graphemes("\u{915}\u{94D}\u{200D}\u{937}") == "\u{915}\u{94D}\u{200D}\u{937}"
  assert joined_graphemes("\u{915}\u{937}") == "\u{915}|\u{937}"
  assert joined_graphemes("\u{915}\u{93C}\u{94D}\u{924}\u{93F}") == "\u{915}\u{93C}\u{94D}\u{924}\u{93F}"
  assert joined_graphemes("a\u{94D}\u{924}") == "a\u{94D}\u{924}"
  assert joined_graphemes("\u{94D}\u{915}") == "\u{94D}\u{915}"
  assert joined_graphemes("\u{1CF5}\u{915}") == "\u{1CF5}\u{915}"
}

test "a String yields the graphemes of its slice" {
  var count: USize = 0
  let text = "e\u{301}\u{1F1FA}\u{1F1F8}!"
  for _ in text.graphemes() {
    count += 1
  }
  assert count == 3
}
