use standard::growth
use standard::intrinsic
use standard::writing

public opaque type String(storage: intrinsic::Storage[UInt8])
  derives Copyable

public opaque type StringSlice(bytes: intrinsic::View[UInt8])
  derives Plain

public opaque type TextBuilder(text: String)

public trait FromTemplate {
  type Part
  fn from_template(template: Template[Self.Part]) -> Self
}

public opaque type Literal(text: StringSlice)
  derives Plain

public type Template[Part](literals: List[Literal], parts: List[Part])

impl Model for String {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    cost time finite
  {
    intrinsic::storage_model(self.storage)
  }
}

impl Model for StringSlice {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    cost time finite
  {
    intrinsic::view_model(self.bytes)
  }
}

impl Model for Literal {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    cost time finite
  {
    self.text.model()
  }
}

public fn String.length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_length(self.storage)
}

public fn String.is_empty(self) -> Bool
  ensures result == (self.model().length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn String.push(mut self, text: StringSlice)
  ensures identical(self.model(), old(self.model()).concatenate(text.model()))
{
  growth::reserve(mut self.storage, additional: text.length())
  for index in 0..text.length()
    invariant self.model().length() == old(self.model()).length() + yielded.length()
    invariant forall i in 0..old(self.model()).length() =>
      identical(self.model()[i], old(self.model())[i])
    invariant forall i in 0..yielded.length() =>
      identical(self.model()[old(self.model()).length() + i], text.model()[i])
    invariant intrinsic::storage_capacity(self.storage) >= old(self.model()).length() + text.length()
  {
    intrinsic::storage_push(mut self.storage, value: intrinsic::view_at(text.bytes, index: index))
  }
}

public fn String.slice(self) -> StringSlice
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  StringSlice(bytes: intrinsic::storage_view(self.storage))
}

public fn String.trim(self) -> StringSlice
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.slice().trim()
}

internal fn String.from_bytes(bytes: own intrinsic::Storage[UInt8]) -> String {
  if valid_utf8(intrinsic::storage_view(bytes)) {
    String(storage: own bytes)
  } else {
    String(storage: replaced(intrinsic::storage_view(bytes)))
  }
}

fn valid_utf8(bytes: intrinsic::View[UInt8]) -> Bool {
  var at: USize = 0
  var valid = true
  while valid && at < intrinsic::view_length(bytes) {
    let step = utf8_sequence(bytes, at)
    if step == 0 {
      valid = false
    } else {
      at += step
    }
  }
  valid
}

fn replaced(bytes: intrinsic::View[UInt8]) -> intrinsic::Storage[UInt8] {
  var fixed: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(intrinsic::view_length(bytes))
  var at: USize = 0
  while at < intrinsic::view_length(bytes) {
    let step = utf8_sequence(bytes, at)
    if step == 0 {
      growth::push(mut fixed, value: 239)
      growth::push(mut fixed, value: 191)
      growth::push(mut fixed, value: 189)
      at += 1
    } else {
      for index in at..at + step {
        growth::push(mut fixed, value: intrinsic::view_at(bytes, index: index))
      }
      at += step
    }
  }
  fixed
}

fn utf8_sequence(bytes: intrinsic::View[UInt8], at: USize) -> USize
  requires at < intrinsic::view_length(bytes)
  ensures result <= intrinsic::view_length(bytes) - at
{
  let first = intrinsic::view_at(bytes, index: at)
  let length: USize =
    if first < 128 { 1 } else if (first & 224) == 192 { 2 } else if (first & 240) == 224 { 3 } else if (first & 248) == 240 { 4 } else { 0 }
  if length == 0 || length > intrinsic::view_length(bytes) - at {
    0
  } else {
    let mask: UInt8 = if length == 1 { 127 } else if length == 2 { 31 } else if length == 3 { 15 } else { 7 }
    var code: UInt32 = intrinsic::convert(first & mask)
    var continued = true
    for index in at + 1..at + length {
      let byte = intrinsic::view_at(bytes, index: index)
      if (byte & 192) != 128 {
        continued = false
      }
      let low: UInt32 = intrinsic::convert(byte & 63)
      code = (code << 6) | low
    }
    let overlong = (length == 2 && code < 128) || (length == 3 && code < 2048) || (length == 4 && code < 65536)
    if !continued || overlong || code > 1114111 || (code >= 55296 && code <= 57343) { 0 } else { length }
  }
}

public fn StringSlice.length(self) -> USize
  ensures result == self.model().length()
  cost time O(1)
  cost allocations == 0
{
  intrinsic::view_length(self.bytes)
}

public fn StringSlice.byte(self, index: USize) -> UInt8
  requires index < self.length()
  ensures result == self.model()[index]
  cost time O(1)
  cost allocations == 0
{
  intrinsic::view_at(self.bytes, index: index)
}

public fn Literal.text(self) -> StringSlice
  ensures identical(result.model(), self.model())
  cost time O(1)
{
  self.text
}

public fn StringSlice.to_string(self) -> String
  ensures result.length() == self.length()
  cost time O(self.length())
  cost allocations <= 1
{
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(self.length())
  self.copy_onto(mut output)
  String(storage: own output)
}

public fn TextBuilder.new() -> TextBuilder {
  TextBuilder(text: String(storage: intrinsic::storage_empty()))
}

public fn TextBuilder.write(mut self, text: StringSlice) {
  mut self.text.push(text)
}

public fn TextBuilder.finish(own self) -> String {
  self.text
}

internal fn TextBuilder.write_byte(mut self, byte: UInt8) {
  writing::byte(mut self.text.storage, value: byte)
}

internal fn TextBuilder.write_float32(mut self, value: Float32) {
  writing::float32(mut self.text.storage, value: value)
}

internal fn TextBuilder.write_float64(mut self, value: Float64) {
  writing::float64(mut self.text.storage, value: value)
}

public fn TextBuilder.write_character(mut self, character: Character) {
  writing::character(mut self.text.storage, value: character)
}

internal fn TextBuilder.write_unsigned(mut self, value: UInt64) {
  writing::unsigned(mut self.text.storage, value: value)
}

internal fn TextBuilder.write_signed(mut self, value: Int64) {
  writing::signed(mut self.text.storage, value: value)
}

impl Equal for String {
  fn equal(self, other: String) -> Bool {
    self.slice() == other.slice()
  }
}

impl Ordered for String {
  fn compare(self, other: String) -> Ordering {
    let order = intrinsic::compare_bytes(intrinsic::storage_view(self.storage), right: intrinsic::storage_view(other.storage))
    if order < 0 { Ordering.Less } else if order > 0 { Ordering.Greater } else { Ordering.Equal }
  }
}

impl Hash for String {
  fn hash(self, hasher: mut Hasher) {
    let bytes = intrinsic::storage_view(self.storage)
    for index in 0..intrinsic::view_length(bytes) {
      mut hasher.write(intrinsic::convert(intrinsic::view_at(bytes, index: index)))
    }
  }
}

impl Display for String {
  fn display(self, output: mut TextBuilder) {
    mut output.write(self.slice())
  }
}

impl Equal for StringSlice {
  fn equal(self, other: StringSlice) -> Bool {
    intrinsic::compare_bytes(self.bytes, right: other.bytes) == 0
  }
}

impl Display for StringSlice {
  fn display(self, output: mut TextBuilder) {
    mut output.write(self)
  }
}

public trait Parse {
  type Error
  fn parse(text: StringSlice) -> Result[Self, Self.Error]
}

public type Utf8Error(valid_up_to: USize)
  derives Equal

impl Display for Utf8Error {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("the bytes are not UTF-8 at offset ")
    self.valid_up_to.display(mut output)
  }
}

public type Utf16Error(valid_up_to: USize)
  derives Equal

impl Display for Utf16Error {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("the units are not UTF-16 at index ")
    self.valid_up_to.display(mut output)
  }
}

public fn String.with_capacity(capacity: USize) -> String
  ensures result.length() == 0
{
  String(storage: intrinsic::storage_with_capacity(capacity))
}

public fn String.from_utf8(bytes: own List[UInt8]) -> Result[String, Utf8Error]
  cost time O(bytes.length())
  cost allocations == 0
{
  let text = String(storage: own bytes.storage)
  var offset: USize = 0
  while offset < text.length()
    invariant offset <= text.length()
    decreases text.length() - offset
    cost time O(offset)
    cost allocations == 0
  {
    let decoded = text.slice().decode(offset)
    if decoded.length == 1 && text.slice().byte(offset) >= 128 {
      return Err(Utf8Error(valid_up_to: offset))
    }
    offset += decoded.length
  }
  Ok(own text)
}

internal fn StringSlice.malformed_length(self, offset: USize) -> USize
  requires offset < self.length()
  ensures 1 <= result && result <= 3
  ensures result <= self.length() - offset
  cost time O(1)
  cost allocations == 0
{
  let lead = self.byte(offset)
  let wanted: USize = if lead >= 194 && lead <= 223 {
    2
  } else if lead >= 224 && lead <= 239 {
    3
  } else if lead >= 240 && lead <= 244 {
    4
  } else {
    1
  }
  if wanted == 1 || offset + 1 >= self.length() {
    return 1
  }
  let second = self.byte(offset + 1)
  let low: UInt8 = if lead == 224 { 160 } else if lead == 240 { 144 } else { 128 }
  let high: UInt8 = if lead == 237 { 159 } else if lead == 244 { 143 } else { 191 }
  if second < low || second > high {
    return 1
  }
  if wanted == 2 || offset + 2 >= self.length() {
    return 2
  }
  let third = self.byte(offset + 2)
  if third < 128 || third > 191 || wanted == 3 {
    return 2
  }
  3
}

internal fn StringSlice.is_malformed_at(self, offset: USize) -> Bool
  requires offset < self.length()
  cost time O(1)
  cost allocations == 0
{
  self.decode(offset).length == 1 && self.byte(offset) >= 128
}

internal fn reverse_run(storage: mut intrinsic::Storage[UInt8], from: USize, to: USize)
  requires from <= to
  requires to <= intrinsic::storage_length(storage)
  ensures intrinsic::storage_length(storage) == old(intrinsic::storage_length(storage))
  ensures intrinsic::storage_capacity(storage) == old(intrinsic::storage_capacity(storage))
  cost time O(to - from)
  cost allocations == 0
{
  var low = from
  var high = to
  while low + 1 < high
    invariant from <= low
    invariant low <= high
    invariant high <= to
    invariant intrinsic::storage_length(storage) == old(intrinsic::storage_length(storage))
    invariant intrinsic::storage_capacity(storage) == old(intrinsic::storage_capacity(storage))
    decreases high - low
    cost time O(low - from)
    cost allocations == 0
  {
    high -= 1
    intrinsic::storage_swap(mut storage, first: low, second: high)
    low += 1
  }
}

public fn String.from_utf8_lossy(bytes: Slice[UInt8]) -> String
  cost time O(bytes.length())
{
  let text = StringSlice(bytes: bytes.elements)
  if text.length() > USize.maximum / 4 {
    intrinsic::crash("a string cannot hold that many bytes".slice())
  }
  var budget: USize = 0
  var offset: USize = 0
  while offset < text.length()
    invariant offset <= text.length()
    invariant budget <= 2 * offset
    decreases text.length() - offset
    cost time O(offset)
  {
    if text.is_malformed_at(offset) {
      let run = text.malformed_length(offset)
      budget += 3 - run
      offset += run
    } else {
      offset += text.decode(offset).length
    }
  }
  let capacity = text.length() + budget
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(capacity)
  var position: USize = 0
  while position < text.length()
    invariant position <= text.length()
    invariant intrinsic::storage_length(output) + (text.length() - position) + budget <= capacity
    invariant intrinsic::storage_capacity(output) == capacity
    decreases text.length() - position
    cost time O(position)
  {
    if text.is_malformed_at(position) {
      let run = text.malformed_length(position)
      if budget >= 3 - run {
        intrinsic::storage_push(mut output, value: 239)
        intrinsic::storage_push(mut output, value: 191)
        intrinsic::storage_push(mut output, value: 189)
        budget -= 3 - run
      }
      position += run
    } else {
      let length = text.decode(position).length
      text.part(position, to: position + length).copy_onto(mut output)
      position += length
    }
  }
  String(storage: own output)
}

public fn String.from_utf16(units: Slice[UInt16]) -> Result[String, Utf16Error]
  cost time O(units.length())
{
  if units.length() > USize.maximum / 4 {
    intrinsic::crash("a string cannot hold that many bytes".slice())
  }
  var size: USize = 0
  var index: USize = 0
  while index < units.length()
    invariant index <= units.length()
    invariant size <= 3 * index
    decreases units.length() - index
    cost time O(index)
  {
    let unit = units[index]
    if unit < 55296 || unit > 57343 {
      size += if unit < 128 { 1 } else if unit < 2048 { 2 } else { 3 }
      index += 1
    } else if unit <= 56319 && index + 1 < units.length() && units[index + 1] >= 56320 && units[index + 1] <= 57343 {
      size += 4
      index += 2
    } else {
      return Err(Utf16Error(valid_up_to: index))
    }
  }
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(size)
  var room = size
  var position: USize = 0
  while position < units.length()
    invariant position <= units.length()
    invariant intrinsic::storage_length(output) + room == size
    invariant intrinsic::storage_capacity(output) == size
    decreases units.length() - position
    cost time O(position)
  {
    let unit: UInt32 = intrinsic::convert(units[position])
    var code = unit
    var step: USize = 1
    if unit >= 55296 && unit <= 56319 && position + 1 < units.length() {
      let low: UInt32 = intrinsic::convert(units[position + 1])
      if low >= 56320 && low <= 57343 {
        code = 65536 + (unit - 55296) * 1024 + (low - 56320)
        step = 2
      }
    }
    let character: Character = if code >= 55296 && code <= 57343 { Character"\u{fffd}" } else { intrinsic::convert(code) }
    if room >= character.utf8_length() {
      character.encode_onto(mut output)
      room -= character.utf8_length()
    }
    position += step
  }
  Ok(String(storage: own output))
}

public fn String.collect[Source: Cursor[Element = Character]](source: own Source) -> String {
  todo
}

public fn String.capacity(self) -> USize
  ensures result >= self.length()
  cost time O(1)
{
  intrinsic::storage_capacity(self.storage)
}

public fn String.reserve(mut self, additional: USize)
  ensures identical(self.model(), old(self.model()))
{
  growth::reserve(mut self.storage, additional: additional)
}

public fn String.clear(mut self)
  ensures self.length() == 0
  ensures self.capacity() == old(self.capacity())
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_shorten(mut self.storage, length: 0)
}

public fn String.push_character(mut self, character: Character)
  ensures self.length() == old(self.length()) + character.utf8_length()
  cost amortized time O(1)
{
  let code = character.code()
  if code < 128 {
    growth::push(mut self.storage, value: intrinsic::convert(code))
  } else if code < 2048 {
    growth::push(mut self.storage, value: intrinsic::convert(192 + code / 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code % 64))
  } else if code < 65536 {
    growth::push(mut self.storage, value: intrinsic::convert(224 + code / 4096))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code / 64 % 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code % 64))
  } else {
    growth::push(mut self.storage, value: intrinsic::convert(240 + code / 262144))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code / 4096 % 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code / 64 % 64))
    growth::push(mut self.storage, value: intrinsic::convert(128 + code % 64))
  }
}

public fn String.pop_character(mut self) -> Option[Character]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(1)
  cost allocations == 0
{
  if self.length() == 0 {
    return None
  }
  let start = self.slice().previous_start(self.length())
  let character = self.slice().decode(start).character
  intrinsic::storage_shorten(mut self.storage, length: start)
  Some(character)
}

public fn String.insert(mut self, offset: USize, text: StringSlice)
  requires offset <= self.length()
  requires self.is_boundary(offset)
  ensures self.length() == old(self.length()) + text.length()
  cost amortized time O(old(self.length()) + text.length())
{
  let end = self.length() + text.length()
  growth::reserve(mut self.storage, additional: text.length())
  text.copy_onto(mut self.storage)
  reverse_run(mut self.storage, from: offset, to: end)
  reverse_run(mut self.storage, from: offset, to: offset + text.length())
  reverse_run(mut self.storage, from: offset + text.length(), to: end)
}

public fn String.remove_range(mut self, from: USize, to: USize)
  requires from <= to
  requires to <= self.length()
  requires self.is_boundary(from)
  requires self.is_boundary(to)
  ensures self.length() == old(self.length()) - (to - from)
  cost time O(old(self.length()))
  cost allocations == 0
{
  let width = to - from
  if width == 0 {
    return
  }
  var index = to
  while index < self.length()
    invariant self.length() == old(self.length())
    invariant to <= index
    invariant index <= self.length()
    decreases self.length() - index
    cost allocations == 0
  {
    intrinsic::storage_swap(mut self.storage, first: index - width, second: index)
    index += 1
  }
  intrinsic::storage_shorten(mut self.storage, length: self.length() - width)
}

public fn String.truncate(mut self, length: USize)
  requires length <= self.length()
  requires self.is_boundary(length)
  ensures self.length() == length
  cost time O(1)
  cost allocations == 0
{
  intrinsic::storage_shorten(mut self.storage, length: length)
}

impl Default for String {
  fn default() -> String {
    ""
  }
}

impl From[Character] for String {
  fn from(value: own Character) -> String
  {
    var text = String(storage: intrinsic::storage_with_capacity(4))
    mut text.push_character(value)
    text
  }
}

public fn String.to_bytes(own self) -> List[UInt8]
  ensures result.length() == self.length()
  cost time O(1)
  cost allocations == 0
{
  List(storage: own self.storage)
}

public fn TextBuilder.with_capacity(capacity: USize) -> TextBuilder {
  TextBuilder(text: String.with_capacity(capacity))
}

public fn TextBuilder.length(self) -> USize
  cost time O(1)
{
  self.text.length()
}
