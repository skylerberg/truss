public opaque type Limited[Source: Reader](source: Source, left: UInt64)

public fn Limited[Source: Reader].new(source: own Source, limit: UInt64) -> Limited[Source] {
  Limited(source: own source, left: limit)
}

public fn Limited[Source: Reader].finish(own self) -> Source {
  self.source
}

impl Reader for Limited[Source: Reader] {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
