use standard::console
use standard::files
use standard::intrinsic
use standard::network
use standard::processes

public opaque type Handle(descriptor: intrinsic::Handle, number: UInt64)

public fn Handle.simulated(number: UInt64) -> Handle
  ensures result.number() == number
{
  Handle(descriptor: intrinsic::handle_from(-1), number: number)
}

public fn Handle.number(self) -> UInt64
  cost time O(1)
{
  self.number
}

public type Position =
  | FromStart(offset: UInt64)
  | FromCurrent(offset: Int64)
  | FromEnd(offset: Int64)
  derives Equal

public trait Reader {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
    ensures !(result is Ok(count) && (count > limit || buffer.length() != old(buffer.length()) + count))
    ensures !(result is Err(_) && buffer.length() != old(buffer.length()))

  fn read_to_end(mut self, buffer: mut List[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    let start = buffer.length()
    var more = true
    while more
      invariant buffer.length() >= start
    {
      let count = mut self.read(mut buffer, limit: 65536)?
      more = count > 0
    }
    Ok(buffer.length() - start)
  }

  fn read_exactly(mut self, buffer: mut List[UInt8], count: USize) -> Result[Unit, SystemError]
    uses Handles
  {
    var left = count
    while left > 0
      invariant left <= count
    {
      let got = mut self.read(mut buffer, limit: left)?
      if got == 0 {
        return Err(SystemError.UnexpectedEnd)
      }
      left -= got
    }
    Ok(Unit)
  }

  fn read_text(mut self) -> Result[String, SystemError]
    uses Handles
  {
    var bytes: List[UInt8] = []
    let _ = mut self.read_to_end(mut bytes)?
    match String.from_utf8(own bytes) {
      Ok(text) => Ok(own text)
      Err(_) => Err(SystemError.InvalidData)
    }
  }

  fn skip(mut self, count: UInt64) -> Result[UInt64, SystemError]
    uses Handles
  {
    var scratch: List[UInt8] = []
    var skipped: UInt64 = 0
    var more = true
    while more && skipped < count
      invariant skipped <= count
    {
      let left = count - skipped
      let limit: USize = if left > 65536 { 65536 } else { intrinsic::convert(left) }
      let got = mut self.read(mut scratch, limit: limit)?
      skipped += intrinsic::convert(got)
      mut scratch.clear()
      more = got > 0
    }
    Ok(skipped)
  }
}

public trait Writer {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
    ensures !(result is Ok(count) && count > bytes.length())

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles

  fn write_all(mut self, bytes: Slice[UInt8]) -> Result[Unit, SystemError]
    uses Handles
  {
    var written: USize = 0
    while written < bytes.length()
      invariant written <= bytes.length()
    {
      let count = mut self.write(bytes.slice_range(written, stop: bytes.length()))?
      if count == 0 {
        return Err(SystemError.NothingWritten)
      }
      written += count
    }
    Ok(Unit)
  }

  fn write_text(mut self, text: StringSlice) -> Result[Unit, SystemError]
    uses Handles
  {
    mut self.write_all(text.bytes())
  }
}

public trait Seek {
  fn seek(mut self, to: Position) -> Result[UInt64, SystemError]
    uses Handles

  fn position(mut self) -> Result[UInt64, SystemError]
    uses Handles
  {
    mut self.seek(Position.FromCurrent(offset: 0))
  }
}

public opaque type ByteReader(bytes: Slice[UInt8], position: USize)
  invariant position <= bytes.length()

public fn ByteReader.new(bytes: Slice[UInt8]) -> ByteReader
  cost time O(1)
{
  ByteReader(bytes: bytes, position: 0)
}

public fn ByteReader.remaining(self) -> Slice[UInt8]
  ensures result.length() == self.bytes.length() - self.position
  cost time O(1)
{
  self.bytes.slice_range(self.position, stop: self.bytes.length())
}

impl Reader for ByteReader {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError] {
    let left = self.bytes.length() - self.position
    let count = if limit < left { limit } else { left }
    mut buffer.append_slice(self.bytes.slice_range(self.position, stop: self.position + count))
    self.position += count
    Ok(count)
  }
}

public opaque type ByteWriter(bytes: List[UInt8])

public fn ByteWriter.new() -> ByteWriter
  cost time O(1)
{
  ByteWriter(bytes: [])
}

public fn ByteWriter.written(self) -> Slice[UInt8]
  cost time O(1)
{
  self.bytes.slice()
}

public fn ByteWriter.finish(own self) -> List[UInt8]
  cost time O(1)
{
  self.bytes
}

impl Writer for ByteWriter {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    mut self.bytes.append_slice(bytes)
    Ok(bytes.length())
  }

  fn flush(mut self) -> Result[Unit, SystemError] {
    Ok(Unit)
  }
}

public opaque type BufferedReader[Source: Reader](source: Source, pending: List[UInt8], start: USize, room: USize)
  invariant start <= pending.length()
  invariant room > 0

public fn BufferedReader[Source: Reader].new(source: own Source, capacity: USize = 65536) -> BufferedReader[Source] {
  BufferedReader(source: own source, pending: [], start: 0, room: if capacity == 0 { 1 } else { capacity })
}

internal fn BufferedReader[Source: Reader].fill(mut self) -> Result[USize, SystemError]
  uses Handles
  ensures !(result is Ok(count) && self.pending.length() - self.start != old(self.pending.length() - self.start) + count)
{
  if self.start > 0 {
    mut self.pending.remove_range(0..self.start)
    self.start = 0
  }
  mut self.source.read(mut self.pending, limit: self.room)
}

public fn BufferedReader[Source: Reader].read_until(
  mut self,
  delimiter: UInt8,
  buffer: mut List[UInt8],
) -> Result[USize, SystemError]
  uses Handles
{
  var taken: USize = 0
  var more = true
  while more
    invariant self.start <= self.pending.length()
    invariant self.room > 0
  {
    var index = self.start
    var found = false
    while index < self.pending.length() && !found
      invariant self.start <= index
      invariant index <= self.pending.length()
      decreases self.pending.length() - index + (if found { 0 } else { 1 })
    {
      found = self.pending[index] == delimiter
      index += 1
    }
    mut buffer.append_slice(self.pending.slice_range(self.start, stop: index))
    taken = taken.saturating_add(index - self.start)
    self.start = index
    if found {
      more = false
    } else {
      let count = mut self.fill()?
      more = count > 0
    }
  }
  Ok(taken)
}

public fn BufferedReader[Source: Reader].read_line(mut self) -> Result[Option[String], SystemError]
  uses Handles
{
  var bytes: List[UInt8] = []
  let count = mut self.read_until(10, buffer: mut bytes)?
  if count == 0 {
    return Ok(None)
  }
  if bytes.length() > 0 && bytes[bytes.length() - 1] == 10 {
    mut bytes.truncate(bytes.length() - 1)
    if bytes.length() > 0 && bytes[bytes.length() - 1] == 13 {
      mut bytes.truncate(bytes.length() - 1)
    }
  }
  match String.from_utf8(own bytes) {
    Ok(text) => Ok(Some(own text))
    Err(_) => Err(SystemError.InvalidData)
  }
}

public fn BufferedReader[Source: Reader].lines(mut self) yields own Result[String, SystemError]
  uses Handles
{
  var more = true
  while more
    invariant self.start <= self.pending.length()
    invariant self.room > 0
  {
    match mut self.read_line() {
      Ok(Some(line)) => yield Ok(own line)
      Ok(None) => {
        more = false
      }
      Err(error) => {
        more = false
        yield Err(error)
      }
    }
  }
}

public fn BufferedReader[Source: Reader].peek(mut self, count: USize) -> Result[Slice[UInt8], SystemError]
  uses Handles
  ensures !(result is Ok(seen) && seen.length() > count)
{
  var more = true
  while more && self.pending.length() - self.start < count
    invariant self.start <= self.pending.length()
    invariant self.room > 0
  {
    let got = mut self.fill()?
    more = got > 0
  }
  let available = self.pending.length() - self.start
  let shown = if available < count { available } else { count }
  Ok(self.pending.slice_range(self.start, stop: self.start + shown))
}

public fn BufferedReader[Source: Reader].finish(own self) -> Source {
  self.source
}

public fn BufferedReader[Source: Reader].source(self) lends Source {
  yield self.source
}

impl Reader for BufferedReader[Source: Reader] {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    if self.start == self.pending.length() {
      if limit >= self.room {
        return mut self.source.read(mut buffer, limit: limit)
      }
      let _ = mut self.fill()?
    }
    let available = self.pending.length() - self.start
    let count = if limit < available { limit } else { available }
    mut buffer.append_slice(self.pending.slice_range(self.start, stop: self.start + count))
    self.start += count
    Ok(count)
  }
}

impl Seek for BufferedReader[Source: Reader + Seek] {
  fn seek(mut self, to: Position) -> Result[UInt64, SystemError]
    uses Handles
  {
    let unread: UInt64 = intrinsic::convert(self.pending.length() - self.start)
    mut self.pending.clear()
    self.start = 0
    match to {
      FromCurrent(offset) => {
        let position = mut self.source.seek(Position.FromCurrent(offset: 0))?
        let target = if offset >= 0 {
          position.saturating_subtract(unread).saturating_add(offset.to_unsigned_bits())
        } else {
          position.saturating_subtract(unread).saturating_subtract(offset.unsigned_absolute())
        }
        mut self.source.seek(Position.FromStart(offset: target))
      }
      FromStart(offset) => mut self.source.seek(Position.FromStart(offset: offset))
      FromEnd(offset) => mut self.source.seek(Position.FromEnd(offset: offset))
    }
  }
}

public opaque type BufferedWriter[Sink: Writer](sink: Sink, pending: List[UInt8], room: USize)

public fn BufferedWriter[Sink: Writer].new(sink: own Sink, capacity: USize = 65536) -> BufferedWriter[Sink] {
  BufferedWriter(sink: own sink, pending: [], room: capacity)
}

public fn BufferedWriter[Sink: Writer].write_line(mut self, text: StringSlice) -> Result[Unit, SystemError]
  uses Handles
{
  mut self.write_all(text.bytes())?
  mut self.write_all("\n".bytes())
}

public fn BufferedWriter[Sink: Writer].finish(own self) -> Sink
  requires self.pending.length() == 0
{
  self.sink
}

impl Writer for BufferedWriter[Sink: Writer] {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    if bytes.length() >= self.room {
      mut self.flush()?
      return mut self.sink.write(bytes)
    }
    if self.pending.length() > self.room - bytes.length() {
      mut self.flush()?
    }
    mut self.pending.append_slice(bytes)
    Ok(bytes.length())
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
    ensures !(result is Ok(_) && self.pending.length() != 0)
  {
    mut self.sink.write_all(self.pending.slice())?
    mut self.pending.clear()
    mut self.sink.flush()
  }
}

public fn copy[Source: Reader, Sink: Writer](source: mut Source, sink: mut Sink) -> Result[UInt64, SystemError]
  uses Handles
{
  var scratch: List[UInt8] = []
  var copied: UInt64 = 0
  var more = true
  while more {
    let count = mut source.read(mut scratch, limit: 65536)?
    mut sink.write_all(scratch.slice())?
    copied = copied.saturating_add(intrinsic::convert(count))
    mut scratch.clear()
    more = count > 0
  }
  Ok(copied)
}

public opaque type Limited[Source: Reader](source: Source, left: UInt64)

public fn Limited[Source: Reader].new(source: own Source, limit: UInt64) -> Limited[Source] {
  Limited(source: own source, left: limit)
}

public fn Limited[Source: Reader].finish(own self) -> Source {
  self.source
}

impl Reader for Limited[Source: Reader] {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    let allowed: USize = if self.left < intrinsic::convert(limit) { intrinsic::convert(self.left) } else { limit }
    if allowed == 0 {
      return Ok(0)
    }
    let count = mut self.source.read(mut buffer, limit: allowed)?
    self.left -= intrinsic::convert(count)
    Ok(count)
  }
}

public type NoHandles()

impl Handles for NoHandles {
  fn read(self, handle: Handle, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError] {
    Err(SystemError.Closed)
  }

  fn write(self, handle: Handle, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    Err(SystemError.Closed)
  }

  fn read_at(
    self,
    handle: Handle,
    offset: UInt64,
    buffer: mut List[UInt8],
    limit: USize,
  ) -> Result[USize, SystemError] {
    Err(SystemError.Closed)
  }

  fn write_at(self, handle: Handle, offset: UInt64, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    Err(SystemError.Closed)
  }

  fn seek(self, handle: Handle, to: Position) -> Result[UInt64, SystemError] {
    Err(SystemError.Closed)
  }

  fn set_length(self, handle: Handle, length: UInt64) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn synchronize(self, handle: Handle) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn metadata(self, handle: Handle) -> Result[files::Metadata, SystemError] {
    Err(SystemError.Closed)
  }

  fn close(self, handle: own Handle) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn shut_down(self, handle: Handle, direction: network::Direction) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn set_timeout(
    self,
    handle: Handle,
    direction: network::Direction,
    timeout: Option[Duration],
  ) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn accept(self, listener: Handle) -> Result[network::Accepted, SystemError] {
    Err(SystemError.Closed)
  }

  fn send_to(
    self,
    socket: Handle,
    bytes: Slice[UInt8],
    address: network::SocketAddress,
  ) -> Result[USize, SystemError] {
    Err(SystemError.Closed)
  }

  fn receive_from(
    self,
    socket: Handle,
    buffer: mut List[UInt8],
    limit: USize,
  ) -> Result[network::Datagram, SystemError] {
    Err(SystemError.Closed)
  }

  fn wait(self, process: Handle) -> Result[processes::ExitStatus, SystemError] {
    Err(SystemError.Closed)
  }

  fn signal(self, process: Handle, signal: processes::Signal) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }

  fn terminal_size(self, terminal: Handle) -> Result[console::Size, SystemError] {
    Err(SystemError.Closed)
  }

  fn set_raw_mode(self, terminal: Handle, enabled: Bool) -> Result[Unit, SystemError] {
    Err(SystemError.Closed)
  }
}
