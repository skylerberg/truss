use standard::console
use standard::files
use standard::intrinsic
use standard::network
use standard::processes

public opaque type Handle(descriptor: intrinsic::Handle, number: UInt64)

public fn Handle.numbered(number: UInt64) -> Handle
  ensures result.number() == number
{
  Handle(descriptor: intrinsic::handle_from(-1), number: number)
}

public fn Handle.number(self) -> UInt64
  cost time O(1)
{
  self.number
}

public type Position =
  | FromStart(offset: UInt64)
  | FromCurrent(offset: Int64)
  | FromEnd(offset: Int64)
  derives Equal

public trait Reader {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles

  fn read_to_end(mut self, buffer: mut List[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    todo
  }

  fn read_exactly(mut self, buffer: mut List[UInt8], count: USize) -> Result[Unit, SystemError]
    uses Handles
  {
    todo
  }

  fn read_text(mut self) -> Result[String, SystemError]
    uses Handles
  {
    todo
  }

  fn skip(mut self, count: UInt64) -> Result[UInt64, SystemError]
    uses Handles
  {
    todo
  }
}

public trait Writer {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles

  fn write_all(mut self, bytes: Slice[UInt8]) -> Result[Unit, SystemError]
    uses Handles
  {
    todo
  }

  fn write_text(mut self, text: StringSlice) -> Result[Unit, SystemError]
    uses Handles
  {
    todo
  }
}

public trait Seek {
  fn seek(mut self, to: Position) -> Result[UInt64, SystemError]
    uses Handles

  fn position(mut self) -> Result[UInt64, SystemError]
    uses Handles
  {
    todo
  }
}

public opaque type ByteReader(bytes: Slice[UInt8], position: USize)

public fn ByteReader.new(bytes: Slice[UInt8]) -> ByteReader
  cost time O(1)
{
  ByteReader(bytes: bytes, position: 0)
}

public fn ByteReader.remaining(self) -> Slice[UInt8]
  cost time O(1)
{
  todo
}

impl Reader for ByteReader {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError] {
    todo
  }
}

public opaque type ByteWriter(bytes: List[UInt8])

public fn ByteWriter.new() -> ByteWriter
  cost time O(1)
{
  ByteWriter(bytes: [])
}

public fn ByteWriter.written(self) -> Slice[UInt8]
  cost time O(1)
{
  self.bytes.slice()
}

public fn ByteWriter.finish(own self) -> List[UInt8]
  cost time O(1)
{
  self.bytes
}

impl Writer for ByteWriter {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError] {
    todo
  }

  fn flush(mut self) -> Result[Unit, SystemError] {
    Ok(Unit)
  }
}

