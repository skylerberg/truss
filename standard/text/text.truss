use standard.core
use standard.growth
use standard.intrinsic
use standard.numbers.float_text
use standard.text.utf8
use standard.writing

public opaque type String(storage: intrinsic.Storage[UInt8])
  derives Copyable
  invariant utf8.is_valid(self.model())

public opaque type StringSlice(bytes: intrinsic.View[UInt8])
  derives Plain
  invariant utf8.is_valid(self.model())

public trait FromTemplate {
  type Part
  fn is_valid_template(literals: Slice[Literal]) -> Bool
  fn from_template(template: Template[Self.Part]) -> Self
    requires Self.is_valid_template(template.literals)
}

public opaque type Literal(text: StringSlice)
  derives Plain

public type Template[Part](literals: List[Literal], parts: List[Part])

impl Model for String {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    ensures identical(result, intrinsic.storage_model(self.storage))
  {
    intrinsic.storage_model(self.storage)
  }
}

impl Model for StringSlice {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    ensures identical(result, intrinsic.view_model(self.bytes))
  {
    intrinsic.view_model(self.bytes)
  }
}

impl Model for Literal {
  type Value = Sequence[UInt8]

  fn model(self) -> Sequence[UInt8]
    ensures identical(result, self.text.model())
  {
    self.text.model()
  }
}

public fn String.length(self) -> UInt64
  ensures result == self.model().length()
  ensures result <= core.maximum_length
  cost time O(1)
  cost allocations == 0
{
  intrinsic.storage_length(self.storage)
}

public fn String.push(mut self, text: StringSlice)
  ensures identical(self.model(), old(self.model()).concatenate(text.model()))
  cost amortized time O(text.length())
{
  growth.reserve(mut self.storage, additional: text.length())
  text.copy_onto(mut self.storage)
}

public fn String.slice(self) -> StringSlice
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  StringSlice(bytes: intrinsic.storage_view(self.storage))
}

internal fn String.from_bytes(bytes: own intrinsic.Storage[UInt8]) -> String {
  if find_malformed(intrinsic.storage_view(bytes)) is None {
    String(storage: own bytes)
  } else {
    String.from_utf8_lossy(Slice(elements: intrinsic.storage_view(bytes)))
  }
}

fn character_width(bytes: intrinsic.View[UInt8], at: UInt64) -> UInt64
  requires at < intrinsic.view_length(bytes)
  ensures result == utf8.width(intrinsic.view_model(bytes), at: at)
  cost time O(1)
  cost allocations == 0
{
  let remaining = intrinsic.view_length(bytes) - at
  let first = intrinsic.view_at(bytes, index: at)
  if first <= 127 {
    return 1
  }
  if first < 194 || first > 244 || remaining < 2 {
    return 0
  }
  let second = intrinsic.view_at(bytes, index: at + 1)
  let low: UInt8 = if first == 224 { 160 } else if first == 240 { 144 } else { 128 }
  let high: UInt8 = if first == 237 { 159 } else if first == 244 { 143 } else { 191 }
  if second < low || second > high {
    return 0
  }
  if first <= 223 {
    return 2
  }
  if remaining < 3 || !utf8.is_continuation(intrinsic.view_at(bytes, index: at + 2)) {
    return 0
  }
  if first <= 239 {
    return 3
  }
  if remaining < 4 || !utf8.is_continuation(intrinsic.view_at(bytes, index: at + 3)) {
    return 0
  }
  4
}

fn find_malformed(bytes: intrinsic.View[UInt8]) -> Option[UInt64]
  ensures (result is None) == utf8.is_valid(intrinsic.view_model(bytes))
  cost time O(intrinsic.view_length(bytes))
  cost allocations == 0
{
  var offset: UInt64 = 0
  while offset < intrinsic.view_length(bytes)
    invariant offset <= intrinsic.view_length(bytes)
    invariant utf8.is_valid(intrinsic.view_model(bytes)) == utf8.is_valid_from(intrinsic.view_model(bytes), at: offset)
    decreases intrinsic.view_length(bytes) - offset
    cost time O(offset)
    cost allocations == 0
  {
    let width = character_width(bytes, at: offset)
    if width == 0 {
      return Some(offset)
    }
    offset += width
  }
  None
}

fn push_character_bytes(output: mut intrinsic.Storage[UInt8], bytes: intrinsic.View[UInt8], at: UInt64, width: UInt64)
  requires at < intrinsic.view_length(bytes)
  requires width == utf8.width(intrinsic.view_model(bytes), at: at)
  requires width > 0
  requires intrinsic.storage_length(output) + width <= intrinsic.storage_capacity(output)
  requires utf8.is_valid(intrinsic.storage_model(output))
  ensures intrinsic.storage_length(output) == old(intrinsic.storage_length(output)) + width
  ensures intrinsic.storage_capacity(output) == old(intrinsic.storage_capacity(output))
  ensures utf8.is_valid(intrinsic.storage_model(output))
  cost time O(width)
  cost allocations == 0
{
  for index in at..at + width
    invariant intrinsic.storage_length(output) == old(intrinsic.storage_length(output)) + (index - at)
    invariant intrinsic.storage_capacity(output) == old(intrinsic.storage_capacity(output))
    invariant forall i in 0..old(intrinsic.storage_length(output)) =>
      intrinsic.storage_model(output)[i] == old(intrinsic.storage_model(output))[i]
    invariant forall i in at..index =>
      intrinsic.storage_model(output)[old(intrinsic.storage_length(output)) + i - at] == intrinsic.view_model(bytes)[i]
    cost allocations == 0
  {
    intrinsic.storage_push(mut output, value: intrinsic.view_at(bytes, index: index))
  }
  proof {
    assert identical(intrinsic.storage_model(output)[..old(intrinsic.storage_length(output))], old(intrinsic.storage_model(output)))
    assert utf8.width(intrinsic.storage_model(output), at: old(intrinsic.storage_length(output))) == width
    utf8.appending_a_valid_character_is_valid(intrinsic.storage_model(output), prefix: old(intrinsic.storage_length(output)))
  }
}

fn push_replacement_character(output: mut intrinsic.Storage[UInt8])
  requires intrinsic.storage_length(output) + 3 <= intrinsic.storage_capacity(output)
  requires utf8.is_valid(intrinsic.storage_model(output))
  ensures intrinsic.storage_length(output) == old(intrinsic.storage_length(output)) + 3
  ensures intrinsic.storage_capacity(output) == old(intrinsic.storage_capacity(output))
  ensures utf8.is_valid(intrinsic.storage_model(output))
  cost time O(1)
  cost allocations == 0
{
  intrinsic.storage_push(mut output, value: 239)
  intrinsic.storage_push(mut output, value: 191)
  intrinsic.storage_push(mut output, value: 189)
  proof {
    assert identical(intrinsic.storage_model(output)[..old(intrinsic.storage_length(output))], old(intrinsic.storage_model(output)))
    utf8.appending_a_valid_character_is_valid(intrinsic.storage_model(output), prefix: old(intrinsic.storage_length(output)))
  }
}



public fn StringSlice.length(self) -> UInt64
  ensures result == self.model().length()
  ensures result <= core.maximum_length
  cost time O(1)
  cost allocations == 0
{
  intrinsic.view_length(self.bytes)
}

public fn StringSlice.byte(self, index: UInt64) -> UInt8
  uses Panic unless index < self.length()
  ensures result == self.model()[index]
  cost time O(1)
  cost allocations == 0
{
  if index >= self.length() {
    Panic.crash("index out of bounds")
  }
  intrinsic.view_at(self.bytes, index: index)
}

public fn Literal.text(self) -> StringSlice
  ensures identical(result.model(), self.model())
  cost time O(1)
{
  self.text
}

public fn StringSlice.to_string(self) -> String
  ensures identical(result.model(), self.model())
  cost time O(self.length())
  cost allocations <= 1
{
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(self.length())
  self.copy_onto(mut output)
  String(storage: own output)
}

internal fn String.push_byte(mut self, byte: UInt8)
  requires byte <= 127
  ensures identical(self.model(), old(self.model()).append(byte))
  cost amortized time O(1)
{
  growth.push(mut self.storage, value: byte)
  proof {
    utf8.ascii_extension_is_valid(old(self.model()), after: intrinsic.storage_model(self.storage))
  }
}

internal fn String.push_float32(mut self, value: Float32)
{
  float_text.write_shortest_float32(mut self.storage, value: value)
  proof {
    utf8.ascii_extension_is_valid(old(self.model()), after: intrinsic.storage_model(self.storage))
  }
}

internal fn String.push_float64(mut self, value: Float64)
{
  float_text.write_shortest_float64(mut self.storage, value: value)
  proof {
    utf8.ascii_extension_is_valid(old(self.model()), after: intrinsic.storage_model(self.storage))
  }
}

internal fn String.push_unsigned(mut self, value: UInt64)
{
  writing.unsigned(mut self.storage, value: value)
  proof {
    utf8.ascii_extension_is_valid(old(self.model()), after: intrinsic.storage_model(self.storage))
  }
}

internal fn String.push_signed(mut self, value: Int64)
{
  writing.signed(mut self.storage, value: value)
  proof {
    utf8.ascii_extension_is_valid(old(self.model()), after: intrinsic.storage_model(self.storage))
  }
}

impl Equal for String {
  fn equal(self, other: String) -> Bool
    ensures result == identical(self.model(), other.model())
    cost time O(other.length())
    cost allocations == 0
  {
    self.slice() == other.slice()
  }
}

impl Ordered for String {
  fn compare(self, other: String) -> Ordering
    ensures (result == Ordering.Less) == (intrinsic.compare_bytes(intrinsic.storage_view(self.storage), right: intrinsic.storage_view(other.storage)) < 0)
    ensures (result == Ordering.Equal) == identical(self.model(), other.model())
    cost time O(self.length())
    cost allocations == 0
  {
    let order = intrinsic.compare_bytes(intrinsic.storage_view(self.storage), right: intrinsic.storage_view(other.storage))
    if order < 0 { Ordering.Less } else if order > 0 { Ordering.Greater } else { Ordering.Equal }
  }
}

impl Hash for String {
  fn hash(self, hasher: Hasher) -> Hasher
    ensures identical(result, hasher.after_bytes(self.model(), count: self.length()).write(self.length()))
    cost time O(self.length())
    cost allocations == 0
  {
    hasher.write_bytes(self.slice().bytes())
  }
}

impl Display for String {
  fn display(self, output: mut String) {
    mut output.push(self)
  }
}

impl Equal for StringSlice {
  fn equal(self, other: StringSlice) -> Bool
    ensures result == identical(self.model(), other.model())
    cost time O(other.length())
    cost allocations == 0
  {
    intrinsic.compare_bytes(other.bytes, right: self.bytes) == 0
  }
}

impl Display for StringSlice {
  fn display(self, output: mut String) {
    mut output.push(self)
  }
}

public trait Parse {
  type Error
  fn parse(text: StringSlice) -> Result[Self, Self.Error]
}

impl Parse for String {
  type Error = Never

  fn parse(text: StringSlice) -> Result[String, Never] {
    Ok(text.to_string())
  }
}

public type Utf8Error(valid_up_to: UInt64)
  derives Equal

impl Display for Utf8Error {
  fn display(self, output: mut String)
  {
    mut output.push("the bytes are not UTF-8 at offset ")
    self.valid_up_to.display(mut output)
  }
}

public type Utf16Error(valid_up_to: UInt64)
  derives Equal

impl Display for Utf16Error {
  fn display(self, output: mut String)
  {
    mut output.push("the units are not UTF-16 at index ")
    self.valid_up_to.display(mut output)
  }
}

public fn String.with_capacity(capacity: UInt64) -> String
  ensures result.length() == 0
{
  String(storage: intrinsic.storage_with_capacity(capacity))
}

public fn String.from_utf8(bytes: own List[UInt8]) -> Result[String, Utf8Error]
  ensures (result is Ok(_)) == utf8.is_valid(bytes.model())
  ensures !(result is Ok(text) && !identical(text.model(), bytes.model()))
  cost time O(bytes.length())
  cost allocations == 0
{
  match find_malformed(intrinsic.storage_view(bytes.storage)) {
    Some(offset) => Err(Utf8Error(valid_up_to: offset))
    None => Ok(String(storage: own bytes.storage))
  }
}

public fn String.from_valid_utf8(bytes: own List[UInt8]) -> String
  requires utf8.is_valid(bytes.model())
  ensures identical(result.model(), bytes.model())
  cost time O(1)
  cost allocations == 0
{
  String(storage: own bytes.storage)
}

fn malformed_length(bytes: intrinsic.View[UInt8], offset: UInt64) -> UInt64
  requires offset < intrinsic.view_length(bytes)
  ensures 1 <= result && result <= 3
  ensures result <= intrinsic.view_length(bytes) - offset
  cost time O(1)
  cost allocations == 0
{
  let length = intrinsic.view_length(bytes)
  let lead = intrinsic.view_at(bytes, index: offset)
  let wanted: UInt64 = if lead >= 194 && lead <= 223 {
    2
  } else if lead >= 224 && lead <= 239 {
    3
  } else if lead >= 240 && lead <= 244 {
    4
  } else {
    1
  }
  if wanted == 1 || offset + 1 >= length {
    return 1
  }
  let second = intrinsic.view_at(bytes, index: offset + 1)
  let low: UInt8 = if lead == 224 { 160 } else if lead == 240 { 144 } else { 128 }
  let high: UInt8 = if lead == 237 { 159 } else if lead == 244 { 143 } else { 191 }
  if second < low || second > high {
    return 1
  }
  if wanted == 2 || offset + 2 >= length {
    return 2
  }
  let third = intrinsic.view_at(bytes, index: offset + 2)
  if !utf8.is_continuation(third) || wanted == 3 {
    return 2
  }
  3
}


internal fn insert_run(storage: mut intrinsic.Storage[UInt8], offset: UInt64, text: StringSlice)
  requires offset <= intrinsic.storage_length(storage)
  requires intrinsic.storage_length(storage) + text.length() <= intrinsic.storage_capacity(storage)
  ensures identical(
    intrinsic.storage_model(storage),
    old(intrinsic.storage_model(storage))[0..offset]
      .concatenate(text.model())
      .concatenate(old(intrinsic.storage_model(storage))[offset..old(intrinsic.storage_length(storage))]),
  )
  ensures intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
  cost time O(intrinsic.storage_length(storage) + text.length())
  cost allocations == 0
{
  let end = intrinsic.storage_length(storage) + text.length()
  text.copy_onto(mut storage)
  reverse_run(mut storage, from: offset, to: end)
  reverse_run(mut storage, from: offset, to: offset + text.length())
  reverse_run(mut storage, from: offset + text.length(), to: end)
  proof {
    assert forall i in 0..offset => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
    assert forall i in offset..offset + text.length() => intrinsic.storage_model(storage)[i] == text.model()[i - offset]
    assert forall i in offset + text.length()..end =>
      intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i - text.length()]
  }
}

internal fn remove_run(storage: mut intrinsic.Storage[UInt8], from: UInt64, to: UInt64)
  requires from <= to
  requires to <= intrinsic.storage_length(storage)
  ensures identical(
    intrinsic.storage_model(storage),
    old(intrinsic.storage_model(storage))[0..from]
      .concatenate(old(intrinsic.storage_model(storage))[to..old(intrinsic.storage_length(storage))]),
  )
  ensures intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
  cost time O(intrinsic.storage_length(storage))
  cost allocations == 0
{
  let width = to - from
  var index = to
  while index < intrinsic.storage_length(storage)
    invariant intrinsic.storage_length(storage) == old(intrinsic.storage_length(storage))
    invariant intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
    invariant to <= index
    invariant index <= intrinsic.storage_length(storage)
    invariant forall i in 0..from => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
    invariant forall i in from..index - width =>
      intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i + width]
    invariant forall i in index..intrinsic.storage_length(storage) =>
      intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
    decreases intrinsic.storage_length(storage) - index
    cost time O(index - to)
    cost allocations == 0
  {
    intrinsic.storage_swap(mut storage, first: index - width, second: index)
    index += 1
  }
  intrinsic.storage_shorten(mut storage, length: intrinsic.storage_length(storage) - width)
}

internal fn reverse_run(storage: mut intrinsic.Storage[UInt8], from: UInt64, to: UInt64)
  requires from <= to
  requires to <= intrinsic.storage_length(storage)
  ensures intrinsic.storage_length(storage) == old(intrinsic.storage_length(storage))
  ensures intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
  ensures forall i in 0..from => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
  ensures forall i in from..to => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[from + to - 1 - i]
  ensures forall i in to..intrinsic.storage_length(storage) =>
    intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
  cost time O(to - from)
  cost allocations == 0
{
  var low = from
  var high = to
  while low + 1 < high
    invariant from <= low
    invariant low <= high
    invariant high <= to
    invariant low - from == to - high
    invariant intrinsic.storage_length(storage) == old(intrinsic.storage_length(storage))
    invariant intrinsic.storage_capacity(storage) == old(intrinsic.storage_capacity(storage))
    invariant forall i in 0..from => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
    invariant forall i in from..low => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[from + to - 1 - i]
    invariant forall i in low..high => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
    invariant forall i in high..to => intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[from + to - 1 - i]
    invariant forall i in to..intrinsic.storage_length(storage) =>
      intrinsic.storage_model(storage)[i] == old(intrinsic.storage_model(storage))[i]
    decreases high - low
    cost time O(low - from)
    cost allocations == 0
  {
    high -= 1
    intrinsic.storage_swap(mut storage, first: low, second: high)
    low += 1
  }
}

public fn String.from_utf8_lossy(bytes: Slice[UInt8]) -> String
  cost time O(bytes.length())
{
  let view = bytes.elements
  let length = intrinsic.view_length(view)
  if length > UInt64.maximum / 4 {
    intrinsic.crash("a string cannot hold that many bytes")
  }
  var budget: UInt64 = 0
  var offset: UInt64 = 0
  while offset < length
    invariant offset <= length
    invariant budget <= 2 * offset
    decreases length - offset
    cost time O(offset)
  {
    let width = character_width(view, at: offset)
    if width == 0 {
      let run = malformed_length(view, offset: offset)
      budget += 3 - run
      offset += run
    } else {
      offset += width
    }
  }
  let capacity = length + budget
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(capacity)
  var position: UInt64 = 0
  while position < length
    invariant position <= length
    invariant intrinsic.storage_length(output) + (length - position) + budget <= capacity
    invariant intrinsic.storage_capacity(output) == capacity
    invariant utf8.is_valid(intrinsic.storage_model(output))
    decreases length - position
    cost time O(position)
  {
    let width = character_width(view, at: position)
    if width == 0 {
      let run = malformed_length(view, offset: position)
      if budget >= 3 - run {
        push_replacement_character(mut output)
        budget -= 3 - run
      }
      position += run
    } else {
      push_character_bytes(mut output, bytes: view, at: position, width: width)
      position += width
    }
  }
  String(storage: own output)
}

public fn String.from_utf16(units: Slice[UInt16]) -> Result[String, Utf16Error]
  cost time O(units.length())
{
  if units.length() > UInt64.maximum / 4 {
    intrinsic.crash("a string cannot hold that many bytes")
  }
  var size: UInt64 = 0
  var index: UInt64 = 0
  while index < units.length()
    invariant index <= units.length()
    invariant size <= 3 * index
    decreases units.length() - index
    cost time O(index)
  {
    let unit = units[index]
    if unit < 55296 || unit > 57343 {
      size += if unit < 128 { 1 } else if unit < 2048 { 2 } else { 3 }
      index += 1
    } else if unit <= 56319 && index + 1 < units.length() && units[index + 1] >= 56320 && units[index + 1] <= 57343 {
      size += 4
      index += 2
    } else {
      return Err(Utf16Error(valid_up_to: index))
    }
  }
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(size)
  var room = size
  var position: UInt64 = 0
  while position < units.length()
    invariant position <= units.length()
    invariant intrinsic.storage_length(output) + room == size
    invariant intrinsic.storage_capacity(output) == size
    invariant utf8.is_valid(intrinsic.storage_model(output))
    decreases units.length() - position
    cost time O(position)
  {
    let unit: UInt32 = intrinsic.convert(units[position])
    var code = unit
    var step: UInt64 = 1
    if unit >= 55296 && unit <= 56319 && position + 1 < units.length() {
      let low: UInt32 = intrinsic.convert(units[position + 1])
      if low >= 56320 && low <= 57343 {
        code = 65536 + (unit - 55296) * 1024 + (low - 56320)
        step = 2
      }
    }
    let character: Character = if code >= 55296 && code <= 57343 { Character"\u{fffd}" } else { intrinsic.convert(code) }
    if room >= character.utf8_length() {
      character.encode_onto(mut output)
      room -= character.utf8_length()
    }
    position += step
  }
  Ok(String(storage: own output))
}

public fn String.collect[Source: Cursor[Element = Character]](source: own Source) -> String
  uses Source.Uses, RunForever unless Source: FiniteCursor
{
  var cursor = own source
  var text: String = ""
  while mut cursor.next() is Some(character)
    decreases cursor.remaining() when Source: FiniteCursor
  {
    mut text.push_character(character)
  }
  text
}

public fn String.capacity(self) -> UInt64
  ensures result >= self.length()
  ensures result == (intrinsic.storage_capacity(self.storage))
  cost time O(1)
{
  intrinsic.storage_capacity(self.storage)
}

public fn String.reserve(mut self, additional: UInt64)
  ensures identical(self.model(), old(self.model()))
{
  growth.reserve(mut self.storage, additional: additional)
}

public fn String.clear(mut self)
  ensures self.length() == 0
  ensures self.capacity() == old(self.capacity())
  cost time O(1)
  cost allocations == 0
{
  intrinsic.storage_shorten(mut self.storage, length: 0)
}

public fn String.push_character(mut self, character: Character)
  ensures self.length() == old(self.length()) + character.utf8_length()
  ensures identical(self.model()[..old(self.length())], old(self.model()))
  ensures self.is_boundary(old(self.length()))
  cost amortized time O(1)
{
  growth.reserve(mut self.storage, additional: character.utf8_length())
  character.encode_onto(mut self.storage)
}

public fn String.pop_character(mut self) -> Option[Character]
  ensures (result is None) == (old(self.length()) == 0)
  cost time O(1)
  cost allocations == 0
{
  if self.length() == 0 {
    return None
  }
  let start = self.slice().previous_start(self.length())
  let character = self.slice().decode(start).character
  proof {
    utf8.slice_is_valid(self.model(), from: 0, to: start)
  }
  intrinsic.storage_shorten(mut self.storage, length: start)
  proof {
    assert identical(intrinsic.storage_model(self.storage), old(self.model())[0..start])
  }
  Some(character)
}

public fn String.insert(mut self, offset: UInt64, text: StringSlice)
  uses Panic unless offset <= self.length() && self.is_boundary(offset)
  ensures identical(self.model(), old(self.model())[0..offset].concatenate(text.model()).concatenate(old(self.model())[offset..old(self.length())]))
  ensures self.length() == old(self.length()) + text.length()
  cost amortized time O(old(self.length()) + text.length())
{
  if offset > self.length() || !self.is_boundary(offset) {
    Panic.crash("slice out of bounds")
  }
  growth.reserve(mut self.storage, additional: text.length())
  insert_run(mut self.storage, offset: offset, text: text)
  proof {
    let before = old(self.model())
    utf8.slice_is_valid(before, from: 0, to: offset)
    utf8.slice_is_valid(before, from: offset, to: before.length())
    utf8.concatenation_is_valid(before[0..offset], second: text.model())
    utf8.concatenation_is_valid(before[0..offset].concatenate(text.model()), second: before[offset..before.length()])
  }
}

public fn String.remove_range(mut self, from: UInt64, to: UInt64)
  uses Panic unless from <= to && to <= self.length() && self.is_boundary(from) && self.is_boundary(to)
  ensures identical(self.model(), old(self.model())[0..from].concatenate(old(self.model())[to..old(self.length())]))
  ensures self.length() == old(self.length()) - (to - from)
  cost time O(old(self.length()))
  cost allocations == 0
{
  if from > to || to > self.length() || !self.is_boundary(from) || !self.is_boundary(to) {
    Panic.crash("slice out of bounds")
  }
  remove_run(mut self.storage, from: from, to: to)
  proof {
    let before = old(self.model())
    utf8.slice_is_valid(before, from: 0, to: from)
    utf8.slice_is_valid(before, from: to, to: before.length())
    utf8.concatenation_is_valid(before[0..from], second: before[to..before.length()])
  }
}

public fn String.truncate(mut self, length: UInt64)
  uses Panic unless length <= self.length() && self.is_boundary(length)
  ensures self.length() == length
  cost time O(1)
  cost allocations == 0
{
  if length > self.length() || !self.is_boundary(length) {
    Panic.crash("slice out of bounds")
  }
  mut self.shorten(length)
}

internal fn String.shorten(mut self, length: UInt64)
  requires length <= self.length()
  requires self.is_boundary(length)
  ensures identical(self.model(), old(self.model())[0..length])
  cost time O(1)
  cost allocations == 0
{
  utf8.shorten_to_boundary(mut self.storage, length: length)
}

impl Default for String {
  fn default() -> String
    ensures result.length() == 0
    cost time O(1)
    cost allocations == 0
  {
    ""
  }
}

impl From[Character] for String {
  fn from(value: own Character) -> String
  {
    var text = String(storage: intrinsic.storage_with_capacity(4))
    mut text.push_character(value)
    text
  }
}

public fn String.to_bytes(own self) -> List[UInt8]
  ensures result.length() == self.length()
  cost time O(1)
  cost allocations == 0
{
  List(storage: own self.storage)
}
