use standard::intrinsic
use standard::text::unicode_data

fn search(count: USize, compare: (fn(row: USize) -> Ordering requires row < count cost time O(1))) -> Option[USize]
  ensures !(result is Some(row) && row >= count)
  cost time O(1)
{
  var low: USize = 0
  var high = count
  let steps: USize = 64
  for _ in 0..steps
    invariant low <= high
    invariant high <= count
  {
    if low < high {
      let middle = low + (high - low) / 2
      match compare(middle) {
        Less => {
          high = middle
        }
        Greater => {
          low = middle + 1
        }
        Equal => return Some(middle)
      }
    }
  }
  None
}

fn ranges_contain(ranges: Slice[UInt32], code: UInt32) -> Bool
  cost time O(1)
{
  search(ranges.length() / 2, compare: fn(row) {
    if code < ranges[2 * row] {
      Ordering.Less
    } else if code > ranges[2 * row + 1] {
      Ordering.Greater
    } else {
      Ordering.Equal
    }
  }) is Some(_)
}

fn mapping_of(mappings: Slice[UInt32], code: UInt32) -> UInt32
  cost time O(1)
{
  match search(mappings.length() / 2, compare: fn(row) { code.compare(mappings[2 * row]) }) {
    Some(row) => mappings[2 * row + 1]
    None => code
  }
}

internal type Expansion(first: UInt32, second: UInt32, third: UInt32)

fn expansion_of(expansions: Slice[UInt32], code: UInt32) -> Option[Expansion]
  cost time O(1)
{
  match search(expansions.length() / 4, compare: fn(row) { code.compare(expansions[4 * row]) }) {
    Some(row) => Some(
      Expansion(first: expansions[4 * row + 1], second: expansions[4 * row + 2], third: expansions[4 * row + 3]),
    )
    None => None
  }
}

internal fn is_alphabetic(code: UInt32) -> Bool
  cost time O(1)
{
  var contained = ranges_contain(unicode_data::alphabetic_ranges[..], code: code)
  contained
}

internal fn is_numeric(code: UInt32) -> Bool
  cost time O(1)
{
  var contained = ranges_contain(unicode_data::numeric_ranges[..], code: code)
  contained
}

