public fn StringSlice.to_bytes(self) -> List[UInt8]
  ensures result.length() == self.length()
  cost time O(self.length())
{
  var bytes: List[UInt8] = List.with_capacity(self.length())
  for index in 0..self.length()
    invariant bytes.length() == yielded.length()
  {
    mut bytes.push(self.byte(index))
  }
  bytes
}

