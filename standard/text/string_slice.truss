impl Ordered for StringSlice {
  fn compare(self, other: StringSlice) -> Ordering
  {
    let order = intrinsic::compare_bytes(self.bytes, right: other.bytes)
    if order < 0 { Ordering.Less } else if order > 0 { Ordering.Greater } else { Ordering.Equal }
  }
}

impl Hash for StringSlice {
  fn hash(self, hasher: mut Hasher) {
    mut hasher.write_bytes(self.bytes())
  }
}
