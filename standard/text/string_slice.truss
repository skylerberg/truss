internal fn ascii_lowercase(byte: UInt8) -> UInt8
  cost time O(1)
{
  if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

internal fn ascii_uppercase(byte: UInt8) -> UInt8
  cost time O(1)
{
  if byte >= 97 && byte <= 122 { byte - 32 } else { byte }
}

public fn StringSlice.equal_ignoring_ascii_case(self, other: StringSlice) -> Bool
  cost time O(self.length())
{
  if self.length() != other.length() {
    return false
  }
  for index in 0..self.length() {
    if ascii_lowercase(self.byte(index)) != ascii_lowercase(other.byte(index)) {
      return false
    }
  }
  true
}

