public fn StringSlice.starts_with(self, prefix: StringSlice) -> Bool
  cost time O(prefix.length())
{
  prefix.length() <= self.length() && self.matches_at(prefix, offset: 0)
}

public fn StringSlice.ends_with(self, suffix: StringSlice) -> Bool
  cost time O(suffix.length())
{
  suffix.length() <= self.length() && self.matches_at(suffix, offset: self.length() - suffix.length())
}

public fn StringSlice.strip_prefix(self, prefix: StringSlice) -> Option[StringSlice]
  ensures (result is Some(_)) == self.starts_with(prefix)
  cost time O(prefix.length())
{
  if self.starts_with(prefix) { Some(self.part(prefix.length(), to: self.length())) } else { None }
}

public fn StringSlice.strip_suffix(self, suffix: StringSlice) -> Option[StringSlice]
  ensures (result is Some(_)) == self.ends_with(suffix)
  cost time O(suffix.length())
{
  if self.ends_with(suffix) { Some(self.part(0, to: self.length() - suffix.length())) } else { None }
}

internal fn StringSlice.leading_whitespace(self) -> USize
  ensures result <= self.length()
  cost time O(self.length())
{
  var start: USize = 0
  while start < self.length()
    invariant start <= self.length()
    decreases self.length() - start
    cost time O(start)
  {
    let decoded = self.decode(start)
    if !decoded.character.is_whitespace() {
      return start
    }
    start += decoded.length
  }
  start
}

internal fn StringSlice.trailing_whitespace_start(self) -> USize
  ensures result <= self.length()
  cost time O(self.length())
{
  var end = self.length()
  while end > 0
    invariant end <= self.length()
    decreases end
    cost time O(self.length() - end)
  {
    let start = self.previous_start(end)
    if !self.decode(start).character.is_whitespace() {
      return end
    }
    end = start
  }
  end
}

public fn StringSlice.trim(self) -> StringSlice
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.trim_start().trim_end()
}

public fn StringSlice.trim_start(self) -> StringSlice
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.part(self.leading_whitespace(), to: self.length())
}

public fn StringSlice.trim_end(self) -> StringSlice
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.part(0, to: self.trailing_whitespace_start())
}

