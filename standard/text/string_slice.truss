use standard::core
use standard::intrinsic

public fn StringSlice.is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn StringSlice.bytes(self) -> Slice[UInt8]
  ensures result.length() == self.length()
  cost time O(1)
{
  Slice(elements: self.bytes)
}

internal type Decoded(character: Character, length: USize)

internal fn sequence_length(first: UInt8) -> USize
  ensures result <= 4
  cost time O(1)
{
  if first < 128 {
    1
  } else if first < 194 {
    0
  } else if first < 224 {
    2
  } else if first < 240 {
    3
  } else if first < 245 {
    4
  } else {
    0
  }
}

internal fn StringSlice.continuation(self, index: USize) -> UInt32
  requires index < self.length()
  ensures result <= 64
  cost time O(1)
{
  let byte = self.byte(index)
  if byte >= 128 && byte <= 191 { intrinsic::convert(byte - 128) } else { 64 }
}

internal fn StringSlice.decode(self, offset: USize) -> Decoded
  requires offset < self.length()
  ensures 1 <= result.length
  ensures result.length <= self.length() - offset
  cost time O(1)
{
  let invalid = Decoded(character: Character.replacement, length: 1)
  let first = self.byte(offset)
  let length = sequence_length(first)
  if length == 0 || length > self.length() - offset {
    return invalid
  }
  if length == 1 {
    return Decoded(character: intrinsic::convert(first), length: 1)
  }
  let second = self.continuation(offset + 1)
  if second == 64 {
    return invalid
  }
  if length == 2 {
    let lead: UInt32 = intrinsic::convert(first - 192)
    return Decoded(character: intrinsic::convert(lead * 64 + second), length: 2)
  }
  let third = self.continuation(offset + 2)
  if third == 64 {
    return invalid
  }
  if length == 3 {
    let lead: UInt32 = intrinsic::convert(first - 224)
    let code = lead * 4096 + second * 64 + third
    if code < 2048 || (code >= 55296 && code <= 57343) {
      return invalid
    }
    return Decoded(character: intrinsic::convert(code), length: 3)
  }
  let fourth = self.continuation(offset + 3)
  if fourth == 64 {
    return invalid
  }
  let lead: UInt32 = intrinsic::convert(first - 240)
  let code = lead * 262144 + second * 4096 + third * 64 + fourth
  if code < 65536 || code > 1114111 {
    invalid
  } else {
    Decoded(character: intrinsic::convert(code), length: 4)
  }
}

internal fn StringSlice.previous_start(self, offset: USize) -> USize
  requires 0 < offset
  requires offset <= self.length()
  ensures result < offset
  ensures offset - result <= 4
  cost time O(1)
{
  var start = offset - 1
  var steps: USize = 0
  while start > 0 && steps < 3 && self.continuation(start) != 64
    invariant start < offset
    invariant offset - start == steps + 1
    invariant steps <= 3
    decreases start
  {
    start -= 1
    steps += 1
  }
  if start + self.decode(start).length == offset { start } else { offset - 1 }
}

internal fn StringSlice.part(self, from: USize, to: USize) -> StringSlice
  requires from <= to
  requires to <= self.length()
  ensures result.length() == to - from
  ensures forall index in 0..result.length() => result.model()[index] == self.model()[from + index]
  cost time O(1)
{
  StringSlice(bytes: intrinsic::view_slice(self.bytes, start: from, stop: to))
}

internal fn StringSlice.matches_at(self, pattern: StringSlice, offset: USize) -> Bool
  requires offset <= self.length()
  requires pattern.length() <= self.length() - offset
  cost time O(pattern.length())
{
  intrinsic::compare_bytes(self.part(offset, to: offset + pattern.length()).bytes, right: pattern.bytes) == 0
}

public fn StringSlice.is_ascii(self) -> Bool
  cost time O(self.length())
{
  for index in 0..self.length() {
    if self.byte(index) >= 128 {
      return false
    }
  }
  true
}

public fn StringSlice.is_boundary(self, offset: USize) -> Bool
  cost time O(1)
{
  offset == self.length() || (offset < self.length() && (self.byte(offset) & 0xC0) != 0x80)
}

public fn StringSlice.characters(self) yields Character
  ensures yielded.length() <= self.length()
  cost time O(self.length())
{
  var offset: USize = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant yielded.length() <= offset
    decreases self.length() - offset
    cost time O(offset)
  {
    let decoded = self.decode(offset)
    yield decoded.character
    offset += decoded.length
  }
}

public fn StringSlice.characters_with_offsets(self) yields core::Indexed[Character]
  ensures result.index < self.length()
  ensures yielded.length() <= self.length()
  cost time O(self.length())
{
  var offset: USize = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant yielded.length() <= offset
    decreases self.length() - offset
    cost time O(offset)
  {
    let decoded = self.decode(offset)
    yield core::Indexed(index: offset, element: decoded.character)
    offset += decoded.length
  }
}

public fn StringSlice.character_count(self) -> USize
  ensures result <= self.length()
  cost time O(self.length())
{
  var count: USize = 0
  var offset: USize = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant count <= offset
    decreases self.length() - offset
    cost time O(offset)
  {
    offset += self.decode(offset).length
    count += 1
  }
  count
}

public fn StringSlice.first_character(self) -> Option[Character]
  ensures (result is None) == self.is_empty()
  cost time O(1)
{
  if self.is_empty() { None } else { Some(self.decode(0).character) }
}

public fn StringSlice.last_character(self) -> Option[Character]
  ensures (result is None) == self.is_empty()
  cost time O(1)
{
  if self.is_empty() {
    None
  } else {
    Some(self.decode(self.previous_start(self.length())).character)
  }
}

