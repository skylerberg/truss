use standard::core
use standard::intrinsic
use standard::text::unicode_tables

public let Character.replacement: Character = Character"\u{FFFD}"

public let Character.maximum: Character = Character"\u{10FFFF}"

public transparent fn Character.code(self) -> UInt32
  ensures result <= 1114111
  ensures result < 55296 || result > 57343
  cost time O(1)
  cost allocations == 0
{
  intrinsic::convert(self)
}

internal fn Character.scalar_index(self) -> UInt32
  ensures result < 1112064
  cost time O(1)
{
  let code = self.code()
  if code < 55296 { code } else { code - 2048 }
}

internal fn Character.at_scalar_index(index: UInt32) -> Character
  requires index < 1112064
  ensures result.scalar_index() == index
  cost time O(1)
{
  if index < 55296 { intrinsic::convert(index) } else { intrinsic::convert(index + 2048) }
}

internal fn Character.encode_onto(self, output: mut intrinsic::Storage[UInt8])
  requires intrinsic::storage_length(output) + self.utf8_length() <= intrinsic::storage_capacity(output)
  ensures intrinsic::storage_length(output) == old(intrinsic::storage_length(output)) + self.utf8_length()
  ensures intrinsic::storage_capacity(output) == old(intrinsic::storage_capacity(output))
  cost time O(1)
  cost allocations == 0
{
  let code = self.code()
  if code < 128 {
    intrinsic::storage_push(mut output, value: intrinsic::convert(code))
  } else if code < 2048 {
    intrinsic::storage_push(mut output, value: intrinsic::convert(192 + code / 64))
    intrinsic::storage_push(mut output, value: intrinsic::convert(128 + code % 64))
  } else if code < 65536 {
    intrinsic::storage_push(mut output, value: intrinsic::convert(224 + code / 4096))
    intrinsic::storage_push(mut output, value: intrinsic::convert(128 + code / 64 % 64))
    intrinsic::storage_push(mut output, value: intrinsic::convert(128 + code % 64))
  } else {
    intrinsic::storage_push(mut output, value: intrinsic::convert(240 + code / 262144))
    intrinsic::storage_push(mut output, value: intrinsic::convert(128 + code / 4096 % 64))
    intrinsic::storage_push(mut output, value: intrinsic::convert(128 + code / 64 % 64))
    intrinsic::storage_push(mut output, value: intrinsic::convert(128 + code % 64))
  }
}

public fn Character.utf8_length(self) -> USize
  ensures 1 <= result && result <= 4
  ensures (result == 1) == (self.code() < 128)
  ensures (result == 2) == (128 <= self.code() && self.code() < 2048)
  ensures (result == 3) == (2048 <= self.code() && self.code() < 65536)
  cost time O(1)
  cost allocations == 0
{
  let code = self.code()
  if code < 128 {
    1
  } else if code < 2048 {
    2
  } else if code < 65536 {
    3
  } else {
    4
  }
}

public fn Character.utf16_length(self) -> USize
  ensures 1 <= result && result <= 2
  cost time O(1)
{
  if self.code() < 65536 { 1 } else { 2 }
}

public fn Character.is_ascii(self) -> Bool
  ensures result == (self.code() < 128)
  cost time O(1)
{
  self.code() < 128
}

public fn Character.is_alphabetic(self) -> Bool
  cost time O(1)
{
  if self.code() < 128 { self.is_ascii_alphabetic() } else { unicode_tables::is_alphabetic(self.code()) }
}

public fn Character.is_numeric(self) -> Bool
  cost time O(1)
{
  if self.code() < 128 { self.is_ascii_digit() } else { unicode_tables::is_numeric(self.code()) }
}

public fn Character.is_alphanumeric(self) -> Bool
  cost time O(1)
{
  self.is_alphabetic() || self.is_numeric()
}

public transparent fn Character.is_whitespace(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  (code >= 9 && code <= 13) || code == 32 || code == 133 || code == 160 || code == 5760
    || (code >= 8192 && code <= 8202) || code == 8232 || code == 8233 || code == 8239 || code == 8287
    || code == 12288
}

public fn Character.is_uppercase(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  if code < 128 { code >= 65 && code <= 90 } else { unicode_tables::is_uppercase(code) }
}

public fn Character.is_lowercase(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  if code < 128 { code >= 97 && code <= 122 } else { unicode_tables::is_lowercase(code) }
}

public transparent fn Character.is_control(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  code < 32 || (code >= 127 && code < 160)
}

public transparent fn Character.is_ascii_digit(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  code >= 48 && code <= 57
}

public transparent fn Character.is_ascii_alphabetic(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
}

public transparent fn Character.is_ascii_alphanumeric(self) -> Bool
  cost time O(1)
{
  self.is_ascii_digit() || self.is_ascii_alphabetic()
}

public transparent fn Character.is_ascii_punctuation(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  (code >= 33 && code <= 47) || (code >= 58 && code <= 64) || (code >= 91 && code <= 96)
    || (code >= 123 && code <= 126)
}

public transparent fn Character.is_ascii_hexadecimal_digit(self) -> Bool
  cost time O(1)
{
  let code = self.code()
  (code >= 48 && code <= 57) || (code >= 97 && code <= 102) || (code >= 65 && code <= 70)
}

internal fn Character.or_scalar(self, code: UInt32) -> Character
  cost time O(1)
{
  if code <= 1114111 && (code < 55296 || code > 57343) { intrinsic::convert(code) } else { self }
}

public fn Character.to_uppercase(self) -> Character
  cost time O(1)
{
  if self.code() < 128 { self.to_ascii_uppercase() } else { self.or_scalar(unicode_tables::uppercase_of(self.code())) }
}

public fn Character.to_lowercase(self) -> Character
  cost time O(1)
{
  if self.code() < 128 { self.to_ascii_lowercase() } else { self.or_scalar(unicode_tables::lowercase_of(self.code())) }
}

public fn Character.to_ascii_uppercase(self) -> Character
  cost time O(1)
{
  let code = self.code()
  if code >= 97 && code <= 122 { intrinsic::convert(code - 32) } else { self }
}

public fn Character.to_ascii_lowercase(self) -> Character
  cost time O(1)
{
  let code = self.code()
  if code >= 65 && code <= 90 { intrinsic::convert(code + 32) } else { self }
}

public fn Character.to_digit(self, radix: UInt32 = 10) -> Option[UInt32]
  requires 2 <= radix && radix <= 36
  ensures match result {
    Some(value) => value < radix
    None => true
  }
  cost time O(1)
{
  let code = self.code()
  let value: UInt32 = if code < 128 {
    let byte: UInt8 = intrinsic::convert(code)
    intrinsic::convert(byte.digit_value())
  } else {
    36
  }
  if value < radix { Some(value) } else { None }
}

public fn Character.from_digit(value: UInt32, radix: UInt32 = 10) -> Option[Character]
  requires 2 <= radix && radix <= 36
  ensures (result is Some(_)) == (value < radix)
  cost time O(1)
{
  if value >= radix {
    None
  } else {
    let digit: UInt8 = intrinsic::convert(value)
    Some(intrinsic::convert(digit.digit_byte(uppercase: false)))
  }
}

impl From[Character] for UInt32 {
  fn from(value: own Character) -> UInt32 {
    value.code()
  }
}

impl From[UInt8] for Character {
  fn from(value: own UInt8) -> Character {
    intrinsic::convert(value)
  }
}

impl TryFrom[UInt32] for Character {
  type Error = core::ConversionError

  fn try_from(value: own UInt32) -> Result[Character, core::ConversionError] {
    if value > 1114111 || (value >= 55296 && value <= 57343) {
      Err(core::ConversionError())
    } else {
      Ok(intrinsic::convert(value))
    }
  }
}

impl TryFrom[Character] for UInt8 {
  type Error = core::ConversionError

  fn try_from(value: own Character) -> Result[UInt8, core::ConversionError] {
    let code = value.code()
    if code > 255 { Err(core::ConversionError()) } else { Ok(intrinsic::convert(code)) }
  }
}

impl core::Countable for Character {
  fn successor(self) -> Option[Character]
    cost time O(1)
  {
    let index = self.scalar_index()
    if index == 1112063 { None } else { Some(Character.at_scalar_index(index + 1)) }
  }

  fn predecessor(self) -> Option[Character]
    cost time O(1)
  {
    let index = self.scalar_index()
    if index == 0 { None } else { Some(Character.at_scalar_index(index - 1)) }
  }

  fn advanced(self, by: USize) -> Option[Character]
    cost time O(1)
  {
    let index: USize = intrinsic::convert(self.scalar_index())
    if by > 1112063 - index { None } else { Some(Character.at_scalar_index(intrinsic::convert(index + by))) }
  }

  fn retreated(self, by: USize) -> Option[Character]
    cost time O(1)
  {
    let index: USize = intrinsic::convert(self.scalar_index())
    if by > index { None } else { Some(Character.at_scalar_index(intrinsic::convert(index - by))) }
  }

  fn steps_to(self, other: Character) -> Option[USize]
    cost time O(1)
  {
    let from = self.scalar_index()
    let to = other.scalar_index()
    if to < from { None } else { Some(intrinsic::convert(to - from)) }
  }
}

fn scalar(code: UInt32) -> Result[Character, core::ConversionError] {
  Character.try_from(code)
}

test "a character's encoded lengths follow its code point" {
  assert Character"a".utf8_length() == 1
  assert Character"\u{7F}".utf8_length() == 1
  assert Character"\u{80}".utf8_length() == 2
  assert Character"\u{7FF}".utf8_length() == 2
  assert Character"\u{800}".utf8_length() == 3
  assert Character"\u{FFFF}".utf8_length() == 3
  assert Character"\u{10000}".utf8_length() == 4
  assert Character.maximum.utf8_length() == 4
  assert Character"a".utf16_length() == 1
  assert Character"\u{FFFF}".utf16_length() == 1
  assert Character"\u{10000}".utf16_length() == 2
}

test "the ASCII classes hold for their ranges and stop at their ends" {
  assert Character"a".is_ascii()
  assert Character"\u{7F}".is_ascii()
  assert !Character"\u{80}".is_ascii()
  assert Character"0".is_ascii_digit()
  assert Character"9".is_ascii_digit()
  assert !Character"/".is_ascii_digit()
  assert !Character":".is_ascii_digit()
  assert Character"a".is_ascii_alphabetic()
  assert Character"Z".is_ascii_alphabetic()
  assert !Character"[".is_ascii_alphabetic()
  assert !Character"`".is_ascii_alphabetic()
  assert !Character"\u{E9}".is_ascii_alphabetic()
  assert Character"7".is_ascii_alphanumeric()
  assert Character"q".is_ascii_alphanumeric()
  assert !Character"_".is_ascii_alphanumeric()
  assert Character"!".is_ascii_punctuation()
  assert Character"/".is_ascii_punctuation()
  assert Character"@".is_ascii_punctuation()
  assert Character"`".is_ascii_punctuation()
  assert Character"~".is_ascii_punctuation()
  assert !Character" ".is_ascii_punctuation()
  assert !Character"a".is_ascii_punctuation()
  assert Character"f".is_ascii_hexadecimal_digit()
  assert Character"A".is_ascii_hexadecimal_digit()
  assert Character"5".is_ascii_hexadecimal_digit()
  assert !Character"g".is_ascii_hexadecimal_digit()
}

test "white space and control characters are told apart" {
  assert Character" ".is_whitespace()
  assert Character"\n".is_whitespace()
  assert Character"\t".is_whitespace()
  assert Character"\u{A0}".is_whitespace()
  assert Character"\u{2003}".is_whitespace()
  assert Character"\u{3000}".is_whitespace()
  assert !Character"a".is_whitespace()
  assert !Character"\u{200B}".is_whitespace()
  assert Character"\u{0}".is_control()
  assert Character"\n".is_control()
  assert Character"\u{7F}".is_control()
  assert Character"\u{9F}".is_control()
  assert !Character" ".is_control()
  assert !Character"\u{A0}".is_control()
}

test "ASCII case conversion changes only ASCII letters" {
  assert Character"a".to_ascii_uppercase() == Character"A"
  assert Character"z".to_ascii_uppercase() == Character"Z"
  assert Character"A".to_ascii_uppercase() == Character"A"
  assert Character"1".to_ascii_uppercase() == Character"1"
  assert Character"\u{E9}".to_ascii_uppercase() == Character"\u{E9}"
  assert Character"Q".to_ascii_lowercase() == Character"q"
  assert Character"q".to_ascii_lowercase() == Character"q"
  assert Character"[".to_ascii_lowercase() == Character"["
}

test "a character is a digit in a radix, and a digit is a character" {
  assert Character"7".to_digit() == Some(7)
  assert Character"a".to_digit() is None
  assert Character"a".to_digit(radix: 16) == Some(10)
  assert Character"F".to_digit(radix: 16) == Some(15)
  assert Character"g".to_digit(radix: 16) is None
  assert Character"z".to_digit(radix: 36) == Some(35)
  assert Character"2".to_digit(radix: 2) is None
  assert Character"-".to_digit() is None
  assert Character.from_digit(7) == Some(Character"7")
  assert Character.from_digit(10) is None
  assert Character.from_digit(10, radix: 16) == Some(Character"a")
  assert Character.from_digit(35, radix: 36) == Some(Character"z")
  assert Character.from_digit(36, radix: 36) is None
}

test "characters convert to and from numbers, except surrogates and values past the last" {
  assert UInt32.from(Character"A") == 65
  assert UInt32.from(Character.maximum) == 1114111
  let byte: UInt8 = 233
  assert Character.from(byte) == Character"\u{E9}"
  assert scalar(65) == Ok(Character"A")
  assert scalar(1114111) == Ok(Character.maximum)
  assert scalar(1114112) is Err(_)
  assert scalar(55296) is Err(_)
  assert scalar(57343) is Err(_)
  assert scalar(55295) is Ok(_)
  assert scalar(57344) is Ok(_)
  assert UInt8.try_from(Character"\u{FF}") == Ok(255)
  assert UInt8.try_from(Character"\u{100}") is Err(_)
}

test "stepping through characters skips the surrogates" {
  assert Character"a".successor() == Some(Character"b")
  assert Character"\u{D7FF}".successor() == Some(Character"\u{E000}")
  assert Character.maximum.successor() is None
  assert Character"b".predecessor() == Some(Character"a")
  assert Character"\u{E000}".predecessor() == Some(Character"\u{D7FF}")
  assert Character"\u{0}".predecessor() is None
  assert Character"a".advanced(by: 25) == Some(Character"z")
  assert Character"\u{D7FF}".advanced(by: 2) == Some(Character"\u{E001}")
  assert Character.maximum.advanced(by: 1) is None
  assert Character.maximum.advanced(by: 0) == Some(Character.maximum)
  assert Character"z".retreated(by: 25) == Some(Character"a")
  assert Character"\u{E001}".retreated(by: 2) == Some(Character"\u{D7FF}")
  assert Character"a".retreated(by: 98) is None
  assert Character"a".steps_to(Character"z") == Some(25)
  assert Character"z".steps_to(Character"a") is None
  assert Character"\u{D7FF}".steps_to(Character"\u{E000}") == Some(1)
  assert Character"\u{0}".steps_to(Character.maximum) == Some(1112063)
}

test "a character's properties follow the Unicode character database" {
  assert Character"a".is_alphabetic() && Character"Z".is_alphabetic() && !Character"1".is_alphabetic()
  assert Character"é".is_alphabetic() && Character"Ω".is_alphabetic() && Character"中".is_alphabetic()
  assert Character"\u{2160}".is_alphabetic()
  assert !Character"!".is_alphabetic() && !Character"€".is_alphabetic() && !Character"\u{301}".is_alphabetic()
  assert Character"7".is_numeric() && Character"٣".is_numeric() && Character"½".is_numeric()
  assert Character"\u{2160}".is_numeric() && !Character"x".is_numeric() && !Character"中".is_numeric()
  assert Character"é".is_alphanumeric() && Character"٣".is_alphanumeric() && !Character"-".is_alphanumeric()
  assert Character"A".is_uppercase() && Character"É".is_uppercase() && Character"Σ".is_uppercase()
  assert !Character"a".is_uppercase() && !Character"中".is_uppercase() && !Character"1".is_uppercase()
  assert Character"a".is_lowercase() && Character"é".is_lowercase() && Character"ß".is_lowercase()
  assert !Character"A".is_lowercase() && !Character"中".is_lowercase()
  assert Character"\u{10400}".is_uppercase() && Character"\u{10428}".is_lowercase()
}

test "a character maps to its simple uppercase and lowercase" {
  assert Character"a".to_uppercase() == Character"A" && Character"A".to_lowercase() == Character"a"
  assert Character"é".to_uppercase() == Character"É" && Character"É".to_lowercase() == Character"é"
  assert Character"ω".to_uppercase() == Character"Ω" && Character"Σ".to_lowercase() == Character"σ"
  assert Character"я".to_uppercase() == Character"Я" && Character"Я".to_lowercase() == Character"я"
  assert Character"ÿ".to_uppercase() == Character"Ÿ"
  assert Character"\u{10428}".to_uppercase() == Character"\u{10400}"
  assert Character"\u{1F80}".to_uppercase() == Character"\u{1F88}"
  assert Character"ß".to_uppercase() == Character"ß"
  assert Character"1".to_uppercase() == Character"1" && Character"中".to_lowercase() == Character"中"
  assert Character"İ".to_lowercase() == Character"i"
}
