use standard.core
use standard.intrinsic
use standard.text.grapheme_breaks
use standard.text.unicode_tables
use standard.text.utf8

public fn String.is_empty(self) -> Bool
  ensures result == (self.length() == 0)
  cost time O(1)
{
  self.length() == 0
}

public fn String.bytes(self) -> view List[UInt8]
  ensures result.length() == self.length()
  ensures identical(result.model(), self.model())
  cost time O(1)
  cost allocations == 0
{
  intrinsic.storage_as(self.storage)
}

internal type Decoded(character: Character, length: UInt64)

internal fn String.decode(self, offset: UInt64) -> Decoded
  requires offset < self.length()
  requires self.is_boundary(offset)
  ensures result.length == utf8.width(self.model(), at: offset)
  ensures 1 <= result.length
  ensures result.length <= self.length() - offset
  ensures self.is_boundary(offset + result.length)
  ensures result.length < 4 ==> result.character.code() < 65536
  ensures result.character.utf8_length() == result.length
  cost time O(1)
  cost allocations == 0
{
  proof {
    utf8.boundary_is_valid_from(self.model(), position: offset)
    utf8.character_ends_at_a_boundary(self.model(), at: offset)
  }
  let first = self.byte(offset)
  if first < 128 {
    return Decoded(character: intrinsic.convert(first), length: 1)
  }
  let second: UInt32 = intrinsic.convert(self.byte(offset + 1) - 128)
  if first < 224 {
    let lead: UInt32 = intrinsic.convert(first - 192)
    return Decoded(character: intrinsic.convert(lead * 64 + second), length: 2)
  }
  let third: UInt32 = intrinsic.convert(self.byte(offset + 2) - 128)
  if first < 240 {
    let lead: UInt32 = intrinsic.convert(first - 224)
    return Decoded(character: intrinsic.convert(lead * 4096 + second * 64 + third), length: 3)
  }
  let fourth: UInt32 = intrinsic.convert(self.byte(offset + 3) - 128)
  let lead: UInt32 = intrinsic.convert(first - 240)
  Decoded(character: intrinsic.convert(lead * 262144 + second * 4096 + third * 64 + fourth), length: 4)
}

internal fn String.previous_start(self, offset: UInt64) -> UInt64
  requires 0 < offset
  requires offset <= self.length()
  requires self.is_boundary(offset)
  ensures result < offset
  ensures offset - result <= 4
  ensures self.is_boundary(result)
  cost time O(1)
  cost allocations == 0
{
  proof {
    utf8.previous_character_starts_within_four_bytes(self.model(), position: offset)
  }
  var start = offset - 1
  while start > 0 && offset - start < 4 && utf8.is_continuation(self.byte(start))
    invariant start < offset
    invariant offset - start <= 4
    invariant forall i in start + 1..offset => utf8.is_continuation(self.model()[i])
    decreases start + 4 - offset
  {
    start -= 1
  }
  start
}

internal fn String.part(self, from: UInt64, to: UInt64) -> view String
  requires from <= to
  requires to <= self.length()
  requires self.is_boundary(from)
  requires self.is_boundary(to)
  ensures identical(result.model(), self.model()[from..to])
  ensures result.length() == to - from
  ensures forall index in 0..result.length() => result.model()[index] == self.model()[from + index]
  cost time O(1)
  cost allocations == 0
{
  let bytes = intrinsic.storage_range(self.storage, start: from, stop: to)
  proof {
    utf8.slice_is_valid(self.model(), from: from, to: to)
    assert identical(intrinsic.storage_model(bytes), self.model()[from..to])
  }
  intrinsic.storage_as(bytes)
}

internal fn String.matches_at(self, pattern: String, offset: UInt64) -> Bool
  requires offset <= self.length()
  requires pattern.length() <= self.length() - offset
  ensures result == (forall i in 0..pattern.length() => self.model()[offset + i] == pattern.model()[i])
  cost time O(pattern.length())
{
  let candidate = intrinsic.storage_range(self.storage, start: offset, stop: offset + pattern.length())
  proof {
    assert (forall i in 0..pattern.length() => self.model()[offset + i] == pattern.model()[i])
      ==> identical(intrinsic.storage_model(candidate), pattern.model())
  }
  intrinsic.compare_bytes(candidate, right: pattern.storage) == 0
}

internal fn String.copy_onto(self, output: mut intrinsic.Storage[UInt8])
  requires intrinsic.storage_length(output) + self.length() <= intrinsic.storage_capacity(output)
  ensures identical(intrinsic.storage_model(output), old(intrinsic.storage_model(output)).concatenate(self.model()))
  ensures intrinsic.storage_length(output) == old(intrinsic.storage_length(output)) + self.length()
  ensures intrinsic.storage_capacity(output) == old(intrinsic.storage_capacity(output))
  ensures utf8.is_valid(old(intrinsic.storage_model(output))) ==> utf8.is_valid(intrinsic.storage_model(output))
  cost time O(self.length())
  cost allocations == 0
{
  for index in 0..self.length()
    invariant intrinsic.storage_length(output) == old(intrinsic.storage_length(output)) + index
    invariant forall i in 0..old(intrinsic.storage_length(output)) =>
      identical(intrinsic.storage_model(output)[i], old(intrinsic.storage_model(output))[i])
    invariant forall i in 0..index =>
      identical(intrinsic.storage_model(output)[old(intrinsic.storage_length(output)) + i], self.model()[i])
    invariant intrinsic.storage_capacity(output) == old(intrinsic.storage_capacity(output))
    cost allocations == 0
  {
    intrinsic.storage_push(mut output, value: intrinsic.storage_at(self.storage, index: index))
  }
  proof {
    assert forall i in old(intrinsic.storage_length(output))..intrinsic.storage_length(output) =>
      identical(intrinsic.storage_model(output)[i], self.model()[i - old(intrinsic.storage_length(output))])
    assert identical(intrinsic.storage_model(output), old(intrinsic.storage_model(output)).concatenate(self.model()))
    if utf8.is_valid(old(intrinsic.storage_model(output))) {
      utf8.concatenation_is_valid(old(intrinsic.storage_model(output)), second: self.model())
    }
  }
}

public fn String.is_ascii(self) -> Bool
  ensures result == (forall i in 0..self.length() => self.model()[i] <= 127)
  cost time O(self.length())
{
  for index in 0..self.length()
    invariant forall i in 0..index => self.model()[i] <= 127
  {
    if self.byte(index) >= 128 {
      return false
    }
  }
  true
}

public fn String.is_boundary(self, offset: UInt64) -> Bool
  ensures result == (offset <= self.length() && utf8.is_boundary(self.model(), at: offset))
  ensures offset == 0 ==> result
  ensures 0 < offset && offset <= self.length() && self.model()[offset - 1] <= 127 ==> result
  cost time O(1)
  cost allocations == 0
{
  proof {
    utf8.start_is_a_boundary(self.model())
    if 0 < offset && offset <= self.length() && self.model()[offset - 1] <= 127 {
      utf8.after_an_ascii_byte_is_a_boundary(self.model(), at: offset - 1)
    }
  }
  offset == self.length() || (offset < self.length() && !utf8.is_continuation(self.byte(offset)))
}

public type Characters(text: view String, offset: UInt64)
  invariant offset <= text.length()
  invariant text.is_boundary(offset)

impl FiniteCursor for Characters {
  fn remaining(self) -> UInt64
    ensures result == self.text.length() - self.offset
    cost time O(1)
    cost allocations == 0
  {
    self.text.length() - self.offset
  }
}

impl Cursor for Characters {
  type Element = Character

  fn next(mut self) -> Option[Character]
    ensures (result is Some(_)) == (old(self.remaining()) > 0)
    ensures (result is Some(_)) ==> self.remaining() < old(self.remaining())
    ensures (result is None) ==> self.remaining() == old(self.remaining())
    cost time O(1)
    cost allocations == 0
  {
    if self.offset < self.text.length() {
      let decoded = self.text.decode(self.offset)
      self.offset += decoded.length
      Some(decoded.character)
    } else {
      None
    }
  }
}

public fn String.characters(self) -> Characters
  ensures result.remaining() == self.length()
  cost time O(1)
  cost allocations == 0
{
  Characters(text: self, offset: 0)
}

public type CharactersWithOffsets(text: view String, offset: UInt64)
  invariant offset <= text.length()
  invariant text.is_boundary(offset)

impl FiniteCursor for CharactersWithOffsets {
  fn remaining(self) -> UInt64
    ensures result == self.text.length() - self.offset
    cost time O(1)
    cost allocations == 0
  {
    self.text.length() - self.offset
  }
}

impl Cursor for CharactersWithOffsets {
  type Element = core.Indexed[Character]

  fn next(mut self) -> Option[core.Indexed[Character]]
    ensures (result is Some(_)) == (old(self.remaining()) > 0)
    ensures (result is Some(_)) ==> self.remaining() < old(self.remaining())
    ensures (result is None) ==> self.remaining() == old(self.remaining())
    ensures !(result is Some(found) && found.index >= self.text.length())
    cost time O(1)
    cost allocations == 0
  {
    if self.offset < self.text.length() {
      let decoded = self.text.decode(self.offset)
      let index = self.offset
      self.offset += decoded.length
      Some(core.Indexed(index: index, element: decoded.character))
    } else {
      None
    }
  }
}

public fn String.characters_with_offsets(self) -> CharactersWithOffsets
  ensures result.remaining() == self.length()
  cost time O(1)
  cost allocations == 0
{
  CharactersWithOffsets(text: self, offset: 0)
}

public fn String.character_count(self) -> UInt64
  ensures result <= self.length()
  cost time O(self.length())
{
  var count: UInt64 = 0
  var offset: UInt64 = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant self.is_boundary(offset)
    invariant count <= offset
    decreases self.length() - offset
    cost time O(offset)
  {
    offset += self.decode(offset).length
    count += 1
  }
  count
}

public fn String.first_character(self) -> Option[Character]
  ensures (result is None) == self.is_empty()
  cost time O(1)
{
  if self.is_empty() { None } else { Some(self.decode(0).character) }
}

public fn String.last_character(self) -> Option[Character]
  ensures (result is None) == self.is_empty()
  cost time O(1)
{
  if self.is_empty() {
    None
  } else {
    Some(self.decode(self.previous_start(self.length())).character)
  }
}

public fn String.character_at(self, offset: UInt64) -> Character
  uses Panic unless offset < self.length() && self.is_boundary(offset)
  ensures result.utf8_length() <= self.length() - offset
  ensures self.is_boundary(offset + result.utf8_length())
  cost time O(1)
  cost allocations == 0
{
  if offset >= self.length() || !self.is_boundary(offset) {
    Panic.crash("offset out of bounds")
  }
  self.decode(offset).character
}

public fn String.graphemes(self) -> List[view String]
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  var parts: List[view String] = []
  var start: UInt64 = 0
  var offset: UInt64 = 0
  var state = grapheme_breaks.State.start()
  while offset < self.length()
    invariant start <= offset
    invariant offset <= self.length()
    invariant parts.length() <= start
    invariant self.is_boundary(start)
    invariant self.is_boundary(offset)
    decreases self.length() - offset
    cost time O(offset)
  {
    let decoded = self.decode(offset)
    let code = decoded.character.code()
    if offset > start && !state.joins(code) {
      mut parts.push(self.part(start, to: offset))
      start = offset
    }
    state = state.after(code)
    offset += decoded.length
  }
  if start < self.length() {
    mut parts.push(self.part(start, to: self.length()))
  }
  parts
}

public fn String.lines(self) -> List[view String]
  ensures result.length() <= self.length() + 1
  cost time O(self.length())
{
  var parts: List[view String] = []
  var start: UInt64 = 0
  var index: UInt64 = 0
  while index < self.length()
    invariant start <= index
    invariant index <= self.length()
    invariant parts.length() <= index
    invariant self.is_boundary(start)
    decreases self.length() - index
    cost time O(index)
  {
    if self.byte(index) == 10 {
      let end = if index > start && self.byte(index - 1) == 13 { index - 1 } else { index }
      mut parts.push(self.part(start, to: end))
      start = index + 1
    }
    index += 1
  }
  if start < self.length() {
    mut parts.push(self.part(start, to: self.length()))
  }
  parts
}

public fn String.substring(self, from: UInt64, to: UInt64) -> view String
  uses Panic unless from <= to && to <= self.length() && self.is_boundary(from) && self.is_boundary(to)
  ensures result.length() == to - from
  cost time O(1)
{
  if from > to || to > self.length() || !self.is_boundary(from) || !self.is_boundary(to) {
    Panic.crash("range out of bounds")
  }
  self.part(from, to: to)
}

public fn String.get_substring(self, from: UInt64, to: UInt64) -> Option[view String]
  ensures (result is Some(_)) == (from <= to && to <= self.length() && self.is_boundary(from) && self.is_boundary(to))
  ensures !(result is Some(part) && part.length() != to - from)
  cost time O(1)
{
  if from <= to && to <= self.length() && self.is_boundary(from) && self.is_boundary(to) {
    Some(self.part(from, to: to))
  } else {
    None
  }
}

public fn String.split_at(self, offset: UInt64) -> core.Pair[view String, view String]
  uses Panic unless offset <= self.length() && self.is_boundary(offset)
  ensures result.first.length() == offset
  ensures result.second.length() == self.length() - offset
  cost time O(1)
{
  if offset > self.length() || !self.is_boundary(offset) {
    Panic.crash("range out of bounds")
  }
  core.Pair(first: self.part(0, to: offset), second: self.part(offset, to: self.length()))
}

fn is_failure_table(pattern: Sequence[UInt8], table: Sequence[UInt64]) -> Bool
  ensures result == (table.length() == pattern.length()
    && (forall i in 0..table.length() => table[i] <= i
      && (forall k in 0..table[i] => pattern[k] == pattern[i + 1 - table[i] + k])))
{
  table.length() == pattern.length()
    && (forall i in 0..table.length() => table[i] <= i
      && (forall k in 0..table[i] => pattern[k] == pattern[i + 1 - table[i] + k]))
}

fn matches_before(text: Sequence[UInt8], pattern: Sequence[UInt8], index: Integer, matched: Integer) -> Bool
  requires 0 <= matched && matched <= index && index <= text.length() && matched <= pattern.length()
  ensures result == (forall k in 0..matched => text[index - matched + k] == pattern[k])
{
  forall k in 0..matched => text[index - matched + k] == pattern[k]
}

internal fn failure_table(pattern: String) -> List[UInt64]
  ensures is_failure_table(pattern.model(), table: result.model())
  cost time O(pattern.length())
{
  var table: intrinsic.Storage[UInt64] = intrinsic.storage_with_capacity(pattern.length())
  if pattern.length() == 0 {
    return List(storage: own table)
  }
  intrinsic.storage_push(mut table, value: 0)
  var matched: UInt64 = 0
  var index: UInt64 = 1
  while index < pattern.length()
    invariant 1 <= index
    invariant index <= pattern.length()
    invariant matched < index
    invariant intrinsic.storage_length(table) == index
    invariant intrinsic.storage_capacity(table) == pattern.length()
    invariant forall i in 0..index => intrinsic.storage_model(table)[i] <= i
      && (forall k in 0..intrinsic.storage_model(table)[i] =>
        pattern.model()[k] == pattern.model()[i + 1 - intrinsic.storage_model(table)[i] + k])
    invariant matches_before(pattern.model(), pattern: pattern.model(), index: index, matched: matched)
    decreases pattern.length() - index
    cost time O(2 * index - matched)
  {
    let before = matched
    while matched > 0 && pattern.byte(index) != pattern.byte(matched)
      invariant matched <= before
      invariant matched < index
      invariant matches_before(pattern.model(), pattern: pattern.model(), index: index, matched: matched)
      decreases matched
      cost time O(before - matched)
    {
      matched = intrinsic.storage_at(table, index: matched - 1)
    }
    if pattern.byte(index) == pattern.byte(matched) {
      matched += 1
    }
    intrinsic.storage_push(mut table, value: matched)
    index += 1
  }
  List(storage: own table)
}

internal fn String.shorter_match(self, pattern: String, table: List[UInt64], matched: UInt64, index: UInt64) -> UInt64
  requires 0 < matched
  requires matched <= pattern.length()
  requires matched <= index
  requires index <= self.length()
  requires is_failure_table(pattern.model(), table: table.model())
  requires matches_before(self.model(), pattern: pattern.model(), index: index, matched: matched)
  ensures result < matched
  ensures matches_before(self.model(), pattern: pattern.model(), index: index, matched: result)
  cost time O(1)
  cost allocations == 0
{
  table[matched - 1]
}

internal fn String.advance(self, pattern: String, table: List[UInt64], matched: UInt64, index: UInt64) -> UInt64
  requires index < self.length()
  requires matched < pattern.length()
  requires matched <= index
  requires is_failure_table(pattern.model(), table: table.model())
  requires matches_before(self.model(), pattern: pattern.model(), index: index, matched: matched)
  ensures result <= matched + 1
  ensures result <= pattern.length()
  ensures matches_before(self.model(), pattern: pattern.model(), index: index + 1, matched: result)
  cost time O(matched + 1 - result)
{
  var current = matched
  while current > 0 && self.byte(index) != pattern.byte(current)
    invariant current <= matched
    invariant matches_before(self.model(), pattern: pattern.model(), index: index, matched: current)
    decreases current
    cost time O(matched - current)
  {
    current = self.shorter_match(pattern, table: table, matched: current, index: index)
  }
  if self.byte(index) == pattern.byte(current) { current + 1 } else { current }
}

internal fn String.find_byte(self, byte: UInt8, from: UInt64) -> UInt64
  requires from <= self.length()
  ensures from <= result
  ensures result <= self.length()
  ensures result < self.length() ==> self.model()[result] == byte
  cost time O(result - from)
  cost allocations == 0
{
  from + intrinsic.find_byte(intrinsic.storage_range(self.storage, start: from, stop: self.length()), byte: byte)
}

let count_block_length: UInt64 = 192

internal fn String.count_byte(self, byte: UInt8) -> UInt64
  ensures result <= self.length()
  cost time O(self.length())
  cost allocations == 0
{
  var count: UInt64 = 0
  var start: UInt64 = 0
  while start < self.length()
    invariant start <= self.length()
    invariant count <= start
    decreases self.length() - start
    cost time O(start)
    cost allocations == 0
  {
    let stop = if self.length() - start > count_block_length { start + count_block_length } else { self.length() }
    var block_count: UInt8 = 0
    for index in start..stop
      invariant block_count <= index - start
      cost allocations == 0
    {
      block_count += if intrinsic.storage_at(self.storage, index: index) == byte { 1 } else { 0 }
    }
    count += intrinsic.convert(block_count)
    start = stop
  }
  count
}

internal fn String.find_first(self, pattern: String, table: List[UInt64]) -> Option[UInt64]
  requires pattern.length() > 0
  requires is_failure_table(pattern.model(), table: table.model())
  ensures !(result is Some(offset)
    && !(offset + pattern.length() <= self.length()
      && (forall i in 0..pattern.length() => self.model()[offset + i] == pattern.model()[i])))
  cost time O(self.length())
{
  let first_byte = pattern.byte(0)
  var has_match = false
  var first: UInt64 = 0
  var matched: UInt64 = 0
  var index: UInt64 = 0
  while index < self.length() && !has_match
    invariant index <= self.length()
    invariant matched < pattern.length()
    invariant matched <= index
    invariant matches_before(self.model(), pattern: pattern.model(), index: index, matched: matched)
    invariant has_match ==> first + pattern.length() <= self.length()
      && (forall i in 0..pattern.length() => self.model()[first + i] == pattern.model()[i])
    decreases self.length() - index
    cost time O(2 * index - matched)
  {
    if matched == 0 {
      index = self.find_byte(first_byte, from: index)
      if index == self.length() {
        break
      }
    }
    matched = self.advance(pattern, table: table, matched: matched, index: index)
    index += 1
    if matched == pattern.length() {
      has_match = true
      first = index - matched
      matched = self.shorter_match(pattern, table: table, matched: matched, index: index)
    }
  }
  if has_match { Some(first) } else { None }
}

public fn String.contains(self, pattern: String) -> Bool
  ensures result == (self.find(pattern) is Some(_))
  cost time O(self.length() + pattern.length())
{
  self.find(pattern) is Some(_)
}

public fn String.find(self, pattern: String) -> Option[UInt64]
  ensures !(result is Some(offset)
    && !(offset + pattern.length() <= self.length()
      && self.is_boundary(offset)
      && self.is_boundary(offset + pattern.length())
      && (forall i in 0..pattern.length() => self.model()[offset + i] == pattern.model()[i])))
  cost time O(self.length() + pattern.length())
{
  if pattern.is_empty() {
    return Some(0)
  }
  if pattern.length() == 1 {
    let byte = pattern.byte(0)
    if (byte & 0xC0) == 0x80 {
      return None
    }
    let offset = self.find_byte(byte, from: 0)
    return if offset < self.length() { Some(offset) } else { None }
  }
  let table = failure_table(pattern)
  let first = self.find_first(pattern, table: table)
  proof {
    if first is Some(offset) {
      utf8.match_lies_between_boundaries(self.model(), part: pattern.model(), at: offset)
    }
  }
  first
}

public fn String.find_last(self, pattern: String) -> Option[UInt64]
  ensures !(result is Some(offset)
    && !(offset + pattern.length() <= self.length()
      && self.is_boundary(offset)
      && self.is_boundary(offset + pattern.length())
      && (forall i in 0..pattern.length() => self.model()[offset + i] == pattern.model()[i])))
  cost time O(self.length() + pattern.length())
{
  if pattern.is_empty() {
    return Some(self.length())
  }
  let table = failure_table(pattern)
  let first_byte = pattern.byte(0)
  var has_match = false
  var last: UInt64 = 0
  var matched: UInt64 = 0
  var index: UInt64 = 0
  while index < self.length()
    invariant index <= self.length()
    invariant matched < pattern.length()
    invariant matched <= index
    invariant matches_before(self.model(), pattern: pattern.model(), index: index, matched: matched)
    invariant has_match ==> last + pattern.length() <= self.length()
      && (forall i in 0..pattern.length() => self.model()[last + i] == pattern.model()[i])
    decreases self.length() - index
    cost time O(2 * index - matched)
  {
    if matched == 0 {
      index = self.find_byte(first_byte, from: index)
      if index == self.length() {
        break
      }
    }
    matched = self.advance(pattern, table: table, matched: matched, index: index)
    index += 1
    if matched == pattern.length() {
      has_match = true
      last = index - matched
      matched = self.shorter_match(pattern, table: table, matched: matched, index: index)
    }
  }
  proof {
    if has_match {
      utf8.match_lies_between_boundaries(self.model(), part: pattern.model(), at: last)
    }
  }
  if has_match { Some(last) } else { None }
}

public fn String.find_character(
  self,
  predicate: (fn(Character) -> Bool uses generic Granted),
) -> Option[UInt64]
  uses generic Granted
  ensures match result {
    Some(offset) => offset < self.length() && self.is_boundary(offset)
    None => true
  }
  cost time O(self.length() * time(predicate))
{
  var offset: UInt64 = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant self.is_boundary(offset)
    decreases self.length() - offset
    cost time O(offset * time(predicate))
  {
    let decoded = self.decode(offset)
    if predicate(decoded.character) {
      return Some(offset)
    }
    offset += decoded.length
  }
  None
}

public fn String.occurrences(self, pattern: String) -> UInt64
  uses Panic unless pattern.length() > 0
  ensures result <= self.length()
  cost time O(self.length() + pattern.length())
{
  if pattern.is_empty() {
    Panic.crash("the pattern is empty")
  }
  if pattern.length() == 1 {
    let byte = pattern.byte(0)
    return if (byte & 0xC0) == 0x80 { 0 } else { self.count_byte(byte) }
  }
  let table = failure_table(pattern)
  let first_byte = pattern.byte(0)
  var count: UInt64 = 0
  var matched: UInt64 = 0
  var index: UInt64 = 0
  while index < self.length()
    invariant index <= self.length()
    invariant matched < pattern.length()
    invariant matched <= index
    invariant count <= index
    invariant matches_before(self.model(), pattern: pattern.model(), index: index, matched: matched)
    decreases self.length() - index
    cost time O(2 * index - matched)
  {
    if matched == 0 {
      index = self.find_byte(first_byte, from: index)
      if index == self.length() {
        break
      }
    }
    matched = self.advance(pattern, table: table, matched: matched, index: index)
    index += 1
    if matched == pattern.length() {
      count += 1
      matched = 0
    }
  }
  count
}

public fn String.starts_with(self, prefix: String) -> Bool
  ensures result ==> prefix.length() <= self.length()
  ensures result == (prefix.length() <= self.length() && self.matches_at(prefix, offset: 0))
  cost time O(prefix.length())
{
  prefix.length() <= self.length() && self.matches_at(prefix, offset: 0)
}

public fn String.ends_with(self, suffix: String) -> Bool
  ensures result ==> suffix.length() <= self.length()
  ensures result == (suffix.length() <= self.length() && self.matches_at(suffix, offset: self.length() - suffix.length()))
  cost time O(suffix.length())
{
  suffix.length() <= self.length() && self.matches_at(suffix, offset: self.length() - suffix.length())
}

public fn String.strip_prefix(self, prefix: String) -> Option[view String]
  ensures (result is Some(_)) == self.starts_with(prefix)
  cost time O(prefix.length())
{
  if !self.starts_with(prefix) {
    return None
  }
  proof {
    if prefix.length() > 0 {
      utf8.match_lies_between_boundaries(self.model(), part: prefix.model(), at: 0)
    }
  }
  Some(self.part(prefix.length(), to: self.length()))
}

public fn String.strip_suffix(self, suffix: String) -> Option[view String]
  ensures (result is Some(_)) == self.ends_with(suffix)
  cost time O(suffix.length())
{
  if !self.ends_with(suffix) {
    return None
  }
  proof {
    if suffix.length() > 0 {
      utf8.match_lies_between_boundaries(self.model(), part: suffix.model(), at: self.length() - suffix.length())
    }
  }
  Some(self.part(0, to: self.length() - suffix.length()))
}

internal fn String.leading_whitespace(self) -> UInt64
  ensures result <= self.length()
  ensures self.is_boundary(result)
  cost time O(self.length())
{
  var start: UInt64 = 0
  while start < self.length()
    invariant start <= self.length()
    invariant self.is_boundary(start)
    decreases self.length() - start
    cost time O(start)
  {
    let decoded = self.decode(start)
    if !decoded.character.is_whitespace() {
      return start
    }
    start += decoded.length
  }
  start
}

internal fn String.trailing_whitespace_start(self) -> UInt64
  ensures result <= self.length()
  ensures self.is_boundary(result)
  cost time O(self.length())
{
  var end = self.length()
  while end > 0
    invariant end <= self.length()
    invariant self.is_boundary(end)
    decreases end
    cost time O(self.length() - end)
  {
    let start = self.previous_start(end)
    if !self.decode(start).character.is_whitespace() {
      return end
    }
    end = start
  }
  end
}

public fn String.trim(self) -> view String
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.trim_start().trim_end()
}

public fn String.trim_start(self) -> view String
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.part(self.leading_whitespace(), to: self.length())
}

public fn String.trim_end(self) -> view String
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  self.part(0, to: self.trailing_whitespace_start())
}

internal fn String.leading_matching(self, predicate: (fn(Character) -> Bool uses generic Granted)) -> UInt64
  uses generic Granted
  ensures result <= self.length()
  ensures self.is_boundary(result)
  cost time O(self.length() * time(predicate))
{
  var start: UInt64 = 0
  while start < self.length()
    invariant start <= self.length()
    invariant self.is_boundary(start)
    decreases self.length() - start
    cost time O(start * time(predicate))
  {
    let decoded = self.decode(start)
    if !predicate(decoded.character) {
      return start
    }
    start += decoded.length
  }
  start
}

internal fn String.trailing_matching_start(
  self,
  predicate: (fn(Character) -> Bool uses generic Granted),
  from: UInt64,
) -> UInt64
  uses generic Granted
  requires from <= self.length()
  ensures from <= result
  ensures result <= self.length()
  ensures self.is_boundary(result)
  cost time O(self.length() * time(predicate))
{
  var end = self.length()
  while end > from
    invariant from <= end
    invariant end <= self.length()
    invariant self.is_boundary(end)
    decreases end
    cost time O((self.length() - end) * time(predicate))
  {
    let start = self.previous_start(end)
    if start < from || !predicate(self.decode(start).character) {
      return end
    }
    end = start
  }
  end
}

public fn String.trim_matching(self, predicate: (fn(Character) -> Bool uses generic Granted)) -> view String
  uses generic Granted
  ensures result.length() <= self.length()
  cost time O(self.length() * time(predicate))
{
  let start = self.leading_matching(predicate)
  self.part(start, to: self.trailing_matching_start(predicate, from: start))
}

public fn String.split(self, separator: String) -> List[view String]
  uses Panic unless separator.length() > 0
  ensures result.length() <= self.length() + 1
  cost time O(self.length() + separator.length())
{
  if separator.is_empty() {
    Panic.crash("the separator is empty")
  }
  var parts: List[view String] = []
  let table = failure_table(separator)
  let first_byte = separator.byte(0)
  var start: UInt64 = 0
  var matched: UInt64 = 0
  var index: UInt64 = 0
  while index < self.length()
    invariant index <= self.length()
    invariant matched < separator.length()
    invariant start + matched <= index
    invariant parts.length() <= index
    invariant self.is_boundary(start)
    invariant matches_before(self.model(), pattern: separator.model(), index: index, matched: matched)
    decreases self.length() - index
    cost time O(2 * index - matched)
  {
    if matched == 0 {
      index = self.find_byte(first_byte, from: index)
      if index == self.length() {
        break
      }
    }
    matched = self.advance(separator, table: table, matched: matched, index: index)
    index += 1
    if matched == separator.length() {
      let offset = index - matched
      proof {
        utf8.match_lies_between_boundaries(self.model(), part: separator.model(), at: offset)
      }
      mut parts.push(self.part(start, to: offset))
      start = index
      matched = 0
    }
  }
  mut parts.push(self.part(start, to: self.length()))
  parts
}

public fn String.split_at_most(self, separator: String, parts: UInt64) -> List[view String]
  uses Panic unless separator.length() > 0 && parts > 0
  ensures result.length() <= parts
  ensures result.length() <= self.length() + 1
  cost time O(self.length() + separator.length())
{
  if separator.is_empty() {
    Panic.crash("the separator is empty")
  }
  if parts == 0 {
    Panic.crash("the part count is zero")
  }
  var pieces: List[view String] = []
  let table = failure_table(separator)
  let first_byte = separator.byte(0)
  var start: UInt64 = 0
  var matched: UInt64 = 0
  var index: UInt64 = 0
  var count: UInt64 = 0
  while index < self.length() && count + 1 < parts
    invariant index <= self.length()
    invariant matched < separator.length()
    invariant start + matched <= index
    invariant pieces.length() == count
    invariant count < parts
    invariant count <= index
    invariant self.is_boundary(start)
    invariant matches_before(self.model(), pattern: separator.model(), index: index, matched: matched)
    decreases self.length() - index
    cost time O(2 * index - matched)
  {
    if matched == 0 {
      index = self.find_byte(first_byte, from: index)
      if index == self.length() {
        break
      }
    }
    matched = self.advance(separator, table: table, matched: matched, index: index)
    index += 1
    if matched == separator.length() {
      let offset = index - matched
      proof {
        utf8.match_lies_between_boundaries(self.model(), part: separator.model(), at: offset)
      }
      mut pieces.push(self.part(start, to: offset))
      count += 1
      start = index
      matched = 0
    }
  }
  mut pieces.push(self.part(start, to: self.length()))
  pieces
}

public fn String.split_matching(self, predicate: (fn(Character) -> Bool uses generic Granted)) -> List[view String]
  uses generic Granted
  ensures result.length() <= self.length() + 1
  cost time O(self.length() * time(predicate))
{
  var parts: List[view String] = []
  var start: UInt64 = 0
  var offset: UInt64 = 0
  while offset < self.length()
    invariant start <= offset
    invariant offset <= self.length()
    invariant parts.length() <= offset
    invariant self.is_boundary(start)
    invariant self.is_boundary(offset)
    decreases self.length() - offset
    cost time O(offset * time(predicate))
  {
    let decoded = self.decode(offset)
    if predicate(decoded.character) {
      mut parts.push(self.part(start, to: offset))
      start = offset + decoded.length
    }
    offset += decoded.length
  }
  mut parts.push(self.part(start, to: self.length()))
  parts
}

public fn String.split_whitespace(self) -> List[view String]
  ensures result.length() <= self.length() + 1
  cost time O(self.length())
{
  var parts: List[view String] = []
  var start: UInt64 = 0
  var inside = false
  var offset: UInt64 = 0
  while offset < self.length()
    invariant start <= offset
    invariant offset <= self.length()
    invariant parts.length() <= offset
    invariant self.is_boundary(start)
    invariant self.is_boundary(offset)
    decreases self.length() - offset
    cost time O(offset)
  {
    let decoded = self.decode(offset)
    if decoded.character.is_whitespace() {
      if inside {
        mut parts.push(self.part(start, to: offset))
        inside = false
      }
    } else if !inside {
      start = offset
      inside = true
    }
    offset += decoded.length
  }
  if inside {
    mut parts.push(self.part(start, to: self.length()))
  }
  parts
}

public fn String.split_once(self, separator: String) -> Option[core.Pair[view String, view String]]
  ensures (result is Some(_)) == (self.find(separator) is Some(_))
  cost time O(self.length() + separator.length())
{
  match self.find(separator) {
    Some(offset) => Some(
      core.Pair(
        first: self.part(0, to: offset),
        second: self.part(offset + separator.length(), to: self.length()),
      ),
    )
    None => None
  }
}

public fn String.split_once_last(self, separator: String) -> Option[core.Pair[view String, view String]]
  ensures (result is Some(_)) == (self.find_last(separator) is Some(_))
  cost time O(self.length() + separator.length())
{
  match self.find_last(separator) {
    Some(offset) => Some(
      core.Pair(
        first: self.part(0, to: offset),
        second: self.part(offset + separator.length(), to: self.length()),
      ),
    )
    None => None
  }
}

fn copy_replaced(output: mut intrinsic.Storage[UInt8], text: String, from: UInt64, to: UInt64, replacement: String)
  requires from <= to
  requires to <= text.length()
  requires text.is_boundary(from)
  requires text.is_boundary(to)
  requires intrinsic.storage_length(output) + (to - from) + replacement.length() <= intrinsic.storage_capacity(output)
  requires utf8.is_valid(intrinsic.storage_model(output))
  ensures intrinsic.storage_length(output) == old(intrinsic.storage_length(output)) + (to - from) + replacement.length()
  ensures intrinsic.storage_capacity(output) == old(intrinsic.storage_capacity(output))
  ensures utf8.is_valid(intrinsic.storage_model(output))
  cost time O(to - from + replacement.length())
  cost allocations == 0
{
  text.part(from, to: to).copy_onto(mut output)
  replacement.copy_onto(mut output)
}

public fn String.replace(self, pattern: String, replacement: String) -> String
  uses Panic unless pattern.length() > 0
  cost time O(self.length() + result.length())
{
  if pattern.is_empty() {
    Panic.crash("the pattern is empty")
  }
  if pattern.length() > self.length() {
    return self.copy()
  }
  let count = self.occurrences(pattern)
  if count == 0 {
    return self.copy()
  }
  if replacement.length() > UInt64.maximum / 4 / count || self.length() > UInt64.maximum / 4 {
    intrinsic.crash("a string cannot hold that many bytes")
  }
  self.replace_matches(pattern, replacement: replacement, budget: count * replacement.length())
}

fn String.replace_matches(self, pattern: String, replacement: String, budget: UInt64) -> String
  requires 0 < pattern.length()
  requires pattern.length() <= self.length()
  requires self.length() + budget <= UInt64.maximum
  cost time O(self.length() + result.length())
{
  let capacity = self.length() + budget
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(capacity)
  let table = failure_table(pattern)
  let first_byte = pattern.byte(0)
  var remaining = budget
  var copied: UInt64 = 0
  var matched: UInt64 = 0
  var index: UInt64 = 0
  while index < self.length()
    invariant index <= self.length()
    invariant matched < pattern.length()
    invariant copied + matched <= index
    invariant intrinsic.storage_length(output) + (self.length() - copied) + remaining <= capacity
    invariant intrinsic.storage_capacity(output) == capacity
    invariant utf8.is_valid(intrinsic.storage_model(output))
    invariant self.is_boundary(copied)
    invariant matches_before(self.model(), pattern: pattern.model(), index: index, matched: matched)
    decreases self.length() - index
    cost time O(2 * index - matched + intrinsic.storage_length(output))
  {
    if matched == 0 {
      index = self.find_byte(first_byte, from: index)
      if index == self.length() {
        break
      }
    }
    matched = self.advance(pattern, table: table, matched: matched, index: index)
    index += 1
    if matched == pattern.length() {
      if remaining >= replacement.length() {
        proof {
          utf8.match_lies_between_boundaries(self.model(), part: pattern.model(), at: index - matched)
        }
        copy_replaced(mut output, text: self, from: copied, to: index - matched, replacement: replacement)
        remaining -= replacement.length()
        copied = index
        matched = 0
      } else {
        matched = self.shorter_match(pattern, table: table, matched: matched, index: index)
      }
    }
  }
  self.part(copied, to: self.length()).copy_onto(mut output)
  String(storage: own output)
}

public fn String.replace_first(self, pattern: String, replacement: String) -> String
  cost time O(self.length() + replacement.length())
{
  if pattern.length() > self.length() {
    return self.copy()
  }
  match self.find(pattern) {
    Some(offset) => {
      if replacement.length() > UInt64.maximum / 4 || self.length() > UInt64.maximum / 4 {
        intrinsic.crash("a string cannot hold that many bytes")
      }
      var output: intrinsic.Storage[UInt8] =
        intrinsic.storage_with_capacity(self.length() - pattern.length() + replacement.length())
      self.part(0, to: offset).copy_onto(mut output)
      replacement.copy_onto(mut output)
      self.part(offset + pattern.length(), to: self.length()).copy_onto(mut output)
      String(storage: own output)
    }
    None => self.copy()
  }
}

public fn String.repeated(self, times: UInt64) -> String
  ensures result.length() == self.length() * times
  cost time O(self.length() * times)
{
  if self.length() == 0 || times == 0 {
    return String(storage: intrinsic.storage_empty())
  }
  if times > core.maximum_length / self.length() {
    intrinsic.crash("a string cannot hold that many bytes")
  }
  let total = self.length() * times
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(total)
  for copy in 0..times
    invariant intrinsic.storage_length(output) == copy * self.length()
    invariant intrinsic.storage_capacity(output) == total
    invariant utf8.is_valid(intrinsic.storage_model(output))
    cost time O(copy * self.length())
  {
    proof {
      assert (copy + 1) * self.length() <= total
    }
    self.copy_onto(mut output)
  }
  String(storage: own output)
}

public fn String.reversed(self) -> String
  ensures result.length() == self.length()
  cost time O(self.length())
{
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(self.length())
  var end = self.length()
  while end > 0
    invariant end <= self.length()
    invariant self.is_boundary(end)
    invariant intrinsic.storage_length(output) == self.length() - end
    invariant intrinsic.storage_capacity(output) == self.length()
    invariant utf8.is_valid(intrinsic.storage_model(output))
    decreases end
    cost time O(self.length() - end)
  {
    let start = self.previous_start(end)
    self.part(start, to: end).copy_onto(mut output)
    end = start
  }
  String(storage: own output)
}

internal fn String.push_scalar(mut self, code: UInt32)
  cost amortized time O(1)
{
  if code <= 1114111 && (code < 55296 || code > 57343) {
    mut self.push_character(intrinsic.convert(code))
  }
}

internal fn String.push_expansion(mut self, expansion: unicode_tables.Expansion)
  cost amortized time O(1)
{
  mut self.push_scalar(expansion.first)
  if expansion.second != 0 {
    mut self.push_scalar(expansion.second)
  }
  if expansion.third != 0 {
    mut self.push_scalar(expansion.third)
  }
}

public fn String.to_uppercase(self) -> String
  cost time O(self.length())
{
  var output = ""
  var offset: UInt64 = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant self.is_boundary(offset)
    decreases self.length() - offset
  {
    let decoded = self.decode(offset)
    match unicode_tables.uppercase_expansion_of(decoded.character.code()) {
      Some(expansion) => mut output.push_expansion(expansion)
      None => mut output.push_character(decoded.character.to_uppercase())
    }
    offset += decoded.length
  }
  output
}

internal type PendingText(text: String)
  cost potential 8 * text.length()

internal fn PendingText.push_character(mut self, character: Character)
  cost amortized time O(1)
{
  mut self.text.push_character(character)
}

internal fn PendingText.flush(mut self, output: mut String)
  cost amortized time O(1)
{
  mut output.push(self.text)
  self.text = ""
}

internal fn lower_character(
  output: mut String,
  after_sigma: mut PendingText,
  sigma_is_undecided: mut Bool,
  follows_cased: mut Bool,
  character: Character,
)
  cost amortized time O(1)
{
  let code = character.code()
  let cased = unicode_tables.is_cased(code)
  let ignorable = unicode_tables.is_case_ignorable(code)
  if !ignorable && sigma_is_undecided {
    if cased {
      mut output.push("σ")
    } else {
      mut output.push("ς")
    }
    mut after_sigma.flush(mut output)
    sigma_is_undecided = false
  }
  if code == 931 {
    if follows_cased {
      sigma_is_undecided = true
    } else {
      mut output.push("σ")
    }
  } else if sigma_is_undecided {
    mut after_sigma.push_character(character.to_lowercase())
  } else {
    match unicode_tables.lowercase_expansion_of(code) {
      Some(expansion) => mut output.push_expansion(expansion)
      None => mut output.push_character(character.to_lowercase())
    }
  }
  if !ignorable {
    follows_cased = cased
  }
}

public fn String.to_lowercase(self) -> String
  cost time O(self.length())
{
  var output = ""
  var after_sigma = PendingText(text: "")
  var sigma_is_undecided = false
  var follows_cased = false
  var offset: UInt64 = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant self.is_boundary(offset)
    decreases self.length() - offset
  {
    let decoded = self.decode(offset)
    lower_character(
      mut output,
      after_sigma: mut after_sigma,
      sigma_is_undecided: mut sigma_is_undecided,
      follows_cased: mut follows_cased,
      character: decoded.character,
    )
    offset += decoded.length
  }
  if sigma_is_undecided {
    mut output.push("ς")
    mut after_sigma.flush(mut output)
  }
  output
}

public fn String.to_ascii_uppercase(self) -> String
  ensures result.length() == self.length()
  cost time O(self.length())
{
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(self.length())
  for index in 0..self.length()
    invariant intrinsic.storage_length(output) == index
    invariant intrinsic.storage_capacity(output) == self.length()
    invariant forall i in 0..index => intrinsic.storage_model(output)[i] == ascii_uppercase(self.model()[i])
  {
    intrinsic.storage_push(mut output, value: ascii_uppercase(self.byte(index)))
  }
  proof {
    utf8.ascii_mapping_is_valid(self.model(), mapped: intrinsic.storage_model(output))
  }
  String(storage: own output)
}

public fn String.to_ascii_lowercase(self) -> String
  ensures result.length() == self.length()
  cost time O(self.length())
{
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(self.length())
  for index in 0..self.length()
    invariant intrinsic.storage_length(output) == index
    invariant intrinsic.storage_capacity(output) == self.length()
    invariant forall i in 0..index => intrinsic.storage_model(output)[i] == ascii_lowercase(self.model()[i])
  {
    intrinsic.storage_push(mut output, value: ascii_lowercase(self.byte(index)))
  }
  proof {
    utf8.ascii_mapping_is_valid(self.model(), mapped: intrinsic.storage_model(output))
  }
  String(storage: own output)
}

internal fn ascii_lowercase(byte: UInt8) -> UInt8
  ensures byte >= 65 && byte <= 90 ==> result == byte + 32
  ensures !(byte >= 65 && byte <= 90) ==> result == byte
  cost time O(1)
{
  if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

internal fn ascii_uppercase(byte: UInt8) -> UInt8
  ensures byte >= 97 && byte <= 122 ==> result == byte - 32
  ensures !(byte >= 97 && byte <= 122) ==> result == byte
  cost time O(1)
{
  if byte >= 97 && byte <= 122 { byte - 32 } else { byte }
}

public fn String.equal_ignoring_ascii_case(self, other: String) -> Bool
  cost time O(self.length())
{
  if self.length() != other.length() {
    return false
  }
  for index in 0..self.length() {
    if ascii_lowercase(self.byte(index)) != ascii_lowercase(other.byte(index)) {
      return false
    }
  }
  true
}

internal fn String.padded(self, width: UInt64, fill: Character, at_start: Bool) -> String
  cost time O(self.length() + width)
{
  let count = self.character_count()
  if count >= width {
    return self.copy()
  }
  let missing = width - count
  let unit = fill.utf8_length()
  if missing > UInt64.maximum / 16 || self.length() > UInt64.maximum / 4 {
    intrinsic.crash("a string cannot hold that many bytes")
  }
  var room: UInt64 = if unit == 1 {
    missing
  } else if unit == 2 {
    missing * 2
  } else if unit == 3 {
    missing * 3
  } else {
    missing * 4
  }
  let after: UInt64 = if at_start { self.length() } else { 0 }
  let capacity = self.length() + room
  var output: intrinsic.Storage[UInt8] = intrinsic.storage_with_capacity(capacity)
  if !at_start {
    self.copy_onto(mut output)
  }
  while room >= unit
    invariant intrinsic.storage_length(output) + room + after <= capacity
    invariant intrinsic.storage_capacity(output) == capacity
    invariant utf8.is_valid(intrinsic.storage_model(output))
    decreases room
    cost time O(intrinsic.storage_length(output))
  {
    fill.encode_onto(mut output)
    room -= unit
  }
  if at_start {
    self.copy_onto(mut output)
  }
  String(storage: own output)
}

public fn String.pad_start(self, width: UInt64, fill: Character = Character" ") -> String
  cost time O(self.length() + width)
{
  self.padded(width, fill: fill, at_start: true)
}

public fn String.pad_end(self, width: UInt64, fill: Character = Character" ") -> String
  cost time O(self.length() + width)
{
  self.padded(width, fill: fill, at_start: false)
}

public fn String.to_bytes(self) -> List[UInt8]
  ensures result.length() == self.length()
  cost time O(self.length())
{
  var bytes: List[UInt8] = List.with_capacity(self.length())
  for index in 0..self.length()
    invariant bytes.length() == index
  {
    mut bytes.push(self.byte(index))
  }
  bytes
}

public fn String.to_utf16(self) -> List[UInt16]
  ensures result.length() <= self.length()
  cost time O(self.length())
{
  var units: intrinsic.Storage[UInt16] = intrinsic.storage_with_capacity(self.length())
  var offset: UInt64 = 0
  while offset < self.length()
    invariant offset <= self.length()
    invariant intrinsic.storage_length(units) <= offset
    invariant intrinsic.storage_capacity(units) == self.length()
    invariant self.is_boundary(offset)
    decreases self.length() - offset
    cost time O(offset)
  {
    let decoded = self.decode(offset)
    let code = decoded.character.code()
    if code < 65536 {
      intrinsic.storage_push(mut units, value: intrinsic.convert(code))
    } else {
      let above = code - 65536
      intrinsic.storage_push(mut units, value: intrinsic.convert(55296 + above / 1024))
      intrinsic.storage_push(mut units, value: intrinsic.convert(56320 + above % 1024))
    }
    offset += decoded.length
  }
  List(storage: own units)
}
