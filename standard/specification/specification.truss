public opaque type Sequence[Element] = todo

public fn Sequence[Element].empty() -> Sequence[Element]
  ensures result.length() == 0
  ensures forall measure: (fn(Element) -> Integer cost time finite) => result.sum(measure) == 0
  cost time finite
{
  todo
}

public fn Sequence[Element].length(self) -> Integer
  ensures result >= 0
  cost time finite
{
  todo
}

public fn Sequence[Element].append(self, value: Element) -> Sequence[Element]
  ensures result.length() == self.length() + 1
  ensures identical(result[self.length()], value)
  ensures forall i in 0..self.length() => identical(result[i], self[i])
  ensures forall measure: (fn(Element) -> Integer cost time finite) => result.sum(measure) == self.sum(measure) + measure(value)
  cost time finite
{
  todo
}

public fn Sequence[Element].concatenate(self, other: Sequence[Element]) -> Sequence[Element]
  ensures result.length() == self.length() + other.length()
  ensures forall i in 0..self.length() => identical(result[i], self[i])
  ensures forall i in 0..other.length() => identical(result[self.length() + i], other[i])
  ensures forall measure: (fn(Element) -> Integer cost time finite) => result.sum(measure) == self.sum(measure) + other.sum(measure)
  cost time finite
{
  todo
}

public fn Sequence[Element].update(self, index: Integer, value: Element) -> Sequence[Element]
  requires 0 <= index && index < self.length()
  ensures result.length() == self.length()
  ensures identical(result[index], value)
  ensures forall i in 0..self.length() => i == index || identical(result[i], self[i])
  ensures forall measure: (fn(Element) -> Integer cost time finite) =>
    result.sum(measure) == self.sum(measure) - measure(self[index]) + measure(value)
  cost time finite
{
  todo
}

public fn Sequence[Element].contains(self, value: Element) -> Bool
  ensures result == (exists i in 0..self.length() => identical(self[i], value))
  cost time finite
{
  todo
}

public fn Sequence[Element].elements(self) -> FiniteSet[Element]
  ensures forall value: Element =>
    result.contains(value) == (exists i in 0..self.length() => identical(self[i], value))
  ensures (forall i in 0..self.length() => forall j in 0..self.length() =>
    i == j || !identical(self[i], self[j])) ==> result.size() == self.length()
  cost time finite
{
  todo
}

public fn Sequence[Element].to_map[Key, Value](
  self,
  key: (fn(Element) -> Key cost time finite),
  value: (fn(Element) -> Value cost time finite),
) -> FiniteMap[Key, Value]
  ensures forall each: Key =>
    result.contains_key(each) == (exists i in 0..self.length() => identical(key(self[i]), each))
  ensures (forall i in 0..self.length() => forall j in 0..self.length() =>
    i == j || !identical(key(self[i]), key(self[j]))) ==>
      result.size() == self.length()
      && forall i in 0..self.length() => identical(result.get(key(self[i])), value(self[i]))
  cost time finite
{
  todo
}

public fn Sequence[Element].sum(self, measure: (fn(Element) -> Integer cost time finite)) -> Integer
  ensures self.length() == 0 ==> result == 0
  ensures (forall i in 0..self.length() => measure(self[i]) >= 0) ==> result >= 0
  cost time finite
{
  todo
}

impl Index for Sequence[Element] {
  type Key = Integer
  type Output = Element

  fn contains_key(self, key: Integer) -> Bool
    cost time finite
  {
    0 <= key && key < self.length()
  }

  fn at(self, key: Integer) lends Element
    requires 0 <= key && key < self.length()
    cost time finite
  {
    todo
  }
}

public opaque type FiniteSet[Element] = todo

public fn FiniteSet[Element].empty() -> FiniteSet[Element]
  ensures result.size() == 0
  ensures forall value: Element => !result.contains(value)
  cost time finite
{
  todo
}

public fn FiniteSet[Element].size(self) -> Integer
  ensures result >= 0
  cost time finite
{
  todo
}

public fn FiniteSet[Element].contains(self, value: Element) -> Bool
  cost time finite
{
  todo
}

public fn FiniteSet[Element].insert(self, value: Element) -> FiniteSet[Element]
  ensures result.contains(value)
  ensures forall other: Element => identical(other, value) || result.contains(other) == self.contains(other)
  ensures result.size() == (if self.contains(value) { self.size() } else { self.size() + 1 })
  cost time finite
{
  todo
}

public fn FiniteSet[Element].remove(self, value: Element) -> FiniteSet[Element]
  ensures !result.contains(value)
  ensures forall other: Element => identical(other, value) || result.contains(other) == self.contains(other)
  ensures result.size() == (if self.contains(value) { self.size() - 1 } else { self.size() })
  cost time finite
{
  todo
}

