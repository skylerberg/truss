  cost time finite
{
  todo
}

public fn FiniteMap[Key, Value].get(self, key: Key) -> Value
  requires self.contains_key(key)
  cost time finite
{
  todo
}

public fn FiniteMap[Key, Value].insert(self, key: Key, value: Value) -> FiniteMap[Key, Value]
  ensures result.contains_key(key)
  ensures identical(result.get(key), value)
  ensures forall other: Key => identical(other, key) || result.contains_key(other) == self.contains_key(other)
  ensures forall other: Key => identical(other, key) || !self.contains_key(other) || identical(result.get(other), self.get(other))
  ensures result.size() == (if self.contains_key(key) { self.size() } else { self.size() + 1 })
  cost time finite
{
  todo
}

public fn FiniteMap[Key, Value].keys(self) -> FiniteSet[Key]
  ensures forall key: Key => result.contains(key) == self.contains_key(key)
  ensures result.size() == self.size()
  cost time finite
{
  todo
}

