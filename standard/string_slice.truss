public fn StringSlice.substring(self, from: USize, to: USize) -> StringSlice
  requires from <= to
  requires to <= self.length()
  requires self.is_boundary(from)
  requires self.is_boundary(to)
  ensures result.length() == to - from
  cost time O(1)
{
  todo
}

public fn StringSlice.get_substring(self, from: USize, to: USize) -> Option[StringSlice]
  cost time O(1)
{
  todo
}

public fn StringSlice.split_at(self, offset: USize) -> Pair[StringSlice, StringSlice]
  requires offset <= self.length()
  requires self.is_boundary(offset)
  ensures result.first.length() == offset
  ensures result.second.length() == self.length() - offset
  cost time O(1)
{
  todo
}

public fn StringSlice.contains(self, pattern: StringSlice) -> Bool
  cost time O(self.length() + pattern.length())
{
  todo
}

public fn StringSlice.find(self, pattern: StringSlice) -> Option[USize]
  ensures match result {
    Some(offset) => offset + pattern.length() <= self.length() && self.is_boundary(offset)
    None => !self.contains(pattern)
  }
  cost time O(self.length() + pattern.length())
{
  todo
}

public fn StringSlice.find_last(self, pattern: StringSlice) -> Option[USize]
  ensures match result {
    Some(offset) => offset + pattern.length() <= self.length() && self.is_boundary(offset)
    None => !self.contains(pattern)
  }
  cost time O(self.length() + pattern.length())
{
  todo
}

public fn StringSlice.find_character(
  self,
  matching: (fn(Character) -> Bool cost time finite),
) -> Option[USize]
  ensures match result {
    Some(offset) => offset < self.length() && self.is_boundary(offset)
    None => true
  }
  cost time O(self.length() * time(matching))
{
  todo
}

