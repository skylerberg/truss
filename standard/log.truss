use standard::json
use standard::simulation

public type Level = Debug | Information | Warning | Error
  derives Equal, Hash, Ordered

impl Display for Level {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Debug => mut output.write("debug")
      Information => mut output.write("information")
      Warning => mut output.write("warning")
      Error => mut output.write("error")
    }
  }
}

public type Value =
  | String(value: String)
  | Integer(value: Int64)
  | Float(value: Float64)
  | Bool(value: Bool)
  | Duration(value: Duration)
  | Instant(value: Instant)

public type Field(name: String, value: Value)

public fn Field.string(name: StringSlice, value: StringSlice) -> Field {
  Field(name: name.to_string(), value: Value.String(value.to_string()))
}

public fn Field.integer(name: StringSlice, value: Int64) -> Field {
  Field(name: name.to_string(), value: Value.Integer(value))
}

public fn Field.float(name: StringSlice, value: Float64) -> Field {
  Field(name: name.to_string(), value: Value.Float(value))
}

public fn Field.bool(name: StringSlice, value: Bool) -> Field {
  Field(name: name.to_string(), value: Value.Bool(value))
}

public fn Field.duration(name: StringSlice, value: Duration) -> Field {
  Field(name: name.to_string(), value: Value.Duration(value))
}

public fn Field.display[Shown: Display](name: StringSlice, value: Shown) -> Field {
  Field(name: name.to_string(), value: Value.String("${value}"))
}

public type Record(level: Level, message: String, fields: List[Field])

public fn debug(message: StringSlice, fields: own List[Field] = [])
  uses Log
{
  if Log.enabled(Level.Debug) {
    Log.record(Record(level: Level.Debug, message: message.to_string(), fields: own fields))
  }
}

public fn information(message: StringSlice, fields: own List[Field] = [])
  uses Log
{
  if Log.enabled(Level.Information) {
    Log.record(Record(level: Level.Information, message: message.to_string(), fields: own fields))
  }
}

public fn warning(message: StringSlice, fields: own List[Field] = [])
  uses Log
{
  if Log.enabled(Level.Warning) {
    Log.record(Record(level: Level.Warning, message: message.to_string(), fields: own fields))
  }
}

public fn error(message: StringSlice, fields: own List[Field] = [])
  uses Log
{
  if Log.enabled(Level.Error) {
    Log.record(Record(level: Level.Error, message: message.to_string(), fields: own fields))
  }
}

public type DiscardLog()

impl Log for DiscardLog {
  fn record(self, record: Record) {}

  fn enabled(self, level: Level) -> Bool {
    false
  }
}

public type CapturedLog(records: List[Record] = [])

impl Log for CapturedLog {
  fn record(mut self, record: Record) {
    mut self.records.push(record.copy())
  }

  fn enabled(mut self, level: Level) -> Bool {
    true
  }
}

public type Format = Lines | Json
  derives Equal

public type ConsoleLog(minimum: Level = Level.Information, format: Format = Format.Lines)

fn needs_quotes(text: StringSlice) -> Bool {
  if text.is_empty() {
    return true
  }
  for index in 0..text.length() {
    let byte = text.byte(index)
    if byte <= 32 || byte == 34 || byte == 61 || byte == 127 {
      return true
    }
  }
  false
}

fn write_value(output: mut TextBuilder, value: Value, as_json: Bool) {
  match value {
    String(text) => {
      if as_json || needs_quotes(text.slice()) {
        mut output.write(json::quote(text.slice()).slice())
      } else {
        mut output.write(text.slice())
      }
    }
    Integer(number) => number.display(mut output)
    Float(number) => {
      if as_json && !number.is_finite() {
        mut output.write(json::quote("${number}").slice())
      } else {
        number.display(mut output)
      }
    }
    Bool(flag) => flag.display(mut output)
    Duration(duration) => {
      if as_json {
        mut output.write(json::quote("${duration}").slice())
      } else {
        duration.display(mut output)
      }
    }
    Instant(instant) => {
      if as_json {
        mut output.write(json::quote("${instant}").slice())
      } else {
        instant.display(mut output)
      }
    }
  }
}

fn write_line(output: mut TextBuilder, time: Instant, record: Record) {
  time.display(mut output)
  mut output.write(" ")
  record.level.display(mut output)
  mut output.write(" ")
  mut output.write(record.message.slice())
  for index in 0..record.fields.length() {
    mut output.write(" ")
    mut output.write(record.fields[index].name.slice())
    mut output.write("=")
    write_value(mut output, value: record.fields[index].value, as_json: false)
  }
}

fn write_json(output: mut TextBuilder, time: Instant, record: Record) {
  mut output.write("{\"time\":")
  mut output.write(json::quote("${time}").slice())
  mut output.write(",\"level\":")
  mut output.write(json::quote("${record.level}").slice())
  mut output.write(",\"message\":")
  mut output.write(json::quote(record.message.slice()).slice())
  for index in 0..record.fields.length() {
    mut output.write(",")
    mut output.write(json::quote(record.fields[index].name.slice()).slice())
    mut output.write(":")
    write_value(mut output, value: record.fields[index].value, as_json: true)
  }
  mut output.write("}")
}

impl Log for ConsoleLog
  uses Console, Clock
{
  fn record(self, record: Record) {
    var output = TextBuilder.new()
    match self.format {
      Lines => write_line(mut output, time: Clock.now(), record: record)
      Json => write_json(mut output, time: Clock.now(), record: record)
    }
    let line = own output.finish()
    Console.print_error(line.slice())
  }

  fn enabled(self, level: Level) -> Bool {
    level >= self.minimum
  }
}

public type AtLeast(minimum: Level)

impl Log for AtLeast
  uses Log
{
  fn record(self, record: Record) {
    if record.level >= self.minimum {
      Log.record(record)
    }
  }

  fn enabled(self, level: Level) -> Bool {
    level >= self.minimum && Log.enabled(level)
  }
}

public type WithFields(fields: List[Field])

impl Log for WithFields
  uses Log
{
  fn record(self, record: Record)
  {
    var fields = self.fields.copy()
    for field in record.fields {
      mut fields.push(field.copy())
    }
    Log.record(Record(level: record.level, message: record.message.copy(), fields: own fields))
  }

  fn enabled(self, level: Level) -> Bool {
    Log.enabled(level)
  }
}

test "a level is displayed in lower case" {
  assert "${Level.Debug}" == "debug"
  assert "${Level.Information}" == "information"
  assert "${Level.Warning}" == "warning"
  assert "${Level.Error}" == "error"
}

test "a logger that adds fields puts them before the record's own" {
  var captured = CapturedLog()
  provide mut captured {
    provide WithFields(fields: [Field.string("request", value: "r1")]) {
      information("started", fields: [Field.integer("count", value: 2)])
      debug("detail")
    }
    warning("outside")
  }
  assert captured.records.length() == 3
  assert captured.records[0].level == Level.Information
  assert captured.records[0].message == "started"
  assert captured.records[0].fields.length() == 2
  assert captured.records[0].fields[0].name == "request"
  assert captured.records[0].fields[1].name == "count"
  assert captured.records[1].fields.length() == 1
  assert captured.records[1].fields[0].name == "request"
  assert captured.records[2].fields.length() == 0
}

test "a console log writes each record as a line with its time, level, message, and fields" {
  let start = Instant.from_unix_nanoseconds(1700000000000000000)
  let world = simulation::World.from(simulation::Setup.new().with_time(start))
  provide world {
    provide ConsoleLog() {
      information("started", fields: [
        Field.integer("count", value: 2),
        Field.string("user", value: "ada"),
        Field.string("note", value: "two words"),
        Field.bool("ready", value: true),
      ])
      debug("hidden")
      error("failed")
    }
    assert world.errors() == "2023-11-14T22:13:20Z information started count=2 user=ada note=\"two words\" ready=true\n2023-11-14T22:13:20Z error failed\n"
  }
}

test "a console log writes each record as a JSON object when asked to" {
  let start = Instant.from_unix_nanoseconds(1700000000000000000)
  let world = simulation::World.from(simulation::Setup.new().with_time(start))
  provide world {
    provide ConsoleLog(minimum: Level.Debug, format: Format.Json) {
      debug("a \"quoted\" message", fields: [
        Field.integer("count", value: -3),
        Field.float("ratio", value: 0.5),
        Field.string("user", value: "ada"),
        Field.duration("took", value: Duration.milliseconds(1500)),
      ])
    }
    assert world.errors() == "{\"time\":\"2023-11-14T22:13:20Z\",\"level\":\"debug\",\"message\":\"a \\\"quoted\\\" message\",\"count\":-3,\"ratio\":0.5,\"user\":\"ada\",\"took\":\"1.5s\"}\n"
  }
}
