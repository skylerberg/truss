  | May
  | June
  | July
  | August
  | September
  | October
  | November
  | December
  derives Equal, Hash, Ordered

public fn Month.number(self) -> UInt8
  ensures 1 <= result && result <= 12
  cost time O(1)
{
  todo
}

public fn Month.from_number(number: UInt8) -> Option[Month]
  ensures (result is Some(_)) == (1 <= number && number <= 12)
  cost time O(1)
{
  todo
}

public fn Month.days(self, leap_year: Bool) -> UInt8
  ensures 28 <= result && result <= 31
  cost time O(1)
{
  todo
}

impl Display for Month {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

