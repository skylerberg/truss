public opaque type Stopwatch(started: Duration)
  derives Plain

public fn Stopwatch.start() -> Stopwatch
  uses Clock
{
  Stopwatch(started: Clock.monotonic())
}

public fn Stopwatch.elapsed(self) -> Duration
  uses Clock
{
  Clock.monotonic() - self.started
}

public type FixedClock(time: Instant)

impl Clock for FixedClock {
  fn now(self) -> Instant {
    self.time
  }

  fn monotonic(self) -> Duration {
    Duration.zero
  }

  fn sleep(self, duration: Duration) {}
}

public opaque type ManualClock(time: Instant, elapsed: Duration)

public fn ManualClock.new(start: Instant) -> ManualClock {
  ManualClock(time: start, elapsed: Duration.zero)
}

public fn ManualClock.advance(mut self, by: Duration)
  requires !by.is_negative()
{
  self.time = self.time + by
  self.elapsed = self.elapsed + by
}

impl Clock for ManualClock {
  fn now(self) -> Instant {
    self.time
  }

  fn monotonic(self) -> Duration {
    self.elapsed
  }

  fn sleep(mut self, duration: Duration) {
    todo
  }
}
