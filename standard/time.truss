use standard::core
use standard::intrinsic
use standard::serialization
use standard::text

public opaque type Duration(nanoseconds: Int64)
  derives Plain, Equal, Hash, Ordered

public let Duration.zero: Duration = Duration(nanoseconds: 0)

public let Duration.maximum: Duration = Duration(nanoseconds: 9223372036854775807)

public let Duration.minimum: Duration = Duration(nanoseconds: -9223372036854775808)

public fn Duration.nanoseconds(count: Int64) -> Duration
  ensures result.total_nanoseconds() == count
  cost time O(1)
{
  Duration(nanoseconds: count)
}

public fn Duration.microseconds(count: Int64) -> Duration
  requires -9223372036854775 <= count && count <= 9223372036854775
  ensures result.total_nanoseconds() == count * 1000
  cost time O(1)
{
  Duration(nanoseconds: count * 1000)
}

public fn Duration.milliseconds(count: Int64) -> Duration
  requires -9223372036854 <= count && count <= 9223372036854
  ensures result.total_nanoseconds() == count * 1000000
  cost time O(1)
{
  Duration(nanoseconds: count * 1000000)
}

public fn Duration.seconds(count: Int64) -> Duration
  requires -9223372036 <= count && count <= 9223372036
  ensures result.total_nanoseconds() == count * 1000000000
  cost time O(1)
{
  Duration(nanoseconds: count * 1000000000)
}

public fn Duration.minutes(count: Int64) -> Duration
  requires -153722867 <= count && count <= 153722867
  ensures result.total_nanoseconds() == count * 60000000000
  cost time O(1)
{
  Duration(nanoseconds: count * 60000000000)
}

public fn Duration.hours(count: Int64) -> Duration
  requires -2562047 <= count && count <= 2562047
  ensures result.total_nanoseconds() == count * 3600000000000
  cost time O(1)
{
  Duration(nanoseconds: count * 3600000000000)
}

public fn Duration.days(count: Int64) -> Duration
  requires -106751 <= count && count <= 106751
  ensures result.total_nanoseconds() == count * 86400000000000
  cost time O(1)
{
  Duration(nanoseconds: count * 86400000000000)
}

public fn Duration.from_seconds(seconds: Float64) -> Option[Duration]
  cost time O(1)
{
  let nanoseconds = (seconds * 1000000000.0).round()
  if intrinsic::fits[Float64, Int64](nanoseconds) {
    Some(Duration(nanoseconds: intrinsic::convert(nanoseconds)))
  } else {
    None
  }
}

public fn Duration.total_nanoseconds(self) -> Int64
  ensures result == (self.nanoseconds)
  cost time O(1)
{
  self.nanoseconds
}

public fn Duration.total_microseconds(self) -> Int64
  cost time O(1)
{
  self.nanoseconds / 1000
}

public fn Duration.total_milliseconds(self) -> Int64
  cost time O(1)
{
  self.nanoseconds / 1000000
}

public fn Duration.total_seconds(self) -> Int64
  cost time O(1)
{
  self.nanoseconds / 1000000000
}

public fn Duration.subsecond_nanoseconds(self) -> Int32
  ensures -1000000000 < result && result < 1000000000
  cost time O(1)
{
  intrinsic::convert(self.nanoseconds % 1000000000)
}

public fn Duration.to_seconds(self) -> Float64
  cost time O(1)
{
  self.nanoseconds.to_float64() / 1000000000.0
}

public fn Duration.is_zero(self) -> Bool
  cost time O(1)
{
  self.nanoseconds == 0
}

public fn Duration.is_negative(self) -> Bool
  ensures result == (self.nanoseconds < 0)
  cost time O(1)
{
  self.nanoseconds < 0
}

public fn Duration.absolute(self) -> Duration
  ensures !result.is_negative()
  cost time O(1)
{
  if self.nanoseconds == Int64.minimum {
    Duration.maximum
  } else if self.nanoseconds < 0 {
    Duration(nanoseconds: -self.nanoseconds)
  } else {
    self
  }
}

public fn Duration.checked_add(self, other: Duration) -> Option[Duration]
  cost time O(1)
{
  Some(Duration(nanoseconds: self.nanoseconds.checked_add(other.nanoseconds)?))
}

public fn Duration.checked_subtract(self, other: Duration) -> Option[Duration]
  cost time O(1)
{
  Some(Duration(nanoseconds: self.nanoseconds.checked_subtract(other.nanoseconds)?))
}

public fn Duration.checked_multiply(self, factor: Int64) -> Option[Duration]
  cost time O(1)
{
  Some(Duration(nanoseconds: self.nanoseconds.checked_multiply(factor)?))
}

impl Add[Duration] for Duration {
  type Output = Duration

  fn add_is_defined(self, right: Duration) -> Bool
    cost time O(1)
  {
    true
  }

  fn add(self, right: Duration) -> Duration {
    Duration(nanoseconds: self.nanoseconds.saturating_add(right.nanoseconds))
  }
}

impl Subtract[Duration] for Duration {
  type Output = Duration

  fn subtract_is_defined(self, right: Duration) -> Bool
    cost time O(1)
  {
    true
  }

  fn subtract(self, right: Duration) -> Duration {
    Duration(nanoseconds: self.nanoseconds.saturating_subtract(right.nanoseconds))
  }
}

impl Multiply[Int64] for Duration {
  type Output = Duration

  fn multiply_is_defined(self, right: Int64) -> Bool
    cost time O(1)
  {
    true
  }

  fn multiply(self, right: Int64) -> Duration {
    Duration(nanoseconds: self.nanoseconds.saturating_multiply(right))
  }
}

impl Divide[Int64] for Duration {
  type Output = Option[Duration]

  fn divide_is_defined(self, right: Int64) -> Bool
    cost time O(1)
  {
    true
  }

  fn divide(self, right: Int64) -> Option[Duration]
  {
    Some(Duration(nanoseconds: self.nanoseconds.checked_divide(right)?))
  }
}

impl Negate for Duration {
  type Output = Duration

  fn negate_is_defined(self) -> Bool
    cost time O(1)
  {
    true
  }

  fn negate(self) -> Duration
  {
    let zero: Int64 = 0
    Duration(nanoseconds: zero.saturating_subtract(self.nanoseconds))
  }
}

impl Default for Duration {
  fn default() -> Duration {
    Duration.zero
  }
}

internal fn write_fixed_point(output: mut TextBuilder, whole: UInt64, fraction: UInt64, digits: USize)
  cost time finite
{
  whole.display(mut output)
  if fraction != 0 {
    mut output.write(".")
    write_fraction(mut output, value: fraction, digits: digits)
  }
}

impl Display for Duration {
  fn display(self, output: mut TextBuilder) {
    if self.nanoseconds == 0 {
      mut output.write("0s")
      return
    }
    if self.nanoseconds < 0 {
      mut output.write("-")
    }
    let magnitude = self.nanoseconds.unsigned_absolute()
    if magnitude < 1000 {
      magnitude.display(mut output)
      mut output.write("ns")
    } else if magnitude < 1000000 {
      write_fixed_point(mut output, whole: magnitude / 1000, fraction: magnitude % 1000, digits: 3)
      mut output.write("\u{b5}s")
    } else if magnitude < 1000000000 {
      write_fixed_point(mut output, whole: magnitude / 1000000, fraction: magnitude % 1000000, digits: 6)
      mut output.write("ms")
    } else {
      let seconds = magnitude / 1000000000
      let hours = seconds / 3600
      let minutes = seconds / 60 % 60
      if hours > 0 {
        hours.display(mut output)
        mut output.write("h")
      }
      if hours > 0 || minutes > 0 {
        minutes.display(mut output)
        mut output.write("m")
      }
      write_fixed_point(mut output, whole: seconds % 60, fraction: magnitude % 1000000000, digits: 9)
      mut output.write("s")
    }
  }
}

internal type ParsedUnit(nanoseconds: UInt64, end: USize)

internal fn parse_unit(text: StringSlice, from: USize) -> Option[ParsedUnit]
  requires from <= text.length()
  ensures !(result is Some(scale) && (scale.end <= from || scale.end > text.length()))
  ensures !(result is Some(scale) && (scale.nanoseconds == 0 || scale.nanoseconds > 3600000000000))
  cost time O(1)
{
  let left = text.length() - from
  if left == 0 {
    return None
  }
  let first = text.byte(from)
  let second: UInt8 = if left >= 2 { text.byte(from + 1) } else { 0 }
  let third: UInt8 = if left >= 3 { text.byte(from + 2) } else { 0 }
  if first == 110 && second == 115 {
    Some(ParsedUnit(nanoseconds: 1, end: from + 2))
  } else if first == 117 && second == 115 {
    Some(ParsedUnit(nanoseconds: 1000, end: from + 2))
  } else if (first == 194 && second == 181 && third == 115) || (first == 206 && second == 188 && third == 115) {
    Some(ParsedUnit(nanoseconds: 1000, end: from + 3))
  } else if first == 109 && second == 115 {
    Some(ParsedUnit(nanoseconds: 1000000, end: from + 2))
  } else if first == 115 {
    Some(ParsedUnit(nanoseconds: 1000000000, end: from + 1))
  } else if first == 109 {
    Some(ParsedUnit(nanoseconds: 60000000000, end: from + 1))
  } else if first == 104 {
    Some(ParsedUnit(nanoseconds: 3600000000000, end: from + 1))
  } else {
    None
  }
}

internal fn skip_digits(text: StringSlice, from: USize) -> USize
  requires from <= text.length()
  ensures from <= result
  ensures result <= text.length()
  ensures forall position in from..result => text.byte(position) >= 48 && text.byte(position) <= 57
  cost time O(result - from)
{
  var index = from
  while index < text.length() && text.byte(index) >= 48 && text.byte(index) <= 57
    invariant from <= index
    invariant index <= text.length()
    invariant forall position in from..index => text.byte(position) >= 48 && text.byte(position) <= 57
    decreases text.length() - index
    cost time O(index - from)
  {
    index += 1
  }
  index
}

internal fn parse_integer(text: StringSlice, from: USize, to: USize) -> Option[UInt64]
  requires from <= to
  requires to <= text.length()
  requires forall position in from..to => text.byte(position) >= 48 && text.byte(position) <= 57
  cost time O(to - from)
{
  var value: UInt64 = 0
  var fits = true
  var index = from
  while index < to
    invariant from <= index
    invariant index <= to
    decreases to - index
    cost time O(index - from)
  {
    let digit: UInt64 = intrinsic::convert(text.byte(index) - 48)
    if value > (UInt64.maximum - digit) / 10 {
      fits = false
    } else {
      value = value * 10 + digit
    }
    index += 1
  }
  if fits { Some(value) } else { None }
}

internal fn parse_fraction(text: StringSlice, from: USize, to: USize, unit: UInt64) -> UInt64
  requires from <= to
  requires to <= text.length()
  requires forall position in from..to => text.byte(position) >= 48 && text.byte(position) <= 57
  requires 0 < unit && unit <= 3600000000000
  ensures result < unit
  cost time O(to - from)
{
  var value: UInt64 = 0
  var index = to
  while index > from
    invariant from <= index
    invariant index <= to
    invariant value < unit
    decreases index
    cost time O(to - index)
  {
    index -= 1
    let digit: UInt64 = intrinsic::convert(text.byte(index) - 48)
    value = (value + digit * unit) / 10
  }
  value
}

internal type ParsedTerm(nanoseconds: UInt64, end: USize, error: Option[ParseTimeError])

internal fn parse_term(text: StringSlice, from: USize) -> ParsedTerm
  requires from <= text.length()
  ensures from <= result.end
  ensures result.end <= text.length()
  ensures result.error is None ==> result.end > from
  cost time O(result.end - from)
{
  let whole_end = skip_digits(text, from: from)
  let pointed = whole_end < text.length() && text.byte(whole_end) == 46
  let fraction_start = if pointed { whole_end + 1 } else { whole_end }
  let fraction_end = if pointed { skip_digits(text, from: fraction_start) } else { whole_end }
  if whole_end == from && fraction_end == fraction_start {
    return ParsedTerm(nanoseconds: 0, end: fraction_end, error: Some(ParseTimeError.Malformed(offset: from)))
  }
  match parse_unit(text, from: fraction_end) {
    Some(scale) => {
      let fraction = parse_fraction(text, from: fraction_start, to: fraction_end, unit: scale.nanoseconds)
      match parse_integer(text, from: from, to: whole_end) {
        Some(whole) => {
          if whole > (UInt64.maximum - fraction) / scale.nanoseconds {
            ParsedTerm(nanoseconds: 0, end: scale.end, error: Some(ParseTimeError.OutOfRange))
          } else {
            ParsedTerm(nanoseconds: whole * scale.nanoseconds + fraction, end: scale.end, error: None)
          }
        }
        None => ParsedTerm(nanoseconds: 0, end: scale.end, error: Some(ParseTimeError.OutOfRange))
      }
    }
    None => ParsedTerm(nanoseconds: 0, end: fraction_end, error: Some(ParseTimeError.Malformed(offset: fraction_end)))
  }
}

impl text::Parse for Duration {
  type Error = ParseTimeError

  fn parse(text: StringSlice) -> Result[Duration, ParseTimeError]
  {
    if text.length() == 0 {
      return Err(ParseTimeError.Empty)
    }
    let negative = text.byte(0) == 45
    var index: USize = if negative || text.byte(0) == 43 { 1 } else { 0 }
    if index == text.length() {
      return Err(ParseTimeError.Malformed(offset: index))
    }
    if text.length() - index == 1 && text.byte(index) == 48 {
      return Ok(Duration.zero)
    }
    var total: UInt64 = 0
    var failure: Option[ParseTimeError] = None
    while index < text.length()
      invariant index <= text.length()
      decreases text.length() - index
      cost time O(index)
    {
      let term = parse_term(text, from: index)
      if term.error is Some(error) {
        failure = Some(error)
        index = text.length()
      } else if term.nanoseconds > UInt64.maximum - total {
        failure = Some(ParseTimeError.OutOfRange)
        index = text.length()
      } else {
        total += term.nanoseconds
        index = term.end
      }
    }
    if failure is Some(error) {
      return Err(error)
    }
    if negative {
      if total > 9223372036854775808 {
        Err(ParseTimeError.OutOfRange)
      } else if total == 9223372036854775808 {
        Ok(Duration.minimum)
      } else {
        let magnitude: Int64 = intrinsic::convert(total)
        Ok(Duration(nanoseconds: -magnitude))
      }
    } else if total > 9223372036854775807 {
      Err(ParseTimeError.OutOfRange)
    } else {
      Ok(Duration(nanoseconds: intrinsic::convert(total)))
    }
  }
}

public opaque type Instant(nanoseconds: Int64)
  derives Plain, Equal, Hash, Ordered

public let Instant.epoch: Instant = Instant(nanoseconds: 0)

public fn Instant.from_unix_nanoseconds(nanoseconds: Int64) -> Instant
  ensures result.unix_nanoseconds() == nanoseconds
  cost time O(1)
{
  Instant(nanoseconds: nanoseconds)
}

public fn Instant.from_unix_milliseconds(milliseconds: Int64) -> Option[Instant]
  cost time O(1)
{
  Some(Instant(nanoseconds: milliseconds.checked_multiply(1000000)?))
}

public fn Instant.from_unix_seconds(seconds: Int64) -> Option[Instant]
  cost time O(1)
{
  Some(Instant(nanoseconds: seconds.checked_multiply(1000000000)?))
}

public fn Instant.unix_nanoseconds(self) -> Int64
  ensures result == (self.nanoseconds)
  cost time O(1)
{
  self.nanoseconds
}

public fn Instant.unix_milliseconds(self) -> Int64
  cost time O(1)
{
  self.nanoseconds.floor_divide(1000000)
}

public fn Instant.unix_seconds(self) -> Int64
  ensures result == (self.nanoseconds.floor_divide(1000000000))
  cost time O(1)
{
  self.nanoseconds.floor_divide(1000000000)
}

public fn Instant.duration_since(self, earlier: Instant) -> Duration
  cost time O(1)
{
  Duration(nanoseconds: self.nanoseconds.saturating_subtract(earlier.nanoseconds))
}

public fn Instant.checked_add(self, duration: Duration) -> Option[Instant]
  cost time O(1)
{
  Some(Instant(nanoseconds: self.nanoseconds.checked_add(duration.nanoseconds)?))
}

public fn Instant.checked_subtract(self, duration: Duration) -> Option[Instant]
  cost time O(1)
{
  Some(Instant(nanoseconds: self.nanoseconds.checked_subtract(duration.nanoseconds)?))
}

impl Add[Duration] for Instant {
  type Output = Instant

  fn add_is_defined(self, right: Duration) -> Bool
    cost time O(1)
  {
    true
  }

  fn add(self, right: Duration) -> Instant {
    Instant(nanoseconds: self.nanoseconds.saturating_add(right.nanoseconds))
  }
}

impl Subtract[Duration] for Instant {
  type Output = Instant

  fn subtract_is_defined(self, right: Duration) -> Bool
    cost time O(1)
  {
    true
  }

  fn subtract(self, right: Duration) -> Instant {
    Instant(nanoseconds: self.nanoseconds.saturating_subtract(right.nanoseconds))
  }
}

impl Subtract[Instant] for Instant {
  type Output = Duration

  fn subtract_is_defined(self, right: Instant) -> Bool
    cost time O(1)
  {
    true
  }

  fn subtract(self, right: Instant) -> Duration {
    self.duration_since(right)
  }
}

internal fn Instant.date_time(self) -> DateTime
  cost time O(1)
{
  let days = self.nanoseconds.floor_divide(86400000000000)
  let rest = self.nanoseconds.floor_modulo(86400000000000)
  DateTime(
    date: Date(days_since_epoch: intrinsic::convert(days)),
    time: TimeOfDay(nanoseconds_since_midnight: intrinsic::convert(rest)),
  )
}

impl Display for Instant {
  fn display(self, output: mut TextBuilder) {
    self.date_time().display(mut output)
    mut output.write("Z")
  }
}

internal type Number(value: Int64, end: USize)

internal fn parse_number(text: StringSlice, from: USize, most: USize) -> Result[Number, ParseTimeError]
  requires from <= text.length()
  requires most <= 9
  ensures !(result is Ok(number) && (number.end <= from || number.end > text.length() || number.end - from > most))
  ensures !(result is Ok(number) && (number.value < 0 || number.value > 999999999))
  cost time O(1)
{
  var value: Int64 = 0
  var index = from
  while index < text.length() && index - from < most && text.byte(index) >= 48 && text.byte(index) <= 57
    invariant from <= index
    invariant index <= text.length()
    invariant index - from <= most
    invariant 0 <= value
    invariant index - from <= 0 ==> value < 1
    invariant index - from <= 1 ==> value < 10
    invariant index - from <= 2 ==> value < 100
    invariant index - from <= 3 ==> value < 1000
    invariant index - from <= 4 ==> value < 10000
    invariant index - from <= 5 ==> value < 100000
    invariant index - from <= 6 ==> value < 1000000
    invariant index - from <= 7 ==> value < 10000000
    invariant index - from <= 8 ==> value < 100000000
    invariant index - from <= 9 ==> value < 1000000000
    decreases from + most - index
  {
    value = value * 10 + intrinsic::convert[UInt8, Int64](text.byte(index) - 48)
    index += 1
  }
  if index == from {
    return Err(ParseTimeError.Malformed(offset: from))
  }
  Ok(Number(value: value, end: index))
}

internal fn parse_field(text: StringSlice, from: USize, width: USize) -> Result[Int64, ParseTimeError]
  requires from <= text.length()
  requires 1 <= width && width <= 9
  ensures !(result is Ok(value) && (value < 0 || value > 999999999 || width > text.length() - from))
  cost time O(1)
{
  let number = parse_number(text, from: from, most: width)?
  if number.end - from != width {
    return Err(ParseTimeError.Malformed(offset: number.end))
  }
  Ok(number.value)
}

internal fn expect_byte(text: StringSlice, at: USize, byte: UInt8) -> Result[USize, ParseTimeError]
  requires at <= text.length()
  ensures !(result is Ok(next) && (next != at + 1 || next > text.length()))
  cost time O(1)
{
  if at < text.length() && text.byte(at) == byte {
    Ok(at + 1)
  } else {
    Err(ParseTimeError.Malformed(offset: at))
  }
}

internal type ParsedDate(date: Date, end: USize)

internal fn parse_iso_date(text: StringSlice, from: USize) -> Result[ParsedDate, ParseTimeError]
  requires from <= text.length()
  ensures !(result is Ok(read) && (read.end <= from || read.end > text.length()))
  cost time O(1)
{
  let negative = from < text.length() && text.byte(from) == 45
  let start = if negative { from + 1 } else { from }
  let year = parse_number(text, from: start, most: 7)?
  if year.end - start < 4 {
    return Err(ParseTimeError.Malformed(offset: year.end))
  }
  let month_start = expect_byte(text, at: year.end, byte: 45)?
  let month = parse_field(text, from: month_start, width: 2)?
  let day_start = expect_byte(text, at: month_start + 2, byte: 45)?
  let day = parse_field(text, from: day_start, width: 2)?
  let signed_year = if negative { -year.value } else { year.value }
  if signed_year <= -5900000 || signed_year >= 5900000 || month < 1 || month > 12 || day < 1 {
    return Err(ParseTimeError.OutOfRange)
  }
  if day > days_in_month(month, leap: is_leap(signed_year)) {
    return Err(ParseTimeError.OutOfRange)
  }
  match checked_date(signed_year, month: month, day: day) {
    Some(date) => Ok(ParsedDate(date: date, end: day_start + 2))
    None => Err(ParseTimeError.OutOfRange)
  }
}

internal fn power_of_ten(digits: USize) -> Int64
  requires 1 <= digits && digits <= 9
  ensures 1 <= result && result <= 100000000
  cost time O(1)
{
  if digits == 1 {
    100000000
  } else if digits == 2 {
    10000000
  } else if digits == 3 {
    1000000
  } else if digits == 4 {
    100000
  } else if digits == 5 {
    10000
  } else if digits == 6 {
    1000
  } else if digits == 7 {
    100
  } else if digits == 8 {
    10
  } else {
    1
  }
}

internal type ParsedTime(time: TimeOfDay, end: USize)

internal fn parse_iso_time(text: StringSlice, from: USize) -> Result[ParsedTime, ParseTimeError]
  requires from <= text.length()
  ensures !(result is Ok(read) && (read.end <= from || read.end > text.length()))
  cost time O(1)
{
  let hour = parse_field(text, from: from, width: 2)?
  let minute_start = expect_byte(text, at: from + 2, byte: 58)?
  let minute = parse_field(text, from: minute_start, width: 2)?
  var end = minute_start + 2
  var second: Int64 = 0
  var nanosecond: Int64 = 0
  if end < text.length() && text.byte(end) == 58 {
    second = parse_field(text, from: end + 1, width: 2)?
    end = end + 3
    if end < text.length() && text.byte(end) == 46 {
      let fraction = parse_number(text, from: end + 1, most: 9)?
      nanosecond = fraction.value * power_of_ten(fraction.end - (end + 1))
      end = fraction.end
    }
  }
  if hour > 23 || minute > 59 || second > 59 || nanosecond > 999999999 {
    return Err(ParseTimeError.OutOfRange)
  }
  match TimeOfDay.new(
    intrinsic::convert(hour),
    minute: intrinsic::convert(minute),
    second: intrinsic::convert(second),
    nanosecond: intrinsic::convert(nanosecond),
  ) {
    Some(time) => Ok(ParsedTime(time: time, end: end))
    None => Err(ParseTimeError.OutOfRange)
  }
}

internal type ParsedDateTime(date_time: DateTime, end: USize)

internal fn parse_iso_date_time(text: StringSlice, from: USize) -> Result[ParsedDateTime, ParseTimeError]
  requires from <= text.length()
  ensures !(result is Ok(read) && (read.end <= from || read.end > text.length()))
  cost time O(1)
{
  let date = parse_iso_date(text, from: from)?
  let time = parse_iso_time(text, from: expect_byte(text, at: date.end, byte: 84)?)?
  Ok(ParsedDateTime(date_time: DateTime(date: date.date, time: time.time), end: time.end))
}

internal fn parse_iso_offset(text: StringSlice, from: USize) -> Result[Int64, ParseTimeError]
  requires from <= text.length()
  ensures !(result is Ok(seconds) && (seconds <= -86400 || seconds >= 86400))
  cost time O(1)
{
  if from == text.length() {
    return Err(ParseTimeError.Malformed(offset: from))
  }
  let sign = text.byte(from)
  if sign == 90 || sign == 122 {
    if from + 1 != text.length() {
      return Err(ParseTimeError.Malformed(offset: from + 1))
    }
    return Ok(0)
  }
  if sign != 43 && sign != 45 {
    return Err(ParseTimeError.Malformed(offset: from))
  }
  let hours = parse_field(text, from: from + 1, width: 2)?
  let minutes_start = expect_byte(text, at: from + 3, byte: 58)?
  let minutes = parse_field(text, from: minutes_start, width: 2)?
  if minutes_start + 2 != text.length() {
    return Err(ParseTimeError.Malformed(offset: minutes_start + 2))
  }
  if hours > 23 || minutes > 59 {
    return Err(ParseTimeError.OutOfRange)
  }
  let seconds = hours * 3600 + minutes * 60
  Ok(if sign == 45 { -seconds } else { seconds })
}

internal fn DateTime.instant(self, offset_seconds: Int64) -> Option[Instant]
  requires -86400 < offset_seconds && offset_seconds < 86400
  cost time O(1)
{
  let days: Int64 = intrinsic::convert(self.date.days_since_epoch)
  let nanoseconds_of_day: Int64 = intrinsic::convert(self.time.nanoseconds_since_midnight)
  let near: Int64 = if days < -2 { -2 } else if days > 2 { 2 } else { days }
  let whole = (days - near).checked_multiply(86400000000000)?
  Some(Instant(nanoseconds: whole.checked_add(near * 86400000000000 + nanoseconds_of_day - offset_seconds * 1000000000)?))
}

internal fn write_fraction(output: mut TextBuilder, value: UInt64, digits: USize)
  cost time finite
{
  let padded = value.format(minimum_digits: digits)
  let text = padded.slice()
  var end = text.length()
  while end > 0 && text.byte(end - 1) == 48
    invariant end <= text.length()
    decreases end
  {
    end -= 1
  }
  mut output.write(text.part(0, to: end))
}

impl text::Parse for Instant {
  type Error = ParseTimeError

  fn parse(text: StringSlice) -> Result[Instant, ParseTimeError]
  {
    if text.length() == 0 {
      return Err(ParseTimeError.Empty)
    }
    let read = parse_iso_date_time(text, from: 0)?
    let offset = parse_iso_offset(text, from: read.end)?
    match read.date_time.instant(offset) {
      Some(instant) => Ok(instant)
      None => Err(ParseTimeError.OutOfRange)
    }
  }
}

public type ParseTimeError =
  | Empty
  | Malformed(offset: USize)
  | OutOfRange
  derives Equal

impl Display for ParseTimeError {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Empty => mut output.write("the text is empty")
      Malformed(offset) => {
        mut output.write("the text is not a time at offset ")
        offset.display(mut output)
      }
      OutOfRange => mut output.write("the time is outside the range the type holds")
    }
  }
}

public type Month =
  | January
  | February
  | March
  | April
  | May
  | June
  | July
  | August
  | September
  | October
  | November
  | December
  derives Equal, Hash, Ordered

public fn Month.number(self) -> UInt8
  ensures 1 <= result && result <= 12
  cost time O(1)
{
  match self {
    January => 1
    February => 2
    March => 3
    April => 4
    May => 5
    June => 6
    July => 7
    August => 8
    September => 9
    October => 10
    November => 11
    December => 12
  }
}

public fn Month.from_number(number: UInt8) -> Option[Month]
  ensures (result is Some(_)) == (1 <= number && number <= 12)
  cost time O(1)
{
  if number == 1 {
    Some(Month.January)
  } else if number == 2 {
    Some(Month.February)
  } else if number == 3 {
    Some(Month.March)
  } else if number == 4 {
    Some(Month.April)
  } else if number == 5 {
    Some(Month.May)
  } else if number == 6 {
    Some(Month.June)
  } else if number == 7 {
    Some(Month.July)
  } else if number == 8 {
    Some(Month.August)
  } else if number == 9 {
    Some(Month.September)
  } else if number == 10 {
    Some(Month.October)
  } else if number == 11 {
    Some(Month.November)
  } else if number == 12 {
    Some(Month.December)
  } else {
    None
  }
}

public fn Month.days(self, leap_year: Bool) -> UInt8
  ensures 28 <= result && result <= 31
  cost time O(1)
{
  match self {
    January => 31
    February => if leap_year { 29 } else { 28 }
    March => 31
    April => 30
    May => 31
    June => 30
    July => 31
    August => 31
    September => 30
    October => 31
    November => 30
    December => 31
  }
}

impl Display for Month {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      January => mut output.write("January")
      February => mut output.write("February")
      March => mut output.write("March")
      April => mut output.write("April")
      May => mut output.write("May")
      June => mut output.write("June")
      July => mut output.write("July")
      August => mut output.write("August")
      September => mut output.write("September")
      October => mut output.write("October")
      November => mut output.write("November")
      December => mut output.write("December")
    }
  }
}

public type Weekday = Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday
  derives Equal, Hash, Ordered

public fn Weekday.number_from_monday(self) -> UInt8
  ensures 1 <= result && result <= 7
  cost time O(1)
{
  match self {
    Monday => 1
    Tuesday => 2
    Wednesday => 3
    Thursday => 4
    Friday => 5
    Saturday => 6
    Sunday => 7
  }
}

public fn Weekday.is_weekend(self) -> Bool
  ensures result == (self is Saturday | Sunday)
  cost time O(1)
{
  self is Saturday | Sunday
}

impl Display for Weekday {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Monday => mut output.write("Monday")
      Tuesday => mut output.write("Tuesday")
      Wednesday => mut output.write("Wednesday")
      Thursday => mut output.write("Thursday")
      Friday => mut output.write("Friday")
      Saturday => mut output.write("Saturday")
      Sunday => mut output.write("Sunday")
    }
  }
}

public opaque type Date(days_since_epoch: Int32)
  derives Plain, Equal, Hash, Ordered

internal type Civil(year: Int64, month: Int64, day: Int64)

internal fn is_leap(year: Int64) -> Bool
  cost time O(1)
{
  (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

internal fn days_in_month(month: Int64, leap: Bool) -> Int64
  requires 1 <= month && month <= 12
  ensures 28 <= result && result <= 31
  cost time O(1)
{
  if month == 2 {
    if leap { 29 } else { 28 }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

internal fn month_from_number(number: Int64) -> Month
  requires 1 <= number && number <= 12
  cost time O(1)
{
  if number == 1 {
    Month.January
  } else if number == 2 {
    Month.February
  } else if number == 3 {
    Month.March
  } else if number == 4 {
    Month.April
  } else if number == 5 {
    Month.May
  } else if number == 6 {
    Month.June
  } else if number == 7 {
    Month.July
  } else if number == 8 {
    Month.August
  } else if number == 9 {
    Month.September
  } else if number == 10 {
    Month.October
  } else if number == 11 {
    Month.November
  } else {
    Month.December
  }
}

internal fn weekday_from_number(number: Int64) -> Weekday
  requires 1 <= number && number <= 7
  cost time O(1)
{
  if number == 1 {
    Weekday.Monday
  } else if number == 2 {
    Weekday.Tuesday
  } else if number == 3 {
    Weekday.Wednesday
  } else if number == 4 {
    Weekday.Thursday
  } else if number == 5 {
    Weekday.Friday
  } else if number == 6 {
    Weekday.Saturday
  } else {
    Weekday.Sunday
  }
}

internal fn march_month(day_of_year: Int64) -> Int64
  requires 0 <= day_of_year && day_of_year <= 365
  ensures 0 <= result && result <= 11
  ensures result == (if day_of_year < 31 {
      0
    } else if day_of_year < 61 {
      1
    } else if day_of_year < 92 {
      2
    } else if day_of_year < 122 {
      3
    } else if day_of_year < 153 {
      4
    } else if day_of_year < 184 {
      5
    } else if day_of_year < 214 {
      6
    } else if day_of_year < 245 {
      7
    } else if day_of_year < 275 {
      8
    } else if day_of_year < 306 {
      9
    } else if day_of_year < 337 {
      10
    } else {
      11
    })
  cost time O(1)
{
  if day_of_year < 31 {
    0
  } else if day_of_year < 61 {
    1
  } else if day_of_year < 92 {
    2
  } else if day_of_year < 122 {
    3
  } else if day_of_year < 153 {
    4
  } else if day_of_year < 184 {
    5
  } else if day_of_year < 214 {
    6
  } else if day_of_year < 245 {
    7
  } else if day_of_year < 275 {
    8
  } else if day_of_year < 306 {
    9
  } else if day_of_year < 337 {
    10
  } else {
    11
  }
}

internal fn march_start(month: Int64) -> Int64
  requires 0 <= month && month <= 11
  ensures 0 <= result && result <= 337
  ensures result == (if month == 0 {
      0
    } else if month == 1 {
      31
    } else if month == 2 {
      61
    } else if month == 3 {
      92
    } else if month == 4 {
      122
    } else if month == 5 {
      153
    } else if month == 6 {
      184
    } else if month == 7 {
      214
    } else if month == 8 {
      245
    } else if month == 9 {
      275
    } else if month == 10 {
      306
    } else {
      337
    })
  cost time O(1)
{
  if month == 0 {
    0
  } else if month == 1 {
    31
  } else if month == 2 {
    61
  } else if month == 3 {
    92
  } else if month == 4 {
    122
  } else if month == 5 {
    153
  } else if month == 6 {
    184
  } else if month == 7 {
    214
  } else if month == 8 {
    245
  } else if month == 9 {
    275
  } else if month == 10 {
    306
  } else {
    337
  }
}

internal fn january_start(month: Int64) -> Int64
  requires 1 <= month && month <= 12
  ensures 0 <= result && result <= 334
  cost time O(1)
{
  if month == 1 {
    0
  } else if month == 2 {
    31
  } else if month == 3 {
    59
  } else if month == 4 {
    90
  } else if month == 5 {
    120
  } else if month == 6 {
    151
  } else if month == 7 {
    181
  } else if month == 8 {
    212
  } else if month == 9 {
    243
  } else if month == 10 {
    273
  } else if month == 11 {
    304
  } else {
    334
  }
}

internal fn min_of(first: Int64, second: Int64) -> Int64
  ensures result <= first && result <= second
  ensures result == first || result == second
  cost time O(1)
{
  if first < second { first } else { second }
}

internal fn civil_from_days(days: Int64) -> Civil
  requires -2147483648 <= days && days <= 2147483647
  ensures 1 <= result.month && result.month <= 12
  ensures 1 <= result.day && result.day <= 31
  ensures -5900000 < result.year && result.year < 5900000
  cost time O(1)
{
  let shifted = days + 719468
  let era = shifted.floor_divide(146097)
  let day_of_era = shifted - era * 146097
  let centuries = min_of(day_of_era / 36524, second: 3)
  let in_century = day_of_era - centuries * 36524
  let fours = min_of(in_century / 1461, second: 24)
  let in_four = in_century - fours * 1461
  let ones = min_of(in_four / 365, second: 3)
  let day_of_year = in_four - ones * 365
  let year_of_era = centuries * 100 + fours * 4 + ones
  let from_march = march_month(day_of_year)
  let day = day_of_year - march_start(from_march) + 1
  let month = if from_march < 10 { from_march + 3 } else { from_march - 9 }
  let year = year_of_era + era * 400 + (if month <= 2 { 1 } else { 0 })
  Civil(year: year, month: month, day: day)
}

internal fn days_from_civil(year: Int64, month: Int64, day: Int64) -> Int64
  requires -6000000 < year && year < 6000000
  requires 1 <= month && month <= 12
  requires 1 <= day && day <= 31
  ensures -2200000000 < result && result < 2200000000
  cost time O(1)
{
  let from_march = if month > 2 { month - 3 } else { month + 9 }
  let shifted_year = if month > 2 { year } else { year - 1 }
  let era = shifted_year.floor_divide(400)
  let year_of_era = shifted_year - era * 400
  let day_of_year = march_start(from_march) + day - 1
  let day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
  era * 146097 + day_of_era - 719468
}

internal fn checked_date(year: Int64, month: Int64, day: Int64) -> Option[Date]
  requires -6000000 < year && year < 6000000
  requires 1 <= month && month <= 12
  requires 1 <= day && day <= 31
  cost time O(1)
{
  let days = days_from_civil(year, month: month, day: day)
  if days < -2147483648 || days > 2147483647 {
    None
  } else {
    Some(Date(days_since_epoch: intrinsic::convert(days)))
  }
}

internal fn Date.civil(self) -> Civil
  ensures 1 <= result.month && result.month <= 12
  ensures 1 <= result.day && result.day <= 31
  ensures -5900000 < result.year && result.year < 5900000
  cost time O(1)
{
  civil_from_days(intrinsic::convert(self.days_since_epoch))
}

internal fn Date.weekday_number(self) -> Int64
  ensures 1 <= result && result <= 7
  cost time O(1)
{
  let days: Int64 = intrinsic::convert(self.days_since_epoch)
  (days + 3).floor_modulo(7) + 1
}

internal fn ordinal_day(civil: Civil) -> Int64
  requires 1 <= civil.month && civil.month <= 12
  requires 1 <= civil.day && civil.day <= 31
  ensures 1 <= result && result <= 366
  cost time O(1)
{
  let leap_day: Int64 = if civil.month > 2 && is_leap(civil.year) { 1 } else { 0 }
  january_start(civil.month) + leap_day + civil.day
}

internal fn Date.plus_months_wide(self, months: Int64) -> Option[Date]
  requires -30000000000 < months && months < 30000000000
  cost time O(1)
{
  let civil = self.civil()
  let total = civil.year * 12 + civil.month - 1 + months
  let year = total.floor_divide(12)
  let month = total - year * 12 + 1
  if year <= -5900000 || year >= 5900000 {
    return None
  }
  checked_date(year, month: month, day: min_of(civil.day, second: days_in_month(month, leap: is_leap(year))))
}

internal fn weeks_in_year(year: Int64) -> Int64
  requires -6000000 < year && year < 6000000
  ensures result == 52 || result == 53
  cost time O(1)
{
  let previous = year - 1
  let this_year = (year + year.floor_divide(4) - year.floor_divide(100) + year.floor_divide(400)).floor_modulo(7)
  let last_year =
    (previous + previous.floor_divide(4) - previous.floor_divide(100) + previous.floor_divide(400)).floor_modulo(7)
  if this_year == 4 || last_year == 3 { 53 } else { 52 }
}

internal fn iso_week(ordinal: Int64, weekday: Int64, year: Int64) -> Int64
  requires 1 <= ordinal && ordinal <= 366
  requires 1 <= weekday && weekday <= 7
  requires -5900000 < year && year < 5900000
  ensures 1 <= result && result <= 53
  cost time O(1)
{
  var week = (ordinal - weekday + 10) / 7
  if week == 0 {
    week = weeks_in_year(year - 1)
  } else if week == 53 && weeks_in_year(year) == 52 {
    week = 1
  }
  week
}

internal fn write_two_digits(output: mut TextBuilder, value: Int64)
  requires 0 <= value && value <= 99
  cost time finite
{
  if value < 10 {
    mut output.write("0")
  }
  value.display(mut output)
}

public fn Date.new(year: Int32, month: UInt8, day: UInt8) -> Option[Date]
  cost time O(1)
{
  if month < 1 || month > 12 || day < 1 {
    return None
  }
  let wide_year: Int64 = intrinsic::convert(year)
  let wide_month: Int64 = intrinsic::convert(month)
  let wide_day: Int64 = intrinsic::convert(day)
  if wide_year <= -5900000 || wide_year >= 5900000 || wide_day > days_in_month(wide_month, leap: is_leap(wide_year)) {
    return None
  }
  checked_date(wide_year, month: wide_month, day: wide_day)
}

public fn Date.from_day_of_year(year: Int32, day_of_year: UInt16) -> Option[Date]
  cost time O(1)
{
  let wide_year: Int64 = intrinsic::convert(year)
  let ordinal: Int64 = intrinsic::convert(day_of_year)
  let length: Int64 = if is_leap(wide_year) { 366 } else { 365 }
  if wide_year <= -5900000 || wide_year >= 5900000 || ordinal < 1 || ordinal > length {
    return None
  }
  let days = days_from_civil(wide_year, month: 1, day: 1) + ordinal - 1
  if days < -2147483648 || days > 2147483647 {
    None
  } else {
    Some(Date(days_since_epoch: intrinsic::convert(days)))
  }
}

public fn Date.is_leap_year(year: Int32) -> Bool
  ensures result == ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0)
  cost time O(1)
{
  (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
}

public fn Date.year(self) -> Int32
  cost time O(1)
{
  intrinsic::convert(self.civil().year)
}

public fn Date.month(self) -> Month
  cost time O(1)
{
  month_from_number(self.civil().month)
}

public fn Date.day(self) -> UInt8
  ensures 1 <= result && result <= 31
  cost time O(1)
{
  intrinsic::convert(self.civil().day)
}

public fn Date.weekday(self) -> Weekday
  cost time O(1)
{
  weekday_from_number(self.weekday_number())
}

public fn Date.day_of_year(self) -> UInt16
  ensures 1 <= result && result <= 366
  cost time O(1)
{
  intrinsic::convert(ordinal_day(self.civil()))
}

public fn Date.week_of_year(self) -> UInt8
  ensures 1 <= result && result <= 53
  cost time O(1)
{
  let civil = self.civil()
  intrinsic::convert(iso_week(ordinal_day(civil), weekday: self.weekday_number(), year: civil.year))
}

public fn Date.plus_days(self, days: Int32) -> Option[Date]
  cost time O(1)
{
  Some(Date(days_since_epoch: self.days_since_epoch.checked_add(days)?))
}

public fn Date.plus_months(self, months: Int32) -> Option[Date]
  cost time O(1)
{
  self.plus_months_wide(intrinsic::convert(months))
}

public fn Date.plus_years(self, years: Int32) -> Option[Date]
  cost time O(1)
{
  let wide: Int64 = intrinsic::convert(years)
  self.plus_months_wide(wide * 12)
}

public fn Date.days_until(self, other: Date) -> Int64
  cost time O(1)
{
  let from: Int64 = intrinsic::convert(self.days_since_epoch)
  let to: Int64 = intrinsic::convert(other.days_since_epoch)
  to - from
}

public fn Date.at(self, time: TimeOfDay) -> DateTime
  ensures identical(result, DateTime(date: self, time: time))
  cost time O(1)
{
  DateTime(date: self, time: time)
}

impl Display for Date {
  fn display(self, output: mut TextBuilder)
  {
    let civil = self.civil()
    mut output.write(civil.year.format(minimum_digits: 4))
    mut output.write("-")
    write_two_digits(mut output, value: civil.month)
    mut output.write("-")
    write_two_digits(mut output, value: civil.day)
  }
}

impl text::Parse for Date {
  type Error = ParseTimeError

  fn parse(text: StringSlice) -> Result[Date, ParseTimeError]
  {
    if text.length() == 0 {
      return Err(ParseTimeError.Empty)
    }
    let read = parse_iso_date(text, from: 0)?
    if read.end != text.length() {
      return Err(ParseTimeError.Malformed(offset: read.end))
    }
    Ok(read.date)
  }
}

impl core::Countable for Date {
  fn successor(self) -> Option[Date]
    cost time O(1)
  {
    self.plus_days(1)
  }

  fn predecessor(self) -> Option[Date]
    cost time O(1)
  {
    self.plus_days(-1)
  }

  fn advanced(self, by: USize) -> Option[Date]
    cost time O(1)
  {
    match self.days_since_epoch.advanced(by: by) {
      Some(days) => Some(Date(days_since_epoch: days))
      None => None
    }
  }

  fn retreated(self, by: USize) -> Option[Date]
    cost time O(1)
  {
    match self.days_since_epoch.retreated(by: by) {
      Some(days) => Some(Date(days_since_epoch: days))
      None => None
    }
  }

  fn steps_to(self, other: Date) -> Option[USize]
    cost time O(1)
  {
    self.days_since_epoch.steps_to(other.days_since_epoch)
  }
}

public opaque type TimeOfDay(nanoseconds_since_midnight: UInt64)
  derives Plain, Equal, Hash, Ordered
  invariant nanoseconds_since_midnight < 86400000000000

public let TimeOfDay.midnight: TimeOfDay = TimeOfDay(nanoseconds_since_midnight: 0)

public let TimeOfDay.noon: TimeOfDay = TimeOfDay(nanoseconds_since_midnight: 43200000000000)

public fn TimeOfDay.new(hour: UInt8, minute: UInt8, second: UInt8 = 0, nanosecond: UInt32 = 0) -> Option[TimeOfDay]
  cost time O(1)
{
  if hour >= 24 || minute >= 60 || second >= 60 || nanosecond >= 1000000000 {
    return None
  }
  let hours: UInt64 = intrinsic::convert(hour)
  let minutes: UInt64 = intrinsic::convert(minute)
  let seconds: UInt64 = intrinsic::convert(second)
  let nanoseconds: UInt64 = intrinsic::convert(nanosecond)
  Some(TimeOfDay(nanoseconds_since_midnight: ((hours * 60 + minutes) * 60 + seconds) * 1000000000 + nanoseconds))
}

public fn TimeOfDay.hour(self) -> UInt8
  ensures result < 24
  cost time O(1)
{
  intrinsic::convert(self.nanoseconds_since_midnight / 3600000000000 % 24)
}

public fn TimeOfDay.minute(self) -> UInt8
  ensures result < 60
  cost time O(1)
{
  intrinsic::convert(self.nanoseconds_since_midnight / 60000000000 % 60)
}

public fn TimeOfDay.second(self) -> UInt8
  ensures result < 60
  cost time O(1)
{
  intrinsic::convert(self.nanoseconds_since_midnight / 1000000000 % 60)
}

public fn TimeOfDay.nanosecond(self) -> UInt32
  ensures result < 1000000000
  cost time O(1)
{
  intrinsic::convert(self.nanoseconds_since_midnight % 1000000000)
}

public fn TimeOfDay.since_midnight(self) -> Duration
  cost time O(1)
{
  Duration(nanoseconds: intrinsic::convert(self.nanoseconds_since_midnight))
}

impl Display for TimeOfDay {
  fn display(self, output: mut TextBuilder)
  {
    write_two_digits(mut output, value: intrinsic::convert(self.hour()))
    mut output.write(":")
    write_two_digits(mut output, value: intrinsic::convert(self.minute()))
    mut output.write(":")
    write_two_digits(mut output, value: intrinsic::convert(self.second()))
    let nanosecond = self.nanosecond()
    if nanosecond != 0 {
      mut output.write(".")
      write_fraction(mut output, value: intrinsic::convert(nanosecond), digits: 9)
    }
  }
}

impl text::Parse for TimeOfDay {
  type Error = ParseTimeError

  fn parse(text: StringSlice) -> Result[TimeOfDay, ParseTimeError]
  {
    if text.length() == 0 {
      return Err(ParseTimeError.Empty)
    }
    let read = parse_iso_time(text, from: 0)?
    if read.end != text.length() {
      return Err(ParseTimeError.Malformed(offset: read.end))
    }
    Ok(read.time)
  }
}

public type DateTime(date: Date, time: TimeOfDay)
  derives Equal, Hash, Ordered

public fn DateTime.plus(self, duration: Duration) -> Option[DateTime]
  cost time O(1)
{
  let days = duration.nanoseconds.floor_divide(86400000000000)
  let rest = duration.nanoseconds.floor_modulo(86400000000000)
  let nanoseconds_of_day: Int64 = intrinsic::convert(self.time.nanoseconds_since_midnight)
  let total = nanoseconds_of_day + rest
  let carried: Int64 = if total >= 86400000000000 { 1 } else { 0 }
  let date = self.date.plus_days(intrinsic::convert(days + carried))?
  Some(DateTime(
    date: date,
    time: TimeOfDay(nanoseconds_since_midnight: intrinsic::convert(total - carried * 86400000000000)),
  ))
}

impl Display for DateTime {
  fn display(self, output: mut TextBuilder)
  {
    self.date.display(mut output)
    mut output.write("T")
    self.time.display(mut output)
  }
}

impl text::Parse for DateTime {
  type Error = ParseTimeError

  fn parse(text: StringSlice) -> Result[DateTime, ParseTimeError]
  {
    if text.length() == 0 {
      return Err(ParseTimeError.Empty)
    }
    let read = parse_iso_date_time(text, from: 0)?
    if read.end != text.length() {
      return Err(ParseTimeError.Malformed(offset: read.end))
    }
    Ok(read.date_time)
  }
}

public type LocalInstant =
  | Unique(instant: Instant)
  | Ambiguous(earlier: Instant, later: Instant)
  | Skipped(before: Instant, after: Instant)
  derives Equal

type RuleDay(by_weekday: Bool, counts_leap_day: Bool, month: Int64, week: Int64, day: Int64)
  invariant 1 <= month && month <= 12
  invariant 1 <= week && week <= 5
  invariant 0 <= day && day <= 365

type DaylightRule(offset: Int64, start: RuleDay, start_time: Int64, end: RuleDay, end_time: Int64)
  invariant -1000000 < offset && offset < 1000000
  invariant -1000000 < start_time && start_time < 1000000
  invariant -1000000 < end_time && end_time < 1000000

type ZoneRule(standard: Int64, daylight: Option[DaylightRule])
  invariant -1000000 < standard && standard < 1000000

public opaque type TimeZone(
  name: String,
  transitions: List[Int64],
  offsets: List[Int32],
  first_offset: Int32,
  rule: Option[ZoneRule],
)
  invariant offsets.length() == transitions.length()
  derives Copyable

fn RuleDay.days(self, year: Int64) -> Int64
  requires -6000000 < year && year < 6000000
  ensures -2200001000 < result && result < 2200001000
  cost time O(1)
{
  if !self.by_weekday {
    let leap_day: Int64 = if !self.counts_leap_day && self.day >= 60 && is_leap(year) { 1 } else { 0 }
    let from_one: Int64 = if self.counts_leap_day { 0 } else { 1 }
    return days_from_civil(year, month: 1, day: 1) + self.day - from_one + leap_day
  }
  let first = days_from_civil(year, month: self.month, day: 1)
  let weekday_of_first = (first + 4).floor_modulo(7)
  let to_weekday = (self.day - weekday_of_first).floor_modulo(7)
  let length = days_in_month(self.month, leap: is_leap(year))
  let wanted = to_weekday + 7 * (self.week - 1)
  first + (if wanted >= length { wanted - 7 } else { wanted })
}

fn ZoneRule.offset_at(self, seconds: Int64) -> Int64
  requires -100000000000 < seconds && seconds < 100000000000
  ensures -1000000 < result && result < 1000000
  cost time O(1)
{
  match self.daylight {
    None => self.standard
    Some(daylight) => {
      let year = civil_from_days((seconds + self.standard).floor_divide(86400)).year
      let start = daylight.start.days(year) * 86400 + daylight.start_time - self.standard
      let end = daylight.end.days(year) * 86400 + daylight.end_time - daylight.offset
      let in_daylight = if start < end {
        start <= seconds && seconds < end
      } else {
        !(end <= seconds && seconds < start)
      }
      if in_daylight { daylight.offset } else { self.standard }
    }
  }
}

fn transitions_at_or_before(transitions: Slice[Int64], seconds: Int64) -> USize
  ensures result <= transitions.length()
  cost time O(log(transitions.length()))
{
  var low: USize = 0
  var high = transitions.length()
  while low < high
    invariant low <= high
    invariant high <= transitions.length()
    decreases high - low
    cost time O(log(transitions.length()) - log(high - low))
  {
    let middle = low + (high - low) / 2
    if transitions[middle] <= seconds {
      low = middle + 1
    } else {
      high = middle
    }
  }
  low
}

fn TimeZone.offset_seconds(self, seconds: Int64) -> Int64
  requires -100000000000 < seconds && seconds < 100000000000
  ensures -2147483649 < result && result < 2147483648
  cost time O(log(self.transitions.length()))
{
  let passed = transitions_at_or_before(self.transitions.slice(), seconds: seconds)
  if passed == self.transitions.length() && self.rule is Some(rule) {
    return rule.offset_at(seconds)
  }
  if passed == 0 {
    return intrinsic::convert(self.first_offset)
  }
  intrinsic::convert(self.offsets[passed - 1])
}

public fn TimeZone.utc() -> TimeZone
  cost time O(1)
{
  TimeZone(name: "UTC", transitions: [], offsets: [], first_offset: 0, rule: None)
}

fn write_offset(output: mut TextBuilder, seconds: Int64)
  requires -360000 < seconds && seconds < 360000
  cost time finite
{
  if seconds == 0 {
    mut output.write("Z")
    return
  }
  if seconds < 0 {
    mut output.write("-")
  } else {
    mut output.write("+")
  }
  let size = if seconds < 0 { -seconds } else { seconds }
  write_two_digits(mut output, value: size / 3600)
  mut output.write(":")
  write_two_digits(mut output, value: (size % 3600) / 60)
  if size % 60 != 0 {
    mut output.write(":")
    write_two_digits(mut output, value: size % 60)
  }
}

public fn TimeZone.fixed(offset: Duration) -> Option[TimeZone]
  cost time finite
{
  let nanoseconds = offset.nanoseconds
  if nanoseconds % 1000000000 != 0 || nanoseconds <= -86400000000000 || nanoseconds >= 86400000000000 {
    return None
  }
  let seconds = nanoseconds / 1000000000
  var name = TextBuilder.new()
  write_offset(mut name, seconds: seconds)
  Some(TimeZone(
    name: own name.finish(),
    transitions: [],
    offsets: [],
    first_offset: intrinsic::convert(seconds),
    rule: None,
  ))
}

type ZoneHeader(version: UInt8, time_count: USize, type_count: USize, block: USize)

fn big_endian(bytes: Slice[UInt8], at: USize, width: USize) -> Option[UInt64]
  requires 1 <= width && width <= 8
  cost time O(1)
{
  if at > bytes.length() || bytes.length() - at < width {
    return None
  }
  var value: UInt64 = 0
  var index: USize = 0
  while index < width
    invariant index <= width
    decreases width - index
    cost time O(index)
  {
    value = (value << 8) | intrinsic::convert[UInt8, UInt64](bytes[at + index])
    index += 1
  }
  Some(value)
}

fn count_at(bytes: Slice[UInt8], at: USize) -> Option[USize]
  ensures !(result is Some(count) && count > 4294967295)
  cost time O(1)
{
  let value = big_endian(bytes, at: at, width: 4)?
  Some(intrinsic::convert(value % 4294967296))
}

fn read_header(bytes: Slice[UInt8], at: USize, time_width: USize) -> Option[ZoneHeader]
  requires at <= 1099511627776
  requires time_width == 4 || time_width == 8
  ensures !(result is Some(header) && (header.time_count > 4294967295 || header.type_count > 4294967295
    || header.block > 1000000000000))
  cost time O(1)
{
  if at > bytes.length() || bytes.length() - at < 44 {
    return None
  }
  if bytes[at] != 84 || bytes[at + 1] != 90 || bytes[at + 2] != 105 || bytes[at + 3] != 102 {
    return None
  }
  let utc_count = count_at(bytes, at: at + 20)?
  let standard_count = count_at(bytes, at: at + 24)?
  let leap_count = count_at(bytes, at: at + 28)?
  let time_count = count_at(bytes, at: at + 32)?
  let type_count = count_at(bytes, at: at + 36)?
  let character_count = count_at(bytes, at: at + 40)?
  Some(ZoneHeader(
    version: bytes[at + 4],
    time_count: time_count,
    type_count: type_count,
    block: time_count * time_width + time_count + type_count * 6 + character_count
      + leap_count * (time_width + 4) + standard_count + utc_count,
  ))
}

type ParsedNumber(value: Int64, end: USize)

fn posix_number(bytes: Slice[UInt8], from: USize, to: USize, most: Int64) -> Option[ParsedNumber]
  requires from <= to
  requires to <= bytes.length()
  requires 0 <= most && most <= 100000
  ensures !(result is Some(number) && (number.value < 0 || number.value > most || number.end <= from || number.end > to))
  cost time finite
{
  var value: Int64 = 0
  var index = from
  while index < to && 48 <= bytes[index] && bytes[index] <= 57
    invariant from <= index
    invariant index <= to
    invariant 0 <= value
    invariant value <= most
    decreases to - index
  {
    value = value * 10 + intrinsic::convert[UInt8, Int64](bytes[index] - 48)
    if value > most {
      return None
    }
    index += 1
  }
  if index == from {
    return None
  }
  Some(ParsedNumber(value: value, end: index))
}

fn posix_time(bytes: Slice[UInt8], from: USize, to: USize) -> Option[ParsedNumber]
  requires from <= to
  requires to <= bytes.length()
  ensures !(result is Some(time) && (time.value <= -700000 || time.value >= 700000 || time.end <= from || time.end > to))
  cost time finite
{
  var index = from
  var negative = false
  if index < to && (bytes[index] == 45 || bytes[index] == 43) {
    negative = bytes[index] == 45
    index += 1
  }
  let hours = posix_number(bytes, from: index, to: to, most: 167)?
  var seconds = hours.value * 3600
  index = hours.end
  if index < to && bytes[index] == 58 {
    let minutes = posix_number(bytes, from: index + 1, to: to, most: 59)?
    seconds += minutes.value * 60
    index = minutes.end
    if index < to && bytes[index] == 58 {
      let rest = posix_number(bytes, from: index + 1, to: to, most: 59)?
      seconds += rest.value
      index = rest.end
    }
  }
  Some(ParsedNumber(value: if negative { -seconds } else { seconds }, end: index))
}

fn posix_name_end(bytes: Slice[UInt8], from: USize, to: USize) -> Option[USize]
  requires from <= to
  requires to <= bytes.length()
  ensures !(result is Some(end) && (end <= from || end > to))
  cost time finite
{
  var index = from
  if index < to && bytes[index] == 60 {
    while index < to && bytes[index] != 62
      invariant from <= index
      invariant index <= to
      decreases to - index
    {
      index += 1
    }
    if index == to {
      return None
    }
    return Some(index + 1)
  }
  while index < to && ((65 <= bytes[index] && bytes[index] <= 90) || (97 <= bytes[index] && bytes[index] <= 122))
    invariant from <= index
    invariant index <= to
    decreases to - index
  {
    index += 1
  }
  if index - from < 3 {
    return None
  }
  Some(index)
}

type ParsedRuleDay(day: RuleDay, time: Int64, end: USize)

fn posix_rule_day(bytes: Slice[UInt8], from: USize, to: USize) -> Option[ParsedRuleDay]
  requires from <= to
  requires to <= bytes.length()
  ensures !(result is Some(parsed) && (parsed.time <= -700000 || parsed.time >= 700000 || parsed.end <= from
    || parsed.end > to))
  cost time finite
{
  if from == to {
    return None
  }
  var day = RuleDay(by_weekday: false, counts_leap_day: true, month: 1, week: 1, day: 0)
  var index = from
  if bytes[from] == 77 {
    let month = posix_number(bytes, from: from + 1, to: to, most: 12)?
    if month.value < 1 || month.end == to || bytes[month.end] != 46 {
      return None
    }
    let week = posix_number(bytes, from: month.end + 1, to: to, most: 5)?
    if week.value < 1 || week.end == to || bytes[week.end] != 46 {
      return None
    }
    let weekday = posix_number(bytes, from: week.end + 1, to: to, most: 6)?
    day = RuleDay(by_weekday: true, counts_leap_day: true, month: month.value, week: week.value, day: weekday.value)
    index = weekday.end
  } else if bytes[from] == 74 {
    let number = posix_number(bytes, from: from + 1, to: to, most: 365)?
    if number.value < 1 {
      return None
    }
    day = RuleDay(by_weekday: false, counts_leap_day: false, month: 1, week: 1, day: number.value)
    index = number.end
  } else {
    let number = posix_number(bytes, from: from, to: to, most: 365)?
    day = RuleDay(by_weekday: false, counts_leap_day: true, month: 1, week: 1, day: number.value)
    index = number.end
  }
  if index < to && bytes[index] == 47 {
    let time = posix_time(bytes, from: index + 1, to: to)?
    return Some(ParsedRuleDay(day: day, time: time.value, end: time.end))
  }
  Some(ParsedRuleDay(day: day, time: 7200, end: index))
}

fn posix_rule(bytes: Slice[UInt8], from: USize, to: USize) -> Option[ZoneRule]
  requires from <= to
  requires to <= bytes.length()
  cost time finite
{
  let standard_name = posix_name_end(bytes, from: from, to: to)?
  let standard = posix_time(bytes, from: standard_name, to: to)?
  if standard.end == to {
    return Some(ZoneRule(standard: -standard.value, daylight: None))
  }
  let daylight_name = posix_name_end(bytes, from: standard.end, to: to)?
  var offset = 3600 - standard.value
  var index = daylight_name
  if index < to && bytes[index] != 44 {
    let daylight = posix_time(bytes, from: index, to: to)?
    offset = -daylight.value
    index = daylight.end
  }
  if index == to || bytes[index] != 44 {
    return None
  }
  let start = posix_rule_day(bytes, from: index + 1, to: to)?
  if start.end == to || bytes[start.end] != 44 {
    return None
  }
  let end = posix_rule_day(bytes, from: start.end + 1, to: to)?
  if end.end != to {
    return None
  }
  Some(ZoneRule(
    standard: -standard.value,
    daylight: Some(DaylightRule(
      offset: offset,
      start: start.day,
      start_time: start.time,
      end: end.day,
      end_time: end.time,
    )),
  ))
}

fn footer_rule(rules: Slice[UInt8], from: USize) -> Result[Option[ZoneRule], ZoneError]
  cost time finite
{
  if from >= rules.length() || rules[from] != 10 {
    return Err(ZoneError.MalformedRules)
  }
  var end = from + 1
  while end < rules.length() && rules[end] != 10
    invariant from < end
    invariant end <= rules.length()
    decreases rules.length() - end
  {
    end += 1
  }
  if end == rules.length() {
    return Err(ZoneError.MalformedRules)
  }
  if end == from + 1 {
    return Ok(None)
  }
  match posix_rule(rules, from: from + 1, to: end) {
    Some(rule) => Ok(Some(rule))
    None => Err(ZoneError.MalformedRules)
  }
}

public fn TimeZone.from_rules(name: StringSlice, rules: Slice[UInt8]) -> Result[TimeZone, ZoneError]
  cost time finite
{
  if rules.length() > 1099511627776 {
    return Err(ZoneError.MalformedRules)
  }
  var header = match read_header(rules, at: 0, time_width: 4) {
    Some(header) => header
    None => return Err(ZoneError.MalformedRules)
  }
  var start: USize = 44
  var time_width: USize = 4
  if header.version != 0 {
    start = 44 + header.block + 44
    time_width = 8
    header = match read_header(rules, at: 44 + header.block, time_width: 8) {
      Some(wide_header) => wide_header
      None => return Err(ZoneError.MalformedRules)
    }
  }
  if header.type_count == 0 || start > rules.length() || rules.length() - start < header.block {
    return Err(ZoneError.MalformedRules)
  }
  let kinds_start = start + header.time_count * time_width
  let types_start = kinds_start + header.time_count
  var transitions: List[Int64] = List.with_capacity(header.time_count)
  var offsets: List[Int32] = List.with_capacity(header.time_count)
  var index: USize = 0
  while index < header.time_count
    invariant index <= header.time_count
    invariant transitions.length() == index
    invariant offsets.length() == index
    decreases header.time_count - index
  {
    let raw = match big_endian(rules, at: start + index * time_width, width: time_width) {
      Some(raw) => raw
      None => return Err(ZoneError.MalformedRules)
    }
    let time: Int64 = if time_width == 8 {
      raw.to_signed_bits()
    } else {
      intrinsic::convert(intrinsic::convert[UInt64, UInt32](raw % 4294967296).to_signed_bits())
    }
    if index > 0 && time <= transitions[index - 1] {
      return Err(ZoneError.MalformedRules)
    }
    if kinds_start + index >= rules.length() {
      return Err(ZoneError.MalformedRules)
    }
    let kind: USize = intrinsic::convert(rules[kinds_start + index])
    if kind >= header.type_count {
      return Err(ZoneError.MalformedRules)
    }
    let offset = match big_endian(rules, at: types_start + kind * 6, width: 4) {
      Some(offset) => offset
      None => return Err(ZoneError.MalformedRules)
    }
    mut transitions.push(time)
    mut offsets.push(intrinsic::convert[UInt64, UInt32](offset % 4294967296).to_signed_bits())
    index += 1
  }
  let first = match big_endian(rules, at: types_start, width: 4) {
    Some(first) => first
    None => return Err(ZoneError.MalformedRules)
  }
  var rule: Option[ZoneRule] = None
  if time_width == 8 {
    rule = footer_rule(rules, from: start + header.block)?
  }
  Ok(TimeZone(
    name: name.to_string(),
    transitions: own transitions,
    offsets: own offsets,
    first_offset: intrinsic::convert[UInt64, UInt32](first % 4294967296).to_signed_bits(),
    rule: rule,
  ))
}

public fn TimeZone.name(self) -> StringSlice
  cost time O(1)
{
  self.name.slice()
}

public fn TimeZone.offset(self, instant: Instant) -> Duration
  cost time O(log(self.transitions.length()))
{
  Duration(nanoseconds: self.offset_seconds(instant.unix_seconds()) * 1000000000)
}

public fn TimeZone.to_local(self, instant: Instant) -> DateTime
  cost time O(log(self.transitions.length()))
{
  let seconds = instant.unix_seconds()
  let local = seconds + self.offset_seconds(seconds)
  let nanoseconds_of_day = local.floor_modulo(86400) * 1000000000 + instant.nanoseconds.floor_modulo(1000000000)
  DateTime(
    date: Date(days_since_epoch: intrinsic::convert(local.floor_divide(86400))),
    time: TimeOfDay(nanoseconds_since_midnight: intrinsic::convert(nanoseconds_of_day)),
  )
}

fn instant_at(seconds: Int64, nanoseconds: Int64) -> Option[Instant]
  requires 0 <= nanoseconds && nanoseconds < 1000000000
  cost time O(1)
{
  let whole = seconds.checked_multiply(1000000000)?
  Some(Instant(nanoseconds: whole.checked_add(nanoseconds)?))
}

public fn TimeZone.to_instant(self, local: DateTime) -> Option[LocalInstant]
  cost time O(log(self.transitions.length()))
{
  let days: Int64 = intrinsic::convert(local.date.days_since_epoch)
  let nanoseconds_of_day: Int64 = intrinsic::convert(local.time.nanoseconds_since_midnight)
  if days < -110000 || days > 110000 {
    return None
  }
  let seconds = days * 86400 + nanoseconds_of_day / 1000000000
  let fraction = nanoseconds_of_day % 1000000000
  let before = self.offset_seconds(seconds - 86400)
  let after = self.offset_seconds(seconds + 86400)
  let first = seconds - before
  let second = seconds - after
  if before == after {
    return Some(LocalInstant.Unique(instant: instant_at(first, nanoseconds: fraction)?))
  }
  let first_holds = self.offset_seconds(first) == before
  let second_holds = self.offset_seconds(second) == after
  let earlier = instant_at(if first < second { first } else { second }, nanoseconds: fraction)?
  let later = instant_at(if first < second { second } else { first }, nanoseconds: fraction)?
  if first_holds && second_holds {
    Some(LocalInstant.Ambiguous(earlier: earlier, later: later))
  } else if first_holds {
    Some(LocalInstant.Unique(instant: instant_at(first, nanoseconds: fraction)?))
  } else if second_holds {
    Some(LocalInstant.Unique(instant: instant_at(second, nanoseconds: fraction)?))
  } else {
    Some(LocalInstant.Skipped(before: earlier, after: later))
  }
}

public fn TimeZone.format(self, instant: Instant) -> String
  cost time finite
{
  var output = TextBuilder.new()
  self.to_local(instant).display(mut output)
  let offset = self.offset_seconds(instant.unix_seconds())
  if -360000 < offset && offset < 360000 {
    write_offset(mut output, seconds: offset)
  }
  own output.finish()
}

public type ZoneError =
  | UnknownZone
  | MalformedRules
  derives Equal

impl Display for ZoneError {
  fn display(self, output: mut TextBuilder) {
    match self {
      UnknownZone => mut output.write("the time zone is not known")
      MalformedRules => mut output.write("the time zone's rules are malformed")
    }
  }
}

public fn zone(name: StringSlice) -> Result[TimeZone, ZoneError]
  uses Environment
{
  match Environment.zone_rules(name) {
    Some(rules) => TimeZone.from_rules(name, rules: rules.slice())
    None => Err(ZoneError.UnknownZone)
  }
}

public fn local_zone() -> TimeZone
  uses Environment
{
  match Environment.local_zone() {
    Some(name) => match zone(name.slice()) {
      Ok(named_zone) => named_zone
      Err(_) => TimeZone.utc()
    }
    None => TimeZone.utc()
  }
}

public opaque type Layout(parts: List[LayoutPart])
  derives Copyable

type LayoutPart =
  | Text(text: String)
  | Year
  | Month
  | Day
  | Hour
  | Minute
  | Second
  | Fraction(digits: UInt8)
  | Weekday

fn layout_parts(pattern: StringSlice) -> Option[List[LayoutPart]]
  cost time finite
{
  var parts: List[LayoutPart] = []
  var run: USize = 0
  var index: USize = 0
  while index < pattern.length()
    invariant run <= index
    invariant index <= pattern.length()
    decreases pattern.length() - index
  {
    if pattern.byte(index) != 37 {
      index += 1
    } else {
      if index > run {
        mut parts.push(LayoutPart.Text(text: pattern.part(run, to: index).to_string()))
      }
      if index + 1 == pattern.length() {
        return None
      }
      var letter = pattern.byte(index + 1)
      var next = index + 2
      var digits: UInt8 = 9
      if 49 <= letter && letter <= 57 {
        if next == pattern.length() || pattern.byte(next) != 102 {
          return None
        }
        digits = letter - 48
        letter = 102
        next += 1
      }
      if letter == 89 {
        mut parts.push(LayoutPart.Year)
      } else if letter == 109 {
        mut parts.push(LayoutPart.Month)
      } else if letter == 100 {
        mut parts.push(LayoutPart.Day)
      } else if letter == 72 {
        mut parts.push(LayoutPart.Hour)
      } else if letter == 77 {
        mut parts.push(LayoutPart.Minute)
      } else if letter == 83 {
        mut parts.push(LayoutPart.Second)
      } else if letter == 102 {
        mut parts.push(LayoutPart.Fraction(digits: digits))
      } else if letter == 65 {
        mut parts.push(LayoutPart.Weekday)
      } else if letter == 37 {
        mut parts.push(LayoutPart.Text(text: "%"))
      } else {
        return None
      }
      index = next
      run = next
    }
  }
  if index > run {
    mut parts.push(LayoutPart.Text(text: pattern.part(run, to: index).to_string()))
  }
  Some(own parts)
}

impl FromTemplate for Layout {
  type Part = Never

  fn from_template(template: Template[Never]) -> Layout
    requires is_valid_layout(template.literals)
  {
    if template.literals.length() != 1 {
      return Layout(parts: [])
    }
    match layout_parts(template.literals[0].text()) {
      Some(parts) => Layout(parts: own parts)
      None => Layout(parts: [])
    }
  }
}

public fn is_valid_layout(literals: Slice[text::Literal]) -> Bool
  cost time finite
{
  literals.length() == 1 && layout_parts(literals[0].text()) is Some(_)
}

public fn DateTime.format(self, layout: Layout) -> String
  cost time finite
{
  let civil = self.date.civil()
  let nanoseconds_of_day: Int64 = intrinsic::convert(self.time.nanoseconds_since_midnight)
  let seconds = nanoseconds_of_day / 1000000000
  var output = TextBuilder.new()
  var index: USize = 0
  while index < layout.parts.length()
    invariant index <= layout.parts.length()
    decreases layout.parts.length() - index
  {
    match layout.parts[index] {
      Text(text) => mut output.write(text.slice())
      Year => {
        let year = if civil.year < 0 { -civil.year } else { civil.year }
        if civil.year < 0 {
          mut output.write("-")
        }
        mut output.write(year.format(minimum_digits: 4).slice())
      }
      Month => write_two_digits(mut output, value: civil.month)
      Day => write_two_digits(mut output, value: civil.day)
      Hour => write_two_digits(mut output, value: seconds / 3600)
      Minute => write_two_digits(mut output, value: (seconds % 3600) / 60)
      Second => write_two_digits(mut output, value: seconds % 60)
      Fraction(digits) => {
        let padded = (nanoseconds_of_day % 1000000000).format(minimum_digits: 9)
        let shown: USize = intrinsic::convert(digits)
        if shown <= padded.length() {
          mut output.write(padded.slice().part(0, to: shown))
        }
      }
      Weekday => self.date.weekday().display(mut output)
    }
    index += 1
  }
  own output.finish()
}

type LayoutFields(year: Int64, month: Int64, day: Int64, hour: Int64, minute: Int64, second: Int64, nanosecond: Int64)

fn weekday_name_end(text: StringSlice, from: USize) -> USize
  requires from <= text.length()
  ensures from <= result
  ensures result <= text.length()
  cost time finite
{
  var index = from
  while index < text.length() && ((65 <= text.byte(index) && text.byte(index) <= 90)
    || (97 <= text.byte(index) && text.byte(index) <= 122))
    invariant from <= index
    invariant index <= text.length()
    decreases text.length() - index
  {
    index += 1
  }
  index
}

public fn Layout.parse_date_time(self, text: StringSlice) -> Result[DateTime, ParseTimeError]
  cost time finite
{
  var fields = LayoutFields(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0, nanosecond: 0)
  var weekday: Option[String] = None
  var position: USize = 0
  var index: USize = 0
  while index < self.parts.length()
    invariant index <= self.parts.length()
    invariant position <= text.length()
    invariant 0 <= fields.year && fields.year <= 999999999
    invariant 0 <= fields.month && fields.month <= 999999999
    invariant 0 <= fields.day && fields.day <= 999999999
    invariant 0 <= fields.hour && fields.hour <= 999999999
    invariant 0 <= fields.minute && fields.minute <= 999999999
    invariant 0 <= fields.second && fields.second <= 999999999
    invariant 0 <= fields.nanosecond && fields.nanosecond <= 999999999
    decreases self.parts.length() - index
  {
    match self.parts[index] {
      Text(expected) => {
        if expected.length() > text.length() - position || !text.matches_at(expected.slice(), offset: position) {
          return Err(ParseTimeError.Malformed(offset: position))
        }
        position += expected.length()
      }
      Year => {
        fields.year = parse_field(text, from: position, width: 4)?
        position += 4
      }
      Month => {
        fields.month = parse_field(text, from: position, width: 2)?
        position += 2
      }
      Day => {
        fields.day = parse_field(text, from: position, width: 2)?
        position += 2
      }
      Hour => {
        fields.hour = parse_field(text, from: position, width: 2)?
        position += 2
      }
      Minute => {
        fields.minute = parse_field(text, from: position, width: 2)?
        position += 2
      }
      Second => {
        fields.second = parse_field(text, from: position, width: 2)?
        position += 2
      }
      Fraction(digits) => {
        let width: USize = intrinsic::convert(digits)
        if width < 1 || width > 9 {
          return Err(ParseTimeError.Malformed(offset: position))
        }
        var value = parse_field(text, from: position, width: width)?
        var scaled = width
        while scaled < 9
          invariant scaled <= 9
          invariant 0 <= value
          invariant value <= 999999999
          decreases 9 - scaled
        {
          if value > 99999999 {
            return Err(ParseTimeError.OutOfRange)
          }
          value = value * 10
          scaled += 1
        }
        fields.nanosecond = value
        position += width
      }
      Weekday => {
        let end = weekday_name_end(text, from: position)
        if end == position {
          return Err(ParseTimeError.Malformed(offset: position))
        }
        weekday = Some(text.part(position, to: end).to_string())
        position = end
      }
    }
    index += 1
  }
  if position != text.length() {
    return Err(ParseTimeError.Malformed(offset: position))
  }
  if fields.year > 9999 || fields.month < 1 || fields.month > 12 || fields.day < 1 || fields.day > 31
    || fields.hour > 23 || fields.minute > 59 || fields.second > 59
  {
    return Err(ParseTimeError.OutOfRange)
  }
  if fields.day > days_in_month(fields.month, leap: is_leap(fields.year)) {
    return Err(ParseTimeError.OutOfRange)
  }
  let date = match checked_date(fields.year, month: fields.month, day: fields.day) {
    Some(date) => date
    None => return Err(ParseTimeError.OutOfRange)
  }
  if weekday is Some(name) && name != "${date.weekday()}" {
    return Err(ParseTimeError.OutOfRange)
  }
  let nanoseconds_of_day = (fields.hour * 3600 + fields.minute * 60 + fields.second) * 1000000000 + fields.nanosecond
  Ok(DateTime(date: date, time: TimeOfDay(nanoseconds_since_midnight: intrinsic::convert(nanoseconds_of_day))))
}

public opaque type Stopwatch(started: Duration)
  derives Plain

public fn Stopwatch.start() -> Stopwatch
  uses Clock
{
  Stopwatch(started: Clock.monotonic())
}

public fn Stopwatch.elapsed(self) -> Duration
  uses Clock
{
  Clock.monotonic() - self.started
}

public type FixedClock(time: Instant)

impl Clock for FixedClock {
  fn now(self) -> Instant {
    self.time
  }

  fn monotonic(self) -> Duration {
    Duration.zero
  }

  fn sleep(self, duration: Duration) {}
}

public opaque type ManualClock(time: Instant, elapsed: Duration)

public fn ManualClock.new(start: Instant) -> ManualClock {
  ManualClock(time: start, elapsed: Duration.zero)
}

public fn ManualClock.advance(mut self, by: Duration)
  requires !by.is_negative()
{
  self.time = self.time + by
  self.elapsed = self.elapsed + by
}

impl Clock for ManualClock {
  fn now(self) -> Instant {
    self.time
  }

  fn monotonic(self) -> Duration {
    self.elapsed
  }

  fn sleep(mut self, duration: Duration)
  {
    if !duration.is_negative() {
      mut self.advance(duration)
    }
  }
}

impl serialization::Serialize for Duration {
  fn serialize[Sink: serialization::Serializer](self, sink: mut Sink) {
    serialization::serialize_text(self, sink: mut sink)
  }
}

impl serialization::Deserialize for Duration {
  fn deserialize[Source: serialization::Deserializer](source: mut Source) -> Result[Duration, serialization::Error] {
    serialization::deserialize_text(mut source, expected: "a duration")
  }
}

impl serialization::Serialize for Instant {
  fn serialize[Sink: serialization::Serializer](self, sink: mut Sink) {
    serialization::serialize_text(self, sink: mut sink)
  }
}

impl serialization::Deserialize for Instant {
  fn deserialize[Source: serialization::Deserializer](source: mut Source) -> Result[Instant, serialization::Error] {
    serialization::deserialize_text(mut source, expected: "an instant, such as `2024-01-02T03:04:05Z`")
  }
}

impl serialization::Serialize for Date {
  fn serialize[Sink: serialization::Serializer](self, sink: mut Sink) {
    serialization::serialize_text(self, sink: mut sink)
  }
}

impl serialization::Deserialize for Date {
  fn deserialize[Source: serialization::Deserializer](source: mut Source) -> Result[Date, serialization::Error] {
    serialization::deserialize_text(mut source, expected: "a date, such as `2024-01-02`")
  }
}

impl serialization::Serialize for TimeOfDay {
  fn serialize[Sink: serialization::Serializer](self, sink: mut Sink) {
    serialization::serialize_text(self, sink: mut sink)
  }
}

impl serialization::Deserialize for TimeOfDay {
  fn deserialize[Source: serialization::Deserializer](source: mut Source) -> Result[TimeOfDay, serialization::Error] {
    serialization::deserialize_text(mut source, expected: "a time of day, such as `03:04:05`")
  }
}

impl serialization::Serialize for DateTime {
  fn serialize[Sink: serialization::Serializer](self, sink: mut Sink) {
    serialization::serialize_text(self, sink: mut sink)
  }
}

impl serialization::Deserialize for DateTime {
  fn deserialize[Source: serialization::Deserializer](source: mut Source) -> Result[DateTime, serialization::Error] {
    serialization::deserialize_text(mut source, expected: "a date and time, such as `2024-01-02T03:04:05`")
  }
}
