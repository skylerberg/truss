impl core::Countable for Date {
  fn successor(self) -> Option[Date]
    cost time O(1)
  {
    self.plus_days(1)
  }

  fn predecessor(self) -> Option[Date]
    cost time O(1)
  {
    self.plus_days(-1)
  }

  fn advanced(self, by: USize) -> Option[Date]
    cost time O(1)
  {
    todo
  }

  fn retreated(self, by: USize) -> Option[Date]
    cost time O(1)
  {
    todo
  }

  fn steps_to(self, other: Date) -> Option[USize]
    cost time O(1)
  {
    todo
  }
}

