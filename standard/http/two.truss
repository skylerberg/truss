use standard::http::hpack
use standard::intrinsic
use standard::map
use standard::streams

internal let preface: String = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

let protocol_error: UInt32 = 1

let flow_control_error: UInt32 = 3

let stream_closed: UInt32 = 5

let frame_size_error: UInt32 = 6

let refused_stream: UInt32 = 7

let compression_error: UInt32 = 9

let data_frame: UInt8 = 0

let headers_frame: UInt8 = 1

let reset_frame: UInt8 = 3

let settings_frame: UInt8 = 4

let push_frame: UInt8 = 5

let ping_frame: UInt8 = 6

let goaway_frame: UInt8 = 7

let window_frame: UInt8 = 8

let continuation_frame: UInt8 = 9

let end_stream: UInt8 = 1

let end_headers: UInt8 = 4

let padded: UInt8 = 8

let has_priority: UInt8 = 32

let largest_window: Int64 = 2147483647

let local_stream_window: USize = 1048576

let local_connection_window: USize = 16777216

let local_stream_limit: USize = 100

internal type Failure =
  | Closed
  | Reset(code: UInt32)
  | Protocol(code: UInt32, message: String)
  | System(error: SystemError)
  derives Equal

impl Display for Failure {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Closed => mut output.write("the HTTP/2 connection closed")
      Reset(code) => {
        mut output.write("the peer reset the HTTP/2 stream with code ")
        code.display(mut output)
      }
      Protocol(code, message) => {
        mut output.write("HTTP/2 error ")
        code.display(mut output)
        mut output.write(": ")
        mut output.write(message.slice())
      }
      System(error) => error.display(mut output)
    }
  }
}

fn violation(code: UInt32, message: StringSlice) -> Failure {
  Failure.Protocol(code: code, message: message.to_string())
}

internal type Message(stream: UInt32, fields: List[hpack::Field], body: List[UInt8], is_oversized: Bool)

type Frame(kind: UInt8, flags: UInt8, stream: UInt32, payload: List[UInt8])

type StreamState(
  stream: UInt32,
  block: List[UInt8],
  fields: List[hpack::Field],
  has_headers: Bool,
  body: List[UInt8],
  is_ended: Bool,
  is_oversized: Bool,
  is_delivered: Bool,
  send_window: Int64,
)

internal type Session[Stream: streams::Reader + streams::Writer](
  reader: streams::BufferedReader[Stream],
  is_server: Bool,
  decoder: hpack::Decoder,
  encoder: hpack::Encoder,
  peer_frame_size: USize,
  peer_stream_window: Int64,
  send_window: Int64,
  streams: List[StreamState],
  ready: List[Message],
  last_stream: UInt32,
  next_stream: UInt32,
  continuation: Option[UInt32],
  is_going_away: Bool,
  header_limit: USize,
  body_limit: USize,
)

fn system[Value](outcome: own Result[Value, SystemError]) -> Result[Value, Failure] {
  match own outcome {
    Ok(value) => Ok(own value)
    Err(error) => Err(Failure.System(error: error))
  }
}

fn push_u32(bytes: mut List[UInt8], value: UInt32) {
  mut bytes.push(intrinsic::convert((value >> 24) & 255))
  mut bytes.push(intrinsic::convert((value >> 16) & 255))
  mut bytes.push(intrinsic::convert((value >> 8) & 255))
  mut bytes.push(intrinsic::convert(value & 255))
}

fn u32_at(bytes: Slice[UInt8], at: USize) -> UInt32 {
  if at >= bytes.length() || bytes.length() - at < 4 {
    return 0
  }
  (intrinsic::convert[UInt8, UInt32](bytes[at]) << 24) | (intrinsic::convert[UInt8, UInt32](bytes[at + 1]) << 16)
    | (intrinsic::convert[UInt8, UInt32](bytes[at + 2]) << 8) | intrinsic::convert[UInt8, UInt32](bytes[at + 3])
}

fn write_frame[Stream: streams::Reader + streams::Writer](
  session: mut Session[Stream],
  kind: UInt8,
  flags: UInt8,
  stream: UInt32,
  payload: Slice[UInt8],
) -> Result[Unit, Failure]
  uses Handles
{
  let length = payload.length()
  var bytes: List[UInt8] = List.with_capacity(9)
  mut bytes.push(intrinsic::convert((length >> 16) & 255))
  mut bytes.push(intrinsic::convert((length >> 8) & 255))
  mut bytes.push(intrinsic::convert(length & 255))
  mut bytes.push(kind)
  mut bytes.push(flags)
  push_u32(mut bytes, value: stream & 2147483647)
  mut bytes.append_slice(payload)
  system(mut session.reader.source().write_all(bytes.slice()))?
  system(mut session.reader.source().flush())
}

fn read_frame[Stream: streams::Reader + streams::Writer](session: mut Session[Stream]) -> Result[Frame, Failure]
  uses Handles
{
  var header: List[UInt8] = []
  match mut session.reader.read_exactly(mut header, count: 9) {
    Ok(_) => {}
    Err(UnexpectedEnd) => return Err(Failure.Closed)
    Err(error) => return Err(Failure.System(error: error))
  }
  if header.length() != 9 {
    return Err(Failure.Closed)
  }
  let length = intrinsic::convert[UInt8, USize](header[0]) * 65536 + intrinsic::convert[UInt8, USize](header[1]) * 256
    + intrinsic::convert[UInt8, USize](header[2])
  if length > 16384 {
    return Err(violation(frame_size_error, message: "a frame larger than the advertised maximum"))
  }
  var payload: List[UInt8] = List.with_capacity(length)
  match mut session.reader.read_exactly(mut payload, count: length) {
    Ok(_) => {}
    Err(UnexpectedEnd) => return Err(violation(frame_size_error, message: "a frame that ends early"))
    Err(error) => return Err(Failure.System(error: error))
  }
  Ok(Frame(kind: header[3], flags: header[4], stream: u32_at(header.slice(), at: 5) & 2147483647, payload: own payload))
}

fn settings_payload(is_server: Bool, header_limit: USize) -> List[UInt8] {
  var payload: List[UInt8] = []
  if is_server {
    push_setting(mut payload, identifier: 3, value: local_stream_limit)
  } else {
    push_setting(mut payload, identifier: 2, value: 0)
  }
  push_setting(mut payload, identifier: 4, value: local_stream_window)
  push_setting(mut payload, identifier: 6, value: header_limit)
  payload
}

fn push_setting(payload: mut List[UInt8], identifier: UInt8, value: USize) {
  mut payload.push(0)
  mut payload.push(identifier)
  push_u32(mut payload, value: intrinsic::convert(value & 4294967295))
}

fn window_increment(amount: USize) -> List[UInt8] {
  var payload: List[UInt8] = []
  push_u32(mut payload, value: intrinsic::convert(amount & 2147483647))
  payload
}

fn open_session[Stream: streams::Reader + streams::Writer](
  reader: own streams::BufferedReader[Stream],
  is_server: Bool,
  header_limit: USize,
  body_limit: USize,
) -> Result[Session[Stream], Failure]
  uses Handles
{
  var session = Session(
    reader: own reader,
    is_server: is_server,
    decoder: hpack::Decoder.new(),
    encoder: hpack::Encoder.new(),
    peer_frame_size: 16384,
    peer_stream_window: 65535,
    send_window: 65535,
    streams: [],
    ready: [],
    last_stream: 0,
    next_stream: 1,
    continuation: None,
    is_going_away: false,
    header_limit: header_limit,
    body_limit: body_limit,
  )
  if !is_server {
    system(mut session.reader.source().write_all(preface.slice().bytes()))?
  }
  let settings = settings_payload(is_server, header_limit: header_limit)
  write_frame(mut session, kind: settings_frame, flags: 0, stream: 0, payload: settings.slice())?
  let increment = window_increment(local_connection_window - 65535)
  write_frame(mut session, kind: window_frame, flags: 0, stream: 0, payload: increment.slice())?
  Ok(own session)
}

internal fn accept[Stream: streams::Reader + streams::Writer](
  reader: own streams::BufferedReader[Stream],
  header_limit: USize,
  body_limit: USize,
) -> Result[Session[Stream], Failure]
  uses Handles
{
  var opened = own reader
  var opening: List[UInt8] = []
  match mut opened.read_exactly(mut opening, count: 24) {
    Ok(_) => {}
    Err(error) => return Err(Failure.System(error: error))
  }
  if opening.slice() != preface.slice().bytes() {
    return Err(violation(protocol_error, message: "a connection that does not start with the HTTP/2 preface"))
  }
  var session = open_session(own opened, is_server: true, header_limit: header_limit, body_limit: body_limit)?
  let first = read_frame(mut session)?
  if first.kind != settings_frame || (first.flags & 1) != 0 {
    return Err(violation(protocol_error, message: "a connection whose first frame is not SETTINGS"))
  }
  process(mut session, frame: own first)?
  Ok(own session)
}

internal fn connect[Stream: streams::Reader + streams::Writer](
  stream: own Stream,
  header_limit: USize,
  body_limit: USize,
) -> Result[Session[Stream], Failure]
  uses Handles
{
  open_session(streams::BufferedReader.new(own stream, capacity: 16384), is_server: false, header_limit: header_limit, body_limit: body_limit)
}

fn stream_index(streams: Slice[StreamState], stream: UInt32) -> Option[USize] {
  for index in 0..streams.length() {
    if streams[index].stream == stream {
      return Some(index)
    }
  }
  None
}

fn strip_padding(payload: Slice[UInt8], flags: UInt8, skip: USize) -> Result[List[UInt8], Failure] {
  var start: USize = 0
  var stop = payload.length()
  if (flags & padded) != 0 {
    if payload.is_empty() {
      return Err(violation(protocol_error, message: "a padded frame with no padding length"))
    }
    let padding: USize = intrinsic::convert(payload[0])
    start = 1
    if padding > stop - start {
      return Err(violation(protocol_error, message: "padding longer than its frame"))
    }
    stop -= padding
  }
  if skip > stop - start {
    return Err(violation(frame_size_error, message: "a frame too short for its priority"))
  }
  start += skip
  Ok(payload[start..stop].to_list())
}

fn decode_block[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], index: USize) -> Result[Unit, Failure] {
  if index >= session.streams.length() {
    return Ok(Unit)
  }
  let block = map::exchange(mut session.streams[index].block, value: [])
  let fields = match mut session.decoder.decode(block.slice(), list_limit: session.header_limit) {
    Ok(fields) => own fields
    Err(error) => return Err(violation(compression_error, message: error.message.slice()))
  }
  if session.streams[index].has_headers {
    if !session.streams[index].is_ended {
      return Err(violation(protocol_error, message: "trailers that do not end the stream"))
    }
    return Ok(Unit)
  }
  if !session.is_server && fields.length() > 0 && fields[0].name == ":status" && fields[0].value.slice().starts_with("1") {
    return Ok(Unit)
  }
  session.streams[index].fields = own fields
  session.streams[index].has_headers = true
  Ok(Unit)
}

fn deliver[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], index: USize) {
  if index >= session.streams.length() {
    return
  }
  if !session.streams[index].has_headers || !session.streams[index].is_ended || session.streams[index].is_delivered
    || session.continuation == Some(session.streams[index].stream)
  {
    return
  }
  session.streams[index].is_delivered = true
  let fields = map::exchange(mut session.streams[index].fields, value: [])
  let body = map::exchange(mut session.streams[index].body, value: [])
  mut session.ready.push(Message(
    stream: session.streams[index].stream,
    fields: own fields,
    body: own body,
    is_oversized: session.streams[index].is_oversized,
  ))
  if !session.is_server {
    let _ = mut session.streams.remove_at(index)
  }
}

fn new_stream_state(stream: UInt32, window: Int64) -> StreamState {
  StreamState(
    stream: stream,
    block: [],
    fields: [],
    has_headers: false,
    body: [],
    is_ended: false,
    is_oversized: false,
    is_delivered: false,
    send_window: window,
  )
}

fn process_headers[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure]
  uses Handles
{
  if frame.stream == 0 {
    return Err(violation(protocol_error, message: "HEADERS on stream zero"))
  }
  let skip: USize = if (frame.flags & has_priority) != 0 { 5 } else { 0 }
  let fragment = strip_padding(frame.payload.slice(), flags: frame.flags, skip: skip)?
  var index = stream_index(session.streams.slice(), stream: frame.stream)
  var is_refused = false
  if index is None {
    if !session.is_server || frame.stream % 2 == 0 || frame.stream <= session.last_stream {
      return Err(violation(stream_closed, message: "HEADERS on a stream that is not open"))
    }
    session.last_stream = frame.stream
    is_refused = session.is_going_away || session.streams.length() >= local_stream_limit
    mut session.streams.push(new_stream_state(frame.stream, window: session.peer_stream_window))
    index = Some(session.streams.length() - 1)
  }
  let position = match index {
    Some(position) => position
    None => return Ok(Unit)
  }
  if position >= session.streams.length() {
    return Ok(Unit)
  }
  if session.streams[position].is_ended {
    return Err(violation(stream_closed, message: "HEADERS on a stream that has ended"))
  }
  mut session.streams[position].block.append(own fragment)
  if (frame.flags & end_stream) != 0 {
    session.streams[position].is_ended = true
  }
  if (frame.flags & end_headers) == 0 {
    session.continuation = Some(frame.stream)
    return Ok(Unit)
  }
  decode_block(mut session, index: position)?
  if is_refused {
    if position < session.streams.length() {
      let _ = mut session.streams.remove_at(position)
    }
    let code = window_increment(intrinsic::convert(refused_stream))
    return write_frame(mut session, kind: reset_frame, flags: 0, stream: frame.stream, payload: code.slice())
  }
  deliver(mut session, index: position)
  Ok(Unit)
}

fn process_continuation[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure] {
  let position = match stream_index(session.streams.slice(), stream: frame.stream) {
    Some(position) => position
    None => return Err(violation(protocol_error, message: "CONTINUATION on a stream that is not open"))
  }
  if position >= session.streams.length() {
    return Ok(Unit)
  }
  mut session.streams[position].block.append(own frame.payload)
  if session.streams[position].block.length() > session.header_limit {
    return Err(violation(protocol_error, message: "a header block larger than the limit"))
  }
  if (frame.flags & end_headers) != 0 {
    session.continuation = None
    decode_block(mut session, index: position)?
    deliver(mut session, index: position)
  }
  Ok(Unit)
}

fn process_data[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure]
  uses Handles
{
  if frame.stream == 0 {
    return Err(violation(protocol_error, message: "DATA on stream zero"))
  }
  let length = frame.payload.length()
  if length > 0 {
    let increment = window_increment(length)
    write_frame(mut session, kind: window_frame, flags: 0, stream: 0, payload: increment.slice())?
  }
  let position = match stream_index(session.streams.slice(), stream: frame.stream) {
    Some(position) => position
    None => {
      if frame.stream <= session.last_stream || frame.stream < session.next_stream {
        return Ok(Unit)
      }
      return Err(violation(protocol_error, message: "DATA on a stream that is not open"))
    }
  }
  if position >= session.streams.length() {
    return Ok(Unit)
  }
  if session.streams[position].is_ended || !session.streams[position].has_headers {
    return Err(violation(stream_closed, message: "DATA on a stream that is not open"))
  }
  let data = strip_padding(frame.payload.slice(), flags: frame.flags, skip: 0)?
  if session.streams[position].body.length() > session.body_limit || data.length() > session.body_limit - session.streams[position].body.length() {
    session.streams[position].is_oversized = true
    mut session.streams[position].body.clear()
  } else if !session.streams[position].is_oversized {
    mut session.streams[position].body.append(own data)
  }
  if (frame.flags & end_stream) != 0 {
    session.streams[position].is_ended = true
    deliver(mut session, index: position)
  } else if length > 0 {
    let increment = window_increment(length)
    write_frame(mut session, kind: window_frame, flags: 0, stream: frame.stream, payload: increment.slice())?
  }
  Ok(Unit)
}

fn process_settings[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure]
  uses Handles
{
  if frame.stream != 0 {
    return Err(violation(protocol_error, message: "SETTINGS on a stream"))
  }
  if (frame.flags & 1) != 0 {
    if !frame.payload.is_empty() {
      return Err(violation(frame_size_error, message: "a SETTINGS acknowledgement with a payload"))
    }
    return Ok(Unit)
  }
  if frame.payload.length() % 6 != 0 {
    return Err(violation(frame_size_error, message: "a SETTINGS frame whose length is not a multiple of six"))
  }
  var at: USize = 0
  while at < frame.payload.length() && frame.payload.length() - at >= 6 {
    let identifier = intrinsic::convert[UInt8, UInt16](frame.payload[at]) * 256 + intrinsic::convert[UInt8, UInt16](frame.payload[at + 1])
    let value = u32_at(frame.payload.slice(), at: at + 2)
    if identifier == 1 {
      mut session.encoder.set_limit(intrinsic::convert(value))
    } else if identifier == 2 && value > 1 {
      return Err(violation(protocol_error, message: "SETTINGS_ENABLE_PUSH that is not zero or one"))
    } else if identifier == 4 {
      if value > 2147483647 {
        return Err(violation(flow_control_error, message: "an initial window larger than allowed"))
      }
      let window: Int64 = intrinsic::convert(value)
      let delta = window.saturating_subtract(session.peer_stream_window)
      session.peer_stream_window = window
      for index in 0..session.streams.length() {
        if index < session.streams.length() {
          let updated = session.streams[index].send_window.saturating_add(delta)
          if updated > largest_window {
            return Err(violation(flow_control_error, message: "a window larger than allowed"))
          }
          session.streams[index].send_window = updated
        }
      }
    } else if identifier == 5 {
      if value < 16384 || value > 16777215 {
        return Err(violation(protocol_error, message: "a maximum frame size outside the allowed range"))
      }
      session.peer_frame_size = intrinsic::convert(value)
    }
    at += 6
  }
  write_frame(mut session, kind: settings_frame, flags: 1, stream: 0, payload: [])
}

fn process_window[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure] {
  if frame.payload.length() != 4 {
    return Err(violation(frame_size_error, message: "a WINDOW_UPDATE that is not four bytes"))
  }
  let increment: Int64 = intrinsic::convert(u32_at(frame.payload.slice(), at: 0) & 2147483647)
  if increment == 0 {
    return Err(violation(protocol_error, message: "a WINDOW_UPDATE of zero"))
  }
  if frame.stream == 0 {
    let updated = session.send_window.saturating_add(increment)
    if updated > largest_window {
      return Err(violation(flow_control_error, message: "a connection window larger than allowed"))
    }
    session.send_window = updated
    return Ok(Unit)
  }
  match stream_index(session.streams.slice(), stream: frame.stream) {
    Some(position) => {
      if position < session.streams.length() {
        let updated = session.streams[position].send_window.saturating_add(increment)
        if updated > largest_window {
          return Err(violation(flow_control_error, message: "a stream window larger than allowed"))
        }
        session.streams[position].send_window = updated
      }
    }
    None => {}
  }
  Ok(Unit)
}

fn process[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure]
  uses Handles
{
  match session.continuation {
    Some(stream) => {
      if frame.kind != continuation_frame || frame.stream != stream {
        return Err(violation(protocol_error, message: "a frame between HEADERS and its CONTINUATION"))
      }
    }
    None => {
      if frame.kind == continuation_frame {
        return Err(violation(protocol_error, message: "a CONTINUATION that does not follow HEADERS"))
      }
    }
  }
  let kind = frame.kind
  if kind == data_frame {
    process_data(mut session, frame: own frame)
  } else if kind == headers_frame {
    process_headers(mut session, frame: own frame)
  } else if kind == continuation_frame {
    process_continuation(mut session, frame: own frame)
  } else if kind == settings_frame {
    process_settings(mut session, frame: own frame)
  } else if kind == window_frame {
    process_window(mut session, frame: own frame)
  } else if kind == ping_frame {
    if frame.payload.length() != 8 || frame.stream != 0 {
      return Err(violation(frame_size_error, message: "a PING that is not eight bytes on stream zero"))
    }
    if (frame.flags & 1) == 0 {
      write_frame(mut session, kind: ping_frame, flags: 1, stream: 0, payload: frame.payload.slice())?
    }
    Ok(Unit)
  } else if kind == reset_frame {
    if frame.payload.length() != 4 || frame.stream == 0 {
      return Err(violation(frame_size_error, message: "a RST_STREAM that is not four bytes on a stream"))
    }
    match stream_index(session.streams.slice(), stream: frame.stream) {
      Some(position) => {
        if position < session.streams.length() {
          let _ = mut session.streams.remove_at(position)
        }
        if !session.is_server {
          return Err(Failure.Reset(code: u32_at(frame.payload.slice(), at: 0)))
        }
      }
      None => {}
    }
    Ok(Unit)
  } else if kind == goaway_frame {
    session.is_going_away = true
    Ok(Unit)
  } else if kind == push_frame {
    Err(violation(protocol_error, message: "a PUSH_PROMISE, which this endpoint disabled"))
  } else {
    Ok(Unit)
  }
}

fn pump[Stream: streams::Reader + streams::Writer](session: mut Session[Stream]) -> Result[Unit, Failure]
  uses Handles
{
  let frame = read_frame(mut session)?
  process(mut session, frame: own frame)
}

internal fn receive[Stream: streams::Reader + streams::Writer](session: mut Session[Stream]) -> Result[List[Message], Failure]
  uses Handles
{
  while session.ready.is_empty() || session.reader.buffered() >= 9 {
    if session.is_going_away && session.ready.is_empty() && session.streams.is_empty() {
      return Err(Failure.Closed)
    }
    pump(mut session)?
  }
  Ok(map::exchange(mut session.ready, value: []))
}

fn send_headers[Stream: streams::Reader + streams::Writer](
  session: mut Session[Stream],
  stream: UInt32,
  fields: Slice[hpack::Field],
  is_last: Bool,
) -> Result[Unit, Failure]
  uses Handles
{
  let block = mut session.encoder.encode(fields)
  let size = session.peer_frame_size
  var start: USize = 0
  var is_first = true
  while is_first || start < block.length()
    invariant start <= block.length()
  {
    let stop = if block.length() - start > size { start + size } else { block.length() }
    let flags: UInt8 = (if stop == block.length() { end_headers } else { 0 }) | (if is_first && is_last { end_stream } else { 0 })
    write_frame(mut session, kind: if is_first { headers_frame } else { continuation_frame }, flags: flags, stream: stream, payload: block[start..stop])?
    start = stop
    is_first = false
  }
  Ok(Unit)
}

fn send_body[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], stream: UInt32, body: Slice[UInt8]) -> Result[Unit, Failure]
  uses Handles
{
  var start: USize = 0
  while start < body.length() {
    let position = match stream_index(session.streams.slice(), stream: stream) {
      Some(position) => position
      None => return Ok(Unit)
    }
    if position >= session.streams.length() {
      return Ok(Unit)
    }
    let window = if session.send_window < session.streams[position].send_window { session.send_window } else { session.streams[position].send_window }
    if window <= 0 {
      pump(mut session)?
      continue
    }
    var size = body.length() - start
    if size > session.peer_frame_size {
      size = session.peer_frame_size
    }
    let room: USize = intrinsic::convert(window)
    if size > room {
      size = room
    }
    let stop = start + size
    let used: Int64 = intrinsic::convert(size)
    session.send_window -= used
    session.streams[position].send_window -= used
    write_frame(mut session, kind: data_frame, flags: if stop == body.length() { end_stream } else { 0 }, stream: stream, payload: body[start..stop])?
    start = stop
  }
  Ok(Unit)
}

internal fn respond[Stream: streams::Reader + streams::Writer](
  session: mut Session[Stream],
  stream: UInt32,
  fields: Slice[hpack::Field],
  body: Slice[UInt8],
) -> Result[Unit, Failure]
  uses Handles
{
  if stream_index(session.streams.slice(), stream: stream) is None {
    return Ok(Unit)
  }
  send_headers(mut session, stream: stream, fields: fields, is_last: body.is_empty())?
  send_body(mut session, stream: stream, body: body)?
  match stream_index(session.streams.slice(), stream: stream) {
    Some(position) => {
      if position < session.streams.length() {
        let _ = mut session.streams.remove_at(position)
      }
    }
    None => {}
  }
  Ok(Unit)
}

internal fn exchange[Stream: streams::Reader + streams::Writer](
  session: mut Session[Stream],
  fields: Slice[hpack::Field],
  body: Slice[UInt8],
) -> Result[Message, Failure]
  uses Handles
{
  if session.is_going_away || session.next_stream > 2147483645 {
    return Err(Failure.Closed)
  }
  let stream = session.next_stream
  session.next_stream += 2
  mut session.streams.push(new_stream_state(stream, window: session.peer_stream_window))
  send_headers(mut session, stream: stream, fields: fields, is_last: body.is_empty())?
  send_body(mut session, stream: stream, body: body)?
  while true {
    var answer_at: Option[USize] = None
    for index in 0..session.ready.length() {
      if session.ready[index].stream == stream {
        answer_at = Some(index)
      }
    }
    match answer_at {
      Some(position) => {
        if position < session.ready.length() {
          let answer = mut session.ready.remove_at(position)
          return Ok(own answer)
        }
      }
      None => {}
    }
    if session.is_going_away && stream_index(session.streams.slice(), stream: stream) is None {
      return Err(Failure.Closed)
    }
    pump(mut session)?
  }
}

internal fn is_usable[Stream: streams::Reader + streams::Writer](session: Session[Stream]) -> Bool {
  !session.is_going_away && session.next_stream <= 2147483645
}

internal fn close[Stream: streams::Reader + streams::Writer](session: mut Session[Stream], code: UInt32)
  uses Handles
{
  var payload: List[UInt8] = []
  push_u32(mut payload, value: session.last_stream)
  push_u32(mut payload, value: code)
  let _ = write_frame(mut session, kind: goaway_frame, flags: 0, stream: 0, payload: payload.slice())
}

internal fn failure_code(failure: Failure) -> UInt32 {
  match failure {
    Protocol(code, ..) => code
    _ => 0
  }
}

internal fn finish[Stream: streams::Reader + streams::Writer](session: own Session[Stream]) -> Stream {
  own session.reader.finish()
}
