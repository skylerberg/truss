use standard::http::date
use standard::http::flow
use standard::http::hpack
use standard::intrinsic
use standard::map
use standard::streams
use standard::tasks

internal let preface: String = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

let protocol_error: UInt32 = 1

let flow_control_error: UInt32 = 3

let stream_closed: UInt32 = 5

let frame_size_error: UInt32 = 6

let internal_error: UInt32 = 2

let refused_stream: UInt32 = 7

let compression_error: UInt32 = 9

let data_frame: UInt8 = 0

let headers_frame: UInt8 = 1

let reset_frame: UInt8 = 3

let settings_frame: UInt8 = 4

let push_frame: UInt8 = 5

let ping_frame: UInt8 = 6

let goaway_frame: UInt8 = 7

let window_frame: UInt8 = 8

let continuation_frame: UInt8 = 9

let end_stream: UInt8 = 1

let end_headers: UInt8 = 4

let padded: UInt8 = 8

let has_priority: UInt8 = 32

let largest_window: Int64 = 2147483647

let local_stream_window: USize = 1048576

let local_connection_window: USize = 16777216

let local_stream_limit: Int64 = 100

internal type Failure =
  | Closed
  | Reset(code: UInt32)
  | Protocol(code: UInt32, message: String)
  | System(error: SystemError)
  derives Equal

impl Display for Failure {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Closed => mut output.write("the HTTP/2 connection closed")
      Reset(code) => {
        mut output.write("the peer reset the HTTP/2 stream with code ")
        code.display(mut output)
      }
      Protocol(code, message) => {
        mut output.write("HTTP/2 error ")
        code.display(mut output)
        mut output.write(": ")
        mut output.write(message.slice())
      }
      System(error) => error.display(mut output)
    }
  }
}

fn violation(code: UInt32, message: StringSlice) -> Failure {
  Failure.Protocol(code: code, message: message.to_string())
}

internal fn failure_code(failure: Failure) -> UInt32 {
  match failure {
    Protocol(code, ..) => code
    _ => 0
  }
}

fn system[Value](outcome: own Result[Value, SystemError]) -> Result[Value, Failure] {
  match own outcome {
    Ok(value) => Ok(own value)
    Err(error) => Err(Failure.System(error: error))
  }
}

fn push_u32(bytes: mut List[UInt8], value: UInt32) {
  mut bytes.push(intrinsic::convert((value >> 24) & 255))
  mut bytes.push(intrinsic::convert((value >> 16) & 255))
  mut bytes.push(intrinsic::convert((value >> 8) & 255))
  mut bytes.push(intrinsic::convert(value & 255))
}

fn u32_at(bytes: Slice[UInt8], at: USize) -> UInt32 {
  if at >= bytes.length() || bytes.length() - at < 4 {
    return 0
  }
  (intrinsic::convert[UInt8, UInt32](bytes[at]) << 24) | (intrinsic::convert[UInt8, UInt32](bytes[at + 1]) << 16)
    | (intrinsic::convert[UInt8, UInt32](bytes[at + 2]) << 8) | intrinsic::convert[UInt8, UInt32](bytes[at + 3])
}

type Frame(kind: UInt8, flags: UInt8, stream: UInt32, payload: List[UInt8])

internal type Inbox(bytes: List[UInt8])

fn fill[Stream: streams::Duplex](stream: Stream, inbox: mut Inbox) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  match stream.receive(mut inbox.bytes, limit: 65536) {
    Ok(0) => Err(Failure.Closed)
    Ok(_) => Ok(Unit)
    Err(error) => Err(Failure.System(error: error))
  }
}

fn take_bytes[Stream: streams::Duplex](stream: Stream, inbox: mut Inbox, count: USize) -> Result[List[UInt8], Failure]
  uses Handles, Tasks
{
  while inbox.bytes.length() < count {
    fill(stream, inbox: mut inbox)?
  }
  let rest = mut inbox.bytes.split_off(count)
  Ok(map::exchange(mut inbox.bytes, value: own rest))
}

fn read_frame[Stream: streams::Duplex](stream: Stream, inbox: mut Inbox) -> Result[Frame, Failure]
  uses Handles, Tasks
{
  while inbox.bytes.length() < 9 {
    fill(stream, inbox: mut inbox)?
  }
  let length = intrinsic::convert[UInt8, USize](inbox.bytes[0]) * 65536 + intrinsic::convert[UInt8, USize](inbox.bytes[1]) * 256
    + intrinsic::convert[UInt8, USize](inbox.bytes[2])
  if length > 16384 {
    return Err(violation(frame_size_error, message: "a frame larger than the advertised maximum"))
  }
  while inbox.bytes.length() < 9 || inbox.bytes.length() - 9 < length {
    fill(stream, inbox: mut inbox)?
  }
  let rest = mut inbox.bytes.split_off(9 + length)
  let whole = map::exchange(mut inbox.bytes, value: own rest)
  if whole.length() < 9 {
    return Err(Failure.Closed)
  }
  Ok(Frame(kind: whole[3], flags: whole[4], stream: u32_at(whole.slice(), at: 5) & 2147483647, payload: whole[9..].to_list()))
}

fn frame_bytes(output: mut List[UInt8], kind: UInt8, flags: UInt8, stream: UInt32, payload: Slice[UInt8]) {
  let length = payload.length()
  mut output.push(intrinsic::convert((length >> 16) & 255))
  mut output.push(intrinsic::convert((length >> 8) & 255))
  mut output.push(intrinsic::convert(length & 255))
  mut output.push(kind)
  mut output.push(flags)
  push_u32(mut output, value: stream & 2147483647)
  mut output.append_slice(payload)
}

fn send_frame[Stream: streams::Duplex](stream: Stream, kind: UInt8, flags: UInt8, id: UInt32, payload: Slice[UInt8]) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  var bytes: List[UInt8] = List.with_capacity(9 + payload.length())
  frame_bytes(mut bytes, kind: kind, flags: flags, stream: id, payload: payload)
  system(stream.send_all(bytes.slice()))
}

fn push_setting(payload: mut List[UInt8], identifier: UInt8, value: USize) {
  mut payload.push(0)
  mut payload.push(identifier)
  push_u32(mut payload, value: intrinsic::convert(value & 4294967295))
}

fn window_increment(amount: USize) -> List[UInt8] {
  var payload: List[UInt8] = []
  push_u32(mut payload, value: intrinsic::convert(amount & 2147483647))
  payload
}

fn open_connection[Stream: streams::Duplex](stream: Stream, is_server: Bool, header_limit: USize) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  var bytes: List[UInt8] = []
  if !is_server {
    mut bytes.append_slice(preface.slice().bytes())
  }
  var settings: List[UInt8] = []
  if is_server {
    push_setting(mut settings, identifier: 3, value: intrinsic::convert(local_stream_limit))
  } else {
    push_setting(mut settings, identifier: 2, value: 0)
  }
  push_setting(mut settings, identifier: 4, value: local_stream_window)
  push_setting(mut settings, identifier: 6, value: header_limit)
  frame_bytes(mut bytes, kind: settings_frame, flags: 0, stream: 0, payload: settings.slice())
  let increment = window_increment(local_connection_window - 65535)
  frame_bytes(mut bytes, kind: window_frame, flags: 0, stream: 0, payload: increment.slice())
  system(stream.send_all(bytes.slice()))
}

fn strip_padding(payload: Slice[UInt8], flags: UInt8, skip: USize) -> Result[List[UInt8], Failure] {
  var start: USize = 0
  var stop = payload.length()
  if (flags & padded) != 0 {
    if payload.is_empty() {
      return Err(violation(protocol_error, message: "a padded frame with no padding length"))
    }
    let padding: USize = intrinsic::convert(payload[0])
    start = 1
    if padding > stop - start {
      return Err(violation(protocol_error, message: "padding longer than its frame"))
    }
    stop -= padding
  }
  if skip > stop - start {
    return Err(violation(frame_size_error, message: "a frame too short for its priority"))
  }
  start += skip
  Ok(payload[start..stop].to_list())
}

type PeerSettings(initial_window: Option[Int64], frame_size: Option[USize], table_size: Option[USize])

fn parse_settings(frame: Frame) -> Result[Option[PeerSettings], Failure] {
  if frame.stream != 0 {
    return Err(violation(protocol_error, message: "SETTINGS on a stream"))
  }
  if (frame.flags & 1) != 0 {
    if !frame.payload.is_empty() {
      return Err(violation(frame_size_error, message: "a SETTINGS acknowledgement with a payload"))
    }
    return Ok(None)
  }
  if frame.payload.length() % 6 != 0 {
    return Err(violation(frame_size_error, message: "a SETTINGS frame whose length is not a multiple of six"))
  }
  var settings = PeerSettings(initial_window: None, frame_size: None, table_size: None)
  var at: USize = 0
  while at < frame.payload.length() && frame.payload.length() - at >= 6 {
    let identifier = intrinsic::convert[UInt8, UInt16](frame.payload[at]) * 256 + intrinsic::convert[UInt8, UInt16](frame.payload[at + 1])
    let value = u32_at(frame.payload.slice(), at: at + 2)
    if identifier == 1 {
      settings.table_size = Some(intrinsic::convert(value))
    } else if identifier == 2 && value > 1 {
      return Err(violation(protocol_error, message: "SETTINGS_ENABLE_PUSH that is not zero or one"))
    } else if identifier == 4 {
      if value > 2147483647 {
        return Err(violation(flow_control_error, message: "an initial window larger than allowed"))
      }
      settings.initial_window = Some(intrinsic::convert(value))
    } else if identifier == 5 {
      if value < 16384 || value > 16777215 {
        return Err(violation(protocol_error, message: "a maximum frame size outside the allowed range"))
      }
      settings.frame_size = Some(intrinsic::convert(value))
    }
    at += 6
  }
  Ok(Some(settings))
}

fn window_of(frame: Frame) -> Result[Int64, Failure] {
  if frame.payload.length() != 4 {
    return Err(violation(frame_size_error, message: "a WINDOW_UPDATE that is not four bytes"))
  }
  let increment: Int64 = intrinsic::convert(u32_at(frame.payload.slice(), at: 0) & 2147483647)
  if increment == 0 {
    return Err(violation(protocol_error, message: "a WINDOW_UPDATE of zero"))
  }
  Ok(increment)
}

fn block_of(frame: Frame) -> Result[List[UInt8], Failure] {
  let skip: USize = if (frame.flags & has_priority) != 0 { 5 } else { 0 }
  strip_padding(frame.payload.slice(), flags: frame.flags, skip: skip)
}

internal type Arrival(
  stream: UInt32,
  fields: List[hpack::Field],
  chunks: tasks::Channel[flow::Chunk],
  outbound: tasks::Channel[flow::Outbound],
  cancelled: tasks::Channel[Unit],
)

type Cancel(stream: UInt32, cancelled: tasks::Channel[Unit])

fn cancel_stream(reading: mut Reading, stream: UInt32)
  uses Tasks
{
  for entry in reading.cancels {
    if entry.stream == stream {
      entry.cancelled.close()
    }
  }
}

fn cancel_all(reading: mut Reading)
  uses Tasks
{
  for entry in reading.cancels {
    entry.cancelled.close()
  }
  reading.cancels = []
}

fn watch_stream(reading: mut Reading, stream: UInt32, cancelled: tasks::Channel[Unit])
  uses Tasks
{
  var index: USize = 0
  while index < reading.cancels.length() {
    if reading.cancels[index].cancelled.is_closed() {
      let _ = mut reading.cancels.remove_at(index)
    } else {
      index += 1
    }
  }
  mut reading.cancels.push(Cancel(stream: stream, cancelled: cancelled.copy()))
}

internal fn abort_stream(outbound: tasks::Channel[flow::Outbound], stream: UInt32)
  uses Tasks
{
  var frame: List[UInt8] = []
  let code = window_increment(intrinsic::convert(internal_error))
  frame_bytes(mut frame, kind: reset_frame, flags: 0, stream: stream, payload: code.slice())
  let _ = outbound.send(flow::Outbound.Reset(stream: stream))
  let _ = outbound.send(flow::Outbound.Frame(bytes: own frame))
}

type Inflow(stream: UInt32, chunks: tasks::Channel[flow::Chunk], block: List[UInt8], has_headers: Bool, is_ending: Bool, is_refused: Bool)

type Admission(is_draining: Bool, last_stream: UInt32, active: Int64)

type Reading(
  decoder: hpack::Decoder,
  inflows: List[Inflow],
  last_stream: UInt32,
  continuation: Option[UInt32],
  is_going_away: Bool,
  header_limit: USize,
  admission: tasks::Cell[Admission],
  cancels: List[Cancel],
)

fn inflow_index(inflows: Slice[Inflow], stream: UInt32) -> Option[USize] {
  for index in 0..inflows.length() {
    if inflows[index].stream == stream {
      return Some(index)
    }
  }
  None
}

fn close_inflow(reading: mut Reading, index: USize, chunk: own flow::Chunk)
  uses Tasks
{
  if index < reading.inflows.length() {
    let inflow = mut reading.inflows.remove_at(index)
    let _ = inflow.chunks.send(own chunk)
    inflow.chunks.close()
  }
}

fn complete_headers(reading: mut Reading, index: USize, arrivals: tasks::Channel[Arrival], outbound: tasks::Channel[flow::Outbound]) -> Result[Unit, Failure]
  uses Tasks
{
  if index >= reading.inflows.length() {
    return Ok(Unit)
  }
  let block = map::exchange(mut reading.inflows[index].block, value: [])
  let fields = match mut reading.decoder.decode(block.slice(), list_limit: reading.header_limit) {
    Ok(fields) => own fields
    Err(error) => return Err(violation(compression_error, message: error.message.slice()))
  }
  if index >= reading.inflows.length() {
    return Ok(Unit)
  }
  let stream = reading.inflows[index].stream
  if reading.inflows[index].is_refused {
    let _ = mut reading.inflows.remove_at(index)
    var frame: List[UInt8] = []
    let code = window_increment(intrinsic::convert(refused_stream))
    frame_bytes(mut frame, kind: reset_frame, flags: 0, stream: stream, payload: code.slice())
    let _ = outbound.send(flow::Outbound.Frame(bytes: own frame))
    return Ok(Unit)
  }
  if !reading.inflows[index].has_headers {
    reading.inflows[index].has_headers = true
    let chunks = reading.inflows[index].chunks.copy()
    let cancelled = tasks::Channel[Unit].new()
    watch_stream(mut reading, stream: stream, cancelled: cancelled)
    let _ = arrivals.send(Arrival(stream: stream, fields: own fields, chunks: own chunks, outbound: outbound.copy(), cancelled: own cancelled))
  } else if !reading.inflows[index].is_ending {
    return Err(violation(protocol_error, message: "trailers that do not end the stream"))
  }
  if index < reading.inflows.length() && reading.inflows[index].is_ending {
    close_inflow(mut reading, index: index, chunk: flow::Chunk.End)
  }
  Ok(Unit)
}

fn serve_headers(reading: mut Reading, frame: own Frame, arrivals: tasks::Channel[Arrival], outbound: tasks::Channel[flow::Outbound]) -> Result[Unit, Failure]
  uses Tasks
{
  if frame.stream == 0 {
    return Err(violation(protocol_error, message: "HEADERS on stream zero"))
  }
  let fragment = block_of(frame)?
  let index = match inflow_index(reading.inflows.slice(), stream: frame.stream) {
    Some(index) => index
    None => {
      if frame.stream % 2 == 0 || frame.stream <= reading.last_stream {
        return Err(violation(stream_closed, message: "HEADERS on a stream that is not open"))
      }
      reading.last_stream = frame.stream
      let stream = frame.stream
      let is_going_away = reading.is_going_away
      let is_admitted = reading.admission.update(fn(admission) {
        if is_going_away || admission.is_draining || admission.active >= local_stream_limit {
          false
        } else {
          admission.last_stream = stream
          admission.active += 1
          true
        }
      })
      let is_refused = !is_admitted
      mut reading.inflows.push(Inflow(
        stream: frame.stream,
        chunks: tasks::Channel.new(capacity: 1024),
        block: [],
        has_headers: false,
        is_ending: false,
        is_refused: is_refused,
      ))
      reading.inflows.length() - 1
    }
  }
  if index >= reading.inflows.length() {
    return Ok(Unit)
  }
  mut reading.inflows[index].block.append(own fragment)
  if (frame.flags & end_stream) != 0 {
    reading.inflows[index].is_ending = true
  }
  if (frame.flags & end_headers) == 0 {
    reading.continuation = Some(frame.stream)
    return Ok(Unit)
  }
  complete_headers(mut reading, index: index, arrivals: arrivals, outbound: outbound)
}

fn serve_continuation(reading: mut Reading, frame: own Frame, arrivals: tasks::Channel[Arrival], outbound: tasks::Channel[flow::Outbound]) -> Result[Unit, Failure]
  uses Tasks
{
  let index = match inflow_index(reading.inflows.slice(), stream: frame.stream) {
    Some(index) => index
    None => return Err(violation(protocol_error, message: "CONTINUATION on a stream that is not open"))
  }
  if index >= reading.inflows.length() {
    return Ok(Unit)
  }
  mut reading.inflows[index].block.append(own frame.payload)
  if reading.inflows[index].block.length() > reading.header_limit {
    return Err(violation(protocol_error, message: "a header block larger than the limit"))
  }
  if (frame.flags & end_headers) != 0 {
    reading.continuation = None
    return complete_headers(mut reading, index: index, arrivals: arrivals, outbound: outbound)
  }
  Ok(Unit)
}

fn serve_data(reading: mut Reading, frame: own Frame, outbound: tasks::Channel[flow::Outbound]) -> Result[Unit, Failure]
  uses Tasks
{
  if frame.stream == 0 {
    return Err(violation(protocol_error, message: "DATA on stream zero"))
  }
  let length = frame.payload.length()
  let index = match inflow_index(reading.inflows.slice(), stream: frame.stream) {
    Some(index) => index
    None => {
      if frame.stream > reading.last_stream {
        return Err(violation(protocol_error, message: "DATA on a stream that is not open"))
      }
      if length > 0 {
        let _ = outbound.send(flow::Outbound.Credit(stream: 0, amount: length))
      }
      return Ok(Unit)
    }
  }
  if index >= reading.inflows.length() || !reading.inflows[index].has_headers {
    return Err(violation(protocol_error, message: "DATA before HEADERS"))
  }
  let data = strip_padding(frame.payload.slice(), flags: frame.flags, skip: 0)?
  let padding = length.saturating_subtract(data.length())
  if padding > 0 {
    let _ = outbound.send(flow::Outbound.Credit(stream: frame.stream, amount: padding))
  }
  let size = data.length()
  if size > 0 {
    if reading.inflows[index].chunks.send(flow::Chunk.Data(bytes: own data)) is Err(_) {
      let _ = outbound.send(flow::Outbound.Credit(stream: 0, amount: size))
    }
  }
  if (frame.flags & end_stream) != 0 {
    close_inflow(mut reading, index: index, chunk: flow::Chunk.End)
  }
  Ok(Unit)
}

fn serve_frame(reading: mut Reading, frame: own Frame, arrivals: tasks::Channel[Arrival], outbound: tasks::Channel[flow::Outbound]) -> Result[Unit, Failure]
  uses Tasks
{
  match reading.continuation {
    Some(stream) => {
      if frame.kind != continuation_frame || frame.stream != stream {
        return Err(violation(protocol_error, message: "a frame between HEADERS and its CONTINUATION"))
      }
    }
    None => {
      if frame.kind == continuation_frame {
        return Err(violation(protocol_error, message: "a CONTINUATION that does not follow HEADERS"))
      }
    }
  }
  let kind = frame.kind
  if kind == data_frame {
    serve_data(mut reading, frame: own frame, outbound: outbound)
  } else if kind == headers_frame {
    serve_headers(mut reading, frame: own frame, arrivals: arrivals, outbound: outbound)
  } else if kind == continuation_frame {
    serve_continuation(mut reading, frame: own frame, arrivals: arrivals, outbound: outbound)
  } else if kind == settings_frame {
    match parse_settings(frame)? {
      Some(settings) => {
        let _ = outbound.send(flow::Outbound.Settings(
          initial_window: settings.initial_window,
          frame_size: settings.frame_size,
          table_size: settings.table_size,
        ))
      }
      None => {}
    }
    Ok(Unit)
  } else if kind == window_frame {
    let increment = window_of(frame)?
    let _ = outbound.send(flow::Outbound.Window(stream: frame.stream, increment: increment))
    Ok(Unit)
  } else if kind == ping_frame {
    if frame.payload.length() != 8 || frame.stream != 0 {
      return Err(violation(frame_size_error, message: "a PING that is not eight bytes on stream zero"))
    }
    if (frame.flags & 1) == 0 {
      var reply: List[UInt8] = []
      frame_bytes(mut reply, kind: ping_frame, flags: 1, stream: 0, payload: frame.payload.slice())
      let _ = outbound.send(flow::Outbound.Frame(bytes: own reply))
    }
    Ok(Unit)
  } else if kind == reset_frame {
    if frame.payload.length() != 4 || frame.stream == 0 {
      return Err(violation(frame_size_error, message: "a RST_STREAM that is not four bytes on a stream"))
    }
    match inflow_index(reading.inflows.slice(), stream: frame.stream) {
      Some(index) => close_inflow(mut reading, index: index, chunk: flow::Chunk.Failed(message: "the client reset the stream"))
      None => {}
    }
    cancel_stream(mut reading, stream: frame.stream)
    let _ = outbound.send(flow::Outbound.Reset(stream: frame.stream))
    Ok(Unit)
  } else if kind == goaway_frame {
    reading.is_going_away = true
    Ok(Unit)
  } else if kind == push_frame {
    Err(violation(protocol_error, message: "a PUSH_PROMISE sent to a server"))
  } else {
    Ok(Unit)
  }
}

fn read_requests[Stream: streams::Duplex](
  stream: Stream,
  inbox: mut Inbox,
  reading: mut Reading,
  arrivals: tasks::Channel[Arrival],
  outbound: tasks::Channel[flow::Outbound],
) -> Failure
  uses Handles, Tasks
{
  var has_settings = false
  while true {
    let frame = match read_frame(stream, inbox: mut inbox) {
      Ok(frame) => own frame
      Err(System(TimedOut)) => {
        if reading.admission.read(fn(admission) { admission.active > 0 }) {
          continue
        }
        return Failure.System(error: SystemError.TimedOut)
      }
      Err(failure) => return own failure
    }
    if !has_settings && (frame.kind != settings_frame || (frame.flags & 1) != 0) {
      return violation(protocol_error, message: "a connection whose first frame is not SETTINGS")
    }
    has_settings = true
    match serve_frame(mut reading, frame: own frame, arrivals: arrivals, outbound: outbound) {
      Ok(_) => {}
      Err(failure) => return own failure
    }
  }
}

type Pending(bytes: List[UInt8], is_end: Bool, ack: tasks::Channel[Bool])

type Outflow(stream: UInt32, window: Int64, queue: List[Pending])

type Writing(
  encoder: hpack::Encoder,
  frame_size: USize,
  initial_window: Int64,
  connection_window: Int64,
  outflows: List[Outflow],
  is_closing: Bool,
)

fn outflow_index(outflows: Slice[Outflow], stream: UInt32) -> Option[USize] {
  for index in 0..outflows.length() {
    if outflows[index].stream == stream {
      return Some(index)
    }
  }
  None
}

fn smaller(first: Int64, second: Int64) -> Int64 {
  if first < second { first } else { second }
}

fn flush_outflow[Stream: streams::Duplex](stream: Stream, writing: mut Writing, index: USize) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  while index < writing.outflows.length() && !writing.outflows[index].queue.is_empty() {
    let id = writing.outflows[index].stream
    let window = smaller(writing.connection_window, second: writing.outflows[index].window)
    let total = writing.outflows[index].queue[0].bytes.length()
    let is_end = writing.outflows[index].queue[0].is_end
    if total > 0 && window <= 0 {
      return Ok(Unit)
    }
    var size = total
    if size > writing.frame_size {
      size = writing.frame_size
    }
    if total > 0 {
      let room: USize = intrinsic::convert(window)
      if size > room {
        size = room
      }
    }
    let is_whole = size == total
    let rest = mut writing.outflows[index].queue[0].bytes.split_off(size)
    let piece = map::exchange(mut writing.outflows[index].queue[0].bytes, value: own rest)
    send_frame(stream, kind: data_frame, flags: if is_whole && is_end { end_stream } else { 0 }, id: id, payload: piece.slice())?
    let used: Int64 = intrinsic::convert(piece.length())
    writing.connection_window = writing.connection_window.saturating_subtract(used)
    if index < writing.outflows.length() {
      writing.outflows[index].window = writing.outflows[index].window.saturating_subtract(used)
      if is_whole && !writing.outflows[index].queue.is_empty() {
        let done = mut writing.outflows[index].queue.remove_at(0)
        let _ = done.ack.send(true)
        if is_end {
          let _ = mut writing.outflows.remove_at(index)
          return Ok(Unit)
        }
      }
    }
  }
  Ok(Unit)
}

fn flush_all[Stream: streams::Duplex](stream: Stream, writing: mut Writing) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  var index: USize = 0
  while index < writing.outflows.length() {
    let before = writing.outflows.length()
    flush_outflow(stream, writing: mut writing, index: index)?
    if writing.outflows.length() == before {
      index += 1
    }
  }
  Ok(Unit)
}

fn abandon(outflow: own Outflow)
  uses Tasks
{
  for pending in outflow.queue {
    let _ = pending.ack.send(false)
  }
}

fn write_message[Stream: streams::Duplex](connection: Stream, writing: mut Writing, message: own flow::Outbound) -> Result[Unit, Failure]
  uses Handles, Tasks, Clock
{
  match own message {
    Head(stream, status, fields, is_end, ack) => {
      if writing.is_closing {
        let _ = ack.send(false)
        return Ok(Unit)
      }
      var all: List[hpack::Field] = [hpack::Field(name: ":status", value: "${status}")]
      var has_date = false
      for field in fields {
        let name = field.name.slice().to_ascii_lowercase()
        if name == "date" {
          has_date = true
        }
        mut all.push(hpack::Field(name: own name, value: field.value.copy()))
      }
      if !has_date {
        mut all.push(hpack::Field(name: "date", value: date::format(Clock.now())))
      }
      let block = mut writing.encoder.encode(all.slice())
      var start: USize = 0
      var is_first = true
      while is_first || start < block.length()
        invariant start <= block.length()
      {
        let stop = if block.length() - start > writing.frame_size { start + writing.frame_size } else { block.length() }
        let flags: UInt8 = (if stop == block.length() { end_headers } else { 0 }) | (if is_first && is_end { end_stream } else { 0 })
        send_frame(connection, kind: if is_first { headers_frame } else { continuation_frame }, flags: flags, id: stream, payload: block[start..stop])?
        start = stop
        is_first = false
      }
      if !is_end {
        mut writing.outflows.push(Outflow(stream: stream, window: writing.initial_window, queue: []))
      }
      let _ = ack.send(true)
    }
    Data(stream, bytes, is_end, ack) => {
      match outflow_index(writing.outflows.slice(), stream: stream) {
        Some(index) => {
          if writing.is_closing || index >= writing.outflows.length() {
            let _ = ack.send(false)
            return Ok(Unit)
          }
          mut writing.outflows[index].queue.push(Pending(bytes: own bytes, is_end: is_end, ack: ack.copy()))
          flush_outflow(connection, writing: mut writing, index: index)?
        }
        None => {
          let _ = ack.send(false)
        }
      }
    }
    Credit(stream, amount) => {
      if amount > 0 && !writing.is_closing {
        var frames: List[UInt8] = []
        let increment = window_increment(amount)
        if stream != 0 {
          frame_bytes(mut frames, kind: window_frame, flags: 0, stream: stream, payload: increment.slice())
        }
        frame_bytes(mut frames, kind: window_frame, flags: 0, stream: 0, payload: increment.slice())
        system(connection.send_all(frames.slice()))?
      }
    }
    Frame(bytes) => {
      if !writing.is_closing {
        system(connection.send_all(bytes.slice()))?
      }
    }
    Window(stream, increment) => {
      if stream == 0 {
        let updated = writing.connection_window.saturating_add(increment)
        if updated > largest_window {
          return Err(violation(flow_control_error, message: "a connection window larger than allowed"))
        }
        writing.connection_window = updated
        flush_all(connection, writing: mut writing)?
      } else {
        match outflow_index(writing.outflows.slice(), stream: stream) {
          Some(index) => {
            if index < writing.outflows.length() {
              writing.outflows[index].window = writing.outflows[index].window.saturating_add(increment)
              flush_outflow(connection, writing: mut writing, index: index)?
            }
          }
          None => {}
        }
      }
    }
    Settings(initial_window, frame_size, table_size) => {
      match initial_window {
        Some(window) => {
          let delta = window.saturating_subtract(writing.initial_window)
          writing.initial_window = window
          for index in 0..writing.outflows.length() {
            if index < writing.outflows.length() {
              writing.outflows[index].window = writing.outflows[index].window.saturating_add(delta)
            }
          }
        }
        None => {}
      }
      match frame_size {
        Some(size) => writing.frame_size = size
        None => {}
      }
      match table_size {
        Some(size) => mut writing.encoder.set_limit(size)
        None => {}
      }
      send_frame(connection, kind: settings_frame, flags: 1, id: 0, payload: [])?
      flush_all(connection, writing: mut writing)?
    }
    Reset(stream) => {
      match outflow_index(writing.outflows.slice(), stream: stream) {
        Some(index) => {
          if index < writing.outflows.length() {
            abandon(mut writing.outflows.remove_at(index))
          }
        }
        None => {}
      }
    }
    Drain(last_stream, ack) => {
      if !writing.is_closing {
        var payload: List[UInt8] = []
        push_u32(mut payload, value: last_stream)
        push_u32(mut payload, value: 0)
        let _ = send_frame(connection, kind: goaway_frame, flags: 0, id: 0, payload: payload.slice())
      }
      let _ = ack.send(true)
    }
    Goaway(last_stream, code) => {
      if !writing.is_closing {
        var payload: List[UInt8] = []
        push_u32(mut payload, value: last_stream)
        push_u32(mut payload, value: code)
        let _ = send_frame(connection, kind: goaway_frame, flags: 0, id: 0, payload: payload.slice())
      }
      writing.is_closing = true
      while !writing.outflows.is_empty() {
        abandon(mut writing.outflows.remove_at(0))
      }
    }
  }
  Ok(Unit)
}

fn write_responses[Stream: streams::Duplex](stream: Stream, outbound: tasks::Channel[flow::Outbound])
  uses Handles, Tasks, Clock
{
  var writing = Writing(
    encoder: hpack::Encoder.new(),
    frame_size: 16384,
    initial_window: 65535,
    connection_window: 65535,
    outflows: [],
    is_closing: false,
  )
  for message in outbound.messages() {
    match write_message(stream, writing: mut writing, message: own message) {
      Ok(_) => {}
      Err(_) => {
        writing.is_closing = true
        while !writing.outflows.is_empty() {
          abandon(mut writing.outflows.remove_at(0))
        }
      }
    }
  }
}

fn drain(admission: tasks::Cell[Admission], drained: tasks::Channel[Unit], outbound: tasks::Channel[flow::Outbound])
  uses Tasks
{
  let active = admission.update(fn(state) {
    state.is_draining = true
    state.active
  })
  let last_stream = admission.read(fn(state) { state.last_stream })
  let ack = tasks::Channel[Bool].new(capacity: 1)
  if outbound.send(flow::Outbound.Drain(last_stream: last_stream, ack: ack.copy())) is Ok(_) {
    let _ = ack.receive()
  }
  if active > 0 {
    let _ = drained.receive()
  }
}

internal fn serve[Stream: streams::Duplex, capability Granted](
  stream: Stream,
  inbox: own Inbox,
  header_limit: USize,
  stopping: tasks::Channel[Unit],
  respond: (fn(own Arrival) uses Granted),
)
  uses Tasks, Handles, Clock, Granted
{
  var opened = own inbox
  let opening = match take_bytes(stream, inbox: mut opened, count: 24) {
    Ok(bytes) => own bytes
    Err(_) => return
  }
  if opening.slice() != preface.slice().bytes() || open_connection(stream, is_server: true, header_limit: header_limit) is Err(_) {
    return
  }
  let arrivals = tasks::Channel[Arrival].new(capacity: 128)
  let outbound = tasks::Channel[flow::Outbound].new(capacity: 256)
  let admission = tasks::Cell[Admission].new(Admission(is_draining: false, last_stream: 0, active: 0))
  let drained = tasks::Channel[Unit].new()
  var reading = Reading(
    decoder: hpack::Decoder.new(),
    inflows: [],
    last_stream: 0,
    continuation: None,
    is_going_away: false,
    header_limit: header_limit,
    admission: admission.copy(),
    cancels: [],
  )
  concurrent {
    {
      let failure = read_requests(stream, inbox: mut opened, reading: mut reading, arrivals: arrivals, outbound: outbound)
      while !reading.inflows.is_empty() {
        close_inflow(mut reading, index: 0, chunk: flow::Chunk.Failed(message: "the connection closed"))
      }
      cancel_all(mut reading)
      let _ = outbound.send(flow::Outbound.Goaway(last_stream: reading.last_stream, code: failure_code(failure)))
      arrivals.close()
    }
    {
      concurrent for arrival in arrivals.messages() {
        let cancelled = arrival.cancelled.copy()
        respond(own arrival)
        cancelled.close()
        let is_drained = admission.update(fn(state) {
          if state.active > 0 {
            state.active -= 1
          }
          state.is_draining && state.active == 0
        })
        if is_drained {
          drained.close()
        }
      }
      outbound.close()
    }
    {
      write_responses(stream, outbound: outbound)
      return
    }
    {
      let _ = stopping.receive()
      drain(admission, drained: drained, outbound: outbound)
      return
    }
  }
}

type Outstream(
  stream: UInt32,
  block: List[UInt8],
  fields: List[hpack::Field],
  has_headers: Bool,
  data: List[UInt8],
  is_ended: Bool,
  is_ending: Bool,
  reset: Option[UInt32],
  send_window: Int64,
)

internal type Session[Stream: streams::Duplex](
  stream: Stream,
  inbox: Inbox,
  decoder: hpack::Decoder,
  encoder: hpack::Encoder,
  frame_size: USize,
  peer_window: Int64,
  send_window: Int64,
  outstreams: List[Outstream],
  next_stream: UInt32,
  continuation: Option[UInt32],
  is_going_away: Bool,
  header_limit: USize,
)

internal fn connect[Stream: streams::Duplex](stream: own Stream, header_limit: USize) -> Result[Session[Stream], Failure]
  uses Handles, Tasks
{
  open_connection(stream, is_server: false, header_limit: header_limit)?
  Ok(Session(
    stream: own stream,
    inbox: Inbox(bytes: []),
    decoder: hpack::Decoder.new(),
    encoder: hpack::Encoder.new(),
    frame_size: 16384,
    peer_window: 65535,
    send_window: 65535,
    outstreams: [],
    next_stream: 1,
    continuation: None,
    is_going_away: false,
    header_limit: header_limit,
  ))
}

fn outstream_index(outstreams: Slice[Outstream], stream: UInt32) -> Option[USize] {
  for index in 0..outstreams.length() {
    if outstreams[index].stream == stream {
      return Some(index)
    }
  }
  None
}

fn decode_response[Stream: streams::Duplex](session: mut Session[Stream], index: USize) -> Result[Unit, Failure] {
  if index >= session.outstreams.length() {
    return Ok(Unit)
  }
  let block = map::exchange(mut session.outstreams[index].block, value: [])
  let fields = match mut session.decoder.decode(block.slice(), list_limit: session.header_limit) {
    Ok(fields) => own fields
    Err(error) => return Err(violation(compression_error, message: error.message.slice()))
  }
  if index >= session.outstreams.length() {
    return Ok(Unit)
  }
  if session.outstreams[index].is_ending {
    session.outstreams[index].is_ended = true
  }
  if session.outstreams[index].has_headers {
    return Ok(Unit)
  }
  if fields.length() > 0 && fields[0].name == ":status" && fields[0].value.slice().starts_with("1") {
    return Ok(Unit)
  }
  session.outstreams[index].fields = own fields
  session.outstreams[index].has_headers = true
  Ok(Unit)
}

fn client_frame[Stream: streams::Duplex](session: mut Session[Stream], frame: own Frame) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  match session.continuation {
    Some(stream) => {
      if frame.kind != continuation_frame || frame.stream != stream {
        return Err(violation(protocol_error, message: "a frame between HEADERS and its CONTINUATION"))
      }
    }
    None => {
      if frame.kind == continuation_frame {
        return Err(violation(protocol_error, message: "a CONTINUATION that does not follow HEADERS"))
      }
    }
  }
  let kind = frame.kind
  if kind == data_frame {
    let length = frame.payload.length()
    match outstream_index(session.outstreams.slice(), stream: frame.stream) {
      Some(index) => {
        let data = strip_padding(frame.payload.slice(), flags: frame.flags, skip: 0)?
        if index < session.outstreams.length() {
          mut session.outstreams[index].data.append(own data)
          if (frame.flags & end_stream) != 0 {
            session.outstreams[index].is_ended = true
          }
        }
      }
      None => {
        if length > 0 {
          let increment = window_increment(length)
          send_frame(session.stream, kind: window_frame, flags: 0, id: 0, payload: increment.slice())?
        }
      }
    }
  } else if kind == headers_frame || kind == continuation_frame {
    let fragment = if kind == headers_frame { block_of(frame)? } else { frame.payload.copy() }
    match outstream_index(session.outstreams.slice(), stream: frame.stream) {
      Some(index) => {
        if index < session.outstreams.length() {
          mut session.outstreams[index].block.append(own fragment)
          if kind == headers_frame && (frame.flags & end_stream) != 0 {
            session.outstreams[index].is_ending = true
          }
          if session.outstreams[index].block.length() > session.header_limit {
            return Err(violation(protocol_error, message: "a header block larger than the limit"))
          }
        }
        if (frame.flags & end_headers) == 0 {
          session.continuation = Some(frame.stream)
        } else {
          session.continuation = None
          decode_response(mut session, index: index)?
        }
      }
      None => return Err(violation(stream_closed, message: "HEADERS on a stream that is not open"))
    }
  } else if kind == settings_frame {
    match parse_settings(frame)? {
      Some(settings) => {
        match settings.initial_window {
          Some(window) => {
            let delta = window.saturating_subtract(session.peer_window)
            session.peer_window = window
            for index in 0..session.outstreams.length() {
              if index < session.outstreams.length() {
                session.outstreams[index].send_window = session.outstreams[index].send_window.saturating_add(delta)
              }
            }
          }
          None => {}
        }
        match settings.frame_size {
          Some(size) => session.frame_size = size
          None => {}
        }
        match settings.table_size {
          Some(size) => mut session.encoder.set_limit(size)
          None => {}
        }
        send_frame(session.stream, kind: settings_frame, flags: 1, id: 0, payload: [])?
      }
      None => {}
    }
  } else if kind == window_frame {
    let increment = window_of(frame)?
    if frame.stream == 0 {
      session.send_window = session.send_window.saturating_add(increment)
    } else {
      match outstream_index(session.outstreams.slice(), stream: frame.stream) {
        Some(index) => {
          if index < session.outstreams.length() {
            session.outstreams[index].send_window = session.outstreams[index].send_window.saturating_add(increment)
          }
        }
        None => {}
      }
    }
  } else if kind == ping_frame {
    if frame.payload.length() != 8 || frame.stream != 0 {
      return Err(violation(frame_size_error, message: "a PING that is not eight bytes on stream zero"))
    }
    if (frame.flags & 1) == 0 {
      send_frame(session.stream, kind: ping_frame, flags: 1, id: 0, payload: frame.payload.slice())?
    }
  } else if kind == reset_frame {
    match outstream_index(session.outstreams.slice(), stream: frame.stream) {
      Some(index) => {
        if index < session.outstreams.length() {
          session.outstreams[index].reset = Some(u32_at(frame.payload.slice(), at: 0))
          session.outstreams[index].is_ended = true
        }
      }
      None => {}
    }
  } else if kind == goaway_frame {
    session.is_going_away = true
  } else if kind == push_frame {
    return Err(violation(protocol_error, message: "a PUSH_PROMISE, which this client disabled"))
  }
  Ok(Unit)
}

fn pump[Stream: streams::Duplex](session: mut Session[Stream]) -> Result[Unit, Failure]
  uses Handles, Tasks
{
  let frame = read_frame(session.stream, inbox: mut session.inbox)?
  client_frame(mut session, frame: own frame)
}

internal fn begin[Stream: streams::Duplex](
  session: mut Session[Stream],
  fields: Slice[hpack::Field],
  body: Slice[UInt8],
) -> Result[UInt32, Failure]
  uses Handles, Tasks
{
  if session.is_going_away || session.next_stream > 2147483645 {
    return Err(Failure.Closed)
  }
  let id = session.next_stream
  session.next_stream += 2
  mut session.outstreams.push(Outstream(
    stream: id,
    block: [],
    fields: [],
    has_headers: false,
    data: [],
    is_ended: false,
    is_ending: false,
    reset: None,
    send_window: session.peer_window,
  ))
  let block = mut session.encoder.encode(fields)
  var start: USize = 0
  var is_first = true
  while is_first || start < block.length()
    invariant start <= block.length()
  {
    let stop = if block.length() - start > session.frame_size { start + session.frame_size } else { block.length() }
    let flags: UInt8 = (if stop == block.length() { end_headers } else { 0 }) | (if is_first && body.is_empty() { end_stream } else { 0 })
    send_frame(session.stream, kind: if is_first { headers_frame } else { continuation_frame }, flags: flags, id: id, payload: block[start..stop])?
    start = stop
    is_first = false
  }
  var sent: USize = 0
  while sent < body.length() {
    let index = match outstream_index(session.outstreams.slice(), stream: id) {
      Some(index) => index
      None => return Err(Failure.Closed)
    }
    if index >= session.outstreams.length() {
      return Err(Failure.Closed)
    }
    match session.outstreams[index].reset {
      Some(code) => return Err(Failure.Reset(code: code))
      None => {}
    }
    let window = smaller(session.send_window, second: session.outstreams[index].send_window)
    if window <= 0 {
      pump(mut session)?
      continue
    }
    var size = body.length() - sent
    if size > session.frame_size {
      size = session.frame_size
    }
    let room: USize = intrinsic::convert(window)
    if size > room {
      size = room
    }
    let stop = sent + size
    let used: Int64 = intrinsic::convert(size)
    session.send_window = session.send_window.saturating_subtract(used)
    session.outstreams[index].send_window = session.outstreams[index].send_window.saturating_subtract(used)
    send_frame(session.stream, kind: data_frame, flags: if stop == body.length() { end_stream } else { 0 }, id: id, payload: body[sent..stop])?
    sent = stop
  }
  Ok(id)
}

internal fn head[Stream: streams::Duplex](session: mut Session[Stream], stream: UInt32) -> Result[List[hpack::Field], Failure]
  uses Handles, Tasks
{
  while true {
    let index = match outstream_index(session.outstreams.slice(), stream: stream) {
      Some(index) => index
      None => return Err(Failure.Closed)
    }
    if index >= session.outstreams.length() {
      return Err(Failure.Closed)
    }
    match session.outstreams[index].reset {
      Some(code) => return Err(Failure.Reset(code: code))
      None => {}
    }
    if session.outstreams[index].has_headers {
      return Ok(map::exchange(mut session.outstreams[index].fields, value: []))
    }
    if session.outstreams[index].is_ended {
      return Err(violation(protocol_error, message: "a response that ends before its headers"))
    }
    pump(mut session)?
  }
}

internal fn next_data[Stream: streams::Duplex](session: mut Session[Stream], stream: UInt32) -> Result[Option[List[UInt8]], Failure]
  uses Handles, Tasks
{
  while true {
    let index = match outstream_index(session.outstreams.slice(), stream: stream) {
      Some(index) => index
      None => return Ok(None)
    }
    if index >= session.outstreams.length() {
      return Ok(None)
    }
    match session.outstreams[index].reset {
      Some(code) => return Err(Failure.Reset(code: code))
      None => {}
    }
    if !session.outstreams[index].data.is_empty() {
      let data = map::exchange(mut session.outstreams[index].data, value: [])
      let is_ended = session.outstreams[index].is_ended
      var frames: List[UInt8] = []
      let increment = window_increment(data.length())
      if !is_ended {
        frame_bytes(mut frames, kind: window_frame, flags: 0, stream: stream, payload: increment.slice())
      }
      frame_bytes(mut frames, kind: window_frame, flags: 0, stream: 0, payload: increment.slice())
      system(session.stream.send_all(frames.slice()))?
      return Ok(Some(own data))
    }
    if session.outstreams[index].is_ended {
      let _ = mut session.outstreams.remove_at(index)
      return Ok(None)
    }
    pump(mut session)?
  }
}

internal fn release[Stream: streams::Duplex](session: mut Session[Stream], stream: UInt32)
  uses Handles, Tasks
{
  match outstream_index(session.outstreams.slice(), stream: stream) {
    Some(index) => {
      if index < session.outstreams.length() {
        let finished = mut session.outstreams.remove_at(index)
        if !finished.is_ended {
          let code = window_increment(8)
          let _ = send_frame(session.stream, kind: reset_frame, flags: 0, id: stream, payload: code.slice())
        }
      }
    }
    None => {}
  }
}

internal fn is_usable[Stream: streams::Duplex](session: Session[Stream]) -> Bool {
  !session.is_going_away && session.next_stream <= 2147483645
}
