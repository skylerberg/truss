use standard::collections
use standard::intrinsic
use standard::log
use standard::tasks

public type CorsPolicy(
  origins: List[String] = ["*"],
  methods: List[Method] = [Method.Get, Method.Head, Method.Post, Method.Put, Method.Patch, Method.Delete],
  headers: List[String] = ["content-type", "authorization"],
  exposed: List[String] = [],
  allow_credentials: Bool = false,
  max_age_seconds: Int64 = 600,
)
  derives Equal

fn allowed_origin(policy: CorsPolicy, origin: StringSlice) -> Option[String] {
  for allowed in policy.origins {
    if allowed == "*" {
      return Some(if policy.allow_credentials { origin.to_string() } else { "*" })
    }
    if allowed.slice() == origin {
      return Some(origin.to_string())
    }
  }
  None
}

fn joined(parts: Slice[String]) -> String {
  var text = ""
  for part in parts {
    if !text.is_empty() {
      mut text.push(", ")
    }
    mut text.push(part.slice())
  }
  text
}

public fn cors[capability Granted](
  request: own Request,
  responder: mut Responder,
  policy: CorsPolicy,
  next: (fn(own Request, mut Responder) uses Granted),
)
  uses Tasks, Granted
{
  let origin = match request.header("Origin") {
    Some(origin) => origin.to_string()
    None => {
      next(own request, mut responder)
      return
    }
  }
  mut responder.add_header("Vary", value: "Origin")
  let allowed = allowed_origin(policy, origin: origin.slice())
  let is_preflight = request.method == Method.Options && request.header("Access-Control-Request-Method") is Some(_)
  match allowed {
    Some(value) => {
      mut responder.set_header("Access-Control-Allow-Origin", value: value.slice())
      if policy.allow_credentials {
        mut responder.set_header("Access-Control-Allow-Credentials", value: "true")
      }
      if is_preflight {
        var methods: List[String] = []
        for method in policy.methods {
          mut methods.push("${method}")
        }
        mut responder.set_header("Access-Control-Allow-Methods", value: joined(methods.slice()).slice())
        mut responder.set_header("Access-Control-Allow-Headers", value: joined(policy.headers.slice()).slice())
        mut responder.set_header("Access-Control-Max-Age", value: "${policy.max_age_seconds}".slice())
        let _ = mut responder.send(Response.new(status: Status.no_content))
        return
      }
      if !policy.exposed.is_empty() {
        mut responder.set_header("Access-Control-Expose-Headers", value: joined(policy.exposed.slice()).slice())
      }
    }
    None => {
      if is_preflight {
        let _ = mut responder.send(Response.new(status: Status.no_content))
        return
      }
    }
  }
  next(own request, mut responder)
}

public type SecurityPolicy(
  content_security_policy: Option[String] = Some("default-src 'self'"),
  frame_options: Option[String] = Some("DENY"),
  referrer_policy: Option[String] = Some("strict-origin-when-cross-origin"),
  transport_security_seconds: Option[Int64] = Some(31536000),
  opener_policy: Option[String] = Some("same-origin"),
)
  derives Equal

public fn secure_headers[capability Granted](
  request: own Request,
  responder: mut Responder,
  next: (fn(own Request, mut Responder) uses Granted),
  policy: SecurityPolicy = SecurityPolicy(),
)
  uses Granted
{
  mut responder.set_header("X-Content-Type-Options", value: "nosniff")
  match policy.content_security_policy {
    Some(value) => mut responder.set_header("Content-Security-Policy", value: value.slice())
    None => {}
  }
  match policy.frame_options {
    Some(value) => mut responder.set_header("X-Frame-Options", value: value.slice())
    None => {}
  }
  match policy.referrer_policy {
    Some(value) => mut responder.set_header("Referrer-Policy", value: value.slice())
    None => {}
  }
  match policy.transport_security_seconds {
    Some(seconds) => mut responder.set_header("Strict-Transport-Security", value: "max-age=${seconds}; includeSubDomains".slice())
    None => {}
  }
  match policy.opener_policy {
    Some(value) => mut responder.set_header("Cross-Origin-Opener-Policy", value: value.slice())
    None => {}
  }
  next(own request, mut responder)
}

fn is_request_id(text: StringSlice) -> Bool {
  if text.is_empty() || text.length() > 128 {
    return false
  }
  for byte in text.bytes() {
    let is_allowed = (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 45 || byte == 95 || byte == 46
    if !is_allowed {
      return false
    }
  }
  true
}

public fn request_id[capability Granted](
  request: own Request,
  responder: mut Responder,
  next: (fn(own Request, mut Responder) uses Granted),
)
  uses Random, Granted
{
  var incoming = own request
  let id = match incoming.header("X-Request-ID") {
    Some(given) => if is_request_id(given) { given.to_string() } else { Random.next().format(radix: 16, minimum_digits: 16) }
    None => Random.next().format(radix: 16, minimum_digits: 16)
  }
  mut incoming.headers.set("X-Request-ID", value: id.slice())
  mut responder.set_header("X-Request-ID", value: id.slice())
  next(own incoming, mut responder)
}

public fn log_requests[capability Granted](
  request: own Request,
  responder: mut Responder,
  next: (fn(own Request, mut Responder) uses Granted),
)
  uses Clock, Log, Granted
{
  let started = Clock.monotonic()
  let method = "${request.method}"
  let path = request.path().to_string()
  let id = match request.header("X-Request-ID") {
    Some(given) => given.to_string()
    None => ""
  }
  next(own request, mut responder)
  let elapsed = Clock.monotonic() - started
  let code: Int64 = match responder.status() {
    Some(status) => intrinsic::convert(status.code)
    None => 200
  }
  var fields: List[log::Field] = [
    log::Field.string("method", value: method.slice()),
    log::Field.string("path", value: path.slice()),
    log::Field.integer("status", value: code),
    log::Field.integer("bytes", value: intrinsic::convert(responder.bytes_sent() & 9223372036854775807)),
    log::Field.duration("duration", value: elapsed),
  ]
  if !id.is_empty() {
    mut fields.push(log::Field.string("request_id", value: id.slice()))
  }
  log::information("request", fields: own fields)
}

public fn Request.with_body_limit(own self, bytes: USize) -> Request {
  var limited = own self
  if bytes < limited.body.limit {
    limited.body.limit = bytes
  }
  limited
}

public type RateLimit(requests: UInt64 = 60, per_seconds: Int64 = 60, burst: UInt64 = 0, keys: USize = 10000)
  derives Equal

type Rates(milli_capacity: Int64, requests: Int64, per_seconds: Int64)

fn rates_of(policy: RateLimit) -> Rates
  ensures result.requests >= 1 && result.requests <= 1000000000
  ensures result.per_seconds >= 1 && result.per_seconds <= 31536000
  ensures result.milli_capacity >= 1000 && result.milli_capacity <= 1000000000000
{
  let requests: Int64 = if policy.requests < 1 { 1 } else if policy.requests > 1000000000 { 1000000000 } else { intrinsic::convert(policy.requests) }
  let per_seconds: Int64 = if policy.per_seconds < 1 { 1 } else if policy.per_seconds > 31536000 { 31536000 } else { policy.per_seconds }
  let burst: Int64 = if policy.burst < 1 { requests } else if policy.burst > 1000000000 { 1000000000 } else { intrinsic::convert(policy.burst) }
  Rates(milli_capacity: burst * 1000, requests: requests, per_seconds: per_seconds)
}

type Bucket(milli_tokens: Int64, updated_milliseconds: Int64)
  derives Equal

public type Decision =
  | Allowed(remaining: UInt64)
  | Limited(retry_after_seconds: Int64)
  derives Equal

public opaque type RateLimiter(policy: RateLimit, buckets: tasks::Cell[collections::LruCache[String, Bucket]])

public fn RateLimiter.new(policy: RateLimit = RateLimit()) -> RateLimiter {
  let keys = if policy.keys < 1 { 1 } else { policy.keys }
  RateLimiter(policy: policy, buckets: tasks::Cell.new(collections::LruCache[String, Bucket].new(keys)))
}

public fn RateLimiter.copy(self) -> RateLimiter {
  RateLimiter(policy: self.policy, buckets: self.buckets.copy())
}

fn refilled(bucket: Bucket, policy: RateLimit, now: Int64) -> Bucket {
  let rates = rates_of(policy)
  let elapsed = if now > bucket.updated_milliseconds { now.saturating_subtract(bucket.updated_milliseconds) } else { 0 }
  let gained = elapsed.saturating_multiply(rates.requests) / rates.per_seconds
  let tokens = bucket.milli_tokens.saturating_add(gained)
  Bucket(milli_tokens: if tokens > rates.milli_capacity { rates.milli_capacity } else { tokens }, updated_milliseconds: now)
}

fn full(policy: RateLimit, now: Int64) -> Bucket {
  Bucket(milli_tokens: rates_of(policy).milli_capacity, updated_milliseconds: now)
}

fn wait_seconds(milli_tokens: Int64, policy: RateLimit) -> Int64 {
  let rates = rates_of(policy)
  let missing = if milli_tokens >= 1000 { 0 } else if milli_tokens <= 0 { 1000 } else { 1000 - milli_tokens }
  let wait_milliseconds = (missing * rates.per_seconds + rates.requests - 1) / rates.requests
  (wait_milliseconds + 999) / 1000
}

public fn RateLimiter.take(self, key: StringSlice) -> Decision
  uses Tasks, Clock
{
  let now = Clock.monotonic().total_milliseconds()
  let policy = self.policy
  let name = key.to_string()
  self.buckets.update(fn(buckets) {
    let current = match mut buckets.get(name.copy()) {
      Some(bucket) => refilled(bucket, policy: policy, now: now)
      None => full(policy, now: now)
    }
    if current.milli_tokens >= 1000 {
      let left = current.milli_tokens - 1000
      let _ = mut buckets.insert(name.copy(), value: Bucket(milli_tokens: left, updated_milliseconds: now))
      let whole: UInt64 = intrinsic::convert(left / 1000)
      Decision.Allowed(remaining: whole)
    } else {
      let _ = mut buckets.insert(name.copy(), value: current)
      Decision.Limited(retry_after_seconds: wait_seconds(current.milli_tokens, policy: policy))
    }
  })
}

public fn peer_key(request: Request) -> String {
  match request.peer {
    Some(peer) => "${peer.address}"
    None => ""
  }
}

public fn rate_limit[capability Granted](
  request: own Request,
  responder: mut Responder,
  limiter: RateLimiter,
  key: fn(Request) -> String,
  next: (fn(own Request, mut Responder) uses Granted),
)
  uses Tasks, Clock, Granted
{
  match limiter.take(key(request).slice()) {
    Allowed(_) => next(own request, mut responder)
    Limited(retry_after_seconds) => {
      var response = Response.text(Status.too_many_requests.reason(), status: Status.too_many_requests)
      mut response.headers.set("Retry-After", value: "${retry_after_seconds}".slice())
      let _ = mut responder.send(own response)
    }
  }
}

public type CsrfPolicy(trusted_origins: List[String] = [])
  derives Equal

fn is_safe_method(method: Method) -> Bool {
  method == Method.Get || method == Method.Head || method == Method.Options
}

fn is_trusted_origin(policy: CsrfPolicy, origin: StringSlice) -> Bool {
  for trusted in policy.trusted_origins {
    if same_name(trusted.slice(), second: origin) {
      return true
    }
  }
  false
}

fn host_of_origin(origin: StringSlice) -> Option[StringSlice] {
  let rest = match origin.find("://") {
    Some(at) => origin.split_at(at).second.strip_prefix("://").unwrap_or("")
    None => return None
  }
  if rest.is_empty() || rest.contains("/") { None } else { Some(rest) }
}

fn is_cross_origin(request: Request, policy: CsrfPolicy) -> Bool {
  if is_safe_method(request.method) {
    return false
  }
  match request.header("Sec-Fetch-Site") {
    Some(site) => {
      if same_name(site, second: "same-origin") || same_name(site, second: "none") {
        return false
      }
      return match request.header("Origin") {
        Some(origin) => !is_trusted_origin(policy, origin: origin)
        None => true
      }
    }
    None => {}
  }
  let origin = match request.header("Origin") {
    Some(origin) => origin
    None => return false
  }
  if is_trusted_origin(policy, origin: origin) {
    return false
  }
  match host_of_origin(origin), request.header("Host") {
    Some(origin_host), Some(host) => !same_name(origin_host, second: host)
    _, _ => true
  }
}

public fn csrf[capability Granted](
  request: own Request,
  responder: mut Responder,
  policy: CsrfPolicy,
  next: (fn(own Request, mut Responder) uses Granted),
)
  uses Tasks, Granted
{
  if is_cross_origin(request, policy: policy) {
    let _ = mut responder.send(Response.text("cross-origin request refused", status: Status.forbidden))
    return
  }
  next(own request, mut responder)
}
