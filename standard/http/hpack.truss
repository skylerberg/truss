let huffman_counts: Array[UInt16, 31] = [0, 0, 0, 0, 0, 10, 26, 32, 6, 0, 5, 3, 2, 6, 2, 3, 0, 0, 0, 3, 8, 13, 26, 29, 12, 4, 15, 19, 29, 0, 4]

let huffman_offsets: Array[UInt16, 31] = [0, 0, 0, 0, 0, 0, 10, 36, 68, 74, 74, 79, 82, 84, 90, 92, 95, 95, 95, 95, 98, 106, 119, 145, 174, 186, 190, 205, 224, 253, 253]

fn entry_size(name: StringSlice, value: StringSlice) -> USize {
  name.length().saturating_add(value.length()).saturating_add(32)
}

type Table(entries: List[Field], size: USize, limit: USize)

fn evict(table: mut Table) {
  while table.size > table.limit && !table.entries.is_empty() {
    let oldest = mut table.entries.remove_at(0)
    table.size = table.size.saturating_subtract(entry_size(oldest.name.slice(), value: oldest.value.slice()))
  }
  if table.entries.is_empty() {
    table.size = 0
  }
}

fn insert(table: mut Table, name: StringSlice, value: StringSlice) {
  let size = entry_size(name, value: value)
  if size > table.limit {
    mut table.entries.clear()
    table.size = 0
    return
  }
  table.size = table.size.saturating_add(size)
  mut table.entries.push(Field(name: name.to_string(), value: value.to_string()))
  evict(mut table)
}

fn resize(table: mut Table, limit: USize) {
  table.limit = limit
  evict(mut table)
}

fn entry_name(table: Table, index: USize) -> Result[String, Error] {
  if index == 0 {
    return Err(failure("a header index of zero"))
  }
  if index <= 61 {
    return Ok(static_names[index - 1].copy())
  }
  let position = index - 62
  if position >= table.entries.length() {
    return Err(failure("a header index past the end of the table"))
  }
  Ok(table.entries[table.entries.length() - 1 - position].name.copy())
}

fn entry_value(table: Table, index: USize) -> Result[String, Error] {
  if index == 0 {
    return Err(failure("a header index of zero"))
  }
  if index <= 61 {
    return Ok(static_values[index - 1].copy())
  }
  let position = index - 62
  if position >= table.entries.length() {
    return Err(failure("a header index past the end of the table"))
  }
  Ok(table.entries[table.entries.length() - 1 - position].value.copy())
}

fn read_integer(block: Slice[UInt8], at: mut USize, prefix_bits: USize) -> Result[USize, Error] {
  if at >= block.length() || prefix_bits == 0 || prefix_bits > 8 {
    return Err(failure("a header block that ends early"))
  }
  let mask: USize = (1 << prefix_bits) - 1
  var value = intrinsic::convert[UInt8, USize](block[at]) & mask
  at += 1
  if value < mask {
    return Ok(value)
  }
  var shift: USize = 0
  while at < block.length() {
    let byte = intrinsic::convert[UInt8, USize](block[at])
    at += 1
    if shift > 21 {
      return Err(failure("an integer that is too large"))
    }
    value = value.saturating_add((byte & 127) << shift)
    shift += 7
    if (byte & 128) == 0 {
      return Ok(value)
    }
  }
  Err(failure("a header block that ends early"))
}

fn huffman_decode(bytes: Slice[UInt8]) -> Result[List[UInt8], Error] {
  var output: List[UInt8] = List.with_capacity(bytes.length())
  var code: UInt32 = 0
  var length: USize = 0
  let width: USize = 8
  for byte in bytes {
    for bit_index in 0..width {
      let bit: UInt32 = intrinsic::convert((byte >> (7 - bit_index)) & 1)
      code = ((code << 1) & 1073741823) | bit
      length = length.saturating_add(1)
      if length > 30 {
        return Err(failure("a Huffman code that is too long"))
      }
      let first = huffman_first_codes[length]
      let count: UInt32 = intrinsic::convert(huffman_counts[length])
      if code >= first && code - first < count {
        let position = intrinsic::convert[UInt16, USize](huffman_offsets[length]) + intrinsic::convert[UInt32, USize](code - first)
        if position >= 257 {
          return Err(failure("a Huffman code that is not in the table"))
        }
        let symbol = huffman_symbols[position]
        if symbol >= 256 {
          return Err(failure("a Huffman string that holds the end-of-string code"))
        }
        mut output.push(intrinsic::convert(symbol))
        code = 0
        length = 0
      }
    }
  }
  if length > 7 || code != (1 << length) - 1 {
    return Err(failure("a Huffman string whose padding is not the end-of-string code's prefix"))
  }
  Ok(own output)
}

fn huffman_length(bytes: Slice[UInt8]) -> USize {
  var bits: USize = 0
  for byte in bytes {
    bits = bits.saturating_add(intrinsic::convert(huffman_lengths[intrinsic::convert[UInt8, USize](byte)]))
  }
  bits.saturating_add(7) / 8
}

fn huffman_encode(output: mut List[UInt8], bytes: Slice[UInt8]) {
  var pending: UInt64 = 0
  var bits: USize = 0
  for byte in bytes {
    let symbol: USize = intrinsic::convert(byte)
    let length: USize = intrinsic::convert(huffman_lengths[symbol])
    let code: UInt64 = intrinsic::convert(huffman_codes[symbol])
    if bits > 7 || length > 30 {
      return
    }
    pending = (pending << length) | code
    bits += length
    while bits >= 8
      invariant bits <= 37
    {
      bits -= 8
      mut output.push(intrinsic::convert((pending >> bits) & 255))
    }
    pending = pending & ((1 << bits) - 1)
  }
  if bits > 0 && bits < 8 {
    let fill: USize = 8 - bits
    mut output.push(intrinsic::convert(((pending << fill) | (255 >> bits)) & 255))
  }
}

fn read_string(block: Slice[UInt8], at: mut USize) -> Result[String, Error] {
  if at >= block.length() {
    return Err(failure("a header block that ends early"))
  }
  let is_huffman = (block[at] & 128) != 0
  let length = read_integer(block, at: mut at, prefix_bits: 7)?
  if at > block.length() || length > block.length() - at {
    return Err(failure("a string longer than its header block"))
  }
  let raw = block[at..at + length]
  at += length
  let bytes = if is_huffman { huffman_decode(raw)? } else { raw.to_list() }
  match String.from_utf8(own bytes) {
    Ok(text) => Ok(own text)
    Err(_) => Err(failure("a header that is not UTF-8"))
  }
}

public opaque type Decoder(table: Table, maximum: USize)

public fn Decoder.new(limit: USize = 4096) -> Decoder {
  Decoder(table: Table(entries: [], size: 0, limit: limit), maximum: limit)
}

public fn Decoder.decode(mut self, block: Slice[UInt8], list_limit: USize = 65536) -> Result[List[Field], Error] {
  decode_block(mut self.table, maximum: self.maximum, block: block, list_limit: list_limit)
}

fn decode_block(table: mut Table, maximum: USize, block: Slice[UInt8], list_limit: USize) -> Result[List[Field], Error] {
  var fields: List[Field] = []
  var list_size: USize = 0
  var at: USize = 0
  while at < block.length() {
    let first = block[at]
    if (first & 128) != 0 {
      let index = read_integer(block, at: mut at, prefix_bits: 7)?
      let name = entry_name(table, index: index)?
      let value = entry_value(table, index: index)?
      list_size = list_size.saturating_add(entry_size(name.slice(), value: value.slice()))
      mut fields.push(Field(name: own name, value: own value))
    } else if (first & 224) == 32 {
      if !fields.is_empty() {
        return Err(failure("a table size update after the first field"))
      }
      let limit = read_integer(block, at: mut at, prefix_bits: 5)?
      if limit > maximum {
        return Err(failure("a table size update above the advertised limit"))
      }
      resize(mut table, limit: limit)
    } else {
      let is_indexed = (first & 64) != 0
      let is_sensitive = !is_indexed && (first & 16) != 0
      let index = read_integer(block, at: mut at, prefix_bits: if is_indexed { 6 } else { 4 })?
      let name = if index == 0 { read_string(block, at: mut at)? } else { entry_name(table, index: index)? }
      let value = read_string(block, at: mut at)?
      if is_indexed {
        insert(mut table, name: name.slice(), value: value.slice())
      }
      list_size = list_size.saturating_add(entry_size(name.slice(), value: value.slice()))
      mut fields.push(Field(name: own name, value: own value, is_sensitive: is_sensitive))
    }
    if list_size > list_limit {
      return Err(failure("a header list larger than the limit"))
    }
  }
  Ok(own fields)
}

fn write_integer(output: mut List[UInt8], flags: UInt8, prefix_bits: USize, value: USize) {
  if prefix_bits == 0 || prefix_bits > 8 {
    return
  }
  let mask: USize = (1 << prefix_bits) - 1
  if value < mask {
    mut output.push(flags | intrinsic::convert(value & 255))
    return
  }
  mut output.push(flags | intrinsic::convert(mask & 255))
  var rest = value - mask
  while rest >= 128 {
    mut output.push(intrinsic::convert((rest & 127) | 128))
    rest = rest >> 7
  }
  mut output.push(intrinsic::convert(rest & 255))
}

fn write_string(output: mut List[UInt8], text: StringSlice) {
  let bytes = text.bytes()
  let compressed = huffman_length(bytes)
  if compressed < bytes.length() {
    write_integer(mut output, flags: 128, prefix_bits: 7, value: compressed)
    huffman_encode(mut output, bytes: bytes)
  } else {
    write_integer(mut output, flags: 0, prefix_bits: 7, value: bytes.length())
    mut output.append_slice(bytes)
  }
}

public opaque type Encoder(table: Table, pending_limit: Option[USize])

public fn Encoder.new(limit: USize = 4096) -> Encoder {
  Encoder(table: Table(entries: [], size: 0, limit: limit), pending_limit: None)
}

public fn Encoder.set_limit(mut self, limit: USize) {
  let bounded = if limit > 4096 { 4096 } else { limit }
  if bounded != self.table.limit {
    self.pending_limit = Some(bounded)
  }
}

public fn Encoder.encode(mut self, fields: Slice[Field]) -> List[UInt8] {
  var output: List[UInt8] = []
  match self.pending_limit {
    Some(limit) => {
      resize(mut self.table, limit: limit)
      write_integer(mut output, flags: 32, prefix_bits: 5, value: limit)
    }
    None => {}
  }
  self.pending_limit = None
  for field in fields {
    encode_field(mut output, table: mut self.table, field: field)
  }
  output
}

fn is_never_indexed(field: Field) -> Bool {
  field.is_sensitive || field.name == "authorization" || field.name == "proxy-authorization"
}

fn encode_field(output: mut List[UInt8], table: mut Table, field: Field) {
  let sensitive = is_never_indexed(field)
  var name_index: USize = 0
  let static_count: USize = 61
  for index in 0..static_count {
    if static_names[index] == field.name {
      if !sensitive && static_values[index] == field.value {
        write_integer(mut output, flags: 128, prefix_bits: 7, value: index + 1)
        return
      }
      if name_index == 0 {
        name_index = index + 1
      }
    }
  }
  let count = table.entries.length()
  for position in 0..count {
    let entry = table.entries[count - 1 - position]
    if entry.name == field.name {
      if !sensitive && entry.value == field.value {
        write_integer(mut output, flags: 128, prefix_bits: 7, value: position.saturating_add(62))
        return
      }
      if name_index == 0 {
        name_index = position.saturating_add(62)
      }
    }
  }
  let is_indexed = !sensitive && entry_size(field.name.slice(), value: field.value.slice()) <= table.limit
  if is_indexed {
    write_integer(mut output, flags: 64, prefix_bits: 6, value: name_index)
  } else {
    write_integer(mut output, flags: if sensitive { 16 } else { 0 }, prefix_bits: 4, value: name_index)
  }
  if name_index == 0 {
    write_string(mut output, text: field.name.slice())
  }
  write_string(mut output, text: field.value.slice())
  if is_indexed {
    insert(mut table, name: field.name.slice(), value: field.value.slice())
  }
}
