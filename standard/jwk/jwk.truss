use standard::base64
use standard::cryptography
use standard::json

public type Error(message: String)
  derives Equal

impl Display for Error {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write("JWK: ")
    mut output.write(self.message.slice())
  }
}

fn failure(message: StringSlice) -> Error {
  Error(message: message.to_string())
}

public type Material =
  | Secret(bytes: List[UInt8])
  | RsaPublic(key: cryptography::RsaPublicKey)
  | RsaPrivate(key: cryptography::RsaPrivateKey)
  | EcPublic(key: cryptography::EcdsaVerifyingKey)
  | EcPrivate(key: cryptography::EcdsaSigningKey)
  | Ed25519Public(key: cryptography::VerifyingKey)
  | Ed25519Private(key: cryptography::SigningKey)

public type Key(material: Material, id: Option[String] = None, algorithm: Option[String] = None, usage: Option[String] = None)

public type KeySet(keys: List[Key])

internal fn encoded(bytes: Slice[UInt8]) -> String {
  base64::encode(bytes, alphabet: base64::Alphabet.UrlSafe, padding: false)
}

internal fn decoded(text: StringSlice) -> Result[List[UInt8], Error] {
  match base64::decode(text, alphabet: base64::Alphabet.UrlSafe) {
    Ok(bytes) => Ok(own bytes)
    Err(_) => Err(failure("a member that is not base64url"))
  }
}

fn text_of(value: json::Value, name: StringSlice) -> Option[String] {
  match value.get(name) {
    Some(member) => match member.as_text() {
      Some(text) => Some(text.to_string())
      None => None
    }
    None => None
  }
}

fn bytes_of(value: json::Value, name: StringSlice) -> Result[List[UInt8], Error] {
  match text_of(value, name: name) {
    Some(text) => decoded(text.slice())
    None => Err(Error(message: "a key without its \"${name}\" member"))
  }
}

fn curve_named(name: StringSlice) -> Result[cryptography::Curve, Error] {
  if name == "P-256".slice() {
    Ok(cryptography::Curve.P256)
  } else if name == "P-384".slice() {
    Ok(cryptography::Curve.P384)
  } else {
    Err(Error(message: "the curve ${name}, which is not supported"))
  }
}

fn curve_name(curve: cryptography::Curve) -> StringSlice {
  match curve {
    P256 => "P-256".slice()
    P384 => "P-384".slice()
  }
}

fn array_32(bytes: Slice[UInt8]) -> Result[Array[UInt8, 32], Error] {
  if bytes.length() != 32 {
    return Err(failure("an Ed25519 key that is not 32 bytes"))
  }
  var array: Array[UInt8, 32] = Array.filled(0)
  let width: USize = 32
  for index in 0..width {
    array[index] = bytes[index]
  }
  Ok(array)
}

fn material_of(value: json::Value) -> Result[Material, Error]
  uses Panic
{
  let kind = match text_of(value, name: "kty") {
    Some(kind) => own kind
    None => return Err(failure("a key without \"kty\""))
  }
  let is_private = value.get("d") is Some(_)
  if kind == "oct" {
    return Ok(Material.Secret(bytes: bytes_of(value, name: "k")?))
  }
  if kind == "RSA" {
    let modulus = bytes_of(value, name: "n")?
    let exponent = bytes_of(value, name: "e")?
    let public_key = match cryptography::RsaPublicKey.new(modulus.slice(), exponent: exponent.slice()) {
      Some(key) => key
      None => return Err(failure("an RSA key whose modulus or exponent cannot be used"))
    }
    if !is_private {
      return Ok(Material.RsaPublic(key: own public_key))
    }
    let private_key = cryptography::RsaPrivateKey.new(
      public_key,
      exponent: bytes_of(value, name: "d")?.slice(),
      first_prime: bytes_of(value, name: "p")?.slice(),
      second_prime: bytes_of(value, name: "q")?.slice(),
      first_exponent: bytes_of(value, name: "dp")?.slice(),
      second_exponent: bytes_of(value, name: "dq")?.slice(),
      coefficient: bytes_of(value, name: "qi")?.slice(),
    )
    return match own private_key {
      Some(key) => Ok(Material.RsaPrivate(key: own key))
      None => Err(failure("an RSA private key whose parts do not agree"))
    }
  }
  if kind == "EC" {
    let curve = curve_named(text_of(value, name: "crv").unwrap_or("").slice())?
    let x = bytes_of(value, name: "x")?
    let y = bytes_of(value, name: "y")?
    var point: List[UInt8] = [4]
    mut point.append_slice(x.slice())
    mut point.append_slice(y.slice())
    let public_key = match cryptography::EcdsaVerifyingKey.from_sec1(curve, bytes: point.slice()) {
      Some(key) => key
      None => return Err(failure("an EC key that is not a point on its curve"))
    }
    if !is_private {
      return Ok(Material.EcPublic(key: own public_key))
    }
    let scalar = bytes_of(value, name: "d")?
    return match cryptography::EcdsaSigningKey.from_scalar(curve, bytes: scalar.slice()) {
      Some(key) => {
        if key.verifying_key() != public_key {
          return Err(failure("an EC private key that does not match its public point"))
        }
        Ok(Material.EcPrivate(key: key.copy()))
      }
      None => Err(failure("an EC private key that is not a valid scalar"))
    }
  }
  if kind == "OKP" {
    if text_of(value, name: "crv") != Some("Ed25519") {
      return Err(failure("an OKP key on a curve other than Ed25519"))
    }
    let x = array_32(bytes_of(value, name: "x")?.slice())?
    if !is_private {
      return match cryptography::VerifyingKey.from_bytes(x) {
        Some(key) => Ok(Material.Ed25519Public(key: key))
        None => Err(failure("an Ed25519 public key that is not a point"))
      }
    }
    let seed = array_32(bytes_of(value, name: "d")?.slice())?
    let key = cryptography::SigningKey.from_seed(seed)
    if key.verifying_key().bytes() != x {
      return Err(failure("an Ed25519 private key that does not match its public key"))
    }
    return Ok(Material.Ed25519Private(key: own key))
  }
  Err(Error(message: "the key type ${kind}, which is not supported"))
}

public fn Key.from_value(value: json::Value) -> Result[Key, Error]
  uses Panic
{
  if value.as_members() is None {
    return Err(failure("a key that is not a JSON object"))
  }
  Ok(Key(
    material: material_of(value)?,
    id: text_of(value, name: "kid"),
    algorithm: text_of(value, name: "alg"),
    usage: text_of(value, name: "use"),
  ))
}

public fn Key.parse(text: StringSlice) -> Result[Key, Error]
  uses Panic
{
  match json::parse(text) {
    Ok(value) => Key.from_value(value)
    Err(_) => Err(failure("a key that is not JSON"))
  }
}

fn put(members: mut Map[String, json::Value], name: StringSlice, text: StringSlice) {
  mut members.insert(name.to_string(), value: json::Value.String(value: text.to_string()))
}

fn put_bytes(members: mut Map[String, json::Value], name: StringSlice, bytes: Slice[UInt8]) {
  put(mut members, name: name, text: encoded(bytes).slice())
}

public fn Key.to_value(self) -> json::Value
  uses Panic
{
  var members: Map[String, json::Value] = [:]
  match self.material {
    Secret(bytes) => {
      put(mut members, name: "kty", text: "oct")
      put_bytes(mut members, name: "k", bytes: bytes.slice())
    }
    RsaPublic(key) => {
      put(mut members, name: "kty", text: "RSA")
      put_bytes(mut members, name: "n", bytes: key.modulus())
      put_bytes(mut members, name: "e", bytes: key.exponent())
    }
    RsaPrivate(key) => {
      let public_key = key.public_key()
      let parts = key.expose_parts()
      put(mut members, name: "kty", text: "RSA")
      put_bytes(mut members, name: "n", bytes: public_key.modulus())
      put_bytes(mut members, name: "e", bytes: public_key.exponent())
      put_bytes(mut members, name: "d", bytes: parts.exponent.slice())
      put_bytes(mut members, name: "p", bytes: parts.first_prime.slice())
      put_bytes(mut members, name: "q", bytes: parts.second_prime.slice())
      put_bytes(mut members, name: "dp", bytes: parts.first_exponent.slice())
      put_bytes(mut members, name: "dq", bytes: parts.second_exponent.slice())
      put_bytes(mut members, name: "qi", bytes: parts.coefficient.slice())
    }
    EcPublic(key) => put_point(mut members, key: key)
    EcPrivate(key) => {
      put_point(mut members, key: key.verifying_key())
      put_bytes(mut members, name: "d", bytes: key.expose_scalar())
    }
    Ed25519Public(key) => {
      put(mut members, name: "kty", text: "OKP")
      put(mut members, name: "crv", text: "Ed25519")
      let bytes = key.bytes()
      put_bytes(mut members, name: "x", bytes: bytes[..])
    }
    Ed25519Private(key) => {
      put(mut members, name: "kty", text: "OKP")
      put(mut members, name: "crv", text: "Ed25519")
      let public_bytes = key.verifying_key().bytes()
      put_bytes(mut members, name: "x", bytes: public_bytes[..])
      let seed = key.expose_seed()
      put_bytes(mut members, name: "d", bytes: seed[..])
    }
  }
  match self.id {
    Some(id) => put(mut members, name: "kid", text: id.slice())
    None => {}
  }
  match self.algorithm {
    Some(algorithm) => put(mut members, name: "alg", text: algorithm.slice())
    None => {}
  }
  match self.usage {
    Some(usage) => put(mut members, name: "use", text: usage.slice())
    None => {}
  }
  json::Value.Object(members: own members)
}

fn put_point(members: mut Map[String, json::Value], key: cryptography::EcdsaVerifyingKey) {
  let point = key.sec1()
  let size = point.length().saturating_subtract(1) / 2
  if point.length() < 1 + 2 * size {
    return
  }
  put(mut members, name: "kty", text: "EC")
  put(mut members, name: "crv", text: curve_name(key.curve()))
  put_bytes(mut members, name: "x", bytes: point[1..1 + size])
  put_bytes(mut members, name: "y", bytes: point[1 + size..])
}

public fn Key.to_text(self) -> String
  uses Panic
{
  self.to_value().to_text()
}

public fn Key.public_key(self) -> Key
  uses Panic
{
  let material = match self.material {
    RsaPrivate(key) => Material.RsaPublic(key: key.public_key())
    EcPrivate(key) => Material.EcPublic(key: key.verifying_key())
    Ed25519Private(key) => Material.Ed25519Public(key: key.verifying_key())
    other => other.copy()
  }
  Key(material: own material, id: self.id.copy(), algorithm: self.algorithm.copy(), usage: self.usage.copy())
}

public fn Key.is_private(self) -> Bool {
  match self.material {
    Secret(..) | RsaPrivate(..) | EcPrivate(..) | Ed25519Private(..) => true
    _ => false
  }
}

fn member_text(value: json::Value, name: StringSlice) -> String {
  let member = text_of(value, name: name).unwrap_or("")
  "\"${name}\":${json::quote(member.slice())}"
}

public fn Key.thumbprint(self) -> String
  uses Panic
{
  let value = self.public_key().to_value()
  let canonical = match self.material {
    Secret(..) => "{${member_text(value, name: "k")},${member_text(value, name: "kty")}}"
    RsaPublic(..) | RsaPrivate(..) => "{${member_text(value, name: "e")},${member_text(value, name: "kty")},${member_text(value, name: "n")}}"
    EcPublic(..) | EcPrivate(..) => "{${member_text(value, name: "crv")},${member_text(value, name: "kty")},${member_text(value, name: "x")},${member_text(value, name: "y")}}"
    Ed25519Public(..) | Ed25519Private(..) => "{${member_text(value, name: "crv")},${member_text(value, name: "kty")},${member_text(value, name: "x")}}"
  }
  let digest = cryptography::sha256(canonical.slice().bytes())
  encoded(digest[..])
}

public fn KeySet.parse(text: StringSlice) -> Result[KeySet, Error]
  uses Panic
{
  let value = match json::parse(text) {
    Ok(value) => own value
    Err(_) => return Err(failure("a key set that is not JSON"))
  }
  let items = match value.get("keys") {
    Some(keys) => match keys.as_items() {
      Some(items) => items.to_list()
      None => return Err(failure("a key set whose \"keys\" is not an array"))
    }
    None => return Err(failure("a key set without \"keys\""))
  }
  var keys: List[Key] = []
  for item in items {
    match Key.from_value(item) {
      Ok(key) => mut keys.push(own key)
      Err(_) => {}
    }
  }
  Ok(KeySet(keys: own keys))
}

public fn KeySet.find(self, id: StringSlice) -> Option[Key] {
  for key in self.keys {
    match key.id {
      Some(key_id) => {
        if key_id.slice() == id {
          return Some(key.copy())
        }
      }
      None => {}
    }
  }
  None
}

public fn KeySet.to_text(self) -> String
  uses Panic
{
  var items: List[json::Value] = []
  for key in self.keys {
    mut items.push(key.to_value())
  }
  var members: Map[String, json::Value] = [:]
  mut members.insert("keys", value: json::Value.Array(items: own items))
  json::Value.Object(members: own members).to_text()
}
