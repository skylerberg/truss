use standard::intrinsic
use standard::streams
use standard::unicode

public opaque type Input(handle: streams::Handle)

public fn Input.from_handle(handle: own streams::Handle) -> Input {
  Input(handle: own handle)
}

impl streams::Reader for Input {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.read(self.handle, buffer: mut buffer, limit: limit)
  }
}

public opaque type Output(handle: streams::Handle)

public fn Output.from_handle(handle: own streams::Handle) -> Output {
  Output(handle: own handle)
}

impl streams::Writer for Output {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.write(self.handle, bytes: bytes)
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
  {
    Ok(Unit)
  }
}

public type Size(columns: UInt16, rows: UInt16)
  derives Equal

public opaque type Terminal(handle: streams::Handle)

public fn Terminal.from_handle(handle: own streams::Handle) -> Terminal {
  Terminal(handle: own handle)
}

public fn Terminal.is_interactive(self) -> Bool
  uses Handles
{
  self.size().is_ok()
}

public fn Terminal.size(self) -> Result[Size, SystemError]
  uses Handles
{
  Handles.terminal_size(self.handle)
}

public fn Terminal.set_raw_mode(mut self, enabled: Bool) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.set_raw_mode(self.handle, enabled: enabled)
}

public fn with_raw_mode[Returned, capability Granted](
  run: (fn() -> Returned uses Granted),
) -> Result[Returned, SystemError]
  uses Console, Handles, Granted
{
  var terminal = Console.terminal()
  mut terminal.set_raw_mode(true)?
  let returned = run()
  mut terminal.set_raw_mode(false)?
  Ok(own returned)
}

fn remove_last_character(line: mut List[UInt8]) {
  while line.length() > 0 && line[line.length() - 1] >= 128 && line[line.length() - 1] < 192
    decreases line.length()
  {
    let _ = mut line.pop()
  }
  let _ = mut line.pop()
}

fn hidden_line(terminal: Terminal) -> Result[Option[String], SystemError]
  uses Handles
{
  var line: List[UInt8] = []
  var typed: List[UInt8] = []
  while true {
    mut typed.clear()
    let count = Handles.read(terminal.handle, buffer: mut typed, limit: 1)?
    if count == 0 {
      return Ok(if line.is_empty() { None } else { Some(String.from_utf8_lossy(line.slice())) })
    }
    let byte = typed[0]
    if byte == 10 || byte == 13 {
      return Ok(Some(String.from_utf8_lossy(line.slice())))
    }
    if byte == 3 {
      return Err(SystemError.Interrupted)
    }
    if byte == 4 && line.is_empty() {
      return Ok(None)
    }
    if byte == 8 || byte == 127 {
      remove_last_character(mut line)
    } else if byte >= 32 {
      mut line.push(byte)
    }
  }
}

public fn read_secret(prompt: StringSlice) -> Result[Option[String], SystemError]
  uses Console, Handles
{
  Console.print(prompt)
  var terminal = Console.terminal()
  if mut terminal.set_raw_mode(true) is Err(_) {
    return Ok(Console.read_line())
  }
  let typed = hidden_line(terminal)
  let restored = mut terminal.set_raw_mode(false)
  Console.print("\n")
  restored?
  typed
}

public type Color =
  | Black
  | Red
  | Green
  | Yellow
  | Blue
  | Magenta
  | Cyan
  | White
  | BrightBlack
  | BrightRed
  | BrightGreen
  | BrightYellow
  | BrightBlue
  | BrightMagenta
  | BrightCyan
  | BrightWhite
  | Palette(index: UInt8)
  | TrueColor(red: UInt8, green: UInt8, blue: UInt8)
  derives Equal

public type Style(
  foreground: Option[Color] = None,
  background: Option[Color] = None,
  bold: Bool = false,
  dim: Bool = false,
  italic: Bool = false,
  underline: Bool = false,
)

internal fn Color.named_offset(self) -> UInt8
  ensures result <= 67
  cost time O(1)
{
  match self {
    Black => 0
    Red => 1
    Green => 2
    Yellow => 3
    Blue => 4
    Magenta => 5
    Cyan => 6
    White => 7
    BrightBlack => 60
    BrightRed => 61
    BrightGreen => 62
    BrightYellow => 63
    BrightBlue => 64
    BrightMagenta => 65
    BrightCyan => 66
    BrightWhite => 67
    Palette(_) => 0
    TrueColor(..) => 0
  }
}

internal fn Color.write_code(self, output: mut String, background: Bool)
  cost amortized time O(1)
{
  let base: UInt8 = if background { 40 } else { 30 }
  match self {
    Palette(index) => {
      if background {
        mut output.push(";48;5;")
      } else {
        mut output.push(";38;5;")
      }
      mut output.push(index.format())
    }
    TrueColor(red, green, blue) => {
      if background {
        mut output.push(";48;2;")
      } else {
        mut output.push(";38;2;")
      }
      mut output.push(red.format())
      mut output.push(";")
      mut output.push(green.format())
      mut output.push(";")
      mut output.push(blue.format())
    }
    _ => {
      mut output.push(";")
      mut output.push((base + self.named_offset()).format())
    }
  }
}

public fn Style.apply(self, text: StringSlice) -> String
  cost time O(text.length())
{
  if self.foreground is None && self.background is None && !self.bold && !self.dim && !self.italic && !self.underline {
    return text.to_string()
  }
  var output: String = ""
  mut output.push("\u{1b}[0")
  if self.bold {
    mut output.push(";1")
  }
  if self.dim {
    mut output.push(";2")
  }
  if self.italic {
    mut output.push(";3")
  }
  if self.underline {
    mut output.push(";4")
  }
  match self.foreground {
    Some(color) => color.write_code(mut output, background: false)
    None => {}
  }
  match self.background {
    Some(color) => color.write_code(mut output, background: true)
    None => {}
  }
  mut output.push("m")
  mut output.push(text)
  mut output.push("\u{1b}[0m")
  output
}

internal fn sequence_end(text: StringSlice, from: USize) -> USize
  requires from <= text.length()
  ensures from <= result
  ensures result <= text.length()
  cost time O(result - from)
{
  var index = from
  while index < text.length() && text.byte(index) >= 32 && text.byte(index) <= 63
    invariant from <= index
    invariant index <= text.length()
    decreases text.length() - index
    cost time O(index - from)
  {
    index += 1
  }
  if index < text.length() && text.byte(index) >= 64 && text.byte(index) <= 126 { index + 1 } else { index }
}

public fn strip_styles(text: StringSlice) -> String
  ensures result.length() <= text.length()
  cost time O(text.length())
{
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(text.length())
  var index: USize = 0
  while index < text.length()
    invariant index <= text.length()
    invariant intrinsic::storage_length(output) <= index
    invariant intrinsic::storage_capacity(output) == text.length()
    decreases text.length() - index
    cost time O(index)
  {
    if text.byte(index) == 27 && index + 1 < text.length() && text.byte(index + 1) == 91 {
      index = sequence_end(text, from: index + 2)
    } else {
      intrinsic::storage_push(mut output, value: text.byte(index))
      index += 1
    }
  }
  String(storage: own output)
}

public fn display_width(text: StringSlice) -> USize
  cost time O(text.length())
{
  var width: USize = 0
  for character in text.characters() {
    width = width.saturating_add(unicode::display_width(character))
  }
  width
}

public opaque type CapturedConsole(input: List[String], next_line: USize, output: String, errors: String)

public fn CapturedConsole.new(input: own List[String] = []) -> CapturedConsole {
  CapturedConsole(input: own input, next_line: 0, output: "", errors: "")
}

public fn CapturedConsole.output(self) -> StringSlice
  cost time O(1)
{
  self.output.slice()
}

public fn CapturedConsole.errors(self) -> StringSlice
  cost time O(1)
{
  self.errors.slice()
}

impl Console for CapturedConsole {
  fn print(mut self, text: StringSlice) {
    mut self.output.push(text)
  }

  fn print_line(mut self, text: StringSlice) {
    mut self.output.push(text)
    mut self.output.push("\n")
  }

  fn print_error(mut self, text: StringSlice) {
    mut self.errors.push(text)
    mut self.errors.push("\n")
  }

  fn read_line(mut self) -> Option[String]
  {
    if self.next_line < self.input.length() {
      let line = self.input[self.next_line].copy()
      self.next_line += 1
      Some(own line)
    } else {
      None
    }
  }

  fn input(mut self) -> Input
  {
    Input(handle: streams::Handle.simulated(0))
  }

  fn output(mut self) -> Output
  {
    Output(handle: streams::Handle.simulated(1))
  }

  fn error_output(mut self) -> Output
  {
    Output(handle: streams::Handle.simulated(2))
  }

  fn terminal(mut self) -> Terminal
  {
    Terminal(handle: streams::Handle.simulated(1))
  }
}

fn same(actual: StringSlice, expected: StringSlice) -> Bool {
  actual == expected
}

test "styles are stripped from text" {
  assert strip_styles("\u{1b}[1;31mred\u{1b}[0m plain") == "red plain"
  assert strip_styles("no styles") == "no styles"
  assert strip_styles("") == ""
  assert strip_styles("\u{1b}[") == ""
  assert strip_styles("a\u{1b}[2Kb") == "ab"
  assert strip_styles("\u{1b}[38;2;1;2;3mx") == "x"
  assert strip_styles("h\u{e9}\u{1b}[4m\u{20ac}") == "h\u{e9}\u{20ac}"
  assert strip_styles("\u{1b}x").length() == 2
}

test "a captured console gives its lines in order and keeps what is printed" {
  var captured = CapturedConsole.new(["first", "second"])
  provide mut captured {
    assert Console.read_line() == Some("first")
    Console.print("a")
    Console.print_line("b")
    Console.print_error("oops")
    assert Console.read_line() == Some("second")
    assert Console.read_line() is None
    assert Console.read_line() is None
  }
  assert same(captured.output(), expected: "ab\n")
  assert same(captured.errors(), expected: "oops\n")
}

test "a style wraps text in the codes that set it and the code that resets it" {
  assert Style().apply("plain") == "plain"
  assert Style(bold: true).apply("x") == "\u{1b}[0;1mx\u{1b}[0m"
  assert Style(dim: true, italic: true).apply("x") == "\u{1b}[0;2;3mx\u{1b}[0m"
  assert Style(foreground: Some(Color.Red), background: Some(Color.BrightBlue), underline: true)
    .apply("hi") == "\u{1b}[0;4;31;104mhi\u{1b}[0m"
  assert Style(foreground: Some(Color.Palette(index: 200))).apply("p") == "\u{1b}[0;38;5;200mp\u{1b}[0m"
  assert Style(background: Some(Color.TrueColor(red: 1, green: 20, blue: 255))).apply("t")
    == "\u{1b}[0;48;2;1;20;255mt\u{1b}[0m"
  assert Style(foreground: Some(Color.BrightWhite)).apply("") == "\u{1b}[0;97m\u{1b}[0m"
  let styled = Style(bold: true, foreground: Some(Color.Green)).apply("h\u{e9}llo")
  assert strip_styles(styled) == "h\u{e9}llo"
}
