public type Color =
  | Black
  | Red
  | Green
  | Yellow
  | Blue
  | Magenta
  | Cyan
  | White
  | BrightBlack
  | BrightRed
  | BrightGreen
  | BrightYellow
  | BrightBlue
  | BrightMagenta
  | BrightCyan
  | BrightWhite
  | Palette(index: UInt8)
  | TrueColor(red: UInt8, green: UInt8, blue: UInt8)
  derives Equal

public type Style(
  foreground: Option[Color] = None,
  background: Option[Color] = None,
  bold: Bool = false,
  dim: Bool = false,
  italic: Bool = false,
  underline: Bool = false,
)

public fn Style.apply(self, text: StringSlice) -> String
  cost time O(text.length())
{
  todo
}

public fn strip_styles(text: StringSlice) -> String
  cost time O(text.length())
{
  todo
}

public fn display_width(text: StringSlice) -> USize
  cost time O(text.length())
{
  todo
}

public opaque type CapturedConsole(input: List[String], next_line: USize, output: String, errors: String)

public fn CapturedConsole.new(input: own List[String] = []) -> CapturedConsole {
  CapturedConsole(input: own input, next_line: 0, output: "", errors: "")
}

public fn CapturedConsole.output(self) -> StringSlice
  cost time O(1)
{
  self.output.slice()
}

public fn CapturedConsole.errors(self) -> StringSlice
  cost time O(1)
{
  self.errors.slice()
}

impl Console for CapturedConsole {
  fn print(mut self, text: StringSlice) {
    mut self.output.push(text)
  }

  fn print_line(mut self, text: StringSlice) {
    mut self.output.push(text)
    mut self.output.push("\n")
  }

  fn print_error(mut self, text: StringSlice) {
    mut self.errors.push(text)
    mut self.errors.push("\n")
  }

  fn read_line(mut self) -> Option[String] {
    todo
  }

  fn input(mut self) -> Input {
    todo
  }

  fn output(mut self) -> Output {
    todo
  }

  fn error_output(mut self) -> Output {
    todo
  }

  fn terminal(mut self) -> Terminal {
    todo
  }
}
