internal fn sequence_end(text: StringSlice, from: USize) -> USize
  requires from <= text.length()
  ensures from <= result
  ensures result <= text.length()
  cost time O(result - from)
{
  var index = from
  while index < text.length() && text.byte(index) >= 32 && text.byte(index) <= 63
    invariant from <= index
    invariant index <= text.length()
    decreases text.length() - index
    cost time O(index - from)
  {
    index += 1
  }
  if index < text.length() && text.byte(index) >= 64 && text.byte(index) <= 126 { index + 1 } else { index }
}

public fn strip_styles(text: StringSlice) -> String
  ensures result.length() <= text.length()
  cost time O(text.length())
{
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(text.length())
  var index: USize = 0
  while index < text.length()
    invariant index <= text.length()
    invariant intrinsic::storage_length(output) <= index
    invariant intrinsic::storage_capacity(output) == text.length()
    decreases text.length() - index
    cost time O(index)
  {
    if text.byte(index) == 27 && index + 1 < text.length() && text.byte(index + 1) == 91 {
      index = sequence_end(text, from: index + 2)
    } else {
      intrinsic::storage_push(mut output, value: text.byte(index))
      index += 1
    }
  }
  String(storage: own output)
}

