use standard::intrinsic
use standard::streams

public opaque type Input(handle: streams::Handle)

public fn Input.from_handle(handle: own streams::Handle) -> Input {
  Input(handle: own handle)
}

impl streams::Reader for Input {
  fn read(mut self, buffer: mut List[UInt8], limit: USize) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.read(self.handle, buffer: mut buffer, limit: limit)
  }
}

public opaque type Output(handle: streams::Handle)

public fn Output.from_handle(handle: own streams::Handle) -> Output {
  Output(handle: own handle)
}

impl streams::Writer for Output {
  fn write(mut self, bytes: Slice[UInt8]) -> Result[USize, SystemError]
    uses Handles
  {
    Handles.write(self.handle, bytes: bytes)
  }

  fn flush(mut self) -> Result[Unit, SystemError]
    uses Handles
  {
    Ok(Unit)
  }
}

public type Size(columns: UInt16, rows: UInt16)
  derives Equal

public opaque type Terminal(handle: streams::Handle)

public fn Terminal.from_handle(handle: own streams::Handle) -> Terminal {
  Terminal(handle: own handle)
}

public fn Terminal.is_interactive(self) -> Bool
  uses Handles
{
  self.size().is_ok()
}

public fn Terminal.size(self) -> Result[Size, SystemError]
  uses Handles
{
  Handles.terminal_size(self.handle)
}

public fn Terminal.set_raw_mode(mut self, enabled: Bool) -> Result[Unit, SystemError]
  uses Handles
{
  Handles.set_raw_mode(self.handle, enabled: enabled)
}

public fn with_raw_mode[Returned, capability Granted](
  run: (fn() -> Returned uses Granted),
) -> Result[Returned, SystemError]
  uses Console, Handles, Granted
{
  todo
}

public fn read_secret(prompt: StringSlice) -> Result[Option[String], SystemError]
  uses Console, Handles
{
  todo
