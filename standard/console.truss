public type Color =
  | Black
  | Red
  | Green
  | Yellow
  | Blue
  | Magenta
  | Cyan
  | White
  | BrightBlack
  | BrightRed
  | BrightGreen
  | BrightYellow
  | BrightBlue
  | BrightMagenta
  | BrightCyan
  | BrightWhite
  | Palette(index: UInt8)
  | TrueColor(red: UInt8, green: UInt8, blue: UInt8)
  derives Equal

public type Style(
  foreground: Option[Color] = None,
  background: Option[Color] = None,
  bold: Bool = false,
  dim: Bool = false,
  italic: Bool = false,
  underline: Bool = false,
)

