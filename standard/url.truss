public opaque type Component(text: String)

impl From[StringSlice] for Component {
  fn from(value: own StringSlice) -> Component {
    Component(text: encode_component(value))
  }
}

impl From[String] for Component {
  fn from(value: own String) -> Component {
    Component(text: encode_component(value.slice()))
  }
}

impl From[Int64] for Component {
  fn from(value: own Int64) -> Component {
    Component(text: "${value}")
  }
}

impl From[UInt64] for Component {
  fn from(value: own UInt64) -> Component {
    Component(text: "${value}")
  }
}

impl FromTemplate for Url {
  type Part = Component

  fn from_template(template: Template[Component]) -> Url
    requires is_valid_template(template.literals)
  {
    todo
  }
}

