use standard::intrinsic
use standard::network
use standard::text

public type Host =
  | Domain(name: String)
  | Address(address: network::IpAddress)
  derives Equal, Hash

impl Display for Host {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      Domain(name) => mut output.write(name.slice())
      Address(address) => match address {
        Version4(_) => address.display(mut output)
        Version6(_) => {
          mut output.write("[")
          address.display(mut output)
          mut output.write("]")
        }
      }
    }
  }
}

public opaque type Url(
  scheme: String,
  user_information: Option[String],
  host: Option[Host],
  port: Option[UInt16],
  path: String,
  query: Option[String],
  fragment: Option[String],
)
  derives Copyable, Equal, Hash

public type ParseError =
  | MissingScheme
  | InvalidScheme
  | InvalidHost
  | InvalidPort
  | InvalidCharacter(offset: USize)
  | InvalidPercentEncoding(offset: USize)
  derives Equal

impl Display for ParseError {
  fn display(self, output: mut TextBuilder)
  {
    match self {
      MissingScheme => mut output.write("the URL has no scheme")
      InvalidScheme => mut output.write("the scheme is not letters, digits, `+`, `-`, and `.` after a letter")
      InvalidHost => mut output.write("the host is not a name or an address")
      InvalidPort => mut output.write("the port is not a number up to 65535")
      InvalidCharacter(offset) => {
        mut output.write("a character at offset ")
        offset.display(mut output)
        mut output.write(" cannot appear there in a URL")
      }
      InvalidPercentEncoding(offset) => {
        mut output.write("the `%` at offset ")
        offset.display(mut output)
        mut output.write(" is not followed by two hexadecimal digits")
      }
    }
  }
}

public type Parameter(name: String, value: String)
  derives Equal

internal fn is_unreserved(byte: UInt8) -> Bool
  cost time O(1)
  cost allocations == 0
{
  (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
    || byte == 45 || byte == 46 || byte == 95 || byte == 126
}

internal fn is_sub_delimiter(byte: UInt8) -> Bool
  cost time O(1)
  cost allocations == 0
{
  byte == 33 || byte == 36 || (byte >= 38 && byte <= 44) || byte == 59 || byte == 61
}

internal type UrlPart = InUserInformation | InHost | InPath | InQuery
  derives Equal

internal fn UrlPart.allows(self, byte: UInt8) -> Bool
  cost time O(1)
  cost allocations == 0
{
  if is_unreserved(byte) || is_sub_delimiter(byte) {
    true
  } else if self == UrlPart.InUserInformation {
    byte == 58
  } else if self == UrlPart.InPath {
    byte == 58 || byte == 64 || byte == 47
  } else if self == UrlPart.InQuery {
    byte == 58 || byte == 64 || byte == 47 || byte == 63
  } else {
    false
  }
}

internal fn find_first_of(text: StringSlice, from: USize, to: USize, first: UInt8, second: UInt8, third: UInt8) -> USize
  requires from <= to
  requires to <= text.length()
  ensures from <= result
  ensures result <= to
  cost time O(result - from)
  cost allocations == 0
{
  var index = from
  while index < to && text.byte(index) != first && text.byte(index) != second && text.byte(index) != third
    invariant from <= index
    invariant index <= to
    decreases to - index
    cost time O(index - from)
    cost allocations == 0
  {
    index += 1
  }
  index
}

internal fn find_last(text: StringSlice, from: USize, to: USize, byte: UInt8) -> USize
  requires from <= to
  requires to <= text.length()
  ensures from <= result
  ensures result <= to
  cost time O(to - from)
  cost allocations == 0
{
  var index = to
  while index > from
    invariant from <= index
    invariant index <= to
    decreases index
    cost time O(to - index)
    cost allocations == 0
  {
    index -= 1
    if text.byte(index) == byte {
      return index
    }
  }
  to
}

internal fn validate(text: StringSlice, from: USize, to: USize, place: UrlPart) -> Option[ParseError]
  requires from <= to
  requires to <= text.length()
  cost time O(to - from)
{
  var index = from
  while index < to
    invariant from <= index
    invariant index <= to
    decreases to - index
    cost time O(index - from)
  {
    let byte = text.byte(index)
    if byte == 37 {
      if to - index < 3 {
        return Some(ParseError.InvalidPercentEncoding(offset: index))
      }
      if text.byte(index + 1).digit_value() >= 16 || text.byte(index + 2).digit_value() >= 16 {
        return Some(ParseError.InvalidPercentEncoding(offset: index))
      }
      index += 3
    } else if place.allows(byte) {
      index += 1
    } else {
      return Some(ParseError.InvalidCharacter(offset: index))
    }
  }
  None
}

internal fn scheme_end(text: StringSlice) -> USize
  ensures result <= text.length()
  cost time O(text.length())
  cost allocations == 0
{
  if text.length() == 0 {
    return 0
  }
  let first = text.byte(0)
  if !((first >= 65 && first <= 90) || (first >= 97 && first <= 122)) {
    return text.length()
  }
  var index: USize = 1
  while index < text.length()
    invariant index <= text.length()
    decreases text.length() - index
    cost time O(index)
    cost allocations == 0
  {
    let byte = text.byte(index)
    if byte == 58 {
      return index
    }
    let continues = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
      || byte == 43 || byte == 45 || byte == 46
    if !continues {
      return text.length()
    }
    index += 1
  }
  text.length()
}

internal fn parse_port(text: StringSlice, from: USize, to: USize) -> Result[Option[UInt16], ParseError]
  requires from <= to
  requires to <= text.length()
  cost time O(to - from)
{
  if from == to {
    return Ok(None)
  }
  match network::parse_number(text, from: from, to: to, limit: 65535) {
    Ok(port) => Ok(Some(intrinsic::convert(port)))
    Err(_) => Err(ParseError.InvalidPort)
  }
}

internal fn parse_host(text: StringSlice, from: USize, to: USize) -> Result[Host, ParseError]
  requires from <= to
  requires to <= text.length()
  cost time O(to - from)
{
  let name = text.part(from, to: to)
  match network::parse_address(name) {
    Ok(address) => {
      if address is Version4(_) {
        return Ok(Host.Address(address))
      }
      return Err(ParseError.InvalidHost)
    }
    Err(_) => {}
  }
  if validate(text, from: from, to: to, place: UrlPart.InHost) is Some(_) {
    return Err(ParseError.InvalidHost)
  }
  Ok(Host.Domain(name.to_ascii_lowercase()))
}

internal type Authority(user_information: Option[String], host: Host, port: Option[UInt16])

internal fn parse_authority(text: StringSlice, from: USize, to: USize) -> Result[Authority, ParseError]
  requires from <= to
  requires to <= text.length()
  cost time O(to - from)
{
  let at = find_last(text, from: from, to: to, byte: 64)
  var user_information: Option[String] = None
  var start = from
  if at != to {
    match validate(text, from: from, to: at, place: UrlPart.InUserInformation) {
      Some(error) => return Err(error)
      None => {}
    }
    user_information = Some(text.part(from, to: at).to_string())
    start = at + 1
  }
  if start < to && text.byte(start) == 91 {
    let close = find_first_of(text, from: start + 1, to: to, first: 93, second: 93, third: 93)
    if close == to {
      return Err(ParseError.InvalidHost)
    }
    match network::parse_address(text.part(start + 1, to: close)) {
      Ok(address) => {
        if address is Version4(_) {
          return Err(ParseError.InvalidHost)
        }
        if close + 1 < to && text.byte(close + 1) != 58 {
          return Err(ParseError.InvalidPort)
        }
        let port = parse_port(text, from: if close + 1 < to { close + 2 } else { to }, to: to)?
        Ok(Authority(user_information: own user_information, host: Host.Address(address), port: port))
      }
      Err(_) => Err(ParseError.InvalidHost)
    }
  } else {
    let colon = find_last(text, from: start, to: to, byte: 58)
    let host = parse_host(text, from: start, to: colon)?
    let port = parse_port(text, from: if colon < to { colon + 1 } else { to }, to: to)?
    Ok(Authority(user_information: own user_information, host: own host, port: port))
  }
}

internal type PathQueryFragment(path: String, query: Option[String], fragment: Option[String])

internal fn parse_path_query_fragment(text: StringSlice, from: USize) -> Result[PathQueryFragment, ParseError]
  requires from <= text.length()
  cost time O(text.length() - from)
{
  let length = text.length()
  let path_end = find_first_of(text, from: from, to: length, first: 63, second: 35, third: 35)
  match validate(text, from: from, to: path_end, place: UrlPart.InPath) {
    Some(error) => return Err(error)
    None => {}
  }
  var query: Option[String] = None
  var fragment: Option[String] = None
  var next = path_end
  if next < length && text.byte(next) == 63 {
    let query_end = find_first_of(text, from: next + 1, to: length, first: 35, second: 35, third: 35)
    match validate(text, from: next + 1, to: query_end, place: UrlPart.InQuery) {
      Some(error) => return Err(error)
      None => {}
    }
    query = Some(text.part(next + 1, to: query_end).to_string())
    next = query_end
  }
  if next < length {
    match validate(text, from: next + 1, to: length, place: UrlPart.InQuery) {
      Some(error) => return Err(error)
      None => {}
    }
    fragment = Some(text.part(next + 1, to: length).to_string())
  }
  Ok(PathQueryFragment(path: text.part(from, to: path_end).to_string(), query: own query, fragment: own fragment))
}

internal fn starts_authority(text: StringSlice, from: USize) -> Bool
  requires from <= text.length()
  cost time O(1)
  cost allocations == 0
{
  text.length() - from >= 2 && text.byte(from) == 47 && text.byte(from + 1) == 47
}

internal fn authority_end(text: StringSlice, from: USize) -> USize
  requires from <= text.length()
  requires starts_authority(text, from: from)
  ensures from + 2 <= result
  ensures result <= text.length()
  cost time O(result - from)
  cost allocations == 0
{
  find_first_of(text, from: from + 2, to: text.length(), first: 47, second: 63, third: 35)
}

internal fn build_url(scheme: own String, authority: own Option[Authority], rest: own PathQueryFragment) -> Url
  cost time O(1)
{
  var parts = own rest
  match own authority {
    Some(found) => {
      var named = own found
      Url(
        scheme: own scheme,
        user_information: own named.user_information,
        host: Some(own named.host),
        port: named.port,
        path: own parts.path,
        query: own parts.query,
        fragment: own parts.fragment,
      )
    }
    None => Url(
      scheme: own scheme,
      user_information: None,
      host: None,
      port: None,
      path: own parts.path,
      query: own parts.query,
      fragment: own parts.fragment,
    )
  }
}

internal type EscapeSet = AsComponent | AsForm | AsPath | AsFragment
  derives Equal

internal fn EscapeSet.allows(self, byte: UInt8) -> Bool
  cost time O(1)
  cost allocations == 0
{
  if is_unreserved(byte) {
    true
  } else if self == EscapeSet.AsPath {
    is_sub_delimiter(byte) || byte == 58 || byte == 64 || byte == 47
  } else if self == EscapeSet.AsFragment {
    is_sub_delimiter(byte) || byte == 58 || byte == 64 || byte == 47 || byte == 63
  } else {
    false
  }
}

internal fn percent_encode(text: StringSlice, how: EscapeSet) -> String
  cost time O(text.length())
{
  if text.length() > USize.maximum / 8 {
    intrinsic::crash("a string cannot hold that many bytes".slice())
  }
  let form = how == EscapeSet.AsForm
  var extra: USize = 0
  for index in 0..text.length()
    invariant extra <= 2 * yielded.length()
  {
    let byte = text.byte(index)
    if !how.allows(byte) && !(form && byte == 32) {
      extra += 2
    }
  }
  let capacity = text.length() + extra
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(capacity)
  var budget = extra
  for index in 0..text.length()
    invariant intrinsic::storage_length(output) + (text.length() - yielded.length()) + budget <= capacity
    invariant intrinsic::storage_capacity(output) == capacity
  {
    let byte = text.byte(index)
    if form && byte == 32 {
      intrinsic::storage_push(mut output, value: 43)
    } else if how.allows(byte) || budget < 2 {
      intrinsic::storage_push(mut output, value: byte)
    } else {
      intrinsic::storage_push(mut output, value: 37)
      intrinsic::storage_push(mut output, value: (byte / 16).digit_byte(uppercase: true))
      intrinsic::storage_push(mut output, value: (byte % 16).digit_byte(uppercase: true))
      budget -= 2
    }
  }
  String(storage: own output)
}

internal fn percent_decode_bytes(text: StringSlice, from: USize, to: USize, form: Bool) -> Result[List[UInt8], ParseError]
  requires from <= to
  requires to <= text.length()
  ensures !(result is Ok(bytes) && bytes.length() > to - from)
  cost time O(to - from)
{
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(to - from)
  var index = from
  while index < to
    invariant from <= index
    invariant index <= to
    invariant intrinsic::storage_length(output) <= index - from
    invariant intrinsic::storage_capacity(output) == to - from
    decreases to - index
    cost time O(index - from)
  {
    let byte = text.byte(index)
    if byte == 37 {
      if to - index < 3 {
        return Err(ParseError.InvalidPercentEncoding(offset: index))
      }
      let high = text.byte(index + 1).digit_value()
      let low = text.byte(index + 2).digit_value()
      if high >= 16 || low >= 16 {
        return Err(ParseError.InvalidPercentEncoding(offset: index))
      }
      intrinsic::storage_push(mut output, value: high * 16 + low)
      index += 3
    } else {
      intrinsic::storage_push(mut output, value: if form && byte == 43 { 32 } else { byte })
      index += 1
    }
  }
  Ok(List(storage: own output))
}

internal fn percent_decode(text: StringSlice, from: USize, to: USize, form: Bool) -> Result[String, ParseError]
  requires from <= to
  requires to <= text.length()
  cost time O(to - from)
{
  let bytes = percent_decode_bytes(text, from: from, to: to, form: form)?
  match String.from_utf8(own bytes) {
    Ok(found) => Ok(own found)
    Err(_) => Err(ParseError.InvalidCharacter(offset: from))
  }
}

internal fn parse_parameter(text: StringSlice, from: USize, to: USize) -> Result[Parameter, ParseError]
  requires from <= to
  requires to <= text.length()
  cost time O(to - from)
{
  let equals = find_first_of(text, from: from, to: to, first: 61, second: 61, third: 61)
  let name = percent_decode(text, from: from, to: equals, form: true)?
  let value = percent_decode(text, from: if equals < to { equals + 1 } else { to }, to: to, form: true)?
  Ok(Parameter(name: own name, value: own value))
}

internal fn count_byte(text: StringSlice, byte: UInt8) -> USize
  ensures result <= text.length()
  cost time O(text.length())
  cost allocations == 0
{
  var count: USize = 0
  for index in 0..text.length()
    invariant count <= yielded.length()
    cost allocations == 0
  {
    if text.byte(index) == byte {
      count += 1
    }
  }
  count
}

internal fn find_last_slash(output: intrinsic::Storage[UInt8]) -> USize
  ensures result <= intrinsic::storage_length(output)
  cost time O(intrinsic::storage_length(output) - result)
  cost allocations == 0
{
  var length = intrinsic::storage_length(output)
  while length > 0 && intrinsic::storage_at(output, index: length - 1) != 47
    invariant length <= intrinsic::storage_length(output)
    decreases length
    cost time O(intrinsic::storage_length(output) - length)
    cost allocations == 0
  {
    length -= 1
  }
  if length > 0 { length - 1 } else { 0 }
}

internal fn is_dot(text: StringSlice, from: USize, to: USize) -> Bool
  requires from <= to
  requires to <= text.length()
  cost time O(1)
  cost allocations == 0
{
  to - from == 1 && text.byte(from) == 46
}

internal fn is_double_dot(text: StringSlice, from: USize, to: USize) -> Bool
  requires from <= to
  requires to <= text.length()
  cost time O(1)
  cost allocations == 0
{
  to - from == 2 && text.byte(from) == 46 && text.byte(from + 1) == 46
}

internal fn remove_dot_segments(path: StringSlice) -> String
  ensures result.length() <= path.length()
  cost time O(path.length())
{
  let length = path.length()
  var output: intrinsic::Storage[UInt8] = intrinsic::storage_with_capacity(length)
  var index: USize = 0
  while index < length
    invariant index <= length
    invariant intrinsic::storage_length(output) <= index
    invariant intrinsic::storage_capacity(output) == length
    decreases length - index
    cost time O(2 * index - intrinsic::storage_length(output))
  {
    let slashed = path.byte(index) == 47
    let start = if slashed { index + 1 } else { index }
    let end = find_first_of(path, from: index + 1, to: length, first: 47, second: 47, third: 47)
    let dot = is_dot(path, from: start, to: end)
    let double = is_double_dot(path, from: start, to: end)
    if double {
      intrinsic::storage_shorten(mut output, length: find_last_slash(output))
    }
    if dot || double {
      if slashed && end == length {
        intrinsic::storage_push(mut output, value: 47)
      }
      index = if !slashed && end < length { end + 1 } else { end }
    } else {
      path.part(index, to: end).copy_onto(mut output)
      index = end
    }
  }
  String(storage: own output)
}

internal fn text_equals(scheme: StringSlice, name: StringSlice) -> Bool
  cost time O(name.length())
{
  scheme.length() == name.length() && scheme.matches_at(name, offset: 0)
}

internal fn Url.merge_path(self, relative: StringSlice) -> String
  cost time finite
{
  let base = self.path.slice()
  var merged: String = ""
  if self.host is Some(_) && base.length() == 0 {
    mut merged.push("/")
  } else {
    let slash = find_last(base, from: 0, to: base.length(), byte: 47)
    if slash < base.length() {
      mut merged.push(base.part(0, to: slash + 1))
    }
  }
  mut merged.push(relative)
  merged
}

public fn parse(text: StringSlice) -> Result[Url, ParseError]
  cost time O(text.length())
{
  let colon = scheme_end(text)
  if colon == text.length() {
    let delimiter = find_first_of(text, from: 0, to: text.length(), first: 58, second: 47, third: 63)
    let named = delimiter < text.length() && text.byte(delimiter) == 58
    return Err(if named { ParseError.InvalidScheme } else { ParseError.MissingScheme })
  }
  let scheme = text.part(0, to: colon).to_ascii_lowercase()
  var from = colon + 1
  var authority: Option[Authority] = None
  if starts_authority(text, from: from) {
    let end = authority_end(text, from: from)
    authority = Some(parse_authority(text, from: from + 2, to: end)?)
    from = end
  }
  let rest = parse_path_query_fragment(text, from: from)?
  Ok(build_url(own scheme, authority: own authority, rest: own rest))
}

public fn encode_component(text: StringSlice) -> String
  cost time O(text.length())
{
  percent_encode(text, how: EscapeSet.AsComponent)
}

public fn decode_component(text: StringSlice) -> Result[String, ParseError]
  cost time O(text.length())
{
  percent_decode(text, from: 0, to: text.length(), form: false)
}

public fn encode_query(parameters: Slice[Parameter]) -> String
  cost time finite
{
  var output: String = ""
  for index in 0..parameters.length() {
    if index > 0 {
      mut output.push("&")
    }
    mut output.push(percent_encode(parameters[index].name.slice(), how: EscapeSet.AsForm))
    mut output.push("=")
    mut output.push(percent_encode(parameters[index].value.slice(), how: EscapeSet.AsForm))
  }
  output
}

public fn decode_query(text: StringSlice) -> Result[List[Parameter], ParseError]
  cost time O(text.length())
{
  let room = count_byte(text, byte: 38) + 1
  var output: intrinsic::Storage[Parameter] = intrinsic::storage_with_capacity(room)
  var failure: Option[ParseError] = None
  var failed = false
  var index: USize = 0
  while index < text.length() && !failed
    invariant index <= text.length()
    invariant intrinsic::storage_length(output) <= room
    invariant intrinsic::storage_capacity(output) == room
    decreases text.length() - index
    cost time O(index)
  {
    let end = find_first_of(text, from: index, to: text.length(), first: 38, second: 38, third: 38)
    if end > index && intrinsic::storage_length(output) < room {
      match parse_parameter(text, from: index, to: end) {
        Ok(parameter) => intrinsic::storage_push(mut output, value: own parameter)
        Err(error) => {
          failure = Some(error)
        }
      }
    }
    failed = failure is Some(_)
    index = if end < text.length() { end + 1 } else { end }
  }
  match failure {
    Some(error) => Err(error)
    None => Ok(List(storage: own output))
  }
}

public fn Url.scheme(self) -> StringSlice
  cost time O(1)
{
  self.scheme.slice()
}

public fn Url.user_information(self) -> Option[StringSlice]
  cost time O(1)
{
  self.user_information.map(fn(found) { found.slice() })
}

public fn Url.host(self) lends Option[Host]
  cost time O(1)
{
  yield self.host
}

public fn Url.port(self) -> Option[UInt16]
  cost time O(1)
{
  self.port
}

public fn Url.port_or_default(self) -> Option[UInt16]
  cost time O(1)
{
  match self.port {
    Some(port) => Some(port)
    None => {
      let scheme = self.scheme.slice()
      if text_equals(scheme, name: "http") || text_equals(scheme, name: "ws") {
        Some(80)
      } else if text_equals(scheme, name: "https") || text_equals(scheme, name: "wss") {
        Some(443)
      } else if text_equals(scheme, name: "ftp") {
        Some(21)
      } else if text_equals(scheme, name: "ssh") {
        Some(22)
      } else {
        None
      }
    }
  }
}

public fn Url.path(self) -> StringSlice
  cost time O(1)
{
  self.path.slice()
}

public fn Url.path_segments(self) -> List[String]
  cost time O(self.path.length())
{
  let path = self.path.slice()
  if path.length() == 0 {
    return []
  }
  let room = count_byte(path, byte: 47) + 1
  var output: intrinsic::Storage[String] = intrinsic::storage_with_capacity(room)
  var index: USize = if path.byte(0) == 47 { 1 } else { 0 }
  var more = true
  while more && index <= path.length()
    invariant index <= path.length() + 1
    invariant intrinsic::storage_length(output) <= room
    invariant intrinsic::storage_capacity(output) == room
    decreases path.length() + 1 - index
    cost time O(index)
  {
    let end = find_first_of(path, from: index, to: path.length(), first: 47, second: 47, third: 47)
    if intrinsic::storage_length(output) < room {
      if percent_decode(path, from: index, to: end, form: false) is Ok(segment) {
        intrinsic::storage_push(mut output, value: own segment)
      } else {
        intrinsic::storage_push(mut output, value: path.part(index, to: end).to_string())
      }
    }
    more = end < path.length()
    index = end + 1
  }
  List(storage: own output)
}

public fn Url.query(self) -> Option[StringSlice]
  cost time O(1)
{
  self.query.map(fn(found) { found.slice() })
}

public fn Url.query_parameters(self) -> List[Parameter]
  cost time finite
{
  match self.query {
    Some(found) => if decode_query(found.slice()) is Ok(parameters) { parameters } else { [] }
    None => []
  }
}

public fn Url.query_parameter(self, name: StringSlice) -> Option[String]
  cost time finite
{
  let parameters = self.query_parameters()
  for index in 0..parameters.length() {
    if parameters[index].name.slice() == name {
      return Some(parameters[index].value.copy())
    }
  }
  None
}

public fn Url.fragment(self) -> Option[StringSlice]
  cost time O(1)
{
  self.fragment.map(fn(found) { found.slice() })
}

public fn Url.join(self, reference: StringSlice) -> Result[Url, ParseError]
  cost time finite
{
  if scheme_end(reference) < reference.length() {
    var absolute = parse(reference)?
    absolute.path = remove_dot_segments(absolute.path.slice())
    return Ok(own absolute)
  }
  var from: USize = 0
  var authority: Option[Authority] = None
  if starts_authority(reference, from: 0) {
    let end = find_first_of(reference, from: 2, to: reference.length(), first: 47, second: 63, third: 35)
    authority = Some(parse_authority(reference, from: 2, to: end)?)
    from = end
  }
  var rest = parse_path_query_fragment(reference, from: from)?
  if authority is Some(_) {
    rest.path = remove_dot_segments(rest.path.slice())
    return Ok(build_url(self.scheme.copy(), authority: own authority, rest: own rest))
  }
  var joined = self.copy()
  joined.fragment = own rest.fragment
  if rest.path.length() == 0 {
    if rest.query is Some(_) {
      joined.query = own rest.query
    }
    return Ok(own joined)
  }
  joined.query = own rest.query
  if rest.path.slice().byte(0) == 47 {
    joined.path = remove_dot_segments(rest.path.slice())
  } else {
    let merged = self.merge_path(rest.path.slice())
    joined.path = remove_dot_segments(merged.slice())
  }
  Ok(own joined)
}

public fn Url.with_path(own self, path: StringSlice) -> Url
  cost time finite
{
  var changed = own self
  let escaped = percent_encode(path, how: EscapeSet.AsPath)
  if changed.host is Some(_) && escaped.length() > 0 && escaped.slice().byte(0) != 47 {
    var rooted: String = "/"
    mut rooted.push(escaped.slice())
    changed.path = own rooted
  } else {
    changed.path = own escaped
  }
  changed
}

public fn Url.with_path_segment(own self, segment: StringSlice) -> Url
  cost time finite
{
  var changed = own self
  let length = changed.path.length()
  if length == 0 || changed.path.slice().byte(length - 1) != 47 {
    mut changed.path.push("/")
  }
  mut changed.path.push(percent_encode(segment, how: EscapeSet.AsComponent))
  changed
}

public fn Url.with_query(own self, parameters: Slice[Parameter]) -> Url
  cost time finite
{
  var changed = own self
  changed.query = if parameters.length() == 0 { None } else { Some(encode_query(parameters)) }
  changed
}

public fn Url.with_query_parameter(own self, name: StringSlice, value: StringSlice) -> Url
  cost time finite
{
  var changed = own self
  var query: String = ""
  match changed.query {
    Some(existing) => {
      mut query.push(existing.slice())
      if existing.length() > 0 {
        mut query.push("&")
      }
    }
    None => {}
  }
  mut query.push(percent_encode(name, how: EscapeSet.AsForm))
  mut query.push("=")
  mut query.push(percent_encode(value, how: EscapeSet.AsForm))
  changed.query = Some(own query)
  changed
}

public fn Url.with_fragment(own self, fragment: Option[String]) -> Url
  cost time finite
{
  var changed = own self
  changed.fragment = match fragment {
    Some(text) => Some(percent_encode(text.slice(), how: EscapeSet.AsFragment))
    None => None
  }
  changed
}

public fn Url.with_port(own self, port: Option[UInt16]) -> Url
  cost time O(1)
{
  var changed = own self
  changed.port = port
  changed
}

impl Display for Url {
  fn display(self, output: mut TextBuilder)
  {
    mut output.write(self.scheme.slice())
    mut output.write(":")
    match self.host {
      Some(host) => {
        mut output.write("//")
        match self.user_information {
          Some(user) => {
            mut output.write(user.slice())
            mut output.write("@")
          }
          None => {}
        }
        host.display(mut output)
        match self.port {
          Some(port) => {
            mut output.write(":")
            port.display(mut output)
          }
          None => {}
        }
      }
      None => {}
    }
    mut output.write(self.path.slice())
    match self.query {
      Some(query) => {
        mut output.write("?")
        mut output.write(query.slice())
      }
      None => {}
    }
    match self.fragment {
      Some(fragment) => {
        mut output.write("#")
        mut output.write(fragment.slice())
      }
      None => {}
    }
  }
}

impl text::Parse for Url {
  type Error = ParseError

  fn parse(text: StringSlice) -> Result[Url, ParseError]
  {
    parse(text)
  }
}

public opaque type Component(text: String)

impl From[StringSlice] for Component {
  fn from(value: own StringSlice) -> Component {
    Component(text: encode_component(value))
  }
}

impl From[String] for Component {
  fn from(value: own String) -> Component {
    Component(text: encode_component(value.slice()))
  }
}

impl From[Int64] for Component {
  fn from(value: own Int64) -> Component {
    Component(text: "${value}")
  }
}

impl From[UInt64] for Component {
  fn from(value: own UInt64) -> Component {
    Component(text: "${value}")
  }
}

impl FromTemplate for Url {
  type Part = Component

  fn from_template(template: Template[Component]) -> Url
    requires is_valid_template(template.literals)
  {
    var text = ""
    var index: USize = 0
    while index < template.literals.length()
      invariant index <= template.literals.length()
      decreases template.literals.length() - index
    {
      mut text.push(template.literals[index].text())
      if index < template.parts.length() {
        mut text.push(template.parts[index].text.slice())
      }
      index += 1
    }
    match parse(text.slice()) {
      Ok(url) => url
      Err(_) => Url(
        scheme: "",
        user_information: None,
        host: None,
        port: None,
        path: "",
        query: None,
        fragment: None,
      )
    }
  }
}

internal fn template_text(literals: Slice[text::Literal], part: StringSlice) -> String
  cost time finite
{
  var text = ""
  var index: USize = 0
  while index < literals.length()
    invariant index <= literals.length()
    decreases literals.length() - index
  {
    if index > 0 {
      mut text.push(part)
    }
    mut text.push(literals[index].text())
    index += 1
  }
  text
}

internal fn path_start(text: StringSlice) -> USize
  ensures result <= text.length()
  cost time O(text.length())
{
  let colon = scheme_end(text)
  if colon == text.length() {
    return colon
  }
  if starts_authority(text, from: colon + 1) {
    authority_end(text, from: colon + 1)
  } else {
    colon + 1
  }
}

internal fn parses_with_parts_after_authority(literals: Slice[text::Literal], part: StringSlice) -> Bool
  requires literals.length() > 0
  cost time finite
{
  let text = template_text(literals, part: part)
  if !(parse(text.slice()) is Ok(_)) {
    return false
  }
  literals.length() == 1 || path_start(text.slice()) <= literals[0].text().length()
}

public fn is_valid_template(literals: Slice[text::Literal]) -> Bool
  cost time finite
{
  literals.length() > 0
    && parses_with_parts_after_authority(literals, part: "~")
    && parses_with_parts_after_authority(literals, part: "")
}
