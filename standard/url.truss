use standard::network
use standard::text

public type Host =
  | Domain(name: String)
  | Address(address: network::IpAddress)
  derives Equal, Hash

impl Display for Host {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

public opaque type Url(
  scheme: String,
  user_information: Option[String],
  host: Option[Host],
  port: Option[UInt16],
  path: String,
  query: Option[String],
  fragment: Option[String],
)
  derives Copyable

public type ParseError =
  | MissingScheme
  | InvalidScheme
  | InvalidHost
  | InvalidPort
  | InvalidCharacter(offset: USize)
  | InvalidPercentEncoding(offset: USize)
  derives Equal

impl Display for ParseError {
  fn display(self, output: mut TextBuilder) {
    todo
  }
}

public type Parameter(name: String, value: String)
  derives Equal

public fn parse(text: StringSlice) -> Result[Url, ParseError]
  cost time O(text.length())
{
  todo
}

public fn encode_component(text: StringSlice) -> String
  cost time O(text.length())
{
  todo
}

public fn decode_component(text: StringSlice) -> Result[String, ParseError]
  cost time O(text.length())
{
  todo
}

public fn encode_query(parameters: Slice[Parameter]) -> String
  cost time finite
{
  todo
}

public fn decode_query(text: StringSlice) -> Result[List[Parameter], ParseError]
  cost time O(text.length())
{
  todo
}

