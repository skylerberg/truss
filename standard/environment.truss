  }

  fn current_directory(self) -> Result[Path, SystemError] {
    Ok(self.current_directory.copy())
  }

  fn platform(self) -> Platform {
    self.platform.copy()
  }

  fn location(self, location: Location) -> Option[Path] {
    todo
  }

  fn local_zone(self) -> Option[String] {
