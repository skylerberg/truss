; Checks that Menhir finds exactly the conflicts GRAMMAR.md documents in
; "Checking the grammar". `--interpret` with no input builds the automaton,
; writes truss.conflicts, and stops before generating a parser, which this
; grammar, whose actions are all empty, is not meant to be.

(rule
 (with-stdout-to
  no_sentences
  (echo "")))

(rule
 (targets truss.conflicts)
 (deps truss.mly no_sentences)
 (action
  (with-outputs-to
   menhir.output
   (with-stdin-from
    no_sentences
    (run %{bin:menhir} --explain --interpret truss.mly)))))

(test
 (name grammar_conflicts)
 (deps truss.conflicts))
