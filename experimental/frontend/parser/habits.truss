use frontend.source
use frontend.syntax
use frontend.token

fn spell_node(cursor: TokenCursor, id: UInt64) -> Option[String]
  uses Panic, RunForever
{
  cursor.spell(cursor.read_file_span(id))
}

fn report_habit(cursor: mut TokenCursor, code: String, span: source.Span, message: String, fix_title: String, edits: own List[source.Edit])
  uses Panic, RunForever
{
  var joins = false
  for edit in edits {
    if cursor.joins_neighbors(edit.span, code: edit.replacement) {
      joins = true
    }
  }
  let fixes = if joins { [] } else { [source.make_fix(fix_title, own edits)] }
  report(mut cursor, code, span, message, own fixes)
}

fn extend_with_trailing_space(written: token.Token, next: token.Token) -> source.Span
  uses Panic
{
  source.make_span(written.span.start, stop: next.span.start)
}

fn increment(cursor: mut TokenCursor, target: syntax.Expression, operator: token.Token)
  uses Panic, RunForever
{
  let is_plus = operator.kind == token.Kind.Foreign(token.Foreign.PlusPlus)
  let replacement = if is_plus { " += 1" } else { " -= 1" }
  let sign = if is_plus { "+" } else { "-" }
  let written = match spell_node(cursor, id: target.id) {
    Some(spelled) => "${spelled} ${sign}= 1"
    None => "${sign}= 1"
  }
  report_habit(
    mut cursor,
    code: "parser.increment",
    span: operator.span,
    message: "Truss has no `${sign}${sign}`; write `${written}`.",
    fix_title: "Write `${written}`",
    edits: [source.replace(operator.span, replacement)],
  )
}

fn report_double_negation(cursor: mut TokenCursor, operator: token.Token, operand: syntax.Expression)
  uses Panic, RunForever
{
  let operand_span = cursor.read_file_span(operand.id)
  report_habit(
    mut cursor,
    code: "parser.double_negation",
    span: operator.span,
    message: "Truss has no `--`; to negate twice, write `-(-x)`.",
    fix_title: "Write `-(-x)`",
    edits: [source.replace(operator.span, replacement: "-(-"), source.insert(source.make_zero_width(operand_span.stop), replacement: ")")],
  )
}

fn match_arm_comma(cursor: mut TokenCursor, comma: token.Token, next: token.Token)
  uses Panic, RunForever
{
  let is_arm_end = next.line_break_before || next.kind == token.Kind.Newline
    || next.kind == token.Kind.Punctuation(token.Punctuation.Close(token.Bracket.Curly))
  let title = if is_arm_end { "Remove the comma" } else { "Put the next arm on its own line" }
  let edit = if is_arm_end {
    source.delete(comma.span)
  } else {
    source.replace(source.make_span(comma.span.start, stop: next.span.start), replacement: "\n")
  }
  report_habit(
    mut cursor,
    code: "parser.match_arm_comma",
    span: comma.span,
    message: "`match` arms are separated by line breaks, not commas.",
    fix_title: title,
    edits: [own edit],
  )
}

fn report_conditional(
  cursor: mut TokenCursor,
  condition: syntax.Expression,
  then_value: syntax.Expression,
  else_value: syntax.Expression,
  question: token.Token,
)
  uses Panic, RunForever
{
  let condition_span = cursor.read_file_span(condition.id)
  let then_span = cursor.read_file_span(then_value.id)
  let else_span = cursor.read_file_span(else_value.id)
  report_habit(
    mut cursor,
    code: "parser.conditional_operator",
    span: question.span,
    message: "Truss has no conditional operator; write `if x { a } else { b }`.",
    fix_title: "Write an `if` expression",
    edits: [
      source.insert(source.make_zero_width(condition_span.start), replacement: "if "),
      source.replace(source.make_span(condition_span.stop, stop: then_span.start), replacement: " { "),
      source.replace(source.make_span(then_span.stop, stop: else_span.start), replacement: " } else { "),
      source.insert(source.make_zero_width(else_span.stop), replacement: " }"),
    ],
  )
}

fn report_let_mut(cursor: mut TokenCursor, let_token: token.Token, mut_token: token.Token)
  uses Panic, RunForever
{
  report_habit(
    mut cursor,
    code: "parser.let_mut",
    span: mut_token.span,
    message: "A mutable variable is declared with `var`, not `let mut`.",
    fix_title: "Write `var`",
    edits: [source.replace(source.make_span(let_token.span.start, stop: mut_token.span.stop), replacement: "var")],
  )
}

fn report_address_of(cursor: mut TokenCursor, before: Option[token.Token], ampersand: token.Token, next: token.Token)
  uses Panic, RunForever
{
  let written = if next.kind == token.Kind.Keyword(token.Keyword.Mut) { "`mut x`" } else { "`x`" }
  let separator = match before {
    Some(previous) => {
      let is_word = match previous.kind {
        Upper(_) | Lower(_) | Keyword(_) | Reserved(_) | Integer(_) | Float(_) => true
        _ => false
      }
      if is_word && previous.span.stop == ampersand.span.start { " " } else { "" }
    }
    None => ""
  }
  report_habit(
    mut cursor,
    code: "parser.address_of",
    span: ampersand.span,
    message: "Truss has no `&`; write ${written}, with `mut` or `own` before a place only when it is mutated or moved.",
    fix_title: "Remove the `&`",
    edits: [source.replace(extend_with_trailing_space(written: ampersand, next: next), replacement: separator)],
  )
}

fn report_closure_bars(cursor: mut TokenCursor, opening: token.Token, closing: token.Token, body: syntax.Expression, is_before_else: Bool)
  uses Panic, RunForever
{
  let body_span = cursor.read_file_span(body.id)
  var edits: List[source.Edit] = []
  if is_before_else {
    mut edits.push(source.insert(source.make_zero_width(opening.span.start), replacement: "("))
  }
  if opening.kind == token.Kind.Punctuation(token.Punctuation.OrOr) {
    mut edits.push(source.replace(source.make_span(opening.span.start, stop: body_span.start), replacement: "fn() "))
  } else {
    mut edits.push(source.replace(opening.span, replacement: "fn("))
    mut edits.push(source.replace(source.make_span(closing.span.start, stop: body_span.start), replacement: ") "))
  }
  if !(body.kind is Block(_)) {
    mut edits.push(source.insert(source.make_zero_width(body_span.start), replacement: "{ "))
    mut edits.push(source.insert(source.make_zero_width(body_span.stop), replacement: " }"))
  }
  if is_before_else {
    mut edits.push(source.insert(source.make_zero_width(body_span.stop), replacement: ")"))
  }
  report_habit(
    mut cursor,
    code: "parser.closure_bars",
    span: opening.span,
    message: "A lambda is written `fn(x) { x + 1 }`.",
    fix_title: "Write `fn(...) { ... }`",
    edits: own edits,
  )
}

fn report_brace_record(cursor: mut TokenCursor, name_stop: UInt64, opening: token.Token, first: token.Token, last_stop: UInt64, closing: token.Token)
  uses Panic, RunForever
{
  report_habit(
    mut cursor,
    code: "parser.brace_record",
    span: opening.span,
    message: "Records are built with parentheses: `Point(x: 1.0, y: 2.0)`.",
    fix_title: "Use parentheses",
    edits: [
      source.replace(source.make_span(name_stop, stop: first.span.start), replacement: "("),
      source.replace(source.make_span(last_stop, stop: closing.span.stop), replacement: ")"),
    ],
  )
}

fn report_turbofish(cursor: mut TokenCursor, colons: token.Token, less: token.Token, greater: token.Token)
  uses Panic, RunForever
{
  report_habit(
    mut cursor,
    code: "parser.turbofish",
    span: less.span,
    message: "Type arguments go in square brackets: `parse[Int64](text)`.",
    fix_title: "Use square brackets",
    edits: [source.replace(source.make_span(colons.span.start, stop: less.span.stop), replacement: "["), source.replace(greater.span, replacement: "]")],
  )
}

fn report_angle_brackets(cursor: mut TokenCursor, angles: List[token.Token])
  uses Panic, RunForever
{
  var edits: List[source.Edit] = []
  for angle in angles {
    let replacement = if angle.kind == token.Kind.Punctuation(token.Punctuation.Less) {
      "["
    } else if angle.kind == token.Kind.Punctuation(token.Punctuation.ShiftRight) {
      "]]"
    } else {
      "]"
    }
    mut edits.push(source.replace(angle.span, replacement))
  }
  report_habit(
    mut cursor,
    code: "parser.angle_brackets",
    span: angles.get(0).expect("an angle bracket").span,
    message: "Type arguments and generic parameters go in square brackets: `List[String]`, `fn first[Element](...)`.",
    fix_title: "Use square brackets",
    edits: own edits,
  )
}

fn report_qualified_variant(cursor: mut TokenCursor, qualifier_start: UInt64, variant: syntax.Name)
  uses Panic, RunForever
{
  let variant_start = cursor.read_file_span(variant.id).start
  let span = source.make_span(qualifier_start, stop: variant_start)
  report_habit(
    mut cursor,
    code: "parser.qualified_variant",
    span: span,
    message: "A pattern names a variant alone: `${variant.text}`. The type of the scrutinee says which type's variant it is.",
    fix_title: "Remove the qualifier",
    edits: [source.delete(span)],
  )
}

fn show_macro_advice(name: String) -> view String {
  match name {
    "println" | "print" | "eprintln" | "eprint" => " Print with `Console.print_line(text)`, and build the text with `\${...}` in a string."
    "format" => " Build text with `\${...}` in a string."
    "vec" => " A list is written `[first, second]`."
    "assert" | "assert_eq" | "assert_ne" | "debug_assert" => " An assertion is a statement, `assert condition`, in a test, a theorem, or a proof."
    "dbg" => " `echo value` prints a value while debugging."
    "panic" => " Code that cannot be reached is `unreachable`, and a failure is a `Result`."
    _ => ""
  }
}

fn report_macro_call(cursor: mut TokenCursor, name: syntax.Name, bang: token.Token, opening: token.Token)
  uses Panic, RunForever
{
  let message = "Truss has no macros, so `${name.text}!` is not a call.${show_macro_advice(name.text)}"
  if name.text == "vec" && opening.kind == token.Kind.Punctuation(token.Punctuation.Open(token.Bracket.Square)) {
    let name_start = cursor.read_file_span(name.id).start
    report_habit(
      mut cursor,
      code: "parser.macro_call",
      span: bang.span,
      message: message,
      fix_title: "Write a list",
      edits: [source.delete(source.make_span(name_start, stop: bang.span.stop))],
    )
    return
  }
  report(mut cursor, code: "parser.macro_call", span: bang.span, message: message)
}

fn report_keyword_macro(cursor: mut TokenCursor, bang: token.Token, closing: token.Token, has_arguments: Bool)
  uses Panic, RunForever
{
  let message = "Truss has no macros. `todo` and `unreachable` are written without `!()`."
  if has_arguments {
    report(mut cursor, code: "parser.macro_call", span: bang.span, message: message)
    return
  }
  report_habit(
    mut cursor,
    code: "parser.macro_call",
    span: bang.span,
    message: message,
    fix_title: "Remove `!()`",
    edits: [source.delete(source.make_span(bang.span.start, stop: closing.span.stop))],
  )
}

fn report_tuple(cursor: mut TokenCursor, opening: token.Token) -> Failure
  uses Panic
{
  report(
    mut cursor,
    code: "parser.tuple",
    span: opening.span,
    message: "Parentheses do not make a tuple: every tuple type has a name and named fields. Values that belong together go in a record or a tuple type, such as `core.Pair`, built as `core.Pair(first: a, second: b)`.",
  )
  Failure.Failed
}

fn report_tuple_field(cursor: mut TokenCursor, field: token.Token) -> Failure
  uses Panic
{
  report(
    mut cursor,
    code: "parser.tuple",
    span: field.span,
    message: "A value has no numbered fields. Every field has a name, in a tuple type too, as in `pair.first`.",
  )
  Failure.Failed
}

fn report_power_operator(cursor: mut TokenCursor, operator: token.Token)
  uses Panic
{
  report(
    mut cursor,
    code: "parser.power_operator",
    span: operator.span,
    message: "Truss has no power operator. Multiply, as in `x * x`, or call the type's own method for a power.",
  )
}

fn report_short_declaration(cursor: mut TokenCursor, target: syntax.Expression, operator: token.Token)
  uses Panic, RunForever
{
  let message = "Truss has no `:=`. A new name is declared with `let name = value`."
  let is_plain_name = match target.kind {
    Name(_) => true
    _ => false
  }
  if is_plain_name {
    let target_start = cursor.read_file_span(target.id).start
    report_habit(
      mut cursor,
      code: "parser.short_declaration",
      span: operator.span,
      message: message,
      fix_title: "Declare the name with `let`",
      edits: [source.insert(source.make_zero_width(target_start), replacement: "let "), source.replace(operator.span, replacement: "=")],
    )
    return
  }
  report(mut cursor, code: "parser.short_declaration", span: operator.span, message: message)
}

fn is_path_expression(candidate: syntax.Expression) -> Bool
  uses RunForever
{
  match candidate.kind {
    Name(_) => true
    Member(base, ..) => is_path_expression(base)
    _ => false
  }
}

fn pipe_operator(cursor: mut TokenCursor, value: syntax.Expression, operator: token.Token, callee: syntax.Expression)
  uses Panic, RunForever
{
  let message = "Truss has no `|>`. A function is called with its argument: `function(value)`."
  let spelled = if is_path_expression(callee) { spell_node(cursor, id: callee.id) } else { None }
  if spelled is Some(callee_spelling) {
    let value_span = cursor.read_file_span(value.id)
    let callee_span = cursor.read_file_span(callee.id)
    report_habit(
      mut cursor,
      code: "parser.pipe_operator",
      span: operator.span,
      message: message,
      fix_title: "Write the call",
      edits: [
        source.insert(source.make_zero_width(value_span.start), replacement: "${callee_spelling}("),
        source.replace(source.make_span(value_span.stop, stop: callee_span.stop), replacement: ")"),
      ],
    )
    return
  }
  report(mut cursor, code: "parser.pipe_operator", span: operator.span, message: message)
}

fn report_lambda_annotation(cursor: mut TokenCursor, from: UInt64, stop: UInt64)
  uses Panic, RunForever
{
  let span = source.make_span(from, stop)
  report_habit(
    mut cursor,
    code: "parser.lambda_annotation",
    span: span,
    message: "A lambda's parameters and result have no annotations. Their types are inferred from where the lambda is passed.",
    fix_title: "Remove the annotation",
    edits: [source.delete(span)],
  )
}

fn report_impl_parameters(cursor: mut TokenCursor, opening: token.Token, closing: token.Token, has_bounds: Bool)
  uses Panic, RunForever
{
  let message = "An `impl` has no parameters of its own. The type after `for` declares them, with their bounds: `impl Trait for Box[Item: Ordered]`."
  if has_bounds {
    report(mut cursor, code: "parser.impl_parameters", span: opening.span, message: message)
    return
  }
  report_habit(
    mut cursor,
    code: "parser.impl_parameters",
    span: opening.span,
    message: message,
    fix_title: "Remove the parameters",
    edits: [source.delete(source.make_span(opening.span.start, stop: closing.span.stop))],
  )
}

fn report_null_coalescing(cursor: mut TokenCursor, value: syntax.Expression, first: token.Token, second: token.Token, default: syntax.Expression)
  uses Panic, RunForever
{
  let value_span = cursor.read_file_span(value.id)
  let default_span = cursor.read_file_span(default.id)
  let needs_parentheses = match value.kind {
    Binary(..) | Is(..) | Range(..) | Prefix(..) | Mode(..) | Quantified(..) | Echo(_) | Return(_) => true
    _ => false
  }
  let written = if second.kind == token.Kind.Punctuation(token.Punctuation.Colon) { "?:" } else { "??" }
  var edits: List[source.Edit] = []
  if needs_parentheses {
    mut edits.push(source.insert(source.make_zero_width(value_span.start), replacement: "("))
  }
  let call = if needs_parentheses { ").unwrap_or(" } else { ".unwrap_or(" }
  mut edits.push(source.replace(source.make_span(value_span.stop, stop: default_span.start), replacement: call))
  mut edits.push(source.insert(source.make_zero_width(default_span.stop), replacement: ")"))
  report_habit(
    mut cursor,
    code: "parser.null_coalescing",
    span: first.span,
    message: "Truss has no `${written}`. An `Option`'s value, or a default when it has none, is `option.unwrap_or(default)`.",
    fix_title: "Call `unwrap_or`",
    edits: own edits,
  )
}

fn singularize(word: String) -> Option[String]
  uses Panic
{
  let length = word.length()
  if length > 3 && word.ends_with("ies") {
    return Some("${word.substring(0, to: length - 3)}y")
  }
  let is_excluded = word.ends_with("ss") || word.ends_with("us") || word.ends_with("is") || word.ends_with("ses")
    || word.ends_with("xes") || word.ends_with("zes") || word.ends_with("ches") || word.ends_with("shes")
  if length > 1 && word.ends_with("s") && !is_excluded {
    return Some(word.substring(0, to: length - 1).copy())
  }
  None
}

fn derive_parameter_name(callee: syntax.Expression) -> String
  uses Panic
{
  let candidate = match callee.kind {
    Member(base, ..) => match base.kind {
      Name(name) => singularize(name.text)
      _ => None
    }
    _ => None
  }
  match own candidate {
    Some(name) => if name != "it" && token.find_word(name).is_none() { name } else { "element".copy() }
    None => "element".copy()
  }
}

fn report_trailing_lambda(
  cursor: mut TokenCursor,
  callee: syntax.Expression,
  parameter: String,
  opening: token.Token,
  closing: token.Token,
  next: token.Token,
  uses_of_it: List[token.Token],
)
  uses Panic, RunForever
{
  let message = "A lambda is passed inside the parentheses, with a named parameter: `fn(${parameter}) { ... }`."
  if !ends_statement(next.kind) {
    report(mut cursor, code: "parser.trailing_lambda", span: opening.span, message: message)
    return
  }
  let callee_stop = cursor.read_file_span(callee.id).stop
  var edits: List[source.Edit] = [
    source.replace(source.make_span(callee_stop, stop: opening.span.start), replacement: "(fn(${parameter}) "),
    source.insert(source.make_zero_width(closing.span.stop), replacement: ")"),
  ]
  for use_of_it in uses_of_it {
    mut edits.push(source.replace(use_of_it.span, replacement: parameter))
  }
  report_habit(
    mut cursor,
    code: "parser.trailing_lambda",
    span: opening.span,
    message: message,
    fix_title: "Pass a lambda",
    edits: own edits,
  )
}

fn is_integer_type_name(name: String) -> Bool {
  match name {
    "Int8" | "Int16" | "Int32" | "Int64" | "UInt8" | "UInt16" | "UInt32" | "UInt64" => true
    _ => false
  }
}

fn make_conversion_fix(target_spelling: String, name: String, value: source.Span, target: source.Span) -> source.Fix
  uses Panic
{
  source.make_fix(
    "Write `${target_spelling}.${name}(...)`",
    edits: [
      source.insert(source.make_zero_width(value.start), replacement: "${target_spelling}.${name}("),
      source.replace(source.make_span(value.stop, stop: target.stop), replacement: ")"),
    ],
  )
}

fn is_simple_spelling(text: String) -> Bool {
  for byte in text.bytes() {
    let is_allowed = byte == 95 || byte == 46 || (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57)
    if !is_allowed {
      return false
    }
  }
  true
}

fn report_as_conversion(cursor: mut TokenCursor, value: syntax.Expression, as_token: token.Token, target: syntax.TypeExpression)
  uses Panic, RunForever
{
  let Some(target_spelling) = spell_node(cursor, id: target.id) else {
    report(
      mut cursor,
      code: "parser.as_conversion",
      span: as_token.span,
      message: "Truss has no `as`; call a conversion of the target type, such as `from_integer` or `try_from_integer` for an integer, or `from` or `try_from` for a library type.",
    )
    return
  }
  let value_span = cursor.read_file_span(value.id)
  let target_span = cursor.read_file_span(target.id)
  if target_spelling == "Float32" || target_spelling == "Float64" {
    let method = "to_${target_spelling.to_ascii_lowercase()}"
    let is_simple = match cursor.spell(value_span) {
      Some(value_text) => is_simple_spelling(value_text)
      None => false
    }
    var edits: List[source.Edit] = []
    if !is_simple {
      mut edits.push(source.insert(source.make_zero_width(value_span.start), replacement: "("))
    }
    let closing = if is_simple { "" } else { ")" }
    mut edits.push(source.replace(source.make_span(value_span.stop, stop: target_span.stop), replacement: "${closing}.${method}()"))
    report(
      mut cursor,
      code: "parser.as_conversion",
      span: as_token.span,
      message: "Truss has no `as`; write `x.${method}()`.",
      fixes: [source.make_fix("Write `.${method}()`", own edits)],
    )
    return
  }
  let checked = if is_integer_type_name(target_spelling) { "from_integer" } else { "from" }
  let fallible = if is_integer_type_name(target_spelling) { "try_from_integer" } else { "try_from" }
  report(
    mut cursor,
    code: "parser.as_conversion",
    span: as_token.span,
    message: "Truss has no `as`; write `${target_spelling}.${checked}(x)`, or `${target_spelling}.${fallible}(x)` when the value may not fit.",
    fixes: [
      make_conversion_fix(target_spelling, name: checked, value: value_span, target: target_span),
      make_conversion_fix(target_spelling, name: fallible, value: value_span, target: target_span),
    ],
  )
}

fn report_elif(cursor: mut TokenCursor, previous_stop: UInt64, elif_token: token.Token)
  uses Panic, RunForever
{
  report_habit(
    mut cursor,
    code: "parser.elif",
    span: elif_token.span,
    message: "Truss writes `else if`, not `elif`.",
    fix_title: "Write `else if`",
    edits: [source.replace(source.make_span(previous_stop, stop: elif_token.span.stop), replacement: " else if")],
  )
}

fn report_loop(cursor: mut TokenCursor, loop_token: token.Token)
  uses Panic, RunForever
{
  report_habit(
    mut cursor,
    code: "parser.reserved_word",
    span: loop_token.span,
    message: "Truss has no `loop`; write `while true`.",
    fix_title: "Write `while true`",
    edits: [source.replace(loop_token.span, replacement: "while true")],
  )
}

fn report_constant_keyword(cursor: mut TokenCursor, written: token.Token)
  uses Panic, RunForever
{
  let word: view String = match written.kind {
    Reserved(reserved) => token.spell_reserved(reserved)
    _ => ""
  }
  report_habit(
    mut cursor,
    code: "parser.reserved_word",
    span: written.span,
    message: "Truss has no `${word}`; a constant is a `let` at the top level.",
    fix_title: "Write `let`",
    edits: [source.replace(written.span, replacement: "let")],
  )
}
