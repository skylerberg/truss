use frontend.source
use frontend.syntax
use frontend.token

type Group =
  | ArithmeticGroup
  | ShiftGroup
  | BitwiseGroup(bitwise: syntax.Bitwise)
  | RangeGroup
  | ComparisonGroup
  | AndGroup
  | OrGroup
  | ImpliesGroup
  | Lowest
  derives Equal

type Parent(group: Group, is_right: Bool)
  derives Equal

fn classify_binary(binary: syntax.Binary) -> Group {
  match binary {
    Operation(operation) => match operation {
      Arithmetic(_) => Group.ArithmeticGroup
      Shift(_) => Group.ShiftGroup
      Bitwise(bitwise) => Group.BitwiseGroup(bitwise)
    }
    Comparison(_) => Group.ComparisonGroup
    Connective(connective) => match connective {
      And => Group.AndGroup
      Or => Group.OrGroup
      Implies => Group.ImpliesGroup
    }
  }
}

fn group_of(value: syntax.Expression) -> Option[Group] {
  match value.kind {
    Binary(operator, ..) => Some(classify_binary(operator))
    Is(..) => Some(Group.ComparisonGroup)
    Range(..) => Some(Group.RangeGroup)
    Quantified(..) | Echo(_) | Return(_) => Some(Group.Lowest)
    _ => None
  }
}

type Operands(first: UInt64, second: UInt64)
  derives Equal

fn find_operands(value: syntax.Expression) -> Option[Operands] {
  match value.kind {
    Binary(left, right, ..) => Some(Operands(first: left.id, second: right.id))
    Is(value: tested, pattern, ..) => Some(Operands(first: tested.id, second: pattern.id))
    Range(start, stop, ..) => match start, stop {
      Some(start_value), Some(stop_value) => Some(Operands(first: start_value.id, second: stop_value.id))
      _, _ => None
    }
    _ => None
  }
}

fn extract_operator_id(value: syntax.Expression) -> UInt64 {
  match value.kind {
    Binary(operator_id, ..) | Is(operator_id, ..) | Range(operator_id, ..) => operator_id
    _ => value.id
  }
}

type Language = TrussLanguage | CLanguage | GoLanguage | SwiftLanguage
  derives Equal

fn rank_in(language: Language, operator: syntax.Binary) -> UInt64 {
  if language == Language.TrussLanguage {
    return rank_binary(operator)
  }
  match operator {
    Connective(_) => 0
    Operation(operation) => match operation {
      Arithmetic(arithmetic) => match arithmetic {
        Multiply | Divide | Remainder => 10
        Add | Subtract => 9
      }
      Shift(_) => match language {
        CLanguage => 8
        GoLanguage => 10
        _ => 11
      }
      Bitwise(bitwise) => match language {
        CLanguage => match bitwise {
          BitAnd => 5
          BitXor => 4
          BitOr => 3
        }
        _ => match bitwise {
          BitAnd => 10
          BitXor | BitOr => 9
        }
      }
    }
    Comparison(comparison) => match language {
      CLanguage => match comparison {
        Less | LessEqual | Greater | GreaterEqual => 7
        Equal | NotEqual => 6
      }
      _ => 4
    }
  }
}

fn applies_first(language: Language, first: syntax.Binary, second: syntax.Binary) -> Bool {
  rank_in(language, operator: first) >= rank_in(language, operator: second)
}

type Grouping = LeftFirst | RightFirst
  derives Equal

fn report_parentheses(cursor: mut TokenCursor, id: UInt64, message: StringSlice, fixes: own List[source.Fix])
  uses Panic
{
  let span = cursor.read_file_span(id)
  report(mut cursor, code: "parser.needs_parentheses", span: span, message: message, fixes: own fixes)
}

let longest_titled_expression: UInt64 = 80

fn make_titled_fix(cursor: TokenCursor, fallback: StringSlice, whole: UInt64, edits: own List[source.Edit]) -> source.Fix
  uses Panic, RunForever
{
  var insertions: List[token.Insertion] = []
  for edit in edits {
    mut insertions.push(token.Insertion(at: edit.span.start, text: edit.replacement.copy()))
  }
  let span = cursor.read_file_span(whole)
  let spelled = if span.stop - span.start > longest_titled_expression { None } else { cursor.spell(span, insertions) }
  match spelled {
    Some(fixed) => source.make_fix("Write `${fixed}`", own edits)
    None => source.make_fix(fallback, own edits)
  }
}

fn make_parentheses(cursor: TokenCursor, first: UInt64, last: UInt64) -> List[source.Edit]
  uses Panic
{
  [
    source.insert(source.make_zero_width(cursor.read_file_span(first).start), replacement: "("),
    source.insert(source.make_zero_width(cursor.read_file_span(last).stop), replacement: ")"),
  ]
}

fn is_name_or_literal(value: syntax.Expression) -> Bool {
  match value.kind {
    Name(_) | Integer(_) | Float(_) | String(_) | True | False => true
    _ => false
  }
}

type Problem = LowestOperand | Chained(message: String) | Mixed(message: String) | MixedBitwise
  derives Equal

fn is_bitwise_group(group: Group) -> Bool {
  match group {
    ShiftGroup | BitwiseGroup(_) => true
    _ => false
  }
}

fn is_connective_group(group: Group) -> Bool {
  group == Group.AndGroup || group == Group.OrGroup || group == Group.ImpliesGroup
}

fn find_problem(parent: Group, child: Group, is_right: Bool, operand: syntax.Expression) -> Option[Problem] {
  if is_connective_group(parent) && child == Group.Lowest && is_right && operand.kind is Quantified(..) {
    return None
  }
  if child == Group.Lowest {
    return Some(Problem.LowestOperand)
  }
  if parent == child && (parent == Group.ArithmeticGroup || parent == Group.ShiftGroup || parent == Group.AndGroup || parent == Group.OrGroup) {
    return None
  }
  if parent == child && parent is BitwiseGroup(_) {
    return None
  }
  if child == Group.ArithmeticGroup && (parent == Group.RangeGroup || parent == Group.ComparisonGroup || is_connective_group(parent)) {
    return None
  }
  if child == Group.RangeGroup && (parent == Group.ComparisonGroup || is_connective_group(parent)) {
    return None
  }
  if child == Group.ComparisonGroup && is_connective_group(parent) {
    return None
  }
  if parent == Group.ImpliesGroup && (child == Group.AndGroup || child == Group.OrGroup) {
    return None
  }
  if parent == Group.RangeGroup && child == Group.RangeGroup {
    return Some(Problem.Chained("Ranges do not chain."))
  }
  if parent == Group.ComparisonGroup && child == Group.ComparisonGroup {
    return Some(Problem.Chained("Comparisons do not chain."))
  }
  if parent == Group.ImpliesGroup && child == Group.ImpliesGroup {
    return Some(Problem.Chained("`==>` does not chain."))
  }
  if (parent == Group.AndGroup && child == Group.OrGroup) || (parent == Group.OrGroup && child == Group.AndGroup) {
    return Some(Problem.Mixed("`&&` and `||` cannot be mixed without parentheses."))
  }
  if is_bitwise_group(parent) || is_bitwise_group(child) {
    return Some(Problem.MixedBitwise)
  }
  Some(Problem.Mixed("These operators need parentheses to say which applies first."))
}

fn wrap_edits(cursor: TokenCursor, context: Option[Parent], whole: syntax.Expression, last: Option[Group], edits: own List[source.Edit]) -> List[source.Edit]
  uses Panic
{
  if context is Some(outer) && last is Some(last_group) && find_problem(outer.group, child: last_group, is_right: outer.is_right, operand: whole).is_some() {
    var wrapped = own edits
    mut wrapped.append(make_parentheses(cursor, first: whole.id, last: whole.id))
    return wrapped
  }
  edits
}

type Pieces(first_operator: UInt64, second_operator: UInt64, third_operator: UInt64)
  derives Equal

fn make_grouping_fix(
  cursor: TokenCursor,
  context: Option[Parent],
  whole: syntax.Expression,
  operand: syntax.Expression,
  pieces: Pieces,
  parsed: Grouping,
  grouping: Grouping,
) -> source.Fix
  uses Panic, RunForever
{
  let edits = match grouping {
    LeftFirst => make_parentheses(cursor, first: pieces.first_operator, last: pieces.second_operator)
    RightFirst => make_parentheses(cursor, first: pieces.second_operator, last: pieces.third_operator)
  }
  let last = if grouping == parsed { group_of(whole) } else { group_of(operand) }
  let fallback = match grouping {
    LeftFirst => "Group the first two operands"
    RightFirst => "Group the last two operands"
  }
  make_titled_fix(cursor, fallback, whole: whole.id, edits: wrap_edits(cursor, context, whole, last, own edits))
}

fn find_first_operand(value: syntax.Expression) -> Option[syntax.Expression]
  uses RunForever
{
  match value.kind {
    Binary(left, ..) => if group_of(left) == group_of(value) { find_first_operand(left) } else { Some(left.copy()) }
    Is(value: tested, ..) => Some(tested.copy())
    Range(start, stop, ..) => match start, stop {
      Some(start_value), Some(_) => Some(start_value.copy())
      _, _ => None
    }
    _ => None
  }
}

fn find_last_operand(value: syntax.Expression) -> Option[syntax.Expression] {
  match value.kind {
    Binary(right, ..) => Some(right.copy())
    Range(start, stop, ..) => match start, stop {
      Some(_), Some(stop_value) => Some(stop_value.copy())
      _, _ => None
    }
    _ => None
  }
}

fn regroups_cleanly(whole: syntax.Expression, operand: syntax.Expression, is_right: Bool, parsed: Grouping, grouping: Grouping) -> Bool
  uses RunForever
{
  if grouping == parsed {
    return true
  }
  let middle = if is_right { find_first_operand(operand) } else { find_last_operand(operand) }
  match group_of(whole), middle {
    Some(outer), Some(middle_value) => match group_of(middle_value) {
      Some(inner) => find_problem(outer, child: inner, is_right: is_right, operand: middle_value).is_none()
      None => true
    }
    _, _ => true
  }
}

fn report_problem(
  cursor: mut TokenCursor,
  context: Option[Parent],
  whole: syntax.Expression,
  operand: syntax.Expression,
  is_right: Bool,
  problem: Problem,
)
  uses Panic, RunForever
{
  let pieces = match find_operands(whole), find_operands(operand) {
    Some(whole_operands), Some(operand_operands) => if !is_right {
      Some(Pieces(first_operator: operand_operands.first, second_operator: operand_operands.second, third_operator: whole_operands.second))
    } else {
      match find_first_operand(operand) {
        Some(first) => Some(Pieces(first_operator: whole_operands.first, second_operator: first.id, third_operator: operand_operands.second))
        None => None
      }
    }
    _, _ => None
  }
  let parsed = if is_right { Grouping.RightFirst } else { Grouping.LeftFirst }
  let other = if is_right { Grouping.LeftFirst } else { Grouping.RightFirst }
  let candidates = if operand.kind is Is(..) && !is_right { [parsed] } else { [parsed, other] }
  var groupings: List[Grouping] = []
  for grouping in candidates {
    if regroups_cleanly(whole, operand, is_right, parsed, grouping) {
      mut groupings.push(grouping)
    }
  }
  match problem {
    LowestOperand => {
      let fix = make_titled_fix(cursor, fallback: "Add parentheses", whole: operand.id, edits: make_parentheses(cursor, first: operand.id, last: operand.id))
      report_parentheses(
        mut cursor,
        id: operand.id,
        message: "This takes everything after it, so as an operand it must be in parentheses, except that `forall` and `exists` may be the last operand of `&&`, `||`, or `==>`.",
        fixes: [own fix],
      )
    }
    Mixed(message) => {
      var fixes: List[source.Fix] = []
      if pieces is Some(operator_ids) {
        for grouping in groupings {
          mut fixes.push(make_grouping_fix(cursor, context, whole, operand, pieces: operator_ids, parsed: parsed, grouping: grouping))
        }
      }
      report_parentheses(mut cursor, id: extract_operator_id(whole), message: message, fixes: own fixes)
    }
    MixedBitwise => {
      var fixes: List[source.Fix] = []
      let both_binary = match whole.kind, operand.kind {
        Binary(operator: outer, ..), Binary(operator: inner, ..) => Some(Operators(outer, inner))
        _, _ => None
      }
      if pieces is Some(operator_ids) {
        if both_binary is Some(operators) {
          let first = if is_right { operators.outer } else { operators.inner }
          let second = if is_right { operators.inner } else { operators.outer }
          var other_appears = false
          for language in [Language.TrussLanguage, Language.CLanguage, Language.GoLanguage, Language.SwiftLanguage] {
            let grouping = if applies_first(language, first, second) { Grouping.LeftFirst } else { Grouping.RightFirst }
            if grouping == other {
              other_appears = true
            }
          }
          let ordered = if other_appears { [parsed, other] } else { [parsed] }
          for grouping in ordered {
            if regroups_cleanly(whole, operand, is_right, parsed, grouping) {
              mut fixes.push(make_grouping_fix(cursor, context, whole, operand, pieces: operator_ids, parsed: parsed, grouping: grouping))
            }
          }
        } else {
          for grouping in groupings {
            mut fixes.push(make_grouping_fix(cursor, context, whole, operand, pieces: operator_ids, parsed: parsed, grouping: grouping))
          }
        }
      }
      report_parentheses(
        mut cursor,
        id: extract_operator_id(whole),
        message: "Shifts and bitwise operators combine only with themselves; add parentheses.",
        fixes: own fixes,
      )
    }
    Chained(message) => {
      var fixes: List[source.Fix] = []
      let is_implies = match whole.kind {
        Binary(operator, ..) => operator == syntax.Binary.Connective(syntax.Connective.Implies)
        _ => false
      }
      if is_implies {
        if pieces is Some(operator_ids) {
          for grouping in groupings.reversed() {
            mut fixes.push(make_grouping_fix(cursor, context, whole, operand, pieces: operator_ids, parsed: parsed, grouping: grouping))
          }
        }
      } else if whole.kind is Binary(..) && !is_right && operand.kind is Binary(right: middle, ..) && is_name_or_literal(middle) {
        let middle_span = cursor.read_file_span(middle.id)
        if cursor.spell(middle_span) is Some(middle_spelling) {
          let edits = wrap_edits(
            cursor,
            context,
            whole,
            last: Some(Group.AndGroup),
            edits: [source.insert(source.make_zero_width(middle_span.stop), replacement: " && ${middle_spelling}")],
          )
          mut fixes.push(make_titled_fix(cursor, fallback: "Join the comparisons with `&&`", whole: whole.id, edits: own edits))
        }
      }
      report_parentheses(mut cursor, id: extract_operator_id(whole), message: message, fixes: own fixes)
    }
  }
}

type Operators(outer: syntax.Binary, inner: syntax.Binary)
  derives Equal

fn check_operand(cursor: mut TokenCursor, context: Option[Parent], value: syntax.Expression, parent: Group, is_right: Bool, operand: syntax.Expression)
  uses Panic, RunForever
{
  check_precedence(mut cursor, value: operand, context: Some(Parent(group: parent, is_right)))
  if group_of(operand) is Some(child) && find_problem(parent, child, is_right, operand) is Some(problem) {
    report_problem(mut cursor, context, whole: value, operand: operand, is_right: is_right, problem: problem.copy())
  }
}

fn check_precedence(cursor: mut TokenCursor, value: syntax.Expression, context: Option[Parent])
  uses Panic, RunForever
{
  match value.kind {
    Binary(operator, left, right, ..) => {
      let group = classify_binary(operator)
      check_operand(mut cursor, context, value, parent: group, is_right: false, operand: left)
      check_operand(mut cursor, context, value, parent: group, is_right: true, operand: right)
    }
    Is(value: left, operator_id, ..) => {
      if left.kind is Prefix(operator, ..) && operator == syntax.PrefixOperator.Not {
        let whole = cursor.read_file_span(value.id)
        let negate_test = make_titled_fix(
          cursor,
          fallback: "Negate the test",
          whole: value.id,
          edits: [
            source.insert(source.make_zero_width(whole.start + 1), replacement: "("),
            source.insert(source.make_zero_width(whole.stop), replacement: ")"),
          ],
        )
        let negate_value = make_titled_fix(cursor, fallback: "Negate the value", whole: value.id, edits: make_parentheses(cursor, first: left.id, last: left.id))
        report_parentheses(
          mut cursor,
          id: operator_id,
          message: "`!` and `is` have no relative precedence. Add parentheses to say whether the test or the value is negated.",
          fixes: [own negate_test, own negate_value],
        )
      }
      check_operand(mut cursor, context, value, parent: Group.ComparisonGroup, is_right: false, operand: left)
    }
    Range(start, stop, ..) => {
      if start is Some(start_value) {
        check_operand(mut cursor, context, value, parent: Group.RangeGroup, is_right: false, operand: start_value)
      }
      if stop is Some(stop_value) {
        check_operand(mut cursor, context, value, parent: Group.RangeGroup, is_right: true, operand: stop_value)
      }
    }
    Prefix(operand: inner, ..) => {
      check_precedence(mut cursor, value: inner, context: None)
      if group_of(inner) == Some(Group.Lowest) {
        report_problem(mut cursor, context: None, whole: value, operand: inner, is_right: true, problem: Problem.LowestOperand)
      }
    }
    _ => walk_expression_parts(mut cursor, visitor: Visitor.PrecedenceVisitor, value: value)
  }
}
