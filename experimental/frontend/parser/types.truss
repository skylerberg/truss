use frontend.source
use frontend.syntax
use frontend.token

fn is_clause_keyword(kind: token.Kind) -> Bool {
  match kind {
    Keyword(keyword) => match keyword {
      Uses | Requires | Ensures | Decreases | Cost => true
      _ => false
    }
    _ => false
  }
}

type Operator = BinaryOperator(binary: syntax.Binary) | IsOperator | RangeOperator(is_inclusive: Bool)
  derives Equal

let comparison_level: UInt64 = 3

let range_level: UInt64 = 4

fn rank_binary(binary: syntax.Binary) -> UInt64 {
  match binary {
    Connective(connective) => match connective {
      Implies => 0
      Or => 1
      And => 2
    }
    Comparison(_) => comparison_level
    Operation(operation) => match operation {
      Bitwise(bitwise) => match bitwise {
        BitOr => 5
        BitXor => 6
        BitAnd => 7
      }
      Shift(_) => 8
      Arithmetic(arithmetic) => match arithmetic {
        Add | Subtract => 9
        Multiply | Divide | Remainder => 10
      }
    }
  }
}

fn rank_operator(operator: Operator) -> UInt64 {
  match operator {
    BinaryOperator(binary) => rank_binary(binary)
    IsOperator => comparison_level
    RangeOperator(_) => range_level
  }
}

fn binary_operator(binary: syntax.Binary) -> Option[Operator] {
  Some(Operator.BinaryOperator(binary))
}

fn arithmetic_operator(arithmetic: syntax.Arithmetic) -> Option[Operator] {
  binary_operator(syntax.Binary.Operation(syntax.Operation.Arithmetic(arithmetic)))
}

fn find_operator(kind: token.Kind) -> Option[Operator] {
  match kind {
    Punctuation(punctuation) => match punctuation {
      Implies => binary_operator(syntax.Binary.Connective(syntax.Connective.Implies))
      OrOr => binary_operator(syntax.Binary.Connective(syntax.Connective.Or))
      AndAnd => binary_operator(syntax.Binary.Connective(syntax.Connective.And))
      EqualEqual => binary_operator(syntax.Binary.Comparison(syntax.Comparison.Equal))
      NotEqual => binary_operator(syntax.Binary.Comparison(syntax.Comparison.NotEqual))
      Less => binary_operator(syntax.Binary.Comparison(syntax.Comparison.Less))
      LessEqual => binary_operator(syntax.Binary.Comparison(syntax.Comparison.LessEqual))
      Greater => binary_operator(syntax.Binary.Comparison(syntax.Comparison.Greater))
      GreaterEqual => binary_operator(syntax.Binary.Comparison(syntax.Comparison.GreaterEqual))
      DotDot => Some(Operator.RangeOperator(is_inclusive: false))
      DotDotEqual => Some(Operator.RangeOperator(is_inclusive: true))
      Bar => binary_operator(syntax.Binary.Operation(syntax.Operation.Bitwise(syntax.Bitwise.BitOr)))
      Caret => binary_operator(syntax.Binary.Operation(syntax.Operation.Bitwise(syntax.Bitwise.BitXor)))
      Ampersand => binary_operator(syntax.Binary.Operation(syntax.Operation.Bitwise(syntax.Bitwise.BitAnd)))
      ShiftLeft => binary_operator(syntax.Binary.Operation(syntax.Operation.Shift(syntax.Shift.ShiftLeft)))
      ShiftRight => binary_operator(syntax.Binary.Operation(syntax.Operation.Shift(syntax.Shift.ShiftRight)))
      Plus => arithmetic_operator(syntax.Arithmetic.Add)
      Minus => arithmetic_operator(syntax.Arithmetic.Subtract)
      Star => arithmetic_operator(syntax.Arithmetic.Multiply)
      Slash => arithmetic_operator(syntax.Arithmetic.Divide)
      Percent => arithmetic_operator(syntax.Arithmetic.Remainder)
      _ => None
    }
    Keyword(keyword) => if keyword == token.Keyword.Is { Some(Operator.IsOperator) } else { None }
    _ => None
  }
}

fn compound(operation: syntax.Operation) -> Option[syntax.Assignment] {
  Some(syntax.Assignment.Compound(operation))
}

fn find_assignment_operator(kind: token.Kind) -> Option[syntax.Assignment] {
  match kind {
    Punctuation(punctuation) => match punctuation {
      Equal => Some(syntax.Assignment.Assign)
      PlusEqual => compound(syntax.Operation.Arithmetic(syntax.Arithmetic.Add))
      MinusEqual => compound(syntax.Operation.Arithmetic(syntax.Arithmetic.Subtract))
      StarEqual => compound(syntax.Operation.Arithmetic(syntax.Arithmetic.Multiply))
      SlashEqual => compound(syntax.Operation.Arithmetic(syntax.Arithmetic.Divide))
      PercentEqual => compound(syntax.Operation.Arithmetic(syntax.Arithmetic.Remainder))
      AmpersandEqual => compound(syntax.Operation.Bitwise(syntax.Bitwise.BitAnd))
      BarEqual => compound(syntax.Operation.Bitwise(syntax.Bitwise.BitOr))
      CaretEqual => compound(syntax.Operation.Bitwise(syntax.Bitwise.BitXor))
      ShiftLeftEqual => compound(syntax.Operation.Shift(syntax.Shift.ShiftLeft))
      ShiftRightEqual => compound(syntax.Operation.Shift(syntax.Shift.ShiftRight))
      _ => None
    }
    _ => None
  }
}

fn is_open(kind: token.Kind) -> Bool {
  match kind {
    Punctuation(punctuation) => match punctuation {
      Open(_) => true
      _ => false
    }
    _ => false
  }
}

fn skip_angle_brackets(cursor: mut TokenCursor)
  uses Panic, RunForever
{
  let Some(closer) = cursor.find_angle_closer() else {
    return
  }
  var angles: List[token.Token] = []
  var index = cursor.index
  while index <= closer {
    let current = cursor.lookup_token(index)
    let is_angle = current.kind == token.Kind.Punctuation(token.Punctuation.Less)
      || current.kind == token.Kind.Punctuation(token.Punctuation.Greater)
      || current.kind == token.Kind.Punctuation(token.Punctuation.ShiftRight)
    if is_angle {
      mut angles.push(current)
      index += 1
    } else if is_open(current.kind) {
      index = cursor.lookup_closer(index) + 1
    } else {
      index += 1
    }
  }
  report_angle_brackets(mut cursor, angles)
  skip_to(mut cursor, limit: closer + 1)
}

fn macro_follows(cursor: TokenCursor, name_stop: UInt64) -> Bool
  uses Panic
{
  let bang = cursor.peek()
  let opener = cursor.lookup_token(cursor.index + 1)
  bang.kind == token.Kind.Punctuation(token.Punctuation.Bang) && bang.span.start == name_stop && opener.span.start == bang.span.stop
    && (opener.kind == token.Kind.Punctuation(token.Punctuation.Open(token.Bracket.Paren))
      || opener.kind == token.Kind.Punctuation(token.Punctuation.Open(token.Bracket.Square)))
}

fn starts_operand_kind(kind: token.Kind) -> Bool {
  match kind {
    Punctuation(punctuation) => match punctuation {
      Open(_) | Minus | DotDot | DotDotEqual => true
      _ => false
    }
    _ => false
  }
}

fn coalescing_follows(cursor: TokenCursor) -> Bool
  uses Panic
{
  let question = cursor.peek()
  let second = cursor.lookup_token(cursor.index + 1)
  let third = cursor.peek_ahead(2)
  if !(question.kind == token.Kind.Punctuation(token.Punctuation.Question) && second.span.start == question.span.stop
    && begins_expression(third))
  {
    return false
  }
  if second.kind == token.Kind.Punctuation(token.Punctuation.Question) {
    return !starts_operand_kind(third)
  }
  if second.kind == token.Kind.Punctuation(token.Punctuation.Colon) {
    return question.span.start > cursor.compute_previous_stop()
  }
  false
}

fn has_comma(cursor: TokenCursor, opener: UInt64) -> Bool
  uses Panic
{
  let closer = cursor.lookup_closer(opener)
  var index = opener + 1
  while index < closer {
    let kind = cursor.lookup_token(index).kind
    if kind == token.Kind.Punctuation(token.Punctuation.Comma) {
      return true
    }
    if is_open(kind) {
      let nested_closer = cursor.lookup_closer(index)
      if nested_closer < index {
        Panic.crash("a group closes before it opens")
      }
      index = nested_closer + 1
    } else {
      index += 1
    }
  }
  false
}

fn parse_type_expression(cursor: mut TokenCursor) -> Result[syntax.TypeExpression, Failure]
  uses Panic, RunForever
{
  enter_nested(mut cursor)?
  let result = parse_type_expression_inner(mut cursor)
  leave_nested(mut cursor)
  result
}

fn parse_type_expression_inner(cursor: mut TokenCursor) -> Result[syntax.TypeExpression, Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  let first = cursor.peek_kind()
  if first == token.Kind.Keyword(token.Keyword.SelfType) {
    advance(mut cursor)
    let associated = if accept_punctuation(mut cursor, punctuation: token.Punctuation.Dot) {
      Some(parse_upper_name(mut cursor, expected: "an associated type after `Self.`")?)
    } else {
      None
    }
    return Ok(make_type_node(mut cursor, start, kind: syntax.TypeKind.SelfType(own associated)))
  }
  if first == token.Kind.Keyword(token.Keyword.Any) {
    advance(mut cursor)
    let path_type = parse_path_type(mut cursor)?
    return Ok(make_type_node(mut cursor, start, kind: syntax.TypeKind.AnyType(own path_type)))
  }
  if first == token.Kind.Keyword(token.Keyword.Fn) {
    let function_type = parse_function_type(mut cursor, with_clauses: false)?
    return Ok(make_type_node(mut cursor, start, kind: syntax.TypeKind.FunctionType(own function_type)))
  }
  if first == token.Kind.Punctuation(token.Punctuation.Open(token.Bracket.Paren)) {
    return Ok(parse_parenthesized_function_type(mut cursor))
  }
  match first {
    Upper(_) => {
      if cursor.peek_ahead(1) == token.Kind.Punctuation(token.Punctuation.Dot) && cursor.peek_ahead(2) is Upper(_) {
        let parameter = take_name(mut cursor)
        advance(mut cursor)
        let name = parse_upper_name(mut cursor, expected: "an associated type")?
        return Ok(make_type_node(mut cursor, start, kind: syntax.TypeKind.Associated(own parameter, own name)))
      }
      let path_type = parse_path_type(mut cursor)?
      Ok(make_type_node(mut cursor, start, kind: syntax.TypeKind.PathType(own path_type)))
    }
    Lower(_) => {
      let path_type = parse_path_type(mut cursor)?
      Ok(make_type_node(mut cursor, start, kind: syntax.TypeKind.PathType(own path_type)))
    }
    _ => Err(fail(mut cursor, expected: "a type"))
  }
}

fn parse_path_type(cursor: mut TokenCursor) -> Result[syntax.PathType, Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  let path = parse_upper_path(mut cursor, expected: "a type name")?
  let arguments = if cursor.is_punctuation(token.Punctuation.Open(token.Bracket.Square)) {
    parse_type_arguments(mut cursor)?
  } else {
    if cursor.is_punctuation(token.Punctuation.Less) {
      skip_angle_brackets(mut cursor)
    }
    []
  }
  Ok(syntax.PathType(own path, own arguments, id: allocate_id_from(mut cursor, start_index: start)))
}

fn recover_type_argument(cursor: mut TokenCursor, span: source.Span) -> syntax.TypeArgument {
  syntax.TypeArgument.TypeArgument(syntax.TypeExpression(kind: syntax.TypeKind.TypeError, id: allocate_id(mut cursor, span)))
}

fn parse_type_arguments(cursor: mut TokenCursor) -> Result[List[syntax.TypeArgument], Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  let arguments = parse_bracketed(mut cursor, parse_item: parse_type_argument, recover: recover_type_argument)
  if arguments.is_empty() {
    let span = cursor.lookup_token(start).span
    report(mut cursor, code: "parser.unexpected_token", span: span, message: "Type arguments cannot be empty.")
    return Err(Failure.Failed)
  }
  Ok(own arguments)
}

fn parse_type_argument(cursor: mut TokenCursor) -> Result[syntax.TypeArgument, Failure]
  uses Panic, RunForever
{
  let first = cursor.peek_kind()
  let second = cursor.peek_ahead(1)
  match first {
    Integer(literal) => {
      let value = cursor.integer(literal)
      let written = take(mut cursor)
      Ok(syntax.TypeArgument.Count(digits: own value, id: allocate_token_id(mut cursor, span: written.span)))
    }
    Lower(_) => if second != token.Kind.Punctuation(token.Punctuation.Dot) {
      Ok(syntax.TypeArgument.CountName(take_name(mut cursor)))
    } else {
      Ok(syntax.TypeArgument.TypeArgument(parse_type_expression(mut cursor)?))
    }
    Upper(_) => if second == token.Kind.Punctuation(token.Punctuation.Equal) {
      let name = take_name(mut cursor)
      advance(mut cursor)
      Ok(syntax.TypeArgument.Constraint(own name, value: parse_type_expression(mut cursor)?))
    } else {
      Ok(syntax.TypeArgument.TypeArgument(parse_type_expression(mut cursor)?))
    }
    _ => Ok(syntax.TypeArgument.TypeArgument(parse_type_expression(mut cursor)?))
  }
}

fn parse_function_input(cursor: mut TokenCursor) -> Result[syntax.FunctionInput, Failure]
  uses Panic, RunForever
{
  let name = if cursor.peek_kind() is Lower(_) && cursor.peek_ahead(1) == token.Kind.Punctuation(token.Punctuation.Colon) {
    let written = take_name(mut cursor)
    advance(mut cursor)
    Some(own written)
  } else {
    None
  }
  let mode = parse_mode(mut cursor)
  Ok(syntax.FunctionInput(own name, mode, annotation: parse_type_expression(mut cursor)?))
}

fn recover_function_input(cursor: mut TokenCursor, span: source.Span) -> syntax.FunctionInput {
  syntax.FunctionInput(
    name: None,
    mode: None,
    annotation: syntax.TypeExpression(kind: syntax.TypeKind.TypeError, id: allocate_id(mut cursor, span)),
  )
}

fn has_unless(clause: syntax.Clause) -> Bool {
  match clause.kind {
    Uses(capabilities) => {
      for capability_use in capabilities {
        if capability_use.unless_bounds.is_some() || !capability_use.unless_values.is_empty() {
          return true
        }
      }
      false
    }
    _ => false
  }
}

fn parse_function_type(cursor: mut TokenCursor, with_clauses: Bool) -> Result[syntax.FunctionType, Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  expect_keyword(mut cursor, keyword: token.Keyword.Fn)?
  if !cursor.is_punctuation(token.Punctuation.Open(token.Bracket.Paren)) {
    return Err(fail(mut cursor, expected: "`(` after `fn` in a function type"))
  }
  let inputs = parse_bracketed(mut cursor, parse_item: parse_function_input, recover: recover_function_input)
  let output = if accept_punctuation(mut cursor, punctuation: token.Punctuation.Arrow) {
    Some(parse_type_expression(mut cursor)?)
  } else {
    None
  }
  var clauses: List[syntax.Clause] = []
  if with_clauses {
    while true {
      let kind = cursor.peek_kind()
      if kind == token.Kind.Keyword(token.Keyword.Uses) || kind == token.Kind.Keyword(token.Keyword.Cost)
        || kind == token.Kind.Keyword(token.Keyword.Requires) || kind == token.Kind.Keyword(token.Keyword.Ensures)
      {
        mut clauses.push(parse_clause(mut cursor)?)
      } else if kind == token.Kind.Keyword(token.Keyword.Decreases) {
        return Err(fail(mut cursor, "`uses`, `cost`, `requires`, or `ensures`; a function type has no `decreases`"))
      } else {
        break
      }
    }
  }
  for clause in clauses {
    if clause.condition.is_some() || has_unless(clause) {
      let span = cursor.make_file_span(cursor.read_span(clause.id))
      report(
        mut cursor,
        code: "parser.misplaced_condition",
        span: span,
        message: "A function type's clauses take no condition: a call through a function value has no type arguments to decide one.",
      )
    }
  }
  for clause in clauses {
    if clause.kind is Cost(clause: cost_clause) {
      let non_literal_id = match cost_clause.bound {
        BigO(value) | AtMost(value) | Exactly(value) => if value.kind is Integer(_) { None } else { Some(value.id) }
      }
      if non_literal_id is Some(amount_id) {
        let amount_span = cursor.read_file_span(amount_id)
        report(
          mut cursor,
          "parser.function_type_cost_bound",
          amount_span,
          "An `O(...)`, `<=`, or `==` bound in a function type is an integer literal, as in `O(1)` or `<= 2`, since the type holds a number and not an expression. State a bound that depends on a value in the enclosing function's own `cost` clause, which names the callback's cost as `time(visit)`.",
        )
      }
    }
  }
  var has_callback_contract = false
  for clause in clauses {
    if clause.kind is Requires(_) || clause.kind is Ensures(_) {
      has_callback_contract = true
    }
  }
  var every_named = true
  var some_named = false
  for input in inputs {
    if input.name.is_some() {
      some_named = true
    } else {
      every_named = false
    }
  }
  let span = cursor.lookup_token(start).span
  if has_callback_contract {
    if !every_named {
      report(
        mut cursor,
        "parser.function_type_names",
        span,
        "A function type with `requires` or `ensures` names every input, as in `fn(index: UInt64)`, so that its clauses can mention them.",
      )
    }
  } else if some_named {
    report(
      mut cursor,
      "parser.function_type_names",
      span,
      "A function type names its inputs only when a `requires` or an `ensures` mentions them; remove the names, since calls through a function value pass arguments by position.",
    )
  }
  Ok(syntax.FunctionType(own inputs, own output, own clauses))
}

fn parse_parenthesized_function_type(cursor: mut TokenCursor) -> syntax.TypeExpression
  uses Panic, RunForever
{
  let start = cursor.index
  let closer = cursor.lookup_closer(start)
  advance(mut cursor)
  match parse_parenthesized_function_type_inner(mut cursor, start, closer) {
    Ok(function_type) => {
      skip_to(mut cursor, limit: closer + 1)
      make_type_node(mut cursor, start, kind: syntax.TypeKind.FunctionType(own function_type))
    }
    Err(_) => {
      skip_to(mut cursor, limit: closer + 1)
      make_type_node(mut cursor, start, kind: syntax.TypeKind.TypeError)
    }
  }
}

fn parse_parenthesized_function_type_inner(cursor: mut TokenCursor, start: UInt64, closer: UInt64) -> Result[syntax.FunctionType, Failure]
  uses Panic, RunForever
{
  if !cursor.is_keyword(token.Keyword.Fn) && has_comma(cursor, opener: start) {
    let opening = cursor.lookup_token(start)
    return Err(report_tuple(mut cursor, opening))
  }
  if !cursor.is_keyword(token.Keyword.Fn) {
    return Err(fail(mut cursor, expected: "a function type; parentheses in a type only hold a function type with clauses"))
  }
  let function_type = parse_function_type(mut cursor, with_clauses: true)?
  if function_type.clauses.is_empty() {
    let span = cursor.lookup_token(start).span
    report(mut cursor, code: "parser.unexpected_token", span: span, message: "Parentheses around a function type are only for its clauses; remove them.")
    return Err(Failure.Failed)
  }
  if cursor.index < closer {
    return Err(fail(mut cursor, expected: "`)` after the clauses of the function type"))
  }
  Ok(own function_type)
}

fn parse_bounds(cursor: mut TokenCursor) -> Result[List[syntax.PathType], Failure]
  uses Panic, RunForever
{
  parse_separated(mut cursor, separator: token.Punctuation.Plus, parse_item: parse_path_type)
}

fn recover_generic_parameter(cursor: mut TokenCursor, span: source.Span) -> syntax.GenericParameter {
  syntax.GenericParameter(kind: syntax.GenericKind.GenericError, id: allocate_id(mut cursor, span))
}

fn parse_generics(cursor: mut TokenCursor) -> Result[List[syntax.GenericParameter], Failure]
  uses Panic, RunForever
{
  if cursor.is_punctuation(token.Punctuation.Less) {
    skip_angle_brackets(mut cursor)
    return Ok([])
  }
  if !cursor.is_punctuation(token.Punctuation.Open(token.Bracket.Square)) {
    return Ok([])
  }
  let start = cursor.index
  let parameters = parse_bracketed(mut cursor, parse_item: parse_generic_parameter, recover: recover_generic_parameter)
  if parameters.is_empty() {
    let span = cursor.lookup_token(start).span
    report(mut cursor, code: "parser.unexpected_token", span: span, message: "Generic parameters cannot be empty.")
    return Err(Failure.Failed)
  }
  Ok(own parameters)
}

fn parse_generic_parameter(cursor: mut TokenCursor) -> Result[syntax.GenericParameter, Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  let kind = match cursor.peek_kind() {
    Upper(_) => {
      let name = take_name(mut cursor)
      let bounds = if accept_punctuation(mut cursor, punctuation: token.Punctuation.Colon) { parse_bounds(mut cursor)? } else { [] }
      syntax.GenericKind.TypeParameter(own name, own bounds)
    }
    Lower(_) => {
      let name = take_name(mut cursor)
      expect_punctuation(mut cursor, punctuation: token.Punctuation.Colon)?
      syntax.GenericKind.ValueParameter(own name, annotation: parse_type_expression(mut cursor)?)
    }
    _ => return Err(fail(mut cursor, expected: "a generic parameter"))
  }
  Ok(syntax.GenericParameter(own kind, id: allocate_id_from(mut cursor, start_index: start)))
}

fn parse_path_type_list(cursor: mut TokenCursor) -> Result[List[syntax.PathType], Failure]
  uses Panic, RunForever
{
  parse_separated(mut cursor, separator: token.Punctuation.Comma, parse_item: parse_path_type)
}

fn parse_capability_reference(cursor: mut TokenCursor) -> Result[syntax.CapabilityReference, Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  let first = cursor.peek_kind()
  let kind = if first == token.Kind.Keyword(token.Keyword.SelfType) {
    advance(mut cursor)
    if !accept_punctuation(mut cursor, punctuation: token.Punctuation.Dot) {
      return Err(fail(mut cursor, expected: "`.` and an associated capability set, as in `Self.Uses`; `Self` is a type, not a capability"))
    }
    syntax.CapabilityReferenceKind.SelfCapabilities(parse_upper_name(mut cursor, expected: "an associated capability set after `Self.`")?)
  } else if first is Upper(_) && cursor.peek_ahead(1) == token.Kind.Punctuation(token.Punctuation.Dot) && cursor.peek_ahead(2) is Upper(_) {
    let parameter = take_name(mut cursor)
    advance(mut cursor)
    syntax.CapabilityReferenceKind.AssociatedCapabilities(
      own parameter,
      name: parse_upper_name(mut cursor, expected: "an associated capability set")?,
    )
  } else if cursor.is_lower_named(first, text: "generic") && cursor.peek_ahead(1) is Upper(_) {
    advance(mut cursor)
    syntax.CapabilityReferenceKind.GenericCapability(parse_upper_name(mut cursor, expected: "the name of a capability parameter")?)
  } else {
    syntax.CapabilityReferenceKind.CapabilityPath(parse_path_type(mut cursor)?)
  }
  Ok(syntax.CapabilityReference(own kind, id: allocate_id_from(mut cursor, start_index: start)))
}

fn parse_capability_list(cursor: mut TokenCursor) -> Result[List[syntax.CapabilityReference], Failure]
  uses Panic, RunForever
{
  parse_separated(mut cursor, separator: token.Punctuation.Comma, parse_item: parse_capability_reference)
}

fn parse_capability_use(cursor: mut TokenCursor) -> Result[syntax.CapabilityUse, Failure]
  uses Panic, RunForever
{
  let reference = parse_capability_reference(mut cursor)?
  if !accept_keyword(mut cursor, keyword: token.Keyword.Unless) {
    return Ok(syntax.CapabilityUse(own reference, unless_bounds: None, unless_values: []))
  }
  let atoms = parse_condition_atoms(mut cursor)?
  var bounds: List[syntax.BoundCondition] = []
  var values: List[syntax.Expression] = []
  for atom in own atoms {
    match own atom {
      BoundAtom(bound) => mut bounds.push(own bound)
      ValueAtom(value) => mut values.push(own value)
    }
  }
  let unless_bounds = if bounds.is_empty() { None } else { Some(own bounds) }
  Ok(syntax.CapabilityUse(own reference, own unless_bounds, unless_values: own values))
}

fn parse_capability_uses(cursor: mut TokenCursor) -> Result[List[syntax.CapabilityUse], Failure]
  uses Panic, RunForever
{
  parse_separated(mut cursor, separator: token.Punctuation.Comma, parse_item: parse_capability_use)
}

fn parse_condition_after(cursor: mut TokenCursor, keyword: token.Keyword) -> Result[Option[List[syntax.BoundCondition]], Failure]
  uses Panic, RunForever
{
  if !accept_keyword(mut cursor, keyword) {
    return Ok(None)
  }
  let atoms = parse_condition_atoms(mut cursor)?
  var bounds: List[syntax.BoundCondition] = []
  for atom in own atoms {
    match own atom {
      BoundAtom(bound) => mut bounds.push(own bound)
      ValueAtom(value) => {
        let span = cursor.make_file_span(cursor.read_span(value.id))
        report(
          mut cursor,
          code: "parser.misplaced_condition",
          span: span,
          message: "A `when` condition names bounds, such as `T: Trait`. A clause that holds where a value condition does is written with `==>`, as in `ensures P ==> Q`.",
        )
      }
    }
  }
  Ok(Some(own bounds))
}

fn is_bound_atom(cursor: TokenCursor) -> Bool
  uses Panic, RunForever
{
  let first = cursor.peek_kind()
  let is_subject = match first {
    Upper(_) => true
    Keyword(keyword) => keyword == token.Keyword.SelfType
    _ => false
  }
  if !is_subject {
    return false
  }
  var offset: UInt64 = 1
  var depth: UInt64 = 0
  while true {
    let kind = cursor.peek_ahead(offset)
    if kind == token.Kind.Punctuation(token.Punctuation.Open(token.Bracket.Square)) {
      offset += 1
      depth += 1
    } else if depth == 0 {
      break
    } else if kind == token.Kind.Punctuation(token.Punctuation.Close(token.Bracket.Square)) {
      offset += 1
      if depth == 1 {
        break
      }
      depth -= 1
    } else if kind == token.Kind.EndOfFile {
      break
    } else {
      offset += 1
    }
  }
  while cursor.peek_ahead(offset) == token.Kind.Punctuation(token.Punctuation.Dot) && cursor.peek_ahead(offset + 1) is Upper(_) {
    offset += 2
  }
  cursor.peek_ahead(offset) == token.Kind.Punctuation(token.Punctuation.Colon)
}

type ConditionAtom = BoundAtom(bound: syntax.BoundCondition) | ValueAtom(value: syntax.Expression)
  derives Equal

fn parse_condition_atom(cursor: mut TokenCursor) -> Result[ConditionAtom, Failure]
  uses Panic, RunForever
{
  if is_bound_atom(cursor) {
    let start = cursor.index
    let subject = parse_type_expression(mut cursor)?
    expect_punctuation(mut cursor, punctuation: token.Punctuation.Colon)?
    let bounds = parse_bounds(mut cursor)?
    return Ok(
      ConditionAtom.BoundAtom(
        syntax.BoundCondition(own subject, own bounds, id: allocate_id_from(mut cursor, start_index: start)),
      ),
    )
  }
  let level = rank_binary(syntax.Binary.Connective(syntax.Connective.And)) + 1
  Ok(ConditionAtom.ValueAtom(parse_binary(mut cursor, level, open_range: false)?))
}

fn parse_condition_atoms(cursor: mut TokenCursor) -> Result[List[ConditionAtom], Failure]
  uses Panic, RunForever
{
  parse_separated(mut cursor, separator: token.Punctuation.AndAnd, parse_item: parse_condition_atom)
}

fn parse_plain_expression(cursor: mut TokenCursor) -> Result[syntax.Expression, Failure]
  uses Panic, RunForever
{
  parse_expression(mut cursor)
}

fn parse_expression_list(cursor: mut TokenCursor) -> Result[List[syntax.Expression], Failure]
  uses Panic, RunForever
{
  parse_separated(mut cursor, separator: token.Punctuation.Comma, parse_item: parse_plain_expression)
}

fn parse_clause(cursor: mut TokenCursor) -> Result[syntax.Clause, Failure]
  uses Panic, RunForever
{
  let start = cursor.index
  let keyword = take(mut cursor)
  let kind = match keyword.kind {
    Keyword(written) => match written {
      Uses => syntax.ClauseKind.Uses(parse_capability_uses(mut cursor)?)
      Requires => syntax.ClauseKind.Requires(parse_expression(mut cursor)?)
      Ensures => syntax.ClauseKind.Ensures(parse_expression(mut cursor)?)
      Decreases => syntax.ClauseKind.Decreases(parse_expression_list(mut cursor)?)
      Cost => syntax.ClauseKind.Cost(parse_cost(mut cursor)?)
      _ => return Err(fail(mut cursor, expected: "a clause"))
    }
    _ => return Err(fail(mut cursor, expected: "a clause"))
  }
  let condition = if kind is Uses(_) {
    if cursor.is_keyword(token.Keyword.When) {
      return Err(
        fail(
          mut cursor,
          expected: "`,` or the end of the `uses` clause; a capability's condition follows `unless`, as in `uses RunForever unless Source: FiniteCursor`",
        ),
      )
    }
    None
  } else {
    parse_condition_after(mut cursor, keyword: token.Keyword.When)?
  }
  Ok(syntax.Clause(own kind, own condition, id: allocate_id_from(mut cursor, start_index: start)))
}

fn parse_cost(cursor: mut TokenCursor) -> Result[syntax.CostClause, Failure]
  uses Panic, RunForever
{
  let is_amortized = cursor.contextual(cursor.peek_kind()) == Some(ContextualKeyword.Amortized) && cursor.peek_ahead(1) is Lower(_)
  if is_amortized {
    advance(mut cursor)
  }
  if cursor.contextual(cursor.peek_kind()) == Some(ContextualKeyword.Potential) {
    let span = cursor.peek().span
    report(
      mut cursor,
      code: "parser.misplaced_potential",
      span: span,
      message: "`cost potential` belongs to a type, and states the potential its values hold.",
    )
    return Err(Failure.Failed)
  }
  let resource_word = expect_contextual(
    mut cursor,
    accepted: resources(),
    category: "a resource",
    expected: "a resource: `time`, `allocations`, `allocated_bytes`, or `calls(...)`",
  )?
  let resource = match resource_word {
    Metric(metric) => syntax.Resource.Metric(metric)
    _ => syntax.Resource.Calls(parse_call_target(mut cursor)?)
  }
  let next = cursor.peek_kind()
  let bound = if next == token.Kind.Punctuation(token.Punctuation.LessEqual) {
    advance(mut cursor)
    syntax.Bound.AtMost(parse_expression(mut cursor)?)
  } else if next == token.Kind.Punctuation(token.Punctuation.EqualEqual) {
    advance(mut cursor)
    syntax.Bound.Exactly(parse_expression(mut cursor)?)
  } else {
    let _ = expect_contextual(
      mut cursor,
      accepted: [ContextualKeyword.BigO],
      category: "a bound",
      expected: "a bound: `O(...)`, `<=`, or `==`",
      suggested: Some([ContextualKeyword.BigO]),
    )?
    syntax.Bound.BigO(parse_parenthesized_expression(mut cursor)?)
  }
  Ok(syntax.CostClause(is_amortized, own resource, own bound))
}

fn parse_call_target(cursor: mut TokenCursor) -> Result[syntax.CallTarget, Failure]
  uses Panic, RunForever
{
  let opener = cursor.index
  if !cursor.is_punctuation(token.Punctuation.Open(token.Bracket.Paren)) {
    return Err(fail(mut cursor, expected: "`(` after `calls`"))
  }
  let closer = cursor.lookup_closer(opener)
  advance(mut cursor)
  let target = if cursor.peek_kind() is Lower(_) && cursor.peek_ahead(1) != token.Kind.Punctuation(token.Punctuation.Dot) {
    syntax.CallTarget.CallParameter(take_name(mut cursor))
  } else {
    let capability_path = parse_path_type(mut cursor)?
    if accept_punctuation(mut cursor, punctuation: token.Punctuation.Dot) {
      syntax.CallTarget.CallMethod(path_type: own capability_path, name: lower_name(mut cursor, expected: "a method name")?)
    } else {
      syntax.CallTarget.CallCapability(own capability_path)
    }
  }
  if cursor.index < closer {
    return Err(fail(mut cursor, expected: "`)` after the target of `calls`"))
  }
  skip_to(mut cursor, limit: closer + 1)
  Ok(own target)
}

fn parse_parenthesized_expression(cursor: mut TokenCursor) -> Result[syntax.Expression, Failure]
  uses Panic, RunForever
{
  let opener = cursor.index
  if !cursor.is_punctuation(token.Punctuation.Open(token.Bracket.Paren)) {
    return Err(fail(mut cursor, expected: "`(`"))
  }
  let closer = cursor.lookup_closer(opener)
  advance(mut cursor)
  let value = parse_expression(mut cursor)?
  if cursor.index < closer {
    return Err(fail(mut cursor, expected: "`)`"))
  }
  skip_to(mut cursor, limit: closer + 1)
  Ok(own value)
}
