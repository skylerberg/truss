use frontend.source
use frontend.token
use standard.collections

type Ending = Closed | Unterminated
  derives Equal

type Scanned(
  kind: token.Kind,
  start: UInt64,
  stop: UInt64,
  ending: Ending,
  first_line_break: Option[source.Span],
  blank_line: Bool,
)
  derives Equal

type Item = Lexed(token: Scanned) | LineEnd | End
  derives Equal

type NameProblem(code: String, message: String)

type NameCheck(is_upper: Bool, problem: Option[NameProblem], fix: Option[String])

type Decoded(is_valid: Bool, code: UInt32, length: UInt64)
  derives Equal

type Scanner(
  source: source.Source,
  length: UInt64,
  diagnostics: List[source.Diagnostic],
  position: UInt64,
  first_line_break: Option[source.Span],
  blank_line: Bool,
  line_is_blank: Bool,
  unterminated_at_end: Bool,
  name_indices: collections.SortedMap[String, UInt64],
  name_checks: List[NameCheck],
  previous: Option[Scanned],
  held: List[Item],
  semicolons: List[UInt64],
  tables: token.Tables,
)
  invariant length == source.text.length()

fn Scanner.create(source: own source.Source) -> Scanner
  uses Panic
{
  let length = source.text.length()
  let position = source.compute_line_start(0)
  Scanner(
    own source,
    length,
    diagnostics: [],
    position,
    first_line_break: None,
    blank_line: false,
    line_is_blank: true,
    unterminated_at_end: false,
    name_indices: [:],
    name_checks: [],
    previous: None,
    held: [],
    semicolons: [],
    tables: token.Tables.empty(),
  )
}

fn Scanner.is_at_end(self, index: UInt64) -> Bool
  ensures result == (index >= self.length)
{
  index >= self.length
}

fn Scanner.continues(self, earlier: Scanner) -> Bool
  ensures result == (self.source.text == earlier.source.text && self.length == earlier.length
    && earlier.position <= self.position && self.held.length() == earlier.held.length())
{
  self.source.text == earlier.source.text && self.length == earlier.length && earlier.position <= self.position
    && self.held.length() == earlier.held.length()
}

fn Scanner.count_remaining(self, position: UInt64) -> UInt64
  ensures position < self.length ==> result == self.length - position
  ensures self.length <= position ==> result == 0
{
  if position < self.length { self.length - position } else { 0 }
}

fn Scanner.lookup(self, index: UInt64) -> UInt8
  uses Panic
  ensures index < self.length ==> result == self.source.text.byte(index)
{
  self.source.text.byte(index)
}

fn Scanner.is_at(self, index: UInt64, byte: UInt8) -> Bool
  ensures result == (index < self.length && self.source.text.byte(index) == byte)
{
  index < self.length && self.source.text.byte(index) == byte
}

fn report(
  scanner: mut Scanner,
  code: StringSlice,
  span: source.Span,
  message: StringSlice,
  notes: own List[source.Note] = [],
  fixes: own List[source.Fix] = [],
)
  ensures scanner.continues(old(scanner))
  ensures scanner.position == old(scanner.position)
{
  mut scanner.diagnostics.push(source.make_diagnostic(code, span, message, own notes, own fixes))
}

fn Scanner.text(self, start: UInt64, stop: UInt64) -> StringSlice
  uses Panic
{
  self.source.text.substring(start, to: stop)
}

fn is_line_break(byte: UInt8) -> Bool
  ensures result == (byte == 10 || byte == 13)
{
  byte == 10 || byte == 13
}

fn is_space(byte: UInt8) -> Bool
  ensures result == (byte == 32 || byte == 9)
{
  byte == 32 || byte == 9
}

fn is_digit(byte: UInt8) -> Bool
  ensures result == (byte >= 48 && byte <= 57)
{
  byte >= 48 && byte <= 57
}

fn is_hexadecimal_digit(byte: UInt8) -> Bool
  ensures result == (is_digit(byte) || (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70))
{
  is_digit(byte) || (byte >= 97 && byte <= 102) || (byte >= 65 && byte <= 70)
}

fn is_ascii_letter(byte: UInt8) -> Bool
  ensures result == ((byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90))
{
  (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90)
}

fn is_ascii_name_byte(byte: UInt8) -> Bool
  ensures result == (is_ascii_letter(byte) || is_digit(byte) || byte == 95)
{
  is_ascii_letter(byte) || is_digit(byte) || byte == 95
}

fn is_ascii(byte: UInt8) -> Bool
  ensures result == (byte < 128)
{
  byte < 128
}

fn Scanner.is_end_of_line(self, index: UInt64) -> Bool
  uses Panic
  ensures !result ==> index < self.length
{
  self.is_at_end(index) || is_line_break(self.lookup(index))
}

fn Scanner.is_digit_at(self, index: UInt64) -> Bool
  uses Panic
{
  index < self.length && is_digit(self.lookup(index))
}

fn Scanner.is_hexadecimal_digit_at(self, index: UInt64) -> Bool
  uses Panic
  ensures result ==> index < self.length
{
  index < self.length && is_hexadecimal_digit(self.lookup(index))
}

fn Scanner.is_space_at(self, index: UInt64) -> Bool
  uses Panic
  ensures result ==> index < self.length
{
  index < self.length && is_space(self.lookup(index))
}

fn Scanner.is_ascii_name_byte_at(self, index: UInt64) -> Bool
  uses Panic
  ensures result ==> index < self.length
{
  index < self.length && is_ascii_name_byte(self.lookup(index))
}

fn Scanner.byte_before(self, index: UInt64) -> Option[UInt8]
  uses Panic
{
  if index > 0 && index <= self.length { Some(self.lookup(index - 1)) } else { None }
}

fn Scanner.byte_after(self, index: UInt64) -> Option[UInt8]
  uses Panic
{
  if index < self.length { Some(self.lookup(index)) } else { None }
}

fn Scanner.joins_neighbor(self, span: source.Span, code: StringSlice) -> Bool
  uses Panic
{
  token.joins_neighbor(self.byte_before(span.start), after: self.byte_after(span.stop), code: code)
}

fn Scanner.list_code_fixes(self, span: source.Span, codes: Slice[String]) -> List[source.Fix]
  uses Panic
{
  var fixes: List[source.Fix] = []
  for code in codes {
    if !self.joins_neighbor(span, code) {
      mut fixes.push(source.make_fix("Write `${code}`", edits: [source.replace(span, replacement: code)]))
    }
  }
  fixes
}

fn is_continuation(byte: UInt8) -> Bool {
  byte >= 128 && byte <= 191
}

fn decode_text(text: StringSlice, index: UInt64) -> Decoded
  uses Panic
  ensures 1 <= result.length && result.length <= 4
{
  let length = text.length()
  let first = text.byte(index)
  let invalid = Decoded(is_valid: false, code: 65533, length: 1)
  if first < 128 {
    return Decoded(is_valid: true, code: UInt32.from_integer(first), length: 1)
  }
  let second_ok = index + 1 < length
  if first >= 194 && first <= 223 {
    if second_ok && is_continuation(text.byte(index + 1)) {
      let code = (UInt32.from_integer(first) & 31) * 64 + (UInt32.from_integer(text.byte(index + 1)) & 63)
      return Decoded(is_valid: true, code, length: 2)
    }
    return invalid
  }
  if first >= 224 && first <= 239 {
    if !second_ok {
      return invalid
    }
    let second = text.byte(index + 1)
    let second_valid = if first == 224 {
      second >= 160 && second <= 191
    } else if first == 237 {
      second >= 128 && second <= 159
    } else {
      is_continuation(second)
    }
    if !second_valid {
      return invalid
    }
    if index + 2 < length && is_continuation(text.byte(index + 2)) {
      let code = (UInt32.from_integer(first) & 15) * 4096 + (UInt32.from_integer(second) & 63) * 64
        + (UInt32.from_integer(text.byte(index + 2)) & 63)
      return Decoded(is_valid: true, code, length: 3)
    }
    return Decoded(is_valid: false, code: 65533, length: 2)
  }
  if first >= 240 && first <= 244 {
    if !second_ok {
      return invalid
    }
    let second = text.byte(index + 1)
    let second_valid = if first == 240 {
      second >= 144 && second <= 191
    } else if first == 244 {
      second >= 128 && second <= 143
    } else {
      is_continuation(second)
    }
    if !second_valid {
      return invalid
    }
    if !(index + 2 < length && is_continuation(text.byte(index + 2))) {
      return Decoded(is_valid: false, code: 65533, length: 2)
    }
    if !(index + 3 < length && is_continuation(text.byte(index + 3))) {
      return Decoded(is_valid: false, code: 65533, length: 3)
    }
    let code = (UInt32.from_integer(first) & 7) * 262144 + (UInt32.from_integer(second) & 63) * 4096
      + (UInt32.from_integer(text.byte(index + 2)) & 63) * 64 + (UInt32.from_integer(text.byte(index + 3)) & 63)
    return Decoded(is_valid: true, code, length: 4)
  }
  invalid
}

fn Scanner.decode(self, index: UInt64) -> Decoded
  uses Panic
  ensures 1 <= result.length && result.length <= 4
{
  decode_text(self.source.text, index)
}

fn Scanner.run_length(self, index: UInt64, byte: UInt8) -> UInt64
  uses Panic
  ensures self.is_at(index, byte) ==> 1 <= result
  ensures !self.is_at(index, byte) ==> result == 0
{
  var position = index
  while self.is_at(position, byte)
    invariant index <= position
    invariant self.is_at(index, byte) || position == index
    decreases self.count_remaining(position)
  {
    position += 1
  }
  position - index
}

fn Scanner.skip_spaces(self, index: UInt64) -> UInt64
  uses Panic
  ensures index <= result
{
  var position = index
  while self.is_space_at(position)
    invariant index <= position
    decreases self.count_remaining(position)
  {
    position += 1
  }
  position
}

fn Scanner.compute_end_of_line(self, index: UInt64) -> UInt64
  uses Panic
  ensures index <= result
{
  var position = index
  while !self.is_end_of_line(position)
    invariant index <= position
    decreases self.count_remaining(position)
  {
    position += 1
  }
  position
}

fn Scanner.measure_line_break(self, index: UInt64) -> UInt64
  uses Panic
  ensures 1 <= result && result <= 2
{
  if self.is_at(index, byte: 13) && self.is_at(index + 1, byte: 10) { 2 } else { 1 }
}

fn Scanner.extract_indentation(self, offset: UInt64) -> String
  uses Panic
{
  let start = self.source.compute_line_start(offset)
  self.text(start, stop: self.skip_spaces(start)).to_string()
}

fn Scanner.count_spaces_before(self, offset: UInt64) -> UInt64
  uses Panic
{
  let line_start = self.source.compute_line_start(offset)
  var position = offset
  while position > line_start && is_space(self.lookup(position - 1)) {
    position -= 1
  }
  position
}

fn Scanner.has_only_spaces_before(self, offset: UInt64) -> Bool
  uses Panic
{
  self.count_spaces_before(offset) == self.source.compute_line_start(offset)
}

fn hexadecimal_digit(value: UInt32) -> StringSlice
  uses Panic
{
  "0123456789ABCDEF".substring(UInt64.from_integer(value), to: UInt64.from_integer(value) + 1)
}

fn format_hexadecimal(value: UInt32, minimum_digits: UInt64, is_lowercase: Bool = false) -> String
  uses Panic
{
  var digits: List[UInt32] = []
  var remaining = value
  while remaining > 0 {
    mut digits.push(remaining % 16)
    remaining = remaining / 16
  }
  while digits.length() < minimum_digits {
    mut digits.push(0)
  }
  var text = ""
  for digit in digits.reversed() {
    if is_lowercase {
      mut text.push(hexadecimal_digit(digit).to_ascii_lowercase())
    } else {
      mut text.push(hexadecimal_digit(digit))
    }
  }
  text
}

fn describe_code_point(code: UInt32) -> String
  uses Panic
{
  match find_forbidden_name(code) {
    Some(name) => "U+${format_hexadecimal(code, minimum_digits: 4)} ${name}"
    None => "U+${format_hexadecimal(code, minimum_digits: 4)}"
  }
}

fn Scanner.show_character(self, index: UInt64) -> String
  uses Panic
{
  let decoded = self.decode(index)
  if !decoded.is_valid {
    return "the byte 0x${format_hexadecimal(UInt32.from_integer(self.lookup(index)), minimum_digits: 2)}"
  }
  if decoded.code < 128 {
    return "`${self.text(index, stop: index + 1)}`"
  }
  "`${self.text(index, stop: index + decoded.length)}` (U+${format_hexadecimal(decoded.code, minimum_digits: 4)})"
}

fn in_ranges(ranges: Slice[UInt32], value: UInt32) -> Bool
  uses Panic
{
  var low: UInt64 = 0
  var high = ranges.length() / 2
  while low < high {
    let middle = low + (high - low) / 2
    let first = ranges.get(2 * middle).expect("a range start")
    if value < first {
      high = middle
    } else if value <= ranges.get(2 * middle + 1).expect("a range end") {
      return true
    } else {
      low = middle + 1
    }
  }
  false
}

fn is_xid_start(code: UInt32) -> Bool
  uses Panic
{
  if code < 128 {
    let byte = UInt8.from_integer(code)
    return is_ascii_letter(byte)
  }
  in_ranges(xid_start_ranges[..], value: code)
}

fn is_xid_continue(code: UInt32) -> Bool
  uses Panic
{
  if code < 128 {
    let byte = UInt8.from_integer(code)
    return is_ascii_name_byte(byte)
  }
  in_ranges(xid_continue_ranges[..], value: code)
}

fn is_forbidden(code: UInt32) -> Bool
  uses Panic
{
  in_ranges(forbidden_ranges[..], value: code)
}

fn is_bidi_control(code: UInt32) -> Bool
  uses Panic
{
  in_ranges(bidi_control_ranges[..], value: code)
}

fn is_control(code: UInt32) -> Bool
  uses Panic
{
  in_ranges(control_ranges[..], value: code)
}

type Context = Code | OrdinaryString | RawString
  derives Equal

fn Scanner.remove_trivia(self, start: UInt64, stop: UInt64, line_break: Bool) -> source.Edit
  uses Panic
{
  let before = self.count_spaces_before(start)
  let after = self.skip_spaces(stop)
  let code_before = !self.has_only_spaces_before(start)
  let code_after = !self.is_end_of_line(after)
  if code_before && code_after {
    let replacement = if line_break { "\n${self.extract_indentation(start)}" } else { " " }
    return source.replace(source.make_span(before, stop: after), replacement)
  }
  if code_before {
    return source.delete(source.make_span(before, stop: after))
  }
  if code_after {
    return source.delete(source.make_span(start, stop: after))
  }
  let line_start = self.source.compute_line_start(start)
  let line_stop = if self.is_at_end(after) { after } else { after + self.measure_line_break(after) }
  source.delete(source.make_span(line_start, stop: line_stop))
}

fn report_forbidden_run(scanner: mut Scanner, context: Context)
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  let first = scanner.decode(start)
  scanner.position = start + first.length
  var characters: List[UInt32] = [first.code]
  while !scanner.is_at_end(scanner.position)
    invariant scanner.continues(old(scanner))
    invariant start < scanner.position
    decreases scanner.count_remaining(scanner.position)
  {
    let decoded = scanner.decode(scanner.position)
    if decoded.is_valid && is_forbidden(decoded.code) {
      scanner.position += decoded.length
      mut characters.push(decoded.code)
    } else {
      break
    }
  }
  let stop = scanner.position
  var names: List[String] = []
  for character in characters {
    mut names.push(describe_code_point(character))
  }
  var has_bidi = false
  var has_control = false
  var has_invisible = false
  for character in characters {
    if is_bidi_control(character) {
      has_bidi = true
    } else if is_control(character) {
      has_control = true
    } else {
      has_invisible = true
    }
  }
  var reasons: List[StringSlice] = []
  if has_bidi {
    mut reasons.push("Bidirectional controls can make code display differently from how it compiles.")
  }
  if has_control {
    mut reasons.push("Control characters can make a terminal hide or rewrite text.")
  }
  if has_invisible {
    mut reasons.push("Invisible characters can hide text from a reader.")
  }
  let is_plural = characters.length() > 1
  let verb = if is_plural { "are" } else { "is" }
  let base = "${names.join(", ")} ${verb} not allowed in source files. ${reasons.join(" ")}"
  match context {
    Code => {
      let title = if is_plural { "Delete the characters" } else { "Delete the character" }
      let fix = source.make_fix(title, edits: [scanner.remove_trivia(start, stop, line_break: false)])
      report(mut scanner, code: "lexer.forbidden_character", span: source.make_span(start, stop), message: base, fixes: [own fix])
    }
    OrdinaryString => {
      var escapes = ""
      for character in characters {
        mut escapes.push("\\u{${format_hexadecimal(character, minimum_digits: 1)}}")
      }
      let fix = source.make_fix("Replace with `${escapes}`", edits: [source.replace(source.make_span(start, stop), replacement: escapes)])
      report(
        mut scanner,
        code: "lexer.forbidden_character",
        span: source.make_span(start, stop),
        message: "${base} Write it as an escape, so that it can be seen.",
        fixes: [own fix],
      )
    }
    RawString => {
      report(
        mut scanner,
        code: "lexer.forbidden_character",
        span: source.make_span(start, stop),
        message: "${base} A raw string has no escapes, so write the text as an ordinary string, with the character as an escape such as `\\u{200B}`.",
      )
    }
  }
}

fn report_invalid_run(scanner: mut Scanner)
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  scanner.position = start + 1
  while !scanner.is_at_end(scanner.position) && !scanner.decode(scanner.position).is_valid
    invariant scanner.continues(old(scanner))
    invariant start < scanner.position
    decreases scanner.count_remaining(scanner.position)
  {
    scanner.position += 1
  }
  report(
    mut scanner,
    code: "lexer.invalid_utf8",
    span: source.make_span(start, stop: scanner.position),
    message: "Source files must be UTF-8, and these bytes are not valid UTF-8.",
  )
}

type Special = OrdinarySpecial(closing: UInt8) | RawSpecial
  derives Equal

fn is_special(special: Special, byte: UInt8) -> Bool {
  match special {
    OrdinarySpecial(closing) => byte == 34 || byte == 92 || byte == 36 || byte == closing
    RawSpecial => byte == 34 || byte == 36
  }
}

fn copy_plain(scanner: mut Scanner, buffer: mut String, special: Special)
  uses Panic
  ensures scanner.continues(old(scanner))
{
  let start = scanner.position
  var stop = start
  while !scanner.is_at_end(stop)
    decreases scanner.count_remaining(stop)
  {
    let current = scanner.lookup(stop)
    if (current >= 32 && current < 127 && !is_special(special, byte: current)) || current == 9 {
      stop += 1
    } else {
      break
    }
  }
  if stop > start {
    mut buffer.push(scanner.text(start, stop))
    scanner.position = stop
  }
}

fn read_character(scanner: mut Scanner, buffer: mut String, context: Context)
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let decoded = scanner.decode(scanner.position)
  if !decoded.is_valid {
    report_invalid_run(mut scanner)
  } else if is_forbidden(decoded.code) {
    report_forbidden_run(mut scanner, context)
  } else {
    mut buffer.push(scanner.text(scanner.position, stop: scanner.position + decoded.length))
    scanner.position += decoded.length
  }
}

fn consume_line_break(scanner: mut Scanner) -> source.Span
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  let length = scanner.measure_line_break(start)
  if length == 1 && scanner.is_at(start, byte: 13) {
    let fix = source.make_fix(
      "Replace with a line feed",
      edits: [source.replace(source.make_span(start, stop: start + 1), replacement: "\n")],
    )
    report(
      mut scanner,
      code: "lexer.carriage_return",
      span: source.make_span(start, stop: start + 1),
      message: "A carriage return is a line break only before a line feed.",
      fixes: [own fix],
    )
  }
  scanner.position = start + length
  source.make_span(start, stop: scanner.position)
}

fn note_line_break(scanner: mut Scanner, line_break: source.Span)
  ensures scanner.continues(old(scanner))
{
  if scanner.first_line_break.is_some() && scanner.line_is_blank {
    scanner.blank_line = true
  }
  if scanner.first_line_break.is_none() {
    scanner.first_line_break = Some(line_break)
  }
  scanner.line_is_blank = true
}

fn reject(scanner: mut Scanner, length: UInt64, message: StringSlice, code: StringSlice = "lexer.unexpected_character")
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures scanner.position == old(scanner.position) + length
{
  let start = scanner.position
  scanner.position = start + length
  scanner.line_is_blank = false
  report(mut scanner, code, span: source.make_span(start, stop: start + length), message: message)
}
