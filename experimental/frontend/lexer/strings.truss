use frontend::source
use frontend::token

let maximum_nesting: UInt64 = 32

type Pending(text: token::Text, interpolation: token::Interpolation)

type Builder(buffer: String, text_start: UInt64, pairs: List[Pending])

fn make_builder(start: UInt64) -> Builder {
  Builder(buffer: "", text_start: start, pairs: [])
}

fn take_text(builder: mut Builder, stop: UInt64) -> token::Text
  uses Panic
{
  let value = own builder.buffer
  builder.buffer = ""
  token::Text(value: own value, span: source::make_span(builder.text_start, stop))
}

fn add_interpolation(builder: mut Builder, interpolation: token::Interpolation)
  uses Panic
{
  let text = take_text(mut builder, stop: interpolation.span.start)
  mut builder.pairs.push(Pending(text: own text, interpolation))
  builder.text_start = interpolation.span.stop
}

type Finished(first: token::Text, rest: List[token::Segment])

fn finish(builder: mut Builder, stop: UInt64) -> Finished
  uses Panic
{
  let last = take_text(mut builder, stop)
  let pairs = own builder.pairs
  builder.pairs = []
  if pairs.is_empty() {
    return Finished(first: own last, rest: [])
  }
  var texts: List[token::Text] = []
  var interpolations: List[token::Interpolation] = []
  for pair in own pairs {
    mut texts.push(own pair.text)
    mut interpolations.push(pair.interpolation)
  }
  mut texts.push(own last)
  let first = mut texts.remove_at(0)
  var rest: List[token::Segment] = []
  for entry in own texts.cursor().enumerate() {
    let interpolation = interpolations.get(entry.index).expect("an interpolation before each later text")
    mut rest.push(token::Segment(interpolation, text: own entry.element))
  }
  Finished(first: own first, rest: own rest)
}

fn store_literal(scanner: mut Scanner, literal: own token::StringLiteral) -> token::Kind {
  let index = scanner.tables.literals.length()
  mut scanner.tables.literals.push(own literal)
  token::Kind.String(index)
}

fn make_literal(scanner: mut Scanner, tag: Option[token::Tag], form: token::Form, builder: mut Builder, stop: UInt64) -> token::Kind
  uses Panic
{
  let finished = finish(mut builder, stop)
  store_literal(mut scanner, literal: token::StringLiteral(tag: tag.copy(), form, first: own finished.first, rest: own finished.rest))
}

fn opens_raw_string(scanner: Scanner, index: UInt64) -> Bool
  uses Panic, RunForever
{
  let dollars = scanner.run_length(index, byte: 36)
  scanner.run_length(index + dollars, byte: 34) >= 3
}

fn ends_in_closer(scanner: Scanner, text_start: UInt64, stop: UInt64) -> Bool
  uses Panic
{
  var position = stop
  while position > text_start && is_space(scanner.lookup(position - 1)) {
    position -= 1
  }
  if position <= text_start {
    return false
  }
  let last = scanner.lookup(position - 1)
  last == 41 || last == 93 || last == 125
}

type InterpolationState(
  start: UInt64,
  nesting: UInt64,
  braces: UInt64,
  count: UInt64,
  is_finished: Bool,
  is_closed: Bool,
  ending: Ending,
)

fn finish_input(position: UInt64, ending: Ending) -> LayoutInput {
  LayoutInput.Finish(position, first_line_break: None, blank_line: false, ends_unterminated: ending == Ending.Unterminated)
}

fn read_interpolation_input(scanner: mut Scanner, state: mut InterpolationState) -> LayoutInput
  uses Panic, RunForever
{
  if state.is_finished {
    return finish_input(scanner.position, ending: state.ending)
  }
  match scan(mut scanner, inline: true, nesting: state.nesting + 1) {
    LineEnd | End => {
      report(
        mut scanner,
        code: "lexer.line_break_in_interpolation",
        span: source::make_span(state.start, stop: scanner.position),
        message: "An interpolation cannot contain a line break. Move the expression into a `let` before the string.",
      )
      state.is_finished = true
      state.ending = Ending.Unterminated
      finish_input(scanner.position, ending: state.ending)
    }
    Lexed(scanned) => {
      if scanned.kind == token::Kind.Punctuation(token::Punctuation.Close(token::Bracket.Curly)) && state.braces == 0 {
        state.is_finished = true
        state.is_closed = true
        return finish_input(scanned.start, ending: state.ending)
      }
      if scanned.kind == token::Kind.Punctuation(token::Punctuation.Open(token::Bracket.Curly)) {
        state.braces += 1
      } else if scanned.kind == token::Kind.Punctuation(token::Punctuation.Close(token::Bracket.Curly)) {
        state.braces -= 1
      }
      state.count += 1
      if scanned.ending == Ending.Unterminated {
        state.is_finished = true
        state.ending = Ending.Unterminated
      }
      LayoutInput.Next(
        kind: scanned.kind,
        span: source::make_span(scanned.start, stop: scanned.stop),
        first_line_break: None,
        blank_line: false,
        unterminated_string: scanned.ending == Ending.Unterminated,
      )
    }
  }
}

type InterpolationResult(interpolation: token::Interpolation, ending: Ending)

fn scan_interpolation(scanner: mut Scanner, nesting: UInt64, delimiter_length: UInt64) -> InterpolationResult
  uses Panic, RunForever
{
  let start = scanner.position
  if nesting + 1 > maximum_nesting {
    report(
      mut scanner,
      code: "lexer.interpolation_too_deep",
      span: source::make_span(start, stop: start + delimiter_length),
      message: "Interpolations can nest at most ${maximum_nesting} deep.",
    )
    scanner.position = scanner.compute_end_of_line(start)
    let first = scanner.tables.tokens.length()
    mut scanner.tables.tokens.push(token::make_token(token::Kind.EndOfFile, span: source::make_zero_width(scanner.position)))
    return InterpolationResult(
      interpolation: token::Interpolation(first, stop: first + 1, span: source::make_span(start, stop: scanner.position), is_closed: false),
      ending: Ending.Unterminated,
    )
  }
  scanner.position = start + delimiter_length
  scanner.previous = None
  var state = InterpolationState(
    start,
    nesting,
    braces: 0,
    count: 0,
    is_finished: false,
    is_closed: false,
    ending: Ending.Closed,
  )
  let range = lex_interpolation(mut scanner, state: mut state)
  let interpolation_span = source::make_span(start, stop: scanner.position)
  if state.is_closed && state.count == 0 {
    var is_blank = true
    var position = start + delimiter_length
    while position + 1 < scanner.position {
      if !is_space(scanner.lookup(position)) {
        is_blank = false
      }
      position += 1
    }
    let fixes = if is_blank {
      [source::make_fix("Remove the empty interpolation", edits: [source::delete(interpolation_span)])]
    } else {
      []
    }
    report(
      mut scanner,
      code: "lexer.empty_interpolation",
      span: interpolation_span,
      message: "An interpolation needs an expression.",
      fixes: own fixes,
    )
  }
  InterpolationResult(
    interpolation: token::Interpolation(first: range.first, stop: range.stop, span: interpolation_span, is_closed: state.is_closed),
    ending: state.ending,
  )
}

type ScannedString(kind: token::Kind, ending: Ending)

fn scan_string(scanner: mut Scanner, tag: Option[token::Tag], nesting: UInt64) -> ScannedString
  uses Panic, RunForever
{
  let start = scanner.position
  let dollars = scanner.run_length(start, byte: 36)
  let quotes = scanner.run_length(start + dollars, byte: 34)
  if dollars == 0 && quotes == 1 {
    return scan_ordinary(mut scanner, tag, nesting)
  }
  if dollars == 0 && quotes == 2 {
    scanner.position = start + 2
    let literal = token::StringLiteral(
      tag: tag.copy(),
      form: token::Form.Ordinary,
      first: token::Text(value: "", span: source::make_span(start + 1, stop: start + 1)),
      rest: [],
    )
    return ScannedString(kind: store_literal(mut scanner, literal: own literal), ending: Ending.Closed)
  }
  scan_raw(mut scanner, tag, nesting, dollars, quotes)
}

type EscapeResult = ContinueString | EndOfLine
  derives Equal

fn scan_ordinary(scanner: mut Scanner, tag: Option[token::Tag], nesting: UInt64, closing: UInt8 = 34) -> ScannedString
  uses Panic, RunForever
{
  let open_quote = scanner.position
  let literal_start = match tag {
    Some(written) => written.span.start
    None => open_quote
  }
  scanner.position = open_quote + 1
  var builder = make_builder(scanner.position)
  var ending = Ending.Closed
  var stop: UInt64 = 0
  while true {
    copy_plain(mut scanner, buffer: mut builder.buffer, special: Special.OrdinarySpecial(closing))
    let position = scanner.position
    if scanner.is_end_of_line(position) {
      let message = "This string is not closed on its line. An ordinary string fits on one line; text that spans lines goes in a raw string, between `\"\"\"`s."
      if nesting == 0 {
        let fixes = if ends_in_closer(scanner, text_start: literal_start + 1, stop: position) {
          []
        } else {
          [source::make_fix("Close the string", edits: [source::insert(source::make_zero_width(position), replacement: "\"")])]
        }
        report(
          mut scanner,
          code: "lexer.unterminated_string",
          span: source::make_span(literal_start, stop: position),
          message,
          fixes: own fixes,
        )
      } else {
        report(mut scanner, code: "lexer.unterminated_string", span: source::make_span(literal_start, stop: position), message)
      }
      ending = Ending.Unterminated
      stop = position
      break
    }
    if scanner.is_at(position, byte: closing) {
      scanner.position = position + 1
      stop = position
      break
    }
    if scanner.is_at(position, byte: 92) {
      if scan_escape(mut scanner, buffer: mut builder.buffer) == EscapeResult.EndOfLine {
        ending = Ending.Unterminated
        stop = scanner.position
        break
      }
      continue
    }
    if scanner.is_at(position, byte: 36) && scanner.is_at(position + 1, byte: 123) {
      let result = scan_interpolation(mut scanner, nesting, delimiter_length: 2)
      add_interpolation(mut builder, interpolation: result.interpolation)
      if result.ending == Ending.Unterminated {
        ending = Ending.Unterminated
        stop = scanner.position
        break
      }
      continue
    }
    if scanner.is_at(position, byte: 36) {
      mut builder.buffer.push("$")
      scanner.position = position + 1
      continue
    }
    read_character(mut scanner, buffer: mut builder.buffer, context: Context.OrdinaryString)
  }
  ScannedString(kind: make_literal(mut scanner, tag, form: token::Form.Ordinary, builder: mut builder, stop), ending)
}

fn scan_escape(scanner: mut Scanner, buffer: mut String) -> EscapeResult
  uses Panic, RunForever
{
  let start = scanner.position
  if scanner.is_end_of_line(start + 1) {
    report(
      mut scanner,
      code: "lexer.invalid_escape",
      span: source::make_span(start, stop: start + 1),
      message: "A `\\` at the end of a line does not continue the string. Text that spans lines goes in a raw string, between `\"\"\"`s.",
    )
    scanner.position = start + 1
    return EscapeResult.EndOfLine
  }
  let escaped = scanner.lookup(start + 1)
  let simple: Option[StringSlice] = if escaped == 110 {
    Some("\n")
  } else if escaped == 116 {
    Some("\t")
  } else if escaped == 114 {
    Some("\r")
  } else if escaped == 48 {
    Some("\0")
  } else if escaped == 92 {
    Some("\\")
  } else if escaped == 34 {
    Some("\"")
  } else {
    None
  }
  if simple is Some(value) {
    mut buffer.push(value)
    scanner.position = start + 2
    return EscapeResult.ContinueString
  }
  if escaped == 36 && scanner.is_at(start + 2, byte: 123) {
    mut buffer.push("\${")
    scanner.position = start + 3
    return EscapeResult.ContinueString
  }
  if escaped == 117 {
    let form = "A Unicode escape is written `\\u{...}`, with 1 to 6 hexadecimal digits."
    if !scanner.is_at(start + 2, byte: 123) {
      if scan_foreign_escape(mut scanner, buffer: mut buffer) {
        return EscapeResult.ContinueString
      }
      report_escape_problem(mut scanner, start, stop: start + 2, message: form)
      return EscapeResult.ContinueString
    }
    let digits_start = start + 3
    var stop = digits_start
    while scanner.is_hexadecimal_digit_at(stop) {
      stop += 1
    }
    let count = stop - digits_start
    if !scanner.is_at(stop, byte: 125) {
      report_escape_problem(mut scanner, start, stop, message: form)
      return EscapeResult.ContinueString
    }
    if count == 0 || count > 6 {
      report_escape_problem(mut scanner, start, stop: stop + 1, message: form)
      return EscapeResult.ContinueString
    }
    let digits = scanner.text(digits_start, stop)
    var value: UInt32 = 0
    for byte in digits.bytes() {
      value = value * 16 + UInt32.from_integer(hexadecimal_value(byte))
    }
    match Character.try_from_code(value) {
      Ok(character) => {
        mut buffer.push_character(character)
        scanner.position = stop + 1
      }
      Err(_) => {
        let digits_text = digits.to_string()
        report_escape_problem(
          mut scanner,
          start,
          stop: stop + 1,
          message: "`\\u{${digits_text}}` is not a Unicode scalar value: surrogates and values above 10FFFF have no character.",
        )
      }
    }
    return EscapeResult.ContinueString
  }
  if scan_foreign_escape(mut scanner, buffer: mut buffer) {
    return EscapeResult.ContinueString
  }
  let decoded = scanner.decode(start + 1)
  let length = if decoded.is_valid { decoded.length } else { 1 }
  let written = if !decoded.is_valid {
    "`\\` followed by ${scanner.show_character(start + 1)}"
  } else {
    "`${scanner.text(start, stop: start + 1 + length)}`"
  }
  report_escape_problem(
    mut scanner,
    start,
    stop: start + 1 + length,
    message: "${written} is not an escape. The escapes are `\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\\${`, and `\\u{...}`. For text with backslashes, such as a regular expression or a Windows path, a raw string has no escapes: `\"\"\"\\d+\"\"\"`.",
  )
  EscapeResult.ContinueString
}

fn hexadecimal_value(byte: UInt8) -> UInt8
  uses Panic
{
  if is_digit(byte) {
    byte - 48
  } else if byte >= 97 {
    byte - 87
  } else {
    byte - 55
  }
}

fn report_escape_problem(scanner: mut Scanner, start: UInt64, stop: UInt64, message: StringSlice)
  uses Panic
{
  report(mut scanner, code: "lexer.invalid_escape", span: source::make_span(start, stop), message)
  scanner.position = stop
}

fn scan_raw(scanner: mut Scanner, tag: Option[token::Tag], nesting: UInt64, dollars: UInt64, quotes: UInt64) -> ScannedString
  uses Panic, RunForever
{
  let delimiter_start = scanner.position
  let literal_start = match tag {
    Some(written) => written.span.start
    None => delimiter_start
  }
  let delimiter_stop = delimiter_start + dollars + quotes
  let line_end = scanner.compute_end_of_line(delimiter_stop)
  let is_multi_line = scanner.skip_spaces(delimiter_stop) == line_end
  let form = token::Form.Raw(quotes, dollars, multi_line: is_multi_line)
  if !is_multi_line {
    scanner.position = delimiter_stop
    return scan_one_line_raw(mut scanner, tag, form, nesting, literal_start, dollars, quotes)
  }
  if nesting > 0 {
    report(
      mut scanner,
      code: "lexer.line_break_in_interpolation",
      span: source::make_span(literal_start, stop: line_end),
      message: "An interpolation cannot contain a line break, so it cannot hold a multi-line string. Move the expression into a `let` before the string.",
    )
    scanner.position = line_end
    var builder = make_builder(delimiter_stop)
    return ScannedString(
      kind: make_literal(mut scanner, tag, form, builder: mut builder, stop: delimiter_stop),
      ending: Ending.Unterminated,
    )
  }
  ScannedString(
    kind: scan_multi_line_raw(mut scanner, tag, form, literal_start, dollars, quotes, delimiter_stop, line_end),
    ending: Ending.Closed,
  )
}

fn lex_raw_dollars(scanner: mut Scanner, builder: mut Builder, dollars: UInt64, nesting: UInt64) -> Ending
  uses Panic, RunForever
{
  let start = scanner.position
  let run = scanner.run_length(start, byte: 36)
  let needed = if dollars > 1 { dollars } else { 1 }
  if run >= needed && scanner.is_at(start + run, byte: 123) {
    mut builder.buffer.push("$".repeated(run - needed))
    scanner.position = start + run - needed
    let result = scan_interpolation(mut scanner, nesting, delimiter_length: needed + 1)
    add_interpolation(mut builder, interpolation: result.interpolation)
    return result.ending
  }
  mut builder.buffer.push("$".repeated(run))
  scanner.position = start + run
  Ending.Closed
}

fn report_too_many_quotes(scanner: mut Scanner, start: UInt64, run: UInt64, quotes: UInt64, is_multi_line: Bool)
  uses Panic
{
  let advice = if is_multi_line {
    " Open the string with a longer delimiter."
  } else {
    " A one-line raw string cannot start or end with `\"`; use the multi-line form, or a longer delimiter."
  }
  report(
    mut scanner,
    code: "lexer.raw_string_quotes",
    span: source::make_span(start, stop: start + run),
    message: "A run of ${run} `\"`s is longer than this string's delimiter of ${quotes}.${advice}",
  )
}

fn scan_one_line_raw(
  scanner: mut Scanner,
  tag: Option[token::Tag],
  form: token::Form,
  nesting: UInt64,
  literal_start: UInt64,
  dollars: UInt64,
  quotes: UInt64,
) -> ScannedString
  uses Panic, RunForever
{
  var builder = make_builder(scanner.position)
  let delimiter = "\"".repeated(quotes)
  var ending = Ending.Closed
  var stop: UInt64 = 0
  while true {
    copy_plain(mut scanner, buffer: mut builder.buffer, special: Special.RawSpecial)
    let position = scanner.position
    if scanner.is_end_of_line(position) {
      let fixes = if nesting == 0 && scanner.lookup(position - 1) != 34
        && !ends_in_closer(scanner, text_start: builder.text_start, stop: position)
      {
        [
          source::make_fix(
            "Close the string with `${delimiter}`",
            edits: [source::insert(source::make_zero_width(position), replacement: delimiter)],
          ),
        ]
      } else {
        []
      }
      report(
        mut scanner,
        code: "lexer.unterminated_string",
        span: source::make_span(literal_start, stop: position),
        message: "This raw string is not closed on its line. A raw string with text after its opening `${delimiter}` is a one-line string. For several lines, start the text on the line after the opening `${delimiter}`.",
        fixes: own fixes,
      )
      ending = Ending.Unterminated
      stop = position
      break
    }
    if scanner.is_at(position, byte: 34) {
      let run = scanner.run_length(position, byte: 34)
      scanner.position = position + run
      if run >= quotes {
        if run > quotes {
          report_too_many_quotes(mut scanner, start: position, run, quotes, is_multi_line: false)
        }
        stop = position
        break
      }
      mut builder.buffer.push("\"".repeated(run))
      continue
    }
    if scanner.is_at(position, byte: 36) {
      if lex_raw_dollars(mut scanner, builder: mut builder, dollars, nesting) == Ending.Unterminated {
        ending = Ending.Unterminated
        stop = scanner.position
        break
      }
      continue
    }
    read_character(mut scanner, buffer: mut builder.buffer, context: Context.RawString)
  }
  ScannedString(kind: make_literal(mut scanner, tag, form, builder: mut builder, stop), ending)
}

type Closing =
  | OwnLine(indentation: String, delimiter_start: UInt64)
  | AfterText(start: UInt64)
  | UnterminatedAt(position: UInt64)

type RawLines(lines: List[Finished], closing: Option[Closing])

fn scan_multi_line_raw(
  scanner: mut Scanner,
  tag: Option[token::Tag],
  form: token::Form,
  literal_start: UInt64,
  dollars: UInt64,
  quotes: UInt64,
  delimiter_stop: UInt64,
  line_end: UInt64,
) -> token::Kind
  uses Panic, RunForever
{
  let read = read_raw_lines(mut scanner, dollars, quotes, line_end)
  if read.closing is Some(closing) {
    return build_multi_line(mut scanner, tag, form, quotes, delimiter_stop, lines: read.lines, closing: closing.copy())
  }
  scanner.unterminated_at_end = true
  let delimiter = "\"".repeated(quotes)
  var notes: List[source::Note] = []
  if guess_raw_string_end(scanner, literal_start, line_end) is Some(line_start) {
    mut notes.push(
      source::Note(
        span: source::make_zero_width(line_start),
        message: "The string may have been meant to end with `${delimiter}` before this line.",
      ),
    )
  }
  if quotes == 6 && dollars == 0 {
    mut notes.push(
      source::Note(span: source::make_span(delimiter_stop - quotes, stop: delimiter_stop), message: "For an empty string, write `\"\"`."),
    )
  }
  report(
    mut scanner,
    code: "lexer.unterminated_string",
    span: source::make_span(literal_start, stop: delimiter_stop),
    message: "This raw string is never closed, so it runs to the end of the file. Close it with `${delimiter}` on a line of its own.",
    notes: own notes,
  )
  let position = scanner.position
  build_multi_line(mut scanner, tag, form, quotes, delimiter_stop, lines: read.lines, closing: Closing.UnterminatedAt(position))
}

fn read_raw_lines(scanner: mut Scanner, dollars: UInt64, quotes: UInt64, line_end: UInt64) -> RawLines
  uses Panic, RunForever
{
  scanner.position = line_end
  if scanner.position < scanner.length {
    let _ = consume_line_break(mut scanner)
  }
  var lines: List[Finished] = []
  while true {
    let line_start = scanner.position
    if line_start >= scanner.length {
      return RawLines(lines: own lines, closing: None)
    }
    let first = scanner.skip_spaces(line_start)
    if scanner.run_length(first, byte: 34) >= quotes {
      let run = scanner.run_length(first, byte: 34)
      if run > quotes {
        report_too_many_quotes(mut scanner, start: first, run, quotes, is_multi_line: true)
      }
      scanner.position = first + run
      let indentation = scanner.text(line_start, stop: first).to_string()
      return RawLines(lines: own lines, closing: Some(Closing.OwnLine(indentation: own indentation, delimiter_start: first)))
    }
    var builder = make_builder(line_start)
    var is_next_line = false
    while true {
      copy_plain(mut scanner, buffer: mut builder.buffer, special: Special.RawSpecial)
      let position = scanner.position
      if scanner.is_end_of_line(position) {
        mut lines.push(finish(mut builder, stop: position))
        if scanner.is_at_end(position) {
          return RawLines(lines: own lines, closing: None)
        }
        let _ = consume_line_break(mut scanner)
        is_next_line = true
        break
      }
      if scanner.is_at(position, byte: 34) {
        let run = scanner.run_length(position, byte: 34)
        scanner.position = position + run
        if run == quotes {
          mut lines.push(finish(mut builder, stop: position))
          return RawLines(lines: own lines, closing: Some(Closing.AfterText(start: position)))
        }
        if run > quotes {
          report_too_many_quotes(mut scanner, start: position, run, quotes, is_multi_line: true)
        }
        mut builder.buffer.push("\"".repeated(run))
        continue
      }
      if scanner.is_at(position, byte: 36) {
        let _ = lex_raw_dollars(mut scanner, builder: mut builder, dollars, nesting: 0)
        continue
      }
      read_character(mut scanner, buffer: mut builder.buffer, context: Context.RawString)
    }
    if !is_next_line {
      break
    }
  }
  RawLines(lines: own lines, closing: None)
}

fn take_blank_prefix(text: StringSlice) -> StringSlice
  uses Panic
{
  var stop: UInt64 = 0
  while stop < text.length() && is_space(text.byte(stop)) {
    stop += 1
  }
  text.substring(0, to: stop)
}

fn find_leading_whitespace(line: Finished) -> Option[StringSlice]
  uses Panic
{
  let whitespace = take_blank_prefix(line.first.value)
  if whitespace == line.first.value && line.rest.is_empty() { None } else { Some(whitespace) }
}

fn compute_common_prefix(first: StringSlice, second: StringSlice) -> String
  uses Panic
{
  let length = if first.length() < second.length() { first.length() } else { second.length() }
  var index: UInt64 = 0
  while index < length && first.byte(index) == second.byte(index) {
    index += 1
  }
  first.substring(0, to: index).to_string()
}

fn compute_common_indentation(lines: Slice[Finished]) -> String
  uses Panic
{
  var common: Option[String] = None
  for line in lines {
    if find_leading_whitespace(line) is Some(prefix) {
      common = match common {
        None => Some(prefix.to_string())
        Some(so_far) => Some(compute_common_prefix(prefix, second: so_far))
      }
    }
  }
  match common {
    Some(text) => text.copy()
    None => ""
  }
}

fn guess_raw_string_end(scanner: Scanner, literal_start: UInt64, line_end: UInt64) -> Option[UInt64]
  uses Panic, RunForever
{
  let opener_line = scanner.source.compute_line_start(literal_start)
  let opener_indentation = scanner.skip_spaces(opener_line) - opener_line
  var position = line_end
  while position < scanner.length {
    let line_start = position + scanner.measure_line_break(position)
    if line_start >= scanner.length {
      return None
    }
    let first = scanner.skip_spaces(line_start)
    let is_blank = scanner.is_end_of_line(first)
    if (!is_blank && first - line_start < opener_indentation) || starts_definition(scanner.source, offset: line_start) {
      return Some(line_start)
    }
    position = scanner.compute_end_of_line(line_start)
  }
  None
}

fn describe_whitespace(whitespace: StringSlice) -> String
  uses Panic
{
  if whitespace.is_empty() {
    return "no indentation"
  }
  var groups: List[String] = []
  var index: UInt64 = 0
  while index < whitespace.length() {
    let character = whitespace.byte(index)
    var next = index
    while next < whitespace.length() && whitespace.byte(next) == character {
      next += 1
    }
    let count = next - index
    let noun = if character == 9 {
      if count == 1 { "tab" } else { "tabs" }
    } else {
      if count == 1 { "space" } else { "spaces" }
    }
    mut groups.push("${count} ${noun}")
    index = next
  }
  groups.join(" then ")
}

fn build_multi_line(
  scanner: mut Scanner,
  tag: Option[token::Tag],
  form: token::Form,
  quotes: UInt64,
  delimiter_stop: UInt64,
  lines: Slice[Finished],
  closing: own Closing,
) -> token::Kind
  uses Panic, RunForever
{
  var indentation = ""
  var delimiter_start: UInt64 = 0
  match own closing {
    OwnLine(indentation: written, delimiter_start: start) => {
      indentation = own written
      delimiter_start = start
    }
    AfterText(start) => {
      indentation = compute_common_indentation(lines)
      report(
        mut scanner,
        code: "lexer.raw_string_closing_not_alone",
        span: source::make_span(start, stop: start + quotes),
        message: "The closing delimiter of a multi-line raw string goes on a line of its own.",
        fixes: [
          source::make_fix(
            "Move the closing delimiter to its own line",
            edits: [source::insert(source::make_zero_width(start), replacement: "\n${indentation}")],
          ),
        ],
      )
      delimiter_start = start
    }
    UnterminatedAt(position) => {
      indentation = compute_common_indentation(lines)
      delimiter_start = position
    }
  }
  var joined = make_builder(delimiter_stop)
  for entry in lines.enumerate() {
    let line = entry.element
    if entry.index > 0 {
      mut joined.buffer.push("\n")
    }
    let value = line.first.value.slice()
    if value.starts_with(indentation) {
      mut joined.buffer.push(value.substring(indentation.length(), to: value.length()))
    } else if find_leading_whitespace(line).is_some() {
      var at: UInt64 = 0
      while at < value.length() && at < indentation.length() && value.byte(at) == indentation.byte(at) {
        at += 1
      }
      let line_whitespace = match find_leading_whitespace(line) {
        Some(whitespace) => whitespace.to_string()
        None => ""
      }
      let whitespace_stop = scanner.skip_spaces(line.first.span.start)
      let source_whitespace = scanner.text(line.first.span.start, stop: whitespace_stop)
      var source_difference: UInt64 = 0
      while source_difference < source_whitespace.length() && source_difference < indentation.length()
        && source_whitespace.byte(source_difference) == indentation.byte(source_difference)
      {
        source_difference += 1
      }
      let source_at = line.first.span.start + source_difference
      report(
        mut scanner,
        code: "lexer.raw_string_indentation",
        span: source::make_span(source_at, stop: source_at + 1),
        message: "Every line of a multi-line raw string starts with the indentation of its closing delimiter, which is ${describe_whitespace(indentation)}. This line starts with ${describe_whitespace(line_whitespace)}.",
        fixes: [
          source::make_fix(
            "Indent the line like the closing delimiter",
            edits: [source::replace(source::make_span(line.first.span.start, stop: whitespace_stop), replacement: indentation)],
          ),
        ],
      )
      mut joined.buffer.push(value.substring(at, to: value.length()))
    }
    for segment in line.rest {
      add_interpolation(mut joined, interpolation: segment.interpolation)
      mut joined.buffer.push(segment.text.value)
    }
  }
  make_literal(mut scanner, tag, form, builder: mut joined, stop: delimiter_start)
}
