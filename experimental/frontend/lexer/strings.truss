use frontend.source
use frontend.token

let maximum_nesting: UInt64 = 32

type Parts(first: token.Text, rest: List[token.Segment], pending: token.Interpolation)

type Builder(buffer: String, text_start: UInt64, parts: Option[Parts])

fn make_builder(start: UInt64) -> Builder {
  Builder(buffer: "", text_start: start, parts: None)
}

fn add_interpolation(builder: mut Builder, interpolation: token.Interpolation)
  uses Panic
{
  let value = own builder.buffer
  builder.buffer = ""
  let text = token.Text(own value, span: source.make_span(builder.text_start, stop: interpolation.span.start))
  match mut builder.parts {
    Some(parts) => {
      mut parts.rest.push(token.Segment(interpolation: parts.pending, own text))
      parts.pending = interpolation
    }
    None => builder.parts = Some(Parts(first: own text, rest: [], pending: interpolation))
  }
  builder.text_start = interpolation.span.stop
}

type Finished(first: token.Text, rest: List[token.Segment])

fn finish(builder: own Builder, stop: UInt64) -> Finished
  uses Panic
{
  let last = token.Text(value: own builder.buffer, span: source.make_span(builder.text_start, stop))
  match own builder.parts {
    None => Finished(first: own last, rest: [])
    Some(parts) => {
      var rest = own parts.rest
      mut rest.push(token.Segment(interpolation: parts.pending, text: own last))
      Finished(first: own parts.first, own rest)
    }
  }
}

fn store_literal(scanner: mut Scanner, literal: own token.StringLiteral) -> token.Kind
  ensures scanner.continues(old(scanner))
{
  let index = scanner.tables.literals.length()
  mut scanner.tables.literals.push(own literal)
  token.Kind.String(index)
}

fn make_literal(scanner: mut Scanner, tag: own Option[token.Tag], form: token.Form, builder: own Builder, stop: UInt64) -> token.Kind
  uses Panic
  ensures scanner.continues(old(scanner))
{
  let finished = finish(own builder, stop)
  store_literal(mut scanner, literal: token.StringLiteral(own tag, form, first: own finished.first, rest: own finished.rest))
}

fn opens_raw_string(scanner: Scanner, index: UInt64) -> Bool
  uses Panic
{
  let dollars = scanner.run_length(index, byte: 36)
  scanner.run_length(index + dollars, byte: 34) >= 3
}

fn ends_in_closer(scanner: Scanner, text_start: UInt64, stop: UInt64) -> Bool
  uses Panic
{
  var position = stop
  while position > text_start && is_space(scanner.lookup(position - 1)) {
    position -= 1
  }
  if position <= text_start {
    return false
  }
  let last = scanner.lookup(position - 1)
  last == 41 || last == 93 || last == 125
}

type InterpolationState(
  start: UInt64,
  nesting: UInt64,
  delimiter_length: UInt64,
  braces: UInt64,
  count: UInt64,
  is_finished: Bool,
  is_closed: Bool,
  ending: Ending,
)

fn finish_input(position: UInt64, ending: Ending) -> LayoutInput
  ensures result is Finish(..)
{
  LayoutInput.Finish(position, first_line_break: None, blank_line: false, ends_unterminated: ending == Ending.Unterminated)
}

fn read_interpolation_item(scanner: mut Scanner, state: mut InterpolationState, item: Item) -> LayoutInput
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures !(item is Lexed(_)) ==> result is Finish(..)
{
  match item {
    LineEnd | End => {
      report(
        mut scanner,
        code: "lexer.line_break_in_interpolation",
        span: source.make_span(state.start, stop: scanner.position),
        message: "An interpolation cannot contain a line break. Move the expression into a `let` before the string.",
      )
      state.is_finished = true
      state.ending = Ending.Unterminated
      finish_input(scanner.position, ending: state.ending)
    }
    Lexed(scanned) => {
      if scanned.kind == token.Kind.Punctuation(token.Punctuation.Close(token.Bracket.Curly)) && state.braces == 0 {
        state.is_finished = true
        state.is_closed = true
        return finish_input(scanned.start, ending: state.ending)
      }
      if scanned.kind == token.Kind.Punctuation(token.Punctuation.Open(token.Bracket.Curly)) {
        state.braces += 1
      } else if scanned.kind == token.Kind.Punctuation(token.Punctuation.Close(token.Bracket.Curly)) {
        state.braces -= 1
      }
      state.count += 1
      if scanned.ending == Ending.Unterminated {
        state.is_finished = true
        state.ending = Ending.Unterminated
      }
      LayoutInput.Next(
        kind: scanned.kind,
        span: source.make_span(scanned.start, stop: scanned.stop),
        first_line_break: None,
        blank_line: false,
        unterminated_string: scanned.ending == Ending.Unterminated,
      )
    }
  }
}

type InterpolationResult(interpolation: token.Interpolation, ending: Ending)

type InterpolationRequest(nesting: UInt64, delimiter_length: UInt64)
  invariant 1 <= delimiter_length

fn begin_interpolation(scanner: mut Scanner, request: InterpolationRequest) -> CodeFrame
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  var state = InterpolationState(
    start,
    nesting: request.nesting,
    delimiter_length: request.delimiter_length,
    braces: 0,
    count: 0,
    is_finished: false,
    is_closed: false,
    ending: Ending.Closed,
  )
  if request.nesting + 1 > maximum_nesting {
    report(
      mut scanner,
      code: "lexer.interpolation_too_deep",
      span: source.make_span(start, stop: start + request.delimiter_length),
      message: "Interpolations can nest at most ${maximum_nesting} deep.",
    )
    scanner.position = scanner.compute_end_of_line(start + request.delimiter_length)
    state.is_finished = true
    state.ending = Ending.Unterminated
  } else {
    scanner.position = start + request.delimiter_length
    scanner.previous = None
  }
  make_code_frame(mode: LayoutMode.InterpolationMode(state))
}

fn finish_interpolation(scanner: mut Scanner, state: InterpolationState, range: TokenRange) -> InterpolationResult
  uses Panic
  ensures scanner.continues(old(scanner))
{
  let interpolation_span = source.make_span(state.start, stop: scanner.position)
  if state.is_closed && state.count == 0 {
    var is_blank = true
    var position = state.start + state.delimiter_length
    while position + 1 < scanner.position {
      if !is_space(scanner.lookup(position)) {
        is_blank = false
      }
      position += 1
    }
    let fixes = if is_blank {
      [source.make_fix("Remove the empty interpolation", edits: [source.delete(interpolation_span)])]
    } else {
      []
    }
    report(
      mut scanner,
      code: "lexer.empty_interpolation",
      span: interpolation_span,
      message: "An interpolation needs an expression.",
      fixes: own fixes,
    )
  }
  InterpolationResult(
    interpolation: token.Interpolation(first: range.first, stop: range.stop, span: interpolation_span, is_closed: state.is_closed),
    ending: state.ending,
  )
}

type ScannedString(kind: token.Kind, ending: Ending)

type MultiLineRawText(
  literal_start: UInt64,
  quotes: UInt64,
  dollars: UInt64,
  delimiter_stop: UInt64,
  line_end: UInt64,
  lines: List[Finished],
  is_at_line_start: Bool,
  closing: Option[Closing],
)

type StringScan =
  | OrdinaryScan(closing: UInt8, literal_start: UInt64)
  | OneLineRawScan(literal_start: UInt64, quotes: UInt64, dollars: UInt64)
  | indirect MultiLineRawScan(text: MultiLineRawText)

type StringOrigin =
  | PlainString(start: UInt64)
  | PrefixedString(start: UInt64, quote_start: UInt64, quotes: UInt64)
  | QuotedString(start: UInt64, delimiter: UInt8)

type StringFrame(
  scan: StringScan,
  builder: Builder,
  tag: Option[token.Tag],
  form: token.Form,
  nesting: UInt64,
  inline: Bool,
  origin: StringOrigin,
)

type StringProgress = Interpolates(request: InterpolationRequest) | Ended(ending: Ending, stop: UInt64)

fn open_string(scanner: mut Scanner, tag: own Option[token.Tag], nesting: UInt64, inline: Bool, origin: StringOrigin) -> ItemScan
  uses Panic
  requires scanner.is_at(scanner.position, byte: 34) || scanner.is_at(scanner.position, byte: 36)
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  let dollars = scanner.run_length(start, byte: 36)
  let quotes = scanner.run_length(start + dollars, byte: 34)
  if dollars == 0 && quotes == 1 {
    return open_ordinary(mut scanner, own tag, nesting, inline, origin, closing: 34)
  }
  if dollars == 0 && quotes == 2 {
    scanner.position = start + 2
    let literal = token.StringLiteral(
      own tag,
      form: token.Form.Ordinary,
      first: token.Text(value: "", span: source.make_span(start + 1, stop: start + 1)),
      rest: [],
    )
    let kind = store_literal(mut scanner, own literal)
    return ItemScan.Ready(finish_scanned(mut scanner, origin, inline, scanned: ScannedString(kind, ending: Ending.Closed)))
  }
  let literal_start = match tag {
    Some(written) => written.span.start
    None => start
  }
  let delimiter_stop = start + dollars + quotes
  let line_end = scanner.compute_end_of_line(delimiter_stop)
  let is_multi_line = scanner.skip_spaces(delimiter_stop) == line_end
  let form = token.Form.Raw(quotes, dollars, multi_line: is_multi_line)
  if !is_multi_line {
    scanner.position = delimiter_stop
    return open_one_line_raw(mut scanner, own tag, form, nesting, inline, origin, literal_start, dollars, quotes)
  }
  if nesting > 0 {
    report(
      mut scanner,
      code: "lexer.line_break_in_interpolation",
      span: source.make_span(literal_start, stop: line_end),
      message: "An interpolation cannot contain a line break, so it cannot hold a multi-line string. Move the expression into a `let` before the string.",
    )
    scanner.position = line_end
    let kind = make_literal(mut scanner, own tag, form, builder: make_builder(delimiter_stop), stop: delimiter_stop)
    return ItemScan.Ready(finish_scanned(mut scanner, origin, inline, scanned: ScannedString(kind, ending: Ending.Unterminated)))
  }
  scanner.position = line_end
  if scanner.position < scanner.length {
    let _ = consume_line_break(mut scanner)
  }
  let text = MultiLineRawText(
    literal_start,
    quotes,
    dollars,
    delimiter_stop,
    line_end,
    lines: [],
    is_at_line_start: true,
    closing: None,
  )
  var frame = StringFrame(scan: StringScan.MultiLineRawScan(own text), builder: make_builder(line_end), own tag, form, nesting, inline, origin)
  match continue_string(mut scanner, frame: mut frame, interpolated: None) {
    Interpolates(request) => ItemScan.Opened(string: own frame, request)
    Ended(ending, stop) => ItemScan.Ready(finish_string(mut scanner, frame: own frame, ending: ending, stop: stop))
  }
}

fn open_ordinary(scanner: mut Scanner, tag: own Option[token.Tag], nesting: UInt64, inline: Bool, origin: StringOrigin, closing: UInt8) -> ItemScan
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let open_quote = scanner.position
  let literal_start = match tag {
    Some(written) => written.span.start
    None => open_quote
  }
  scanner.position = open_quote + 1
  var builder = make_builder(scanner.position)
  match continue_ordinary(mut scanner, builder: mut builder, closing: closing, literal_start: literal_start, nesting: nesting) {
    Ended(ending, stop) => ItemScan.Ready(
      finish_text(mut scanner, own tag, form: token.Form.Ordinary, builder: own builder, stop: stop, ending: ending, origin: origin, inline: inline),
    )
    Interpolates(request) => ItemScan.Opened(
      string: StringFrame(scan: StringScan.OrdinaryScan(closing, literal_start), own builder, own tag, form: token.Form.Ordinary, nesting, inline, origin),
      request,
    )
  }
}

fn open_one_line_raw(
  scanner: mut Scanner,
  tag: own Option[token.Tag],
  form: token.Form,
  nesting: UInt64,
  inline: Bool,
  origin: StringOrigin,
  literal_start: UInt64,
  dollars: UInt64,
  quotes: UInt64,
) -> ItemScan
  uses Panic
  ensures scanner.continues(old(scanner))
{
  var builder = make_builder(scanner.position)
  match continue_one_line_raw(mut scanner, builder: mut builder, literal_start: literal_start, quotes: quotes, dollars: dollars, nesting: nesting) {
    Ended(ending, stop) => ItemScan.Ready(
      finish_text(mut scanner, own tag, form: form, builder: own builder, stop: stop, ending: ending, origin: origin, inline: inline),
    )
    Interpolates(request) => ItemScan.Opened(
      string: StringFrame(scan: StringScan.OneLineRawScan(literal_start, quotes, dollars), own builder, own tag, form, nesting, inline, origin),
      request,
    )
  }
}

fn continue_string(scanner: mut Scanner, frame: mut StringFrame, interpolated: Option[InterpolationResult]) -> StringProgress
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures result is Interpolates(_) ==> scanner.position < scanner.length
{
  if interpolated is Some(result) {
    add_interpolation(mut frame.builder, interpolation: result.interpolation)
    if result.ending == Ending.Unterminated && !(frame.scan is MultiLineRawScan(_)) {
      return StringProgress.Ended(ending: Ending.Unterminated, stop: scanner.position)
    }
  }
  match mut frame.scan {
    OrdinaryScan(closing, literal_start) => continue_ordinary(mut scanner, builder: mut frame.builder, closing: closing, literal_start: literal_start, nesting: frame.nesting)
    OneLineRawScan(literal_start, quotes, dollars) => continue_one_line_raw(
      mut scanner,
      builder: mut frame.builder,
      literal_start: literal_start,
      quotes: quotes,
      dollars: dollars,
      nesting: frame.nesting,
    )
    MultiLineRawScan(text) => continue_multi_line_raw(mut scanner, builder: mut frame.builder, text: mut text)
  }
}

fn finish_text(
  scanner: mut Scanner,
  tag: own Option[token.Tag],
  form: token.Form,
  builder: own Builder,
  stop: UInt64,
  ending: Ending,
  origin: StringOrigin,
  inline: Bool,
) -> Item
  uses Panic
  ensures scanner.continues(old(scanner))
{
  let kind = make_literal(mut scanner, own tag, form: form, builder: own builder, stop: stop)
  finish_scanned(mut scanner, origin: origin, inline: inline, scanned: ScannedString(kind, ending))
}

fn finish_string(scanner: mut Scanner, frame: own StringFrame, ending: Ending, stop: UInt64) -> Item
  uses Panic
  ensures scanner.continues(old(scanner))
{
  match own frame.scan {
    MultiLineRawScan(text) => {
      let kind = finish_multi_line_raw(mut scanner, own frame.tag, form: frame.form, text: own text)
      finish_scanned(mut scanner, origin: frame.origin, inline: frame.inline, scanned: ScannedString(kind, ending))
    }
    OrdinaryScan(..) | OneLineRawScan(..) => finish_text(
      mut scanner,
      own frame.tag,
      form: frame.form,
      builder: own frame.builder,
      stop: stop,
      ending: ending,
      origin: frame.origin,
      inline: frame.inline,
    )
  }
}

fn finish_scanned(scanner: mut Scanner, origin: StringOrigin, inline: Bool, scanned: ScannedString) -> Item
  uses Panic
  ensures scanner.continues(old(scanner))
{
  match origin {
    PlainString(_) => {}
    PrefixedString(start, quote_start, quotes) => report_prefixed_string(mut scanner, start, quote_start, quotes, scanned)
    QuotedString(start, delimiter) => report_quoted_string(mut scanner, start, delimiter, scanned)
  }
  let PlainString(start) | PrefixedString(start, ..) | QuotedString(start, ..) = origin
  lexed(mut scanner, inline, start, kind: scanned.kind, ending: scanned.ending)
}

type EscapeResult = ContinueString | EndOfLine
  derives Equal

fn continue_ordinary(scanner: mut Scanner, builder: mut Builder, closing: UInt8, literal_start: UInt64, nesting: UInt64) -> StringProgress
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures result is Interpolates(_) ==> scanner.position < scanner.length
{
  while true
    invariant scanner.continues(old(scanner))
    decreases scanner.count_remaining(scanner.position)
  {
    copy_plain(mut scanner, buffer: mut builder.buffer, special: Special.OrdinarySpecial(closing))
    let position = scanner.position
    if scanner.is_end_of_line(position) {
      let message = "This string is not closed on its line. An ordinary string fits on one line; text that spans lines goes in a raw string, between `\"\"\"`s."
      if nesting == 0 {
        let fixes = if ends_in_closer(scanner, text_start: literal_start + 1, stop: position) {
          []
        } else {
          [source.make_fix("Close the string", edits: [source.insert(source.make_zero_width(position), replacement: "\"")])]
        }
        report(
          mut scanner,
          code: "lexer.unterminated_string",
          span: source.make_span(literal_start, stop: position),
          message: message,
          fixes: own fixes,
        )
      } else {
        report(mut scanner, code: "lexer.unterminated_string", span: source.make_span(literal_start, stop: position), message: message)
      }
      return StringProgress.Ended(ending: Ending.Unterminated, stop: position)
    }
    if scanner.is_at(position, byte: closing) {
      scanner.position = position + 1
      return StringProgress.Ended(ending: Ending.Closed, stop: position)
    }
    if scanner.is_at(position, byte: 92) {
      if scan_escape(mut scanner, buffer: mut builder.buffer) == EscapeResult.EndOfLine {
        return StringProgress.Ended(ending: Ending.Unterminated, stop: scanner.position)
      }
      continue
    }
    if scanner.is_at(position, byte: 36) && scanner.is_at(position + 1, byte: 123) {
      return StringProgress.Interpolates(InterpolationRequest(nesting, delimiter_length: 2))
    }
    if scanner.is_at(position, byte: 36) {
      mut builder.buffer.push("$")
      scanner.position = position + 1
      continue
    }
    read_character(mut scanner, buffer: mut builder.buffer, context: Context.OrdinaryString)
  }
}

fn scan_escape(scanner: mut Scanner, buffer: mut String) -> EscapeResult
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  if scanner.is_end_of_line(start + 1) {
    report(
      mut scanner,
      code: "lexer.invalid_escape",
      span: source.make_span(start, stop: start + 1),
      message: "A `\\` at the end of a line does not continue the string. Text that spans lines goes in a raw string, between `\"\"\"`s.",
    )
    scanner.position = start + 1
    return EscapeResult.EndOfLine
  }
  let escaped = scanner.lookup(start + 1)
  let simple: Option[StringSlice] = if escaped == 110 {
    Some("\n")
  } else if escaped == 116 {
    Some("\t")
  } else if escaped == 114 {
    Some("\r")
  } else if escaped == 48 {
    Some("\0")
  } else if escaped == 92 {
    Some("\\")
  } else if escaped == 34 {
    Some("\"")
  } else {
    None
  }
  if simple is Some(value) {
    mut buffer.push(value)
    scanner.position = start + 2
    return EscapeResult.ContinueString
  }
  if escaped == 36 && scanner.is_at(start + 2, byte: 123) {
    mut buffer.push("\${")
    scanner.position = start + 3
    return EscapeResult.ContinueString
  }
  if escaped == 117 {
    let form = "A Unicode escape is written `\\u{...}`, with 1 to 6 hexadecimal digits."
    if !scanner.is_at(start + 2, byte: 123) {
      if scan_foreign_escape(mut scanner, mut buffer) {
        return EscapeResult.ContinueString
      }
      report_escape_problem(mut scanner, start, stop: start + 2, message: form)
      return EscapeResult.ContinueString
    }
    let digits_start = start + 3
    var stop = digits_start
    while scanner.is_hexadecimal_digit_at(stop)
      invariant digits_start <= stop
      decreases scanner.count_remaining(stop)
    {
      stop += 1
    }
    let count = stop - digits_start
    if !scanner.is_at(stop, byte: 125) {
      report_escape_problem(mut scanner, start, stop, message: form)
      return EscapeResult.ContinueString
    }
    if count == 0 || count > 6 {
      report_escape_problem(mut scanner, start, stop: stop + 1, message: form)
      return EscapeResult.ContinueString
    }
    let digits = scanner.text(digits_start, stop)
    var value: UInt32 = 0
    for byte in digits.bytes() {
      value = value * 16 + UInt32.from_integer(hexadecimal_value(byte))
    }
    match Character.try_from_code(value) {
      Ok(character) => {
        mut buffer.push_character(character)
        scanner.position = stop + 1
      }
      Err(_) => {
        report_escape_problem(
          mut scanner,
          start,
          stop: stop + 1,
          message: "`\\u{${digits}}` is not a Unicode scalar value: surrogates and values above 10FFFF have no character.",
        )
      }
    }
    return EscapeResult.ContinueString
  }
  if scan_foreign_escape(mut scanner, mut buffer) {
    return EscapeResult.ContinueString
  }
  let decoded = scanner.decode(start + 1)
  let length = if decoded.is_valid { decoded.length } else { 1 }
  let written = if !decoded.is_valid {
    "`\\` followed by ${scanner.show_character(start + 1)}"
  } else {
    "`${scanner.text(start, stop: start + 1 + length)}`"
  }
  report_escape_problem(
    mut scanner,
    start,
    stop: start + 1 + length,
    message: "${written} is not an escape. The escapes are `\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\\${`, and `\\u{...}`. For text with backslashes, such as a regular expression or a Windows path, a raw string has no escapes: `\"\"\"\\d+\"\"\"`.",
  )
  EscapeResult.ContinueString
}

fn hexadecimal_value(byte: UInt8) -> UInt8
  uses Panic
{
  if is_digit(byte) {
    byte - 48
  } else if byte >= 97 {
    byte - 87
  } else {
    byte - 55
  }
}

fn report_escape_problem(scanner: mut Scanner, start: UInt64, stop: UInt64, message: StringSlice)
  uses Panic
  requires scanner.position <= stop
  ensures scanner.continues(old(scanner))
  ensures scanner.position == stop
{
  report(mut scanner, code: "lexer.invalid_escape", span: source.make_span(start, stop), message: message)
  scanner.position = stop
}

fn scan_raw_dollars(scanner: mut Scanner, builder: mut Builder, dollars: UInt64, nesting: UInt64) -> Option[InterpolationRequest]
  uses Panic
  requires scanner.is_at(scanner.position, byte: 36)
  ensures scanner.continues(old(scanner))
  ensures result is Some(_) ==> scanner.position < scanner.length
  ensures result is None ==> old(scanner.position) < scanner.position
{
  let start = scanner.position
  let run = scanner.run_length(start, byte: 36)
  let needed = if dollars > 1 { dollars } else { 1 }
  if run >= needed && scanner.is_at(start + run, byte: 123) {
    mut builder.buffer.push("$".repeated(run - needed))
    scanner.position = start + run - needed
    return Some(InterpolationRequest(nesting, delimiter_length: needed + 1))
  }
  mut builder.buffer.push("$".repeated(run))
  scanner.position = start + run
  None
}

fn report_too_many_quotes(scanner: mut Scanner, start: UInt64, run: UInt64, quotes: UInt64, is_multi_line: Bool)
  uses Panic
  ensures scanner.continues(old(scanner))
{
  let advice = if is_multi_line {
    " Open the string with a longer delimiter."
  } else {
    " A one-line raw string cannot start or end with `\"`; use the multi-line form, or a longer delimiter."
  }
  report(
    mut scanner,
    code: "lexer.raw_string_quotes",
    span: source.make_span(start, stop: start + run),
    message: "A run of ${run} `\"`s is longer than this string's delimiter of ${quotes}.${advice}",
  )
}

fn continue_one_line_raw(
  scanner: mut Scanner,
  builder: mut Builder,
  literal_start: UInt64,
  quotes: UInt64,
  dollars: UInt64,
  nesting: UInt64,
) -> StringProgress
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures result is Interpolates(_) ==> scanner.position < scanner.length
{
  while true
    invariant scanner.continues(old(scanner))
    decreases scanner.count_remaining(scanner.position)
  {
    copy_plain(mut scanner, buffer: mut builder.buffer, special: Special.RawSpecial)
    let position = scanner.position
    if scanner.is_end_of_line(position) {
      let delimiter = "\"".repeated(quotes)
      let fixes = if nesting == 0 && scanner.lookup(position - 1) != 34
        && !ends_in_closer(scanner, text_start: builder.text_start, stop: position)
      {
        [
          source.make_fix(
            "Close the string with `${delimiter}`",
            edits: [source.insert(source.make_zero_width(position), replacement: delimiter)],
          ),
        ]
      } else {
        []
      }
      report(
        mut scanner,
        code: "lexer.unterminated_string",
        span: source.make_span(literal_start, stop: position),
        message: "This raw string is not closed on its line. A raw string with text after its opening `${delimiter}` is a one-line string. For several lines, start the text on the line after the opening `${delimiter}`.",
        fixes: own fixes,
      )
      return StringProgress.Ended(ending: Ending.Unterminated, stop: position)
    }
    if scanner.is_at(position, byte: 34) {
      let run = scanner.run_length(position, byte: 34)
      scanner.position = position + run
      if run >= quotes {
        if run > quotes {
          report_too_many_quotes(mut scanner, start: position, run: run, quotes: quotes, is_multi_line: false)
        }
        return StringProgress.Ended(ending: Ending.Closed, stop: position)
      }
      mut builder.buffer.push("\"".repeated(run))
      continue
    }
    if scanner.is_at(position, byte: 36) {
      if scan_raw_dollars(mut scanner, mut builder, dollars, nesting) is Some(request) {
        return StringProgress.Interpolates(request)
      }
      continue
    }
    read_character(mut scanner, buffer: mut builder.buffer, context: Context.RawString)
  }
}

type Closing =
  | OwnLine(indentation: String, delimiter_start: UInt64)
  | AfterText(start: UInt64)
  | UnterminatedAt(position: UInt64)

fn finish_multi_line_raw(scanner: mut Scanner, tag: own Option[token.Tag], form: token.Form, text: own MultiLineRawText) -> token.Kind
  uses Panic
  ensures scanner.continues(old(scanner))
{
  match own text.closing {
    Some(closing) => return build_multi_line(mut scanner, own tag, form, quotes: text.quotes, delimiter_stop: text.delimiter_stop, lines: text.lines, closing: own closing)
    None => {}
  }
  scanner.unterminated_at_end = true
  let delimiter = "\"".repeated(text.quotes)
  var notes: List[source.Note] = []
  if guess_raw_string_end(scanner, literal_start: text.literal_start, line_end: text.line_end) is Some(line_start) {
    mut notes.push(
      source.Note(
        span: source.make_zero_width(line_start),
        message: "The string may have been meant to end with `${delimiter}` before this line.",
      ),
    )
  }
  if text.quotes == 6 && text.dollars == 0 {
    mut notes.push(
      source.Note(span: source.make_span(text.delimiter_stop - text.quotes, stop: text.delimiter_stop), message: "For an empty string, write `\"\"`."),
    )
  }
  report(
    mut scanner,
    code: "lexer.unterminated_string",
    span: source.make_span(text.literal_start, stop: text.delimiter_stop),
    message: "This raw string is never closed, so it runs to the end of the file. Close it with `${delimiter}` on a line of its own.",
    notes: own notes,
  )
  let position = scanner.position
  build_multi_line(mut scanner, own tag, form, quotes: text.quotes, delimiter_stop: text.delimiter_stop, lines: text.lines, closing: Closing.UnterminatedAt(position))
}

fn finish_line(builder: mut Builder, stop: UInt64) -> Finished
  uses Panic
{
  let line = own builder
  builder = make_builder(stop)
  finish(own line, stop)
}

fn continue_multi_line_raw(scanner: mut Scanner, builder: mut Builder, text: mut MultiLineRawText) -> StringProgress
  uses Panic
  ensures scanner.continues(old(scanner))
  ensures result is Interpolates(_) ==> scanner.position < scanner.length
{
  while true
    invariant scanner.continues(old(scanner))
    decreases scanner.count_remaining(scanner.position)
  {
    if text.is_at_line_start {
      let line_start = scanner.position
      if line_start >= scanner.length {
        return StringProgress.Ended(ending: Ending.Closed, stop: line_start)
      }
      let first = scanner.skip_spaces(line_start)
      if scanner.run_length(first, byte: 34) >= text.quotes {
        let run = scanner.run_length(first, byte: 34)
        if run > text.quotes {
          report_too_many_quotes(mut scanner, start: first, run: run, quotes: text.quotes, is_multi_line: true)
        }
        scanner.position = first + run
        text.closing = Some(Closing.OwnLine(indentation: scanner.text(line_start, stop: first).to_string(), delimiter_start: first))
        return StringProgress.Ended(ending: Ending.Closed, stop: first)
      }
      builder = make_builder(line_start)
      text.is_at_line_start = false
    }
    copy_plain(mut scanner, buffer: mut builder.buffer, special: Special.RawSpecial)
    let position = scanner.position
    if scanner.is_end_of_line(position) {
      mut text.lines.push(finish_line(mut builder, stop: position))
      if scanner.is_at_end(position) {
        return StringProgress.Ended(ending: Ending.Closed, stop: position)
      }
      let _ = consume_line_break(mut scanner)
      text.is_at_line_start = true
      continue
    }
    if scanner.is_at(position, byte: 34) {
      let run = scanner.run_length(position, byte: 34)
      scanner.position = position + run
      if run == text.quotes {
        mut text.lines.push(finish_line(mut builder, stop: position))
        text.closing = Some(Closing.AfterText(start: position))
        return StringProgress.Ended(ending: Ending.Closed, stop: position)
      }
      if run > text.quotes {
        report_too_many_quotes(mut scanner, start: position, run: run, quotes: text.quotes, is_multi_line: true)
      }
      mut builder.buffer.push("\"".repeated(run))
      continue
    }
    if scanner.is_at(position, byte: 36) {
      if scan_raw_dollars(mut scanner, mut builder, dollars: text.dollars, nesting: 0) is Some(request) {
        return StringProgress.Interpolates(request)
      }
      continue
    }
    read_character(mut scanner, buffer: mut builder.buffer, context: Context.RawString)
  }
}

fn take_blank_prefix(text: StringSlice) -> StringSlice
  uses Panic
{
  var stop: UInt64 = 0
  while stop < text.length() && is_space(text.byte(stop)) {
    stop += 1
  }
  text.substring(0, to: stop)
}

fn find_leading_whitespace(line: Finished) -> Option[StringSlice]
  uses Panic
{
  let whitespace = take_blank_prefix(line.first.value)
  if whitespace == line.first.value && line.rest.is_empty() { None } else { Some(whitespace) }
}

fn compute_common_prefix(first: StringSlice, second: StringSlice) -> String
  uses Panic
{
  let length = if first.length() < second.length() { first.length() } else { second.length() }
  var index: UInt64 = 0
  while index < length && first.byte(index) == second.byte(index) {
    index += 1
  }
  first.substring(0, to: index).to_string()
}

fn compute_common_indentation(lines: Slice[Finished]) -> String
  uses Panic
{
  var common: Option[String] = None
  for line in lines {
    if find_leading_whitespace(line) is Some(prefix) {
      common = match common {
        None => Some(prefix.to_string())
        Some(so_far) => Some(compute_common_prefix(prefix, second: so_far))
      }
    }
  }
  match own common {
    Some(text) => text
    None => ""
  }
}

fn guess_raw_string_end(scanner: Scanner, literal_start: UInt64, line_end: UInt64) -> Option[UInt64]
  uses Panic
{
  let opener_line = scanner.source.compute_line_start(literal_start)
  let opener_indentation = scanner.skip_spaces(opener_line) - opener_line
  var position = line_end
  while position < scanner.length {
    let line_start = position + scanner.measure_line_break(position)
    if line_start >= scanner.length {
      return None
    }
    let first = scanner.skip_spaces(line_start)
    let is_blank = scanner.is_end_of_line(first)
    if (!is_blank && first - line_start < opener_indentation) || starts_definition(scanner.source, offset: line_start) {
      return Some(line_start)
    }
    position = scanner.compute_end_of_line(line_start)
  }
  None
}

fn describe_whitespace(whitespace: StringSlice) -> String
  uses Panic
{
  if whitespace.is_empty() {
    return "no indentation"
  }
  var groups: List[String] = []
  var index: UInt64 = 0
  while index < whitespace.length() {
    let character = whitespace.byte(index)
    var next = index
    while next < whitespace.length() && whitespace.byte(next) == character {
      next += 1
    }
    let count = next - index
    let noun = if character == 9 {
      if count == 1 { "tab" } else { "tabs" }
    } else {
      if count == 1 { "space" } else { "spaces" }
    }
    mut groups.push("${count} ${noun}")
    index = next
  }
  groups.join(" then ")
}

fn build_multi_line(
  scanner: mut Scanner,
  tag: own Option[token.Tag],
  form: token.Form,
  quotes: UInt64,
  delimiter_stop: UInt64,
  lines: Slice[Finished],
  closing: own Closing,
) -> token.Kind
  uses Panic
  ensures scanner.continues(old(scanner))
{
  var indentation = ""
  var delimiter_start: UInt64 = 0
  match own closing {
    OwnLine(indentation: written, delimiter_start: start) => {
      indentation = own written
      delimiter_start = start
    }
    AfterText(start) => {
      indentation = compute_common_indentation(lines)
      report(
        mut scanner,
        code: "lexer.raw_string_closing_not_alone",
        span: source.make_span(start, stop: start + quotes),
        message: "The closing delimiter of a multi-line raw string goes on a line of its own.",
        fixes: [
          source.make_fix(
            "Move the closing delimiter to its own line",
            edits: [source.insert(source.make_zero_width(start), replacement: "\n${indentation}")],
          ),
        ],
      )
      delimiter_start = start
    }
    UnterminatedAt(position) => {
      indentation = compute_common_indentation(lines)
      delimiter_start = position
    }
  }
  var joined = make_builder(delimiter_stop)
  for entry in lines.enumerate()
    invariant scanner.continues(old(scanner))
  {
    let line = entry.element
    if entry.index > 0 {
      mut joined.buffer.push("\n")
    }
    let value = line.first.value.slice()
    if value.starts_with(indentation) {
      mut joined.buffer.push(value.substring(indentation.length(), to: value.length()))
    } else if find_leading_whitespace(line).is_some() {
      var at: UInt64 = 0
      while at < value.length() && at < indentation.length() && value.byte(at) == indentation.byte(at) {
        at += 1
      }
      let line_whitespace = find_leading_whitespace(line).unwrap_or("")
      let whitespace_stop = scanner.skip_spaces(line.first.span.start)
      let source_whitespace = scanner.text(line.first.span.start, stop: whitespace_stop)
      var source_difference: UInt64 = 0
      while source_difference < source_whitespace.length() && source_difference < indentation.length()
        && source_whitespace.byte(source_difference) == indentation.byte(source_difference)
      {
        source_difference += 1
      }
      let source_at = line.first.span.start + source_difference
      report(
        mut scanner,
        code: "lexer.raw_string_indentation",
        span: source.make_span(source_at, stop: source_at + 1),
        message: "Every line of a multi-line raw string starts with the indentation of its closing delimiter, which is ${describe_whitespace(indentation)}. This line starts with ${describe_whitespace(line_whitespace)}.",
        fixes: [
          source.make_fix(
            "Indent the line like the closing delimiter",
            edits: [source.replace(source.make_span(line.first.span.start, stop: whitespace_stop), replacement: indentation)],
          ),
        ],
      )
      mut joined.buffer.push(value.substring(at, to: value.length()))
    }
    for segment in line.rest {
      add_interpolation(mut joined, interpolation: segment.interpolation)
      mut joined.buffer.push(segment.text.value)
    }
  }
  make_literal(mut scanner, own tag, form, builder: own joined, stop: delimiter_start)
}
