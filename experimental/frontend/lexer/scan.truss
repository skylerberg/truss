use frontend.source
use frontend.token

fn store_number(scanner: mut Scanner, value: own NumberValue) -> token.Kind
  modifies scanner.tables
{
  match own value {
    IntegerValue(integer) => {
      let index = scanner.tables.integers.length()
      mut scanner.tables.integers.push(own integer)
      token.Kind.Integer(index)
    }
    FloatValue(decimal) => {
      let index = scanner.tables.decimals.length()
      mut scanner.tables.decimals.push(own decimal)
      token.Kind.Float(index)
    }
  }
}

type Punctuated(kind: token.Punctuation, length: UInt64)

fn find_punctuation_starting(current: UInt8, next: UInt8, after: UInt8) -> Option[Punctuated]
  ensures !(result is Some(punctuated) && (punctuated.length < 1 || 3 < punctuated.length))
  ensures !(result is Some(punctuated) && 2 <= punctuated.length && (next == 0 || !is_ascii(next)))
  ensures !(result is Some(punctuated) && punctuated.length == 3 && (after == 0 || !is_ascii(after)))
{
  if current == 40 {
    Some(Punctuated(kind: token.Punctuation.Open(token.Bracket.Paren), length: 1))
  } else if current == 41 {
    Some(Punctuated(kind: token.Punctuation.Close(token.Bracket.Paren), length: 1))
  } else if current == 91 {
    Some(Punctuated(kind: token.Punctuation.Open(token.Bracket.Square), length: 1))
  } else if current == 93 {
    Some(Punctuated(kind: token.Punctuation.Close(token.Bracket.Square), length: 1))
  } else if current == 123 {
    Some(Punctuated(kind: token.Punctuation.Open(token.Bracket.Curly), length: 1))
  } else if current == 125 {
    Some(Punctuated(kind: token.Punctuation.Close(token.Bracket.Curly), length: 1))
  } else if current == 44 {
    Some(Punctuated(kind: token.Punctuation.Comma, length: 1))
  } else if current == 63 {
    Some(Punctuated(kind: token.Punctuation.Question, length: 1))
  } else if current == 126 {
    Some(Punctuated(kind: token.Punctuation.Tilde, length: 1))
  } else if current == 58 {
    Some(Punctuated(kind: token.Punctuation.Colon, length: 1))
  } else if current == 46 {
    if next == 46 {
      if after == 61 {
        Some(Punctuated(kind: token.Punctuation.DotDotEqual, length: 3))
      } else {
        Some(Punctuated(kind: token.Punctuation.DotDot, length: 2))
      }
    } else {
      Some(Punctuated(kind: token.Punctuation.Dot, length: 1))
    }
  } else if current == 45 {
    if next == 62 {
      Some(Punctuated(kind: token.Punctuation.Arrow, length: 2))
    } else if next == 61 {
      Some(Punctuated(kind: token.Punctuation.MinusEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Minus, length: 1))
    }
  } else if current == 43 {
    if next == 61 {
      Some(Punctuated(kind: token.Punctuation.PlusEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Plus, length: 1))
    }
  } else if current == 42 {
    if next == 61 {
      Some(Punctuated(kind: token.Punctuation.StarEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Star, length: 1))
    }
  } else if current == 47 {
    if next == 61 {
      Some(Punctuated(kind: token.Punctuation.SlashEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Slash, length: 1))
    }
  } else if current == 37 {
    if next == 61 {
      Some(Punctuated(kind: token.Punctuation.PercentEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Percent, length: 1))
    }
  } else if current == 94 {
    if next == 61 {
      Some(Punctuated(kind: token.Punctuation.CaretEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Caret, length: 1))
    }
  } else if current == 38 {
    if next == 38 {
      Some(Punctuated(kind: token.Punctuation.AndAnd, length: 2))
    } else if next == 61 {
      Some(Punctuated(kind: token.Punctuation.AmpersandEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Ampersand, length: 1))
    }
  } else if current == 124 {
    if next == 124 {
      Some(Punctuated(kind: token.Punctuation.OrOr, length: 2))
    } else if next == 61 {
      Some(Punctuated(kind: token.Punctuation.BarEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Bar, length: 1))
    }
  } else if current == 61 {
    if next == 61 && after == 62 {
      Some(Punctuated(kind: token.Punctuation.Implies, length: 3))
    } else if next == 61 {
      Some(Punctuated(kind: token.Punctuation.EqualEqual, length: 2))
    } else if next == 62 {
      Some(Punctuated(kind: token.Punctuation.FatArrow, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Equal, length: 1))
    }
  } else if current == 33 {
    if next == 61 {
      Some(Punctuated(kind: token.Punctuation.NotEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Bang, length: 1))
    }
  } else if current == 60 {
    if next == 60 {
      if after == 61 {
        Some(Punctuated(kind: token.Punctuation.ShiftLeftEqual, length: 3))
      } else {
        Some(Punctuated(kind: token.Punctuation.ShiftLeft, length: 2))
      }
    } else if next == 61 {
      Some(Punctuated(kind: token.Punctuation.LessEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Less, length: 1))
    }
  } else if current == 62 {
    if next == 62 {
      if after == 61 {
        Some(Punctuated(kind: token.Punctuation.ShiftRightEqual, length: 3))
      } else {
        Some(Punctuated(kind: token.Punctuation.ShiftRight, length: 2))
      }
    } else if next == 61 {
      Some(Punctuated(kind: token.Punctuation.GreaterEqual, length: 2))
    } else {
      Some(Punctuated(kind: token.Punctuation.Greater, length: 1))
    }
  } else {
    None
  }
}

fn lex_punctuation(scanner: mut Scanner, current: UInt8) -> Option[token.Kind]
  modifies scanner.position
  requires scanner.position < scanner.length && current == scanner.source.text.byte(scanner.position) && is_ascii(current)
  ensures result is Some(_) ==> old(scanner.position) < scanner.position
  ensures result is None ==> scanner.position == old(scanner.position)
{
  let start = scanner.position
  let next = if start + 1 < scanner.length { scanner.lookup(start + 1) } else { 0 }
  let after = if start + 2 < scanner.length { scanner.lookup(start + 2) } else { 0 }
  let Some(punctuated) = find_punctuation_starting(current, next, after) else {
    return None
  }
  scanner.position = start + punctuated.length
  Some(token.Kind.Punctuation(punctuated.kind))
}

fn ends_operand(kind: token.Kind) -> Bool {
  match kind {
    Upper(_) | Lower(_) | Underscore | Integer(_) | Float(_) | String(_) => true
    Punctuation(punctuation_kind) => match punctuation_kind {
      Close(_) | Question => true
      _ => false
    }
    Keyword(keyword) => match keyword {
      True | False | SelfValue | SelfType | Todo | Unreachable => true
      _ => false
    }
    _ => false
  }
}

fn follows_operand(scanner: Scanner) -> Bool {
  match scanner.previous {
    Some(previous) => ends_operand(previous.kind)
    None => false
  }
}

fn begins_operand(kind: token.Kind) -> Bool {
  match kind {
    Upper(_) | Lower(_) | Underscore | Integer(_) | Float(_) | String(_) => true
    Punctuation(punctuation_kind) => match punctuation_kind {
      Open(bracket) => bracket != token.Bracket.Curly
      _ => false
    }
    Keyword(keyword) => match keyword {
      True | False | SelfValue | SelfType | Todo | Unreachable => true
      _ => false
    }
    _ => false
  }
}

fn is_word(kind: token.Kind) -> Bool {
  match kind {
    Upper(_) | Lower(_) | Underscore | Keyword(_) | Reserved(_) => true
    _ => false
  }
}

type Pending =
  | AfterInteger(integer: Scanned, float_value: NumberValue, completed: String)
  | AfterPoint(integer: Scanned, dot: Scanned, merged: Scanned, completed: String)
  | AfterEllipsis(raw: Scanned, was_after_operand: Bool)
  invariant match self {
    AfterPoint(integer, dot, ..) => integer.stop == dot.start
    _ => true
  }

type ItemScan = Ready(item: Item) | indirect Awaiting(pending: Pending) | indirect Opened(string: StringFrame, request: InterpolationRequest)

type Resolution = Resolved(item: Item) | Rescan(pending: Pending)

fn make_scanned(scanner: mut Scanner, inline: Bool, start: UInt64, kind: token.Kind, ending: Ending = Ending.Closed) -> Scanned
  modifies scanner.diagnostics, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank, scanner.semicolons
  requires start < scanner.position
  ensures result.start == start && result.stop == scanner.position
{
  report_semicolons(mut scanner, line_break: kind != token.Kind.Punctuation(token.Punctuation.Close(token.Bracket.Curly)))
  let first_line_break = if inline { None } else { scanner.first_line_break }
  let blank_line = !inline && scanner.blank_line
  if !inline {
    scanner.first_line_break = None
    scanner.blank_line = false
    scanner.line_is_blank = false
  }
  Scanned(kind, start, stop: scanner.position, ending, first_line_break, blank_line)
}

fn hold(scanner: mut Scanner, first: Item, second: Option[Item] = None)
  modifies scanner.held
  ensures scanner.held.length() <= old(scanner.held.length()) + 2
{
  if second is Some(later) {
    mut scanner.held.push(later)
  }
  mut scanner.held.push(first)
}

fn attach_trivia(skipped: Scanned, next: Scanned) -> Scanned {
  let first_line_break = match skipped.first_line_break {
    Some(line_break) => Some(line_break)
    None => next.first_line_break
  }
  next with (first_line_break, blank_line: skipped.blank_line || next.blank_line)
}

fn restore_trivia(scanner: mut Scanner, skipped: Scanned)
  modifies scanner.first_line_break, scanner.blank_line
{
  if skipped.first_line_break is Some(line_break) {
    scanner.first_line_break = Some(line_break)
  }
  scanner.blank_line = skipped.blank_line || scanner.blank_line
}

fn lexed(scanner: mut Scanner, inline: Bool, start: UInt64, kind: token.Kind, ending: Ending = Ending.Closed) -> Item
  modifies scanner.diagnostics, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank, scanner.semicolons
  requires start < scanner.position
{
  Item.Lexed(make_scanned(mut scanner, inline, start, kind, ending))
}

fn make_forbidden(scanner: mut Scanner)
  modifies scanner.diagnostics, scanner.position, scanner.line_is_blank
  requires scanner.position < scanner.length
  ensures old(scanner.position) < scanner.position
{
  report_forbidden_run(mut scanner, context: Context.Code)
  scanner.line_is_blank = false
}

fn scan_item(scanner: mut Scanner, inline: Bool, nesting: UInt64) -> ItemScan
  uses Panic
  modifies scanner.diagnostics, scanner.position, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank,
    scanner.unterminated_at_end, scanner.interned_names, scanner.previous, scanner.semicolons,
    scanner.tables
  ensures result is Ready(End) || (inline && result is Ready(LineEnd(..)))
    || (old(scanner.position) < scanner.position && old(scanner.position) < scanner.length)
  ensures old(scanner.position) <= scanner.position
{
  while true
    invariant old(scanner.position) <= scanner.position
    decreases scanner.count_remaining(scanner.position)
  {
    let start = scanner.position
    if scanner.is_at_end(start) {
      report_semicolons(mut scanner, line_break: false)
      return ItemScan.Ready(Item.End)
    }
    let current = scanner.lookup(start)
    if is_space(current) {
      scanner.position = start + 1
      continue
    }
    if is_line_break(current) {
      report_semicolons(mut scanner, line_break: false)
      let line_break = if inline {
        source.make_span(start, stop: start + scanner.measure_line_break(start))
      } else {
        consume_line_break(mut scanner)
      }
      return ItemScan.Ready(Item.LineEnd(line_break))
    }
    let scanned = scan_token(mut scanner, inline, nesting, start, current)
    match own scanned {
      Some(scan) => return scan
      None => {}
    }
  }
}

fn scan_token(scanner: mut Scanner, inline: Bool, nesting: UInt64, start: UInt64, current: UInt8) -> Option[ItemScan]
  uses Panic
  modifies scanner.diagnostics, scanner.position, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank,
    scanner.unterminated_at_end, scanner.interned_names, scanner.previous, scanner.semicolons,
    scanner.tables
  requires start == scanner.position && start < scanner.length && current == scanner.source.text.byte(start)
  ensures old(scanner.position) < scanner.position
{
  if is_ascii_letter(current) || current == 95 {
    return Some(lex_name(mut scanner, inline, nesting))
  }
  if is_digit(current) {
    return Some(lex_number(mut scanner, inline))
  }
  if !is_ascii(current) {
    return scan_non_ascii(mut scanner, inline, nesting, start)
  }
  if current < 32 || current == 127 {
    make_forbidden(mut scanner)
    return None
  }
  scan_symbol(mut scanner, inline, nesting, start, current)
}

fn scan_non_ascii(scanner: mut Scanner, inline: Bool, nesting: UInt64, start: UInt64) -> Option[ItemScan]
  uses Panic
  modifies scanner.diagnostics, scanner.position, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank,
    scanner.unterminated_at_end, scanner.interned_names, scanner.semicolons, scanner.tables
  requires start == scanner.position && start < scanner.length
  ensures old(scanner.position) < scanner.position
{
  let character = scanner.character_at(start)
  if is_forbidden(character.code()) {
    make_forbidden(mut scanner)
    return None
  }
  if is_xid_start(character.code()) {
    return Some(lex_name(mut scanner, inline, nesting))
  }
  match scan_confusable(mut scanner) {
    Some(confusable) => match confusable {
      LexedConfusable(kind) => Some(ItemScan.Ready(lexed(mut scanner, inline, start, kind)))
      Spaced => None
    }
    None => {
      let shown = scanner.show_character(start)
      reject(mut scanner, length: character.utf8_length(), message: "${shown} is not used in Truss.")
      None
    }
  }
}

fn scan_symbol(scanner: mut Scanner, inline: Bool, nesting: UInt64, start: UInt64, current: UInt8) -> Option[ItemScan]
  uses Panic
  modifies scanner.diagnostics, scanner.position, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank,
    scanner.unterminated_at_end, scanner.previous, scanner.semicolons, scanner.tables
  requires start == scanner.position && start < scanner.length && current == scanner.source.text.byte(start)
  requires is_ascii(current) && 32 <= current && current != 127
  ensures old(scanner.position) < scanner.position
{
  if scan_comment(mut scanner, inline) {
    return None
  }
  match scan_operator(mut scanner) {
    Some(operator) => match operator {
      LexedOperator(kind) => return Some(ItemScan.Ready(lexed(mut scanner, inline, start, kind)))
      Ellipsis => return Some(lex_ellipsis(mut scanner, inline, start))
    }
    None => {}
  }
  let string_form = if current == 36 && opens_raw_string(scanner, index: start) {
    None
  } else {
    scan_string_form(mut scanner, inline, nesting)
  }
  match own string_form {
    Some(form) => match own form {
      FormScanned(scan) => return Some(own scan)
      Skipped => return None
    }
    None => {}
  }
  if current == 34 {
    return Some(open_string(mut scanner, tag: None, nesting: nesting, inline: inline, origin: StringOrigin.PlainString(start)))
  }
  if current == 36 {
    if opens_raw_string(scanner, index: start) {
      return Some(open_string(mut scanner, tag: None, nesting: nesting, inline: inline, origin: StringOrigin.PlainString(start)))
    }
    let run = scanner.run_length(start, byte: 36)
    reject(
      mut scanner,
      length: run,
      message: "`$` is used only in strings: `\${...}` inside a string interpolates, and `$`s before a raw string's `\"\"\"` choose how it interpolates.",
    )
    return None
  }
  if current == 46 && scanner.is_digit_at(start + 1) && !follows_operand(scanner) {
    if lex_leading_dot(mut scanner) is Some(value) {
      let kind = store_number(mut scanner, own value)
      return Some(ItemScan.Ready(lexed(mut scanner, inline, start, kind)))
    }
  }
  match lex_punctuation(mut scanner, current) {
    Some(kind) => return Some(ItemScan.Ready(lexed(mut scanner, inline, start, kind)))
    None => {
      reject(mut scanner, length: 1, message: "`${scanner.text(start, stop: start + 1)}` is not used in Truss.")
    }
  }
  None
}

fn lex_number(scanner: mut Scanner, inline: Bool) -> ItemScan
  modifies scanner.diagnostics, scanner.position, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank,
    scanner.previous, scanner.semicolons, scanner.tables
  requires scanner.position < scanner.length && is_digit(scanner.source.text.byte(scanner.position))
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  let stop = scan_number_end(scanner.source.text, start)
  scanner.position = stop
  let checked = check_number(scanner.text(start, stop))
  if checked.problem is Some(problem) {
    var fixes: List[source.Fix] = []
    if !scanner.is_at(stop, byte: 46) {
      for fix in checked.fixes {
        mut fixes.push(source.make_fix(fix.title, edits: [source.replace(source.make_span(start, stop), replacement: fix.text)]))
      }
    }
    report(
      mut scanner,
      code: problem.code,
      span: source.make_span(start + problem.start, stop: start + problem.stop),
      message: problem.message,
      fixes: own fixes,
    )
  }
  let trailing = lex_trailing_point(scanner, start, stop, checked)
  let integer_kind = store_number(mut scanner, value: own checked.value)
  let integer = make_scanned(mut scanner, inline, start, kind: integer_kind)
  let Some(point) = own trailing else {
    return ItemScan.Ready(Item.Lexed(integer))
  }
  scanner.previous = Some(integer)
  ItemScan.Awaiting(Pending.AfterInteger(integer, float_value: own point.value, completed: own point.completed))
}

type TrailingPoint(value: NumberValue, completed: String)

fn lex_trailing_point(scanner: Scanner, start: UInt64, stop: UInt64, checked: CheckedNumber) -> Option[TrailingPoint]
  requires start <= stop && scanner.is_boundary(start) && scanner.is_boundary(stop)
{
  let is_integer = match checked.value {
    IntegerValue(_) => true
    FloatValue(_) => false
  }
  if !is_integer || checked.problem.is_some() || !scanner.is_at(stop, byte: 46) || is_radix(scanner.text(start, stop)) {
    return None
  }
  let completed = "${scanner.text(start, stop: stop + 1)}0"
  let pointed = check_number(completed)
  if pointed.problem.is_some() {
    return None
  }
  match own pointed.value {
    FloatValue(decimal) => Some(TrailingPoint(value: NumberValue.FloatValue(own decimal), own completed))
    IntegerValue(_) => None
  }
}

fn report_trailing_point(scanner: mut Scanner, integer: Scanned, dot: Scanned, completed: String)
  modifies scanner.diagnostics
  requires integer.stop == dot.start
{
  let fixes = scanner.list_code_fixes(source.make_span(integer.start, stop: dot.start + 1), codes: [completed.copy()])
  report(
    mut scanner,
    code: "lexer.number_missing_digits",
    span: source.make_span(dot.start, stop: dot.start + 1),
    message: "A float has a digit after its `.`: `${completed}`.",
    fixes: own fixes,
  )
}

fn lex_leading_dot(scanner: mut Scanner) -> Option[NumberValue]
  modifies scanner.diagnostics, scanner.position
  requires scanner.is_at(scanner.position, byte: 46) && scanner.is_digit_at(scanner.position + 1)
  ensures result is None ==> scanner.position == old(scanner.position)
  ensures result is Some(_) ==> old(scanner.position) < scanner.position
  ensures old(scanner.position) <= scanner.position
{
  let start = scanner.position
  let stop = scan_number_end(scanner.source.text, start: start + 1)
  let fixed = "0${scanner.text(start, stop)}"
  let checked = check_number(fixed)
  let is_float = match checked.value {
    FloatValue(_) => true
    IntegerValue(_) => false
  }
  if !is_float {
    return None
  }
  scanner.position = stop
  if checked.problem.is_none() {
    let fixes = scanner.list_code_fixes(source.make_span(start, stop), codes: [fixed.copy()])
    report(
      mut scanner,
      code: "lexer.number_missing_digits",
      span: source.make_span(start, stop: start + 1),
      message: "A float has a digit before its `.`: `${fixed}`.",
      fixes: own fixes,
    )
  } else {
    report(
      mut scanner,
      code: "lexer.number_missing_digits",
      span: source.make_span(start, stop: start + 1),
      message: "A float has a digit before its `.`.",
    )
  }
  Some(own checked.value)
}

fn lex_ellipsis(scanner: mut Scanner, inline: Bool, start: UInt64) -> ItemScan
  modifies scanner.diagnostics, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank, scanner.previous,
    scanner.semicolons
  requires start < scanner.position
{
  let was_after_operand = follows_operand(scanner)
  let raw = make_scanned(mut scanner, inline, start, kind: token.Kind.Punctuation(token.Punctuation.DotDotEqual))
  scanner.previous = None
  ItemScan.Awaiting(Pending.AfterEllipsis(raw, was_after_operand))
}

fn resolve(scanner: mut Scanner, pending: own Pending, following: Item) -> Resolution
  modifies scanner.diagnostics, scanner.first_line_break, scanner.blank_line, scanner.previous, scanner.held,
    scanner.tables
  ensures scanner.held.length() <= old(scanner.held.length()) + 2
  ensures result is Rescan(_) ==> following is Lexed(_) && scanner.held.length() == old(scanner.held.length())
{
  match own pending {
    AfterInteger(integer, float_value, completed) => {
      let is_point = match following {
        Lexed(next) => next.kind == token.Kind.Punctuation(token.Punctuation.Dot) && next.start == integer.stop
        _ => false
      }
      if !is_point {
        hold(mut scanner, first: following)
        return Resolution.Resolved(Item.Lexed(integer))
      }
      let Lexed(dot) = following else {
        unreachable
      }
      let float_kind = store_number(mut scanner, value: own float_value)
      let merged = integer with (kind: float_kind, stop: dot.stop)
      scanner.previous = Some(merged)
      Resolution.Rescan(Pending.AfterPoint(integer, dot, merged, own completed))
    }
    AfterPoint(integer, dot, merged, completed) => {
      let is_word_after = match following {
        Lexed(word) => is_word(word.kind)
        _ => false
      }
      if is_word_after {
        hold(mut scanner, first: Item.Lexed(dot), second: Some(following))
        return Resolution.Resolved(Item.Lexed(integer))
      }
      report_trailing_point(mut scanner, integer, dot, completed)
      hold(mut scanner, first: following)
      Resolution.Resolved(Item.Lexed(merged))
    }
    AfterEllipsis(raw, was_after_operand) => {
      let operand_follows = match following {
        Lexed(next) => begins_operand(next.kind)
        LineEnd(_) | End => false
      }
      match report_ellipsis(
        mut scanner,
        span: source.make_span(raw.start, stop: raw.stop),
        follows_operand: was_after_operand,
        operand_follows: operand_follows,
      ) {
        Some(kind) => {
          hold(mut scanner, first: following)
          Resolution.Resolved(Item.Lexed(raw with (kind)))
        }
        None => match following {
          Lexed(next) => Resolution.Resolved(Item.Lexed(attach_trivia(skipped: raw, next: next)))
          LineEnd(_) | End => {
            restore_trivia(mut scanner, skipped: raw)
            Resolution.Resolved(following)
          }
        }
      }
    }
  }
}

fn settle(scanner: mut Scanner, pending: mut List[Pending], arrived: Item) -> Option[Item]
  modifies scanner.diagnostics, scanner.first_line_break, scanner.blank_line, scanner.previous, scanner.held,
    scanner.tables
  ensures !(arrived is Lexed(_)) && 0 < old(pending.length()) ==>
    3 * pending.length() + scanner.held.length() < 3 * old(pending.length()) + old(scanner.held.length())
{
  var item = arrived
  while mut pending.pop() is Some(waiting)
    invariant pending.length() <= old(pending.length())
    invariant 3 * pending.length() + scanner.held.length() + (old(pending.length()) - pending.length())
      <= 3 * old(pending.length()) + old(scanner.held.length())
    invariant pending.length() < old(pending.length()) || identical(item, arrived)
    decreases pending.length()
  {
    match resolve(mut scanner, own waiting, following: item) {
      Resolved(resolved) => item = resolved
      Rescan(next) => {
        mut pending.push(own next)
        return None
      }
    }
  }
  Some(item)
}

fn opens_literal_at(scanner: Scanner, stop: UInt64) -> Bool {
  scanner.is_at(stop, byte: 34) || scanner.is_at(stop, byte: 39) || (scanner.is_at(stop, byte: 36) && opens_raw_string(scanner, index: stop))
}

fn intern_name(scanner: mut Scanner, start: UInt64, stop: UInt64) -> InternedName
  modifies scanner.interned_names, scanner.tables
  requires start <= stop && scanner.is_boundary(start) && scanner.is_boundary(stop)
{
  if scanner.interned_names.get(scanner.text(start, stop)) is Some(interned) {
    return interned.copy()
  }
  let interned = InternedName(index: scanner.tables.names.length(), check: check_name(scanner.text(start, stop)))
  mut scanner.tables.names.push(scanner.text(start, stop).copy())
  mut scanner.interned_names.insert(scanner.text(start, stop).copy(), value: interned.copy())
  interned
}

fn lex_name(scanner: mut Scanner, inline: Bool, nesting: UInt64) -> ItemScan
  uses Panic
  modifies scanner.diagnostics, scanner.position, scanner.first_line_break, scanner.blank_line, scanner.line_is_blank,
    scanner.unterminated_at_end, scanner.interned_names, scanner.semicolons, scanner.tables
  requires scanner.position < scanner.length
  ensures old(scanner.position) < scanner.position
{
  let start = scanner.position
  let first = scanner.lookup(start)
  var position = if is_ascii(first) { start + 1 } else { start + scanner.character_at(start).utf8_length() }
  while !scanner.is_at_end(position)
    invariant start < position && scanner.is_boundary(position)
    decreases scanner.count_remaining(position)
  {
    let current = scanner.lookup(position)
    if is_ascii(current) {
      if is_ascii_name_byte(current) {
        position += 1
        continue
      }
      break
    }
    let character = scanner.character_at(position)
    if is_xid_continue(character.code()) {
      position += character.utf8_length()
    } else {
      break
    }
  }
  scanner.position = position
  let stop = position
  let spelling = scanner.text(start, stop)
  let kind = if spelling == "_" {
    token.Kind.Underscore
  } else {
    match token.find_word(spelling) {
      Some(word) => word
      None => {
        let interned = intern_name(mut scanner, start, stop)
        let checked = interned.check
        if checked.problem is Some(problem) {
          var fixes: List[source.Fix] = []
          if checked.fix is Some(fixed) {
            let opens_literal = opens_literal_at(scanner, stop)
            if !opens_literal || (fixed.byte(0) >= 65 && fixed.byte(0) <= 90) {
              mut fixes.push(
                source.make_fix("Write `${fixed}`", edits: [source.replace(source.make_span(start, stop), replacement: fixed)]),
              )
            }
          }
          report(mut scanner, code: problem.code, span: source.make_span(start, stop), message: problem.message, fixes: own fixes)
        }
        if checked.is_upper { token.Kind.Upper(interned.index) } else { token.Kind.Lower(interned.index) }
      }
    }
  }
  let is_tag = match kind {
    Upper(_) => scanner.is_at(stop, byte: 34) || (scanner.is_at(stop, byte: 36) && opens_raw_string(scanner, index: stop))
    _ => false
  }
  if is_tag {
    let tag = token.Tag(name: scanner.text(start, stop).copy(), span: source.make_span(start, stop))
    return open_string(mut scanner, tag: Some(own tag), nesting: nesting, inline: inline, origin: StringOrigin.PlainString(start))
  }
  match lex_after_name(mut scanner, inline, nesting, start, name: kind) {
    Some(scan) => scan
    None => ItemScan.Ready(lexed(mut scanner, inline, start, kind))
  }
}
