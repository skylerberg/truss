use frontend::source
use frontend::token

fn store_number(scanner: mut Scanner, value: own NumberValue) -> token::Kind {
  match own value {
    IntegerValue(integer) => {
      let index = scanner.tables.integers.length()
      mut scanner.tables.integers.push(own integer)
      token::Kind.Integer(index)
    }
    FloatValue(decimal) => {
      let index = scanner.tables.decimals.length()
      mut scanner.tables.decimals.push(own decimal)
      token::Kind.Float(index)
    }
  }
}

fn punctuation(kind: token::Punctuation) -> Option[token::Kind] {
  Some(token::Kind.Punctuation(kind))
}

fn lex_punctuation(scanner: mut Scanner, current: UInt8) -> Option[token::Kind]
  uses Panic
{
  let start = scanner.position
  let next = if start + 1 < scanner.length { scanner.lookup(start + 1) } else { 0 }
  let after = if start + 2 < scanner.length { scanner.lookup(start + 2) } else { 0 }
  var length: UInt64 = 1
  let kind: token::Punctuation = if current == 40 {
    token::Punctuation.Open(token::Bracket.Paren)
  } else if current == 41 {
    token::Punctuation.Close(token::Bracket.Paren)
  } else if current == 91 {
    token::Punctuation.Open(token::Bracket.Square)
  } else if current == 93 {
    token::Punctuation.Close(token::Bracket.Square)
  } else if current == 123 {
    token::Punctuation.Open(token::Bracket.Curly)
  } else if current == 125 {
    token::Punctuation.Close(token::Bracket.Curly)
  } else if current == 44 {
    token::Punctuation.Comma
  } else if current == 63 {
    token::Punctuation.Question
  } else if current == 126 {
    token::Punctuation.Tilde
  } else if current == 58 {
    if next == 58 {
      length = 2
      token::Punctuation.ColonColon
    } else {
      token::Punctuation.Colon
    }
  } else if current == 46 {
    if next == 46 {
      if after == 61 {
        length = 3
        token::Punctuation.DotDotEqual
      } else {
        length = 2
        token::Punctuation.DotDot
      }
    } else {
      token::Punctuation.Dot
    }
  } else if current == 45 {
    if next == 62 {
      length = 2
      token::Punctuation.Arrow
    } else if next == 61 {
      length = 2
      token::Punctuation.MinusEqual
    } else {
      token::Punctuation.Minus
    }
  } else if current == 43 {
    if next == 61 {
      length = 2
      token::Punctuation.PlusEqual
    } else {
      token::Punctuation.Plus
    }
  } else if current == 42 {
    if next == 61 {
      length = 2
      token::Punctuation.StarEqual
    } else {
      token::Punctuation.Star
    }
  } else if current == 47 {
    if next == 61 {
      length = 2
      token::Punctuation.SlashEqual
    } else {
      token::Punctuation.Slash
    }
  } else if current == 37 {
    if next == 61 {
      length = 2
      token::Punctuation.PercentEqual
    } else {
      token::Punctuation.Percent
    }
  } else if current == 94 {
    if next == 61 {
      length = 2
      token::Punctuation.CaretEqual
    } else {
      token::Punctuation.Caret
    }
  } else if current == 38 {
    if next == 38 {
      length = 2
      token::Punctuation.AndAnd
    } else if next == 61 {
      length = 2
      token::Punctuation.AmpersandEqual
    } else {
      token::Punctuation.Ampersand
    }
  } else if current == 124 {
    if next == 124 {
      length = 2
      token::Punctuation.OrOr
    } else if next == 61 {
      length = 2
      token::Punctuation.BarEqual
    } else {
      token::Punctuation.Bar
    }
  } else if current == 61 {
    if next == 61 && after == 62 {
      length = 3
      token::Punctuation.Implies
    } else if next == 61 {
      length = 2
      token::Punctuation.EqualEqual
    } else if next == 62 {
      length = 2
      token::Punctuation.FatArrow
    } else {
      token::Punctuation.Equal
    }
  } else if current == 33 {
    if next == 61 {
      length = 2
      token::Punctuation.NotEqual
    } else {
      token::Punctuation.Bang
    }
  } else if current == 60 {
    if next == 60 {
      if after == 61 {
        length = 3
        token::Punctuation.ShiftLeftEqual
      } else {
        length = 2
        token::Punctuation.ShiftLeft
      }
    } else if next == 61 {
      length = 2
      token::Punctuation.LessEqual
    } else {
      token::Punctuation.Less
    }
  } else if current == 62 {
    if next == 62 {
      if after == 61 {
        length = 3
        token::Punctuation.ShiftRightEqual
      } else {
        length = 2
        token::Punctuation.ShiftRight
      }
    } else if next == 61 {
      length = 2
      token::Punctuation.GreaterEqual
    } else {
      token::Punctuation.Greater
    }
  } else {
    return None
  }
  scanner.position = start + length
  punctuation(kind)
}

fn ends_operand(kind: token::Kind) -> Bool {
  match kind {
    Upper(_) | Lower(_) | Underscore | Integer(_) | Float(_) | String(_) => true
    Punctuation(punctuation_kind) => match punctuation_kind {
      Close(_) | Question => true
      _ => false
    }
    Keyword(keyword) => match keyword {
      True | False | SelfValue | SelfType | Todo | Unreachable => true
      _ => false
    }
    _ => false
  }
}

fn follows_operand(scanner: Scanner) -> Bool {
  match scanner.previous {
    Some(previous) => ends_operand(previous.kind)
    None => false
  }
}

fn begins_operand(kind: token::Kind) -> Bool {
  match kind {
    Upper(_) | Lower(_) | Underscore | Integer(_) | Float(_) | String(_) => true
    Punctuation(punctuation_kind) => match punctuation_kind {
      Open(bracket) => bracket != token::Bracket.Curly
      _ => false
    }
    Keyword(keyword) => match keyword {
      True | False | SelfValue | SelfType | Todo | Unreachable => true
      _ => false
    }
    _ => false
  }
}

fn is_word(kind: token::Kind) -> Bool {
  match kind {
    Upper(_) | Lower(_) | Underscore | Keyword(_) | Reserved(_) => true
    _ => false
  }
}

fn make_scanned(scanner: mut Scanner, inline: Bool, start: UInt64, kind: token::Kind, ending: Ending = Ending.Closed) -> Scanned
  uses Panic, RunForever
{
  report_semicolons(mut scanner, line_break: kind != token::Kind.Punctuation(token::Punctuation.Close(token::Bracket.Curly)))
  let first_line_break = if inline { None } else { scanner.first_line_break }
  let blank_line = !inline && scanner.blank_line
  if !inline {
    scanner.first_line_break = None
    scanner.blank_line = false
    scanner.line_is_blank = false
  }
  Scanned(kind, start, stop: scanner.position, ending, first_line_break, blank_line)
}

fn hold(scanner: mut Scanner, first: Item, second: Option[Item] = None) {
  if second is Some(later) {
    mut scanner.held.push(later)
  }
  mut scanner.held.push(first)
}

fn attach_trivia(skipped: Scanned, next: Scanned) -> Scanned {
  let first_line_break = match skipped.first_line_break {
    Some(line_break) => Some(line_break)
    None => next.first_line_break
  }
  next with (first_line_break, blank_line: skipped.blank_line || next.blank_line)
}

fn restore_trivia(scanner: mut Scanner, skipped: Scanned) {
  if skipped.first_line_break is Some(line_break) {
    scanner.first_line_break = Some(line_break)
  }
  scanner.blank_line = skipped.blank_line || scanner.blank_line
}

fn scan(scanner: mut Scanner, inline: Bool, nesting: UInt64) -> Item
  uses Panic, RunForever
{
  let item = match mut scanner.held.pop() {
    Some(held) => held
    None => scan_item(mut scanner, inline, nesting)
  }
  if item is Lexed(scanned) {
    scanner.previous = Some(scanned)
  }
  item
}

fn scan_after(scanner: mut Scanner, inline: Bool, nesting: UInt64, previous: Option[Scanned]) -> Item
  uses Panic, RunForever
{
  scanner.previous = previous
  scan_item(mut scanner, inline, nesting)
}

fn lexed(scanner: mut Scanner, inline: Bool, start: UInt64, kind: token::Kind, ending: Ending = Ending.Closed) -> Item
  uses Panic, RunForever
{
  Item.Lexed(make_scanned(mut scanner, inline, start, kind, ending))
}

fn make_forbidden(scanner: mut Scanner)
  uses Panic, RunForever
{
  report_forbidden_run(mut scanner, context: Context.Code)
  scanner.line_is_blank = false
}

fn scan_item(scanner: mut Scanner, inline: Bool, nesting: UInt64) -> Item
  uses Panic, RunForever
{
  while true {
    let start = scanner.position
    if scanner.is_at_end(start) {
      report_semicolons(mut scanner, line_break: false)
      return Item.End
    }
    let current = scanner.lookup(start)
    if is_space(current) {
      scanner.position = start + 1
      continue
    }
    if is_line_break(current) {
      report_semicolons(mut scanner, line_break: false)
      return Item.LineEnd
    }
    if is_ascii_letter(current) || current == 95 {
      return lex_name(mut scanner, inline, nesting)
    }
    if is_digit(current) {
      return lex_number(mut scanner, inline, nesting)
    }
    if !is_ascii(current) {
      let decoded = scanner.decode(start)
      if !decoded.is_valid {
        report_invalid_run(mut scanner)
        continue
      }
      if is_forbidden(decoded.code) {
        make_forbidden(mut scanner)
        continue
      }
      if is_xid_start(decoded.code) {
        return lex_name(mut scanner, inline, nesting)
      }
      match scan_confusable(mut scanner, code: decoded.code, length: decoded.length) {
        Some(confusable) => match confusable {
          LexedConfusable(kind) => return lexed(mut scanner, inline, start, kind)
          Spaced => continue
        }
        None => {
          let shown = scanner.show_character(start)
          reject(mut scanner, length: decoded.length, message: "${shown} is not used in Truss.")
          continue
        }
      }
    }
    if current < 32 || current == 127 {
      make_forbidden(mut scanner)
      continue
    }
    if scan_comment(mut scanner, inline) {
      continue
    }
    match scan_operator(mut scanner) {
      Some(operator) => match operator {
        LexedOperator(kind) => return lexed(mut scanner, inline, start, kind)
        Ellipsis => return lex_ellipsis(mut scanner, inline, nesting, start)
      }
      None => {}
    }
    let string_form = if current == 36 && opens_raw_string(scanner, index: start) {
      None
    } else {
      scan_string_form(mut scanner, nesting)
    }
    match string_form {
      Some(form) => match form {
        LexedString(kind, ending) => return lexed(mut scanner, inline, start, kind, ending)
        Skipped => continue
      }
      None => {}
    }
    if current == 34 {
      return lex_string(mut scanner, tag: None, inline: inline, nesting: nesting, start: start)
    }
    if current == 36 {
      if opens_raw_string(scanner, index: start) {
        return lex_string(mut scanner, tag: None, inline: inline, nesting: nesting, start: start)
      }
      let run = scanner.run_length(start, byte: 36)
      reject(
        mut scanner,
        length: run,
        message: "`$` is used only in strings: `\${...}` inside a string interpolates, and `$`s before a raw string's `\"\"\"` choose how it interpolates.",
      )
      continue
    }
    if current == 46 && scanner.is_digit_at(start + 1) && !follows_operand(scanner) {
      if lex_leading_dot(mut scanner) is Some(value) {
        let kind = store_number(mut scanner, own value)
        return lexed(mut scanner, inline, start, kind)
      }
      match lex_punctuation(mut scanner, current) {
        Some(kind) => return lexed(mut scanner, inline, start, kind)
        None => continue
      }
    }
    match lex_punctuation(mut scanner, current) {
      Some(kind) => return lexed(mut scanner, inline, start, kind)
      None => {
        reject(mut scanner, length: 1, message: "`${scanner.text(start, stop: start + 1)}` is not used in Truss.")
      }
    }
  }
}

fn lex_number(scanner: mut Scanner, inline: Bool, nesting: UInt64) -> Item
  uses Panic, RunForever
{
  let start = scanner.position
  let stop = number_scan_end(scanner.source.text, start)
  scanner.position = stop
  let checked = check_number(scanner.text(start, stop))
  if checked.problem is Some(problem) {
    var fixes: List[source::Fix] = []
    if !scanner.is_at(stop, byte: 46) {
      for fix in checked.fixes {
        mut fixes.push(source::make_fix(fix.title, edits: [source::replace(source::make_span(start, stop), replacement: fix.text)]))
      }
    }
    report(
      mut scanner,
      code: problem.code,
      span: source::make_span(start + problem.start, stop: start + problem.stop),
      message: problem.message,
      fixes: own fixes,
    )
  }
  let trailing = lex_trailing_point(scanner, start, stop, checked)
  let integer_kind = store_number(mut scanner, value: own checked.value)
  let integer = make_scanned(mut scanner, inline, start, kind: integer_kind)
  let Some(float_value) = own trailing else {
    return Item.Lexed(integer)
  }
  let following = scan_after(mut scanner, inline, nesting, previous: Some(integer))
  let is_point = match following {
    Lexed(dot) => dot.kind == token::Kind.Punctuation(token::Punctuation.Dot) && dot.start == stop
    _ => false
  }
  if !is_point {
    hold(mut scanner, first: following)
    return Item.Lexed(integer)
  }
  let Lexed(dot) = following else {
    unreachable
  }
  let float_kind = store_number(mut scanner, value: own float_value)
  let merged = integer with (kind: float_kind, stop: dot.stop)
  let after_point = scan_after(mut scanner, inline, nesting, previous: Some(merged))
  let is_word_after = match after_point {
    Lexed(word) => is_word(word.kind)
    _ => false
  }
  if is_word_after {
    hold(mut scanner, first: Item.Lexed(dot), second: Some(after_point))
    return Item.Lexed(integer)
  }
  report_trailing_point(mut scanner, start, point: dot.start)
  hold(mut scanner, first: after_point)
  Item.Lexed(merged)
}

fn lex_trailing_point(scanner: Scanner, start: UInt64, stop: UInt64, checked: CheckedNumber) -> Option[NumberValue]
  uses Panic, RunForever
{
  let is_integer = match checked.value {
    IntegerValue(_) => true
    FloatValue(_) => false
  }
  if !is_integer || checked.problem.is_some() || !scanner.is_at(stop, byte: 46) || is_radix(scanner.text(start, stop)) {
    return None
  }
  let pointed = check_number("${scanner.text(start, stop: stop + 1)}0")
  if pointed.problem.is_some() {
    return None
  }
  match pointed.value {
    FloatValue(_) => Some(pointed.value.copy())
    IntegerValue(_) => None
  }
}

fn report_trailing_point(scanner: mut Scanner, start: UInt64, point: UInt64)
  uses Panic
{
  let written = scanner.text(start, stop: point + 1).to_string()
  let fixes = scanner.list_code_fixes(source::make_span(start, stop: point + 1), codes: ["${written}0"])
  report(
    mut scanner,
    code: "lexer.number_missing_digits",
    span: source::make_span(point, stop: point + 1),
    message: "A float has a digit after its `.`: `${written}0`.",
    fixes: own fixes,
  )
}

fn lex_leading_dot(scanner: mut Scanner) -> Option[NumberValue]
  uses Panic, RunForever
{
  let start = scanner.position
  let stop = number_scan_end(scanner.source.text, start: start + 1)
  let written = scanner.text(start, stop).to_string()
  let fixed = "0${written}"
  let checked = check_number(fixed)
  let is_float = match checked.value {
    FloatValue(_) => true
    IntegerValue(_) => false
  }
  if !is_float {
    return None
  }
  scanner.position = stop
  if checked.problem.is_none() {
    let fixes = scanner.list_code_fixes(source::make_span(start, stop), codes: [fixed.copy()])
    report(
      mut scanner,
      code: "lexer.number_missing_digits",
      span: source::make_span(start, stop: start + 1),
      message: "A float has a digit before its `.`: `${fixed}`.",
      fixes: own fixes,
    )
  } else {
    report(
      mut scanner,
      code: "lexer.number_missing_digits",
      span: source::make_span(start, stop: start + 1),
      message: "A float has a digit before its `.`.",
    )
  }
  Some(own checked.value)
}

fn lex_ellipsis(scanner: mut Scanner, inline: Bool, nesting: UInt64, start: UInt64) -> Item
  uses Panic, RunForever
{
  let was_after_operand = follows_operand(scanner)
  let raw = make_scanned(mut scanner, inline, start, kind: token::Kind.Punctuation(token::Punctuation.DotDotEqual))
  let following = scan_after(mut scanner, inline, nesting, previous: None)
  let operand_follows = match following {
    Lexed(next) => begins_operand(next.kind)
    LineEnd | End => false
  }
  match report_ellipsis(mut scanner, start, follows_operand: was_after_operand, operand_follows: operand_follows) {
    Some(kind) => {
      hold(mut scanner, first: following)
      Item.Lexed(raw with (kind))
    }
    None => match following {
      Lexed(next) => Item.Lexed(attach_trivia(skipped: raw, next: next))
      LineEnd | End => {
        restore_trivia(mut scanner, skipped: raw)
        following
      }
    }
  }
}

fn lex_string(scanner: mut Scanner, tag: Option[token::Tag], inline: Bool, nesting: UInt64, start: UInt64) -> Item
  uses Panic, RunForever
{
  let scanned = scan_string(mut scanner, tag, nesting)
  lexed(mut scanner, inline, start, kind: scanned.kind, ending: scanned.ending)
}

fn opens_literal_at(scanner: Scanner, stop: UInt64) -> Bool
  uses Panic, RunForever
{
  scanner.is_at(stop, byte: 34) || scanner.is_at(stop, byte: 39) || (scanner.is_at(stop, byte: 36) && opens_raw_string(scanner, index: stop))
}

fn check_cached_name(scanner: mut Scanner, spelling: StringSlice) -> UInt64
  uses Panic
{
  if scanner.name_indices.get(spelling) is Some(interned_index) {
    return interned_index
  }
  let index = scanner.tables.names.length()
  mut scanner.tables.names.push(spelling.to_string())
  mut scanner.name_indices.insert(spelling.to_string(), value: index)
  mut scanner.name_checks.push(check_name(spelling))
  index
}

fn lex_name(scanner: mut Scanner, inline: Bool, nesting: UInt64) -> Item
  uses Panic, RunForever
{
  let start = scanner.position
  var position = start
  while !scanner.is_at_end(position) {
    let current = scanner.lookup(position)
    if is_ascii(current) {
      if is_ascii_name_byte(current) {
        position += 1
        continue
      }
      break
    }
    let decoded = scanner.decode(position)
    if decoded.is_valid && is_xid_continue(decoded.code) {
      position += decoded.length
    } else {
      break
    }
  }
  scanner.position = position
  let stop = position
  let spelling = scanner.text(start, stop).to_string()
  let kind = if spelling == "_" {
    token::Kind.Underscore
  } else {
    match token::find_word(spelling) {
      Some(word) => word
      None => {
        let index = check_cached_name(mut scanner, spelling)
        let checked = scanner.name_checks.get(index).expect("a name check").copy()
        if checked.problem is Some(problem) {
          var fixes: List[source::Fix] = []
          if checked.fix is Some(fixed) {
            let opens_literal = opens_literal_at(scanner, stop)
            if !opens_literal || (fixed.byte(0) >= 65 && fixed.byte(0) <= 90) {
              mut fixes.push(
                source::make_fix("Write `${fixed}`", edits: [source::replace(source::make_span(start, stop), replacement: fixed)]),
              )
            }
          }
          report(mut scanner, code: problem.code, span: source::make_span(start, stop), message: problem.message, fixes: own fixes)
        }
        if checked.is_upper { token::Kind.Upper(index) } else { token::Kind.Lower(index) }
      }
    }
  }
  let is_tag = match kind {
    Upper(_) => scanner.is_at(stop, byte: 34) || (scanner.is_at(stop, byte: 36) && opens_raw_string(scanner, index: stop))
    _ => false
  }
  if is_tag {
    return lex_string(mut scanner, tag: Some(token::Tag(name: own spelling, span: source::make_span(start, stop))), inline: inline, nesting: nesting, start: start)
  }
  match lex_after_name(mut scanner, nesting, start, name: kind) {
    Some(scanned) => lexed(mut scanner, inline, start, kind: scanned.kind, ending: scanned.ending)
    None => lexed(mut scanner, inline, start, kind)
  }
}

fn lex_next(scanner: mut Scanner) -> LayoutInput
  uses Panic, RunForever
{
  while true {
    match scan(mut scanner, inline: false, nesting: 0) {
      LineEnd => {
        let line_break = consume_line_break(mut scanner)
        note_line_break(mut scanner, line_break)
      }
      End => {
        return LayoutInput.Finish(
          position: scanner.length,
          first_line_break: scanner.first_line_break,
          blank_line: scanner.blank_line,
          ends_unterminated: scanner.unterminated_at_end,
        )
      }
      Lexed(scanned) => {
        return LayoutInput.Next(
          kind: scanned.kind,
          span: source::make_span(scanned.start, stop: scanned.stop),
          first_line_break: scanned.first_line_break,
          blank_line: scanned.blank_line,
          unterminated_string: scanned.ending == Ending.Unterminated,
        )
      }
    }
  }
}
