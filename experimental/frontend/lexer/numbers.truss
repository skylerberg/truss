use frontend.token
use standard.math

type NumberValue = IntegerValue(digits: String) | FloatValue(value: token.Decimal)
  derives Equal

type NumberProblem(code: String, message: String, start: UInt64, stop: UInt64)
  invariant start <= stop

type Replacement(title: String, text: String)

type CheckedNumber(value: NumberValue, problem: Option[NumberProblem], fixes: List[Replacement])

fn strip_leading_zeros(digits: String) -> String {
  if digits.is_empty() {
    return "0"
  }
  var start: UInt64 = 0
  while start + 1 < digits.length() && digits.byte(start) == 48
    invariant start < digits.length() && digits.is_boundary(start)
  {
    start += 1
  }
  digits.substring(start, to: digits.length()).copy()
}

fn convert_to_decimal(group: String, radix: UInt32) -> String {
  let base = UInt64.from_integer(radix)
  var value: UInt64 = 0
  for byte in group.bytes() {
    if is_hexadecimal_digit(byte) {
      let Some(shifted) = value.checked_multiply(base) else {
        return convert_large_to_decimal(group, radix)
      }
      let Some(next) = shifted.checked_add(UInt64.from_integer(hexadecimal_value(byte))) else {
        return convert_large_to_decimal(group, radix)
      }
      value = next
    }
  }
  "${value}"
}

fn convert_large_to_decimal(group: String, radix: UInt32) -> String {
  let base = math.BigInteger.from(UInt64.from_integer(radix))
  var value = math.BigInteger.zero()
  for byte in group.bytes() {
    if is_hexadecimal_digit(byte) {
      value = value * base + math.BigInteger.from(UInt64.from_integer(hexadecimal_value(byte)))
    }
  }
  "${value}"
}

fn parse_exponent(group: String) -> math.BigInteger {
  let radix: UInt64 = 10
  let base = math.BigInteger.from(radix)
  var value = math.BigInteger.zero()
  for byte in group.bytes() {
    if is_digit(byte) {
      value = value * base + math.BigInteger.from(UInt64.from_integer(byte - 48))
    }
  }
  value
}

fn measure_name_character(text: String, position: UInt64) -> UInt64
  requires position < text.length() && text.is_boundary(position)
  ensures is_ascii_name_byte(text.byte(position)) ==> result == 1
  ensures 0 < result ==> position + result <= text.length() && text.is_boundary(position + result)
{
  let byte = text.byte(position)
  if is_ascii_name_byte(byte) {
    return 1
  }
  if is_ascii(byte) {
    return 0
  }
  let character = text.character_at(position)
  if is_xid_continue(character.code()) { character.utf8_length() } else { 0 }
}

fn compute_name_end(text: String, position: UInt64) -> UInt64
  requires text.is_boundary(position)
  ensures position <= result && text.is_boundary(result)
  ensures position < text.length() && is_ascii_name_byte(text.byte(position)) ==> position < result
{
  var at = position
  while at < text.length()
    invariant position <= at && text.is_boundary(at)
  {
    let width = measure_name_character(text, position: at)
    if width == 0 {
      break
    }
    at += width
  }
  at
}

fn is_radix_prefix(text: String, start: UInt64) -> Bool
  requires start <= text.length()
  ensures result ==> start + 1 < text.length() && text.byte(start) == 48 && is_ascii(text.byte(start + 1))
{
  start + 1 < text.length() && text.byte(start) == 48 && {
    let marker = text.byte(start + 1)
    marker == 120 || marker == 98 || marker == 111
  }
}

fn is_digits_only(text: String) -> Bool {
  for byte in text.bytes() {
    if !is_digit(byte) && byte != 95 {
      return false
    }
  }
  true
}

fn scan_plain_number_end(text: String, start: UInt64) -> UInt64
  requires start < text.length() && is_digit(text.byte(start))
  ensures start < result && text.is_boundary(result)
{
  let length = text.length()
  let first_stop = compute_name_end(text, position: start)
  let only_digits = is_digits_only(text.substring(start, to: first_stop))
  let stop = if only_digits && first_stop + 1 < length && text.byte(first_stop) == 46 && is_digit(text.byte(first_stop + 1)) {
    compute_name_end(text, position: first_stop + 1)
  } else {
    first_stop
  }
  if !is_radix_prefix(text, start) && text.byte(stop - 1) == 101 && stop + 1 < length
    && (text.byte(stop) == 43 || text.byte(stop) == 45) && is_digit(text.byte(stop + 1))
  {
    compute_name_end(text, position: stop + 1)
  } else {
    stop
  }
}

type Cleaned(text: String, first_bad: Option[UInt64])

fn clean_underscores(group: String) -> Cleaned
  ensures !(result.first_bad is Some(index) && group.length() <= index)
{
  var parts: List[view String] = []
  for part in group.split("_") {
    if !part.is_empty() {
      mut parts.push(part)
    }
  }
  let cleaned = parts.join("_")
  if cleaned == group {
    return Cleaned(text: own cleaned, first_bad: None)
  }
  let length = group.length()
  for index in 0..length {
    if group.byte(index) == 95 && (index == 0 || index == length - 1 || group.byte(index + 1) == 95) {
      return Cleaned(text: own cleaned, first_bad: Some(index))
    }
  }
  Cleaned(text: own cleaned, first_bad: None)
}

fn remove_underscores(group: String) -> String {
  group.replace("_", replacement: "")
}

type Issues(limit: UInt64, leftmost: Option[NumberProblem], leftmost_unfixable: Option[NumberProblem])
  invariant !(leftmost is Some(problem) && limit < problem.stop)
  invariant !(leftmost_unfixable is Some(problem) && limit < problem.stop)

fn make_issues(limit: UInt64) -> Issues
  ensures result.limit == limit
{
  Issues(limit, leftmost: None, leftmost_unfixable: None)
}

fn is_left_of(problem: NumberProblem, leftmost: Option[NumberProblem]) -> Bool {
  match leftmost {
    Some(current) => problem.start < current.start
    None => true
  }
}

fn add_issue(issues: mut Issues, code: String, message: String, start: UInt64, stop: UInt64, is_fixable: Bool = true)
  requires start <= stop && stop <= issues.limit
  ensures issues.limit == old(issues.limit)
{
  let problem = NumberProblem(code: code.copy(), message: message.copy(), start, stop)
  if !is_fixable && is_left_of(problem, leftmost: issues.leftmost_unfixable) {
    issues.leftmost_unfixable = Some(problem.copy())
  }
  if is_left_of(problem, leftmost: issues.leftmost) {
    issues.leftmost = Some(own problem)
  }
}

fn add_underscore_issue(issues: mut Issues, offset: UInt64)
  requires offset < issues.limit
  ensures issues.limit == old(issues.limit)
{
  add_issue(mut issues, "lexer.number_underscore", message: "`_` can only go between digits.", start: offset, stop: offset + 1)
}

fn measure_character(text: String, offset: UInt64) -> UInt64
  requires offset < text.length() && text.is_boundary(offset)
  ensures offset + result <= text.length() && text.is_boundary(offset + result)
{
  text.character_at(offset).utf8_length()
}

fn choose_problem(value: own NumberValue, issues: own Issues, fixed: String) -> CheckedNumber
  ensures !(result.problem is Some(problem) && issues.limit < problem.stop)
{
  if issues.leftmost_unfixable is Some(problem) {
    return CheckedNumber(own value, problem: Some(problem.copy()), fixes: [])
  }
  match own issues.leftmost {
    None => CheckedNumber(own value, problem: None, fixes: [])
    Some(problem) => CheckedNumber(
      own value,
      problem: Some(own problem),
      fixes: [Replacement(title: "Write `${fixed}`", text: fixed.copy())],
    )
  }
}

fn is_base_digit(byte: UInt8, base: UInt32) -> Bool
  ensures result ==> is_hexadecimal_digit(byte)
{
  if base == 16 {
    is_hexadecimal_digit(byte)
  } else if base == 2 {
    byte == 48 || byte == 49
  } else {
    byte >= 48 && byte <= 55
  }
}

fn check_radix(text: String) -> CheckedNumber
  requires is_radix_prefix(text, start: 0)
  ensures !(result.problem is Some(problem) && text.length() < problem.stop)
{
  let length = text.length()
  let marker = text.byte(1)
  let base: UInt32 = if marker == 120 { 16 } else if marker == 98 { 2 } else { 8 }
  let base_name = if base == 16 { "hexadecimal" } else if base == 2 { "binary" } else { "octal" }
  var stop: UInt64 = 2
  while stop < length && (is_base_digit(text.byte(stop), base) || text.byte(stop) == 95)
    invariant 2 <= stop && text.is_boundary(stop)
  {
    stop += 1
  }
  let prefix = text.substring(0, to: 2)
  let group = text.substring(2, to: stop)
  let cleaned = clean_underscores(group)
  let digits = remove_underscores(group)
  var issues = make_issues(limit: length)
  if digits.is_empty() && stop == length {
    add_issue(
      mut issues,
      "lexer.number_missing_digits",
      message: "`${prefix}` must be followed by ${base_name} digits.",
      start: 0,
      stop: stop,
      is_fixable: false,
    )
  }
  if cleaned.first_bad is Some(offset) && !digits.is_empty() {
    add_underscore_issue(mut issues, offset: 2 + offset)
  }
  if stop < length {
    let width = measure_character(text, offset: stop)
    add_issue(
      mut issues,
      "lexer.number_invalid_digit",
      message: "`${text.substring(stop, to: stop + width)}` is not a ${base_name} digit.",
      start: stop,
      stop: stop + width,
      is_fixable: false,
    )
  }
  let value = NumberValue.IntegerValue(convert_to_decimal(group, radix: base))
  choose_problem(own value, own issues, fixed: "${prefix}${cleaned.text}")
}

type Group(offset: UInt64, stop: UInt64, text: view String)
  invariant offset <= stop && text.length() == stop - offset

fn group_from(text: String, offset: UInt64) -> Group
  requires text.is_boundary(offset)
  ensures result.offset == offset && text.is_boundary(result.stop)
{
  var stop = offset
  while stop < text.length() && (is_digit(text.byte(stop)) || text.byte(stop) == 95)
    invariant offset <= stop && text.is_boundary(stop)
  {
    stop += 1
  }
  Group(offset, stop, text: text.substring(offset, to: stop))
}

type Exponent(marker: UInt64, sign: view String, digits: Group)
  invariant marker < digits.offset

fn add_underscore_issues(group: Group, issues: mut Issues)
  requires group.stop <= issues.limit
  ensures issues.limit == old(issues.limit)
{
  if clean_underscores(group.text).first_bad is Some(bad) {
    add_underscore_issue(mut issues, offset: group.offset + bad)
  }
}

fn check_decimal(text: String) -> CheckedNumber
  ensures !(result.problem is Some(problem) && text.length() < problem.stop)
{
  let length = text.length()
  let whole = group_from(text, offset: 0)
  let fraction = if whole.stop < length && text.byte(whole.stop) == 46 {
    Some(group_from(text, offset: whole.stop + 1))
  } else {
    None
  }
  let position = match fraction {
    Some(group) => group.stop
    None => whole.stop
  }
  let exponent = if position < length && text.byte(position) == 101 {
    let digits_offset = if position + 1 < length && (text.byte(position + 1) == 43 || text.byte(position + 1) == 45) {
      position + 2
    } else {
      position + 1
    }
    let digits = group_from(text, offset: digits_offset)
    if digits.text.is_empty() && digits_offset < length {
      None
    } else {
      Some(Exponent(marker: position, sign: text.substring(position + 1, to: digits_offset), digits))
    }
  } else {
    None
  }
  let rest = match exponent {
    Some(written) => written.digits.stop
    None => position
  }
  let issues = list_decimal_issues(text, whole, fraction, exponent, rest)
  let fixed = write_decimal(whole, fraction, exponent)
  choose_problem(value: compute_decimal_value(whole, fraction, exponent), issues: own issues, fixed: fixed)
}

fn list_decimal_issues(text: String, whole: Group, fraction: Option[Group], exponent: Option[Exponent], rest: UInt64) -> Issues
  requires whole.stop <= text.length()
  requires !(fraction is Some(group) && text.length() < group.stop)
  requires !(exponent is Some(written) && text.length() < written.digits.stop)
  requires text.is_boundary(rest)
  ensures result.limit == text.length()
{
  let length = text.length()
  var issues = make_issues(limit: length)
  add_underscore_issues(whole, mut issues)
  if fraction is Some(group) {
    add_underscore_issues(group, mut issues)
  }
  if exponent is Some(written) {
    if remove_underscores(written.digits.text).is_empty() {
      add_issue(
        mut issues,
        "lexer.number_missing_digits",
        message: "The exponent needs digits after `e`.",
        start: written.marker,
        stop: written.digits.offset,
        is_fixable: false,
      )
    } else {
      add_underscore_issues(written.digits, mut issues)
    }
  }
  if rest < length {
    let width = measure_character(text, offset: rest)
    add_issue(
      mut issues,
      "lexer.number_followed_by_name",
      message: "A number cannot be followed directly by a name character such as `${text.substring(rest, to: rest + width)}`.",
      start: rest,
      stop: rest + width,
      is_fixable: false,
    )
  }
  issues
}

fn write_decimal(whole: Group, fraction: Option[Group], exponent: Option[Exponent]) -> String {
  var fixed = clean_underscores(whole.text).text
  if fraction is Some(group) {
    mut fixed.push(".")
    mut fixed.push(clean_underscores(group.text).text)
  }
  if exponent is Some(written) {
    mut fixed.push("e")
    mut fixed.push(written.sign)
    mut fixed.push(clean_underscores(written.digits.text).text)
  }
  fixed
}

fn compute_decimal_value(whole: Group, fraction: Option[Group], exponent: Option[Exponent]) -> NumberValue {
  let whole_digits = remove_underscores(whole.text)
  if fraction.is_none() && exponent.is_none() {
    return NumberValue.IntegerValue(strip_leading_zeros(whole_digits))
  }
  let fraction_digits = match fraction {
    Some(group) => remove_underscores(group.text)
    None => ""
  }
  let exponent_value = match exponent {
    Some(written) => {
      let magnitude = parse_exponent(written.digits.text)
      if written.sign == "-" { -magnitude } else { magnitude }
    }
    None => math.BigInteger.zero()
  }
  let significand = strip_leading_zeros("${whole_digits}${fraction_digits}")
  NumberValue.FloatValue(
    token.normalize_decimal(significand, exponent: exponent_value - math.BigInteger.from(fraction_digits.length())),
  )
}

fn check_plain_number(text: String) -> CheckedNumber
  ensures !(result.problem is Some(problem) && text.length() < problem.stop)
{
  if is_radix_prefix(text, start: 0) { check_radix(text) } else { check_decimal(text) }
}

type Suffix(written: view String, type_name: Option[view String])

fn find_suffix(suffix: String) -> Option[Suffix] {
  let type_name: Option[view String] = match suffix {
    "u8" => Some("UInt8")
    "u16" => Some("UInt16")
    "u32" => Some("UInt32")
    "u64" => Some("UInt64")
    "u128" => None
    "usize" => Some("UInt64")
    "uz" => Some("UInt64")
    "z" => Some("Int64")
    "i8" => Some("Int8")
    "i16" => Some("Int16")
    "i32" => Some("Int32")
    "i64" => Some("Int64")
    "i128" => None
    "isize" => Some("Int64")
    "f16" => None
    "f32" => Some("Float32")
    "f64" => Some("Float64")
    "f128" => None
    "f" => Some("Float32")
    "d" => Some("Float64")
    "m" => None
    "u" => Some("UInt32")
    "l" => Some("Int64")
    "ll" => Some("Int64")
    "ul" => Some("UInt64")
    "lu" => Some("UInt64")
    "ull" => Some("UInt64")
    "llu" => Some("UInt64")
    "n" => None
    _ => return None
  }
  Some(Suffix(written: suffix, type_name))
}

fn is_float_suffix(suffix: String) -> Bool {
  match suffix {
    "f" | "d" | "m" | "f16" | "f32" | "f64" | "f128" => true
    _ => false
  }
}

fn is_radix(text: String) -> Bool
  ensures result ==> 2 <= text.length() && text.byte(0) == 48 && is_ascii(text.byte(1))
{
  text.length() >= 2 && text.byte(0) == 48 && {
    let marker = text.byte(1)
    marker == 120 || marker == 88 || marker == 98 || marker == 66 || marker == 111 || marker == 79
  }
}

fn is_hexadecimal(text: String) -> Bool {
  is_radix(text) && (text.byte(1) == 120 || text.byte(1) == 88)
}

fn skip_hexadecimal_digits(text: String, position: UInt64) -> UInt64
  ensures position <= result
{
  var at = position
  while at < text.length() && is_hexadecimal_digit(text.byte(at))
    invariant position <= at
  {
    at += 1
  }
  at
}

fn skip_decimal_digits(text: String, position: UInt64, with_underscores: Bool) -> UInt64
  requires text.is_boundary(position)
  ensures position <= result && text.is_boundary(result)
{
  var at = position
  while at < text.length() && (is_digit(text.byte(at)) || (with_underscores && text.byte(at) == 95))
    invariant position <= at && text.is_boundary(at)
  {
    at += 1
  }
  at
}

fn sign_follows(text: String, stop: UInt64, marker: UInt8) -> Bool
  requires 0 < stop && stop <= text.length()
  ensures result ==> stop + 1 < text.length() && is_ascii(text.byte(stop))
{
  text.byte(stop - 1) == marker && stop + 1 < text.length() && (text.byte(stop) == 43 || text.byte(stop) == 45)
    && is_digit(text.byte(stop + 1))
}

fn scan_number_end(text: String, start: UInt64) -> UInt64
  requires start < text.length() && is_digit(text.byte(start))
  ensures start < result && text.is_boundary(result)
{
  let length = text.length()
  var stop = scan_plain_number_end(text, start)
  let literal = text.substring(start, to: stop)
  if is_digits_only(literal) {
    while stop + 1 < length && text.byte(stop) == 39 && is_digit(text.byte(stop + 1))
      invariant start < stop && text.is_boundary(stop)
    {
      stop = compute_name_end(text, position: stop + 1)
    }
  }
  if is_hexadecimal(literal) {
    let marker = skip_hexadecimal_digits(text, position: stop + 1)
    if stop + 1 < length && text.byte(stop) == 46 && marker > stop + 1 && marker < length
      && (text.byte(marker) == 112 || text.byte(marker) == 80)
    {
      stop = compute_name_end(text, position: stop + 1)
    }
    if sign_follows(text, stop, marker: 112) || sign_follows(text, stop, marker: 80) {
      return compute_name_end(text, position: stop + 1)
    }
    return stop
  }
  if !is_radix(literal) && sign_follows(text, stop, marker: 69) {
    return compute_name_end(text, position: stop + 1)
  }
  stop
}

fn compute_number_end(text: String) -> UInt64
  ensures text.is_boundary(result)
{
  let length = text.length()
  if is_radix(text) {
    var at: UInt64 = 2
    while at < length && (is_hexadecimal_digit(text.byte(at)) || text.byte(at) == 95)
      invariant 2 <= at && text.is_boundary(at)
    {
      at += 1
    }
    return at
  }
  let whole = skip_decimal_digits(text, position: 0, with_underscores: true)
  let position = if whole < length && text.byte(whole) == 46 {
    skip_decimal_digits(text, position: whole + 1, with_underscores: true)
  } else {
    whole
  }
  if position < length && (text.byte(position) == 101 || text.byte(position) == 69) {
    let digits_start = if position + 1 < length && (text.byte(position + 1) == 43 || text.byte(position + 1) == 45) {
      position + 2
    } else {
      position + 1
    }
    let stop = skip_decimal_digits(text, position: digits_start, with_underscores: true)
    if stop > digits_start { stop } else { position }
  } else {
    position
  }
}

type OctalChoice = NotOctal | ValidOctal(octal: String) | InvalidOctal

type DerivationKind =
  | Translated(translation: String)
  | HexadecimalFloat
  | Suffixed(is_float: Bool)
  | LeadingZero(decimal: String, octal: OctalChoice)

type Derivation(problem: NumberProblem, kind: DerivationKind)

type AppliedFixes(
  are_separators_fixed: Bool,
  is_float_truncated: Bool,
  is_prefix_lowered: Bool,
  is_suffix_removed: Bool,
  is_exponent_lowered: Bool,
  are_zeros_removed: Bool,
)

type NumberFix = DigitSeparators | HexadecimalFloat | UppercasePrefix | TypeSuffix | UppercaseExponent | LeadingZero

fn AppliedFixes.count_unapplied(self) -> UInt64
  ensures result == (if self.are_separators_fixed { 0 } else { 1 }) + (if self.is_float_truncated { 0 } else { 1 })
    + (if self.is_prefix_lowered { 0 } else { 1 }) + (if self.is_suffix_removed { 0 } else { 1 })
    + (if self.is_exponent_lowered { 0 } else { 1 }) + (if self.are_zeros_removed { 0 } else { 1 })
{
  (if self.are_separators_fixed { 0 } else { 1 }) + (if self.is_float_truncated { 0 } else { 1 })
    + (if self.is_prefix_lowered { 0 } else { 1 }) + (if self.is_suffix_removed { 0 } else { 1 })
    + (if self.is_exponent_lowered { 0 } else { 1 }) + (if self.are_zeros_removed { 0 } else { 1 })
}

fn AppliedFixes.has(self, fix: NumberFix) -> Bool
  ensures result == match fix {
    DigitSeparators => self.are_separators_fixed
    HexadecimalFloat => self.is_float_truncated
    UppercasePrefix => self.is_prefix_lowered
    TypeSuffix => self.is_suffix_removed
    UppercaseExponent => self.is_exponent_lowered
    LeadingZero => self.are_zeros_removed
  }
{
  match fix {
    DigitSeparators => self.are_separators_fixed
    HexadecimalFloat => self.is_float_truncated
    UppercasePrefix => self.is_prefix_lowered
    TypeSuffix => self.is_suffix_removed
    UppercaseExponent => self.is_exponent_lowered
    LeadingZero => self.are_zeros_removed
  }
}

fn AppliedFixes.include(self, fix: NumberFix) -> AppliedFixes
  requires !self.has(fix)
  ensures result.count_unapplied() < self.count_unapplied()
{
  match fix {
    DigitSeparators => self with (are_separators_fixed: true)
    HexadecimalFloat => self with (is_float_truncated: true)
    UppercasePrefix => self with (is_prefix_lowered: true)
    TypeSuffix => self with (is_suffix_removed: true)
    UppercaseExponent => self with (is_exponent_lowered: true)
    LeadingZero => self with (are_zeros_removed: true)
  }
}

type Derived(derivation: Derivation, text: String, applied: AppliedFixes)

fn derive(
  code: String,
  message: String,
  start: UInt64,
  stop: UInt64,
  kind: own DerivationKind,
  text: own String,
  applied: AppliedFixes,
  fix: NumberFix,
) -> Option[Derived]
  requires start <= stop
  requires !applied.has(fix)
  ensures !(result is Some(derived) && applied.count_unapplied() <= derived.applied.count_unapplied())
  ensures !(result is Some(derived) && derived.derivation.problem.stop != stop)
{
  let problem = NumberProblem(code: code.copy(), message: message.copy(), start, stop)
  Some(Derived(derivation: Derivation(own problem, own kind), own text, applied: applied.include(fix)))
}

fn translate(
  code: String,
  message: String,
  start: UInt64,
  stop: UInt64,
  translation: own String,
  applied: AppliedFixes,
  fix: NumberFix,
) -> Option[Derived]
  requires start <= stop
  requires !applied.has(fix)
  ensures !(result is Some(derived) && applied.count_unapplied() <= derived.applied.count_unapplied())
  ensures !(result is Some(derived) && derived.derivation.problem.stop != stop)
{
  let text = translation.copy()
  derive(code, message, start, stop, kind: DerivationKind.Translated(own translation), text: own text, applied: applied, fix: fix)
}

type Combined(value: NumberValue, fixes: List[Replacement])

fn combine(kind: own DerivationKind, derived: own CheckedNumber) -> Combined {
  let is_valid = derived.problem.is_none()
  match own kind {
    Translated(translation) => {
      let fixes = if is_valid { [Replacement(title: "Write `${translation}`", text: own translation)] } else { [] }
      Combined(value: own derived.value, own fixes)
    }
    HexadecimalFloat => Combined(value: own derived.value, fixes: [])
    Suffixed(is_float) => {
      let value = match own derived.value {
        IntegerValue(digits) => if is_float {
          NumberValue.FloatValue(token.normalize_decimal(digits, exponent: math.BigInteger.zero()))
        } else {
          NumberValue.IntegerValue(own digits)
        }
        FloatValue(decimal) => NumberValue.FloatValue(own decimal)
      }
      Combined(own value, fixes: [])
    }
    LeadingZero(decimal, octal) => {
      var alternatives: List[Replacement] = []
      match own octal {
        NotOctal => if is_valid {
          mut alternatives.push(Replacement(title: "Write `${decimal}`", text: own decimal))
        }
        ValidOctal(text) => if is_valid {
          mut alternatives.push(Replacement(title: "Write `${text}` (octal)", own text))
          mut alternatives.push(Replacement(title: "Write `${decimal}` (decimal)", text: own decimal))
        }
        InvalidOctal => {}
      }
      Combined(value: own derived.value, fixes: own alternatives)
    }
  }
}

fn replace_quotes(text: String) -> String {
  text.replace("'", replacement: "_")
}

fn examine(text: String, applied: AppliedFixes) -> Option[Derived]
  ensures !(result is Some(derived) && applied.count_unapplied() <= derived.applied.count_unapplied())
  ensures !(result is Some(derived) && text.length() < derived.derivation.problem.stop)
{
  let length = text.length()
  let stop = compute_number_end(text)
  let suffix = text.substring(stop, to: length)
  if !applied.has(NumberFix.DigitSeparators) && text.find("'") is Some(quote) {
    let grouped = replace_quotes(text)
    return translate(
      "lexer.number_digit_separator",
      message: "Digits are grouped with `_`, as in `${grouped}`.",
      start: quote,
      stop: quote + 1,
      translation: own grouped,
      applied: applied,
      fix: NumberFix.DigitSeparators,
    )
  }
  if !applied.has(NumberFix.HexadecimalFloat) && is_hexadecimal(text) && stop < length
    && (text.byte(stop) == 46 || text.byte(stop) == 112 || text.byte(stop) == 80)
  {
    return derive(
      "lexer.number_hexadecimal_float",
      message: "Truss has no hexadecimal floats. Write the value as a decimal float.",
      start: 0,
      stop: length,
      kind: DerivationKind.HexadecimalFloat,
      text: text.substring(0, to: stop).copy(),
      applied: applied,
      fix: NumberFix.HexadecimalFloat,
    )
  }
  if !applied.has(NumberFix.UppercasePrefix) && is_radix(text) && (text.byte(1) == 88 || text.byte(1) == 66 || text.byte(1) == 79) {
    let prefix = "0${text.substring(1, to: 2).to_ascii_lowercase()}"
    return translate(
      "lexer.number_uppercase_prefix",
      message: "Number prefixes are lowercase: write `${prefix}`.",
      start: 0,
      stop: 2,
      translation: "${prefix}${text.substring(2, to: length)}",
      applied: applied,
      fix: NumberFix.UppercasePrefix,
    )
  }
  let lowered_suffix = suffix.to_ascii_lowercase()
  if !applied.has(NumberFix.TypeSuffix) && !suffix.is_empty() && find_suffix(lowered_suffix) is Some(suffix_entry) {
    let number = text.substring(0, to: stop)
    let type_name: view String = match suffix_entry.type_name {
      Some(name) => name
      None => if number.contains(".") || number.contains("e") { "Float64" } else { "Int64" }
    }
    return derive(
      "lexer.number_suffix",
      message: "Number literals have no type suffixes such as `${suffix}`. A literal takes its type from its context, as in `let value: ${type_name} = ${number}`.",
      start: stop,
      stop: length,
      kind: DerivationKind.Suffixed(is_float: is_float_suffix(lowered_suffix)),
      text: number.copy(),
      applied: applied,
      fix: NumberFix.TypeSuffix,
    )
  }
  if !applied.has(NumberFix.UppercaseExponent) && !is_radix(text) && text.find("E") is Some(marker) && marker < stop {
    return translate(
      "lexer.number_uppercase_exponent",
      message: "The exponent is written with a lowercase `e`.",
      start: marker,
      stop: marker + 1,
      translation: "${text.substring(0, to: marker)}e${text.substring(marker + 1, to: length)}",
      applied: applied,
      fix: NumberFix.UppercaseExponent,
    )
  }
  examine_leading_zero(text, applied)
}

fn examine_leading_zero(text: String, applied: AppliedFixes) -> Option[Derived]
  ensures !(result is Some(derived) && applied.count_unapplied() <= derived.applied.count_unapplied())
  ensures !(result is Some(derived) && text.length() < derived.derivation.problem.stop)
{
  let length = text.length()
  let whole = skip_decimal_digits(text, position: 0, with_underscores: true)
  let digits = remove_underscores(text.substring(0, to: whole))
  if applied.has(NumberFix.LeadingZero) || is_radix(text) || digits.length() < 2 || digits.byte(0) != 48 {
    return None
  }
  var stripped: UInt64 = 0
  while stripped < length && (text.byte(stripped) == 48 || text.byte(stripped) == 95)
    invariant text.is_boundary(stripped)
  {
    stripped += 1
  }
  let without_zeros: view String = if stripped >= whole { "0" } else { text.substring(stripped, to: whole) }
  let decimal = "${without_zeros}${text.substring(whole, to: length)}"
  var is_octal_digits = true
  for byte in digits.bytes() {
    if byte < 48 || byte > 55 {
      is_octal_digits = false
    }
  }
  let octal_possible = whole == length && is_octal_digits
  let octal = if !octal_possible {
    OctalChoice.NotOctal
  } else {
    let written = "0o${without_zeros}"
    if check_plain_number(written).problem.is_none() { OctalChoice.ValidOctal(own written) } else { OctalChoice.InvalidOctal }
  }
  let message = if octal_possible {
    "Decimal numbers do not start with `0`. In C and Go, `${text.substring(0, to: whole)}` would be octal: write `0o${without_zeros}` for octal, or `${without_zeros}` for decimal."
  } else {
    "Decimal numbers do not start with `0`."
  }
  let derived = decimal.copy()
  derive(
    "lexer.number_leading_zero",
    message: message,
    start: 0,
    stop: whole,
    kind: DerivationKind.LeadingZero(own decimal, own octal),
    text: own derived,
    applied: applied,
    fix: NumberFix.LeadingZero,
  )
}

fn check_number(text: String) -> CheckedNumber
  ensures !(result.problem is Some(problem) && text.length() < problem.stop)
{
  check_with_fixes(text, applied: AppliedFixes(are_separators_fixed: false, is_float_truncated: false, is_prefix_lowered: false, is_suffix_removed: false, is_exponent_lowered: false, are_zeros_removed: false))
}

fn check_with_fixes(text: String, applied: AppliedFixes) -> CheckedNumber
  decreases applied.count_unapplied()
  ensures !(result.problem is Some(problem) && text.length() < problem.stop)
{
  match examine(text, applied) {
    None => check_plain_number(text)
    Some(derived) => {
      let combined = combine(own derived.derivation.kind, derived: check_with_fixes(derived.text, applied: derived.applied))
      CheckedNumber(value: own combined.value, problem: Some(own derived.derivation.problem), fixes: own combined.fixes)
    }
  }
}
