use frontend.token
use standard.math

type NumberValue = IntegerValue(digits: String) | FloatValue(value: token.Decimal)
  derives Equal

type NumberProblem(code: String, message: String, start: UInt64, stop: UInt64)

type Replacement(title: String, text: String)

type CheckedNumber(value: NumberValue, problem: Option[NumberProblem], fixes: List[Replacement])

fn fits_in_word(digits: StringSlice, radix: UInt32) -> Bool {
  if radix == 16 {
    digits.length() <= 15
  } else if radix == 8 {
    digits.length() <= 21
  } else {
    digits.length() <= 63
  }
}

fn parse_digits(digits: StringSlice, radix: UInt32) -> String
  requires radix >= 2 && radix <= 36
  uses Panic
{
  if radix == 10 {
    var start: UInt64 = 0
    while start + 1 < digits.length() && digits.byte(start) == 48 {
      start += 1
    }
    if digits.is_empty() {
      return "0"
    }
    return digits.substring(start, to: digits.length()).to_string()
  }
  if digits.is_empty() {
    return "0"
  }
  if fits_in_word(digits, radix) {
    var value: UInt64 = 0
    for byte in digits.bytes() {
      value = value * UInt64.from_integer(radix) + UInt64.from_integer(hexadecimal_value(byte))
    }
    return "${value}"
  }
  "${math.BigInteger.parse_radix(digits, radix).expect("the digits were checked")}"
}

fn parse_exponent(digits: StringSlice) -> math.BigInteger
  uses Panic
{
  if digits.length() <= 18 {
    var value: UInt64 = 0
    for byte in digits.bytes() {
      value = value * 10 + UInt64.from_integer(byte - 48)
    }
    return math.BigInteger.from(value)
  }
  math.BigInteger.parse_radix(digits, radix: 10).expect("the exponent digits were checked")
}

fn is_name_byte_or_continue(text: StringSlice, position: UInt64) -> UInt64
  uses Panic
{
  let byte = text.byte(position)
  if is_ascii_name_byte(byte) {
    return 1
  }
  if byte >= 128 {
    let decoded = decode_text(text, index: position)
    if decoded.is_valid && is_xid_continue(decoded.code) {
      return decoded.length
    }
  }
  0
}

fn compute_name_end(text: StringSlice, position: UInt64) -> UInt64
  uses Panic
{
  var at = position
  while at < text.length() {
    let width = is_name_byte_or_continue(text, position: at)
    if width == 0 {
      break
    }
    at += width
  }
  at
}

fn is_radix_prefix(text: StringSlice, start: UInt64) -> Bool
  uses Panic
{
  start + 1 < text.length() && text.byte(start) == 48 && {
    let marker = text.byte(start + 1)
    marker == 120 || marker == 98 || marker == 111
  }
}

fn is_digits_only(text: StringSlice) -> Bool {
  for byte in text.bytes() {
    if !is_digit(byte) && byte != 95 {
      return false
    }
  }
  true
}

fn numbers_scan_end(text: StringSlice, start: UInt64) -> UInt64
  uses Panic
{
  let length = text.length()
  let first_stop = compute_name_end(text, position: start)
  let only_digits = is_digits_only(text.substring(start, to: first_stop))
  let stop = if only_digits && first_stop + 1 < length && text.byte(first_stop) == 46 && is_digit(text.byte(first_stop + 1)) {
    compute_name_end(text, position: first_stop + 1)
  } else {
    first_stop
  }
  if !is_radix_prefix(text, start) && text.byte(stop - 1) == 101 && stop + 1 < length
    && (text.byte(stop) == 43 || text.byte(stop) == 45) && is_digit(text.byte(stop + 1))
  {
    compute_name_end(text, position: stop + 1)
  } else {
    stop
  }
}

type Cleaned(text: String, first_bad: Option[UInt64])

fn clean_underscores(group: StringSlice) -> Cleaned
  uses Panic
{
  var parts: List[StringSlice] = []
  for part in group.split("_") {
    if !part.is_empty() {
      mut parts.push(part)
    }
  }
  let cleaned = parts.join("_")
  if cleaned == group {
    return Cleaned(text: own cleaned, first_bad: None)
  }
  let length = group.length()
  for index in 0..length {
    if group.byte(index) == 95 && (index == 0 || index == length - 1 || group.byte(index + 1) == 95) {
      return Cleaned(text: own cleaned, first_bad: Some(index))
    }
  }
  Cleaned(text: own cleaned, first_bad: None)
}

fn remove_underscores(group: StringSlice) -> String
  uses Panic
{
  group.replace("_", replacement: "")
}

type Issue(problem: NumberProblem, is_fixable: Bool)

fn make_issue(code: StringSlice, message: StringSlice, start: UInt64, stop: UInt64, is_fixable: Bool = true) -> Issue {
  Issue(problem: NumberProblem(code: code.to_string(), message: message.to_string(), start, stop), is_fixable)
}

fn make_underscore_issue(offset: UInt64) -> Issue
  uses Panic
{
  make_issue("lexer.number_underscore", message: "`_` can only go between digits.", start: offset, stop: offset + 1)
}

fn measure_character(text: StringSlice, offset: UInt64) -> UInt64
  uses Panic
{
  let decoded = decode_text(text, index: offset)
  if decoded.is_valid { decoded.length } else { 1 }
}

fn take_leftmost(issues: own List[Issue], only_unfixable: Bool) -> Option[NumberProblem] {
  var best: Option[NumberProblem] = None
  for issue in own issues {
    if only_unfixable && issue.is_fixable {
      continue
    }
    let is_better = match best {
      Some(current) => issue.problem.start < current.start
      None => true
    }
    if is_better {
      best = Some(own issue.problem)
    }
  }
  best
}

fn choose_problem(value: own NumberValue, issues: own List[Issue], fixed: StringSlice) -> CheckedNumber {
  var has_unfixable = false
  for issue in issues {
    if !issue.is_fixable {
      has_unfixable = true
    }
  }
  if has_unfixable {
    return CheckedNumber(own value, problem: take_leftmost(own issues, only_unfixable: true), fixes: [])
  }
  match take_leftmost(own issues, only_unfixable: false) {
    None => CheckedNumber(own value, problem: None, fixes: [])
    Some(problem) => CheckedNumber(
      own value,
      problem: Some(own problem),
      fixes: [Replacement(title: "Write `${fixed}`", text: fixed.to_string())],
    )
  }
}

fn is_base_digit(byte: UInt8, base: UInt32) -> Bool {
  if base == 16 {
    is_hexadecimal_digit(byte)
  } else if base == 2 {
    byte == 48 || byte == 49
  } else {
    byte >= 48 && byte <= 55
  }
}

fn check_radix(text: StringSlice) -> CheckedNumber
  uses Panic
{
  let length = text.length()
  let marker = text.byte(1)
  let base: UInt32 = if marker == 120 { 16 } else if marker == 98 { 2 } else { 8 }
  let base_name = if base == 16 { "hexadecimal" } else if base == 2 { "binary" } else { "octal" }
  var stop: UInt64 = 2
  while stop < length && (is_base_digit(text.byte(stop), base) || text.byte(stop) == 95) {
    stop += 1
  }
  let group = text.substring(2, to: stop)
  let cleaned = clean_underscores(group)
  let digits = remove_underscores(group)
  var issues: List[Issue] = []
  if digits.is_empty() && stop == length {
    mut issues.push(
      make_issue(
        "lexer.number_missing_digits",
        message: "`${text.substring(0, to: 2)}` must be followed by ${base_name} digits.",
        start: 0,
        stop: stop,
        is_fixable: false,
      ),
    )
  }
  if cleaned.first_bad is Some(offset) && !digits.is_empty() {
    mut issues.push(make_underscore_issue(2 + offset))
  }
  if stop < length {
    let width = measure_character(text, offset: stop)
    mut issues.push(
      make_issue(
        "lexer.number_invalid_digit",
        message: "`${text.substring(stop, to: stop + width)}` is not a ${base_name} digit.",
        start: stop,
        stop: stop + width,
        is_fixable: false,
      ),
    )
  }
  let value = NumberValue.IntegerValue(parse_digits(digits, radix: base))
  choose_problem(own value, own issues, fixed: "${text.substring(0, to: 2)}${cleaned.text}")
}

type Group(offset: UInt64, text: StringSlice)

fn Group.stop(self) -> UInt64
  uses Panic
{
  self.offset + self.text.length()
}

fn group_from(text: StringSlice, offset: UInt64) -> Group
  uses Panic
{
  var stop = offset
  while stop < text.length() && (is_digit(text.byte(stop)) || text.byte(stop) == 95) {
    stop += 1
  }
  Group(offset, text: text.substring(offset, to: stop))
}

type Exponent(marker: UInt64, sign: StringSlice, digits: Group)

fn list_underscore_issues(group: Group, issues: mut List[Issue])
  uses Panic
{
  if clean_underscores(group.text).first_bad is Some(bad) {
    mut issues.push(make_underscore_issue(group.offset + bad))
  }
}

fn check_decimal(text: StringSlice) -> CheckedNumber
  uses Panic
{
  let length = text.length()
  let whole = group_from(text, offset: 0)
  let fraction = if whole.stop() < length && text.byte(whole.stop()) == 46 {
    Some(group_from(text, offset: whole.stop() + 1))
  } else {
    None
  }
  let position = match fraction {
    Some(group) => group.stop()
    None => whole.stop()
  }
  let exponent = if position < length && text.byte(position) == 101 {
    let digits_offset = if position + 1 < length && (text.byte(position + 1) == 43 || text.byte(position + 1) == 45) {
      position + 2
    } else {
      position + 1
    }
    let digits = group_from(text, offset: digits_offset)
    if digits.text.is_empty() && digits_offset < length {
      None
    } else {
      Some(Exponent(marker: position, sign: text.substring(position + 1, to: digits_offset), digits))
    }
  } else {
    None
  }
  let rest = match exponent {
    Some(written) => written.digits.stop()
    None => position
  }
  var issues: List[Issue] = []
  list_underscore_issues(whole, mut issues)
  if fraction is Some(group) {
    list_underscore_issues(group, mut issues)
  }
  if exponent is Some(written) {
    if remove_underscores(written.digits.text).is_empty() {
      mut issues.push(
        make_issue(
          "lexer.number_missing_digits",
          message: "The exponent needs digits after `e`.",
          start: written.marker,
          stop: written.digits.offset,
          is_fixable: false,
        ),
      )
    } else {
      list_underscore_issues(written.digits, mut issues)
    }
  }
  if rest < length {
    let width = measure_character(text, offset: rest)
    mut issues.push(
      make_issue(
        "lexer.number_followed_by_name",
        message: "A number cannot be followed directly by a name character such as `${text.substring(rest, to: rest + width)}`.",
        start: rest,
        stop: rest + width,
        is_fixable: false,
      ),
    )
  }
  var fixed = clean_underscores(whole.text).text
  if fraction is Some(group) {
    mut fixed.push(".")
    mut fixed.push(clean_underscores(group.text).text)
  }
  if exponent is Some(written) {
    mut fixed.push("e")
    mut fixed.push(written.sign)
    mut fixed.push(clean_underscores(written.digits.text).text)
  }
  let whole_digits = remove_underscores(whole.text)
  let value = if fraction.is_none() && exponent.is_none() {
    NumberValue.IntegerValue(parse_digits(whole_digits, radix: 10))
  } else {
    let fraction_digits = match fraction {
      Some(group) => remove_underscores(group.text)
      None => ""
    }
    let exponent_value = match exponent {
      Some(written) => {
        let exponent_digits = remove_underscores(written.digits.text)
        if exponent_digits.is_empty() {
          math.BigInteger.zero()
        } else {
          let magnitude = parse_exponent(exponent_digits)
          if written.sign == "-" { -magnitude } else { magnitude }
        }
      }
      None => math.BigInteger.zero()
    }
    let significand = parse_digits("${whole_digits}${fraction_digits}", radix: 10)
    NumberValue.FloatValue(
      token.normalize_decimal(significand, exponent: exponent_value - math.BigInteger.from(fraction_digits.length())),
    )
  }
  choose_problem(own value, own issues, fixed)
}

fn numbers_check(text: StringSlice) -> CheckedNumber
  uses Panic
{
  if is_radix_prefix(text, start: 0) { check_radix(text) } else { check_decimal(text) }
}

type Suffix(written: StringSlice, type_name: Option[StringSlice])

fn find_suffix(suffix: StringSlice) -> Option[Suffix] {
  let type_name: Option[StringSlice] = match suffix {
    "u8" => Some("UInt8")
    "u16" => Some("UInt16")
    "u32" => Some("UInt32")
    "u64" => Some("UInt64")
    "u128" => None
    "usize" => Some("UInt64")
    "uz" => Some("UInt64")
    "z" => Some("Int64")
    "i8" => Some("Int8")
    "i16" => Some("Int16")
    "i32" => Some("Int32")
    "i64" => Some("Int64")
    "i128" => None
    "isize" => Some("Int64")
    "f16" => None
    "f32" => Some("Float32")
    "f64" => Some("Float64")
    "f128" => None
    "f" => Some("Float32")
    "d" => Some("Float64")
    "m" => None
    "u" => Some("UInt32")
    "l" => Some("Int64")
    "ll" => Some("Int64")
    "ul" => Some("UInt64")
    "lu" => Some("UInt64")
    "ull" => Some("UInt64")
    "llu" => Some("UInt64")
    "n" => None
    _ => return None
  }
  Some(Suffix(written: suffix, type_name))
}

fn is_float_suffix(suffix: StringSlice) -> Bool {
  match suffix {
    "f" | "d" | "m" | "f16" | "f32" | "f64" | "f128" => true
    _ => false
  }
}

fn is_radix(text: StringSlice) -> Bool
  uses Panic
{
  text.length() >= 2 && text.byte(0) == 48 && {
    let marker = text.byte(1)
    marker == 120 || marker == 88 || marker == 98 || marker == 66 || marker == 111 || marker == 79
  }
}

fn is_hexadecimal(text: StringSlice) -> Bool
  uses Panic
{
  is_radix(text) && (text.byte(1) == 120 || text.byte(1) == 88)
}

fn skip_hexadecimal_digits(text: StringSlice, position: UInt64) -> UInt64
  uses Panic
{
  var at = position
  while at < text.length() && is_hexadecimal_digit(text.byte(at)) {
    at += 1
  }
  at
}

fn skip_decimal_digits(text: StringSlice, position: UInt64, with_underscores: Bool) -> UInt64
  uses Panic
{
  var at = position
  while at < text.length() && (is_digit(text.byte(at)) || (with_underscores && text.byte(at) == 95)) {
    at += 1
  }
  at
}

fn sign_follows(text: StringSlice, stop: UInt64, marker: UInt8) -> Bool
  uses Panic
{
  text.byte(stop - 1) == marker && stop + 1 < text.length() && (text.byte(stop) == 43 || text.byte(stop) == 45)
    && is_digit(text.byte(stop + 1))
}

fn number_scan_end(text: StringSlice, start: UInt64) -> UInt64
  uses Panic
{
  let length = text.length()
  var stop = numbers_scan_end(text, start)
  let literal = text.substring(start, to: stop)
  if is_digits_only(literal) {
    while stop + 1 < length && text.byte(stop) == 39 && is_digit(text.byte(stop + 1)) {
      stop = compute_name_end(text, position: stop + 1)
    }
  }
  if is_hexadecimal(literal) {
    let marker = skip_hexadecimal_digits(text, position: stop + 1)
    if stop + 1 < length && text.byte(stop) == 46 && marker > stop + 1 && marker < length
      && (text.byte(marker) == 112 || text.byte(marker) == 80)
    {
      stop = compute_name_end(text, position: stop + 1)
    }
    if sign_follows(text, stop, marker: 112) || sign_follows(text, stop, marker: 80) {
      return compute_name_end(text, position: stop + 1)
    }
    return stop
  }
  if !is_radix(literal) && sign_follows(text, stop, marker: 69) {
    return compute_name_end(text, position: stop + 1)
  }
  stop
}

fn compute_number_end(text: StringSlice) -> UInt64
  uses Panic
{
  let length = text.length()
  if is_radix(text) {
    var at: UInt64 = 2
    while at < length && (is_hexadecimal_digit(text.byte(at)) || text.byte(at) == 95) {
      at += 1
    }
    return at
  }
  let whole = skip_decimal_digits(text, position: 0, with_underscores: true)
  let position = if whole < length && text.byte(whole) == 46 {
    skip_decimal_digits(text, position: whole + 1, with_underscores: true)
  } else {
    whole
  }
  if position < length && (text.byte(position) == 101 || text.byte(position) == 69) {
    let digits_start = if position + 1 < length && (text.byte(position + 1) == 43 || text.byte(position + 1) == 45) {
      position + 2
    } else {
      position + 1
    }
    let stop = skip_decimal_digits(text, position: digits_start, with_underscores: true)
    if stop > digits_start { stop } else { position }
  } else {
    position
  }
}

fn make_translation(code: StringSlice, message: StringSlice, start: UInt64, stop: UInt64, translation: StringSlice) -> CheckedNumber
  uses Panic, RunForever
{
  let checked = check_number(translation)
  let fixes = if checked.problem.is_none() {
    [Replacement(title: "Write `${translation}`", text: translation.to_string())]
  } else {
    []
  }
  CheckedNumber(
    value: own checked.value,
    problem: Some(NumberProblem(code: code.to_string(), message: message.to_string(), start, stop)),
    own fixes,
  )
}

fn replace_quotes(text: StringSlice) -> String
  uses Panic
{
  text.replace("'", replacement: "_")
}

fn lex_foreign_number(text: StringSlice) -> Option[CheckedNumber]
  uses Panic, RunForever
{
  let length = text.length()
  let stop = compute_number_end(text)
  let suffix = text.substring(stop, to: length)
  if text.find("'") is Some(quote) {
    let grouped = replace_quotes(text)
    return Some(
      make_translation(
        "lexer.number_digit_separator",
        message: "Digits are grouped with `_`, as in `${grouped}`.",
        start: quote,
        stop: quote + 1,
        translation: grouped,
      ),
    )
  }
  if is_hexadecimal(text) && stop < length && (text.byte(stop) == 46 || text.byte(stop) == 112 || text.byte(stop) == 80) {
    return Some(
      CheckedNumber(
        value: check_number(text.substring(0, to: stop)).value,
        problem: Some(
          NumberProblem(
            code: "lexer.number_hexadecimal_float",
            message: "Truss has no hexadecimal floats. Write the value as a decimal float.",
            start: 0,
            stop: length,
          ),
        ),
        fixes: [],
      ),
    )
  }
  if is_radix(text) && (text.byte(1) == 88 || text.byte(1) == 66 || text.byte(1) == 79) {
    let prefix = "0${text.substring(1, to: 2).to_ascii_lowercase()}"
    return Some(
      make_translation(
        "lexer.number_uppercase_prefix",
        message: "Number prefixes are lowercase: write `${prefix}`.",
        start: 0,
        stop: 2,
        translation: "${prefix}${text.substring(2, to: length)}",
      ),
    )
  }
  let lowered_suffix = suffix.to_ascii_lowercase()
  if !suffix.is_empty() && find_suffix(lowered_suffix) is Some(suffix_entry) {
    let number = text.substring(0, to: stop)
    let checked = check_number(number)
    let value = match own checked.value {
      IntegerValue(digits) => if is_float_suffix(lowered_suffix) {
        NumberValue.FloatValue(token.normalize_decimal(digits, exponent: math.BigInteger.zero()))
      } else {
        NumberValue.IntegerValue(own digits)
      }
      FloatValue(decimal) => NumberValue.FloatValue(own decimal)
    }
    let type_name: StringSlice = match suffix_entry.type_name {
      Some(name) => name
      None => if number.contains(".") || number.contains("e") { "Float64" } else { "Int64" }
    }
    return Some(
      CheckedNumber(
        own value,
        problem: Some(
          NumberProblem(
            code: "lexer.number_suffix",
            message: "Number literals have no type suffixes such as `${suffix}`. A literal takes its type from its context, as in `let value: ${type_name} = ${number}`.",
            start: stop,
            stop: length,
          ),
        ),
        fixes: [],
      ),
    )
  }
  if !is_radix(text) && text.find("E") is Some(marker) && marker < stop {
    return Some(
      make_translation(
        "lexer.number_uppercase_exponent",
        message: "The exponent is written with a lowercase `e`.",
        start: marker,
        stop: marker + 1,
        translation: "${text.substring(0, to: marker)}e${text.substring(marker + 1, to: length)}",
      ),
    )
  }
  let whole = skip_decimal_digits(text, position: 0, with_underscores: true)
  let digits = remove_underscores(text.substring(0, to: whole))
  if is_radix(text) || digits.length() < 2 || digits.byte(0) != 48 {
    return None
  }
  var stripped: UInt64 = 0
  while stripped < length && (text.byte(stripped) == 48 || text.byte(stripped) == 95) {
    stripped += 1
  }
  let without_zeros: StringSlice = if stripped >= whole { "0" } else { text.substring(stripped, to: whole) }
  let decimal = "${without_zeros}${text.substring(whole, to: length)}"
  var is_octal_digits = true
  for byte in digits.bytes() {
    if byte < 48 || byte > 55 {
      is_octal_digits = false
    }
  }
  let octal_possible = whole == length && is_octal_digits
  var alternatives: List[Replacement] = []
  if octal_possible {
    let octal = "0o${without_zeros}"
    if check_number(octal).problem.is_none() && check_number(decimal).problem.is_none() {
      mut alternatives.push(Replacement(title: "Write `${octal}` (octal)", text: own octal))
      mut alternatives.push(Replacement(title: "Write `${decimal}` (decimal)", text: decimal.copy()))
    }
  } else if check_number(decimal).problem.is_none() {
    mut alternatives.push(Replacement(title: "Write `${decimal}`", text: decimal.copy()))
  }
  let message = if octal_possible {
    "Decimal numbers do not start with `0`. In C and Go, `${text.substring(0, to: whole)}` would be octal: write `0o${without_zeros}` for octal, or `${without_zeros}` for decimal."
  } else {
    "Decimal numbers do not start with `0`."
  }
  Some(
    CheckedNumber(
      value: check_number(decimal).value,
      problem: Some(NumberProblem(code: "lexer.number_leading_zero", own message, start: 0, stop: whole)),
      fixes: own alternatives,
    ),
  )
}

fn check_number(text: StringSlice) -> CheckedNumber
  uses Panic, RunForever
{
  match lex_foreign_number(text) {
    Some(checked) => checked
    None => numbers_check(text)
  }
}
