internal type Span(start: UInt64, stop: UInt64)
  derives Equal, Hash, Ordered

internal fn make_span(start: UInt64, stop: UInt64) -> Span
  uses Panic
{
  if stop < start {
    Panic.crash("a span ends before it starts")
  }
  Span(start, stop)
}

internal fn make_zero_width(position: UInt64) -> Span {
  Span(start: position, stop: position)
}

internal fn to_file(base: UInt64, span: Span) -> Span
  uses Panic
{
  Span(start: base + span.start, stop: base + span.stop)
}

internal fn of_file(base: UInt64, span: Span) -> Span
  uses Panic
{
  make_span(span.start - base, stop: span.stop - base)
}

internal type Source(path: String, text: String, line_starts: List[UInt64])

internal fn Source.create(path: StringSlice, text: own String) -> Source
  uses Panic
{
  var line_starts: List[UInt64] = []
  let length = text.length()
  if length >= 3 && text.byte(0) == 239 && text.byte(1) == 187 && text.byte(2) == 191 {
    mut line_starts.push(3)
  } else {
    mut line_starts.push(0)
  }
  for index in 0..length {
    let byte = text.byte(index)
    if byte == 10 {
      mut line_starts.push(index + 1)
    } else if byte == 13 && (index + 1 >= length || text.byte(index + 1) != 10) {
      mut line_starts.push(index + 1)
    }
  }
  Source(path: path.to_string(), text: own text, line_starts: own line_starts)
}

internal fn Source.compute_line_index(self, offset: UInt64) -> UInt64
  uses Panic, RunForever
{
  var low: UInt64 = 0
  var high = self.line_starts.length() - 1
  while low < high {
    let middle = (low + high + 1) / 2
    if self.line_starts.get(middle).expect("a line start") <= offset {
      low = middle
    } else {
      high = middle - 1
    }
  }
  low
}

internal fn Source.compute_line_start(self, offset: UInt64) -> UInt64
  uses Panic, RunForever
{
  self.line_starts.get(self.compute_line_index(offset)).expect("a line start")
}

internal fn Source.starts_line(self, offset: UInt64) -> Bool
  uses Panic, RunForever
{
  offset == self.compute_line_start(offset)
}

internal type Edit(span: Span, replacement: String)
  derives Equal

internal type Fix(title: String, edits: List[Edit])
  derives Equal

internal type Note(span: Span, message: String)
  derives Equal

internal type Diagnostic(code: String, span: Span, message: String, notes: List[Note], fixes: List[Fix])
  derives Equal

internal fn make_diagnostic(
  code: StringSlice,
  span: Span,
  message: StringSlice,
  notes: own List[Note] = [],
  fixes: own List[Fix] = [],
) -> Diagnostic {
  Diagnostic(code: code.to_string(), span, message: message.to_string(), notes: own notes, fixes: own fixes)
}

internal fn make_fix(title: StringSlice, edits: own List[Edit]) -> Fix {
  Fix(title: title.to_string(), edits: own edits)
}

internal fn replace(span: Span, replacement: StringSlice) -> Edit {
  Edit(span, replacement: replacement.to_string())
}

internal fn insert(at: Span, replacement: StringSlice) -> Edit {
  Edit(span: at, replacement: replacement.to_string())
}

internal fn delete(span: Span) -> Edit {
  Edit(span, replacement: "")
}

type Ranked(start: UInt64, sequence: UInt64)
  derives Equal, Ordered

internal fn sort_by_start(diagnostics: own List[Diagnostic]) -> List[Diagnostic]
  uses Panic
{
  var ranked: List[Ranked] = []
  for entry in diagnostics.enumerate() {
    mut ranked.push(Ranked(start: entry.element.span.start, sequence: entry.index))
  }
  mut ranked.sort()
  var slots: List[Option[Diagnostic]] = []
  for diagnostic in own diagnostics {
    mut slots.push(Some(own diagnostic))
  }
  var sorted: List[Diagnostic] = []
  for rank in ranked {
    let Some(diagnostic) = mut slots.element(rank.sequence).take() else {
      Panic.crash("each diagnostic is taken once")
    }
    mut sorted.push(own diagnostic)
  }
  sorted
}
