use frontend.lexer
use frontend.parser
use frontend.show
use frontend.source
use frontend.token

fn escape(value: String) -> String {
  var buffer = String.with_capacity(value.length())
  for character in value.characters() {
    if character == Character"\"" {
      mut buffer.push("\\\"")
    } else if character == Character"\\" {
      mut buffer.push("\\\\")
    } else if character == Character"\n" {
      mut buffer.push("\\n")
    } else {
      mut buffer.push_character(character)
    }
  }
  buffer
}

fn show_span(span: source.Span) -> String {
  "${span.start}..${span.stop}"
}

fn show_diagnostic(diagnostic: source.Diagnostic) -> String {
  var text = "${diagnostic.code} ${show_span(diagnostic.span)} \"${escape(diagnostic.message)}\""
  for note in diagnostic.notes {
    mut text.push("\n  note ${show_span(note.span)} \"${escape(note.message)}\"")
  }
  for fix in diagnostic.fixes {
    mut text.push("\n  fix \"${escape(fix.title)}\"")
    for edit in fix.edits {
      mut text.push("\n    edit ${show_span(edit.span)} \"${escape(edit.replacement)}\"")
    }
  }
  text
}

fn show_form(form: token.Form) -> String {
  match form {
    Ordinary => "ordinary"
    Raw(quotes, dollars, multi_line) => "raw ${quotes} ${dollars} ${multi_line}"
  }
}

fn show_text(text: token.Text) -> String {
  "\"${escape(text.value)}\" ${show_span(text.span)}"
}

type ShownRun(first: UInt64, next: UInt64, stop: UInt64)

type ShownString(literal_index: UInt64, segment: UInt64, closing: String, string_token: token.Token, enclosing: ShownRun)

fn write_suffix(current: token.Token, text: mut String) {
  mut text.push(" ${show_span(current.span)}")
  if current.line_break_before {
    mut text.push(" line")
  }
  if current.blank_line_before {
    mut text.push(" blank")
  }
  if current.is_inserted_closer {
    mut text.push(" inserted")
  }
}

fn advance_string(
  literal: token.StringLiteral,
  literal_index: UInt64,
  segment: UInt64,
  string_token: token.Token,
  enclosing: ShownRun,
  strings: mut List[ShownString],
  text: mut String,
) -> ShownRun {
  if segment >= literal.rest.length() {
    write_suffix(string_token, text: mut text)
    return enclosing
  }
  let interpolation = literal.rest[segment].interpolation
  mut text.push(" { ${show_span(interpolation.span)} ${interpolation.is_closed} [ ")
  mut strings.push(ShownString(literal_index, segment, closing: " ] } ${show_text(literal.rest[segment].text)}", string_token, enclosing))
  ShownRun(first: interpolation.first, next: interpolation.first, stop: interpolation.stop)
}

fn open_string(
  literal: token.StringLiteral,
  literal_index: UInt64,
  string_token: token.Token,
  enclosing: ShownRun,
  strings: mut List[ShownString],
  text: mut String,
) -> ShownRun {
  mut text.push("string ")
  if literal.tag is Some(tag) {
    mut text.push("tag ${tag.name} ${show_span(tag.span)} ")
  }
  mut text.push("${show_form(literal.form)} ${show_text(literal.first)}")
  advance_string(
    literal,
    literal_index,
    segment: 0,
    string_token: string_token,
    enclosing: enclosing,
    strings: mut strings,
    text: mut text,
  )
}

fn show_token(tables: token.Tables, index: UInt64) -> String
  uses Panic, RunForever
{
  var text = ""
  var run = ShownRun(first: index, next: index, stop: index + 1)
  var strings: List[ShownString] = []
  while true {
    if run.next >= run.stop {
      let Some(frame) = mut strings.pop() else {
        return text
      }
      mut text.push(frame.closing)
      run = advance_string(
        tables.literal(frame.literal_index),
        literal_index: frame.literal_index,
        segment: frame.segment + 1,
        string_token: frame.string_token,
        enclosing: frame.enclosing,
        strings: mut strings,
        text: mut text,
      )
      continue
    }
    if run.next > run.first {
      mut text.push(" ; ")
    }
    let current = tables.token(run.next)
    run.next += 1
    let kind = match current.kind {
      Upper(name) => "upper ${tables.name(name)}"
      Lower(name) => "lower ${tables.name(name)}"
      Underscore => "underscore"
      Keyword(keyword) => "keyword ${token.spell_keyword(keyword)}"
      Reserved(reserved) => "reserved ${token.spell_reserved(reserved)}"
      Integer(literal) => "integer ${tables.integers.get(literal).expect("an integer literal")}"
      Float(literal) => match tables.decimals.get(literal) {
        Some(decimal) => "float ${decimal.significand}e${decimal.exponent}"
        None => Panic.crash("a decimal index past the table")
      }
      String(literal) => {
        run = open_string(
          tables.literal(literal),
          literal_index: literal,
          string_token: current,
          enclosing: run,
          strings: mut strings,
          text: mut text,
        )
        continue
      }
      Punctuation(punctuation) => "punctuation ${token.spell_punctuation(punctuation)}"
      Foreign(foreign) => "foreign ${token.spell_foreign(foreign)}"
      Newline => "newline"
      EndOfFile => "end"
    }
    mut text.push(kind)
    write_suffix(current, text: mut text)
  }
}

fn print_tokens(path: String, text: own String)
  uses Console, Panic, RunForever
{
  let result = lexer.lex(source.Source.create(path, own text))
  Console.print_line("== ${path}")
  let tables = result.lexed.tables
  for index in result.lexed.first..result.lexed.stop {
    Console.print_line(show_token(tables, index))
  }
  for diagnostic in result.diagnostics {
    Console.print_line(show_diagnostic(diagnostic))
  }
}

fn print_file(path: String, text: own String)
  uses Console, Panic, RunForever
{
  let lexed = lexer.lex(source.Source.create(path, own text))
  let parsed = parser.parse(own lexed.lexed, lexer_diagnostics: lexed.diagnostics)
  Console.print_line("== ${path}")
  let tree = show.show_file(parsed.file)
  if !tree.is_empty() {
    Console.print_line(tree)
  }
  for diagnostic in lexed.diagnostics {
    Console.print_line(show_diagnostic(diagnostic))
  }
  for diagnostic in parsed.diagnostics {
    Console.print_line(show_diagnostic(diagnostic))
  }
}

type Timing(lexing: Int64, parsing: Int64)

fn measure(path: String, text: String, rounds: UInt64) -> Timing
  uses Clock, Panic, RunForever
{
  var best_lexing: Int64 = Int64.maximum
  for _ in 0..rounds {
    let before = Clock.monotonic()
    let result = lexer.lex(source.Source.create(path, text: text.copy()))
    let elapsed = (Clock.monotonic() - before).total_nanoseconds()
    if result.lexed.stop < result.lexed.first {
      Panic.crash("a token range runs backward")
    }
    if elapsed < best_lexing {
      best_lexing = elapsed
    }
  }
  let lexed = lexer.lex(source.Source.create(path, text: text.copy()))
  var best_parsing: Int64 = Int64.maximum
  for _ in 0..rounds {
    let tables = lexed.lexed.tables.copy()
    let input = token.Lexed(own tables, first: lexed.lexed.first, stop: lexed.lexed.stop)
    let before = Clock.monotonic()
    let parsed = parser.parse(own input, lexer_diagnostics: lexed.diagnostics)
    let elapsed = (Clock.monotonic() - before).total_nanoseconds()
    if parsed.file.definitions.length() > text.length() {
      Panic.crash("more definitions than bytes")
    }
    if elapsed < best_parsing {
      best_parsing = elapsed
    }
  }
  Timing(lexing: best_lexing, parsing: best_parsing)
}

fn time_files(rounds: UInt64, paths: List[String])
  uses Console, Clock, FileRead, Panic, RunForever
{
  var total_lexing: Int64 = 0
  var total_parsing: Int64 = 0
  for path in paths {
    let text = FileRead.read_text(Path.new(path)).expect("a readable UTF-8 file")
    let timing = measure(path, text, rounds)
    total_lexing += timing.lexing
    total_parsing += timing.parsing
    Console.print_line("${timing.lexing} ${timing.parsing} ${text.length()} ${path}")
  }
  Console.print_line("${total_lexing} ${total_parsing} total")
}

fn main(arguments: List[String]) -> ExitCode
  uses Console, Clock, FileRead, Panic, RunForever
{
  if arguments.length() < 2 {
    Console.print_error("frontend print FILE... | frontend tokens FILE... | frontend time ROUNDS FILE...")
    return ExitCode.failure
  }
  let command_name = arguments[1].copy()
  if command_name == "time" && arguments.length() >= 3 {
    let rounds = UInt64.parse(arguments[2]).expect("a count of rounds")
    time_files(rounds, paths: arguments[3..])
    return ExitCode.success
  }
  for path in arguments[2..] {
    let text = FileRead.read_text(Path.new(path)).expect("a readable UTF-8 file")
    if command_name == "tokens" {
      print_tokens(path, own text)
    } else if command_name == "print" {
      print_file(path, own text)
    }
  }
  ExitCode.success
}
